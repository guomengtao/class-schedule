<script>
var store = require("./data/store.js")
var database = require("./data/database.js")
var chatBridge = require("./data/chat-bridge.js")
var authStore = require("./data/auth-store.js")
var holidayPreset = require("./data/holiday-preset.js")
var defaultsEngine = require("./data/defaults-engine.js")

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
// DEBUG: 联调时打开，排查同步问题
var DEBUG = true
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}

var resident = null

try {
  resident = require("@system.resident")
} catch (e) {
  dlog("[BACKGROUND] resident not available: " + e)
}

function startResident() {
  if (!resident) {
    return
  }
  try {
    resident.start({
      message: "课程表后台运行中",
      success: function() {
        dlog("[BACKGROUND] resident started")
      },
      fail: function(data, code) {
        dlog("[BACKGROUND] resident start fail: " + code)
      }
    })
  } catch (e) {
    dlog("[BACKGROUND] resident error: " + e)
  }
}

function stopResident() {
  if (!resident) {
    return
  }
  try {
    resident.stop({
      success: function() {
        dlog("[BACKGROUND] resident stopped")
      },
      fail: function(data, code) {
        dlog("[BACKGROUND] resident stop fail: " + code)
      }
    })
  } catch (e) {
    dlog("[BACKGROUND] resident error: " + e)
  }
}

var interconnect = null

// 暴露给全局的 connect 实例：手环要【主动】给手机发消息（聊天功能）就靠它。
// 之前 connect 只是 initSyncReceiver() 里的局部变量，EV 只能在收到手机消息时"回包"，
// 没法自己开口 —— 这是"手环 → 手机"方向做不出来的根本原因。
var _syncConnect = null

try {
  interconnect = require("@system.interconnect")
} catch (e) {
  dlog("[SYNC] interconnect not available: " + e)
}

// ===== 同步协议（插件 ↔ 手环）=====
// 插件 → 手环：
//   { "action": "import", "payload": {...} }  导入课表（payload.scheduleName 可选：按名新建/覆盖同名表）
//   { "action": "export", "scheduleIndex": N }  请求导出（可选指定第 N 套，缺省=当前激活）
//   { "action": "list_schedules" }          请求课程表清单（names + current）
//   { "action": "get_device_id" }           索取设备ID（APK 拿不到，激活用）
//   { "action": "activate", "code": "18位" } 一键激活（本地校验 + 落库 auth_data）
//   直接发课表数据（无 action，按导入处理，兼容已对接格式）
// 手环 → 插件：
//   { "ok": true, "count": N }                          导入回包
//   { "ok": true, "action": "export", "data": [...] }   导出回包（格式 A）
//   { "ok": true, "action": "get_device_id", "deviceId": "...", "deviceId4": "....", "fallback": false }
//   { "ok": true, "action": "activate", "status": "...", "expireAt": ms }

var SYNC_DAY_NAMES = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]
// 默认节次时间表，仅当插件使用 start_period/end_period 时兜底
var SYNC_PERIOD_TIMES = [
  "08:00 - 08:45", "08:55 - 09:40", "10:00 - 10:45", "10:55 - 11:40",
  "14:00 - 14:45", "14:55 - 15:40", "16:00 - 16:45", "16:55 - 17:40"
]

function syncNormalizeDay(v) {
  var s = String(v === null || v === undefined ? "" : v).trim()
  if (s === "") {
    return ""
  }
  if (/^[1-7]$/.test(s)) {
    return SYNC_DAY_NAMES[Number(s) - 1]
  }
  if (s.indexOf("星期") === 0) {
    return s
  }
  var map = {
    "Monday": "星期一", "Tuesday": "星期二", "Wednesday": "星期三",
    "Thursday": "星期四", "Friday": "星期五", "Saturday": "星期六", "Sunday": "星期日",
    "Mon": "星期一", "Tue": "星期二", "Wed": "星期三",
    "Thu": "星期四", "Fri": "星期五", "Sat": "星期六", "Sun": "星期日"
  }
  return map[s] || s
}

// 生成 "HH:MM - HH:MM"，兼容 time / startTime+endTime / 节次 三种写法
function syncBuildTime(c) {
  if (c.time) {
    return String(c.time)
  }
  if (c.startTime && c.endTime) {
    return String(c.startTime) + " - " + String(c.endTime)
  }
  var sp = parseInt(c.start_period || c.startPeriod || 0, 10)
  var ep = parseInt(c.end_period || c.endPeriod || sp, 10)
  if (sp >= 1 && ep >= sp && ep <= SYNC_PERIOD_TIMES.length) {
    var s = SYNC_PERIOD_TIMES[sp - 1].split(" - ")
    var e = SYNC_PERIOD_TIMES[ep - 1].split(" - ")
    return s[0] + " - " + e[1]
  }
  return ""
}

// 宽容取课程数组：支持 [] / {courses:[]} / {schedules:[{courses:[]}]} / {payload:{...}}
function syncExtractCourses(payload) {
  var list = null
  if (payload && payload.length !== undefined && typeof payload !== "string") {
    list = payload
  } else if (payload && payload.courses) {
    list = payload.courses
  } else if (payload && payload.schedules && payload.schedules[0] && payload.schedules[0].courses) {
    list = payload.schedules[0].courses
  } else if (payload && payload.payload) {
    return syncExtractCourses(payload.payload)
  }
  return (list && list.length) ? list : null
}

// Course[] → 格式 A（按 day 分组）
function syncToFormatA(list) {
  var result = []
  var indexMap = {}
  var idSeq = 1
  for (var i = 0; i < list.length; i++) {
    var c = list[i] || {}
    var day = syncNormalizeDay(c.day || c.dayOfWeek || c.day_of_week)
    var name = String(c.name || c.courseName || "").trim()
    if (!day || !name) {
      continue
    }
    var time = syncBuildTime(c)
    if (!time) {
      continue
    }
    if (indexMap[day] === undefined) {
      indexMap[day] = result.length
      result.push({ day: day, classes: [] })
    }
    result[indexMap[day]].classes.push({
      // ★ 透传客户端 id（字段级三方合并的稳定身份）；没传才按顺序生成，兼容旧插件
      id: String(c.id || ("c" + Date.now() + "-" + (idSeq++))),
      name: name,
      time: time,
      teacher: String(c.teacher || ""),
      location: String(c.location || c.classroom || c.room || ""),
      notes: String(c.notes || c.note || "")
    })
  }
  return result
}

function syncReply(connect, payload) {
  try {
    console.log("[SYNC-TX] reply payload=" + JSON.stringify(payload).substring(0, 100))
    // 官方文档：connect.send 的 data 是 Object（框架负责序列化）；发字符串会双重转义
    connect.send({ data: payload })
    console.log("[SYNC-TX] reply send done")
  } catch (e) {
    console.log("[SYNC-TX] reply failed: " + e)
  }
}

// ===== 聊天：收（手机 → 手环）=====
// 消息存进 ev_chat_inbox（聊天页读取），同时长震动提醒，并回送达确认。
function syncHandleChatIncoming(connect, msg) {
  var text = String(msg.text === undefined || msg.text === null ? "" : msg.text)
  // id 必须**每条唯一**：手机端/后续拉取都靠它去重，避免同一条留言被重复提醒
  var msgId = String(msg.id || "")
  if (!msgId) {
    msgId = String(Date.now()) + "-" + Math.random().toString(36).slice(2, 6)
  }
  var item = { id: msgId, from: "phone", text: text, ts: msg.ts || Date.now(), read: false }
  var storage = require("@system.storage")
  storage.get({
    key: "ev_chat_inbox",
    success: function (oldVal) {
      var list = []
      try {
        list = JSON.parse(oldVal || "[]")
      } catch (e) {
        list = []
      }
      list.push(item)
      if (list.length > 50) { list = list.slice(list.length - 50) }
      storage.set({
        key: "ev_chat_inbox",
        value: JSON.stringify(list),
        success: function () { vibrateLong() },
        fail: function () { vibrateLong() }
      })
    },
    fail: function () {
      vibrateLong()
    }
  })
  syncReply(connect, { ok: true, action: "chat_ack", id: msg.id || "", ts: Date.now() })
}

/** 长震动：优先 vibrator.start（自定义时长/次数），失败回落 vibrate({mode:"long"}) */
function vibrateLong() {
  try {
    var vibrator = require("@system.vibrator")
    vibrator.start({
      duration: 800,
      interval: 300,
      count: 2,
      success: function () {
        dlog("[CHAT] vibrate long ok")
      },
      fail: function (data, code) {
        dlog("[CHAT] vibrate.start fail code=" + code + ", fallback")
        try {
          vibrator.vibrate({ mode: "long" })
        } catch (e2) {
          dlog("[CHAT] vibrate fallback fail: " + e2)
        }
      }
    })
  } catch (e) {
    dlog("[CHAT] vibrator not available: " + e)
  }
}

// ===== 课堂提醒：收（手机 → 手环）=====
// 手机点首页「上课了 / 下课了」时下发 {action:"notify", type:"class_start|class_end", text}。
// 手环弹提示条 + 专用震动，并回确认 —— 手机端据回包 ok 判定端到端送达。
// 说明：旧版手环不认 notify（会落到下面 syncHandleImport 兜底回 "no courses"），
//       手机端据此自动回落 action=call（单次长震），保证老用户点了不空。
function syncHandleNotify(connect, msg) {
  var type = String((msg && msg.type) || "")
  var text = String((msg && msg.text) || "")
  if (!text) {
    text = (type === "class_end") ? "下课了！" : "上课了！"
  }
  // ① 提示条：让「上课了 / 下课了」在手环上有可见文案（不再只是与「呼叫手环」同一条黑箱震动）
  try {
    var prompt = require("@system.prompt")
    prompt.showToast({ message: text })
  } catch (e) {
    dlog("[SYNC] notify toast fail: " + e)
  }
  // ② 震动：上课 = 3 次急促（醒目）/ 下课 = 1 次舒缓，与「呼叫手环」的单次长震区分开
  vibrateNotify(type)
  // ③ 留档最近一条提醒，便于手环端排查 / 后续展示
  try {
    var storage = require("@system.storage")
    storage.set({
      key: "ev_last_notify",
      value: JSON.stringify({ type: type, text: text, ts: Date.now() }),
      fail: function () {}
    })
  } catch (e2) {
    dlog("[SYNC] notify persist fail: " + e2)
  }
  syncReply(connect, { ok: true, action: "notify", type: type, ts: Date.now() })
}

/** 课堂提醒震动：上课 3 次急促 / 下课 1 次舒缓；失败回落 vibrate({mode}) */
function vibrateNotify(type) {
  var end = (type === "class_end")
  try {
    var vibrator = require("@system.vibrator")
    vibrator.start({
      duration: end ? 700 : 380,
      interval: end ? 260 : 200,
      count: end ? 1 : 3,
      success: function () {
        dlog("[CHAT] vibrate notify ok")
      },
      fail: function (data, code) {
        dlog("[CHAT] vibrate.start fail code=" + code + ", fallback")
        try {
          vibrator.vibrate({ mode: end ? "long" : "short" })
        } catch (e2) {
          dlog("[CHAT] vibrate fallback fail: " + e2)
        }
      }
    })
  } catch (e) {
    dlog("[CHAT] vibrator not available: " + e)
  }
}

// ===== 聊天：发（手环 → 手机）=====
// 页面调用：syncSendToPhone("文字") —— 这是 EV 第一次具备【主动发送】能力。
// ⚠️ 手机端能否收到，尚未被证实过（插件时代的 S1′ 实验结果是 0 条）。本函数就是用来做这个 PoC 的。
function syncSendToPhone(text) {
  // 实际能力在 chat-bridge.js（共享模块），这里只做一层薄封装
  return chatBridge.send(text)
}

// 导入：转格式 A 后单次原子写盘；写前先备份旧课表，便于回退。
// payload.scheduleName 可选：给了就【按名新建 / 覆盖同名课程表】；缺省仍写当前激活套（向后兼容）。
function syncHandleImport(connect, payload) {
  var list = syncExtractCourses(payload)
  if (!list) {
    dlog("[SYNC] import: no courses")
    syncReply(connect, { ok: false, reason: "no courses" })
    return
  }
  var data = syncToFormatA(list)
  if (!data.length) {
    dlog("[SYNC] import: convert empty")
    syncReply(connect, { ok: false, reason: "convert empty" })
    return
  }

  var count = 0
  for (var i = 0; i < data.length; i++) {
    count += data[i].classes.length
  }

  var wantName = String((payload && payload.scheduleName) || "").trim()
  if (!wantName) {
    var curIndex = 0
    try { curIndex = database.getScheduleIndex() } catch (e) { curIndex = 0 }
    syncWriteCoursesToIndex(curIndex, data, count, connect, null)
    return
  }

  store.getScheduleNames(function (names) {
    names = (names || []).slice()
    var idx = -1
    for (var i = 0; i < names.length; i++) {
      if (String(names[i] || "").trim() === wantName) { idx = i; break }
    }
    if (idx < 0) {
      // 新表：追加名称后写入新索引
      names.push(wantName)
      idx = names.length - 1
      store.setScheduleNames(names, function () {
        syncWriteCoursesToIndex(idx, data, count, connect, { scheduleName: wantName, created: true })
      })
      return
    }
    // 同名已存在：覆盖它
    syncWriteCoursesToIndex(idx, data, count, connect, { scheduleName: wantName, created: false })
  })
}

// 把格式 A 数据写入第 index 套（先备份旧数据），成功后切到该套，让用户立即可见
function syncWriteCoursesToIndex(index, data, count, connect, extra) {
  var storage = require("@system.storage")
  var key = "allCourses_" + index

  storage.get({
    key: key,
    success: function (oldVal) {
      storage.set({
        key: "astrobox_sync_backup",
        value: oldVal || "[]",
        success: function () {
          storage.set({
            key: key,
            value: JSON.stringify(data),
            success: function () {
              database.resetCache()
              try { database.setScheduleIndex(index, function () {}) } catch (e) {}
              var reply = { ok: true, count: count }
              if (extra) {
                reply.action = "import"
                reply.scheduleName = extra.scheduleName
                reply.scheduleIndex = index
                reply.created = !!extra.created
              }
              dlog("[SYNC] import ok: index=" + index + " count=" + count)
              syncReply(connect, reply)
            },
            fail: function () {
              syncReply(connect, { ok: false, reason: "write failed" })
            }
          })
        },
        fail: function () {
          syncReply(connect, { ok: false, reason: "backup failed" })
        }
      })
    },
    fail: function () {
      syncReply(connect, { ok: false, reason: "read failed" })
    }
  })
}

// 设备ID：APK 侧自己拿不到（只能在手环侧取），这里向 APK 暴露
function syncHandleGetDeviceId(connect) {
  function replyWith(raw, fallback) {
    var id = String(raw == null ? "" : raw)
    syncReply(connect, {
      ok: true,
      action: "get_device_id",
      deviceId: id,
      deviceId4: id.slice(-4),
      fallback: !!fallback
    })
  }

  function fallbackUuid() {
    try {
      var deviceUuid = require("./utils/device-uuid.js")
      deviceUuid.getLocalDeviceId(function (id) { replyWith(id, true) })
    } catch (e) {
      replyWith("", true)
    }
  }

  var device = null
  try { device = require("@system.device") } catch (e) { device = null }
  if (!device || !device.getDeviceId) { fallbackUuid(); return }
  try {
    device.getDeviceId({
      success: function (data) {
        var raw = data && data.deviceId
        if (!raw || raw === "NA" || raw === "unknown" || raw === "null") fallbackUuid()
        else replyWith(raw, false)
      },
      fail: function () { fallbackUuid() }
    })
  } catch (e) {
    fallbackUuid()
  }
}

// 一键激活：APK 已从后端拿到 18 位激活码，这里做本地解码校验 + 落库
function syncHandleActivate(connect, payload) {
  var cleaned = String((payload && payload.code) || "").replace(/\s/g, "")
  if (!/^\d{18}$/.test(cleaned)) {
    syncReply(connect, { ok: false, action: "activate", reason: "激活码必须是 18 位纯数字" })
    return
  }

  var cryptoLib = null
  try { cryptoLib = require("./lib/crypto.js") } catch (e) { cryptoLib = null }
  if (!cryptoLib) {
    syncReply(connect, { ok: false, action: "activate", reason: "crypto unavailable" })
    return
  }

  var decrypted = null
  try { decrypted = cryptoLib.decryptActivationCode(cleaned) } catch (e) { decrypted = null }
  if (!decrypted || !decrypted.valid) {
    syncReply(connect, { ok: false, action: "activate", reason: "激活码无法解析" })
    return
  }

  function finish(deviceId) {
    var s = String(deviceId == null ? "" : deviceId)
    var last4 = s.substring(s.length - 4)
    if (String(decrypted.deviceId) !== last4) {
      syncReply(connect, {
        ok: false,
        action: "activate",
        reason: "设备ID不匹配",
        codeDeviceId: decrypted.deviceId,
        localDeviceId4: last4
      })
      return
    }
    // 与手环端 activation.ux 的既有逻辑保持一致（月份 99 = 永久 → days = -1）
    var months = parseInt(decrypted.months, 10)
    var isPermanent = months === 99
    var days = isPermanent ? -1 : months * 30
    authStore.markActivated(days, cleaned, decrypted.redeemCode, function (success) {
      if (success) {
        authStore.saveUsedCode(cleaned)
        authStore.saveUsedRedeemCode(decrypted.redeemCode)
      }
      authStore.getFullStatus(function (st) {
        syncReply(connect, {
          ok: !!success,
          action: "activate",
          reason: success ? "" : "保存激活状态失败",
          status: (st && st.status) || "",
          displayStatus: (st && st.displayStatus) || "",
          expireAt: (st && st.expireAt) || null,
          months: months
        })
      })
    })
  }

  var device = null
  try { device = require("@system.device") } catch (e) { device = null }
  if (!device || !device.getDeviceId) { finish(""); return }
  try {
    device.getDeviceId({
      success: function (data) { finish(data && data.deviceId) },
      fail: function () { finish("") }
    })
  } catch (e) {
    finish("")
  }
}

// ===== 导出作用域（白名单模型）=====
// 只有在这里出现的域才会被读取并返回；未开放的域，插件读不到也改不掉。
// schedule   课表
// profile    昵称
// homepage   首页设置
// appearance 首页模板 + 字号
// pinned     钉首页列表（**默认不开放**，需插件显式传 scopes 才会返回）
// ===== 数据开放策略（守门人模型）=====
// 想调整"哪些可读 / 只读 / 禁止读 / 可写"，只改这张表即可。
//
//   read:  "always"   —— 默认导出就返回（任意读）
//          "explicit" —— 需插件显式传 scopes 才返回
//          "never"    —— 永远不返回（禁止读）
//   write: true/false —— 是否允许 update_settings 写入
//
// 组合出的策略：
//   任意读+可写   → read:"always"   write:true   （如 nickname / 课表）
//   只读          → read:"always"   write:false  （如 version 版本号）
//   显式才给只读 → read:"explicit" write:false   （如 pinned 钉首页）
//   禁止读写     → read:"never"    write:false   （如 auth 授权）
var SYNC_ACCESS = {
  schedule:   { read: "always",   write: true  },  // 课表：可读可写（import 覆盖）
  profile:    { read: "always",   write: true  },  // 昵称等：可读可写
  homepage:   { read: "always",   write: true  },  // 首页设置：可读可写
  appearance: { read: "always",   write: true  },  // 模板 + 字号：可读可写
  version:    { read: "always",   write: false },  // 版本号：只读
  pinned:     { read: "explicit", write: false },  // 钉首页：只读（须显式请求）
  auth:       { read: "never",    write: false }   // 授权：禁止读、禁止写
}

// update_settings 的字段 → 所属域（写权限判断用）
var SYNC_FIELD_DOMAIN = {
  nickname: "profile",
  homepage: "homepage",
  homepageTemplate: "appearance",
  baseFontSize: "appearance",
  weekviewTemplate: "appearance",   // 周视图模板（手机端可远程切换）
  appTheme: "appearance",           // 主题色（手机端可远程切换）
  pinned: "pinned"
}

// 默认就返回的域（read:"always" 者），用于 export 回显
var SYNC_DEFAULT_SCOPES = ["schedule", "profile", "homepage", "appearance", "version"]

var SYNC_ALL_SCOPES = ["schedule", "profile", "homepage", "appearance", "version", "pinned", "auth"]

function syncGetPolicy(name) {
  return SYNC_ACCESS[name] || null
}

function syncWantScope(scopes, name) {
  if (!scopes) {
    return false
  }
  for (var i = 0; i < scopes.length; i++) {
    if (scopes[i] === name) {
      return true
    }
  }
  return false
}

// 是否可读：never 一律拒绝；explicit 需被显式请求；always 默认给
function syncCanRead(name, requested) {
  var p = syncGetPolicy(name)
  if (!p || p.read === "never") {
    return false
  }
  if (p.read === "explicit") {
    return requested
  }
  return true
}

// 是否可写：按字段所属域的 write 策略
function syncCanWrite(field) {
  var domain = SYNC_FIELD_DOMAIN[field]
  if (!domain) {
    return false
  }
  var p = syncGetPolicy(domain)
  return !!(p && p.write === true)
}

// 读取版本号（只读，来源 data/version.js），失败时返回空
function syncCollectVersion() {
  try {
    var v = require("./data/version.js")
    return { versionName: v.versionName || "", versionCode: v.versionCode || 0 }
  } catch (e) {
    return { versionName: "", versionCode: 0 }
  }
}

// 按域收集数据，只收集策略允许且被请求的域
function syncCollectScopes(scopes, scheduleIndex, callback) {
  var result = {}
  var pending = 0
  var done = 0
  var finished = false
  var registered = false
  var timer = null

  function complete() {
    if (finished) {
      return
    }
    finished = true
    if (timer) {
      try { clearTimeout(timer) } catch (e) {}
      timer = null
    }
    callback(result)
  }

  function finish() {
    done++
    // 只有全部任务注册完毕后再判定完成，避免同步回调导致提前回包（只含部分域）
    if (registered && done === pending) {
      complete()
    }
  }

  var list = []
  for (var i = 0; i < SYNC_ALL_SCOPES.length; i++) {
    var nm = SYNC_ALL_SCOPES[i]
    if (syncCanRead(nm, syncWantScope(scopes, nm))) {
      list.push(nm)
    }
  }

  if (syncWantScope(list, "schedule")) {
    pending++
    if (scheduleIndex != null && scheduleIndex >= 0) {
      database.getAllCoursesWithIndex(scheduleIndex, function (courses) {
        result.schedule = courses || []
        finish()
      })
    } else {
      database.getAllCourses(function (courses) {
        result.schedule = courses || []
        finish()
      })
    }
  }
  if (syncWantScope(list, "profile")) {
    pending++
    store.getNickname(function (n) {
      result.nickname = n || ""
      finish()
    })
  }
  if (syncWantScope(list, "homepage")) {
    pending++
    store.getHomepageSettings(function (h) {
      result.homepage = h || {}
      finish()
    })
  }
  if (syncWantScope(list, "appearance")) {
    pending++
    store.getHomepageTemplate(function (t) {
      result.homepageTemplate = t || "default"
      finish()
    })
    pending++
    store.getBaseFontSize(function (f) {
      result.baseFontSize = f || 48
      finish()
    })
    pending++
    store.getWeekViewTemplate(function (t) {
      result.weekviewTemplate = t || "minimal-char"
      finish()
    })
    pending++
    store.getThemeName(function (n) {
      result.appTheme = n || "blue"
      finish()
    })
  }
  if (syncWantScope(list, "pinned")) {
    pending++
    try {
      var pinHelper = require("./data/pin-helper.js")
      pinHelper.getList(function (p) {
        result.pinned = p || []
        finish()
      })
    } catch (e) {
      result.pinned = []
      finish()
    }
  }
  if (syncWantScope(list, "version")) {
    var ver = syncCollectVersion()
    result.versionName = ver.versionName
    result.versionCode = ver.versionCode
  }

  // 所有收集任务已注册完毕，此时才能判定完成
  registered = true

  if (pending === 0) {
    complete()
    return
  }
  if (done === pending) {
    complete()
    return
  }
  // 超时兜底：个别异步回调若长期不返回，也要按期回包（返回已收集到的部分数据），
  // 避免插件侧等到宿主超时后报 "Plugin thread dropped the response"
  try {
    timer = setTimeout(function () {
      dlog("[SYNC] export timeout, partial reply")
      complete()
    }, 2000)
  } catch (e) {}
}

// 导出：默认返回默认域集合；插件可用 scopes 指定（pinned 需显式指定）。
// scheduleIndex 可选：指定则导该套（getAllCoursesWithIndex），否则导当前激活套。
function syncHandleExport(connect, scopes, scheduleIndex) {
  syncCollectScopes(scopes, scheduleIndex, function (data) {
    syncReply(connect, {
      ok: true,
      action: "export",
      version: 1,
      scopes: scopes || SYNC_DEFAULT_SCOPES,
      data: data
    })
  })
}

// 课程表清单：返回所有课程表名称 + 当前选中索引（多课程表导出前置）
function syncHandleListSchedules(connect) {
  var storage = require("@system.storage")
  storage.get({
    key: "scheduleNames",
    success: function (raw) {
      var names = []
      try { names = JSON.parse(raw || "[]") } catch (e) { names = [] }
      storage.get({
        key: "currentScheduleIndex",
        success: function (idxRaw) {
          var cur = parseInt(idxRaw)
          if (isNaN(cur) || cur < 0) { cur = 0 }
          syncReply(connect, { ok: true, action: "list_schedules", names: names, current: cur })
        },
        fail: function () {
          syncReply(connect, { ok: true, action: "list_schedules", names: names, current: 0 })
        }
      })
    },
    fail: function () {
      syncReply(connect, { ok: true, action: "list_schedules", names: [], current: 0 })
    }
  })
}

// 编辑配置：昵称 / 首页设置 / 首页模板 / 字号，支持任意组合
function syncHandleUpdateSettings(connect, payload) {
  if (!payload) {
    syncReply(connect, { ok: false, reason: "empty" })
    return
  }

  var pending = 0
  var done = 0
  var replied = false
  function finish() {
    done++
    if (done === pending && !replied) {
      replied = true
      syncReply(connect, { ok: true, action: "update_settings" })
    }
  }

  if (payload.nickname !== undefined && syncCanWrite("nickname")) {
    pending++
    var nick = payload.nickname
    // 容错：对方可能误传表单 change 事件对象 {"type":"change","value":"123","checked":false}，取 .value
    if (typeof nick === "string") {
      try {
        var nickObj = JSON.parse(nick)
        if (nickObj && typeof nickObj === "object" && Object.prototype.hasOwnProperty.call(nickObj, "value")) {
          nick = nickObj.value
        }
      } catch (e) {}
    }
    store.setNickname(String(nick), finish)
  }
  if (payload.homepage !== undefined && syncCanWrite("homepage")) {
    pending++
    store.setHomepageSettings(payload.homepage, finish)
  }
  if (payload.homepageTemplate !== undefined && syncCanWrite("homepageTemplate")) {
    pending++
    store.setHomepageTemplate(String(payload.homepageTemplate), finish)
  }
  if (payload.baseFontSize !== undefined && syncCanWrite("baseFontSize")) {
    var size = parseInt(payload.baseFontSize, 10)
    if (size >= 20 && size <= 76) {
      pending++
      store.setBaseFontSize(size, finish)
    }
  }
  if (payload.weekviewTemplate !== undefined && syncCanWrite("weekviewTemplate")) {
    pending++
    store.setWeekViewTemplate(String(payload.weekviewTemplate), finish)
  }
  if (payload.appTheme !== undefined && syncCanWrite("appTheme")) {
    pending++
    store.setTheme(String(payload.appTheme), finish)
  }

  if (pending === 0) {
    syncReply(connect, { ok: false, reason: "no known field" })
  }
}

function initSyncReceiver() {
  if (!interconnect) {
    console.log("[SYNC-INIT] interconnect NOT available, module is null")
    return
  }
  console.log("[SYNC-INIT] interconnect available, getting instance...")
  var connect = interconnect.instance()
  console.log("[SYNC-INIT] instance obtained, setting onmessage...")

  connect.onmessage = function (data) {
    console.log("[SYNC-RX] onmessage fired, data type=" + (typeof data) + ", has data field=" + !!(data && data.data))
    var raw = (data && data.data)
    var parsed = null
    try {
      // 兼容插件发字符串或对象两种形态
      if (typeof raw === "string") {
        console.log("[SYNC-RX] raw is string, length=" + raw.length + ", preview=" + raw.substring(0, 120))
        parsed = JSON.parse(raw)
      } else if (raw) {
        console.log("[SYNC-RX] raw is object, keys=" + JSON.stringify(Object.keys(raw)))
        parsed = raw
      }
    } catch (e) {
      console.log("[SYNC-RX] parse failed: " + e + ", raw=" + raw)
      return
    }
    if (!parsed) {
      console.log("[SYNC-RX] parsed is empty, raw was: " + raw)
      return
    }
    console.log("[SYNC-RX] action=" + (parsed.action || "(none)"))

    // 原始报文始终留档，便于排错与后续补转换
    var storage = require("@system.storage")
    storage.set({
      key: "astrobox_sync_data",
      value: JSON.stringify(parsed),
      fail: function () {}
    })

    if (parsed.action === "ping") {
      // 通道探针：同步立即回，最快往返；联调第一步用它判定通道是否双向通
      var pv = syncCollectVersion()
      syncReply(connect, {
        ok: true,
        action: "ping",
        pong: true,
        versionName: pv.versionName,
        versionCode: pv.versionCode
      })
      return
    }
    if (parsed.action === "export") {
      // scopes 支持数组；也兼容单字符串 scope
      var scopes = parsed.scopes
      if (!scopes && parsed.scope) {
        scopes = [parsed.scope]
      }
      syncHandleExport(connect, scopes, parsed.scheduleIndex)
      return
    }
    if (parsed.action === "update_settings") {
      syncHandleUpdateSettings(connect, parsed.payload || parsed)
      return
    }
    if (parsed.action === "chat") {
      // 手机 → 手环：聊天消息。存收件箱 + 长震动，并回送达确认
      syncHandleChatIncoming(connect, parsed)
      return
    }
    if (parsed.action === "list_schedules") {
      // 手机 → 手环：请求课程表清单（多课程表导出前置）
      syncHandleListSchedules(connect)
      return
    }
    if (parsed.action === "get_device_id") {
      // 手机 → 手环：索取设备ID（APK 侧拿不到，激活/绑定用）
      syncHandleGetDeviceId(connect)
      return
    }
    if (parsed.action === "activate") {
      // 手机 → 手环：一键激活（APK 已拿到 18 位激活码，手环本地校验后落库）
      syncHandleActivate(connect, parsed)
      return
    }
    if (parsed.action === "import") {
      syncHandleImport(connect, parsed.payload || parsed)
      return
    }
    if (parsed.action === "call") {
      // 手机 → 手环：呼叫手环（找表）。震动 + 回确认，手机端据 ok 判定端到端送达。
      vibrateLong()
      syncReply(connect, { ok: true, action: "call", ts: Date.now() })
      return
    }
    if (parsed.action === "notify") {
      // 手机 → 手环：课堂提醒（上课了 / 下课了）。弹提示条 + 专用震动 + 回确认。
      syncHandleNotify(connect, parsed)
      return
    }
    if (parsed.action === "rx_ack") {
      // 手机 → 手环：应用层回执（我们发的 chat/cmd 手机已收到）。
      // 记「手机最后在线时间」到全局 —— 模块被打成多份副本，globalThis 是唯一跨副本通道。
      // 留言板页据此显示「手机在线」，手环发消息不再盲发。
      try {
        globalThis.__evSyncPhoneSeenTs = Date.now()
        globalThis.__evSyncPhoneSeenRef = parsed.refAction || ""
      } catch (e) {}
      console.log("[SYNC-RX] rx_ack, refAction=" + (parsed.refAction || "") + " phone is online")
      return
    }
    if (parsed.action === "typing") {
      // 手机 → 手环：输入态（P3）。只把状态写到全局（globalThis 是跨模块副本唯一通道），
      // 留言板页轮询展示「对方正在输入…」+ 草稿；⚠️ 高频报文，不回包。
      try {
        globalThis.__evPeerTyping = {
          state: parsed.state || "upd",
          text: String(parsed.text || "").slice(0, 40),
          ts: parsed.ts || Date.now()
        }
      } catch (e) {}
      return
    }
    // ⚠️ 老端兼容兜底（P2 起）：**白名单外的未知 action 一律安全忽略、不回包**。
    //    历史上这里对「无 action」的报文按 import 处理；但早期实现把「任何未识别报文」
    //    都当 import，结果新版手机端发来新 action（typing / phrases 等）会触发一次
    //    无意义的 import → 回 {reason:"no courses"}，反而污染留言流。
    //    现在拆开：完全无 action 才走老的 import 兼容；有 action 但不在上面白名单 → 丢弃。
    if (!parsed.action) {
      // 无 action：兼容已对接格式，按导入处理
      syncHandleImport(connect, parsed)
      return
    }
    console.log("[SYNC-RX] unknown action ignored: " + parsed.action)
  }

  connect.onopen = function (data) {
    console.log("[SYNC-EVT] onopen fired, isReconnected=" + (data && data.isReconnected))
  }
  connect.onerror = function (data) {
    console.log("[SYNC-EVT] onerror code=" + (data && data.code) + " data=" + (data && data.data))
  }
  connect.onclose = function (data) {
    console.log("[SYNC-EVT] onclose code=" + (data && data.code))
  }
  // ↓↓↓ 注册到共享模块：手环侧这才具备【主动发送】能力（聊天功能前提）
  _syncConnect = connect
  chatBridge.register(connect)
  // 主动探测连接状态，便于真机定位"通道是否建立"
  try {
    connect.getReadyState({
      success: function (d) { console.log("[SYNC-EVT] readyState=" + (d && d.status)) },
      fail: function (d, c) { console.log("[SYNC-EVT] getReadyState fail code=" + c) }
    })
  } catch (e) {
    console.log("[SYNC-EVT] getReadyState exception=" + e)
  }
}

function migrateFontScale() {
  var storage = require("@system.storage")
  storage.get({
    key: "fontScale",
    success: function(data) {
      var oldScale = parseFloat(data)
      if (oldScale && oldScale >= 0.5) {
        var newSize = Math.round(48 * oldScale)
        storage.set({
          key: "baseFontSize",
          value: String(newSize),
          success: function() {
            storage.delete({
            key: "fontScale",
            fail: function() {}
          })
          }
        })
      }
    },
    fail: function() {}
  })
}

function migrateBuiltinHolidays() {
  holidayPreset.ensurePreset(function(added) {
    dlog("[PRESET] builtin holidays added: " + added)
  })
}

// 默认值迁移：区分新用户 / 老用户，按 app-defaults.js 的 policy 逐条应用。
// 版本一致时只有 1 次 storage.get 的开销，不影响启动速度。
// 失败不影响启动 —— 版本号不推进，下次启动自动重试。
function runDefaults() {
  try {
    defaultsEngine.run(function(result) {
      dlog("[defaults] kind=" + result.kind + " applied=" + result.applied)
      if (result.applied > 0) {
        // 迁移写了 storage，必须让 store 的内存缓存失效，否则页面仍显示旧值
        store.clearCache()
      }
    })
  } catch (e) {
    dlog("[defaults] run error: " + e)
  }
}

export default {
  onCreate() {
    database.init()
    authStore.initAuth()
    store.getBaseFontSize(function(size) {
      if (!size) {
        store.setBaseFontSize(48)
      }
    })
    migrateFontScale()
    migrateBuiltinHolidays()
    runDefaults()
    // 自动常驻保活：保证 interconnect 同步消息随时可收，无需用户手工开启「后台运行」
    startResident()
    initSyncReceiver()
  },

  initBackgroundRunning() {
    store.getBackgroundRunningConfig(function(config) {
      if (config && config.running) {
        startResident()
      }
    })
  },

  onDestroy() {
    // 不再主动 stopResident：保持常驻以持续接收同步消息（如需停止由系统或用户决定）
  }
}
</script>