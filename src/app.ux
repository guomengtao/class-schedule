<script>
var store = require("./data/store.js")
var database = require("./data/database.js")
var authStore = require("./data/auth-store.js")
var resident = null

try {
  resident = require("@system.resident")
} catch (e) {
  console.warn("[BACKGROUND] resident not available: " + e)
}

function startResident() {
  if (!resident) {
    return
  }
  try {
    resident.start({
      message: "课程表后台运行中",
      success: function() {
        console.log("[BACKGROUND] resident started")
      },
      fail: function(data, code) {
        console.warn("[BACKGROUND] resident start fail: " + code)
      }
    })
  } catch (e) {
    console.warn("[BACKGROUND] resident error: " + e)
  }
}

function stopResident() {
  if (!resident) {
    return
  }
  try {
    resident.stop({
      success: function() {
        console.log("[BACKGROUND] resident stopped")
      },
      fail: function(data, code) {
        console.warn("[BACKGROUND] resident stop fail: " + code)
      }
    })
  } catch (e) {
    console.warn("[BACKGROUND] resident error: " + e)
  }
}

function migrateFontScale() {
  var storage = require("@system.storage")
  storage.get({
    key: "fontScale",
    success: function(data) {
      var oldScale = parseFloat(data)
      if (oldScale && oldScale >= 0.5) {
        var newSize = Math.round(48 * oldScale)
        storage.set({
          key: "baseFontSize",
          value: String(newSize),
          success: function() {
            storage.delete({ key: "fontScale" })
          }
        })
      }
    }
  })
}

export default {
  onCreate() {
    database.init()
    authStore.initAuth()
    store.getBaseFontSize(function(size) {
      if (!size) {
        store.setBaseFontSize(48)
      }
    })
    migrateFontScale()
    this.initBackgroundRunning()
  },

  initBackgroundRunning() {
    store.getBackgroundRunningConfig(function(config) {
      if (config && config.running) {
        startResident()
      }
    })
  },

  onDestroy() {
    stopResident()
  }
}
</script>