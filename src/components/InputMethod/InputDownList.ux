<!--
  候选「展开更多」面板（三屏共用）

  背景：原先 circle(full) / circle(T9) / rect / pill-shaped 四个分支各写了一份下展实现，且都用 <list>：
  - Vela 上 <list> 存在内容缓存不刷新的问题（详见 InputMethod.ux 中「下展 list 在 Vela 中缓存不刷新」注释）
  - 外层再套 <scroll> 时，<list> 常拿不到正确可视区高度，表现为展开后一片黑
  本组件用「<scroll scroll-y> + <div for>」替代 <list>：
  - 节点常驻（不用 if 反复销毁重建），数据变化即时生效
  - 隐藏时由调用方传空数组，不产生多余节点（保持旧实现的低开销）

  样式一律用模板内联表达式计算，与 InputMethod.ux 现有写法保持一致，不依赖 computed 编译。
-->
<template>
  <div class="idl-panel" style="width: {{widthPct}}%;height: {{height}}px;">
    <scroll class="idl-scroll" scroll-y="{{true}}" style="height: {{height - closeHeight}}px;">
      <div class="idl-row" for="{{items}}" style="height: {{itemHeight}}px;" @click="pickItem(items[$idx])">
        <text class="idl-row-text" style="font-size: {{fontSize}}px;">{{$item}}</text>
      </div>
      <div class="idl-empty" if="{{items.length === 0}}" style="height: {{itemHeight}}px;">
        <text class="idl-empty-text" style="font-size: {{fontSize}}px;">没有更多候选</text>
      </div>
    </scroll>
    <div class="idl-close" style="height: {{closeHeight}}px;" @click="closePanel">
      <text class="idl-close-text">{{closeText}}</text>
    </div>
  </div>
</template>

<script>
export default {
  props: {
    // 候选列表（一维数组）；隐藏时由调用方传空数组
    items: {
      default: []
    },
    // 面板宽度百分比（如 96.4 / 100）
    widthPct: {
      default: 100
    },
    // 面板总高（含底部收起条）
    height: {
      default: 190
    },
    // 单行候选高度
    itemHeight: {
      default: 48
    },
    // 候选字号
    fontSize: {
      default: 28
    },
    // 底部收起条文案
    closeText: {
      default: "收起"
    },
    // 底部收起条高度（≥48，保证胶囊屏可点）
    closeHeight: {
      default: 48
    }
  },

  pickItem(txt) {
    this.$emit("select", { content: txt })
  },

  closePanel() {
    this.$emit("close", {})
  }
}
</script>

<style>
.idl-panel {
  flex-direction: column;
  background-color: #262626;
  border-radius: 22px;
  border: 3px solid rgba(255, 255, 255, 0.06);
  padding-top: 6px;
  overflow: hidden;
}

.idl-scroll {
  flex-direction: column;
  width: 100%;
}

.idl-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding-left: 14px;
  padding-right: 14px;
  flex-shrink: 0;
}

.idl-row-text {
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
  max-width: 100%;
}

.idl-empty {
  width: 100%;
  justify-content: center;
  align-items: center;
}

.idl-empty-text {
  color: #8a8a8a;
}

.idl-close {
  width: 100%;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.08);
}

.idl-close-text {
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
}
</style>
