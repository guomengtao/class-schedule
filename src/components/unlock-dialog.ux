<template>
  <div class="sheet-overlay" show="{{ visible }}" style="background-color: rgba(0,0,0,0.35)" onclick="doCancel">
    <div class="sheet-panel" style="background-color: {{ theme.card }}">
      <div class="sheet-handle-row">
        <div class="sheet-handle" style="background-color: {{ theme.textMuted }}"></div>
      </div>

      <text class="sheet-title" style="color: {{ theme.accent }}">{{ title }}</text>

      <text class="sheet-desc" style="color: {{ theme.textSecondary }}">{{ description }}</text>

      <div class="benefits">
        <div for="{{ benefits }}" class="benefit-row">
          <text class="benefit-icon" style="color: {{ theme.accent }}">✓</text>
          <text class="benefit-text" style="color: {{ theme.text }}">{{ $item }}</text>
        </div>
      </div>

      <div class="btn-row">
        <input class="unlock-btn" type="button" value="立即解锁" onclick="doUnlock"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="cancel-btn" type="button" value="{{ cancelText }}" onclick="doCancel"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../data/store.js")

export default {
  private: {
    visible: false,
    title: "解锁高级功能",
    description: "一次性解锁，永久使用全部高级功能",
    benefits: ["多课表管理", "数据备份与恢复", "首页自定义", "多套主题"],
    cancelText: "暂不需要",
    feature: "",
    onSuccess: null,
    onPayFail: null,
    theme: {
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      bg: "#1a1a2e",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0"
    }
  },

  onInit() {
    var self = this
    store._unlockDialogRef = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onDestroy() {
    if (store._unlockDialogRef === this) {
      store._unlockDialogRef = null
    }
  },

  show(options) {
    options = options || {}
    this.title = options.title || "解锁高级功能"
    this.description = options.description || "一次性解锁，永久使用全部高级功能"
    this.benefits = options.benefits || ["多课表管理", "数据备份与恢复", "首页自定义", "多套主题"]
    this.cancelText = options.cancelText || "暂不需要"
    this.feature = options.feature || ""
    this.onSuccess = options.onSuccess || null
    this.onPayFail = options.onPayFail || null
    this.visible = true
  },

  hide() {
    this.visible = false
  },

  doUnlock() {
    this.hide()
    router.push({ uri: "/pages/activation" })
  },

  doCancel() {
    this.hide()
  }
}
</script>

<style>
.sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: column;
  justify-content: flex-end;
  z-index: 1000;
}

.sheet-panel {
  width: 100%;
  border-radius: 16px 16px 0 0;
  padding: 8px 16px 16px 16px;
  flex-direction: column;
  align-items: center;
}

.sheet-handle-row {
  width: 100%;
  align-items: center;
  margin-bottom: 10px;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
}

.sheet-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 6px;
  text-align: center;
}

.sheet-desc {
  font-size: 11px;
  text-align: center;
  margin-bottom: 10px;
  line-height: 16px;
}

.benefits {
  width: 100%;
  flex-direction: column;
  margin-bottom: 10px;
}

.benefit-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.benefit-icon {
  font-size: 12px;
  margin-right: 6px;
  width: 16px;
  text-align: center;
}

.benefit-text {
  font-size: 12px;
  flex: 1;
}

.btn-row {
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.unlock-btn {
  width: 100%;
  height: 34px;
  border-radius: 17px;
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 6px;
}

.cancel-btn {
  width: 100%;
  height: 28px;
  border-radius: 14px;
  font-size: 12px;
}
</style>