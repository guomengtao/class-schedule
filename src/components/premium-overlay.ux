<template>
  <div class="overlay-modal" if="{{ visible }}" onclick="doCancel">
    <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
      <text class="modal-title" style="color: {{ theme.accent }}">解锁高级功能</text>
      <text class="modal-desc" style="color: {{ theme.textSecondary }}">一次性解锁，永久使用全部高级功能</text>
      <div class="benefit-list">
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 多课表管理</text>
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
      </div>
      <input class="modal-btn-primary" type="button" value="立即解锁" onclick="doUnlock"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="modal-btn-secondary" type="button" value="暂不需要" onclick="doCancel"
             style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../data/store.js")
var premiumOverlay = require("../data/premium-overlay.js")

export default {
  private: {
    visible: false,
    theme: store.DEFAULT_THEME
  },

  onInit() {
    console.log("[PREMIUM-UI] onInit: component created")
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    premiumOverlay._register(self)
    console.log("[PREMIUM-UI] onInit: registered with premiumOverlay module")
  },

  onDestroy() {
    console.log("[PREMIUM-UI] onDestroy: component destroyed")
    premiumOverlay._unregister(this)
  },

  show() {
    console.log("[PREMIUM-UI] show: overlay visible = true")
    this.visible = true
  },

  hide() {
    console.log("[PREMIUM-UI] hide: overlay visible = false")
    this.visible = false
  },

  doUnlock() {
    console.log("[PREMIUM-UI] doUnlock: user clicked '立即解锁', navigating to activation")
    this.hide()
    router.push({ uri: "/pages/activation" })
  },

  doCancel() {
    console.log("[PREMIUM-UI] doCancel: user clicked cancel / tapped outside, go back")
    this.hide()
    router.back()
  },

  stopBubble() {
    console.log("[PREMIUM-UI] stopBubble: tap on card, prevent close")
  }
}
</script>

<style>
.overlay-modal {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.modal-card {
  width: 80%;
  border-radius: 16px;
  padding: 24px 20px;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 8px;
  text-align: center;
}

.modal-desc {
  font-size: 12px;
  text-align: center;
  margin-bottom: 16px;
  line-height: 18px;
}

.benefit-list {
  width: 100%;
  flex-direction: column;
  margin-bottom: 20px;
}

.benefit-item {
  font-size: 13px;
  margin-bottom: 6px;
}

.modal-btn-primary {
  width: 100%;
  height: 36px;
  border-radius: 18px;
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 8px;
}

.modal-btn-secondary {
  width: 100%;
  height: 32px;
  border-radius: 16px;
  font-size: 13px;
}
</style>