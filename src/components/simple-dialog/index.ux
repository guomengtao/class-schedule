<template>
  <div class="overlay" show="{{ visible }}" style="background-color: rgba(0,0,0,0.65)">
    <div class="dialog-box" style="background-color: #16213e">
      <text class="dialog-title" style="color: #7ec8e3">{{ title }}</text>
      <text class="dialog-msg" style="color: #ffffff">{{ message }}</text>
      <input class="dialog-btn" type="button" value="关闭" onclick="hide"
             style="background-color: #7ec8e3; color: #1a1a2e" />
    </div>
  </div>
</template>

<script>
export default {
  props: ['title', 'message'],
  data: {
    visible: false
  },
  onInit() {
    console.log('[simple-dialog] onInit')
  },
  show() {
    console.log('[simple-dialog] show() called')
    this.visible = true
  },
  hide() {
    console.log('[simple-dialog] hide() called')
    this.visible = false
  }
}
</script>

<style>
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dialog-box {
  width: 80%;
  border-radius: 12px;
  padding: 20px 16px;
  flex-direction: column;
  align-items: center;
}

.dialog-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 12px;
  text-align: center;
}

.dialog-msg {
  font-size: 14px;
  margin-bottom: 16px;
  text-align: center;
  line-height: 20px;
}

.dialog-btn {
  width: 100%;
  height: 36px;
  border-radius: 18px;
  font-size: 14px;
  font-weight: bold;
}
</style>