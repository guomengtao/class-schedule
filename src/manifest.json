{
  "package": "com.application.watch.classschedule",
  "name": "Ev课程表",
  "versionName": "1.4.203",
  "versionCode": 703,
  "minPlatformVersion": 1000,
  "icon": "logo.png",
  "deviceTypeList": [
    "watch",
    "band"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.sqlite"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.prompt"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.configuration"
    },
    {
      "name": "system.alarm",
      "permissionDesc": "用于在课程开始时震动提醒您"
    },
    {
      "name": "system.calendar",
      "permissionDesc": "用于将课程信息同步到系统日历"
    },
    {
      "name": "system.request"
    },
    {
      "name": "system.resident",
      "permissionDesc": "用于保持应用在后台继续运行"
    },
    {
      "name": "system.app"
    }
  ],
  "permissions": [
    {
      "name": "hapjs.permission.DEVICE_INFO"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width",
    "background": {
      "features": [
        "system.request",
        "system.resident"
      ]
    }
  },
  "router": {
    "entry": "pages/welcome",
