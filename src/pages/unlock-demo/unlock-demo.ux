<import name="unlock-dialog" src="../../components/unlock-dialog"></import>

<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">弹窗 Demo</text>
    </div>

    <scroll class="page-scroll" scroll-y="{{true}}">
      <text class="section-title" style="color: {{ theme.text }}">弹窗核心实现测试</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">点击下方按钮触发不同类型的解锁弹窗，测试弹窗组件的核心功能</text>

      <div class="demo-card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">场景1: 默认弹窗</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">使用默认标题和权益列表，模拟标准的高级功能解锁提示</text>
        <input class="demo-btn" type="button" value="触发默认弹窗" onclick="showDefaultDialog"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="demo-card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">场景2: 自定义弹窗</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">自定义标题和权益列表，模拟特定功能的解锁提示</text>
        <input class="demo-btn" type="button" value="触发自定义弹窗" onclick="showCustomDialog"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="demo-card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">场景3: 数据备份弹窗</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">模拟数据备份功能的解锁提示，与 backup-restore 页面一致</text>
        <input class="demo-btn" type="button" value="触发备份弹窗" onclick="showBackupDialog"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="demo-card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">场景4: 多课表弹窗</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">模拟多课表管理功能的解锁提示</text>
        <input class="demo-btn" type="button" value="触发多课表弹窗" onclick="showScheduleDialog"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="demo-card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">场景5: 首页自定义弹窗</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">模拟首页自定义功能的解锁提示</text>
        <input class="demo-btn" type="button" value="触发首页自定义弹窗" onclick="showHomepageDialog"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="demo-card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">场景6: 取消按钮自定义</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">自定义取消按钮文案，验证 cancelText 参数</text>
        <input class="demo-btn" type="button" value="触发自定义取消按钮" onclick="showCustomCancelDialog"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="bottom-spacer"></div>
    </scroll>

    <unlock-dialog id="unlockDialog"></unlock-dialog>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  showDefaultDialog() {
    store.showUnlockDialog()
  },

  showCustomDialog() {
    store.showUnlockDialog({
      title: "解锁全部功能",
      benefits: ["无限制添加课程", "云端数据同步", "智能课表推荐", "20套精美主题", "优先技术支持"],
      cancelText: "继续使用标准版"
    })
  },

  showBackupDialog() {
    store.showUnlockDialog({
      title: "解锁数据备份",
      benefits: ["多课表管理", "数据备份与恢复", "首页自定义", "10套主题"],
      cancelText: "继续使用标准版"
    })
  },

  showScheduleDialog() {
    store.showUnlockDialog({
      title: "解锁多课表管理",
      benefits: ["多课表管理", "数据备份与恢复", "首页自定义", "10套主题"],
      cancelText: "继续使用标准版"
    })
  },

  showHomepageDialog() {
    store.showUnlockDialog({
      title: "解锁首页自定义",
      benefits: ["多课表管理", "数据备份与恢复", "首页自定义", "10套主题"],
      cancelText: "继续使用标准版"
    })
  },

  showCustomCancelDialog() {
    store.showUnlockDialog({
      title: "升级高级版",
      benefits: ["多课表管理", "数据备份与恢复", "首页自定义", "10套主题"],
      cancelText: "暂不升级"
    })
  },

  goBack() {
    router.back()
  }
}
</script>

