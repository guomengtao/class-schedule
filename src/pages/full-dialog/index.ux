<template>
  <div class="page" style="background-color: #1a1a2e">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" />
      <text class="title">完整弹窗</text>
      <input class="pin-btn" type="button" value="📌钉首页" onclick="pinToHome" />
    </div>

    <div class="poem-preview">
      <text class="poem-title">《将进酒》</text>
      <text class="poem-author">—— 李白</text>
      <text class="poem-line">君不见黄河之水天上来</text>
      <text class="poem-line">奔流到海不复回</text>
      <text class="poem-line">君不见高堂明镜悲白发</text>
      <text class="poem-line">朝如青丝暮成雪</text>
      <text class="poem-more">……</text>
    </div>

    <input class="demo-btn" type="button" value="打开弹窗查看全文" onclick="showDialog" />

    <text class="log-text">{{ logText }}</text>

    <div class="overlay" show="{{ dialogVisible }}" onclick="hideDialog">
      <div class="dialog-box" onclick="stopPropagation">
        <text class="dialog-title">《将进酒》—— 李白</text>
        <text class="dialog-message">{{ poemText }}</text>
        <input class="dialog-btn" type="button" value="关闭" onclick="hideDialog" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
var pinHelper = require("../../data/pin-helper.js")

var POEM = '君不见黄河之水天上来，奔流到海不复回。\n君不见高堂明镜悲白发，朝如青丝暮成雪。\n人生得意须尽欢，莫使金樽空对月。\n天生我材必有用，千金散尽还复来。\n烹羊宰牛且为乐，会须一饮三百杯。\n岑夫子，丹丘生，将进酒，杯莫停。\n与君歌一曲，请君为我倾耳听。\n钟鼓馔玉不足贵，但愿长醉不复醒。\n古来圣贤皆寂寞，惟有饮者留其名。\n陈王昔时宴平乐，斗酒十千恣欢谑。\n主人何为言少钱，径须沽取对君酌。\n五花马，千金裘，\n呼儿将出换美酒，与尔同销万古愁。'

export default {
  private: {
    dialogVisible: false,
    poemText: POEM,
    logText: '点击上方按钮查看完整诗歌',
    pinned: false
  },

  onInit() {
    var self = this
    pinHelper.isPinned("/pages/full-dialog", function(pinned) {
      self.pinned = pinned
    })
  },

  showDialog() {
    this.dialogVisible = true
    this.logText = '弹窗已打开'
  },

  hideDialog() {
    this.dialogVisible = false
    this.logText = '弹窗已关闭'
  },

  stopPropagation() {
  },

  pinToHome() {
    var self = this
    pinHelper.pinPage("完整弹窗", "/pages/full-dialog", function() {
      self.pinned = true
    })
  },

  goBack() {
    router.back()
  }
}
</script>

