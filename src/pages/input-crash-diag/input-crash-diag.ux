<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">输入法崩溃诊断</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 崩溃回执：重启后重新打开本页，第一眼就能看到上次崩在哪一步 -->
    <div class="crash-bar" if="{{ crashStep }}">
      <text class="crash-text">上次崩在第 {{ crashStep }} 步：{{ crashName }}</text>
    </div>

    <div class="env-bar" style="background-color: {{ theme.card }}">
      <text class="env-text" style="color: {{ theme.accent }}">版本 {{ versionText }} · {{ envText }}</text>
      <text class="env-text" style="color: {{ theme.textMuted }}">已通过：{{ passedText }}</text>
      <text class="env-hint" style="color: {{ theme.textSecondary }}">每步结果即时落盘，重启后回本页即可看到进度</text>
    </div>

    <scroll class="body" scroll-y="true">
      <!-- ===== 第二轮：键盘 UI 元素级细分（第一轮第 3 步已崩，重点跑这个） ===== -->
      <div class="sec-title">
        <text class="sec-title-text" style="color: {{ theme.accent }}">第二轮：键盘元素细分（A→F）</text>
      </div>

      <div class="cell">
        <div class="btn-item btn-main" onclick="runAll2">
          <text class="btn-label btn-main-label">★ 一键跑第二轮（建议先点这个）</text>
        </div>
        <text class="item-hint" style="color: {{ theme.textSecondary }}">按顺序自动跑 A→F，逐项隔离：文本 / 圆角描边 / 横滚 / 图片 / 绝对定位 / 完整键盘</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(6)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">A. 纯文本 ×26</text>
        </div>
        <text class="item-hint" style="color: {{ theme.textSecondary }}">26 个裸 text，无尺寸/边框/圆角/背景</text>
        <text class="item-res" if="{{ r.s6 }}" style="color: {{ r.s6.ok ? theme.text : '#e74c3c' }}">{{ r.s6.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(7)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">B. 圆角描边按键 ×26</text>
        </div>
        <text class="item-hint" style="color: {{ theme.textSecondary }}">复刻 .calbtn66：60×60 + border 3px + radius 30px</text>
        <text class="item-res" if="{{ r.s7 }}" style="color: {{ r.s7.ok ? theme.text : '#e74c3c' }}">{{ r.s7.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(8)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">C. 横向 scroll 容器</text>
        </div>
        <text class="item-hint" style="color: {{ theme.textSecondary }}">1 个 scroll-x 内含 3 排纯文本</text>
        <text class="item-res" if="{{ r.s8 }}" style="color: {{ r.s8.ok ? theme.text : '#e74c3c' }}">{{ r.s8.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(9)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">D. PNG 图片 ×8</text>
        </div>
        <text class="item-hint" style="color: {{ theme.textSecondary }}">只渲染 arc/ 下的 8 张键盘素材</text>
        <text class="item-res" if="{{ r.s9 }}" style="color: {{ r.s9.ok ? theme.text : '#e74c3c' }}">{{ r.s9.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(10)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">E. 绝对定位堆叠</text>
        </div>
        <text class="item-hint" style="color: {{ theme.textSecondary }}">3 层 absolute 文本层，无图片无 scroll 无圆角</text>
        <text class="item-res" if="{{ r.s10 }}" style="color: {{ r.s10.ok ? theme.text : '#e74c3c' }}">{{ r.s10.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(11)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">F. 完整 pill 键盘（对照）</text>
        </div>
        <text class="item-hint" style="color: {{ theme.textSecondary }}">真实组件，不加载词典（= 第一轮第 3 步）</text>
        <text class="item-res" if="{{ r.s11 }}" style="color: {{ r.s11.ok ? theme.text : '#e74c3c' }}">{{ r.s11.value }}</text>
      </div>

      <!-- ===== 第一轮：存储 / 词典 / 端到端 ===== -->
      <div class="sec-title">
        <text class="sec-title-text" style="color: {{ theme.textSecondary }}">第一轮：存储 / 词典 / 端到端（1→5）</text>
      </div>

      <div class="cell">
        <div class="btn-item btn-main2" onclick="runAll">
          <text class="btn-label" style="color: {{ theme.bg }}">★ 一键跑第一轮（1→5）</text>
        </div>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(1)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">1. 并发写 ×5</text>
        </div>
        <text class="item-res" if="{{ r.s1 }}" style="color: {{ r.s1.ok ? theme.text : '#e74c3c' }}">{{ r.s1.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(2)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">2. 并发读 ×7</text>
        </div>
        <text class="item-res" if="{{ r.s2 }}" style="color: {{ r.s2.ok ? theme.text : '#e74c3c' }}">{{ r.s2.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(3)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">3. 建键盘（不加载词典）</text>
        </div>
        <text class="item-res" if="{{ r.s3 }}" style="color: {{ r.s3.ok ? theme.text : '#e74c3c' }}">{{ r.s3.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(4)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">4. 加载词典</text>
        </div>
        <text class="item-res" if="{{ r.s4 }}" style="color: {{ r.s4.ok ? theme.text : '#e74c3c' }}">{{ r.s4.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="runOne(5)" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">5. 跳转真实输入页</text>
        </div>
        <text class="item-res" if="{{ r.s5 }}" style="color: {{ r.s5.ok ? theme.text : '#e74c3c' }}">{{ r.s5.value }}</text>
      </div>

      <!-- ===== 测试宿主区：按当前步骤渲染不同内容 ===== -->
      <div class="stage" if="{{ stage === 'A' }}">
        <div class="kbd-row" for="row in keyRows">
          <text class="k-plain" for="k in row">{{k}}</text>
        </div>
      </div>

      <div class="stage" if="{{ stage === 'B' }}">
        <div class="kbd-row" for="row in keyRows">
          <text class="k-btn66" for="k in row">{{k}}</text>
        </div>
      </div>

      <div class="stage" if="{{ stage === 'C' }}">
        <scroll class="kbd-scroll" scroll-x="true">
          <div class="kbd-col">
            <div class="kbd-row" for="row in keyRows">
              <text class="k-plain" for="k in row">{{k}}</text>
            </div>
          </div>
        </scroll>
      </div>

      <div class="stage" if="{{ stage === 'D' }}">
        <image class="png-item" src="/components/InputMethod/assets/arc/search.png"></image>
        <image class="png-item" src="/components/InputMethod/assets/arc/cn.png"></image>
        <image class="png-item" src="/components/InputMethod/assets/arc/123.png"></image>
        <image class="png-item" src="/components/InputMethod/assets/arc/del.png"></image>
        <image class="png-item" src="/components/InputMethod/assets/arc/space.png"></image>
        <image class="png-item" src="/components/InputMethod/assets/arc/back2.png"></image>
        <image class="png-item" src="/components/InputMethod/assets/arc/a.png"></image>
        <image class="png-item" src="/components/InputMethod/assets/arc/bigA.png"></image>
      </div>

      <div class="stage" if="{{ stage === 'E' }}">
        <div class="abs-box">
          <div class="abs-row" style="top: 0px;">
            <text class="k-plain" for="k in keyRows[0]">{{k}}</text>
          </div>
          <div class="abs-row" style="top: 60px;">
            <text class="k-plain" for="k in keyRows[1]">{{k}}</text>
          </div>
          <div class="abs-row" style="top: 120px;">
            <text class="k-plain" for="k in keyRows[2]">{{k}}</text>
          </div>
        </div>
      </div>

      <div class="ime-host" if="{{ showIme }}">
        <input-method
          hide="{{ false }}"
          keyboardtype="QWERTY"
          maxlength="10"
          screentype="{{ imeScreenType }}"
          dictlazy="{{ dictLazy }}"
        ></input-method>
      </div>

      <!-- 二维码回传：方案暂缓（用户要求），已移除渲染；相关逻辑保留在脚本中待后续讨论 -->

      <div class="cell">
        <div class="btn-item" onclick="resetAll" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.textSecondary }}">清空记录</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
var device = require("@system.device")
var storage = require("@system.storage")
var store = require("../../data/store.js")
var version = require("../../data/version.js")

// 进度落盘：测试前写入步骤号，测试完成清空。
// 若中途重启，该值会保留 → 重新打开本页即可知道"上次崩在第几步"。
var STEP_KEY = "input_diag_step"
var PASS_KEY = "input_diag_passed"

// 诊断回传 URL（与激活页同域名，未识别参数会被忽略，开发者从地址栏取 URL 解析即可）
// 只保留定位问题的最小充分集，控制二维码密度，保证 192px 小屏也能扫出
var DIAG_BASE = "https://app-auth.gudq.com/activate.html?"

var STEP_NAME = {
  "1": "并发写 ×5",
  "2": "并发读 ×7",
  "3": "建键盘（不加载词典）",
  "4": "加载词典",
  "5": "跳转真实输入页",
  "6": "A 纯文本 ×26",
  "7": "B 圆角描边按键 ×26",
  "8": "C 横向 scroll",
  "9": "D PNG 图片 ×8",
  "10": "E 绝对定位堆叠",
  "11": "F 完整 pill 键盘"
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    versionText: "",
    envText: "读取中",
    passedText: "（无）",
    crashStep: "",
    crashName: "",
    screenShape: "",
    screenW: "",
    screenH: "",
    diagUrl: "",
    keyRows: [
      ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
      ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
      ["Z", "X", "C", "V", "B", "N", "M"]
    ],
    stage: "",
    showIme: false,
    dictLazy: true,
    imeScreenType: "pill-shaped",
    passed: [],
    running: false,
    r: {
      s1: null, s2: null, s3: null, s4: null, s5: null,
      s6: null, s7: null, s8: null, s9: null, s10: null, s11: null
    }
  },

  onInit() {
    var self = this
    self.versionText = version.versionName || "(未知)"
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    device.getInfo({
      success: function(d) {
        var shape = d.screenShape || "?"
        if (shape === "capsule") { shape = "pill-shaped" }
        self.imeScreenType = shape
        self.screenShape = shape
        self.screenW = String(d.screenWidth || "")
        self.screenH = String(d.screenHeight || "")
        self.envText = shape + " " + (d.screenWidth || "?") + "x" + (d.screenHeight || "?")
        self.updateDiagUrl()
      },
      fail: function() { self.envText = "获取失败" }
    })
    self.loadState()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    self.loadState()
  },

  loadState() {
    var self = this
    storage.get({
      key: STEP_KEY,
      success: function(data) {
        // 有值 = 上次进入该步骤后没能标记完成 = 崩在这一步
        if (data) {
          self.crashStep = String(data)
          self.crashName = STEP_NAME[String(data)] || ""
        }
        self.updateDiagUrl()
      },
      fail: function() {}
    })
    storage.get({
      key: PASS_KEY,
      success: function(data) {
        if (data) {
          self.passed = String(data).split(",")
          self.passedText = String(data)
          self.updateDiagUrl()
        }
      },
      fail: function() {}
    })
  },

  // ===== 诊断回传 URL：只带最小充分集，控制二维码密度 =====
  // 字段：r=版本 / s=屏型 / w,h=分辨率 / c=渠道 / kb=键盘分支 / dg=崩溃步骤.已通过
  updateDiagUrl() {
    var self = this
    var q = []
    q.push('r=' + encodeURIComponent(self.versionText))
    if (self.screenShape) { q.push('s=' + encodeURIComponent(self.screenShape)) }
    if (self.screenW) { q.push('w=' + self.screenW) }
    if (self.screenH) { q.push('h=' + self.screenH) }
    q.push('c=' + encodeURIComponent(version.channel || ''))
    q.push('kb=' + (self.screenShape === 'rect' ? 'r' : (self.screenShape === 'circle' ? 'c' : 'p')))
    var dg = self.crashStep ? self.crashStep : '0'
    q.push('dg=' + dg + '.' + (self.passed || []).join(''))
    self.diagUrl = DIAG_BASE + q.join('&')
  },

  // ===== 第二轮：A→F =====
  runAll2() {
    var self = this
    if (self.running) return
    self.running = true
    self.runSeq([6, 7, 8, 9, 10, 11], 0)
  },

  // ===== 第一轮：1→5 =====
  runAll() {
    var self = this
    if (self.running) return
    self.running = true
    self.runSeq([1, 2, 3, 4, 5], 0)
  },

  runSeq(list, i) {
    var self = this
    if (i >= list.length) { self.running = false; return }
    self.runStep(list[i], function() {
      setTimeout(function() { self.runSeq(list, i + 1) }, 800)
    })
  },

  runOne(step) {
    var self = this
    if (self.running) return
    self.running = true
    self.runStep(step, function() { self.running = false })
  },

  runStep(step, onDone) {
    var self = this
    // 先落盘"正在执行第 N 步"，再执行可能崩溃的操作
    storage.set({
      key: STEP_KEY,
      value: String(step),
      success: function() { self.execStep(step, onDone) },
      fail: function() { self.execStep(step, onDone) }
    })
  },

  execStep(step, onDone) {
    var self = this
    // 延时确保进度落盘完成后再执行
    setTimeout(function() {
      // 先把上一轮留下的宿主清干净，保证每步都在干净状态开始
      self.stage = ''
      self.showIme = false
      setTimeout(function() {
        self.doStep(step, function(ok, value) {
          self.setRes("s" + step, ok, value)
          if (ok) { self.markPass(step) }
          storage.set({ key: STEP_KEY, value: "" })
          self.updateDiagUrl()
          if (onDone) { onDone(ok) }
        })
      }, 300)
    }, 400)
  },

  doStep(step, finish) {
    var self = this
    if (step === 1) {
      var n = 0
      var one = function() { n++; if (n >= 5) finish(true, "5 次并发写完成，未崩溃") }
      storage.set({ key: "diag_t_title", value: "编辑昵称", success: one, fail: one })
      storage.set({ key: "diag_t_ph", value: "输入昵称", success: one, fail: one })
      storage.set({ key: "diag_t_val", value: "abc", success: one, fail: one })
      storage.set({ key: "diag_t_max", value: "12", success: one, fail: one })
      storage.set({ key: "diag_t_ret", value: "chinese_input_nickname_result", success: one, fail: one })
      return
    }
    if (step === 2) {
      var m = 0
      var two = function() { m++; if (m >= 7) finish(true, "7 次并发读完成，未崩溃") }
      storage.get({ key: "diag_t_title", success: two, fail: two })
      storage.get({ key: "diag_t_ph", success: two, fail: two })
      storage.get({ key: "diag_t_val", success: two, fail: two })
      storage.get({ key: "diag_t_max", success: two, fail: two })
      storage.get({ key: "diag_t_ret", success: two, fail: two })
      store.getTheme(function() { two() })
      store.getThemeName(function() { two() })
      return
    }
    if (step === 3) {
      self.dictLazy = true
      self.showIme = true
      setTimeout(function() { finish(true, "键盘已挂载，未崩溃（未加载词典）") }, 2500)
      return
    }
    if (step === 4) {
      self.showIme = false
      setTimeout(function() {
        self.dictLazy = false
        self.showIme = true
        setTimeout(function() { finish(true, "词典加载完成，未崩溃") }, 4000)
      }, 600)
      return
    }
    if (step === 5) {
      finish(true, "已发起跳转，正在进入真实输入页…")
      setTimeout(function() { router.push({ uri: "/pages/chinese-input" }) }, 600)
      return
    }
    if (step === 6) {
      self.stage = 'A'
      setTimeout(function() { finish(true, "A 通过：26 个纯文本渲染正常") }, 2000)
      return
    }
    if (step === 7) {
      self.stage = 'B'
      setTimeout(function() { finish(true, "B 通过：26 个圆角描边按键渲染正常") }, 2500)
      return
    }
    if (step === 8) {
      self.stage = 'C'
      setTimeout(function() { finish(true, "C 通过：横向 scroll 渲染正常") }, 2000)
      return
    }
    if (step === 9) {
      self.stage = 'D'
      setTimeout(function() { finish(true, "D 通过：8 张 PNG 渲染正常") }, 2500)
      return
    }
    if (step === 10) {
      self.stage = 'E'
      setTimeout(function() { finish(true, "E 通过：绝对定位堆叠渲染正常") }, 2000)
      return
    }
    if (step === 11) {
      self.dictLazy = true
      self.showIme = true
      setTimeout(function() { finish(true, "F 通过：完整 pill 键盘渲染正常") }, 2500)
      return
    }
    finish(false, "未知步骤")
  },

  setRes(key, ok, value) {
    var o = this.r
    this.r = {
      s1: o.s1, s2: o.s2, s3: o.s3, s4: o.s4, s5: o.s5,
      s6: o.s6, s7: o.s7, s8: o.s8, s9: o.s9, s10: o.s10, s11: o.s11
    }
    this.r[key] = { ok: ok, value: value }
  },

  markPass(step) {
    var list = this.passed || []
    if (list.indexOf(String(step)) === -1) { list.push(String(step)) }
    this.passedText = list.join(",")
    storage.set({ key: PASS_KEY, value: this.passedText })
  },

  resetAll() {
    var self = this
    storage.set({ key: STEP_KEY, value: "" })
    storage.set({ key: PASS_KEY, value: "" })
    self.passed = []
    self.passedText = "（无）"
    self.crashStep = ""
    self.crashName = ""
    self.stage = ""
    self.showIme = false
    self.r = {
      s1: null, s2: null, s3: null, s4: null, s5: null,
      s6: null, s7: null, s8: null, s9: null, s10: null, s11: null
    }
    self.updateDiagUrl()
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 8px 8px 6px 8px;
}

.crash-bar {
  background-color: #4a1010;
  border-radius: 8px;
  padding: 8px 12px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.crash-text {
  color: #ff6b6b;
  font-size: 24px;
  line-height: 32px;
  lines: 0;
  font-weight: bold;
}

.env-bar {
  flex-direction: column;
  border-radius: 8px;
  padding: 8px 12px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.env-text {
  font-size: 22px;
  line-height: 30px;
  lines: 1;
}

.env-hint {
