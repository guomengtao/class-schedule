<template>
  <div class="input-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="返回" onclick="onCancel" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">{{ title }}</text>
      <input class="confirm-btn" type="button" value="确认" onclick="onConfirm" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="content-body" if="{{ ready }}">
      <div class="display-area" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="display-text" style="font-size: {{ inputFontSize }}px; color: {{ theme.text }}">{{ inputValue || placeholder }}</text>
        <text class="cursor" show="{{ showCursor }}" style="font-size: {{ inputFontSize }}px; color: {{ theme.accent }}">_</text>
      </div>

      <div class="pinyin-row" show="{{ !hideKeyboard && cval }}">
        <text class="pinyin-text" style="color: {{ theme.accent }}">{{ cvalDisplay }}</text>
      </div>

      <scroll class="candidate-row" show="{{ !hideKeyboard && resultRow0.length > 0 }}" scroll-x="{{true}}">
        <text for="{{ item in resultRow0 }}" class="candidate-item" onclick="onSelectCandidate(item)" style="background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
      </scroll>

      <div class="keyboard" show="{{ !hideKeyboard }}">
        <div class="key-row" show="{{ !numFlag }}">
          <text for="{{ item in keys.full[0] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ !numFlag }}">
          <text for="{{ item in keys.full[1] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ !numFlag }}">
          <text for="{{ item in keys.full[2] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          <text class="key-btn key-del" onclick="onDeleteKey" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
        </div>

        <div class="key-row" show="{{ numFlag }}">
          <text for="{{ item in keys.sign[0] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ numFlag }}">
          <text for="{{ item in keys.sign[1] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ numFlag }}">
          <text for="{{ item in keys.sign[2] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          <text class="key-btn key-del" onclick="onDeleteKey" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
        </div>

        <div class="key-row key-bottom">
          <text class="key-btn key-func" onclick="toggleNumMode" show="{{ lang === 'cn' || numFlag }}" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ numFlag ? 'ABC' : '123' }}</text>
          <text class="key-btn key-func" onclick="toggleShift" show="{{ lang === 'en' && !numFlag }}" style="font-size: {{ keyFontSize }}px; background-color: {{ shiftFlag ? theme.accent : theme.card }}; color: {{ shiftFlag ? theme.bg : theme.accent }}">Shift</text>
          <text class="key-btn key-func" onclick="toggleLang" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ lang === 'cn' ? 'EN' : '中' }}</text>
        </div>
      </div>

      <div class="font-bar" show="{{ !hideKeyboard }}">
        <text class="font-label" style="color: {{ theme.textSecondary }}">字体:</text>
        <text class="font-btn" onclick="setInputFontSize(20)" style="background-color: {{ baseFontSize === 20 ? theme.accent : theme.card }}; color: {{ baseFontSize === 20 ? theme.bg : theme.text }}">20</text>
        <text class="font-btn" onclick="setInputFontSize(24)" style="background-color: {{ baseFontSize === 24 ? theme.accent : theme.card }}; color: {{ baseFontSize === 24 ? theme.bg : theme.text }}">24</text>
        <text class="font-btn" onclick="setInputFontSize(28)" style="background-color: {{ baseFontSize === 28 ? theme.accent : theme.card }}; color: {{ baseFontSize === 28 ? theme.bg : theme.text }}">28</text>
        <text class="font-btn" onclick="setInputFontSize(36)" style="background-color: {{ baseFontSize === 36 ? theme.accent : theme.card }}; color: {{ baseFontSize === 36 ? theme.bg : theme.text }}">36</text>
        <text class="font-btn" onclick="setInputFontSize(48)" style="background-color: {{ baseFontSize === 48 ? theme.accent : theme.card }}; color: {{ baseFontSize === 48 ? theme.bg : theme.text }}">48</text>
        <text class="font-btn" onclick="setInputFontSize(60)" style="background-color: {{ baseFontSize === 60 ? theme.accent : theme.card }}; color: {{ baseFontSize === 60 ? theme.bg : theme.text }}">60</text>
      </div>
    </div>

    <text class="footer-text" style="color: {{ theme.textSecondary }}">中文输入法</text>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import storage from "@system.storage"
const store = require("../../data/store.js")
import { SimpleInputMethod } from "../../components/InputMethod/assets/dicUtil.js"

var dictReady = false
var INPUT_FONT_KEY = "inputFontSize"
var INPUT_FONT_DEFAULT = 36

function ensureDict() {
  if (!dictReady) {
    dictReady = true
    SimpleInputMethod.initDict()
  }
}

function getInputFontSize(callback) {
  storage.get({
    key: INPUT_FONT_KEY,
    success: function(data) {
      var size = parseInt(data) || INPUT_FONT_DEFAULT
      if (size < 20) size = 20
      if (size > 60) size = 60
      callback(size)
    },
    fail: function() { callback(INPUT_FONT_DEFAULT) }
  })
}

function setInputFontSizeStore(size, callback) {
  storage.set({
    key: INPUT_FONT_KEY,
    value: String(size),
    success: function() { if (callback) callback() },
    fail: function() { if (callback) callback() }
  })
}

export default {
  private: {
    title: "输入",
    placeholder: "点击输入",
    inputValue: "",
    maxlen: 5,
    theme: store.DEFAULT_THEME,
    hideKeyboard: true,
    showCursor: false,
    ready: false,
    returnKey: "chinese_input_result",
    inputFontSize: 0,
    keyFontSize: 0,
    baseFontSize: 0,
    cval: "",
    cvalDisplay: "",
    lang: "cn",
    numFlag: false,
    shiftFlag: false,
    resultRow0: [],
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"]
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["-", "/", ":", ";", "(", ")", "$", "&", "@", "\""],
        [".", ",", "?", "!", "'"]
      ]
    }
  },

  onInit() {
  },

  onShow() {
    var self = this

    self.ready = false
    self.hideKeyboard = true

    getInputFontSize(function(size) {
      self.baseFontSize = size
      self.applyFontSize(size)
      self.ready = true
      self.showKeyboard()
    })

    storage.get({
      key: "chinese_input_title",
      success: function(data) { if (data) self.title = data },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_placeholder",
      success: function(data) { if (data) self.placeholder = data },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_value",
      success: function(data) {
        if (data !== undefined && data !== null) self.inputValue = data
      },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_maxlen",
      success: function(data) { if (data) self.maxlen = parseInt(data) || 5 },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_return_key",
      success: function(data) { if (data) self.returnKey = data },
      fail: function() {}
    })
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.showCursor = true
    ensureDict()
  },

  doVibrate() {
    vibrator.vibrate({ mode: "short" })
  },

  setInputFontSize(size) {
    var self = this
    self.baseFontSize = size
    setInputFontSizeStore(size, function() {
      self.applyFontSize(size)
    })
  },

  applyFontSize(size) {
    if (!size || size < 20) size = INPUT_FONT_DEFAULT
    this.inputFontSize = size
    this.keyFontSize = Math.round(size * 0.6)
  },

  onKeyPress(item) {
    if (!item) return
    this.doVibrate()

    if (this.lang === "cn" && !this.numFlag) {
      this.cval += item.toLowerCase()
      this.updateCandidates()
    } else {
      if (this.inputValue.length >= this.maxlen) return
      var char = item
      if (this.lang === "en" && !this.numFlag && !this.shiftFlag) {
        char = item.toLowerCase()
      }
      this.inputValue += char
    }
  },

  onDeleteKey() {
    this.doVibrate()
    if (this.cval.length > 0) {
      this.cval = this.cval.slice(0, -1)
      this.updateCandidates()
    } else {
      this.inputValue = this.inputValue.slice(0, -1)
    }
  },

  onSpace() {
    this.doVibrate()
    if (this.inputValue.length >= this.maxlen) return
    this.inputValue += " "
  },

  onSelectCandidate(item) {
    if (!item) return
    this.doVibrate()

    if (this.inputValue.length >= this.maxlen) return

    var consumed = false
    if (item.length === 1 && this._sylTopChars && this._sylTopChars.length > 0 && this.cval.length > 0) {
      for (var si = 0; si < this._sylTopChars.length; si++) {
        var sc = this._sylTopChars[si]
        if (sc.char === item && sc.offset > 0 && sc.offset <= this.cval.length) {
          this.cval = this.cval.slice(sc.offset)
          this.inputValue += item
          consumed = true
          break
        }
      }
    }

    if (!consumed && this._matchedLen > 0 && this.cval.length > this._matchedLen) {
      this.cval = this.cval.slice(this._matchedLen)
      this.inputValue += item
      consumed = true
    }

    if (!consumed) {
      this.cval = ""
      this.inputValue += item
    }

    this.updateCandidates()
  },

  updateCandidates() {
    var self = this
    this.cvalDisplay = SimpleInputMethod.getSegmentedDisplay(this.cval)

    if (!this.cval || this.lang !== "cn") {
      this.resultRow0 = []
      this._sylTopChars = []
      this._matchedLen = 0
      return
    }

    var result = SimpleInputMethod.getHanzi(this.cval, "cn")
    var chars = result.chars || []
    this._matchedLen = result.matched ? result.matched.length : 0

    var multi = result.multi || { words: [], composed: "", sylTopChars: [] }
    var words = (multi.words || []).slice()
    if (words.length === 0 && multi.composed && multi.composed.length >= 2) {
      words = [multi.composed]
    } else if (multi.composed && multi.composed.length >= 2 && words.indexOf(multi.composed) === -1) {
      words.push(multi.composed)
    }

    var sylTopChars = (multi.sylTopChars || []).filter(function(sc) { return sc.char && sc.offset > 0 })
    self._sylTopChars = sylTopChars

    var sylOnlyChars = sylTopChars.map(function(sc) { return sc.char })
    var seen = {}
    var uniqueSylChars = []
    for (var si = 0; si < sylOnlyChars.length; si++) {
      if (!seen[sylOnlyChars[si]]) { seen[sylOnlyChars[si]] = 1; uniqueSylChars.push(sylOnlyChars[si]) }
    }
    for (var sj = 0; sj < uniqueSylChars.length; sj++) {
      if (words.indexOf(uniqueSylChars[sj]) === -1) { words.push(uniqueSylChars[sj]) }
    }

    var row0 = []
    var cap = parseInt(this.maxlen) || 5
    for (var i = 0; i < words.length && row0.length < cap; i++) {
      row0.push(words[i])
    }
    for (var j = 0; j < chars.length && row0.length < cap; j++) {
      if (words.indexOf(chars[j]) === -1) {
        row0.push(chars[j])
      }
    }
    this.resultRow0 = row0
  },

  toggleNumMode() {
    this.doVibrate()
    this.numFlag = !this.numFlag
    this.cval = ""
    this.resultRow0 = []
    this.cvalDisplay = ""
  },

  toggleLang() {
    this.doVibrate()
    this.lang = this.lang === "cn" ? "en" : "cn"
    this.cval = ""
    this.resultRow0 = []
    this.cvalDisplay = ""
    this.shiftFlag = false
  },

  toggleShift() {
    this.doVibrate()
    this.shiftFlag = !this.shiftFlag
  },

  onConfirm() {
    var result = this.inputValue.trim()
    this.returnResult(result)
  },

  onCancel() {
    this.returnResult(null)
  },

  returnResult(result) {
    var storage = require("@system.storage")
    var returnKey = this.returnKey || "chinese_input_result"
    var value = result !== null ? result : ""

    storage.set({
      key: returnKey,
      value: value,
      success: function() {
        router.back()
      },
      fail: function() { router.back() }
    })
  },

  goBack() {
    this.onCancel()
  }
}
</script>

<style>
.input-page {
  flex-direction: column;
  padding: 44px 8px 12px 8px;
  height: 100%;
}

.content-body {
  flex-direction: column;
  flex: 1;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 52px;
  margin-bottom: 8px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.confirm-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: bold;
  text-align: center;
}

.display-area {
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
  border-width: 2px;
  padding: 8px 12px;
  margin-bottom: 4px;
  min-height: 40px;
}

.display-text {
  flex: 1;
}

.cursor {
  margin-left: 2px;
}

.pinyin-row {
  min-height: 22px;
  padding: 2px 0;
  margin-bottom: 2px;
  padding-left: 8px;
}

.pinyin-text {
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.candidate-row {
  min-height: 36px;
  margin-bottom: 4px;
  padding: 4px 4px;
}

.candidate-item {
  padding: 4px 10px;
  margin-right: 4px;
  border-radius: 6px;
  text-align: center;
}

.keyboard {
  flex-direction: column;
  align-items: stretch;
  margin-top: 2px;
  width: 100%;
}

.key-row {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.key-btn {
  font-weight: bold;
  text-align: center;
  flex: 1;
  min-height: 28px;
  border-radius: 6px;
  margin-left: 2px;
  margin-right: 2px;
  max-width: 60px;
}

.key-del {
  max-width: 60px;
  flex: 1;
}

.key-func {
  flex: 1;
  max-width: 60px;
  min-height: 28px;
  font-weight: bold;
  text-align: center;
  border-radius: 6px;
  margin-left: 2px;
  margin-right: 2px;
  lines: 1;
  text-overflow: ellipsis;
}

.key-bottom {
  margin-bottom: 0;
}

.font-bar {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 8px 0 12px 0;
  margin-top: 8px;
}

.font-label {
  font-size: 14px;
  margin-right: 6px;
}

.font-btn {
  font-size: 14px;
  font-weight: bold;
  text-align: center;
  width: 36px;
  min-height: 24px;
  border-radius: 6px;
  margin-left: 3px;
  margin-right: 3px;
}

.footer-text {
  font-size: 11px;
  text-align: center;
  padding-top: 4px;
}

@media (shape: capsule) {
  .input-page {
    padding: 44px 8px 12px 8px;
  }
  .header {
    height: 46px;
    margin-bottom: 6px;
    justify-content: center;
  }
  .back-btn {
    width: 80px;
    height: 34px;
    font-size: 14px;
  }
  .title {
    font-size: 18px;
  }
  .confirm-btn {
    width: 60px;
    height: 34px;
    font-size: 14px;
  }
  .display-area {
    padding: 6px 8px;
    margin-bottom: 2px;
    min-height: 34px;
  }
  .pinyin-row {
    min-height: 20px;
    padding: 2px 0;
    margin-bottom: 2px;
  }
  .candidate-row {
    min-height: 32px;
    margin-bottom: 2px;
    padding: 4px 4px;
  }
  .candidate-item {
    padding: 2px 8px;
    margin-right: 2px;
  }
  .keyboard {
    margin-top: 2px;
  }
  .key-row {
    margin-bottom: 3px;
  }
  .key-btn {
    min-height: 24px;
    margin-left: 1px;
    margin-right: 1px;
    max-width: 50px;
    flex: 1;
  }
  .key-del {
    max-width: 50px;
    flex: 1;
  }
  .key-func {
    min-height: 24px;
    max-width: 70px;
    flex: 1;
  }
  .font-label {
    font-size: 12px;
  }
  .font-btn {
    font-size: 12px;
    width: 32px;
    min-height: 22px;
  }
  .footer-text {
    font-size: 10px;
    padding-top: 3px;
  }
}

@media (shape: rect) {
  .input-page {
    padding: 44px 6px 10px 6px;
  }
  .header {
    height: 40px;
    margin-bottom: 6px;
  }
  .back-btn {
    width: 70px;
    height: 30px;
    font-size: 14px;
  }
  .title {
    font-size: 18px;
  }
  .confirm-btn {
    width: 56px;
    height: 30px;
    font-size: 14px;
  }
  .display-area {
    padding: 6px 8px;
    margin-bottom: 2px;
    min-height: 32px;
  }
  .pinyin-row {
    min-height: 18px;
    padding: 2px 0;
    margin-bottom: 2px;
  }
  .candidate-row {
    min-height: 30px;
    margin-bottom: 2px;
    padding: 4px 4px;
  }
  .candidate-item {
    padding: 2px 8px;
    margin-right: 2px;
  }
  .keyboard {
    margin-top: 2px;
  }
  .key-row {
    margin-bottom: 3px;
  }
  .key-btn {
    min-height: 22px;
    margin-left: 1px;
    margin-right: 1px;
    max-width: 44px;
    flex: 1;
  }
  .key-del {
    max-width: 44px;
    flex: 1;
  }
  .key-func {
    min-height: 22px;
    max-width: 60px;
    flex: 1;
  }
  .font-label {
    font-size: 11px;
  }
  .font-btn {
    font-size: 11px;
    width: 28px;
    min-height: 20px;
  }
  .footer-text {
    font-size: 9px;
    padding-top: 2px;
  }
}

@media (shape: circle) {
  .input-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 80px;
    height: 30px;
    font-size: 14px;
  }
  .confirm-btn {
    width: 44px;
    height: 30px;
    font-size: 14px;
  }
  .title {
    font-size: 18px;
  }
  .key-row {
    margin-bottom: 3px;
  }
  .key-btn {
    font-size: 28px;
    max-width: 56px;
    flex: 1;
  }
  .key-del {
    font-size: 28px;
    max-width: 56px;
    flex: 1;
  }
  .key-func {
    font-size: 28px;
    max-width: 56px;
    flex: 1;
  }
  .font-label {
    font-size: 14px;
  }
  .font-btn {
    font-size: 14px;
    width: 36px;
    min-height: 24px;
  }
  .footer-text {
    font-size: 10px;
    padding-top: 3px;
  }
}
</style>