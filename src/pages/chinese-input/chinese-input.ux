<template>
  <div class="input-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="&#9664; 返回" onclick="onCancel" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">{{ title }}</text>
      <input class="confirm-btn" type="button" value="确认" onclick="onConfirm" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="display-area" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
      <text class="display-text" style="{{ displayStyle }}; color: {{ theme.text }}">{{ inputValue || placeholder }}</text>
      <text class="cursor" show="{{ showCursor }}" style="{{ displayStyle }}; color: {{ theme.accent }}">_</text>
    </div>

    <div class="pinyin-row" show="{{ !hideKeyboard && cval }}">
      <text class="pinyin-text" style="{{ pinyinStyle }}; color: {{ theme.accent }}">{{ cvalDisplay }}</text>
    </div>

    <scroll class="candidate-row" show="{{ !hideKeyboard && resultRow0.length > 0 }}" scroll-x="{{true}}">
      <text for="{{ item in resultRow0 }}" class="candidate-item" onclick="onSelectCandidate(item)" style="{{ candidateStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
    </scroll>

    <div class="keyboard" show="{{ !hideKeyboard }}">
      <div class="key-row" show="{{ !numFlag }}">
        <text for="{{ item in keys.full[0] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
      </div>
      <div class="key-row" show="{{ !numFlag }}">
        <text for="{{ item in keys.full[1] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
      </div>
      <div class="key-row" show="{{ !numFlag }}">
        <text for="{{ item in keys.full[2] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        <text class="key-btn key-del" onclick="onDeleteKey" style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
      </div>

      <div class="key-row" show="{{ numFlag }}">
        <text for="{{ item in keys.sign[0] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
      </div>
      <div class="key-row" show="{{ numFlag }}">
        <text for="{{ item in keys.sign[1] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
      </div>
      <div class="key-row" show="{{ numFlag }}">
        <text for="{{ item in keys.sign[2] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        <text class="key-btn key-del" onclick="onDeleteKey" style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
      </div>

      <div class="key-row key-bottom">
        <text class="key-btn key-func" onclick="toggleNumMode" show="{{ lang === 'cn' || numFlag }}" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ numFlag ? 'ABC' : '123' }}</text>
        <text class="key-btn key-func" onclick="toggleShift" show="{{ lang === 'en' && !numFlag }}" style="background-color: {{ shiftFlag ? theme.accent : theme.card }}; color: {{ shiftFlag ? theme.bg : theme.accent }}">Shift</text>
        <text class="key-btn key-space" onclick="onSpace" style="background-color: {{ theme.card }}; color: {{ theme.text }}">{{ lang === 'cn' ? '空格' : 'Space' }}</text>
        <text class="key-btn key-func" onclick="toggleLang" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ lang === 'cn' ? 'EN' : '中' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
const store = require("../../data/store.js")
import { SimpleInputMethod } from "../../components/InputMethod/assets/dicUtil.js"

var dictReady = false

function ensureDict() {
  if (!dictReady) {
    dictReady = true
    SimpleInputMethod.initDict()
  }
}

export default {
  private: {
    title: "输入",
    placeholder: "点击输入",
    inputValue: "",
    maxlen: 5,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    hideKeyboard: true,
    showCursor: false,
    returnKey: "chinese_input_result",
    fontScale: 1.0,
    displayStyle: "",
    candidateStyle: "",
    pinyinStyle: "",
    keyStyle: "",
    cval: "",
    cvalDisplay: "",
    lang: "cn",
    numFlag: false,
    shiftFlag: false,
    resultRow0: [],
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"]
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["-", "/", ":", ";", "(", ")", "$", "&", "@", "\""],
        [".", ",", "?", "!", "'"]
      ]
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getScaleSafe(function(scale) {
      self.fontScale = scale
      self.applyFontScale()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getScaleSafe(function(scale) {
      self.fontScale = scale
      self.applyFontScale()
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_title",
      success: function(data) { if (data) self.title = data }
    })
    storage.get({
      key: "chinese_input_placeholder",
      success: function(data) { if (data) self.placeholder = data }
    })
    storage.get({
      key: "chinese_input_value",
      success: function(data) {
        if (data !== undefined && data !== null) self.inputValue = data
      }
    })
    storage.get({
      key: "chinese_input_maxlen",
      success: function(data) { if (data) self.maxlen = parseInt(data) || 5 }
    })
    storage.get({
      key: "chinese_input_return_key",
      success: function(data) { if (data) self.returnKey = data }
    })

    setTimeout(function() {
      self.showKeyboard()
    }, 300)
  },

  applyFontScale() {
    var s = this.fontScale
    if (!s || s < 0.5) { s = 1.0 }
    var styles = store.buildFontStyles(s, {
      displayStyle: 17,
      candidateStyle: 16,
      pinyinStyle: 14,
      keyStyle: 15
    })
    this.displayStyle = styles.displayStyle
    this.candidateStyle = styles.candidateStyle
    this.pinyinStyle = styles.pinyinStyle
    this.keyStyle = styles.keyStyle
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.showCursor = true
    ensureDict()
  },

  doVibrate() {
    vibrator.vibrate({ mode: "short" })
  },

  onKeyPress(item) {
    if (!item) return
    this.doVibrate()

    if (this.lang === "cn" && !this.numFlag) {
      this.cval += item.toLowerCase()
      this.updateCandidates()
    } else {
      if (this.inputValue.length >= this.maxlen) return
      var char = item
      if (this.lang === "en" && !this.numFlag && !this.shiftFlag) {
        char = item.toLowerCase()
      }
      this.inputValue += char
    }
  },

  onDeleteKey() {
    this.doVibrate()
    if (this.cval.length > 0) {
      this.cval = this.cval.slice(0, -1)
      this.updateCandidates()
    } else {
      this.inputValue = this.inputValue.slice(0, -1)
    }
  },

  onSpace() {
    this.doVibrate()
    if (this.inputValue.length >= this.maxlen) return
    this.inputValue += " "
  },

  onSelectCandidate(item) {
    if (!item) return
    this.doVibrate()

    if (this.inputValue.length >= this.maxlen) return

    var consumed = false
    if (item.length === 1 && this._sylTopChars && this._sylTopChars.length > 0 && this.cval.length > 0) {
      for (var si = 0; si < this._sylTopChars.length; si++) {
        var sc = this._sylTopChars[si]
        if (sc.char === item && sc.offset > 0 && sc.offset <= this.cval.length) {
          this.cval = this.cval.slice(sc.offset)
          this.inputValue += item
          consumed = true
          break
        }
      }
    }

    if (!consumed && this._matchedLen > 0 && this.cval.length > this._matchedLen) {
      this.cval = this.cval.slice(this._matchedLen)
      this.inputValue += item
      consumed = true
    }

    if (!consumed) {
      this.cval = ""
      this.inputValue += item
    }

    this.updateCandidates()
  },

  updateCandidates() {
    var self = this
    this.cvalDisplay = SimpleInputMethod.getSegmentedDisplay(this.cval)

    if (!this.cval || this.lang !== "cn") {
      this.resultRow0 = []
      this._sylTopChars = []
      this._matchedLen = 0
      return
    }

    var result = SimpleInputMethod.getHanzi(this.cval, "cn")
    var chars = result.chars || []
    this._matchedLen = result.matched ? result.matched.length : 0

    var multi = result.multi || { words: [], composed: "", sylTopChars: [] }
    var words = (multi.words || []).slice()
    if (words.length === 0 && multi.composed && multi.composed.length >= 2) {
      words = [multi.composed]
    } else if (multi.composed && multi.composed.length >= 2 && words.indexOf(multi.composed) === -1) {
      words.push(multi.composed)
    }

    var sylTopChars = (multi.sylTopChars || []).filter(function(sc) { return sc.char && sc.offset > 0 })
    self._sylTopChars = sylTopChars

    var sylOnlyChars = sylTopChars.map(function(sc) { return sc.char })
    var seen = {}
    var uniqueSylChars = []
    for (var si = 0; si < sylOnlyChars.length; si++) {
      if (!seen[sylOnlyChars[si]]) { seen[sylOnlyChars[si]] = 1; uniqueSylChars.push(sylOnlyChars[si]) }
    }
    for (var sj = 0; sj < uniqueSylChars.length; sj++) {
      if (words.indexOf(uniqueSylChars[sj]) === -1) { words.push(uniqueSylChars[sj]) }
    }

    var row0 = []
    var cap = parseInt(this.maxlen) || 5
    for (var i = 0; i < words.length && row0.length < cap; i++) {
      row0.push(words[i])
    }
    for (var j = 0; j < chars.length && row0.length < cap; j++) {
      if (words.indexOf(chars[j]) === -1) {
        row0.push(chars[j])
      }
    }
    this.resultRow0 = row0
  },

  toggleNumMode() {
    this.doVibrate()
    this.numFlag = !this.numFlag
    this.cval = ""
    this.resultRow0 = []
    this.cvalDisplay = ""
  },

  toggleLang() {
    this.doVibrate()
    this.lang = this.lang === "cn" ? "en" : "cn"
    this.cval = ""
    this.resultRow0 = []
    this.cvalDisplay = ""
    this.shiftFlag = false
  },

  toggleShift() {
    this.doVibrate()
    this.shiftFlag = !this.shiftFlag
  },

  onConfirm() {
    var result = this.inputValue.trim()
    this.returnResult(result)
  },

  onCancel() {
    if (!this.hideKeyboard) {
      this.hideKeyboard = true
      this.showCursor = false
    } else {
      this.returnResult(null)
    }
  },

  returnResult(result) {
    var storage = require("@system.storage")
    var returnKey = this.returnKey || "chinese_input_result"
    var value = result !== null ? result : ""

    storage.set({
      key: returnKey,
      value: value,
      success: function() {
        if (returnKey === "chinese_input_result") {
          storage.get({
            key: "homepage_settings",
            success: function(data) {
              var settings = { showQuickAdd: true, showCustomContent: false, customContent: "", showTime: true, showStatusBar: true, timeFormat: { year: false, month: false, day: false, hour: true, minute: true, second: true } }
              if (data) {
                try { settings = JSON.parse(data) } catch (e) {}
              }
              settings.customContent = value
              if (value && value.length > 0) {
                settings.showCustomContent = true
              }
              storage.set({
                key: "homepage_settings",
                value: JSON.stringify(settings),
                success: function() { router.back() },
                fail: function() { router.back() }
              })
            },
            fail: function() { router.back() }
          })
        } else {
          router.back()
        }
      },
      fail: function() { router.back() }
    })
  },

  goBack() {
    this.onCancel()
  }
}
</script>

<style>
.input-page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  height: 100%;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 36px;
  margin-bottom: 6px;
}

.back-btn {
  width: 64px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.title {
  font-size: 16px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.confirm-btn {
  width: 64px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
}

.display-area {
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
  border-width: 2px;
  padding: 8px 12px;
  margin-bottom: 4px;
  min-height: 40px;
}

.display-text {
  font-size: 17px;
  flex: 1;
}

.cursor {
  font-size: 17px;
  margin-left: 2px;
}

.pinyin-row {
  height: 22px;
  margin-bottom: 2px;
  padding-left: 8px;
}

.pinyin-text {
  font-size: 14px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.candidate-row {
  height: 36px;
  margin-bottom: 4px;
  padding-left: 4px;
  padding-right: 4px;
}

.candidate-item {
  font-size: 16px;
  padding: 4px 10px;
  margin-right: 4px;
  border-radius: 6px;
  text-align: center;
}

.keyboard {
  flex-direction: column;
  margin-top: 4px;
}

.key-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 4px;
}

.key-btn {
  width: 30px;
  height: 36px;
  border-radius: 6px;
  font-size: 15px;
  font-weight: bold;
  text-align: center;
  margin-left: 2px;
  margin-right: 2px;
}

.key-del {
  width: 36px;
  font-size: 11px;
}

.key-func {
  width: 42px;
  font-size: 12px;
}

.key-space {
  flex: 1;
  font-size: 13px;
  margin-left: 6px;
  margin-right: 6px;
}

.key-bottom {
  margin-bottom: 0;
}

@media (shape: capsule) {
  .input-page {
    padding: 44px 8px 12px 8px;
  }
  .header {
    height: 30px;
    margin-bottom: 4px;
    justify-content: center;
  }
  .back-btn {
    width: 46px;
    height: 26px;
    font-size: 12px;
  }
  .title {
    font-size: 13px;
  }
  .confirm-btn {
    width: 46px;
    height: 26px;
    font-size: 12px;
  }
  .display-area {
    padding: 6px 8px;
    margin-bottom: 2px;
    min-height: 34px;
  }
  .display-text {
    font-size: 14px;
  }
  .cursor {
    font-size: 14px;
  }
  .pinyin-row {
    height: 20px;
    margin-bottom: 2px;
  }
  .pinyin-text {
    font-size: 12px;
  }
  .candidate-row {
    height: 32px;
    margin-bottom: 2px;
  }
  .candidate-item {
    font-size: 13px;
    padding: 2px 8px;
    margin-right: 2px;
  }
  .keyboard {
    margin-top: 2px;
  }
  .key-row {
    margin-bottom: 2px;
  }
  .key-btn {
    width: 26px;
    height: 30px;
    font-size: 12px;
    margin-left: 1px;
    margin-right: 1px;
  }
}

@media (shape: rect) {
  .input-page {
    padding: 44px 6px 6px 6px;
  }
  .header {
    height: 28px;
    margin-bottom: 4px;
  }
  .back-btn {
    width: 44px;
    height: 24px;
    font-size: 11px;
  }
  .title {
    font-size: 13px;
  }
  .confirm-btn {
    width: 44px;
    height: 24px;
    font-size: 11px;
  }
  .display-area {
    padding: 6px 8px;
    margin-bottom: 2px;
    min-height: 32px;
  }
  .display-text {
    font-size: 14px;
  }
  .cursor {
    font-size: 14px;
  }
  .pinyin-row {
    height: 18px;
    margin-bottom: 2px;
  }
  .pinyin-text {
    font-size: 12px;
  }
  .candidate-row {
    height: 30px;
    margin-bottom: 2px;
  }
  .candidate-item {
    font-size: 13px;
    padding: 2px 8px;
    margin-right: 2px;
  }
  .keyboard {
    margin-top: 2px;
  }
  .key-row {
    margin-bottom: 2px;
  }
  .key-btn {
    width: 24px;
    height: 28px;
    font-size: 12px;
    margin-left: 1px;
    margin-right: 1px;
  }
  .key-del {
    width: 28px;
    font-size: 10px;
  }
  .key-func {
    width: 34px;
    font-size: 10px;
  }
  .key-space {
    font-size: 11px;
    margin-left: 4px;
    margin-right: 4px;
  }
}

@media (shape: circle) {
  .input-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 56px;
    height: 30px;
    font-size: 13px;
  }
  .confirm-btn {
    width: 44px;
    height: 30px;
    font-size: 13px;
  }
  .title {
    font-size: 16px;
  }
}
</style>