<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">{{ pageTitle }}</text>
    </div>

    <div class="input-display" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
      <text class="input-text" style="color: {{ theme.text }}">{{ inputText || placeholder }}</text>
      <text class="cursor" show="{{ showCursor }}" style="color: {{ theme.accent }}">|</text>
    </div>

    <div class="keyboard-area">
      <div class="keyboard-close-row">
        <input class="done-btn" type="button" value="完成" onclick="confirmInput" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
      <input-method
        hide="{{ false }}"
        keyboardtype="QWERTY"
        maxlength="{{ maxlen }}"
        vibratemode="short"
        screentype="{{ screenType }}"
        oncomplete="onCharacter"
        ondelete="onDeleteChar"
      ></input-method>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const store = require("../../data/store.js")

export default {
  private: {
    pageTitle: "输入",
    placeholder: "请输入",
    inputText: "",
    maxlen: "10",
    returnKey: "chinese_input_result",
    showCursor: false,
    screenType: "pill-shaped",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    device.getInfo({
      success: function(data) {
        var shape = data.screenShape || "circle"
        if (shape === "capsule") {
          shape = "pill-shaped"
        }
        self.screenType = shape
      }
    })
    this.loadParams()
  },

  onReady() {
    this.showCursor = true
  },

  loadParams() {
    var self = this
    var storage = require("@system.storage")
    storage.get({ key: "chinese_input_title", success: function(data) {
      if (data) self.pageTitle = data
    }, fail: function() {} })
    storage.get({ key: "chinese_input_placeholder", success: function(data) {
      if (data) self.placeholder = data
    }, fail: function() {} })
    storage.get({ key: "chinese_input_value", success: function(data) {
      if (data) self.inputText = data
    }, fail: function() {} })
    storage.get({ key: "chinese_input_maxlen", success: function(data) {
      if (data) self.maxlen = data
    }, fail: function() {} })
    storage.get({ key: "chinese_input_return_key", success: function(data) {
      if (data) self.returnKey = data
    }, fail: function() {} })
  },

  onCharacter(e) {
    if (e && e.detail && e.detail.content) {
      var maxLen = parseInt(this.maxlen) || 10
      if (this.inputText.length < maxLen) {
        this.inputText += e.detail.content
      }
    }
  },

  onDeleteChar() {
    this.inputText = this.inputText.slice(0, -1)
  },

  confirmInput() {
    var self = this
    var storage = require("@system.storage")
    var text = this.inputText.trim()
    var key = this.returnKey || "chinese_input_result"
    storage.set({
      key: key,
      value: text,
      success: function() {
        router.back()
      },
      fail: function() {
        router.back()
      }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 38px 6px 2px 6px;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
  height: 36px;
  flex-shrink: 0;
}

.back-btn {
  width: 40px;
  height: 28px;
  border-radius: 14px;
  font-size: 18px;
  text-align: center;
  line-height: 28px;
  flex-shrink: 0;
}

.title {
  font-size: 24px;
  font-weight: bold;
  margin-left: 6px;
  flex: 1;
  line-height: 32px;
  lines: 1;
}

.input-display {
  flex-direction: row;
  align-items: center;
  padding: 6px 10px;
  border-radius: 10px;
  border-width: 2px;
  margin-bottom: 4px;
  min-height: 36px;
  flex-shrink: 0;
}

.input-text {
  font-size: 24px;
  flex: 1;
  lines: 1;
}

.cursor {
  font-size: 24px;
  margin-left: 2px;
}

.keyboard-area {
  flex: 1;
  flex-direction: column;
  min-height: 0;
  overflow: visible;
}

.keyboard-close-row {
  flex-direction: row;
  justify-content: flex-end;
  margin-bottom: 2px;
  flex-shrink: 0;
  height: 28px;
}

.done-btn {
  width: 56px;
  height: 26px;
  border-radius: 13px;
  font-size: 20px;
  font-weight: bold;
  line-height: 28px;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 30px 16px 30px 16px;
  }
  .header {
    height: 48px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
  }
  .back-btn {
    width: 48px;
    height: 40px;
    border-radius: 20px;
    font-size: 24px;
    line-height: 40px;
    flex-shrink: 0;
  }
  .title {
    font-size: 28px;
    line-height: 44px;
    text-align: center;
    flex: 1;
    margin: 0 4px;
    lines: 1;
  }
  .input-display {
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 12px;
    margin-bottom: 6px;
  }
  .input-text {
    font-size: 28px;
    line-height: 36px;
  }
  .cursor {
    font-size: 28px;
    line-height: 36px;
  }
  .keyboard-close-row {
    height: 36px;
  }
  .done-btn {
    width: 72px;
    height: 38px;
    border-radius: 19px;
    font-size: 24px;
    line-height: 34px;
  }
}

@media (shape: circle) {
  .page {
    padding: 38px 20px 16px 20px;
  }
  .header {
    height: 40px;
    margin-bottom: 8px;
  }
  .back-btn {
    width: 44px;
    height: 32px;
    font-size: 22px;
    line-height: 32px;
  }
  .title {
    font-size: 28px;
    line-height: 38px;
  }
  .input-display {
    min-height: 42px;
    padding: 8px 12px;
  }
  .input-text {
    font-size: 26px;
  }
  .cursor {
    font-size: 26px;
  }
  .keyboard-close-row {
    height: 32px;
  }
  .done-btn {
    width: 64px;
    height: 30px;
    font-size: 22px;
    line-height: 28px;
  }
}

@media (shape: rect) {
  .page {
    padding: 38px 10px 8px 10px;
  }
  .header {
    height: 40px;
  }
  .back-btn {
    width: 44px;
    height: 32px;
    font-size: 22px;
    line-height: 32px;
  }
  .title {
    font-size: 28px;
    line-height: 38px;
  }
  .input-display {
    min-height: 42px;
  }
  .input-text {
    font-size: 26px;
  }
  .done-btn {
    font-size: 22px;
  }
}
</style>