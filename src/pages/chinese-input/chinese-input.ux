<template>
  <div class="input-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="&#9664; 返回" onclick="onCancel" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">{{ title }}</text>
      <input class="confirm-btn" type="button" value="确认" onclick="onConfirm" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="display-area" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
      <text class="display-text" style="{{ displayStyle }}; color: {{ theme.text }}">{{ inputValue || placeholder }}</text>
      <text class="cursor" show="{{ showCursor }}" style="{{ displayStyle }}; color: {{ theme.accent }}">_</text>
    </div>

    <div class="pinyin-row" show="{{ !hideKeyboard && cval }}">
      <text class="pinyin-text" style="{{ pinyinStyle }}; color: {{ theme.accent }}">{{ cvalDisplay }}</text>
    </div>

    <scroll class="candidate-row" show="{{ !hideKeyboard && resultRow0.length > 0 }}" scroll-x="{{true}}">
      <text for="{{ item in resultRow0 }}" class="candidate-item" onclick="onSelectCandidate(item)" style="{{ candidateStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
    </scroll>

    <div class="keyboard" show="{{ !hideKeyboard }}">

        <div class="key-row" show="{{ keyboardMode === 't9' && !numFlag }}">
          <text for="{{ item in t9Keys[0] }}" class="key-btn t9-btn" onclick="onT9Key(item)">{{ item.label }}</text>
        </div>
        <div class="key-row" show="{{ keyboardMode === 't9' && !numFlag }}">
          <text for="{{ item in t9Keys[1] }}" class="key-btn t9-btn" onclick="onT9Key(item)">{{ item.label }}</text>
        </div>
        <div class="key-row" show="{{ keyboardMode === 't9' && !numFlag }}">
          <text for="{{ item in t9Keys[2] }}" class="key-btn t9-btn" onclick="onT9Key(item)">{{ item.label }}</text>
        </div>

        <div class="key-row" show="{{ keyboardMode === 'full' && !numFlag }}">
          <text for="{{ item in keys.full[0] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ keyboardMode === 'full' && !numFlag }}">
          <text for="{{ item in keys.full[1] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ keyboardMode === 'full' && !numFlag }}">
          <text for="{{ item in keys.full[2] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          <text class="key-btn key-del" onclick="onDeleteKey" style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
        </div>

        <div class="key-row" show="{{ numFlag }}">
          <text for="{{ item in keys.sign[0] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ numFlag }}">
          <text for="{{ item in keys.sign[1] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </div>
        <div class="key-row" show="{{ numFlag }}">
          <text for="{{ item in keys.sign[2] }}" class="key-btn" onclick="onKeyPress(item)" style="{{ keyStyle }}; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          <text class="key-btn key-del" onclick="onDeleteKey" style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
        </div>

      <div class="key-row key-bottom">
        <text class="key-btn key-func" onclick="toggleNumMode" show="{{ lang === 'cn' || numFlag }}" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ numFlag ? 'ABC' : '123' }}</text>
        <text class="key-btn key-func" onclick="toggleShift" show="{{ lang === 'en' && !numFlag && keyboardMode === 'full' }}" style="background-color: {{ shiftFlag ? theme.accent : theme.card }}; color: {{ shiftFlag ? theme.bg : theme.accent }}">Shift</text>
        <text class="key-btn key-func" onclick="toggleKeyboardMode" style="background-color: {{ keyboardMode === 't9' ? theme.accent : theme.card }}; color: {{ keyboardMode === 't9' ? theme.bg : theme.accent }}">{{ keyboardMode === 't9' ? '9键' : '全键' }}</text>
        <text class="key-btn key-func" onclick="toggleLang" show="{{ keyboardMode === 'full' || !numFlag }}" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ lang === 'cn' ? 'EN' : '中' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
const store = require("../../data/store.js")
import { SimpleInputMethod } from "../../components/InputMethod/assets/dicUtil.js"
import { syllables } from "../../components/InputMethod/assets/pinyin_syllables.js"

var dictReady = false
var t9MapReady = false
var t9DigitToPinyin = {}

function ensureDict() {
  if (!dictReady) {
    dictReady = true
    SimpleInputMethod.initDict()
  }
}

function buildT9Map() {
  if (t9MapReady) return
  t9MapReady = true
  var letterToDigit = {
    'a': '2', 'b': '2', 'c': '2',
    'd': '3', 'e': '3', 'f': '3',
    'g': '4', 'h': '4', 'i': '4',
    'j': '5', 'k': '5', 'l': '5',
    'm': '6', 'n': '6', 'o': '6',
    'p': '7', 'q': '7', 'r': '7', 's': '7',
    't': '8', 'u': '8', 'v': '8',
    'w': '9', 'x': '9', 'y': '9', 'z': '9'
  }
  for (var i = 0; i < syllables.length; i++) {
    var syl = syllables[i]
    var digits = ''
    for (var j = 0; j < syl.length; j++) {
      var d = letterToDigit[syl[j]]
      if (d) digits += d
    }
    if (!t9DigitToPinyin[digits]) t9DigitToPinyin[digits] = []
    if (t9DigitToPinyin[digits].indexOf(syl) === -1) {
      t9DigitToPinyin[digits].push(syl)
    }
  }
}

export default {
  private: {
    title: "输入",
    placeholder: "点击输入",
    inputValue: "",
    maxlen: 5,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    hideKeyboard: true,
    showCursor: false,
    returnKey: "chinese_input_result",
    baseFontSize: 48,
    displayStyle: "",
    candidateStyle: "",
    pinyinStyle: "",
    keyStyle: "",
    cval: "",
    cvalDisplay: "",
    lang: "cn",
    keyboardMode: "t9",
    digitSequence: "",
    t9Buffer: "",
    t9LastKey: "",
    t9LastTime: 0,
    numFlag: false,
    shiftFlag: false,
    resultRow0: [],
    t9Keys: [
      [
        { key: '2', label: '2', action: 'digit' },
        { key: '3', label: '3', action: 'digit' },
        { key: '4', label: '4', action: 'digit' },
        { key: 'del', label: 'Del', action: 'delete' }
      ],
      [
        { key: '5', label: '5', action: 'digit' },
        { key: '6', label: '6', action: 'digit' },
        { key: '7', label: '7', action: 'digit' },
        { key: '123', label: '123', action: 'num' }
      ],
      [
        { key: '8', label: '8', action: 'digit' },
        { key: '9', label: '9', action: 'digit' },
        { key: '0', label: '0', action: 'digit' },
        { key: 'space', label: '空格', action: 'space' }
      ]
    ],
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"]
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["-", "/", ":", ";", "(", ")", "$", "&", "@", "\""],
        [".", ",", "?", "!", "'"]
      ]
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getFontSizes(function(sizes) {
      self.baseFontSize = sizes.display
      self.applyFontSizes(sizes)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getFontSizes(function(sizes) {
      self.baseFontSize = sizes.display
      self.applyFontSizes(sizes)
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_title",
      success: function(data) { if (data) self.title = data }
    })
    storage.get({
      key: "chinese_input_placeholder",
      success: function(data) { if (data) self.placeholder = data }
    })
    storage.get({
      key: "chinese_input_value",
      success: function(data) {
        if (data !== undefined && data !== null) self.inputValue = data
      }
    })
    storage.get({
      key: "chinese_input_maxlen",
      success: function(data) { if (data) self.maxlen = parseInt(data) || 5 }
    })
    storage.get({
      key: "chinese_input_return_key",
      success: function(data) { if (data) self.returnKey = data }
    })

    setTimeout(function() {
      self.showKeyboard()
    }, 300)
  },

  applyFontSizes(sizes) {
    this.displayStyle = "font-size: " + sizes.display + "px"
    this.candidateStyle = "font-size: " + sizes.candidate + "px"
    this.pinyinStyle = "font-size: " + sizes.pinyin + "px"
    this.keyStyle = "font-size: " + sizes.key + "px"
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.showCursor = true
    ensureDict()
  },

  doVibrate() {
    vibrator.vibrate({ mode: "short" })
  },

  onKeyPress(item) {
    if (!item) return
    this.doVibrate()

    if (this.lang === "cn" && !this.numFlag) {
      this.cval += item.toLowerCase()
      this.updateCandidates()
    } else {
      if (this.inputValue.length >= this.maxlen) return
      var char = item
      if (this.lang === "en" && !this.numFlag && !this.shiftFlag) {
        char = item.toLowerCase()
      }
      this.inputValue += char
    }
  },

  onDeleteKey() {
    this.doVibrate()
    if (this.keyboardMode === 't9' && this.lang === 'cn') {
      if (this.digitSequence.length > 0) {
        this.digitSequence = this.digitSequence.slice(0, -1)
        this.resolveT9AndUpdate()
      } else {
        this.inputValue = this.inputValue.slice(0, -1)
      }
      return
    }
    if (this.keyboardMode === 't9' && this.lang === 'en') {
      if (this.t9Buffer) {
        this.t9Buffer = ''
        this.cvalDisplay = this.inputValue
      } else {
        this.inputValue = this.inputValue.slice(0, -1)
      }
      return
    }
    if (this.cval.length > 0) {
      this.cval = this.cval.slice(0, -1)
      this.updateCandidates()
    } else {
      this.inputValue = this.inputValue.slice(0, -1)
    }
  },

  onSpace() {
    this.doVibrate()
    if (this.inputValue.length >= this.maxlen) return
    this.inputValue += " "
  },

  onSelectCandidate(item) {
    if (!item) return
    this.doVibrate()

    if (this.inputValue.length >= this.maxlen) return

    var consumed = false
    if (item.length === 1 && this._sylTopChars && this._sylTopChars.length > 0 && this.cval.length > 0) {
      for (var si = 0; si < this._sylTopChars.length; si++) {
        var sc = this._sylTopChars[si]
        if (sc.char === item && sc.offset > 0 && sc.offset <= this.cval.length) {
          this.cval = this.cval.slice(sc.offset)
          this.inputValue += item
          consumed = true
          break
        }
      }
    }

    if (!consumed && this._matchedLen > 0 && this.cval.length > this._matchedLen) {
      this.cval = this.cval.slice(this._matchedLen)
      this.inputValue += item
      consumed = true
    }

    if (!consumed) {
      this.cval = ""
      this.inputValue += item
    }

    this.updateCandidates()
  },

  updateCandidates() {
    var self = this
    this.cvalDisplay = SimpleInputMethod.getSegmentedDisplay(this.cval)

    if (!this.cval || this.lang !== "cn") {
      this.resultRow0 = []
      this._sylTopChars = []
      this._matchedLen = 0
      return
    }

    var result = SimpleInputMethod.getHanzi(this.cval, "cn")
    var chars = result.chars || []
    this._matchedLen = result.matched ? result.matched.length : 0

    var multi = result.multi || { words: [], composed: "", sylTopChars: [] }
    var words = (multi.words || []).slice()
    if (words.length === 0 && multi.composed && multi.composed.length >= 2) {
      words = [multi.composed]
    } else if (multi.composed && multi.composed.length >= 2 && words.indexOf(multi.composed) === -1) {
      words.push(multi.composed)
    }

    var sylTopChars = (multi.sylTopChars || []).filter(function(sc) { return sc.char && sc.offset > 0 })
    self._sylTopChars = sylTopChars

    var sylOnlyChars = sylTopChars.map(function(sc) { return sc.char })
    var seen = {}
    var uniqueSylChars = []
    for (var si = 0; si < sylOnlyChars.length; si++) {
      if (!seen[sylOnlyChars[si]]) { seen[sylOnlyChars[si]] = 1; uniqueSylChars.push(sylOnlyChars[si]) }
    }
    for (var sj = 0; sj < uniqueSylChars.length; sj++) {
      if (words.indexOf(uniqueSylChars[sj]) === -1) { words.push(uniqueSylChars[sj]) }
    }

    var row0 = []
    var cap = parseInt(this.maxlen) || 5
    for (var i = 0; i < words.length && row0.length < cap; i++) {
      row0.push(words[i])
    }
    for (var j = 0; j < chars.length && row0.length < cap; j++) {
      if (words.indexOf(chars[j]) === -1) {
        row0.push(chars[j])
      }
    }
    this.resultRow0 = row0
  },

  toggleNumMode() {
    this.doVibrate()
    this.numFlag = !this.numFlag
    this.cval = ""
    this.digitSequence = ""
    this.t9Buffer = ""
    this.t9LastKey = ""
    this.resultRow0 = []
    this.cvalDisplay = ""
  },

  toggleLang() {
    this.doVibrate()
    this.lang = this.lang === "cn" ? "en" : "cn"
    this.cval = ""
    this.digitSequence = ""
    this.t9Buffer = ""
    this.t9LastKey = ""
    this.resultRow0 = []
    this.cvalDisplay = ""
    this.shiftFlag = false
  },

  toggleShift() {
    this.doVibrate()
    this.shiftFlag = !this.shiftFlag
  },

  toggleKeyboardMode() {
    this.doVibrate()
    if (this.keyboardMode === 't9') {
      this.keyboardMode = 'full'
    } else {
      this.keyboardMode = 't9'
    }
    this.cval = ""
    this.digitSequence = ""
    this.t9Buffer = ""
    this.t9LastKey = ""
    this.resultRow0 = []
    this.cvalDisplay = ""
  },

  onT9Key(item) {
    if (!item) return
    this.doVibrate()

    if (item.action === 'delete') {
      this.onDeleteKey()
      return
    }
    if (item.action === 'num') {
      this.toggleNumMode()
      return
    }
    if (item.action === 'space') {
      this.onSpace()
      return
    }

    buildT9Map()
    var key = item.key

    if (this.lang === 'cn') {
      this.digitSequence += key
      this.cvalDisplay = this.digitSequence
      this.resolveT9AndUpdate()
    } else {
      this.onT9KeyEnglish(key)
    }
  },

  resolveT9AndUpdate() {
    var seq = this.digitSequence
    if (!seq) {
      this.cval = ''
      this.resultRow0 = []
      return
    }

    var pinyin = ''
    if (t9DigitToPinyin[seq] && t9DigitToPinyin[seq].length > 0) {
      pinyin = t9DigitToPinyin[seq][0]
    } else {
      for (var len = seq.length - 1; len >= 1; len--) {
        var prefix = seq.slice(0, len)
        var suffix = seq.slice(len)
        if (t9DigitToPinyin[prefix] && t9DigitToPinyin[prefix].length > 0 &&
            t9DigitToPinyin[suffix] && t9DigitToPinyin[suffix].length > 0) {
          pinyin = t9DigitToPinyin[prefix][0] + t9DigitToPinyin[suffix][0]
          break
        }
      }
    }

    if (pinyin) {
      this.cval = pinyin
      this.cvalDisplay = seq + ' ( ' + pinyin + ' )'
      this.updateCandidates()
    } else {
      this.cval = ''
      this.resultRow0 = []
      this.cvalDisplay = seq
    }
  },

  onT9KeyEnglish(key) {
    var now = Date.now()
    if (key === this.t9LastKey && (now - this.t9LastTime) < 800) {
      var letters = {
        '2': ['a', 'b', 'c'],
        '3': ['d', 'e', 'f'],
        '4': ['g', 'h', 'i'],
        '5': ['j', 'k', 'l'],
        '6': ['m', 'n', 'o'],
        '7': ['p', 'q', 'r', 's'],
        '8': ['t', 'u', 'v'],
        '9': ['w', 'x', 'y', 'z'],
        '0': [' ']
      }[key]
      if (letters) {
        var current = this.t9Buffer
        var idx = letters.indexOf(current)
        if (idx >= 0 && idx < letters.length - 1) {
          this.t9Buffer = letters[idx + 1]
        } else {
          this.t9Buffer = letters[0]
        }
        this.cvalDisplay = this.inputValue + this.t9Buffer
      }
    } else {
      if (this.t9Buffer) {
        if (this.inputValue.length < this.maxlen) {
          this.inputValue += this.t9Buffer
        }
      }
      var letters = {
        '2': ['a', 'b', 'c'],
        '3': ['d', 'e', 'f'],
        '4': ['g', 'h', 'i'],
        '5': ['j', 'k', 'l'],
        '6': ['m', 'n', 'o'],
        '7': ['p', 'q', 'r', 's'],
        '8': ['t', 'u', 'v'],
        '9': ['w', 'x', 'y', 'z'],
        '0': [' ']
      }[key]
      if (letters) {
        this.t9Buffer = letters[0]
        this.cvalDisplay = this.inputValue + this.t9Buffer
      }
    }
    this.t9LastKey = key
    this.t9LastTime = now
  },

  onConfirm() {
    var result = this.inputValue.trim()
    this.returnResult(result)
  },

  onCancel() {
    if (!this.hideKeyboard) {
      this.hideKeyboard = true
      this.showCursor = false
    } else {
      this.returnResult(null)
    }
  },

  returnResult(result) {
    var storage = require("@system.storage")
    var returnKey = this.returnKey || "chinese_input_result"
    var value = result !== null ? result : ""

    storage.set({
      key: returnKey,
      value: value,
      success: function() {
        router.back()
      },
      fail: function() { router.back() }
    })
  },

  goBack() {
    this.onCancel()
  }
}
</script>

<style>
.input-page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  height: 100%;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 36px;
  margin-bottom: 6px;
}

.back-btn {
  width: 64px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.title {
  font-size: 16px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.confirm-btn {
  width: 64px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
}

.display-area {
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
  border-width: 2px;
  padding: 8px 12px;
  margin-bottom: 4px;
  min-height: 40px;
}

.display-text {
  font-size: 17px;
  flex: 1;
}

.cursor {
  font-size: 17px;
  margin-left: 2px;
}

.pinyin-row {
  height: 22px;
  margin-bottom: 2px;
  padding-left: 8px;
}

.pinyin-text {
  font-size: 14px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.candidate-row {
  height: 36px;
  margin-bottom: 4px;
  padding-left: 4px;
  padding-right: 4px;
}

.candidate-item {
  font-size: 16px;
  padding: 4px 10px;
  margin-right: 4px;
  border-radius: 6px;
  text-align: center;
}

.keyboard {
  flex-direction: column;
  margin-top: 4px;
}

.key-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 4px;
}

.key-btn {
  width: 30px;
  height: 36px;
  border-radius: 6px;
  font-size: 15px;
  font-weight: bold;
  text-align: center;
  margin-left: 2px;
  margin-right: 2px;
}

.key-del {
  width: 36px;
  font-size: 11px;
}

.key-func {
  width: 42px;
  font-size: 12px;
}

.key-space {
  flex: 1;
  font-size: 13px;
  margin-left: 6px;
  margin-right: 6px;
}

.key-bottom {
  margin-bottom: 0;
}

.t9-btn {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  margin-left: 4px;
  margin-right: 4px;
  flex: 1;
  max-width: 76px;
}

@media (shape: capsule) {
  .input-page {
    padding: 44px 8px 12px 8px;
  }
  .header {
    height: 30px;
    margin-bottom: 4px;
    justify-content: center;
  }
  .back-btn {
    width: 46px;
    height: 26px;
    font-size: 12px;
  }
  .title {
    font-size: 13px;
  }
  .confirm-btn {
    width: 46px;
    height: 26px;
