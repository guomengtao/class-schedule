<template>
  <!-- 翻页表盘 ⑦：时间 HH:MM:SS（含秒）；各数字做「上下移动·慢慢替换」的滚动动画。
       保险要点：@keyframes 只 use translateY + opacity，且数值一律带单位(0px)，避免解析失败=黑。 -->
  <div class="page" onclick="onTap">
    <div class="clock">
      <text class="d a0">{{ d0 }}</text>
      <text class="d a1">{{ d1 }}</text>
      <text class="c">:</text>
      <text class="d a2">{{ d2 }}</text>
      <text class="d a3">{{ d3 }}</text>
      <text class="c">:</text>
      <text class="d a4">{{ d4 }}</text>
      <text class="d a5">{{ d5 }}</text>
    </div>
    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"

export default {
  data: {
    d0: "0", d1: "0", d2: "0", d3: "0", d4: "0", d5: "0"
  },

  onInit() {
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const n = new Date()
    const s = this.pad(n.getHours()) + this.pad(n.getMinutes()) + this.pad(n.getSeconds())
    if (s[0] !== this.d0) this.d0 = s[0]
    if (s[1] !== this.d1) this.d1 = s[1]
    if (s[2] !== this.d2) this.d2 = s[2]
    if (s[3] !== this.d3) this.d3 = s[3]
    if (s[4] !== this.d4) this.d4 = s[4]
    if (s[5] !== this.d5) this.d5 = s[5]
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #12141c;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .clock {
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  /* 每个数字：缓慢「上移淡出 → 下方淡入」（错相位，形成逐个替换的节奏） */
  .d {
    font-size: 42px;
    font-weight: bold;
    color: #e8e4da;
    animation-name: kf-roll;
    animation-duration: 4s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .a0 { animation-delay: 0s; }
  .a1 { animation-delay: 0.3s; }
  .a2 { animation-delay: 0.6s; }
  .a3 { animation-delay: 0.9s; }
  .a4 { animation-delay: 1.2s; }
  .a5 { animation-delay: 1.5s; }

  .c {
    font-size: 36px;
    font-weight: bold;
    color: #e8e4da;
    margin: 0 1px;
  }

  @keyframes kf-roll {
    0%   { transform: translateY(0px);   opacity: 1; }
    42%  { transform: translateY(0px);   opacity: 1; }
    50%  { transform: translateY(-16px); opacity: 0; }
    58%  { transform: translateY(16px);  opacity: 0; }
    66%  { transform: translateY(0px);   opacity: 1; }
    100% { transform: translateY(0px);   opacity: 1; }
  }

  .back {
    margin-top: 44px;
    font-size: 22px;
    color: #888899;
  }
</style>
