<template>
  <!--
    翻页表盘 ⑦（v2 · 修黑屏）· 翻动走时间的效果（2D 安全版）
    ── 核实结论 ──
    · Vela 官方仅保证 2D transform；3D 翻转（rotateX/rotateY）**未证实** → 不做 3D。
    · 用 @keyframes + translateY/opacity 的「翻出→翻入」模拟翻页。
    ── 黑屏根因（本项目实测铁律）──
    · transform/animation 加在 **flex 子元素** 上会黑屏；v1 把动画加在每个 .digit（flex 子元素）→ 黑。
    · v2 改法：.page 改 position:relative（非 flex），动画移到 **绝对定位** 的 .clock 上。
    · 仍只用**字面量**关键帧，不碰数据绑定 transform。
    · 时间仍是真实时间（每分钟刷新）；动画是叠加的「翻动」质感，二者并存。
  -->
  <div class="page" onclick="onTap">
    <div class="clock">
      <text class="digit" style="color: {{ clockColor }}">{{ d0ch }}</text>
      <text class="digit" style="color: {{ clockColor }}">{{ d1ch }}</text>
      <text class="colon" style="color: {{ clockColor }}">:</text>
      <text class="digit" style="color: {{ clockColor }}">{{ d2ch }}</text>
      <text class="digit" style="color: {{ clockColor }}">{{ d3ch }}</text>
    </div>
    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const storage = require("@system.storage")

const LIST_PAGE = "/pages/watch-face-list"
const COLOR_KEY = "wf_clock_color"

export default {
  data: {
    d0ch: "0", d1ch: "0", d2ch: "0", d3ch: "0",
    clockColor: "#e8e4da"
  },

  onInit() {
    this.loadColor()
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const h = this.pad(now.getHours())
    const m = this.pad(now.getMinutes())
    if (h[0] !== this.d0ch) this.d0ch = h[0]
    if (h[1] !== this.d1ch) this.d1ch = h[1]
    if (m[0] !== this.d2ch) this.d2ch = m[0]
    if (m[1] !== this.d3ch) this.d3ch = m[1]
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  loadColor() {
    const self = this
    try {
      storage.get({
        key: COLOR_KEY,
        success: function(res) {
          if (res && res.value) self.clockColor = res.value
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  /* v2：.page 不做 flex；动画只加在「绝对定位」的 .clock 上（避开 flex 子元素 transform） */
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #12141c;
  }

  /* 绝对定位铺满 + 内部 flex 居中；动画加在此层（非 flex 子元素） */
  .clock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    animation-name: kf-flip;
    animation-duration: 3s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .digit {
    font-size: 60px;
    font-weight: bold;
  }

  .colon {
    font-size: 56px;
    font-weight: bold;
    margin: 0 2px;
  }

  /* 整体「翻出→翻入」（translateY/opacity 均为字面量关键帧） */
  @keyframes kf-flip {
    0%   { transform: translateY(0);     opacity: 1; }
    40%  { transform: translateY(0);     opacity: 1; }
    50%  { transform: translateY(-14px); opacity: 0; }
    60%  { transform: translateY(14px);  opacity: 0; }
    70%  { transform: translateY(0);     opacity: 1; }
    100% { transform: translateY(0);     opacity: 1; }
  }

  .back {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 70px;
    text-align: center;
    font-size: 22px;
    color: #888899;
  }
</style>
