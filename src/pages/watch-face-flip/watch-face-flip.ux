<template>
  <!--
    翻页表盘 ⑦ · 翻动走时间的效果（2D 安全版）
    ── 核实结论 ──
    · Vela 官方 transform 文档为 2D 转换；3D 翻转（rotateX/rotateY）**未证实** → 本版不做 3D。
    · 改用 @keyframes + translateY/opacity 的「翻出→翻入」动画模拟翻页（项目已证实 keyframes 动画安全）。
    · 动画只用**字面量**关键帧，不碰数据绑定 transform（黑屏铁律）。
    · 时间仍是真实时间（每分钟刷新）；动画是叠加的「翻动」质感，二者并存。
    ── 骨架 ── 照经典表盘（flex 居中）。
  -->
  <div class="page" onclick="onTap">
    <div class="clock">
      <text class="digit d0" style="color: {{ clockColor }}">{{ d0ch }}</text>
      <text class="digit d1" style="color: {{ clockColor }}">{{ d1ch }}</text>
      <text class="colon" style="color: {{ clockColor }}">:</text>
      <text class="digit d2" style="color: {{ clockColor }}">{{ d2ch }}</text>
      <text class="digit d3" style="color: {{ clockColor }}">{{ d3ch }}</text>
    </div>
    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const storage = require("@system.storage")

const LIST_PAGE = "/pages/watch-face-list"
const COLOR_KEY = "wf_clock_color"

export default {
  data: {
    d0ch: "0", d1ch: "0", d2ch: "0", d3ch: "0",
    clockColor: "#e8e4da"
  },

  onInit() {
    this.loadColor()
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const h = this.pad(now.getHours())
    const m = this.pad(now.getMinutes())
    if (h[0] !== this.d0ch) this.d0ch = h[0]
    if (h[1] !== this.d1ch) this.d1ch = h[1]
    if (m[0] !== this.d2ch) this.d2ch = m[0]
    if (m[1] !== this.d3ch) this.d3ch = m[1]
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  loadColor() {
    const self = this
    try {
      storage.get({
        key: COLOR_KEY,
        success: function(res) {
          if (res && res.value) self.clockColor = res.value
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #12141c;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .clock {
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  /* 数字：周期性「翻出→翻入」。动画为字面量关键帧，安全 */
  .digit {
    font-size: 60px;
    font-weight: bold;
    animation-name: kf-flip;
    animation-duration: 3s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  /* 错开相位，形成逐个翻动的节奏 */
  .d0 { animation-delay: 0s; }
  .d1 { animation-delay: 0.2s; }
  .d2 { animation-delay: 0.4s; }
  .d3 { animation-delay: 0.6s; }

  .colon {
    font-size: 56px;
    font-weight: bold;
    margin: 0 2px;
  }

  @keyframes kf-flip {
    0%   { transform: translateY(0);     opacity: 1; }
    38%  { transform: translateY(0);     opacity: 1; }
    48%  { transform: translateY(-12px); opacity: 0; }
    58%  { transform: translateY(12px);  opacity: 0; }
    68%  { transform: translateY(0);     opacity: 1; }
    100% { transform: translateY(0);     opacity: 1; }
  }

  .back {
    margin-top: 40px;
    font-size: 22px;
    color: #888899;
  }
</style>
