<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="content">
      <text class="error-code" style="color: {{ theme.accent }}">404</text>
      <text class="error-text" style="color: {{ theme.text }}">页面不存在</text>
      <text class="hint-text" style="color: {{ theme.textMuted }}">{{ countdown }} 秒后自动返回</text>
      <input class="home-btn" type="button" value="返回首页" onclick="goHome"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="back-btn" type="button" value="返回上一页" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"

var timer = null

export default {
  private: {
    theme: {},
    countdown: 5
  },

  onInit() {
    this.startCountdown()
  },

  onDestroy() {
    if (timer) {
      clearInterval(timer)
      timer = null
    }
  },

  startCountdown() {
    var self = this
    timer = setInterval(function() {
      self.countdown = self.countdown - 1
      if (self.countdown <= 0) {
        clearInterval(timer)
        timer = null
        self.goHome()
      }
    }, 1000)
  },

  goHome() {
    if (timer) {
      clearInterval(timer)
      timer = null
    }
    router.push({
      uri: "/pages/index"
    })
  },

  goBack() {
    if (timer) {
      clearInterval(timer)
      timer = null
    }
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 44px 6px 6px 6px;
  min-height: 100%;
}

.content {
  flex-direction: column;
  align-items: center;
}

.error-code {
  font-size: 60px;
  font-weight: bold;
  margin-bottom: 8px;
}

.error-text {
  font-size: 22px;
  margin-bottom: 16px;
}

.hint-text {
  font-size: 14px;
  margin-bottom: 20px;
}

.home-btn {
  width: 200px;
  height: 44px;
  border-radius: 22px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin-bottom: 12px;
}

.back-btn {
  width: 200px;
  height: 44px;
  border-radius: 22px;
  font-size: 18px;
  text-align: center;
  border-width: 0;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
}
</style>