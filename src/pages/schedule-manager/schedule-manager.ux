<template>
  <div class="manager-page" style="background-color: {{ theme.bg }}">
    <!-- 顶部装饰渐变条 -->
    <div class="top-gradient"></div>

    <!-- 头部导航栏 -->
    <div class="app-header">
      <div class="header-left">
        <div class="icon-btn" onclick="goBack" style="background-color: {{ theme.card }}">
          <text class="icon-btn-text" style="color: {{ theme.accent }}">‹</text>
        </div>
      </div>
      <div class="header-center">
        <text class="header-title" style="color: {{ theme.text }}">课程表管理</text>
        <text class="header-subtitle" style="color: {{ theme.textSecondary }}">共 {{ scheduleList.length }} 个课程表</text>
      </div>
      <div class="header-right">
        <div class="icon-btn" onclick="openStatistics" style="background-color: {{ theme.card }}">
          <text class="icon-btn-text" style="color: {{ theme.accent }}">📊</text>
        </div>
      </div>
    </div>

    <!-- 重命名编辑栏 -->
    <div class="edit-panel" show="{{ editingIndex >= 0 }}" style="background-color: {{ theme.card }}">
      <div class="edit-panel-header">
        <text class="edit-panel-icon">✏️</text>
        <text class="edit-panel-title" style="color: {{ theme.text }}">重命名课程表</text>
      </div>
      <div class="edit-panel-body">
        <div class="edit-input-wrapper" style="background-color: {{ theme.cardLight }}; border-color: {{ theme.accent }}">
          <text class="edit-input-text" style="color: {{ theme.text }}">{{ editName || '点击输入新名称' }}</text>
        </div>
        <div class="edit-btn-group">
          <div class="edit-btn edit-btn-cancel" onclick="cancelEdit" style="background-color: {{ theme.btnSecondary }}">
            <text class="edit-btn-text" style="color: {{ theme.btnSecondaryText }}">取消</text>
          </div>
          <div class="edit-btn edit-btn-confirm" onclick="finishEdit" style="background-color: {{ theme.accent }}">
            <text class="edit-btn-text" style="color: {{ theme.bg }}">✓ 保存</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 课程表列表 -->
    <scroll class="schedule-list-scroll" scroll-y="{{true}}">
      <div class="list-container">
        <div for="{{ scheduleList }}" class="schedule-card {{ $idx === currentIndex ? 'card-active' : '' }}" style="background-color: {{ theme.card }}">
          <!-- 激活指示器 -->
          <div class="card-indicator" if="{{ $idx === currentIndex }}" style="background-color: {{ theme.accent }}"></div>

          <!-- 卡片头部 -->
          <div class="card-header" onclick="selectSchedule($idx)">
            <div class="card-title-area">
              <div class="card-icon" style="background-color: {{ $idx === currentIndex ? theme.accent : theme.cardLight }}">
                <text class="card-icon-text" style="color: {{ $idx === currentIndex ? theme.bg : theme.accent }}">📚</text>
              </div>
              <div class="card-title-wrap">
                <text class="card-title" style="color: {{ theme.text }}">{{ $item.name }}</text>
                <div class="card-tag-row">
                  <text class="card-index-tag" style="background-color: {{ theme.cardLight }}; color: {{ theme.textSecondary }}">#{{ $idx + 1 }}</text>
                  <text class="active-badge" if="{{ $idx === currentIndex }}" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">
                    ● 使用中
                  </text>
                </div>
              </div>
            </div>
            <div class="card-arrow" style="color: {{ theme.textMuted }}">
              <text>›</text>
            </div>
          </div>

          <!-- 分隔线 -->
          <div class="card-divider" style="background-color: {{ theme.cardLight }}"></div>

          <!-- 操作按钮区 - 上排：主要操作 -->
          <div class="action-section">
            <div class="action-section-label">
              <text style="color: {{ theme.textSecondary }}">快捷操作</text>
            </div>
            <div class="action-row-primary">
              <div class="action-item" onclick="openWeekView($idx)" style="background-color: {{ theme.cardLight }}">
                <text class="action-icon">📅</text>
                <text class="action-label" style="color: {{ theme.text }}">周总览</text>
              </div>
              <div class="action-item" onclick="openScheduleStats($idx)" style="background-color: {{ theme.cardLight }}">
                <text class="action-icon">📈</text>
                <text class="action-label" style="color: {{ theme.text }}">数据统计</text>
              </div>
              <div class="action-item" onclick="openQrPopup($idx)" style="background-color: {{ theme.cardLight }}">
                <text class="action-icon">📤</text>
                <text class="action-label" style="color: {{ theme.text }}">导出</text>
              </div>
            </div>
          </div>

          <!-- 操作按钮区 - 下排：管理操作 -->
          <div class="action-section">
            <div class="action-section-label">
              <text style="color: {{ theme.textSecondary }}">管理</text>
            </div>
            <div class="action-row-secondary">
              <div class="action-item action-item-outline" onclick="startRename($idx)" style="border-color: {{ theme.accent }}">
                <text class="action-icon" style="color: {{ theme.accent }}">📝</text>
                <text class="action-label" style="color: {{ theme.accent }}">重命名</text>
              </div>
              <div class="action-item action-item-outline" onclick="copySchedule($idx)" style="border-color: {{ theme.accent }}">
                <text class="action-icon" style="color: {{ theme.accent }}">📋</text>
                <text class="action-label" style="color: {{ theme.accent }}">复制</text>
              </div>
              <div class="action-item action-item-danger" if="{{ scheduleList.length > 1 }}" onclick="deleteSchedule($idx)" style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : theme.deleteBg }}">
                <text class="action-icon">{{ deleteConfirmIndex === $idx ? '⚠️' : '🗑️' }}</text>
                <text class="action-label" style="color: {{ deleteConfirmIndex === $idx ? '#ffffff' : theme.deleteText }}">
                  {{ deleteConfirmIndex === $idx ? '确认删除' : '删除' }}
                </text>
              </div>
            </div>
          </div>

          <!-- 选中使用提示 -->
          <div class="card-tip" if="{{ $idx === currentIndex }}" style="background-color: {{ theme.cardLight }}">
            <text class="card-tip-text" style="color: {{ theme.accent }}">💡 点击卡片区域可返回并应用此课程表</text>
          </div>
        </div>

        <!-- 列表底部留白 -->
        <div class="list-bottom-spacer"></div>
      </div>
    </scroll>

    <!-- 底部新增按钮 -->
    <div class="footer-bar" style="background-color: {{ theme.bg }}">
      <div class="add-btn-wrapper">
        <div class="add-btn" onclick="addSchedule" style="background-color: {{ theme.accent }}">
          <text class="add-btn-icon">＋</text>
          <text class="add-btn-text" style="color: {{ theme.bg }}">新增课程表</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

export default {
  private: {
    scheduleList: [],
    currentIndex: 0,
    editingIndex: -1,
    editName: "",
    deleteConfirmIndex: -1,
    theme: {
      bg: '#0f172a',
      card: '#1e293b',
      cardLight: '#334155',
      accent: '#3b82f6',
      text: '#f8fafc',
      textSecondary: '#94a3b8',
      textMuted: '#64748b',
      btnSecondary: '#475569',
      btnSecondaryText: '#e2e8f0',
      deleteBg: '#1e1b2e',
      deleteText: '#ef4444'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadData()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.editName = data
          storage.delete({ key: "chinese_input_result" })
        }
      }
    })

    this.loadData()
  },

  loadData() {
    var self = this
    store.getScheduleNames(function(names) {
      var list = []
      for (var i = 0; i < names.length; i++) {
        list.push({ name: names[i] })
      }
      self.scheduleList = list
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentIndex = idx
    })
  },

  goBack() {
    if (this.editingIndex >= 0) {
      this.cancelEdit()
      return
    }
    router.back()
  },

  openStatistics() {
    var storage = require("@system.storage")
    storage.set({
      key: "statistics_index",
      value: "-1",
      success: function() {
        router.push({ uri: "/pages/statistics" })
      },
      fail: function() {
        router.push({ uri: "/pages/statistics" })
      }
    })
  },

  openScheduleStats(index) {
    var storage = require("@system.storage")
    storage.set({
      key: "statistics_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/statistics" })
      },
      fail: function() {
        router.push({ uri: "/pages/statistics" })
      }
    })
  },

  selectSchedule(index) {
    if (this.editingIndex >= 0) {
      return
    }
    if (index === this.currentIndex) {
      router.back()
      return
    }
    var self = this
    database.setScheduleIndex(index, function() {
      store.setCurrentScheduleIndex(index, function() {
        self.currentIndex = index
        router.back()
      })
    })
  },

  startRename(index) {
    this.editingIndex = index
    this.editName = this.scheduleList[index].name

    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "重命名课程表" })
    storage.set({ key: "chinese_input_placeholder", value: "输入新名称" })
    storage.set({ key: "chinese_input_value", value: this.editName })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  finishEdit() {
    if (!this.editName || this.editName.trim() === "") {
      return
    }

    var newName = this.editName.trim()
    var exists = false
    for (var i = 0; i < this.scheduleList.length; i++) {
      if (i !== this.editingIndex && this.scheduleList[i].name === newName) {
        exists = true
        break
      }
    }

    if (exists) {
      return
    }

    this.scheduleList[this.editingIndex].name = newName

    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }

    var self = this
    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "已重命名" })
      self.editingIndex = -1
      self.editName = ""
      self.loadData()
    })
  },

  cancelEdit() {
    this.editingIndex = -1
    this.editName = ""
  },

  openWeekView(index) {
    var storage = require("@system.storage")
    storage.set({
      key: "weekview_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/week-view" })
      },
      fail: function() {
        router.push({ uri: "/pages/week-view" })
      }
    })
  },

  addSchedule() {
    var self = this
    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }
    var newName = "课程表" + (names.length + 1)
    var counter = 1
    while (names.indexOf(newName) !== -1) {
      newName = "课程表" + (names.length + 1) + "(" + counter + ")"
      counter++
    }
    names.push(newName)
    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "课程表已添加" })
      self.loadData()
    })
  },

  copySchedule(index) {
    var self = this
    var sourceName = this.scheduleList[index].name
    var newName = sourceName + " (副本)"
    var newIndex = this.scheduleList.length

    var exists = false
    for (var i = 0; i < this.scheduleList.length; i++) {
      if (this.scheduleList[i].name === newName) {
        exists = true
        break
      }
    }
    if (exists) {
      newName = sourceName + " (副本" + newIndex + ")"
    }

    database.getAllCoursesWithIndex(index, function(sourceData) {
      var names = []
      for (var i = 0; i < self.scheduleList.length; i++) {
        names.push(self.scheduleList[i].name)
      }
      names.push(newName)

      store.setScheduleNames(names, function() {
        database.setScheduleIndex(newIndex, function() {
          if (!sourceData || sourceData.length === 0) {
            self.loadData()
            return
          }

          var totalCourses = 0
          for (var d = 0; d < sourceData.length; d++) {
            totalCourses += sourceData[d].classes.length
          }

          if (totalCourses === 0) {
            self.loadData()
            return
          }

          var inserted = 0
          for (var d = 0; d < sourceData.length; d++) {
            var dayData = sourceData[d]
            for (var c = 0; c < dayData.classes.length; c++) {
              var course = dayData.classes[c]
              var newCourse = {
                id: course.id + "_c" + newIndex,
                day: course.day,
                name: course.name,
                time: course.time,
                teacher: course.teacher,
                location: course.location,
                notes: course.notes || ""
              }
              database.insertCourse(newCourse, function() {
                inserted++
                if (inserted === totalCourses) {
                  database.setScheduleIndex(self.currentIndex, function() {
                    prompt.showToast({ message: "课程表已复制" })
                    self.loadData()
                  })
                }
              })
            }
          }
        })
      })
    })
  },

  deleteSchedule(index) {
    if (this.scheduleList.length <= 1) {
      return
    }
    if (this.deleteConfirmIndex !== index) {
      this.deleteConfirmIndex = index
      var self = this
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirmIndex = -1
      }, 5000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    this.deleteConfirmIndex = -1
    var self = this
    var needSwitch = (index === this.currentIndex)

    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }
    names.splice(index, 1)

    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "课程表已删除" })
      if (needSwitch) {
        store.setCurrentScheduleIndex(0, function() {
          database.setScheduleIndex(0, function() {
            self.currentIndex = 0
            self.loadData()
          })
        })
      } else if (index < self.currentIndex) {
        var newIdx = self.currentIndex - 1
        store.setCurrentScheduleIndex(newIdx, function() {
          database.setScheduleIndex(newIdx, function() {
            self.currentIndex = newIdx
            self.loadData()
          })
        })
      } else {
        self.loadData()
      }
    })
  },

  openQrPopup(index) {
    var storage = require("@system.storage")
    storage.set({
      key: "schedule_qrcode_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      },
      fail: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      }
    })
  }
}
</script>

