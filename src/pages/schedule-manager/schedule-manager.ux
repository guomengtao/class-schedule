<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">课程表管理</text>
    </div>

    <div class="rename-bar" if="{{ editingIndex >= 0 }}" style="background-color: {{ theme.card }}">
      <div class="rename-display" onclick="startRename(editingIndex)" style="background-color: {{ theme.cardLight }}; border-color: {{ theme.accent }}">
        <text class="rename-text" style="color: {{ theme.text }}">{{ editName || '输入新名称' }}</text>
      </div>
      <input class="rename-ok-btn" type="button" value="保存" onclick="finishEdit" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="rename-cancel-btn" type="button" value="取消" onclick="cancelEdit" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>

    <div for="{{ list }}" class="item" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <div class="item-left" onclick="toggle($idx)">
          <div class="box" style="background-color: {{ $idx === currentIndex ? theme.accent : theme.cardLight }}; border-color: {{ theme.accent }}">
            <text class="check" style="color: {{ $idx === currentIndex ? theme.bg : theme.textMuted }}">{{ $idx === currentIndex ? '✓' : '' }}</text>
          </div>
          <text class="name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        </div>
        <text class="expand-arrow" onclick="expandItem($idx)" style="color: {{ theme.accent }}">{{ expandedIndex === $idx ? '▲' : '▼' }}</text>
      </div>

      <div class="actions" if="{{ expandedIndex === $idx }}">
        <div class="action-divider" style="background-color: {{ theme.border || theme.borderLight }}"></div>
        <div class="action-row">
          <div class="action-btn" onclick="startRename($idx)" style="background-color: {{ theme.cardLight }}">
            <text class="action-btn-text" style="color: {{ theme.text }}">重命名</text>
          </div>
          <div class="action-btn" onclick="copySchedule($idx)" style="background-color: {{ theme.cardLight }}">
            <text class="action-btn-text" style="color: {{ theme.text }}">复制</text>
          </div>
          <div class="action-btn" onclick="openQrPopup($idx)" style="background-color: {{ theme.cardLight }}">
            <text class="action-btn-text" style="color: {{ theme.text }}">导出</text>
          </div>
        </div>
        <div class="action-row">
          <div class="action-btn" onclick="openWeekView($idx)" style="background-color: {{ theme.cardLight }}">
            <text class="action-btn-text" style="color: {{ theme.text }}">总览</text>
          </div>
          <div class="action-btn" onclick="openScheduleStats($idx)" style="background-color: {{ theme.cardLight }}">
            <text class="action-btn-text" style="color: {{ theme.text }}">统计</text>
          </div>
          <div class="action-btn delete-btn" if="{{ list.length > 1 }}" onclick="deleteSchedule($idx)" style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : theme.deleteBg }}">
            <text class="action-btn-text" style="color: {{ deleteConfirmIndex === $idx ? '#ffffff' : theme.deleteText }}">{{ deleteConfirmIndex === $idx ? '确认' : '删除' }}</text>
          </div>
        </div>
      </div>
    </div>

    <div class="add-section">
      <input class="add-btn" type="button" value="+ 新增课程表" onclick="addSchedule" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <unlock-dialog id="unlockDialog"></unlock-dialog>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}; font-size: 13px;">📌 固定到首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const authStore = require("../../data/auth-store.js")

export default {
  private: {
    isPro: false,
    list: [],
    currentIndex: 0,
    expandedIndex: -1,
    editingIndex: -1,
    editName: "",
    deleteConfirmIndex: -1,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textMuted: '#555566',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadData()
    this.checkProStatus()
  },

  checkProStatus() {
    var self = this
    authStore.checkStatus(function(status) {
      self.isPro = status.isActivated
    })
  },

  checkProAccess() {
    var self = this
    if (!self.isPro) {
      store.showUnlockDialog({
        title: "解锁多课表管理",
        description: "一次性解锁，永久使用全部高级功能",
        benefits: ["多课表管理", "课表复制导出", "数据备份与恢复", "首页自定义"],
        cancelText: "暂不需要"
      })
      return false
    }
    return true
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.editName = data
          storage.delete({ key: "chinese_input_result" })
        }
      }
    })

    this.loadData()
  },

  loadData() {
    var self = this
    store.getScheduleNames(function(names) {
      var list = []
      for (var i = 0; i < names.length; i++) {
        list.push({ name: names[i] })
      }
      self.list = list
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentIndex = idx
    })
  },

  expandItem(idx) {
    if (this.expandedIndex === idx) {
      this.expandedIndex = -1
    } else {
      this.expandedIndex = idx
    }
  },

  toggle(idx) {
    if (idx === this.currentIndex) {
      router.back()
      return
    }
    var self = this
    this.currentIndex = idx
    this.expandedIndex = -1
    store.setCurrentScheduleIndex(idx, function() {
      database.setScheduleIndex(idx, function() {
        prompt.showToast({ message: "已切换到 " + self.list[idx].name })
        router.back()
      })
    })
  },

  startRename(index) {
    if (!this.checkProAccess()) return
    this.editingIndex = index
    this.editName = this.list[index].name

    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "重命名课程表" })
    storage.set({ key: "chinese_input_placeholder", value: "输入新名称" })
    storage.set({ key: "chinese_input_value", value: this.editName })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  finishEdit() {
    if (!this.editName || this.editName.trim() === "") {
      return
    }

    var newName = this.editName.trim()
    var exists = false
    for (var i = 0; i < this.list.length; i++) {
      if (i !== this.editingIndex && this.list[i].name === newName) {
        exists = true
        break
      }
    }

    if (exists) {
      return
    }

    this.list[this.editingIndex].name = newName

    var names = []
    for (var i = 0; i < this.list.length; i++) {
      names.push(this.list[i].name)
    }

    var self = this
    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "已重命名" })
      self.editingIndex = -1
      self.editName = ""
      self.loadData()
    })
  },

  cancelEdit() {
    this.editingIndex = -1
    this.editName = ""
  },

  copySchedule(index) {
    if (!this.checkProAccess()) return
    var self = this
    var sourceName = this.list[index].name
    var newName = sourceName + " (副本)"
    var newIndex = this.list.length

    var exists = false
    for (var i = 0; i < this.list.length; i++) {
      if (this.list[i].name === newName) {
        exists = true
        break
      }
    }
    if (exists) {
      newName = sourceName + " (副本" + newIndex + ")"
    }

    database.getAllCoursesWithIndex(index, function(sourceData) {
      var names = []
      for (var i = 0; i < self.list.length; i++) {
        names.push(self.list[i].name)
      }
      names.push(newName)

      store.setScheduleNames(names, function() {
        database.setScheduleIndex(newIndex, function() {
          if (!sourceData || sourceData.length === 0) {
            self.loadData()
            return
          }

          var totalCourses = 0
          for (var d = 0; d < sourceData.length; d++) {
            totalCourses += sourceData[d].classes.length
          }

          if (totalCourses === 0) {
            self.loadData()
            return
          }

          var inserted = 0
          for (var d = 0; d < sourceData.length; d++) {
            var dayData = sourceData[d]
            for (var c = 0; c < dayData.classes.length; c++) {
              var course = dayData.classes[c]
              var newCourse = {
                id: course.id + "_c" + newIndex,
                day: course.day,
                name: course.name,
                time: course.time,
                teacher: course.teacher,
                location: course.location,
                notes: course.notes || ""
              }
              database.insertCourse(newCourse, function(err) {
                if (!err) {
                  inserted++
                }
                if (inserted === totalCourses) {
                  database.setScheduleIndex(self.currentIndex, function() {
                    prompt.showToast({ message: "课程表已复制" })
                    self.loadData()
                  })
                }
              })
            }
          }
        })
      })
    })
  },

  openQrPopup(index) {
    if (!this.checkProAccess()) return
    var storage = require("@system.storage")
    storage.set({
      key: "schedule_qrcode_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      },
      fail: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      }
    })
  },

  openWeekView(index) {
    if (!this.checkProAccess()) return
    var storage = require("@system.storage")
    storage.set({
      key: "weekview_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/week-view" })
      },
      fail: function() {
        router.push({ uri: "/pages/week-view" })
      }
    })
  },

  openScheduleStats(index) {
    if (!this.checkProAccess()) return
    var storage = require("@system.storage")
    storage.set({
      key: "statistics_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/statistics" })
      },
      fail: function() {
        router.push({ uri: "/pages/statistics" })
      }
    })
  },

  deleteSchedule(index) {
    if (this.list.length <= 1) {
      return
    }
    if (this.deleteConfirmIndex !== index) {
      if (this.deleteTimer) {
        clearTimeout(this.deleteTimer)
        this.deleteTimer = null
      }
      this.deleteConfirmIndex = index
      var self = this
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirmIndex = -1
      }, 5000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    this.deleteConfirmIndex = -1
    var self = this
    var needSwitch = (index === this.currentIndex)
    var deletedName = this.list[index].name

    this.list.splice(index, 1)

    if (needSwitch) {
      this.currentIndex = 0
    } else if (index < this.currentIndex) {
      this.currentIndex = this.currentIndex - 1
    }

    var names = []
    for (var i = 0; i < this.list.length; i++) {
      names.push(this.list[i].name)
    }

    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "已删除 " + deletedName })
      if (needSwitch) {
        database.setScheduleIndex(0, function() {})
      } else if (index < self.currentIndex) {
        database.setScheduleIndex(self.currentIndex, function() {})
      }
    })
  },

  addSchedule() {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        self.doAddSchedule()
      } else {
        if (self.list.length >= 1) {
          store.showUnlockDialog({})
        } else {
          self.doAddSchedule()
        }
      }
    })
  },

  doAddSchedule() {
    var names = []
    for (var i = 0; i < this.list.length; i++) {
      names.push(this.list[i].name)
    }

    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    var newName = ""
    for (var attempt = 0; attempt < 100; attempt++) {
      var suffix = ""
      for (var j = 0; j < 3; j++) {
        suffix += chars.charAt(Math.floor(Math.random() * chars.length))
      }
      var candidate = "课程表" + suffix
      if (names.indexOf(candidate) === -1) {
        newName = candidate
        break
      }
    }
    if (!newName) {
      newName = "课程表" + Date.now().toString(36).slice(-3)
    }
    names.push(newName)
    var newIndex = names.length - 1
    var self = this
    store.setScheduleNames(names, function() {
      database.setScheduleIndex(newIndex, function() {
        var storage = require("@system.storage")
        var STORAGE_KEY = "allCourses"
        storage.set({
          key: STORAGE_KEY + "_" + newIndex,
          value: "[]",
          success: function() {
            prompt.showToast({ message: "已添加 " + newName })
            self.loadData()
          },
          fail: function() {
            prompt.showToast({ message: "已添加 " + newName })
            self.loadData()
          }
        })
      })
    })
  },

  goBack() {
    if (this.editingIndex >= 0) {
      this.cancelEdit()
      return
    }
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("课程表管理", "/pages/schedule-manager")
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 12px 12px 12px;
  height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
}

.back-btn {
  width: 48px;
  height: 36px;
  border-radius: 8px;
  font-size: 18px;
  text-align: center;
  flex-shrink: 0;
}

.title {
  font-size: 20px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 16px 0 8px 0;
}

.pin-link {
  text-align: center;
}

.rename-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 12px;
  border-radius: 10px;
}

.rename-display {
  flex: 1;
  height: 40px;
  border-radius: 8px;
  border-width: 2px;
  font-size: 18px;
  padding: 0 12px;
  flex-direction: row;
  align-items: center;
}

.rename-text {
  font-size: 18px;
}

.rename-ok-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  margin-left: 8px;
}

.rename-cancel-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  font-size: 16px;
  text-align: center;
  margin-left: 6px;
}

.item {
  flex-direction: column;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 12px;
}

.item-row {
  flex-direction: row;
  align-items: center;
}

.item-left {
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.box {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  border-width: 2px;
  border-style: solid;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check {
  font-size: 18px;
  font-weight: bold;
}

.name {
  font-size: 16px;
  font-weight: bold;
  margin-left: 10px;
  flex: 1;
}

.expand-arrow {
  font-size: 12px;
  padding: 4px;
  flex-shrink: 0;
}

.actions {
  flex-direction: column;
  padding-top: 12px;
  margin-top: 10px;
}

.action-divider {
  height: 1px;
  margin: 8px 0;
}

.action-row {
  flex-direction: row;
  margin-bottom: 6px;
}

.action-btn {
  flex: 1;
  height: 34px;
  border-radius: 8px;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}

.action-btn-text {
  font-size: 15px;
}

.add-section {
  margin-top: 10px;
  padding-bottom: 4px;
}

.add-btn {
  width: 100%;
  height: 42px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}
</style>