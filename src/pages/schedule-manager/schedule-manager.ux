<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <stack class="page-root">
  <scroll class="page" scroll-y="true" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">课程表管理</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="rename-bar" if="{{ editingIndex >= 0 }}" style="background-color: {{ theme.card }}">
      <div class="rename-display" onclick="startRename(editingIndex)" style="background-color: {{ theme.cardLight }}; border-color: {{ theme.accent }}">
        <text class="rename-text" style="color: {{ theme.text }}">{{ editName || '输入新名称' }}</text>
      </div>
      <div class="rename-btn-row">
        <input class="rename-ok-btn" type="button" value="保存" onclick="finishEdit" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="rename-cancel-btn" type="button" value="取消" onclick="cancelEdit" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>

    <div for="{{ list }}" class="item" style="background-color: {{ theme.card }}">
      <div class="item-main" onclick="toggle($idx)">
        <div class="indicator"
             style="background-color: {{ $idx === currentIndex ? theme.accent : 'transparent' }}; border-color: {{ $idx === currentIndex ? theme.accent : theme.textMuted }}"></div>
        <text class="name" style="color: {{ $idx === currentIndex ? theme.accent : theme.text }}; font-weight: {{ $idx === currentIndex ? 'bold' : 'normal' }}">{{ $item.name }}</text>
      </div>
      <div class="more-hit" onclick="openSheet($idx)">
        <div class="more-dot" style="background-color: {{ theme.textMuted }}"></div>
        <div class="more-dot" style="background-color: {{ theme.textMuted }}"></div>
        <div class="more-dot" style="background-color: {{ theme.textMuted }}"></div>
      </div>
    </div>

    <text if="{{ list.length === 0 }}" class="empty-hint" style="color: {{ theme.textMuted }}; text-align: center; padding: 40px 10px;">暂无课程表，点击下方按钮创建</text>

    <div class="add-section">
      <input class="add-btn" type="button" value="+ 新增课程表" onclick="addSchedule" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <unlock-dialog id="unlockDialog"></unlock-dialog>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}; font-size: 20px;">固定到首页</text>
    </div>
  </scroll>

  <div class="overlay-sheet" if="{{ sheetIndex >= 0 }}" onclick="closeSheet">
    <div class="sheet-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
      <text class="sheet-title" style="color: {{ theme.text }}">{{ sheetName }}</text>
      <text class="sheet-sub" style="color: {{ theme.textMuted }}">{{ sheetCount }} 门课程</text>

      <div class="sheet-switch-row" onclick="toggleHolidayReminder">
        <text class="sheet-switch-label" style="color: {{ theme.text }}">假期提醒</text>
        <div class="switch-track"
             style="background-color: {{ holidayReminderOn ? theme.accent : theme.btnSecondary }}">
          <div class="switch-thumb"
               style="background-color: {{ theme.card }}; {{ holidayReminderOn ? 'margin-left: 24px;' : 'margin-left: 2px;' }}">
          </div>
        </div>
      </div>

      <div class="sheet-grid">
        <div class="sheet-btn" onclick="sheetRename" style="background-color: {{ theme.cardLight }}">
          <text class="sheet-btn-text" style="color: {{ theme.text }}">重命名</text>
        </div>
        <div class="sheet-btn" onclick="sheetCopy" style="background-color: {{ theme.cardLight }}">
          <text class="sheet-btn-text" style="color: {{ theme.text }}">复制</text>
        </div>
        <div class="sheet-btn" onclick="sheetExport" style="background-color: {{ theme.cardLight }}">
          <text class="sheet-btn-text" style="color: {{ theme.text }}">导出</text>
        </div>
        <div class="sheet-btn" onclick="sheetWeekView" style="background-color: {{ theme.cardLight }}">
          <text class="sheet-btn-text" style="color: {{ theme.text }}">总览</text>
        </div>
        <div class="sheet-btn" onclick="sheetStats" style="background-color: {{ theme.cardLight }}">
          <text class="sheet-btn-text" style="color: {{ theme.text }}">统计</text>
        </div>
        <div class="sheet-btn" if="{{ list.length > 1 }}" onclick="sheetDelete"
             style="background-color: {{ deleteConfirmIndex === sheetIndex ? theme.deleteText : theme.deleteBg }}">
          <text class="sheet-btn-text" style="color: {{ deleteConfirmIndex === sheetIndex ? theme.text : theme.deleteText }}">{{ deleteConfirmIndex === sheetIndex ? '确认删除' : '删除' }}</text>
        </div>
      </div>

      <input class="sheet-close" type="button" value="取消" onclick="closeSheet"
             style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>
  </div>

  <div class="overlay-modal" if="{{ showDialog }}" onclick="dismissDialog">
    <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
      <text class="modal-title" style="color: {{ theme.accent }}">解锁高级版</text>
      <text class="modal-desc" style="color: {{ theme.textSecondary }}">新增课表需要高级版，一次性解锁永久使用</text>
      <div class="benefit-list">
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 多课表管理</text>
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
        <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
      </div>
      <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="modal-btn-secondary" type="button" value="取消" onclick="dismissDialog"
             style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>
  </div>
  </stack>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

export default {
  private: {
    iconTheme: "dark",
    list: [],
    currentIndex: 0,
    editingIndex: -1,
    editName: "",
    deleteConfirmIndex: -1,
    sheetIndex: -1,
    sheetName: "",
    sheetCount: 0,
    holidayReminderOn: false,
    showDialog: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textMuted: '#555566',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadData()
  },

  onReady() {
    this.checkAndShowOverlay()
  },

  checkProAccess() {
    return true
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadData()
    this.checkAndShowOverlay()
    this.checkInputResult()
  },

  checkAndShowOverlay() {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (!unlocked) {
        self.showDialog = true
      }
    })
  },

  loadData() {
    var self = this
    store.getScheduleNames(function(names) {
      console.log("[loadData] names=" + JSON.stringify(names) + " count=" + names.length)
      var list = []
      for (var i = 0; i < names.length; i++) {
        list.push({ name: names[i], courseCount: 0, holidayOn: false })
      }
      self.list = list
      for (var i = 0; i < names.length; i++) {
        (function(idx) {
          database.getAllCoursesWithIndex(idx, function(schedule) {
            var count = 0
            if (schedule) {
              for (var d = 0; d < schedule.length; d++) {
                count += (schedule[d].classes || []).length
              }
            }
            self.list[idx].courseCount = count
          })
          store.getHolidayReminderEnabled(idx, function(on) {
            self.list[idx].holidayOn = on
          })
        })(i)
      }
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentIndex = idx
    })
  },

  openSheet(idx) {
    this.sheetIndex = idx
    this.sheetName = this.list[idx].name
    this.sheetCount = this.list[idx].courseCount
    this.holidayReminderOn = this.list[idx].holidayOn || false
    this.deleteConfirmIndex = -1
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
  },

  closeSheet() {
    this.sheetIndex = -1
    this.deleteConfirmIndex = -1
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
  },

  toggleHolidayReminder() {
    var idx = this.sheetIndex
    if (idx < 0 || idx >= this.list.length) return
    var newVal = !this.holidayReminderOn
    this.holidayReminderOn = newVal
    this.list[idx].holidayOn = newVal
    store.setHolidayReminderEnabled(idx, newVal)
  },

  sheetRename() {
    var idx = this.sheetIndex
    this.closeSheet()
    this.startRename(idx)
  },

  sheetCopy() {
    var idx = this.sheetIndex
    this.closeSheet()
    this.copySchedule(idx)
  },

  sheetExport() {
    var idx = this.sheetIndex
    this.closeSheet()
    this.openQrPopup(idx)
  },

  sheetWeekView() {
    var idx = this.sheetIndex
    this.closeSheet()
    this.openWeekView(idx)
  },

  sheetStats() {
    var idx = this.sheetIndex
    this.closeSheet()
    this.openScheduleStats(idx)
  },

  sheetDelete() {
    this.deleteSchedule(this.sheetIndex)
  },

  toggle(idx) {
    console.log("[toggle] called with idx=" + idx + " currentIndex=" + this.currentIndex + " list.length=" + this.list.length)
    if (idx === this.currentIndex) {
      console.log("[toggle] EARLY RETURN: already on this schedule")
      return
    }
    var self = this
    this.currentIndex = idx
    console.log("[toggle] set currentIndex to " + idx + ", calling store.setCurrentScheduleIndex")
    store.setCurrentScheduleIndex(idx, function() {
      console.log("[toggle] store.setCurrentScheduleIndex success, calling database.setScheduleIndex")
      database.setScheduleIndex(idx, function() {
        console.log("[toggle] database.setScheduleIndex success, showing toast")
        prompt.showToast({ message: "已切换到 " + self.list[idx].name })
      })
    })
  },

  startRename(index) {
    if (!this.checkProAccess()) return
    this.editingIndex = index
    this.editName = this.list[index].name
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "重命名课表", success: function() {} })
    storage.set({ key: "chinese_input_value", value: this.editName, success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "10", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  checkInputResult() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.editName = data
          self.finishEdit()
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  finishEdit() {
    if (!this.editName || this.editName.trim() === "") {
      return
    }

    var newName = this.editName.trim()
    var exists = false
    for (var i = 0; i < this.list.length; i++) {
      if (i !== this.editingIndex && this.list[i].name === newName) {
        exists = true
        break
      }
    }

    if (exists) {
      return
    }

    this.list[this.editingIndex].name = newName

    var names = []
    for (var i = 0; i < this.list.length; i++) {
      names.push(this.list[i].name)
    }

    var self = this
    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "已重命名" })
      self.editingIndex = -1
      self.editName = ""
      self.loadData()
    })
  },

  cancelEdit() {
    this.editingIndex = -1
    this.editName = ""
  },

  copySchedule(index) {
    if (!this.checkProAccess()) return
    var self = this
    var sourceName = this.list[index].name
    var newName = sourceName + " (副本)"
    var newIndex = this.list.length

    var exists = false
    for (var i = 0; i < this.list.length; i++) {
      if (this.list[i].name === newName) {
        exists = true
        break
      }
    }
    if (exists) {
      newName = sourceName + " (副本" + newIndex + ")"
    }

    database.getAllCoursesWithIndex(index, function(sourceData) {
      if (!sourceData || sourceData.length === 0) {
        prompt.showToast({ message: "源课表无数据，无法复制" })
        return
      }

      var totalCourses = 0
      for (var d = 0; d < sourceData.length; d++) {
        totalCourses += sourceData[d].classes.length
      }

      if (totalCourses === 0) {
        prompt.showToast({ message: "源课表无课程，无法复制" })
        return
      }

      var names = []
      for (var i = 0; i < self.list.length; i++) {
        names.push(self.list[i].name)
      }
      names.push(newName)

      store.setScheduleNames(names, function() {
        database.setScheduleIndex(newIndex, function() {
          var processed = 0
          var hasError = false
          for (var d = 0; d < sourceData.length; d++) {
            var dayData = sourceData[d]
            for (var c = 0; c < dayData.classes.length; c++) {
              var course = dayData.classes[c]
              var newCourse = {
                id: course.id + "_c" + newIndex,
                day: course.day,
                name: course.name,
                time: course.time,
                teacher: course.teacher,
                location: course.location,
                notes: course.notes || ""
              }
              database.insertCourse(newCourse, function(err) {
                if (err) hasError = true
                processed++
                if (processed >= totalCourses) {
                  database.setScheduleIndex(self.currentIndex, function() {
                    prompt.showToast({ message: hasError ? "复制部分失败" : "课程表已复制" })
                    self.loadData()
                  })
                }
              })
            }
          }
        })
      })
    })
  },

  openQrPopup(index) {
    if (!this.checkProAccess()) return
    var storage = require("@system.storage")
    storage.set({
      key: "schedule_qrcode_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      },
      fail: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      }
    })
  },

  openWeekView(index) {
    if (!this.checkProAccess()) return
    var storage = require("@system.storage")
    storage.set({
      key: "weekview_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/week-view" })
      },
      fail: function() {
        router.push({ uri: "/pages/week-view" })
      }
    })
  },

  openScheduleStats(index) {
    if (!this.checkProAccess()) return
    var storage = require("@system.storage")
    storage.set({
      key: "statistics_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/statistics" })
      },
      fail: function() {
        router.push({ uri: "/pages/statistics" })
      }
    })
  },

  deleteSchedule(index) {
    if (this.list.length <= 1) {
      return
    }
    if (this.deleteConfirmIndex !== index) {
      if (this.deleteTimer) {
        clearTimeout(this.deleteTimer)
        this.deleteTimer = null
      }
      this.deleteConfirmIndex = index
      var self = this
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirmIndex = -1
      }, 5000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    this.deleteConfirmIndex = -1
    var self = this
    var needSwitch = (index === this.currentIndex)
    var deletedName = this.list[index].name
    var totalBeforeDelete = this.list.length

    // Shift course data in storage first (delete + shift allCourses keys)
    database.deleteScheduleAndShift(index, totalBeforeDelete, function() {
      var newList = []
      for (var i = 0; i < self.list.length; i++) {
        if (i !== index) {
          newList.push({ name: self.list[i].name, courseCount: self.list[i].courseCount })
        }
      }
      self.list = newList

      if (needSwitch) {
        self.currentIndex = 0
      } else if (index < self.currentIndex) {
        self.currentIndex = self.currentIndex - 1
      }

      var names = []
      for (var i = 0; i < self.list.length; i++) {
        names.push(self.list[i].name)
      }

      store.setScheduleNames(names, function() {
        prompt.showToast({ message: "已删除 " + deletedName })
        self.closeSheet()
        if (needSwitch) {
          database.setScheduleIndex(0, function() {})
        } else if (index < self.currentIndex) {
          database.setScheduleIndex(self.currentIndex, function() {})
        }
      })
    })
  },

  addSchedule() {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        self.doAddSchedule()
      } else {
        self.showDialog = true
      }
    })
  },

  goToPremium() {
    this.showDialog = false
    router.push({ uri: "/pages/activation" })
  },

  stopBubble() {
  },

  doAddSchedule() {
    var names = []
    for (var i = 0; i < this.list.length; i++) {
      names.push(this.list[i].name)
    }

    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    var newName = ""
    for (var attempt = 0; attempt < 100; attempt++) {
      var suffix = ""
      for (var j = 0; j < 3; j++) {
        suffix += chars.charAt(Math.floor(Math.random() * chars.length))
      }
      var candidate = "课程表" + suffix
      if (names.indexOf(candidate) === -1) {
        newName = candidate
        break
      }
    }
    if (!newName) {
      newName = "课程表" + Date.now().toString(36).slice(-3)
    }
    names.push(newName)
    var newIndex = names.length - 1
    var self = this
    store.setScheduleNames(names, function() {
      database.setScheduleIndex(newIndex, function() {
        var storage = require("@system.storage")
        var STORAGE_KEY = "allCourses"
        storage.set({
          key: STORAGE_KEY + "_" + newIndex,
          value: "[]",
          success: function() {
            prompt.showToast({ message: "已添加 " + newName })
            self.loadData()
          },
          fail: function() {
            prompt.showToast({ message: "已添加 " + newName })
            self.loadData()
          }
        })
      })
    })
  },

  goBack() {
    if (this.editingIndex >= 0) {
      this.cancelEdit()
      return
    }
    router.back()
  },

  dismissDialog() {
    this.showDialog = false
  },

  pinToHome() {
    pinHelper.pinPage("课程表管理", "/pages/schedule-manager")
  },

  onDestroy() {
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  padding: 44px 12px 12px 12px;
  height: 100%;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 16px 0 8px 0;
  flex-shrink: 0;
}

.pin-link {
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

.rename-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 12px;
  border-radius: 10px;
  flex-shrink: 0;
}

.rename-display {
  flex: 1;
  height: 40px;
  border-radius: 8px;
  border-width: 2px;
  font-size: 20px;
  line-height: 28px;
  padding: 0 12px;
  flex-direction: row;
  align-items: center;
}

.rename-btn-row {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.rename-text {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
  text-overflow: ellipsis;
}

.rename-ok-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  font-size: 20px;
  line-height: 28px;
  font-weight: bold;
  text-align: center;
  margin-left: 8px;
}

.rename-cancel-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  font-size: 20px;
  line-height: 28px;
  text-align: center;
  margin-left: 6px;
}

.item {
  flex-direction: row;
  align-items: center;
  height: 60px;
  padding: 0 4px 0 14px;
  margin-bottom: 10px;
  border-radius: 14px;
  flex-shrink: 0;
}

.item-main {
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 100%;
}

.indicator {
  width: 16px;
  height: 16px;
  border-radius: 8px;
  border-width: 2px;
  border-style: solid;
  flex-shrink: 0;
  margin-right: 12px;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 24px;
  line-height: 32px;
  lines: 1;
  text-overflow: ellipsis;
}

.more-hit {
  width: 56px;
  height: 60px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.more-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  flex-shrink: 0;
  margin: 3px 0;
}

.overlay-sheet {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.55);
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  z-index: 1000;
}

.sheet-card {
  width: 100%;
  border-radius: 20px 20px 0 0;
  padding: 20px 14px 16px 14px;
  flex-direction: column;
  align-items: center;
}

.sheet-title {
  font-size: 26px;
  font-weight: bold;
  line-height: 34px;
  text-align: center;
  margin-bottom: 4px;
  lines: 1;
  text-overflow: ellipsis;
}

.sheet-sub {
