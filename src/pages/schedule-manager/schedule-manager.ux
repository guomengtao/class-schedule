<template>
  <div class="manager-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">课程表管理</text>
      <input class="stats-btn" type="button" value="统计" onclick="openStatistics" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
    </div>

    <div class="rename-bar" show="{{ editingIndex >= 0 }}" style="background-color: {{ theme.card }}">
      <div class="rename-display" onclick="startRename(editingIndex)" style="background-color: {{ theme.cardLight }}; border-color: {{ theme.accent }}">
        <text class="rename-text" style="color: {{ theme.text }}">{{ editName || '输入新名称' }}</text>
      </div>
      <input class="rename-ok-btn" type="button" value="保存" onclick="finishEdit" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="rename-cancel-btn" type="button" value="取消" onclick="cancelEdit" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>

    <scroll class="schedule-list-scroll" scroll-y="{{true}}">
      <div for="{{ scheduleList }}" class="schedule-item {{ $idx === currentIndex ? 'active' : '' }}" style="background-color: {{ theme.card }}; border-left-color: {{ $idx === currentIndex ? theme.accent : theme.bg }}">
        <div class="item-header" onclick="selectSchedule($idx)">
          <text class="schedule-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="badge" if="{{ $idx === currentIndex }}" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">使用中</text>
        </div>

        <div class="actions-grid">
          <div class="action-row">
            <div class="action-btn" onclick="startRename($idx)" style="background-color: {{ theme.cardLight }}">
              <text class="action-btn-text" style="color: {{ theme.text }}">重命名</text>
            </div>
            <div class="action-btn" onclick="copySchedule($idx)" style="background-color: {{ theme.cardLight }}">
              <text class="action-btn-text" style="color: {{ theme.text }}">复制</text>
            </div>
            <div class="action-btn" onclick="openQrPopup($idx)" style="background-color: {{ theme.cardLight }}">
              <text class="action-btn-text" style="color: {{ theme.text }}">导出</text>
            </div>
          </div>
          <div class="action-row">
            <div class="action-btn" onclick="openWeekView($idx)" style="background-color: {{ theme.cardLight }}">
              <text class="action-btn-text" style="color: {{ theme.text }}">总览</text>
            </div>
            <div class="action-btn" onclick="openScheduleStats($idx)" style="background-color: {{ theme.cardLight }}">
              <text class="action-btn-text" style="color: {{ theme.text }}">统计</text>
            </div>
            <div class="action-btn delete-btn" if="{{ scheduleList.length > 1 }}" onclick="deleteSchedule($idx)" style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : theme.deleteBg }}">
              <text class="action-btn-text" style="color: {{ deleteConfirmIndex === $idx ? '#ffffff' : theme.deleteText }}">{{ deleteConfirmIndex === $idx ? '确认' : '删除' }}</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>

    <div class="add-section">
      <input class="add-btn" type="button" value="+ 新增课程表" onclick="addSchedule" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

export default {
  private: {
    scheduleList: [],
    currentIndex: 0,
    editingIndex: -1,
    editName: "",
    deleteConfirmIndex: -1,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadData()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.editName = data
          storage.delete({ key: "chinese_input_result" })
        }
      }
    })

    this.loadData()
  },

  loadData() {
    var self = this
    store.getScheduleNames(function(names) {
      var list = []
      for (var i = 0; i < names.length; i++) {
        list.push({ name: names[i] })
      }
      self.scheduleList = list
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentIndex = idx
    })
  },

  goBack() {
    if (this.editingIndex >= 0) {
      this.cancelEdit()
      return
    }
    router.back()
  },

  openStatistics() {
    var storage = require("@system.storage")
    storage.set({
      key: "statistics_index",
      value: "-1",
      success: function() {
        router.push({ uri: "/pages/statistics" })
      },
      fail: function() {
        router.push({ uri: "/pages/statistics" })
      }
    })
  },

  openScheduleStats(index) {
    var storage = require("@system.storage")
    storage.set({
      key: "statistics_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/statistics" })
      },
      fail: function() {
        router.push({ uri: "/pages/statistics" })
      }
    })
  },

  selectSchedule(index) {
    if (this.editingIndex >= 0) {
      return
    }
    if (index === this.currentIndex) {
      router.back()
      return
    }
    var self = this
    database.setScheduleIndex(index, function() {
      store.setCurrentScheduleIndex(index, function() {
        self.currentIndex = index
        router.back()
      })
    })
  },

  startRename(index) {
    this.editingIndex = index
    this.editName = this.scheduleList[index].name

    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "重命名课程表" })
    storage.set({ key: "chinese_input_placeholder", value: "输入新名称" })
    storage.set({ key: "chinese_input_value", value: this.editName })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  finishEdit() {
    if (!this.editName || this.editName.trim() === "") {
      return
    }

    var newName = this.editName.trim()
    var exists = false
    for (var i = 0; i < this.scheduleList.length; i++) {
      if (i !== this.editingIndex && this.scheduleList[i].name === newName) {
        exists = true
        break
      }
    }

    if (exists) {
      return
    }

    this.scheduleList[this.editingIndex].name = newName

    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }

    var self = this
    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "已重命名" })
      self.editingIndex = -1
      self.editName = ""
      self.loadData()
    })
  },

  cancelEdit() {
    this.editingIndex = -1
    this.editName = ""
  },

  openWeekView(index) {
    var storage = require("@system.storage")
    storage.set({
      key: "weekview_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/week-view" })
      },
      fail: function() {
        router.push({ uri: "/pages/week-view" })
      }
    })
  },

  addSchedule() {
    var self = this
    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }
    var newName = "课程表" + (names.length + 1)
    var counter = 1
    while (names.indexOf(newName) !== -1) {
      newName = "课程表" + (names.length + 1) + "(" + counter + ")"
      counter++
    }
    names.push(newName)
    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "课程表已添加" })
      self.loadData()
    })
  },

  copySchedule(index) {
    var self = this
    var sourceName = this.scheduleList[index].name
    var newName = sourceName + " (副本)"
    var newIndex = this.scheduleList.length

    var exists = false
    for (var i = 0; i < this.scheduleList.length; i++) {
      if (this.scheduleList[i].name === newName) {
        exists = true
        break
      }
    }
    if (exists) {
      newName = sourceName + " (副本" + newIndex + ")"
    }

    database.getAllCoursesWithIndex(index, function(sourceData) {
      var names = []
      for (var i = 0; i < self.scheduleList.length; i++) {
        names.push(self.scheduleList[i].name)
      }
      names.push(newName)

      store.setScheduleNames(names, function() {
        database.setScheduleIndex(newIndex, function() {
          if (!sourceData || sourceData.length === 0) {
            self.loadData()
            return
          }

          var totalCourses = 0
          for (var d = 0; d < sourceData.length; d++) {
            totalCourses += sourceData[d].classes.length
          }

          if (totalCourses === 0) {
            self.loadData()
            return
          }

          var inserted = 0
          for (var d = 0; d < sourceData.length; d++) {
            var dayData = sourceData[d]
            for (var c = 0; c < dayData.classes.length; c++) {
              var course = dayData.classes[c]
              var newCourse = {
                id: course.id + "_c" + newIndex,
                day: course.day,
                name: course.name,
                time: course.time,
                teacher: course.teacher,
                location: course.location,
                notes: course.notes || ""
              }
              database.insertCourse(newCourse, function() {
                inserted++
                if (inserted === totalCourses) {
                  database.setScheduleIndex(self.currentIndex, function() {
                    prompt.showToast({ message: "课程表已复制" })
                    self.loadData()
                  })
                }
              })
            }
          }
        })
      })
    })
  },

  deleteSchedule(index) {
    if (this.scheduleList.length <= 1) {
      return
    }
    if (this.deleteConfirmIndex !== index) {
      this.deleteConfirmIndex = index
      var self = this
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirmIndex = -1
      }, 5000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    this.deleteConfirmIndex = -1
    var self = this
    var needSwitch = (index === this.currentIndex)

    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }
    names.splice(index, 1)

    store.setScheduleNames(names, function() {
      prompt.showToast({ message: "课程表已删除" })
      if (needSwitch) {
        store.setCurrentScheduleIndex(0, function() {
          database.setScheduleIndex(0, function() {
            self.currentIndex = 0
            self.loadData()
          })
        })
      } else if (index < self.currentIndex) {
        var newIdx = self.currentIndex - 1
        store.setCurrentScheduleIndex(newIdx, function() {
          database.setScheduleIndex(newIdx, function() {
            self.currentIndex = newIdx
            self.loadData()
          })
        })
      } else {
        self.loadData()
      }
    })
  },

  openQrPopup(index) {
    var storage = require("@system.storage")
    storage.set({
      key: "schedule_qrcode_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      },
      fail: function() {
        router.push({ uri: "/pages/schedule-qrcode" })
      }
    })
  }
}
</script>

