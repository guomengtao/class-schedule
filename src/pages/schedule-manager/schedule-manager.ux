<template>
  <div class="manager-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">课程表管理</text>
    </div>

    <div class="rename-bar" if="{{ editingIndex >= 0 }}" style="background-color: {{ theme.card }}">
      <input class="rename-input" type="text" value="{{ editName }}" onchange="onRenameChange" placeholder="输入新名称" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <input class="rename-ok-btn" type="button" value="保存" onclick="finishEdit" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="rename-cancel-btn" type="button" value="取消" onclick="cancelEdit" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>

    <div class="schedule-list">
      <div for="{{ scheduleList }}" class="schedule-item {{ $idx === currentIndex ? 'active' : '' }}" style="background-color: {{ theme.card }}; border-left-color: {{ $idx === currentIndex ? theme.accent : 'transparent' }}">
        <div class="item-left" onclick="selectSchedule($idx)">
          <text class="schedule-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="badge" if="{{ $idx === currentIndex }}" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">使用中</text>
        </div>
        <div class="item-right">
          <text class="link" onclick="startRename($idx)" style="color: {{ theme.accent }}">重命名</text>
          <text class="link" onclick="copySchedule($idx)" style="color: {{ theme.accent }}">复制</text>
          <text class="link" onclick="openWeekView($idx)" style="color: {{ theme.accent }}">总览</text>
          <text class="link delete-link" if="{{ scheduleList.length > 1 }}" onclick="deleteSchedule($idx)" style="color: {{ theme.deleteText }}">删除</text>
        </div>
      </div>
    </div>

    <div class="add-section">
      <input class="add-btn" type="button" value="+ 新增课程表" onclick="addSchedule" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

export default {
  private: {
    scheduleList: [],
    currentIndex: 0,
    editingIndex: -1,
    editName: "",
    theme: {}
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadData()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadData()
  },

  loadData() {
    var self = this
    store.getScheduleNames(function(names) {
      var list = []
      for (var i = 0; i < names.length; i++) {
        list.push({ name: names[i] })
      }
      self.scheduleList = list
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentIndex = idx
    })
  },

  goBack() {
    if (this.editingIndex >= 0) {
      this.cancelEdit()
      return
    }
    router.back()
  },

  selectSchedule(index) {
    if (this.editingIndex >= 0) {
      return
    }
    if (index === this.currentIndex) {
      router.back()
      return
    }
    var self = this
    database.setScheduleIndex(index, function() {
      store.setCurrentScheduleIndex(index, function() {
        self.currentIndex = index
        router.back()
      })
    })
  },

  startRename(index) {
    this.editingIndex = index
    this.editName = this.scheduleList[index].name
  },

  onRenameChange(e) {
    this.editName = e.value || ""
  },

  finishEdit() {
    if (!this.editName || this.editName.trim() === "") {
      return
    }

    var newName = this.editName.trim()
    var exists = false
    for (var i = 0; i < this.scheduleList.length; i++) {
      if (i !== this.editingIndex && this.scheduleList[i].name === newName) {
        exists = true
        break
      }
    }

    if (exists) {
      return
    }

    this.scheduleList[this.editingIndex].name = newName

    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }

    var self = this
    store.setScheduleNames(names, function() {
      self.editingIndex = -1
      self.editName = ""
      self.loadData()
    })
  },

  cancelEdit() {
    this.editingIndex = -1
    this.editName = ""
  },

  openWeekView(index) {
    var storage = require("@system.storage")
    storage.set({
      key: "weekview_index",
      value: String(index),
      success: function() {
        router.push({ uri: "/pages/week-view" })
      },
      fail: function() {
        router.push({ uri: "/pages/week-view" })
      }
    })
  },

  addSchedule() {
    var self = this
    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }
    var newName = "课程表" + (names.length + 1)
    var counter = 1
    while (names.indexOf(newName) !== -1) {
      newName = "课程表" + (names.length + 1) + "(" + counter + ")"
      counter++
    }
    names.push(newName)
    store.setScheduleNames(names, function() {
      self.loadData()
    })
  },

  copySchedule(index) {
    var self = this
    var sourceName = this.scheduleList[index].name
    var newName = sourceName + " (副本)"
    var newIndex = this.scheduleList.length

    var exists = false
    for (var i = 0; i < this.scheduleList.length; i++) {
      if (this.scheduleList[i].name === newName) {
        exists = true
        break
      }
    }
    if (exists) {
      newName = sourceName + " (副本" + newIndex + ")"
    }

    database.getAllCoursesWithIndex(index, function(sourceData) {
      var names = []
      for (var i = 0; i < self.scheduleList.length; i++) {
        names.push(self.scheduleList[i].name)
      }
      names.push(newName)

      store.setScheduleNames(names, function() {
        database.setScheduleIndex(newIndex, function() {
          if (!sourceData || sourceData.length === 0) {
            self.loadData()
            return
          }

          var totalCourses = 0
          for (var d = 0; d < sourceData.length; d++) {
            totalCourses += sourceData[d].classes.length
          }

          if (totalCourses === 0) {
            self.loadData()
            return
          }

          var inserted = 0
          for (var d = 0; d < sourceData.length; d++) {
            var dayData = sourceData[d]
            for (var c = 0; c < dayData.classes.length; c++) {
              var course = dayData.classes[c]
              var newCourse = {
                id: course.id + "_c" + newIndex,
                day: course.day,
                name: course.name,
                time: course.time,
                teacher: course.teacher,
                location: course.location,
                notes: course.notes || ""
              }
              database.insertCourse(newCourse, function() {
                inserted++
                if (inserted === totalCourses) {
                  database.setScheduleIndex(self.currentIndex, function() {
                    self.loadData()
                  })
                }
              })
            }
          }
        })
      })
    })
  },

  deleteSchedule(index) {
    if (this.scheduleList.length <= 1) {
      return
    }
    var self = this
    var needSwitch = (index === this.currentIndex)

    var names = []
    for (var i = 0; i < this.scheduleList.length; i++) {
      names.push(this.scheduleList[i].name)
    }
    names.splice(index, 1)

    store.setScheduleNames(names, function() {
      if (needSwitch) {
        store.setCurrentScheduleIndex(0, function() {
          database.setScheduleIndex(0, function() {
            self.currentIndex = 0
            self.loadData()
          })
        })
      } else if (index < self.currentIndex) {
        var newIdx = self.currentIndex - 1
        store.setCurrentScheduleIndex(newIdx, function() {
          database.setScheduleIndex(newIdx, function() {
            self.currentIndex = newIdx
            self.loadData()
          })
        })
      } else {
        self.loadData()
      }
    })
  }
}
</script>

<style>
.manager-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 12px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16px;
  padding: 8px 0;
}

.back-btn {
  width: 54px;
  height: 40px;
  border-radius: 10px;
  background-color: #16213e;
  font-size: 20px;
  color: #7ec8e3;
  text-align: center;
}

.header-title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-left: 12px;
  flex: 1;
}

.rename-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 12px;
  background-color: #0f3460;
  border-radius: 10px;
  border-left-width: 3px;
  border-left-color: #7ec8e3;
  border-left-style: solid;
}

.rename-input {
  flex: 1;
  height: 40px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 18px;
  color: #ffffff;
  padding: 0 12px;
}

.rename-ok-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  background-color: #7ec8e3;
  font-size: 16px;
  font-weight: bold;
  color: #1a1a2e;
  text-align: center;
  margin-left: 8px;
}

.rename-cancel-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  background-color: #555577;
  font-size: 16px;
  color: #ffffff;
  text-align: center;
  margin-left: 6px;
}

.schedule-list {
  flex: 1;
  flex-direction: column;
}

.schedule-item {
  flex-direction: column;
  background-color: #16213e;
  border-radius: 12px;
  padding: 40px 30px;
  margin-bottom: 20px;
}

.schedule-item.active {
  background-color: #0f3460;
  border-left-width: 4px;
  border-left-color: #7ec8e3;
  border-left-style: solid;
}

.item-left {
  flex-direction: row;
  align-items: center;
  padding-bottom: 24px;
  border-bottom-width: 1px;
  border-bottom-color: #1a2a4e;
  border-bottom-style: solid;
}

.schedule-name {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}

.badge {
  font-size: 16px;
  color: #1a1a2e;
  background-color: #7ec8e3;
  padding: 4px 14px;
  border-radius: 10px;
  font-weight: bold;
  margin-left: 14px;
}

.item-right {
  flex-direction: row;
  justify-content: flex-start;
  padding-top: 24px;
}

.link {
  font-size: 22px;
  color: #7ec8e3;
  margin-right: 30px;
  padding: 8px 0;
}

.link.delete-link {
  color: #e74c3c;
}

.add-section {
  margin-top: 12px;
  padding-bottom: 4px;
}

.add-btn {
  width: 100%;
  height: 44px;
  border-radius: 10px;
  background-color: #7ec8e3;
  font-size: 17px;
  font-weight: bold;
  color: #1a1a2e;
  text-align: center;
}
</style>