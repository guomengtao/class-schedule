<template>
  <div class="page">
    <div class="header">
      <text class="title">手风琴 Demo</text>
    </div>

    <div for="{{ list }}" class="item">
      <div class="row" onclick="toggle($idx)">
        <text class="name">第 {{ $idx + 1 }} 行</text>
        <text class="arrow">{{ expandedIndex === $idx ? '▲' : '▼' }}</text>
      </div>

      <div class="panel" if="{{ expandedIndex === $idx }}">
        <div class="panel-divider"></div>
        <div class="btn-row">
          <div class="btn"><text class="btn-text">按钮 1</text></div>
          <div class="btn"><text class="btn-text">按钮 2</text></div>
          <div class="btn"><text class="btn-text">按钮 3</text></div>
        </div>
        <div class="btn-row">
          <div class="btn"><text class="btn-text">按钮 4</text></div>
          <div class="btn"><text class="btn-text">按钮 5</text></div>
          <div class="btn"><text class="btn-text">按钮 6</text></div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  private: {
    list: [{}, {}, {}],
    expandedIndex: -1
  },

  toggle(idx) {
    if (this.expandedIndex === idx) {
      this.expandedIndex = -1
    } else {
      this.expandedIndex = idx
    }
  }
}
</script>

