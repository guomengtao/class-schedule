<!--
  EV 苹果风表盘 · macOS 时钟小组件复刻（2026-10-26）
  ─────────────────────────────────────────────────────────────
  复刻对象：macOS 桌面「时钟」小组件 · 小号 · 模拟表盘（白卡四数字版）
  基准图  ：docs/reference/apple-clock-widget/widget-analog-numerals-white.png
  实测参数：卡片 326px → 圆角 23.9% 边长；数字字高 23.2% 边长；
            整点刻度/指针 #1D1D1F、分钟刻度 #B5B5B6、秒针 #EC993C；表盘无外圈圆环。

  机位分工（方案 §4.5）：
    336×480（手环10Pro）→ 完整复刻白卡模拟表盘（本页宽屏分支）
    192×490（手环9）   → 同家族另一款：macOS 数字版小组件（黑卡，本页窄屏分支）
    理由：模拟表盘 48 条分钟刻度缩到 192 后线宽 <1px 必糊，数字版无精细刻度。

  走针方案沿用 watch-face-evpointer 的标定结论（绕开引擎三大坑）：
    ① 禁 `transform: rotate({{deg}}deg)` 数据绑定 —— Vela 整页黑屏；
    ② 引擎旋转轴 = 元素【顶部中点】，transform-origin 不按 CSS 语义生效；
    ③ 角度只改 class（.r0…​.r59 字面量），不改 transform 值。

  布局铁律：.page 只给尺寸 + 列向 flex，绝不加 justify-content / align-items。
-->
<template>
  <div class="page" onclick="onTap">

    <!-- ═══ 宽屏 336×480：白卡模拟表盘 ═══ -->
    <text class="date-line" if="{{ isWide }}">{{ dateText }}</text>

    <div class="card" if="{{ isWide }}"></div>

    <div class="face" if="{{ isWide }}">
      <!-- 12 整点刻度：#1D1D1F 长 20（字面量 rotate，规避引擎黑屏） -->
      <div class="tk-h" style="left:166.5px;top:97.0px;transform:rotate(0deg)"></div>
      <div class="tk-h" style="left:238.0px;top:116.2px;transform:rotate(30deg)"></div>
      <div class="tk-h" style="left:290.3px;top:168.5px;transform:rotate(60deg)"></div>
      <div class="tk-h" style="left:309.5px;top:240.0px;transform:rotate(90deg)"></div>
      <div class="tk-h" style="left:290.3px;top:311.5px;transform:rotate(120deg)"></div>
      <div class="tk-h" style="left:238.0px;top:363.8px;transform:rotate(150deg)"></div>
      <div class="tk-h" style="left:166.5px;top:383.0px;transform:rotate(180deg)"></div>
      <div class="tk-h" style="left:95.0px;top:363.8px;transform:rotate(210deg)"></div>
      <div class="tk-h" style="left:42.7px;top:311.5px;transform:rotate(240deg)"></div>
      <div class="tk-h" style="left:23.5px;top:240.0px;transform:rotate(270deg)"></div>
      <div class="tk-h" style="left:42.7px;top:168.5px;transform:rotate(300deg)"></div>
      <div class="tk-h" style="left:95.0px;top:116.2px;transform:rotate(330deg)"></div>
      <!-- 48 分钟刻度：#B5B5B6 短 9 -->
      <div class="tk-m" style="left:181.9px;top:97.8px;transform:rotate(6deg)"></div>
      <div class="tk-m" style="left:196.7px;top:100.1px;transform:rotate(12deg)"></div>
      <div class="tk-m" style="left:211.2px;top:104.0px;transform:rotate(18deg)"></div>
      <div class="tk-m" style="left:225.2px;top:109.4px;transform:rotate(24deg)"></div>
      <div class="tk-m" style="left:251.1px;top:124.3px;transform:rotate(36deg)"></div>
      <div class="tk-m" style="left:262.7px;top:133.7px;transform:rotate(42deg)"></div>
      <div class="tk-m" style="left:273.3px;top:144.3px;transform:rotate(48deg)"></div>
      <div class="tk-m" style="left:282.7px;top:155.9px;transform:rotate(54deg)"></div>
      <div class="tk-m" style="left:297.6px;top:181.8px;transform:rotate(66deg)"></div>
      <div class="tk-m" style="left:303.0px;top:195.8px;transform:rotate(72deg)"></div>
      <div class="tk-m" style="left:306.9px;top:210.3px;transform:rotate(78deg)"></div>
      <div class="tk-m" style="left:309.2px;top:225.1px;transform:rotate(84deg)"></div>
      <div class="tk-m" style="left:309.2px;top:254.9px;transform:rotate(96deg)"></div>
      <div class="tk-m" style="left:306.9px;top:269.7px;transform:rotate(102deg)"></div>
      <div class="tk-m" style="left:303.0px;top:284.2px;transform:rotate(108deg)"></div>
      <div class="tk-m" style="left:297.6px;top:298.2px;transform:rotate(114deg)"></div>
      <div class="tk-m" style="left:282.7px;top:324.1px;transform:rotate(126deg)"></div>
      <div class="tk-m" style="left:273.3px;top:335.7px;transform:rotate(132deg)"></div>
      <div class="tk-m" style="left:262.7px;top:346.3px;transform:rotate(138deg)"></div>
      <div class="tk-m" style="left:251.1px;top:355.7px;transform:rotate(144deg)"></div>
      <div class="tk-m" style="left:225.2px;top:370.6px;transform:rotate(156deg)"></div>
      <div class="tk-m" style="left:211.2px;top:376.0px;transform:rotate(162deg)"></div>
      <div class="tk-m" style="left:196.7px;top:379.9px;transform:rotate(168deg)"></div>
      <div class="tk-m" style="left:181.9px;top:382.2px;transform:rotate(174deg)"></div>
      <div class="tk-m" style="left:152.1px;top:382.2px;transform:rotate(186deg)"></div>
      <div class="tk-m" style="left:137.3px;top:379.9px;transform:rotate(192deg)"></div>
      <div class="tk-m" style="left:122.8px;top:376.0px;transform:rotate(198deg)"></div>
      <div class="tk-m" style="left:108.8px;top:370.6px;transform:rotate(204deg)"></div>
