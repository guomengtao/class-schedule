      <div class="tk-m" style="left:36.4px;top:298.2px;transform:rotate(246deg)"></div>
      <div class="tk-m" style="left:31.0px;top:284.2px;transform:rotate(252deg)"></div>
      <div class="tk-m" style="left:27.1px;top:269.7px;transform:rotate(258deg)"></div>
      <div class="tk-m" style="left:24.8px;top:254.9px;transform:rotate(264deg)"></div>
      <div class="tk-m" style="left:24.8px;top:225.1px;transform:rotate(276deg)"></div>
      <div class="tk-m" style="left:27.1px;top:210.3px;transform:rotate(282deg)"></div>
      <div class="tk-m" style="left:31.0px;top:195.8px;transform:rotate(288deg)"></div>
      <div class="tk-m" style="left:36.4px;top:181.8px;transform:rotate(294deg)"></div>
      <div class="tk-m" style="left:51.3px;top:155.9px;transform:rotate(306deg)"></div>
      <div class="tk-m" style="left:60.7px;top:144.3px;transform:rotate(312deg)"></div>
      <div class="tk-m" style="left:71.3px;top:133.7px;transform:rotate(318deg)"></div>
      <div class="tk-m" style="left:82.9px;top:124.3px;transform:rotate(324deg)"></div>
      <div class="tk-m" style="left:108.8px;top:109.4px;transform:rotate(336deg)"></div>
      <div class="tk-m" style="left:122.8px;top:104.0px;transform:rotate(342deg)"></div>
      <div class="tk-m" style="left:137.3px;top:100.1px;transform:rotate(348deg)"></div>
      <div class="tk-m" style="left:152.1px;top:97.8px;transform:rotate(354deg)"></div>

      <!-- 四数字（复刻对象只保留 12/3/6/9） -->
      <text class="num" style="left:123px;top:100px">12</text>
      <text class="num" style="left:223px;top:200px">3</text>
      <text class="num" style="left:123px;top:300px">6</text>
      <text class="num" style="left:23px;top:200px">9</text>

      <!-- 三针：顶部中点压在盘心 (168,240)，向下延伸，rotate(180+θ) 指向 θ -->
      <div class="hand hour {{ hourCls }}"></div>
      <div class="hand minute {{ minuteCls }}"></div>
      <div class="hand second {{ secondCls }}"></div>

      <!-- 中心：橙色轴心 -->
      <div class="hub"></div>
      <div class="hub-dot"></div>
    </div>

    <!-- ═══ 窄屏 192×490：黑卡数字版（同家族另一款，非降级） ═══ -->
    <div class="card-dark" if="{{ isNarrow }}"></div>
    <text class="d-day"   if="{{ isNarrow }}">{{ dayText }}</text>
    <text class="d-time"  if="{{ isNarrow }}">{{ hhmm }}</text>
    <text class="d-date"  if="{{ isNarrow }}">{{ dateSmall }}</text>
    <text class="d-hint"  if="{{ isNarrow }}">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const CN_DAY = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

function pad2(n) {
  return (n < 10 ? "0" : "") + n
}

// 角度 → 60 档类名（6° 一档）。引擎轴在顶部中点，故 .rN 内部为 rotate(180 + 6N)
function stepClass(deg) {
  let step = Math.round(deg / 6) % 60
  if (step < 0) step += 60
  return "r" + step
}

export default {
  data: {
    isWide: false,
    isNarrow: true,
    dateText: "",
    dayText: "",
    hhmm: "--:--",
    dateSmall: "",
    hourCls: "r0",
    minuteCls: "r0",
    secondCls: "r0",
    timer: null
  },

  onInit() {
    this.fitScreen()
    this.sync()
    this.startTimer()
  },

  /* 宽屏探针：336×480 走完整复刻分支；192 保持数字卡片分支。
     用「页内 require」而非顶部 import —— 两种引入方式会互相干扰（evpointer 实测定论）。 */
  fitScreen() {
    const self = this
    try {
      const dev = require("@system.device")
      dev.getInfo({
        success: function (d) {
          const w = d && d.screenWidth ? d.screenWidth : 0
          if (w >= 300) {
            self.isWide = true
            self.isNarrow = false
          }
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  onShow() {
    this.sync()
    this.startTimer()
  },

  onHide() { this.stopTimer() },
  onDestroy() { this.stopTimer() },

  sync() {
    const now = new Date()
    const h = now.getHours()
    const m = now.getMinutes()
    const s = now.getSeconds()
    const h12 = h % 12

    this.hourCls = stepClass((h12 + m / 60 + s / 3600) * 30)
    this.minuteCls = stepClass((m + s / 60) * 6)
    this.secondCls = stepClass(s * 6)

    const mo = now.getMonth() + 1
    const dd = now.getDate()
    this.dateText = mo + "月" + dd + "日 " + CN_DAY[now.getDay()]
    this.dayText = CN_DAY[now.getDay()]
    this.dateSmall = mo + "月" + dd + "日"
    this.hhmm = pad2(h) + ":" + pad2(m)
  },

  startTimer() {
    if (this.timer) return
    const self = this
    this.timer = setInterval(function () { self.sync() }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  onTap() {
    this.stopTimer()
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

