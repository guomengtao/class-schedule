<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const CN_DAY = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

function pad2(n) {
  return (n < 10 ? "0" : "") + n
}

// 角度 → 360 档类名（1° 一档）。引擎轴在顶部中点，故 .sN 内部为 rotate(180 + N)
function degClass(deg) {
  let d = Math.round(deg) % 360
  if (d < 0) d += 360
  return "s" + d
}

export default {
  data: {
    isWide: false,
    isNarrow: true,
    dateText: "",
    dayText: "",
    hhmm: "--:--",
    dateSmall: "",
    hourCls: "s0",
    minuteCls: "s0",
    secondCls: "s0",
    tailCls: "s180",
    timer: null
  },

  onInit() {
    this.fitScreen()
    this.sync()
    this.startTimer()
  },

  /* 宽屏探针：336×480 走完整复刻分支；192 保持数字卡片分支。
     用「页内 require」而非顶部 import —— 两种引入方式会互相干扰（evpointer 实测定论）。 */
  fitScreen() {
    const self = this
    try {
      const dev = require("@system.device")
      dev.getInfo({
        success: function (d) {
          const w = d && d.screenWidth ? d.screenWidth : 0
          if (w >= 300) {
            self.isWide = true
            self.isNarrow = false
          }
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  onShow() {
    this.sync()
    this.startTimer()
  },

  onHide() { this.stopTimer() },
  onDestroy() { this.stopTimer() },

  sync() {
    const now = new Date()
    const h = now.getHours()
    const m = now.getMinutes()
    const s = now.getSeconds()
    const ms = now.getMilliseconds()
    const h12 = h % 12

    // 扫秒：秒位带毫秒，1° 粒度下每 100ms 走 0.6°
    const secDeg = (s + ms / 1000) * 6
    this.hourCls = degClass((h12 + m / 60 + s / 3600) * 30)
    this.minuteCls = degClass((m + s / 60) * 6)
    this.secondCls = degClass(secDeg)
    this.tailCls = degClass(secDeg + 180)

    const mo = now.getMonth() + 1
    const dd = now.getDate()
    this.dateText = mo + "月" + dd + "日 " + CN_DAY[now.getDay()]
    this.dayText = CN_DAY[now.getDay()]
    this.dateSmall = mo + "月" + dd + "日"
    this.hhmm = pad2(h) + ":" + pad2(m)
  },

  startTimer() {
    if (this.timer) return
    const self = this
    this.timer = setInterval(function () { self.sync() }, 100)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  /* 返回目录（按钮，系列统一；已移除点击空白返回 / 上下滑切表盘） */
  onBack() {
    this.stopTimer()
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  .card {
    position: absolute;
    left: 8px;
    top: 80px;
    width: 320px;
    height: 320px;
    border-radius: 76px;
    background-color: #FEFEFE;
  }

  .date-line {
    position: absolute;
    left: 0;
    top: 46px;
    width: 336px;
    text-align: center;
    font-size: 18px;
    color: #8E8E93;
  }

  .face {
    position: absolute;
    left: 0;
    top: 0;
    width: 336px;
    height: 480px;
  }

  .tk-h {
    position: absolute;
    width: 2px;
    height: 29px;
    background-color: #1D1D1F;
  }

  .tk-m {
    position: absolute;
    width: 1.5px;
    height: 18px;
    background-color: #B5B5B6;
  }

  /* 数字：字高 31（占卡 9.9%，与基准 32/326 一致），中心距盘心 86 */
  .num {
    position: absolute;
    width: 70px;
    height: 40px;
    line-height: 40px;
    text-align: center;
    font-size: 39px;
    font-weight: bold;
    color: #1D1D1F;
  }

  /* 所有针：top 压在盘心 240，并显式锁定旋转轴为「元素顶部中点」。
     2026-11-08 三屏像素实测发现三针不共心：引擎默认 transform-origin 并非顶部中点
     （实测更接近元素左上角 0 0）。此前用 left = 盘心X - 针宽/2 居中针身，
     在该默认轴下反而把轴心推偏「针宽/2」：黑针宽 10 偏 5px、橙针宽 2 偏 1px，
     两组轴心相差 4px，针根与固定绝对定位的 hub 错开。
     显式声明后四针轴心统一为 (left + width/2, top) = (168,240)，与 hub 重合。
     验收：三屏三针拟合直线到 hub ≤1px；若该引擎不支持 transform-origin，
     回退方案为四针 left 统一写盘心 X（不再按针宽折半），hub 保持不动。
     验证方式：三屏取 /dev/fb0 裸帧，按颜色分离针身做直线拟合，量轴线到 hub 距离。 */
  .hand { position: absolute; transform-origin: 50% 0; }

  /* 时针 / 分针：top 压在盘心 240，元素顶部中点即旋转轴。
     长度取基准实测：时针 r=90（0.62R，基准 0.561R + 细颈 21.5）、分针 r=130（0.90R）。
     针身宽 10（0.064R），圆头。 */
  .hb-hour {
    left: 163px;
    top: 240px;
    width: 10px;
    height: 90px;
    background-color: #1D1D1F;
    border-radius: 5px;
  }
  .hb-min {
    left: 163px;
    top: 240px;
    width: 10px;
    height: 130px;
    background-color: #1D1D1F;
    border-radius: 5px;
  }

  .second {
    left: 167px;
    top: 240px;
    width: 2px;
    height: 144px;
    background-color: #EC993C;
    border-radius: 1px;
  }

  /* 秒针反向尾：独立元素 + θ+180 的 class，25px（0.155R） */
  .second-tail {
    left: 167px;
    top: 240px;
    width: 2px;
    height: 25px;
    background-color: #EC993C;
    border-radius: 1px;
  }

  /* 中心：纯橙圆点 ⌀7，压在三针之上（基准中心像素 (234,149,53)，无白芯） */
  .hub {
    position: absolute;
    left: 162.5px;
    top: 234.5px;
    width: 11px;
    height: 11px;
    border-radius: 5.5px;
    background-color: #EC993C;
  }

  /* 环孔：透出卡片白底（基准实测孔内为白卡色，秒针在孔内被环遮住） */
  .hub-hole {
    position: absolute;
    left: 165.5px;
    top: 237.5px;
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
    background-color: #FEFEFE;
  }

  /* ── 窄屏 192×490 · 白卡模拟表盘（宽屏标定 × 0.5517） ──
     盘心 (96,184)，刻度外沿 R=80，卡 184×184。192 屏上沿是半径 96 的半圆，
     y=66 处内收仅 4px，所以日期行放在 y=66 不会压进圆弧。 */
  .n-card {
    position: absolute;
    left: 4px;
    top: 92px;
    width: 184px;
    height: 184px;
    border-radius: 44px;
    background-color: #FEFEFE;
  }

  .n-date {
    position: absolute;
    left: 0;
    top: 66px;
    width: 192px;
    text-align: center;
    font-size: 18px;
    color: #8E8E93;
  }

  .n-face {
    position: absolute;
    left: 0;
    top: 0;
    width: 192px;
    height: 490px;
  }

  .ntk-h {
    position: absolute;
    width: 1px;
    height: 16px;
    background-color: #1D1D1F;
  }

  .ntk-m {
    position: absolute;
    width: 1px;
    height: 10px;
    background-color: #B5B5B6;
  }

  /* 数字：字高 22（宽屏 39 × 0.5517），中心距盘心 47.4 */
  .nnum {
    position: absolute;
    width: 38px;
    height: 22px;
    line-height: 22px;
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    color: #1D1D1F;
  }

  /* 窄屏同理：显式锁定旋转轴为顶部中点，四针轴心统一为 (96,184) 与 nhub 重合 */
  .nhand { position: absolute; transform-origin: 50% 0; }

  /* 时针 r=50（宽屏 90 × 0.5517）、分针 r=72（130 × 0.5517），针身宽 5 */
  .nhb-hour {
    left: 93.5px;
    top: 184px;
    width: 5px;
    height: 50px;
    background-color: #1D1D1F;
    border-radius: 3px;
  }
  .nhb-min {
    left: 93.5px;
    top: 184px;
    width: 5px;
    height: 72px;
    background-color: #1D1D1F;
    border-radius: 3px;
  }

  .nsecond {
    left: 95px;
    top: 184px;
    width: 2px;
    height: 79px;
    background-color: #EC993C;
    border-radius: 1px;
  }

  /* 秒针反向尾：独立元素 + θ+180 的 class（不能上移 top，那会把旋转轴带偏） */
  .nsecond-tail {
    left: 95px;
    top: 184px;
    width: 2px;
    height: 14px;
    background-color: #EC993C;
    border-radius: 1px;
  }

  .nhub {
    position: absolute;
    left: 93px;
    top: 181px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #EC993C;
  }

  .nhub-hole {
    position: absolute;
    left: 94.5px;
    top: 182.5px;
    width: 3px;
    height: 3px;
    border-radius: 1.5px;
    background-color: #FEFEFE;
  }

  /* 盘下数字时刻：胶囊屏窄，圆盘做不大，用一行大数字兜住可读性 */
  .n-time {
    position: absolute;
    left: 0;
    top: 320px;
    width: 192px;
    height: 70px;
    line-height: 70px;
    text-align: center;
    font-size: 60px;
    font-weight: bold;
    color: #FFFFFF;
  }

  /* ── 360 档角度类（1° 一档，扫秒用；字面量 transform，安全） ── */
  .s0 { transform: rotate(180deg); }
  .s1 { transform: rotate(181deg); }
