<!-- 调休规则说明页（2026-10-24 瘦身）
     原版 6 段 20 行说明（规则二/补充说明/产品设计/胶囊屏适配），在 192px 屏上
     24px 正文每行只放得下 6 个汉字，等于让用户滚 4 屏去读「本页怎么适配」这种自述。
     现在只留三类信息：规则是什么 → 各校不一样怎么办 → 官方依据在哪。
     字号守四档（44/30/28/24）：标题 28、正文 24，不再出现 18/20/22。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header" style="background-color: {{ theme.bg }}">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">调休</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="scroll-area" scroll-y="true">
      <div class="content-area">
        <div class="info-section" style="background-color: {{ theme.card }}">
          <text class="section-title" style="color: {{ theme.accent }}">补课规则</text>
          <text class="info-text" style="color: {{ theme.text }}">假期占周几，补课就上周几</text>
          <text class="info-sub" style="color: {{ theme.textSecondary }}">2/14 补周一</text>
          <text class="info-sub" style="color: {{ theme.textSecondary }}">2/28 补周五</text>
        </div>

        <div class="info-section" style="background-color: {{ theme.card }}">
          <text class="section-title" style="color: {{ theme.accent }}">各校不同</text>
          <text class="info-text" style="color: {{ theme.text }}">有的学校周六补周一</text>
          <text class="info-text" style="color: {{ theme.text }}">周日补周二，高校多不调休</text>
          <text class="info-sub" style="color: {{ theme.textSecondary }}">可自定义覆盖</text>
        </div>

        <div class="info-section" style="background-color: {{ theme.card }}">
          <text class="section-title" style="color: {{ theme.accent }}">官方依据</text>
          <text class="info-text" style="color: {{ theme.text }}">国办发明电</text>
          <text class="info-sub" style="color: {{ theme.textSecondary }}">〔2025〕7号</text>
          <text class="info-sub" style="color: {{ theme.textSecondary }}">2025-11-04 中国政府网</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {}
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    }, true)
  },

  goBack() {
    router.back()
  }
}
</script>

