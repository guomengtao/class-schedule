<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="tools-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">表盘目录</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row" onclick="openWatchFace">
        <text class="item-label" style="color: {{ theme.text }}">经典表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openWatchFaceRandom">
        <text class="item-label" style="color: {{ theme.text }}">随机表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openWatchFaceClass">
        <text class="item-label" style="color: {{ theme.text }}">课程表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openWatchFaceGold">
        <text class="item-label" style="color: {{ theme.text }}">金属字针表</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openEvPointer">
        <text class="item-label" style="color: {{ theme.text }}">EV指针</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openWatchFaceMetal">
        <text class="item-label" style="color: {{ theme.text }}">仿古金属表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openColorful">
        <text class="item-label" style="color: {{ theme.text }}">彩色表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openBackground">
        <text class="item-label" style="color: {{ theme.text }}">背景表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      // ⚠️ 必须在这里恢复 theme：onDestroy 会把它置成 null，
      // 页面被重新唤起时（从表盘返回）若不补回来，模板取 {{ theme.bg }} 会直接崩成黑屏。
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  openWatchFace() {
    router.push({ uri: "/pages/watch-face" })
  },

  openWatchFaceRandom() {
    router.push({ uri: "/pages/watch-face-random" })
  },

  openWatchFaceClass() {
    router.push({ uri: "/pages/watch-face-class" })
  },

  openWatchFaceGold() {
    router.push({ uri: "/pages/watch-face-gold" })
  },

  openEvPointer() {
    router.push({ uri: "/pages/watch-face-evpointer" })
  },

  openWatchFaceMetal() {
    router.push({ uri: "/pages/watch-face-metal" })
  },

  openColorful() {
    router.push({ uri: "/pages/watch-face-colorful" })
  },

  openBackground() {
    router.push({ uri: "/pages/watch-face-background" })
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    /* 这里故意不再 `this.theme = null`：
       置空后若仍有一帧渲染，模板取 theme.bg 会立刻崩。
       主题对象极小，交给页面一起回收即可。 */
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.tools-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 38px;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.section {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.item-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}

.item-label {
  font-size: 28px;
  line-height: 38px;
}

.arrow {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.row-divider {
  height: 1px;
  width: 100%;
  margin: 0 0;
}
</style>