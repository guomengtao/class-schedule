<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">添加课程</text>
      <input class="mgmt-btn" type="button" value="管理" onclick="openCourseManager"
             style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
    </div>

    <scroll class="main-scroll" scroll-y="true">
      <div class="section">
        <text class="section-title" style="color: {{ theme.text }}">选择课程</text>
        <div class="course-grid">
          <div class="course-item {{ courseIndex === idx ? 'course-item-selected' : '' }}"
               for="{{ (idx, c) in presetCourses }}"
               onclick="selectCourseByIdx(idx)"
               style="background-color: {{ theme.card }}">
            <text class="course-name" style="color: {{ theme.text }}">{{ c.name }}</text>
            <text class="course-time-text" style="color: {{ theme.textSecondary }}">{{ c.time }}</text>
          </div>
        </div>
      </div>

      <div class="section">
        <text class="section-title" style="color: {{ theme.text }}">上课时间</text>
        <div class="time-row">
          <div class="time-box" onclick="pickTime('start')" style="background-color: {{ theme.card }}">
            <text class="time-val" style="color: {{ theme.text }}">{{ padZero(startHour) }}:{{ padZero(startMin) }}</text>
            <text class="time-label" style="color: {{ theme.textSecondary }}">开始</text>
          </div>
          <text class="time-sep" style="color: {{ theme.textMuted }}">至</text>
          <div class="time-box" onclick="pickTime('end')" style="background-color: {{ theme.card }}">
            <text class="time-val" style="color: {{ theme.text }}">{{ padZero(endHour) }}:{{ padZero(endMin) }}</text>
            <text class="time-label" style="color: {{ theme.textSecondary }}">结束</text>
          </div>
        </div>
        <div class="time-adjust" if="{{ timePicker }}">
          <div class="adjust-group">
            <text class="adjust-label" style="color: {{ theme.text }}">时</text>
            <input class="adjust-btn" type="button" value="-" onclick="decreaseSelectedHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="adjust-num" style="color: {{ theme.text }}">{{ padZero(selectedHour) }}</text>
            <input class="adjust-btn" type="button" value="+" onclick="increaseSelectedHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="adjust-group">
            <text class="adjust-label" style="color: {{ theme.text }}">分</text>
            <input class="adjust-btn" type="button" value="-" onclick="decreaseSelectedMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="adjust-num" style="color: {{ theme.text }}">{{ padZero(selectedMin) }}</text>
            <input class="adjust-btn" type="button" value="+" onclick="increaseSelectedMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <input class="confirm-btn" type="button" value="确定" onclick="confirmTimePick"
                 style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        </div>
      </div>

      <div class="section">
        <text class="section-title" style="color: {{ theme.text }}">上课位置</text>
        <div class="input-box" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
          <text class="input-text {{ courseLocation ? '' : 'input-placeholder' }}"
                style="color: {{ courseLocation ? theme.text : theme.textMuted }}">
            {{ courseLocation || '点击输入位置' }}
          </text>
        </div>
      </div>

      <div class="section">
        <text class="section-title" style="color: {{ theme.text }}">星期</text>
        <div class="weekday-row">
          <div class="weekday-btn {{ dayIndex === 1 ? 'weekday-btn-active' : '' }}"
               onclick="selectDay(1)"
               style="background-color: {{ dayIndex === 1 ? theme.accent : theme.card }}">
            <text style="color: {{ dayIndex === 1 ? theme.bg : theme.text }}">一</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 2 ? 'weekday-btn-active' : '' }}"
               onclick="selectDay(2)"
               style="background-color: {{ dayIndex === 2 ? theme.accent : theme.card }}">
            <text style="color: {{ dayIndex === 2 ? theme.bg : theme.text }}">二</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 3 ? 'weekday-btn-active' : '' }}"
               onclick="selectDay(3)"
               style="background-color: {{ dayIndex === 3 ? theme.accent : theme.card }}">
            <text style="color: {{ dayIndex === 3 ? theme.bg : theme.text }}">三</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 4 ? 'weekday-btn-active' : '' }}"
               onclick="selectDay(4)"
               style="background-color: {{ dayIndex === 4 ? theme.accent : theme.card }}">
            <text style="color: {{ dayIndex === 4 ? theme.bg : theme.text }}">四</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 5 ? 'weekday-btn-active' : '' }}"
               onclick="selectDay(5)"
               style="background-color: {{ dayIndex === 5 ? theme.accent : theme.card }}">
            <text style="color: {{ dayIndex === 5 ? theme.bg : theme.text }}">五</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 6 ? 'weekday-btn-active' : '' }}"
               onclick="selectDay(6)"
               style="background-color: {{ dayIndex === 6 ? theme.accent : theme.card }}">
            <text style="color: {{ dayIndex === 6 ? theme.bg : theme.text }}">六</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 0 ? 'weekday-btn-active' : '' }}"
               onclick="selectDay(0)"
               style="background-color: {{ dayIndex === 0 ? theme.accent : theme.card }}">
            <text style="color: {{ dayIndex === 0 ? theme.bg : theme.text }}">日</text>
          </div>
        </div>
      </div>
    </scroll>

    <div class="bottom-bar">
      <input class="cancel-btn" type="button" value="取消" onclick="goBack"
             style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      <input class="save-btn" type="button" value="确认添加" onclick="saveCourse"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
var store = require("../../data/store.js")
var database = require("../../data/database.js")

var COURSE_LIST_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "", location: "" },
  { name: "生物", time: "13:55 - 14:40", teacher: "", location: "" },
  { name: "历史", time: "15:00 - 15:45", teacher: "", location: "" },
  { name: "地理", time: "15:55 - 16:40", teacher: "", location: "" },
  { name: "政治", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "音乐", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "美术", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "体育", time: "10:55 - 11:40", teacher: "", location: "" }
]

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  if (!timeStr) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

export default {
  private: {
    courseName: "",
    courseTime: "",
    courseLocation: "",
    courseIndex: 0,
    presetCourses: [],
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    dayIndex: 1,
    day: "",
    nextId: 100,
    isSaving: false,
    timePicker: false,
    pickTarget: "",
    selectedHour: 8,
    selectedMin: 0,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0"
    }
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(" - ")[0] : "00:00"
      var tb = b.time ? b.time.split(" - ")[0] : "00:00"
      var taParts = ta.split(":")
      var tbParts = tb.split(":")
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadCourses()
    this.setDefaultDay()
    var storage = require("@system.storage")
    storage.get({
      key: "add_course_nextId",
      success: function(val) {
        self.nextId = parseInt(val) || 100
      },
      fail: function() {
        self.nextId = 100
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.refreshCourseList()
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.courseLocation = data
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  refreshCourseList() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            }
          } catch (e) {}
        }
      },
      fail: function() {}
    })
  },

  setDefaultDay() {
    var now = new Date()
    this.dayIndex = now.getDay()
    this.day = DAY_NAMES[this.dayIndex]
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            } else {
              self.presetCourses = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.presetCourses = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.presetCourses = self.sortByTime(defaultCourses.slice())
        }
        self.selectCourse(self.courseIndex)
      },
      fail: function() {
        self.presetCourses = self.sortByTime(defaultCourses.slice())
        self.selectCourse(self.courseIndex)
      }
    })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  padZero(n) {
    return padZero(n)
  },

  selectCourseByIdx(idx) {
    this.courseIndex = idx
    var c = this.presetCourses[idx]
    this.courseName = c.name
    this.courseLocation = c.location || ""
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
  },

  selectCourse(index) {
    if (this.presetCourses.length === 0) {
      this.courseName = ""
      this.courseTime = ""
      return
    }
    if (index < 0 || index >= this.presetCourses.length) {
      index = 0
    }
    this.courseIndex = index
    var c = this.presetCourses[index]
    this.courseName = c.name
    this.courseLocation = c.location
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
  },

  pickTime(target) {
    this.pickTarget = target
    if (target === "start") {
      this.selectedHour = this.startHour
      this.selectedMin = this.startMin
    } else {
      this.selectedHour = this.endHour
      this.selectedMin = this.endMin
    }
    this.timePicker = true
  },

  confirmTimePick() {
    if (this.pickTarget === "start") {
      this.startHour = this.selectedHour
      this.startMin = this.selectedMin
    } else {
      this.endHour = this.selectedHour
      this.endMin = this.selectedMin
    }
    this.timePicker = false
    this.updateTimeString()
  },

  increaseSelectedHour() {
    if (this.selectedHour < 23) { this.selectedHour = this.selectedHour + 1 }
    else { this.selectedHour = 0 }
  },
  decreaseSelectedHour() {
    if (this.selectedHour > 0) { this.selectedHour = this.selectedHour - 1 }
    else { this.selectedHour = 23 }
  },
  increaseSelectedMin() {
    if (this.selectedMin < 55) { this.selectedMin = this.selectedMin + 5 }
    else { this.selectedMin = 0 }
  },
  decreaseSelectedMin() {
    if (this.selectedMin >= 5) { this.selectedMin = this.selectedMin - 5 }
    else { this.selectedMin = 55 }
  },

  updateTimeString() {
    this.courseTime = padZero(this.startHour) + ":" + padZero(this.startMin) + " - " + padZero(this.endHour) + ":" + padZero(this.endMin)
  },

  selectDay(idx) {
    this.dayIndex = idx
    this.day = DAY_NAMES[idx]
  },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "输入位置" })
    storage.set({ key: "chinese_input_placeholder", value: "点击输入位置, 例如: 301教室" })
    storage.set({ key: "chinese_input_value", value: this.courseLocation || "" })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  goBack() {
    router.back()
  },

  saveCourse() {
    if (this.isSaving) { return }
    if (!this.courseName) { prompt.showToast({ message: "请先选择课程" }); return }
    if (!this.courseTime) { prompt.showToast({ message: "请先设置时间" }); return }
    if (!this.day) { this.setDefaultDay() }

    this.isSaving = true
    var self = this
    var newCourse = {
      id: String(this.nextId),
      day: this.day,
      name: this.courseName,
      time: this.courseTime,
      location: this.courseLocation || "",
      notes: ""
    }
    this.nextId++
    var storage = require("@system.storage")
    storage.set({ key: "add_course_nextId", value: String(this.nextId) })
    database.insertCourse(newCourse, function(err) {
      if (!err) {
        prompt.showToast({ message: "课程已添加" })
        router.back()
      } else {
        self.isSaving = false
        prompt.showToast({ message: "保存失败，请重试" })
      }
    })
  }
}
</script>

<style>
.page-root {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 30px 16px 30px 16px;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  flex-shrink: 0;
}

.back-btn {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  font-size: 28px;
  line-height: 48px;
  text-align: center;
  background-color: transparent;
  border: none;
  flex-shrink: 0;
}

.title {
  font-size: 30px;
  line-height: 40px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.mgmt-btn {
  width: 60px;
  height: 40px;
  border-radius: 12px;
  font-size: 22px;
  line-height: 36px;
  text-align: center;
  background-color: transparent;
  border: none;
  flex-shrink: 0;
}

.main-scroll {
  flex: 1;
  flex-direction: column;
}

.section {
  flex-direction: column;
  margin-bottom: 16px;
  flex-shrink: 0;
}

.section-title {
  font-size: 26px;
  line-height: 36px;
  font-weight: bold;
  margin-bottom: 8px;
  max-lines: 1;
  text-overflow: ellipsis;
}

.course-grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.course-item {
  width: 124px;
  height: 68px;
  border-radius: 14px;
  padding: 8px;
  margin-right: 10px;
  margin-bottom: 10px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2px solid transparent;
}

.course-item:nth-child(3n) {
  margin-right: 0;
}

.course-item-selected {
  border-color: #7ec8e3;
}

.course-name {
  font-size: 26px;
  line-height: 34px;
  font-weight: bold;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.course-time-text {
  font-size: 18px;
  line-height: 26px;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.time-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.time-box {
  width: 150px;
  height: 70px;
  border-radius: 14px;
  padding: 10px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.time-val {
  font-size: 32px;
  line-height: 42px;
  font-weight: bold;
  text-align: center;
}

.time-label {
  font-size: 20px;
  line-height: 28px;
}

.time-sep {
  font-size: 26px;
  line-height: 36px;
  margin: 0 12px;
  font-weight: bold;
}

.time-adjust {
  flex-direction: column;
  align-items: center;
  margin-top: 10px;
  padding: 12px;
  border-radius: 14px;
  background-color: #16213e;
}

.adjust-group {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.adjust-label {
  font-size: 24px;
  line-height: 34px;
  width: 40px;
  text-align: center;
}

.adjust-btn {
  width: 40px;
  height: 36px;
  border-radius: 10px;
  font-size: 24px;
  line-height: 32px;
  font-weight: bold;
  text-align: center;
  background-color: transparent;
  border: none;
}

.adjust-num {
  font-size: 30px;
  line-height: 40px;
  font-weight: bold;
  width: 52px;
  text-align: center;
}

.confirm-btn {
  width: 100px;
  height: 38px;
  border-radius: 10px;
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  text-align: center;
  background-color: transparent;
  border: none;
}

.input-box {
  width: 100%;
  height: 48px;
  border-radius: 12px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  padding: 0 14px;
}

.input-text {
  font-size: 26px;
  line-height: 36px;
  max-lines: 1;
  text-overflow: ellipsis;
}

.input-placeholder {
  opacity: 0.5;
  font-size: 26px;
  line-height: 36px;
}

.weekday-row {
  flex-direction: row;
  justify-content: space-between;
}

.weekday-btn {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}

.weekday-btn text {
  font-size: 24px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
}

.bottom-bar {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 10px;
  flex-shrink: 0;
}

.cancel-btn {
  width: 120px;
  height: 46px;
  border-radius: 14px;
  font-size: 26px;
  line-height: 42px;
  font-weight: bold;
  text-align: center;
  background-color: transparent;
  border: none;
}

.save-btn {
  width: 240px;
  height: 46px;
  border-radius: 14px;
  font-size: 26px;
  line-height: 42px;
  font-weight: bold;
  text-align: center;
  background-color: transparent;
  border: none;
}
</style>