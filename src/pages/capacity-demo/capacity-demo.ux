  flex-direction: column;
  width: 100%;
  padding: 30px 14px 14px 14px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-icon {
  width: 20px;
  height: 20px;
}

.title {
  flex: 1;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  line-height: 26px;
}

.ph {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
}

.sec-title {
  font-size: 14px;
  line-height: 20px;
  margin: 8px 0 4px 2px;
}

.ruler {
  width: 164px;
  height: 24px;
  border-width: 1px;
  border-style: dashed;
  border-radius: 4px;
  justify-content: center;
  align-items: center;
}

.ruler-text {
  font-size: 12px;
  line-height: 16px;
}

.size-card {
  flex-direction: column;
  border-radius: 10px;
  padding: 8px 10px;
}

.size-row {
  flex-direction: column;
  margin-bottom: 8px;
}

.size-label {
  font-size: 12px;
  line-height: 16px;
  margin-bottom: 2px;
}

.size-sample {
  lines: 1;
  text-overflow: clip;
}

.note {
  font-size: 12px;
  line-height: 17px;
  margin: 4px 2px 0 2px;
}

.btn-card {
  flex-direction: column;
  border-radius: 10px;
  padding: 8px 10px;
}

.btn-row-label {
  font-size: 12px;
  line-height: 16px;
  margin: 4px 0;
}

.btn-row {
  flex-direction: row;
  margin-bottom: 8px;
}

.btn {
  flex: 1;
  border-radius: 9px;
  justify-content: center;
  align-items: center;
  margin: 0 3px;
}

.btn-text {
  font-size: 14px;
  line-height: 20px;
}

.btn-text-s {
  font-size: 13px;
  line-height: 18px;
}

.btn-text-xs {
  font-size: 12px;
  line-height: 16px;
}
</style>
