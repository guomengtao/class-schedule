<!-- 多彩课表（单日视图）—— 由整周矩阵重构为「只显示一天」的彩色课程卡片列表。
     保留价值：科目稳定配色（多彩身份）；交互：左右滑动切天（prevDay/nextDay）。
     独立首页化：root 判定 + 双模返回 + 主题全适配 + 空态 + 自加载数据。 -->
<template>
  <div class="page" @swipe="handleSwipe" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div if="{{ !isRoot }}" class="back-btn-wrapper" onclick="backClick" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <div class="header-center">
        <text class="header-title" style="color: {{ theme.text }}">多彩课表</text>
        <text class="header-day" style="color: {{ theme.textSecondary }}">{{ dayLabel }}</text>
      </div>
      <div if="{{ !isRoot }}" class="header-placeholder"></div>
    </div>

    <text if="{{ !hasCourses }}" class="empty-hint" style="color: {{ theme.textMuted }}">{{ emptyHint }}</text>

    <scroll if="{{ hasCourses }}" class="scroll-body" scroll-y="true">
      <div for="{{ dayClasses }}" class="course-card" style="background-color: {{ $item.color }}">
        <div class="course-main">
          <text class="course-name" style="color: #ffffff">{{ $item.name }}</text>
          <text class="course-time" style="color: rgba(255,255,255,0.9)">{{ $item.time }}</text>
        </div>
        <text if="{{ $item.location }}" class="course-location" style="color: rgba(255,255,255,0.75)">{{ $item.location }}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router";
const database = require("../../data/database.js");
const store = require("../../data/store.js");
const utils = require("../../data/utils.js");

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"];
// 多彩身份：科目稳定配色（官方 color demo 色板：#ff6b6b / #51cf66 / rgb(51,154,240) / blue / #f00）
var PALETTE = ["#ff6b6b", "#51cf66", "rgb(51,154,240)", "#3b82f6", "#f00"];

function parseMinutes(t) {
  if (!t) return 0;
  var i = t.indexOf(" - ");
  if (i < 0) return 0;
  var s = t.substring(0, i).trim().split(":");
  if (s.length !== 2) return 0;
  return parseInt(s[0], 10) * 60 + parseInt(s[1], 10);
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    dayCursor: 0,
    dayLabel: "",
    dayClasses: [],
    hasCourses: false,
    emptyHint: "今天暂无课程",
    theme: {
      bg: '#1a1a2e', card: '#16213e', accent: '#7ec8e3',
      text: '#ffffff', textSecondary: '#888899', textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this;
    // 独立首页 root 判定：由「更多首页」push 时带 fromPanel='1'；无参数即被设为首页冷启动
    self.fromPanel = (self.fromPanel === '1') ? '1' : '';
    self.isRoot = self.fromPanel !== '1';
    self.updateTheme();
    // 默认显示今天
    self.dayCursor = new Date().getDay();
    self.loadDay();
  },

  onShow() {
    this.updateTheme();
  },

  updateTheme: function() {
    var self = this;
    store.getTheme(function(t, themeName) {
      self.theme = t;
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark';
    });
  },

  loadDay: function() {
    var self = this;
    database.init(function() {
      database.getAllCourses(function(schedule) {
        var matrix = {};
        if (schedule) {
          for (var d = 0; d < schedule.length; d++) {
            var dd = schedule[d];
            if (dd && dd.day) matrix[dd.day] = dd.classes || [];
          }
        }
        self.renderDay(matrix);
      });
    });
  },

  renderDay: function(matrix) {
    var self = this;
    var dayName = DAY_NAMES[self.dayCursor];
    var todayIdx = new Date().getDay();
    if (!self._subjectColors) self._subjectColors = {};
    var cls = (matrix[dayName] || []).slice();
    cls.sort(function(a, b) { return parseMinutes(a.time) - parseMinutes(b.time); });
    var out = cls.map(function(c) {
      var ci = self._subjectColors[c.name];
      if (ci === undefined) {
        ci = Object.keys(self._subjectColors).length % PALETTE.length;
        self._subjectColors[c.name] = ci;
      }
      return { name: c.name, time: c.time, location: c.location, id: c.id, color: PALETTE[ci] };
    });
    self.dayClasses = out;
    self.hasCourses = out.length > 0;
    self.dayLabel = (self.dayCursor === todayIdx) ? ("今天 · " + dayName) : dayName;
    self.emptyHint = (self.dayCursor === todayIdx) ? "今天暂无课程" : (dayName + " 暂无课程");
  },

  reloadDay: function() {
    var self = this;
    database.getAllCourses(function(schedule) {
      var matrix = {};
      if (schedule) {
        for (var d = 0; d < schedule.length; d++) {
          var dd = schedule[d];
          if (dd && dd.day) matrix[dd.day] = dd.classes || [];
        }
      }
      self.renderDay(matrix);
    });
  },

  prevDay: function() {
    if (this.dayCursor > 0) { this.dayCursor -= 1; this.reloadDay(); }
  },

  nextDay: function() {
    if (this.dayCursor < 6) { this.dayCursor += 1; this.reloadDay(); }
  },

  handleSwipe: function(eve) {
    if (eve.direction === "left") this.nextDay();
    else if (eve.direction === "right") this.prevDay();
  },

  backClick() {
    if (this.fromPanel === '1') {
      router.back();
    } else {
      utils.exitApp();
    }
  },

  onBackPress() {
    if (this.fromPanel === '1') return false;
    return utils.exitApp() === true;
  },

  handleClick(item) {
    router.push({ uri: "/pages/schedule-manager" });
  }
};
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; padding: 44px 12px 12px 12px }

.back-header { flex-direction: row; align-items: center; margin-bottom: 14px; padding: 0 4px }
.back-btn-wrapper { width: 48px; height: 40px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 24px; height: 24px }
.header-center { flex: 1; flex-direction: column; align-items: center; justify-content: center }
.header-title { font-size: 26px; font-weight: bold; line-height: 34px; text-align: center }
.header-day { font-size: 16px; line-height: 22px; text-align: center; margin-top: 2px }
.header-placeholder { width: 48px; height: 40px; flex-shrink: 0 }

.empty-hint { flex: 1; align-items: center; justify-content: center; font-size: 22px; line-height: 30px; text-align: center }

.scroll-body { flex: 1; flex-direction: column }
.course-card { flex-direction: column; border-radius: 12px; padding: 12px 14px; margin-bottom: 10px }
.course-main { flex-direction: row; justify-content: space-between; align-items: baseline }
.course-name { font-size: 24px; font-weight: bold; line-height: 32px }
.course-time { font-size: 18px; line-height: 26px; flex-shrink: 0; margin-left: 8px }
.course-location { font-size: 16px; line-height: 22px; margin-top: 4px }

/* 宽屏 / 大屏断点：字号与卡片间距同步放大，保持工整比例 */
@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px }
  .header-title { font-size: 28px; line-height: 36px }
  .course-card { margin-bottom: 12px }
  .course-name { font-size: 28px; line-height: 36px }
  .course-time { font-size: 20px; line-height: 28px }
  .course-location { font-size: 18px; line-height: 24px }
}

@media (width >= 400px) {
  .page { padding: 12px 20px 16px 20px }
  .header-title { font-size: 32px; line-height: 40px }
  .course-card { padding: 16px 18px; margin-bottom: 14px }
  .course-name { font-size: 32px; line-height: 40px }
  .course-time { font-size: 22px; line-height: 30px }
}
</style>
