<!-- UI/实现来源：open-vela-learning/packages_apps/wearable/calendar/src/pages/index/index.ux（ev-minimal 最小改动法，2026-10-14；注入点仅数据源/文案/跳转） -->
<template>
  <div class="home-page" @swipe="handleSwipe">
    <div class="header">
      <div class="year-month">
        <text class="title">本周课表</text>
      </div>
      <div class="week-head">
        <text class="week-text weekend">一</text>
        <text class="week-text">二</text>
        <text class="week-text">三</text>
        <text class="week-text">四</text>
        <text class="week-text">五</text>
        <text class="week-text weekend">六</text>
        <text class="week-text weekend">日</text>
      </div>
      <div class="divider"></div>
    </div>
    <div class="list">
      <div for="row in list" class="item" style="height: {{height}}">
        <div class="cell" for="cell in row" tid="id">
          <text @click="handleClick(cell)" class="{{cell.className}}">
            {{ cell.value }}
          </text>
        </div>
      </div>
    </div>
    <div else class="container" if="{{$app.$def.screenShape === 'pill-shaped'}}">
      <text @click="backClick">返回</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import app from "@system.app";
const database = require("../../data/database.js");
export default {
	private: {
		date: new Date(),
		year: "",
		month: "",
		list: null,
		height: "50px",
		viewIndex: 0
	},

	onInit() {
		this.initList();
		this.loadMatrix();
	},

	initList() {
		let list = [];
		for (let i = 0; i < 5; i++) {
			let initArray = new Array(7).fill("x").map((item) => {
				return {
					value: "",
					className: "",
				};
			});
			list.push(initArray);
		}

		this.list = list;
	},
	backClick() {
		app.terminate();
	},

	// 注入点①数据源：官方 getCalendar（日期矩阵）→ 课表矩阵。
	// 渲染机制全部保留官方：rows×7 矩阵、className 三类（workday/weekend/today）、动态行高、点击进详情。
	// 有课格子直接套官方 cell-text-today 红底高亮类；§11 例外：官方无课程业务，数据层用项目 database。
	loadMatrix() {
		const self = this;
		database.getAllCoursesWithIndex(self.viewIndex, function(schedule) {
			const matrix = {};
			if (schedule) {
				for (let d = 0; d < schedule.length; d++) {
					const dayData = schedule[d];
					if (dayData && dayData.day) matrix[dayData.day] = dayData.classes || [];
				}
			}
			self.buildScheduleMatrix(matrix);
		});
	},

	buildScheduleMatrix(matrix) {
		const DAY_COLS = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"];
		let rows = 1;
		for (let i = 0; i < DAY_COLS.length; i++) {
			const cls = matrix[DAY_COLS[i]] || [];
			if (cls.length > rows) rows = cls.length;
		}
		this.updateListRows(rows);
		this.height = 300 / rows + "px";

		for (let i = 0; i < rows; i++) {
			for (let j = 0; j < 7; j++) {
				const cls = matrix[DAY_COLS[j]] || [];
				const c = cls[i];
				if (j === 5 || j === 6) {
					this.list[i][j].className = "cell-text-weekend";
				} else {
					this.list[i][j].className = "cell-text-workday";
				}
				if (c && c.name) {
					this.list[i][j].value = c.name;
					this.list[i][j].className = "cell-text-today";
					this.list[i][j].courseId = c.id;
				} else {
					this.list[i][j].value = "";
				}
			}
		}
	},

	updateListRows(rows) {
		while (this.list.length < rows) {
			let initArray = new Array(7).fill("x").map((item) => {
				return {
					value: "",
					className: "",
				};
			});
			this.list.push(initArray);
		}

		while (this.list.length > rows) {
			this.list.pop();
		}
	},

	prevWeek() {
		if (this.viewIndex <= 0) return;
		this.viewIndex -= 1;
		this.loadMatrix();
	},

	nextWeek() {
		this.viewIndex += 1;
		this.loadMatrix();
	},

	// 注入点③跳转：官方 handleClick（push 本工程不存在的 pages/detail）→ 项目课程管理页
	handleClick(item) {
		if (item.value === "") return;
		router.push({
			uri: "/pages/schedule-manager"
		});
	},

	handleSwipe(eve) {
		if (eve.direction === "left") {
			this.nextWeek();
		} else if (eve.direction === "right") {
			this.prevWeek();
		}
	},
};
</script>

<style>
.home-page {
	width: 100%;
	height: 100%;
	border-radius: 240px;
	flex-direction: column;
  align-items: center;
}

@media screen and (shape: pill-shaped) {
	.home-page {
		width: 100%;
		height: 100%;
		border-radius: 240px;
		flex-direction: column;
		align-items: flex-start;
	}
}

.header {
	width: 350px;
	height: 80px;
	margin-top: 20px;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
}

.year-month {
	width: 240px;
	height: 60px;
	justify-content: center;
	align-items: center;
}
.container {
	justify-content: center;
	padding: 10px;
	color: white;
	border-radius: 20px;
	margin: 0px 20px 0px 20px;
	background-color: grey;
}

.title {
	font-weight: 700;
}

.red {
	color: #f00;
}

.week-head {
	width: 350px;
	justify-content: center;
	align-items: center;
}

.week-text {
	width: 50px;
	font-weight: 700;
	color: #fff;
	text-align: center;
}

.weekend {
	color: rgba(255, 255, 255, 0.6);
}

.divider {
	width: 100%;
	height: 2px;
	margin-top: 4px;
	background-color: rgba(255, 255, 255, 0.3);
}

.list {
	width: 350px;
	height: 300px;
	flex-direction: column;
}

.item {
	width: 100%;
}

.cell {
	width: 50px;
	height: 100%;
}

.cell-text-workday {
	width: 100%;
	height: 100%;
	font-weight: 700;
	text-align: center;
	color: rgba(255, 255, 255, 1);
	background-color: transparent;
}

.cell-text-weekend {
	width: 100%;
	height: 100%;
	font-weight: 700;
	text-align: center;
	color: rgba(255, 255, 255, 0.6);
	background-color: transparent;
}

.cell-text-today {
	width: 100%;
	height: 100%;
	font-weight: 700;
	text-align: center;
	color: rgba(255, 255, 255, 1);
	background-color: #ff3a3a;
}
</style>
