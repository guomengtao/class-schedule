<!-- 多彩课表 —— 一天一屏的「彩色瓷砖」网格（本栏目身份：高饱和科目色块）。
     2026-10-25 ev-six 重排（evtask-D-evclass-sche-261025-v473pg）：
       · 字号 18/22 → 24/28 两档（18/22 在 12~23 禁区）；
       · 7 格星期条（7×18px 才放得下）→ 删掉，改左右箭头 + 两字日名（24px 下 7 格需 224px，放不下）；
       · 3 列 × 5 行 52×56 → 2 列 × 4 行 82×68 彩色瓷砖（格子大了课名才敢上 24px）；
       · 4 处 if= → display 绑定；删 text-overflow: ellipsis；删日名里的 · 分隔符；
       · 页头 120px 返回热区 → 36px 页头 + 44×44 箭头热区（本页已无手势，不必留超高热区）；
       · 保留屏宽比例适配（fitScreen：192 原样、宽屏 2 列放大到四档内 30/28）。
     纪律：无 transform / 无 <scroll> / 无 @keyframes；页根不挂 onclick。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}; padding: {{ sz.page }}">
    <div class="back-header" style="height: {{ sz.headerH }}">
      <!-- 条件渲染一律 display 绑定（事故案例 11：多兄弟节点 if 会整页白屏） -->
      <div class="back-btn-wrapper" style="display: {{ isRoot ? 'none' : 'flex' }}; background-color: {{ theme.card }}" onclick="backClick">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">多彩</text>
      <div class="header-placeholder" style="display: {{ isRoot ? 'none' : 'flex' }}"></div>
    </div>

    <!-- A 日切换：左箭头 + 两字日名（溢出时带 +N）+ 右箭头。
         箭头用图标不用 ‹ › 字形（红线 4 禁 ›；且字形在本引擎里基线会飘） -->
    <div class="day-row" style="height: {{ sz.dayH }}">
      <div class="nav-btn" onclick="prevDay">
        <image class="nav-icon" src="/common/icons/{{ iconTheme }}/icon_arrow_left.png"></image>
      </div>
      <text class="day-text" style="color: {{ theme.text }}; font-size: {{ sz.dayFont }}; line-height: {{ sz.dayLh }}">{{ dayLabel }}</text>
      <div class="nav-btn" onclick="nextDay">
        <image class="nav-icon" src="/common/icons/{{ iconTheme }}/icon_arrow_right.png"></image>
      </div>
    </div>

    <!-- B 彩色瓷砖：2 列 × 最多 4 行，底色 = 科目色。
         行对象带 cells 属性（不是裸数组）：本引擎里外层 for 的 $item 直接是数组时内层 for 渲染不出来，
         这是色卡页（schedule-panel-subject-color）已验证过的写法。 -->
    <div class="grid" style="display: {{ hasCourses ? 'flex' : 'none' }}; margin-top: {{ sz.gridMT }}">
      <div for="{{ rows }}" class="grid-row" style="height: {{ sz.cellH }}; margin-bottom: {{ sz.gapH }}">
        <div for="{{ $item.cells }}" class="tile {{ $item.now ? 'is-now' : '' }}" style="background-color: {{ $item.color }}; width: {{ sz.cellW }}; height: {{ sz.cellH }}">
          <text class="tile-name {{ $item.sizeCls }}">{{ $item.name }}</text>
        </div>
      </div>
    </div>

    <!-- C 空态：4 字以内（6 字「今天暂无课程」@24 = 191px 超内宽 168） -->
    <text class="empty-hint" style="display: {{ hasCourses ? 'none' : 'flex' }}; color: {{ theme.textMuted }}; font-size: {{ sz.emptyFont }}; line-height: {{ sz.emptyLh }}">{{ emptyHint }}</text>
  </div>
</template>

<script>
import router from "@system.router";
import device from "@system.device";
const database = require("../../data/database.js");
const store = require("../../data/store.js");
const utils = require("../../data/utils.js");
const subjectColor = require("../../data/subject-color.js");
const builtinSchedule = require("../../data/schedule.js");
const screenFit = require("../../data/screen-fit.js");

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"];
var DAY_SHORT = ["日", "一", "二", "三", "四", "五", "六"];

// 192 基准：2 列 × 4 行 = 8 格（宽屏只放大格子，不增列 —— 增列后课名只剩 1 字/行）
var BASE_COLS = 2;
var BASE_ROWS = 4;

function parseMinutes(t) {
  if (!t) return 0;
  var i = t.indexOf(" - ");
  if (i < 0) return 0;
  var s = t.substring(0, i).trim().split(":");
  if (s.length !== 2) return 0;
  return parseInt(s[0], 10) * 60 + parseInt(s[1], 10);
}

function endMinutes(t) {
  if (!t) return 0;
  var i = t.indexOf(" - ");
  if (i < 0) return 0;
  var s = t.substring(i + 3).trim().split(":");
  if (s.length !== 2) return 0;
  return parseInt(s[0], 10) * 60 + parseInt(s[1], 10);
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    dayCursor: 0,
    dayLabel: "",
    emptyHint: "今天无课",
    rows: [],
    hasCourses: false,
    totalCount: 0,
    _matrix: null,
    _timer: null,
    _wide: false,
    cols: BASE_COLS,
    rowsMax: BASE_ROWS,
    // 尺寸令牌：默认值 = 192×490 基准原样；只有宽屏才会被 fitScreen() 改写
    sz: {
      page: "44px 12px 12px 12px",
      headerH: "36px", dayH: "44px",
      dayFont: "24px", dayLh: "30px",
      gridMT: "0px", gapH: "6px",
      cellW: "82px", cellH: "68px",
      emptyFont: "24px", emptyLh: "32px"
    },
    theme: {
      bg: '#1a1a2e', card: '#16213e', accent: '#7ec8e3',
      text: '#ffffff', textSecondary: '#888899', textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this;
    self.fromPanel = (self.fromPanel === '1') ? '1' : '';
    self.isRoot = self.fromPanel !== '1';
    self.dayCursor = new Date().getDay();
    self.fitScreen();
    // 首帧兜底：内置课表同步算一遍，storage 回调慢/丢也不许空白
    self.applySchedule((builtinSchedule && builtinSchedule.schedule) ? builtinSchedule.schedule : []);
    // database.init 放在 storage 回调之后调：onInit 里同步调会让回调永不触发（pit-20261025-24）
    store.getTheme(function(t, themeName) {
      self.theme = t;
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark';
      self.loadData();
    });
    self.scheduleTick();
  },

  onShow() {
    this.updateTheme();
    this.computeNowFlag();
    this.scheduleTick();
  },

  onHide() {
    this.clearTick();
  },

  onDestroy() {
    this.clearTick();
  },

  clearTick: function() {
    if (this._timer) { clearTimeout(this._timer); this._timer = null; }
  },

  // 只挂一个对齐整分的 setTimeout（分钟级事件：当前时段高亮）
  scheduleTick: function() {
    var self = this;
    self.clearTick();
    var now = new Date();
    var ms = (60 - now.getSeconds()) * 1000 - now.getMilliseconds();
    if (ms < 1000) ms = 1000;
    self._timer = setTimeout(function() {
      self._timer = null;
      self.computeNowFlag();
      self.scheduleTick();
    }, ms);
  },

  updateTheme: function() {
    var self = this;
    store.getTheme(function(t, themeName) {
      self.theme = t;
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark';
    });
  },

  /* 屏宽比例适配：192×490（手环 9）是设计基准，sz 一个像素都不动；
     只有 wide 屏（≥300，10 Pro 336 起）才重算格子尺寸。
     字号仍锁死在四档内：2 字 30 / 3 字以上 28（宽屏格子够大，抬一档不越线）。 */
  fitScreen: function() {
    var self = this;
    device.getInfo({
      success: function(d) {
        var s = screenFit.scaleFor(d.screenWidth, d.screenHeight);
        if (!s.wide) return;
        self.applyWide(s, d.screenWidth, d.screenHeight);
        self.render();
      },
      fail: function() { /* 读不到屏幕信息 → 按 192 基准渲染 */ }
    });
  },

  applyWide: function(s, w, h) {
    var self = this;
    var px = screenFit.px;
    var sides = 14, padTop = 44, padBottom = 12;
    var headerH = 36, headerMB = 8;
    var dayH = 48, dayMB = 10;
    var gap = 8;
    var contentW = w - sides * 2;
    var cellW = Math.floor((contentW - gap) / BASE_COLS);
    var gridH = h - padTop - padBottom - headerH - headerMB - dayH - dayMB;
    var cellH = Math.max(64, Math.floor((gridH - (BASE_ROWS - 1) * gap) / BASE_ROWS));
    self._wide = true;
    self.sz = {
      page: px(padTop) + " " + px(sides) + " " + px(padBottom) + " " + px(sides),
      headerH: px(headerH), dayH: px(dayH),
      dayFont: px(28), dayLh: px(34),
      gridMT: "0px", gapH: px(gap),
      cellW: px(cellW), cellH: px(cellH),
      emptyFont: px(28), emptyLh: px(36)
    };
  },

  loadData: function() {
    var self = this;
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.applySchedule(schedule || []);
      });
    });
  },

  applySchedule: function(schedule) {
    var self = this;
    var matrix = {};
    for (var d = 0; d < schedule.length; d++) {
      var dd = schedule[d];
      if (dd && dd.day) matrix[dd.day] = dd.classes || [];
    }
    self._matrix = matrix;
    self.render();
  },

  // 当前时段判定：start <= now < end
  computeNowFlag: function() {
    if (!this._matrix) return;
    var now = new Date();
    var nowMin = now.getHours() * 60 + now.getMinutes();
    var changed = false;
    var rows = this.rows;
    for (var r = 0; r < rows.length; r++) {
      var cells = (rows[r] && rows[r].cells) || [];
      for (var c = 0; c < cells.length; c++) {
        var cell = cells[c];
        if (!cell) continue;
        var isNow = cell.startMin <= nowMin && nowMin < cell.endMin;
        if (cell.now !== isNow) { cell.now = isNow; changed = true; }
      }
    }
    if (changed) this.rows = rows;
  },

  render: function() {
    var self = this;
    var todayIdx = new Date().getDay();
    var dayName = DAY_NAMES[self.dayCursor];
    var cls = ((self._matrix && self._matrix[dayName]) || []).slice();
    cls.sort(function(a, b) { return parseMinutes(a.time) - parseMinutes(b.time); });

    var slots = BASE_COLS * BASE_ROWS;
    var shown = cls.slice(0, slots);
    self.totalCount = cls.length;
    self.hasCourses = cls.length > 0;

    // A 日名：两字在 24px 下只有 108px 可用（两侧箭头各占 30），「周二 +3」= 101px 刚好
    var base = (self.dayCursor === todayIdx) ? "今天" : ("周" + DAY_SHORT[self.dayCursor]);
    var over = cls.length - slots;
    self.dayLabel = over > 0 ? (base + " +" + over) : base;
    // C 空态：4 字以内（今天暂无课程 = 191px 超内宽）
    self.emptyHint = (self.dayCursor === todayIdx) ? "今天无课" : ("周" + DAY_SHORT[self.dayCursor] + "无课");

    // B 瓷砖：2 列分行，行对象带 cells（裸数组进外层 for 会让内层 for 静默不渲染）
    var out = [];
    for (var r = 0; r < BASE_ROWS; r++) {
      var cells = [];
      for (var c = 0; c < BASE_COLS; c++) {
        var item = shown[r * BASE_COLS + c];
        if (!item) continue;
        cells.push({
          name: item.name,
          color: subjectColor.getSubjectColor(item.name),
          // 字号走 class 不走行内（一个 style 里同时放 font-size/line-height 两个绑定在本引擎不稳）
          sizeCls: (item.name || "").length <= 2 ? (self._wide ? "t2w" : "t2") : (self._wide ? "tnw" : "tn"),
          startMin: parseMinutes(item.time),
          endMin: endMinutes(item.time),
          now: false
        });
      }
      if (cells.length) out.push({ cells: cells });
    }
    self.rows = out;
    self.computeNowFlag();
  },

  prevDay: function() {
    if (this.dayCursor > 0) { this.dayCursor -= 1; this.render(); }
  },

  nextDay: function() {
    if (this.dayCursor < 6) { this.dayCursor += 1; this.render(); }
  },

  backClick() {
    if (this.fromPanel === '1') {
      router.back();
    } else {
      // 面板被当独立首页（root）时无可退返回栈，直接回「更多首页」
      router.push({ uri: '/pages/schedule-panel' });
    }
  },

  onBackPress() {
    if (this.fromPanel === '1') return false;
    return utils.exitApp() === true;
  }
};
</script>

<style>
/* 左右 12px（ev-six 页面边距）+ 顶部 44px 让开胶囊状态栏 */
.page { flex-direction: column; width: 100%; height: 100%; padding: 44px 12px 12px 12px }

.back-header { flex-direction: row; align-items: center; height: 36px; margin-bottom: 8px }
.back-btn-wrapper { width: 30px; height: 30px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 22px; height: 22px }
.header-title { flex: 1; font-size: 28px; font-weight: bold; text-align: center; line-height: 36px }
.header-placeholder { width: 30px; height: 30px; flex-shrink: 0 }

/* A 日切换：44×44 热区，负 margin 各让 7px → 视觉只占 30px，中间日名剩 108px */
.day-row { flex-direction: row; align-items: center; justify-content: center; height: 44px; margin-bottom: 8px; flex-shrink: 0 }
.nav-btn { width: 44px; height: 44px; margin: 0 -7px; justify-content: center; align-items: center; flex-shrink: 0 }
.nav-icon { width: 22px; height: 22px }
.day-text { flex: 1; font-size: 24px; line-height: 30px; text-align: center; font-weight: bold }

/* B 瓷砖：2 列 × 最多 4 行；82×2 + 4 = 168（space-between 自动吃下 4px 缝）
   4×68 + 3×6 = 290 → 内容底 44+36+8+44+8+290 = 430 ≤ 440（胶囊圆角安全线） */
.grid { flex-direction: column; flex-shrink: 0 }
.grid-row { flex-direction: row; justify-content: space-between; height: 68px; margin-bottom: 6px }
.tile { width: 82px; height: 68px; border-radius: 10px; padding: 2px; box-sizing: border-box; justify-content: center; align-items: center }
/* 当前节：白色 2px 环 = 状态标记（不是装饰分隔线），全页仅此一处描边 */
.tile.is-now { border-width: 2px; border-style: solid; border-color: #ffffff }
/* 课名：28（2 字）/ 24（3 字以上）两档，靠 class 切——行内同放 font-size+line-height 两个绑定在本引擎不稳。
   宽屏抬到 30/28，仍在四档之内。lines:2 兜住 4 字课名（82px 屏格最多 2 字/行），不用 ellipsis。 */
.tile-name { width: 100%; text-align: center; font-weight: bold; color: #ffffff; lines: 2 }
.t2 { font-size: 28px; line-height: 34px }
.tn { font-size: 24px; line-height: 28px }
.t2w { font-size: 30px; line-height: 36px }
.tnw { font-size: 28px; line-height: 34px }

.empty-hint { flex: 1; align-items: center; justify-content: center; font-size: 24px; line-height: 32px; text-align: center }
</style>
