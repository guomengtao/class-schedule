<!-- 多彩课表 —— 7 天 × 5 节固定网格（本栏目唯一不可替代的价值：完整周结构一眼看完）。
     2026-10-20 重构（evtask-D-evclass-sche-261020-txxxys）：
       · 原为「单日彩色卡片 + <scroll> + @swipe 手势切天」→ 现为固定 3 列 × 5 行网格，不滚动；
       · 移除 touch 手势（drag 在本引擎易被判点击 → 跳页风险），改顶部 ‹ › 箭头切天；
       · 配色由 PALETTE「按插入顺序取色」改为共享固定表 subject-color.js（切天/重载不再漂移）；
       · 首帧用内置课表同步出画（storage 慢也不卡「加载中」）；
       · 只挂一个对齐整分的 setTimeout，onHide/onDestroy 双清。
     纪律：无 transform / 无 <scroll> / 无 @keyframes；页根不挂 onclick。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 顶部返回热区（≥120px）：页面根节点不挂 onclick，防 drag 被当点击 -->
    <div class="back-header">
      <div if="{{ !isRoot }}" class="back-btn-wrapper" onclick="backClick" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <div class="header-center">
        <text class="header-title" onclick="backClick" style="color: {{ theme.text }}">多彩课表</text>
        <text class="header-day" style="color: {{ theme.textSecondary }}">{{ dayLabel }}</text>
      </div>
      <div if="{{ isRoot }}" class="header-placeholder"></div>
    </div>

    <text if="{{ !hasCourses }}" class="empty-hint" style="color: {{ theme.textMuted }}">{{ emptyHint }}</text>

    <!-- A 星期条：一~日 7 格 + 左右切天箭头（替代原 @swipe 手势；20×20 才放得下 168） -->
    <div if="{{ hasCourses }}" class="week-strip">
      <div class="arrow-btn" onclick="prevDay" style="background-color: {{ theme.card }}">
        <text class="arrow-icon" style="color: {{ theme.accent }}">‹</text>
      </div>
      <div for="{{ weekCells }}" class="week-cell {{ $item.current ? 'is-current' : '' }}">
        <text class="week-text" style="color: {{ $item.current ? theme.accent : theme.textSecondary }}">{{ $item.label }}</text>
      </div>
      <div class="arrow-btn" onclick="nextDay" style="background-color: {{ theme.card }}">
        <text class="arrow-icon" style="color: {{ theme.accent }}">›</text>
      </div>
    </div>

    <!-- B 课表格：3 列 × 5 行固定网格，不滚动 -->
    <div if="{{ hasCourses }}" class="grid">
      <div for="{{ gridCells }}" class="grid-row">
        <div for="{{ $item }}" class="grid-cell {{ $item.now ? 'is-now' : '' }}" style="background-color: {{ $item.color }}">
          <text class="cell-name" style="color: #ffffff">{{ $item.name }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
const database = require("../../data/database.js");
const store = require("../../data/store.js");
const utils = require("../../data/utils.js");
const subjectColor = require("../../data/subject-color.js");
const builtinSchedule = require("../../data/schedule.js");

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"];
var DAY_SHORT = ["日", "一", "二", "三", "四", "五", "六"];
var MAX_ROWS = 5;
var COLS = 3;

function parseMinutes(t) {
  if (!t) return 0;
  var i = t.indexOf(" - ");
  if (i < 0) return 0;
  var s = t.substring(0, i).trim().split(":");
  if (s.length !== 2) return 0;
  return parseInt(s[0], 10) * 60 + parseInt(s[1], 10);
}

function endMinutes(t) {
  if (!t) return 0;
  var i = t.indexOf(" - ");
  if (i < 0) return 0;
  var s = t.substring(i + 3).trim().split(":");
  if (s.length !== 2) return 0;
  return parseInt(s[0], 10) * 60 + parseInt(s[1], 10);
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    dayCursor: 0,
    dayLabel: "",
    emptyHint: "今天暂无课程",
    weekCells: [],
    gridCells: [],
    hasCourses: false,
    todayCount: 0,
    totalCount: 0,
    _matrix: null,
    _timer: null,
    theme: {
      bg: '#1a1a2e', card: '#16213e', accent: '#7ec8e3',
      text: '#ffffff', textSecondary: '#888899', textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this;
    self.fromPanel = (self.fromPanel === '1') ? '1' : '';
    self.isRoot = self.fromPanel !== '1';
    self.dayCursor = new Date().getDay();
    self.updateTheme();
    // 首帧兜底：内置课表同步算一遍，storage 回调慢也不卡「加载中」
    self.applySchedule((builtinSchedule && builtinSchedule.schedule) ? builtinSchedule.schedule : []);
    self.loadData();
    self.scheduleTick();
  },

  onShow() {
    this.updateTheme();
    this.computeNowFlag();
    this.scheduleTick();
  },

  onHide() {
    this.clearTick();
  },

  onDestroy() {
    this.clearTick();
  },

  clearTick: function() {
    if (this._timer) { clearTimeout(this._timer); this._timer = null; }
  },

  // 只挂一个对齐整分的 setTimeout（分钟级事件：当前时段高亮）
  scheduleTick: function() {
    var self = this;
    self.clearTick();
    var now = new Date();
    var ms = (60 - now.getSeconds()) * 1000 - now.getMilliseconds();
    self._timer = setTimeout(function() {
      self._timer = null;
      self.computeNowFlag();
      self.scheduleTick();
    }, ms);
  },

  updateTheme: function() {
    var self = this;
    store.getTheme(function(t, themeName) {
      self.theme = t;
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark';
    });
  },

  loadData: function() {
    var self = this;
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.applySchedule(schedule || []);
      });
    });
  },

  applySchedule: function(schedule) {
    var self = this;
    var matrix = {};
    for (var d = 0; d < schedule.length; d++) {
      var dd = schedule[d];
      if (dd && dd.day) matrix[dd.day] = dd.classes || [];
    }
    self._matrix = matrix;
    self.render();
  },

  // 当前时段判定：start <= now < end
  computeNowFlag: function() {
    if (!this._matrix) return;
    var now = new Date();
    var nowMin = now.getHours() * 60 + now.getMinutes();
    var changed = false;
    var cells = this.gridCells;
    for (var r = 0; r < cells.length; r++) {
      var row = cells[r] || [];
      for (var c = 0; c < row.length; c++) {
        var cell = row[c];
        if (!cell) continue;
        var isNow = cell.startMin <= nowMin && nowMin < cell.endMin;
        if (cell.now !== isNow) { cell.now = isNow; changed = true; }
      }
    }
    if (changed) this.gridCells = cells;
  },

  render: function() {
    var self = this;
    var todayIdx = new Date().getDay();
    var dayName = DAY_NAMES[self.dayCursor];
    var cls = ((self._matrix && self._matrix[dayName]) || []).slice();
    cls.sort(function(a, b) { return parseMinutes(a.time) - parseMinutes(b.time); });

    // 副标题宽度只有 ~120px（header-center = 168 − 48 占位）：「今天 · 周二 · 6 节」实测裁掉「节」。
    // 星期名与 A 区高亮重复 → 去掉；溢出时连「今天」也省掉（120px 放不下 12 个全角字）。
    self.todayCount = cls.length;
    if (cls.length > MAX_ROWS * COLS) {
      self.dayLabel = "前" + MAX_ROWS * COLS + "/共" + cls.length + "节";
    } else {
      self.dayLabel = (self.dayCursor === todayIdx ? "今天 · " : ("周" + DAY_SHORT[self.dayCursor] + " · ")) + cls.length + " 节";
    }
    self.hasCourses = cls.length > 0;
    self.emptyHint = (self.dayCursor === todayIdx) ? "今天暂无课程" : ("周" + DAY_SHORT[self.dayCursor] + " 暂无课程");

    // A 星期条：7 格，当前日高亮
    var week = [];
    for (var i = 0; i < 7; i++) {
      week.push({ label: DAY_SHORT[i], current: i === self.dayCursor });
    }
    self.weekCells = week;

    // B 课表格：3 列 × 5 行；前 15 格（5 节）入格，其余计数提示
    var shown = cls.slice(0, MAX_ROWS * COLS);
    self.totalCount = cls.length;
    var rows = [];
    for (var r = 0; r < MAX_ROWS; r++) {
      var row = [];
      for (var c = 0; c < COLS; c++) {
        var item = shown[r * COLS + c];
        if (item) {
          row.push({
            name: item.name,
            color: subjectColor.getSubjectColor(item.name),
            startMin: parseMinutes(item.time),
            endMin: endMinutes(item.time),
            now: false
          });
        } else {
          row.push(null);
        }
      }
      rows.push(row);
    }
    self.gridCells = rows;
    self.computeNowFlag();
  },

  prevDay: function() {
    if (this.dayCursor > 0) { this.dayCursor -= 1; this.render(); }
  },

  nextDay: function() {
    if (this.dayCursor < 6) { this.dayCursor += 1; this.render(); }
  },

  backClick() {
    if (this.fromPanel === '1') {
      router.back();
    } else {
      // 面板被当独立首页（root）时无可退返回栈，直接回「更多首页」
      router.push({ uri: '/pages/schedule-panel' });
    }
  },

  onBackPress() {
    if (this.fromPanel === '1') return false;
    return utils.exitApp() === true;
  }
};
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; padding: 44px 12px 12px 12px }

/* 顶部返回热区 ≥120px（含星期条之前的所有内容） */
.back-header { flex-direction: row; align-items: center; height: 120px; margin-bottom: 8px; padding: 0 4px }
.back-btn-wrapper { width: 48px; height: 40px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 24px; height: 24px }
.header-center { flex: 1; flex-direction: column; align-items: center; justify-content: center }
.header-title { font-size: 24px; font-weight: bold; line-height: 32px; text-align: center }
.header-day { font-size: 18px; line-height: 22px; text-align: center; margin-top: 2px; lines: 1 }
.header-placeholder { width: 48px; height: 40px; flex-shrink: 0 }

/* 切天箭头：替代 @swipe 手势（drag 会被本引擎误判成点击 → 跳页）。
   几何是算出来的（2026-10-21 字号抬到 18 后重算）：
   星期条 7 格 ×18 + 箭头 2×20 = 166 ≤ 168，剩 2px 余量；
   高度 20→26 是为了装下 18px 字的 22 行高，否则箭头字形被裁。 */
.arrow-btn { width: 20px; height: 26px; border-radius: 5px; justify-content: center; align-items: center; flex-shrink: 0 }
.arrow-icon { font-size: 18px; line-height: 22px; text-align: center; font-weight: bold }

.empty-hint { flex: 1; align-items: center; justify-content: center; font-size: 22px; line-height: 30px; text-align: center }

/* A 星期条：130–158，7 格各 18px（7×18 + 2×20 箭头 = 166 ≤ 168） */
.week-strip { flex-direction: row; justify-content: space-between; align-items: center; height: 28px; flex-shrink: 0 }
.week-cell { width: 18px; height: 28px; justify-content: center; align-items: center }
.week-cell.is-current { border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #7ec8e3 }
.week-text { font-size: 18px; line-height: 22px; text-align: center }

/* B 课表格：3 列 × 5 行，格 52×56，列间距 6（3×52+2×6=168）。
   行高 56 是算出来的：页头 44+120+8=172 → 星期条 28 → 网格起点 200；5×64=320 会到 520 **超出 490**，
   5×56=280 到 480 ✔（开工卡写的 B 160–480 即此口径，实拍前算过才没翻车）。 */
.grid { flex-direction: column; flex-shrink: 0 }
.grid-row { flex-direction: row; justify-content: space-between; height: 56px; margin-bottom: 0 }
.grid-cell { width: 52px; height: 56px; border-radius: 8px; padding: 3px; justify-content: flex-start; align-items: center; box-sizing: border-box }
.grid-cell.is-now { border-width: 2px; border-style: solid; border-color: #7ec8e3 }
/* 格内课名：18/20，2 行 = 40 + padding 6 = 46 ≤ 格高 56；格宽 52 − padding 6 = 46，
   18px 汉字每行 2 字，4 字课名正好两行（再长由 ellipsis 收）。 */
.cell-name { font-size: 18px; line-height: 20px; text-align: center; lines: 2; text-overflow: ellipsis; width: 100% }


/* 宽屏 / 大屏断点：等比放大，比例不变 */
@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px }
  .header-title { font-size: 28px; line-height: 36px }
  .arrow-btn { width: 24px; height: 24px }
  .week-cell { width: 22px; height: 32px }
  .grid-cell { width: 60px; height: 64px }
  .cell-name { font-size: 20px; line-height: 22px }
}
</style>
