  flex-direction: column;
  padding: 44px 16px 16px 16px;
  background-color: #1a1a2e;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 20px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
  background-color: #16213e;
  color: #7ec8e3;
  flex-shrink: 0;
}

.title {
  font-size: 22px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  color: #ffffff;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 16px 0 8px 0;
}

.pin-link {
  text-align: center;
}

.item {
  flex-direction: row;
  align-items: center;
  background-color: #16213e;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.box {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  border-width: 2px;
  border-style: solid;
  border-color: #7ec8e3;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check {
  font-size: 24px;
  font-weight: bold;
}

.name {
  font-size: 20px;
  color: #ffffff;
  font-weight: bold;
  margin-left: 14px;
}

.hint {
  font-size: 14px;
  color: #888899;
  margin-top: 20px;
  text-align: center;
}

.premium-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.premium-card {
  width: 90%;
  border-radius: 16px;
  padding: 24px 20px;
  flex-direction: column;
  align-items: center;
}

.premium-icon {
  font-size: 32px;
  margin-bottom: 8px;
}

.premium-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 6px;
}

.premium-desc {
  font-size: 12px;
  text-align: center;
  margin-bottom: 12px;
  line-height: 18px;
}

.premium-benefits {
  width: 100%;
  flex-direction: column;
  margin-bottom: 14px;
}

.benefit {
  font-size: 12px;
  margin-bottom: 4px;
}

.unlock-btn {
  width: 100%;
  height: 36px;
  border-radius: 18px;
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 8px;
}

.cancel-btn {
  width: 100%;
  height: 30px;
  border-radius: 15px;
  font-size: 12px;
}
