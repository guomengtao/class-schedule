<template>
  <div class="page">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" />
      <text class="title">勾选 Demo</text>
    </div>

    <div for="{{ list }}" class="item" onclick="toggle($idx)">
      <div class="box" style="background-color: {{ $item.checked ? '#7ec8e3' : '#0f3460' }}">
        <text class="check" style="color: {{ $item.checked ? '#ffffff' : '#555566' }}">{{ $item.checked ? '✓' : '' }}</text>
      </div>
      <text class="name">{{ $item.name }}</text>
    </div>

    <text class="hint">当前选中: {{ selectedName }}</text>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: #555566; font-size: 13px;">📌 固定到首页</text>
    </div>

    <div class="premium-overlay" if="{{ !isPremiumUnlocked }}" style="background-color: rgba(0,0,0,0.6)">
      <div class="premium-card" style="background-color: {{ theme.card }}">
        <text class="premium-icon">👑</text>
        <text class="premium-title" style="color: {{ theme.accent }}">解锁高级功能</text>
        <text class="premium-desc" style="color: {{ theme.textSecondary }}">一次性解锁，永久使用全部高级功能</text>
        <div class="premium-benefits">
          <text class="benefit" style="color: {{ theme.text }}">✓ 多课表管理</text>
          <text class="benefit" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          <text class="benefit" style="color: {{ theme.text }}">✓ 首页自定义</text>
          <text class="benefit" style="color: {{ theme.text }}">✓ 10套主题</text>
        </div>
        <input class="unlock-btn" type="button" value="立即解锁" onclick="goToActivation"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="cancel-btn" type="button" value="继续使用标准版" onclick="goBack"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var pinHelper = require("../../data/pin-helper.js")

var TEST_FORCE_PREMIUM = false

export default {
  private: {
    list: [
      { name: "课程表 A", checked: true },
      { name: "课程表 B", checked: false },
      { name: "课程表 C", checked: false }
    ],
    selectedName: "课程表 A",
    isPremiumUnlocked: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    if (TEST_FORCE_PREMIUM !== null) {
      self.isPremiumUnlocked = TEST_FORCE_PREMIUM
      return
    }
    store.isPremiumUnlocked(function(unlocked) {
      self.isPremiumUnlocked = unlocked
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    if (TEST_FORCE_PREMIUM !== null) {
      self.isPremiumUnlocked = TEST_FORCE_PREMIUM
      return
    }
    store.isPremiumUnlocked(function(unlocked) {
      self.isPremiumUnlocked = unlocked
    })
  },

  toggle(idx) {
    console.log("[CHECK-DEMO] toggle idx=" + idx)
    for (var i = 0; i < this.list.length; i++) {
      this.list[i].checked = (i === idx)
    }
    this.selectedName = this.list[idx].name
  },

  goBack() {
    console.log("[CHECK-DEMO] goBack")
    router.back()
  },

  goToActivation() {
    router.push({ uri: "/pages/activation" })
  },

  pinToHome() {
    pinHelper.pinPage("勾选 Demo", "/pages/check-demo")
  }
}
</script>

<style>
