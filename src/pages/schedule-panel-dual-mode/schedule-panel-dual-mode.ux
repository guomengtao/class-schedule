<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div if="{{ !isRoot }}" class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">智能切换</text>
      <div if="{{ !isRoot }}" class="header-placeholder"></div>
    </div>

    <div if="{{ isLoading }}" class="loading-area">
      <text class="loading-text" style="color: {{ theme.textMuted }}">加载中...</text>
    </div>

    <div if="{{ !isLoading }}" class="content-area">
      <div class="mode-tag" style="background-color: {{ theme.accent }}20">
        <text class="mode-tag-text" style="color: {{ theme.accent }}">{{ modeLabel }}</text>
      </div>

      <div if="{{ mode === 'in-class' }}" class="progress-card" style="background-color: {{ theme.card }}">
        <text class="prog-name" style="color: {{ theme.text }}">{{ currentClass.name }}</text>
        <text class="prog-time" style="color: {{ theme.textSecondary }}">{{ currentClass.time }}</text>

        <div class="progress-bar-bg" style="background-color: {{ theme.border }}">
          <div class="progress-bar-fill" style="width: {{ progressPercent }}%; background-color: {{ theme.accent }}"></div>
        </div>

        <div class="progress-labels">
          <text class="prog-label" style="color: {{ theme.textSecondary }}">已过 {{ elapsedMinutes }} 分钟</text>
          <text class="prog-label" style="color: {{ theme.accent }}">剩余 {{ remainingMinutes }} 分钟</text>
        </div>
      </div>

      <div if="{{ mode === 'break' }}" class="countdown-card">
        <text class="cd-label" style="color: {{ theme.textSecondary }}">距下节课</text>
        <text class="cd-time" style="color: {{ theme.accent }}">{{ displayTime }}</text>
        <div class="cd-next" style="background-color: {{ theme.card }}">
          <text class="cd-next-name" style="color: {{ theme.text }}">{{ nextClass.name }}</text>
          <text class="cd-next-time" style="color: {{ theme.textSecondary }}">{{ nextClass.time }}</text>
        </div>
      </div>

      <div if="{{ mode === 'done' }}" class="done-area">
        <text class="done-icon">🎉</text>
        <text class="done-text" style="color: {{ theme.textSecondary }}">{{ doneMessage }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")
const utils = require("../../data/utils.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

function parseTimeRange(timeStr) {
  if (!timeStr) return null
  var parts = timeStr.split(" - ")
  if (parts.length !== 2) return null
  var s1 = parts[0].trim().split(":")
  var s2 = parts[1].trim().split(":")
  if (s1.length !== 2 || s2.length !== 2) return null
  return { startMin: parseInt(s1[0]) * 60 + parseInt(s1[1]), endMin: parseInt(s2[0]) * 60 + parseInt(s2[1]) }
}

function pad(n) { return n < 10 ? "0" + n : String(n) }

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    isLoading: true,
    mode: "break",
    modeLabel: "课间 · 倒计时",
    currentClass: null,
    nextClass: null,
    progressPercent: 0,
    elapsedMinutes: 0,
    remainingMinutes: 0,
    displayTime: "--:--",
    doneMessage: "今日课程已全部结束",
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    // 独立首页 root 判定：由「更多首页」push 时带 fromPanel='1'；无参数即被设为首页冷启动
    self.fromPanel = (self.fromPanel === '1') ? '1' : ''
    self.isRoot = self.fromPanel !== '1'
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    self.loadData()
    self.timer = setInterval(function() { self.tick() }, 10000)
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        var todayIndex = new Date().getDay()
        var todayName = DAY_NAMES[todayIndex]
        var todayDay = null
        for (var i = 0; i < schedule.length; i++) {
          if (schedule[i].day === todayName) { todayDay = schedule[i]; break }
        }
        self.todayClasses = (todayDay && todayDay.classes) ? todayDay.classes.slice() : []
        self.isLoading = false
        self.tick()
      })
    })
  },

  tick: function() {
    var self = this
    var now = new Date()
    var nowMin = now.getHours() * 60 + now.getMinutes()
    var classes = self.todayClasses || []

    for (var i = 0; i < classes.length; i++) {
      var range = parseTimeRange(classes[i].time)
      if (!range) continue
      if (nowMin >= range.startMin && nowMin < range.endMin) {
        self.mode = "in-class"
        self.modeLabel = "上课中 · 进度"
        self.currentClass = classes[i]
        var total = range.endMin - range.startMin
        var elapsed = nowMin - range.startMin
        self.progressPercent = Math.min(100, Math.round(elapsed / total * 100))
        self.elapsedMinutes = elapsed
        self.remainingMinutes = range.endMin - nowMin
        return
      }
    }

    self.mode = "break"
    self.modeLabel = "课间 · 倒计时"
    self.currentClass = null
    self.nextClass = null

    for (var j = 0; j < classes.length; j++) {
      var r = parseTimeRange(classes[j].time)
      if (r && r.startMin > nowMin) {
        if (!self.nextClass || r.startMin < parseTimeRange(self.nextClass.time).startMin) {
          self.nextClass = classes[j]
        }
      }
    }

    if (self.nextClass) {
      var nr = parseTimeRange(self.nextClass.time)
      var wait = nr.startMin - nowMin
      self.displayTime = pad(Math.floor(wait / 60)) + ":" + pad(wait % 60)
    } else if (classes.length > 0) {
      self.mode = "done"
      self.doneMessage = "今日课程已全部结束"
    } else {
      self.mode = "done"
      self.doneMessage = "今天没有课"
    }
  },

  goBack() {
    // 双模返回：被「更多首页」push（fromPanel）→ 回父页；作为 root 首页 → 退出应用
    if (this.fromPanel === '1') {
      router.back()
    } else {
      utils.exitApp()
    }
  },

  onBackPress() {
    // 硬件返回键：push 态交还系统默认返回（回更多首页）；root 态退出（与默认首页 index 一致）
    if (this.fromPanel === '1') return false
    return utils.exitApp() === true
  },

  onDestroy() {
    if (this.timer) { clearInterval(this.timer); this.timer = null }
  }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; padding: 44px 12px 12px 12px }

.back-header { flex-direction: row; align-items: center; margin-bottom: 16px; padding: 0 4px }
.back-btn-wrapper { width: 48px; height: 40px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 24px; height: 24px }
.header-title { flex: 1; font-size: 28px; font-weight: bold; text-align: center; line-height: 38px }
.header-placeholder { width: 48px; height: 48px; flex-shrink: 0 }

.loading-area { align-items: center; padding: 30px 0 }
.loading-text { font-size: 22px; line-height: 30px }

.content-area { flex: 1; flex-direction: column; padding: 0 4px }

.mode-tag { align-self: center; border-radius: 10px; padding: 6px 18px; margin-bottom: 18px }
.mode-tag-text { font-size: 18px; line-height: 26px; font-weight: bold }

/* 独立首页化修正：左右 padding 20→12px，给 22px 字号「10:00 - 10:45」留足一行宽度 */
.progress-card { flex-direction: column; border-radius: 18px; padding: 24px 12px }
.prog-name { font-size: 30px; font-weight: bold; line-height: 38px; margin-bottom: 4px }
.prog-time { font-size: 22px; line-height: 30px; margin-bottom: 18px }

.progress-bar-bg { height: 14px; border-radius: 7px; margin-bottom: 10px; overflow: hidden }
.progress-bar-fill { height: 14px; border-radius: 7px }
/* 独立首页化修正：「已过 X 分钟」+「剩余 Y 分钟」左右排合计约 244px，144px 卡内溢出截断
   （实测只见「已过 2 剩余」），改纵向堆叠两行完整显示 */
.progress-labels { flex-direction: column }
.prog-label { font-size: 20px; line-height: 28px }

.countdown-card { flex: 1; flex-direction: column; justify-content: center; align-items: center }
.cd-label { font-size: 22px; line-height: 30px; margin-bottom: 8px }
.cd-time { font-size: 72px; font-weight: bold; line-height: 80px; font-family: monospace; margin-bottom: 24px }
.cd-next { flex-direction: column; align-items: center; padding: 16px 24px; border-radius: 14px }
.cd-next-name { font-size: 26px; font-weight: bold; line-height: 34px; margin-bottom: 4px }
.cd-next-time { font-size: 20px; line-height: 28px }

.done-area { flex: 1; flex-direction: column; justify-content: center; align-items: center }
.done-icon { font-size: 56px; margin-bottom: 14px }
.done-text { font-size: 24px; line-height: 32px; text-align: center }

@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px }
  .progress-card { padding: 28px 24px; border-radius: 20px }
  .prog-name { font-size: 34px; line-height: 42px }
  .cd-time { font-size: 96px; line-height: 104px }
  .cd-next-name { font-size: 28px; line-height: 36px }
}

@media (width >= 400px) {
  .page { padding: 12px 20px 16px 20px }
  .cd-time { font-size: 120px; line-height: 128px }
}
</style>