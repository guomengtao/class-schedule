<template>
  <div class="test-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" 
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">提醒测试</text>
    </div>

    <text class="desc" style="color: {{ theme.textMuted }}">
      测试系统闹钟/日历提醒是否可用
    </text>

    <div class="selector" style="background-color: {{ theme.card }}">
      <text class="selector-label" style="color: {{ theme.text }}">提醒时间</text>
      <div class="selector-control">
        <input class="selector-btn" type="button" value="-" onclick="decreaseTime" 
               style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        <text class="selector-value" style="color: {{ theme.accent }}">{{ testMinutes }} 分钟后</text>
        <input class="selector-btn" type="button" value="+" onclick="increaseTime" 
               style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
      </div>
    </div>

    <div class="test-buttons">
      <div class="test-card" onclick="testAlarm" style="background-color: {{ theme.card }}">
        <text class="test-icon">🔔</text>
        <text class="test-title" style="color: {{ theme.text }}">测试闹钟</text>
        <text class="test-desc" style="color: {{ theme.textMuted }}">使用 @system.alarm</text>
        <text class="test-hint" style="color: {{ theme.textMuted }}">{{ testMinutes }}分钟后震动提醒</text>
      </div>

      <div class="test-card" onclick="testCalendar" style="background-color: {{ theme.card }}">
        <text class="test-icon">📅</text>
        <text class="test-title" style="color: {{ theme.text }}">测试日历</text>
        <text class="test-desc" style="color: {{ theme.textMuted }}">使用 @system.calendar</text>
        <text class="test-hint" style="color: {{ theme.textMuted }}">{{ testMinutes }}分钟后事件提醒</text>
      </div>
    </div>

    <div class="status" if="{{ lastResult }}" style="background-color: {{ theme.cardLight }}">
      <text class="status-text" style="color: {{ lastResultSuccess ? theme.accent : '#ff6b6b' }}">
        {{ lastResult }}
      </text>
    </div>

    <text class="footer-hint" style="color: {{ theme.textMuted }}">
      测试成功后，手环会在设置时间后震动提醒
    </text>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")

var alarm = null
var calendar = null

try {
  alarm = require("@system.alarm")
} catch (e) {
  console.warn("[TEST] alarm module not available")
}

try {
  calendar = require("@system.calendar")
} catch (e) {
  console.warn("[TEST] calendar module not available")
}

export default {
  private: {
    theme: {},
    testMinutes: 3,
    lastResult: "",
    lastResultSuccess: false
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    console.log("[TEST] alarm:", alarm)
    console.log("[TEST] calendar:", calendar)
  },

  increaseTime() {
    if (this.testMinutes < 30) {
      this.testMinutes++
    }
  },

  decreaseTime() {
    if (this.testMinutes > 1) {
      this.testMinutes--
    }
  },

  getRemindTime() {
    var now = new Date()
    var target = new Date(now.getTime() + this.testMinutes * 60 * 1000)
    return {
      hour: target.getHours(),
      minute: target.getMinutes(),
      timestamp: target.getTime(),
      timeStr: this.padZero(target.getHours()) + ":" + this.padZero(target.getMinutes())
    }
  },

  padZero(n) {
    return n < 10 ? "0" + n : String(n)
  },

  testAlarm() {
    var self = this
    var time = this.getRemindTime()

    if (!alarm) {
      this.setResult("@system.alarm 模块不可用", false)
      return
    }

    prompt.showToast({
      message: "设置闹钟...",
      duration: 500
    })

    alarm.setAlarm({
      hour: time.hour,
      minute: time.minute,
      message: "课程提醒测试",
      vibrate: true,
      success: function() {
        var msg = "闹钟已设置！" + time.timeStr + " 将震动提醒"
        self.setResult(msg, true)
        prompt.showToast({ message: "闹钟设置成功", duration: 1000 })
        console.log("[TEST] alarm set success")
      },
      fail: function(data, code) {
        var msg = "闹钟设置失败，错误码: " + code
        self.setResult(msg, false)
        prompt.showToast({ message: "设置失败，请检查权限", duration: 1500 })
        console.log("[TEST] alarm set failed:", code, data)
      }
    })
  },

  testCalendar() {
    var self = this
    var time = this.getRemindTime()

    if (!calendar) {
      this.setResult("@system.calendar 模块不可用", false)
      return
    }

    prompt.showToast({
      message: "创建日历事件...",
      duration: 500
    })

    var now = new Date()
    var startDate = new Date(now.getTime() + this.testMinutes * 60 * 1000)
    var endDate = new Date(startDate.getTime() + 5 * 60 * 1000)

    calendar.insert({
      title: "课程提醒测试",
      description: "测试日历提醒功能",
      startDate: startDate.getTime(),
      endDate: endDate.getTime(),
      remindMinutes: [0],
      success: function(id) {
        var msg = "日历事件已创建！" + time.timeStr + " 将震动提醒 (ID:" + id + ")"
        self.setResult(msg, true)
        prompt.showToast({ message: "日历事件创建成功", duration: 1000 })
        console.log("[TEST] calendar insert success, id:", id)
      },
      fail: function(data, code) {
        var msg = "日历事件创建失败，错误码: " + code
        self.setResult(msg, false)
        prompt.showToast({ message: "创建失败，请检查权限", duration: 1500 })
        console.log("[TEST] calendar insert failed:", code, data)
      }
    })
  },

  setResult(msg, success) {
    this.lastResult = msg
    this.lastResultSuccess = success
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.test-page {
  flex-direction: column;
  padding: 12px 16px;
  height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  height: 44px;
  margin-bottom: 8px;
}

.back-btn {
  width: 44px;
  height: 36px;
  border-radius: 8px;
  font-size: 16px;
  text-align: center;
}

.header-title {
  font-size: 20px;
  font-weight: bold;
  margin-left: 12px;
}

.desc {
  font-size: 13px;
  margin-bottom: 12px;
  text-align: center;
}

.selector {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 12px;
  padding: 12px 16px;
  margin-bottom: 12px;
}

.selector-label {
  font-size: 15px;
}

.selector-control {
  flex-direction: row;
  align-items: center;
}

.selector-btn {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
}

.selector-value {
  font-size: 18px;
  font-weight: bold;
  width: 80px;
  text-align: center;
}

.test-buttons {
  flex-direction: column;
}

.test-card {
  flex-direction: column;
  align-items: center;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 10px;
  border-left-width: 4px;
  border-left-color: #7ec8e3;
  border-left-style: solid;
}

.test-icon {
  font-size: 32px;
  margin-bottom: 4px;
}

.test-title {
  font-size: 18px;
  font-weight: bold;
}

.test-desc {
  font-size: 13px;
  margin-top: 2px;
}

.test-hint {
  font-size: 12px;
  margin-top: 6px;
}

.status {
  border-radius: 10px;
  padding: 10px 14px;
  margin-top: 8px;
}

.status-text {
  font-size: 13px;
}

.footer-hint {
  font-size: 12px;
  text-align: center;
  margin-top: 12px;
}
</style>