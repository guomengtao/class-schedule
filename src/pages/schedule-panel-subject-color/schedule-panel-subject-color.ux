<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <!-- 条件渲染一律 display 绑定（事故案例 11：多兄弟节点 if 会整页白屏） -->
      <div class="back-btn-wrapper" style="display: {{ isRoot ? 'none' : 'flex' }}; background-color: {{ theme.card }}" onclick="goBack">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.textSecondary }}">色卡</text>
      <div class="header-placeholder" style="display: {{ isRoot ? 'none' : 'flex' }}"></div>
    </div>

    <!-- A 当前科目：10px 色条 + 课名。色条是「这一格什么颜色」的唯一载体，不是装饰。
         课名字号随字数在两档之间切：2 字用 44（117px），3~4 字降到 28（112/149px）。
         可用宽 168 − 10(色条) − 8(间距) = 150，44px 只放得下 2 字，这是硬账。 -->
    <div class="now-row">
      <div class="now-stripe" style="background-color: {{ nowColor }}"></div>
      <text class="now-name" style="font-size: {{ nowFont }}px; color: {{ nowActive ? theme.accent : theme.textSecondary }}">{{ nowName }}</text>
    </div>

    <!-- B 今日科目色卡网格：2 列 × 3 行，每格 80×72。格内 72px 宽，24px 一行 2 字，
         3 字以上靠 lines:2 折行兜底——不省略，宁可两行也不丢字。 -->
    <div class="grid">
      <div for="{{ gridRows }}" class="grid-row">
        <div for="{{ $item.cells }}" class="cell" style="background-color: {{ $item.color }}">
          <text class="cell-name">{{ $item.name }}</text>
        </div>
      </div>
    </div>

    <!-- C 图例：只报总数。超过 6 科时改口径说「N 科 只列 6」，不用点号拼接 -->
    <text class="legend" style="color: {{ theme.textSecondary }}">{{ legendText }}</text>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")
const utils = require("../../data/utils.js")
const builtinSchedule = require("../../data/schedule.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

// P2 阶段固定配色表：同一科跨天同色。
// ⚠️ 已知问题（不在本次范围）：这张是本页私有的旧表，与共享表 src/data/subject-color.js 已经漂移
//    （例：语文本页 #2ecc71 绿、共享表 #e74c3c 红；体育 #8bc34a / #2ecc71；信息系 #2980b9 / #0984e3）。
//    后果是同一个「语文」在色卡页和多彩课表页显示成两种颜色。收敛方案：改 require 共享表，
//    代价是 4 个科目变色、多彩课表页要一起回归，故单独立项处理。
var SUBJECT_COLORS = {
  "数学": "#3498db",
  "语文": "#2ecc71",
  "英语": "#e67e22",
  "物理": "#9b59b6",
  "化学": "#e74c3c",
  "生物": "#27ae60",
  "历史": "#f39c12",
  "地理": "#1abc9c",
  "政治": "#c0392b",
  "计算机": "#2980b9",
  "信息技术": "#2980b9",
  "音乐": "#e91e63",
  "美术": "#ff5722",
  "体育": "#8bc34a"
}
var FALLBACK_COLOR = "#7f8c8d"

// 2 字课名走 44（四档最大），3 字以上降到 28——168px 一行放不下 3 个 44px 汉字
var NAME_FONT_BIG = 44
var NAME_FONT_SMALL = 28

// 子串匹配（"信息技术" 命中 "信息技术"，"体育课" 命中 "体育"）；未命中回退灰，绝不返回空
function getSubjectColor(name) {
  if (!name) return FALLBACK_COLOR
  for (var key in SUBJECT_COLORS) {
    if (name.indexOf(key) !== -1) return SUBJECT_COLORS[key]
  }
  return FALLBACK_COLOR
}

// "08:00 - 09:35" 解析成 {startMin, endMin}；脏数据返回 null
function parseTimeRange(timeStr) {
  if (!timeStr) return null
  var parts = timeStr.split(" - ")
  if (parts.length !== 2) return null
  var s1 = parts[0].trim().split(":")
  var s2 = parts[1].trim().split(":")
  if (s1.length !== 2 || s2.length !== 2) return null
  var a = parseInt(s1[0]) * 60 + parseInt(s1[1])
  var b = parseInt(s2[0]) * 60 + parseInt(s2[1])
  if (isNaN(a) || isNaN(b) || b <= a) return null
  return { startMin: a, endMin: b }
}

function fontOf(name) {
  var n = (name || "").length
  return n <= 2 ? NAME_FONT_BIG : NAME_FONT_SMALL
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    isLoading: true,
    nowName: "",
    nowColor: FALLBACK_COLOR,
    nowActive: false,
    nowFont: NAME_FONT_BIG,
    gridRows: [],
    legendText: "",
    schedule: [],
    tickTimer: null,
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    // 独立首页 root 判定：由「更多首页」push 带 fromPanel='1'；无参数即冷启动为首页
    self.fromPanel = (self.fromPanel === '1') ? '1' : ''
    self.isRoot = self.fromPanel !== '1'
    // 首帧同步出内容：storage 回调慢/丢也不许停在「加载中」
    self.apply((builtinSchedule && builtinSchedule.schedule) ? builtinSchedule.schedule : [])
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
      self.loadData()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    // 回前台立即重算（后台期间可能已换课），再续排下一次整分
    if (!self.isLoading) self.tick()
  },

  onHide() {
    this.clearTickTimer()
  },

  /* 分钟级刷新：只挂一个对齐「下一个整分」的 setTimeout（方案 §0 禁秒级轮询） */
  scheduleNextMinute: function() {
    var self = this
    this.clearTickTimer()
    var now = new Date()
    var ms = 60000 - (now.getSeconds() * 1000)
    if (ms < 1000) ms = 1000
    this.tickTimer = setTimeout(function() { self.tick() }, ms)
  },

  clearTickTimer: function() {
    if (this.tickTimer) { clearTimeout(this.tickTimer); this.tickTimer = null }
  },

  apply: function(schedule) {
    this.schedule = schedule || []
    this.isLoading = false
    this.tick()
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.apply(schedule || [])
      })
    })
  },

  classesOf: function(dayName) {
    var schedule = this.schedule || []
    for (var i = 0; i < schedule.length; i++) {
      if (schedule[i].day === dayName) return schedule[i].classes || []
    }
    return []
  },

  tick: function() {
    try {
      this.compute()
    } catch (e) {
      // 算炸了退回空态，不许把页面钉在旧读数上
      this.nowName = "没课"
      this.nowColor = FALLBACK_COLOR
      this.nowActive = false
      this.nowFont = NAME_FONT_BIG
      this.gridRows = []
      this.legendText = ""
      console.error("[subject-color] compute failed: " + e)
    }
    this.scheduleNextMinute()
  },

  compute: function() {
    var now = new Date()
    var nowMin = now.getHours() * 60 + now.getMinutes()
    var raw = this.classesOf(DAY_NAMES[now.getDay()])

    var items = []
    for (var i = 0; i < raw.length; i++) {
      var r = parseTimeRange(raw[i].time)
      if (!r) continue
      items.push({
        name: raw[i].name,
        time: raw[i].time,
        startMin: r.startMin,
        endMin: r.endMin,
        color: getSubjectColor(raw[i].name)
      })
    }
    items.sort(function(a, b) { return a.startMin - b.startMin })

    // A 当前科目：正在上的那节；否则退「课间」/「已下课」/「没课」（≤3 字）
    var current = null
    for (var k = 0; k < items.length; k++) {
      if (nowMin >= items[k].startMin && nowMin < items[k].endMin) { current = items[k]; break }
    }
    // 三态区分（实拍发现：全天课上完后仍显示「课间」是错的）
    var hasFuture = false
    for (var n = 0; n < items.length; n++) {
      if (items[n].startMin > nowMin) { hasFuture = true; break }
    }
    if (current) {
      this.nowName = current.name
      this.nowColor = current.color
      this.nowActive = true
    } else {
      // 没课（今天无安排）/ 课间（后面还有课）/ 已下课（今天的都上完了）
      this.nowName = items.length === 0 ? "没课" : (hasFuture ? "课间" : "已下课")
      this.nowColor = FALLBACK_COLOR
      this.nowActive = false
    }
    this.nowFont = fontOf(this.nowName)

    // B 今日科目（去重，按当天首次出现顺序），最多 6 格 = 2×3
    var subjects = []
    var seen = {}
    for (var m = 0; m < items.length; m++) {
      var nm = items[m].name
      if (seen[nm]) continue
      seen[nm] = 1
      subjects.push({ name: nm, color: items[m].color })
    }
    var shown = subjects.slice(0, 6)
    var rows = []
    for (var r2 = 0; r2 < shown.length; r2 += 2) {
      rows.push({ cells: shown.slice(r2, r2 + 2) })
    }
    this.gridRows = rows

    // C 图例：只说总数；超 6 科时把「只列 6」明说，不用点号拼接
    if (subjects.length === 0) {
      this.legendText = "今天没课"
    } else if (subjects.length > 6) {
      this.legendText = subjects.length + " 科 只列 6"
    } else {
      this.legendText = "今天 " + subjects.length + " 科"
    }
  },

  goBack: function() {
    // 双模返回：被「更多首页」push（fromPanel）则回父页；作为 root 首页则回「更多首页」
    if (this.fromPanel === '1') {
      router.back()
    } else {
      // 面板被当独立首页（root）时无可退返回栈，直接回「更多首页」
      router.push({ uri: '/pages/schedule-panel' })
    }
  },

  onBackPress: function() {
    // 硬件返回键：push 态交还系统默认返回；root 态退出（与 index 一致）
    if (this.fromPanel === '1') return false
    return utils.exitApp() === true
  },

  onDestroy: function() {
    this.clearTickTimer()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 12px 12px 12px;
}
.back-header {
  flex-direction: row;
  align-items: center;
  height: 40px;
  flex-shrink: 0;
}
.back-btn-wrapper {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.back-btn-icon {
  width: 22px;
  height: 22px;
}
.header-title {
  flex: 1;
  font-size: 28px;
  text-align: center;
  line-height: 36px;
  lines: 1;
}
.header-placeholder {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
}

/* A 当前科目：色条 10×40 + 课名。字号由 nowFont 绑进 inline style（44 / 28 两档） */
.now-row {
  margin-top: 12px;
  height: 56px;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}
.now-stripe {
  width: 10px;
  height: 40px;
  border-radius: 5px;
  margin-right: 8px;
  flex-shrink: 0;
}
.now-name {
  flex: 1;
  font-size: 44px;
  font-weight: bold;
  line-height: 56px;
  lines: 1;
}

/* B 网格：12 + 3×72 + 2×8 = 240，整页内容底 432 */
.grid {
  margin-top: 12px;
  flex-direction: column;
  flex-shrink: 0;
}
.grid-row {
  flex-direction: row;
  justify-content: space-between;
  width: 168px;
  height: 72px;
  margin-bottom: 8px;
  flex-shrink: 0;
}
/* 格宽 80（方案原写 84：2×84=168 再加间距必然溢出 168 内容宽，实测改为 80） */
.cell {
  width: 80px;
  height: 72px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  padding: 0 4px;
}
/* 格内可用宽 72px = 2 个 24px 汉字；3 字以上折行（lines:2，26×2=52 ≤ 72−8），不省略号 */
.cell-name {
  font-size: 24px;
  line-height: 26px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  lines: 2;
}

/* C 图例：8 + 24 = 32，收在 432 */
.legend {
  margin-top: 8px;
  font-size: 24px;
  line-height: 32px;
  text-align: center;
  flex-shrink: 0;
  lines: 1;
}

@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px; }
  .header-title { font-size: 28px; line-height: 36px; }
  .now-row { height: 60px; }
  .now-stripe { width: 12px; height: 44px; }
  .now-name { line-height: 60px; }
  .grid-row { width: 176px; height: 78px; margin-bottom: 9px; }
  .cell { width: 84px; height: 78px; }
  .cell-name { font-size: 24px; line-height: 28px; }
  .legend { font-size: 24px; line-height: 34px; }
}

@media (width >= 400px) {
  .page { padding: 12px 20px 16px 20px; }
  .header-title { font-size: 28px; line-height: 38px; }
  .now-row { margin-top: 20px; height: 90px; }
  .now-stripe { width: 18px; height: 68px; border-radius: 9px; }
  .now-name { line-height: 90px; }
  .grid { margin-top: 24px; }
  .grid-row { width: 320px; height: 110px; margin-bottom: 12px; }
  .cell { width: 154px; height: 110px; border-radius: 16px; }
  .cell-name { font-size: 28px; line-height: 36px; }
  .legend { font-size: 28px; line-height: 38px; }
}
</style>
