<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="page-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div if="{{ !isRoot }}" class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">科目色卡</text>
      <div if="{{ !isRoot }}" class="header-placeholder"></div>
    </div>

    <div if="{{ isLoading }}" class="loading-area">
      <text class="loading-text" style="color: {{ theme.textMuted }}">加载中...</text>
    </div>

    <div if="{{ !isLoading && todayClasses.length === 0 }}" class="empty-area">
      <text class="empty-text" style="color: {{ theme.textMuted }}">今天没有课</text>
    </div>

    <div for="{{ todayClasses }}" class="course-card" style="background-color: {{ theme.card }}">
      <div class="color-stripe" style="background-color: {{ $item.subjectColor }}"></div>
      <div class="card-body">
        <text class="card-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <text class="card-time" style="color: {{ theme.textSecondary }}">{{ $item.time }}</text>
        <text class="card-location" if="{{ $item.location }}" style="color: {{ theme.textMuted }}">{{ $item.location }}</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")
const utils = require("../../data/utils.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

var SUBJECT_COLORS = {
  "数学": "#3498db",
  "语文": "#2ecc71",
  "英语": "#e67e22",
  "物理": "#9b59b6",
  "化学": "#e74c3c",
  "生物": "#27ae60",
  "历史": "#f39c12",
  "地理": "#1abc9c",
  "政治": "#c0392b",
  "计算机": "#2980b9",
  "信息技术": "#2980b9",
  "音乐": "#e91e63",
  "美术": "#ff5722",
  "体育": "#8bc34a"
}

function getSubjectColor(name) {
  if (!name) return "#7f8c8d"
  for (var key in SUBJECT_COLORS) {
    if (name.indexOf(key) !== -1) return SUBJECT_COLORS[key]
  }
  return "#7f8c8d"
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    isLoading: true,
    todayClasses: [],
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    // 独立首页 root 判定：由「更多首页」push 时带 fromPanel='1'；无参数即被设为首页冷启动
    self.fromPanel = (self.fromPanel === '1') ? '1' : ''
    self.isRoot = self.fromPanel !== '1'
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    self.loadData()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        var todayIndex = new Date().getDay()
        var todayName = DAY_NAMES[todayIndex]
        var todayDay = null
        for (var i = 0; i < schedule.length; i++) {
          if (schedule[i].day === todayName) { todayDay = schedule[i]; break }
        }
        var classes = (todayDay && todayDay.classes) ? todayDay.classes.slice() : []
        for (var j = 0; j < classes.length; j++) {
          classes[j].subjectColor = getSubjectColor(classes[j].name)
        }
        self.todayClasses = classes
        self.isLoading = false
      })
    })
  },

  goBack() {
    // 双模返回：被「更多首页」push（fromPanel）→ 回父页；作为 root 首页 → 退出应用
    if (this.fromPanel === '1') {
      router.back()
    } else {
      utils.exitApp()
    }
  },

  onBackPress() {
    // 硬件返回键：push 态交还系统默认返回（回更多首页）；root 态退出（与默认首页 index 一致）
    if (this.fromPanel === '1') return false
    return utils.exitApp() === true
  }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100% }
.page-scroll { flex: 1; width: 100%; flex-direction: column }
.page-body { flex-direction: column; width: 100%; padding: 44px 12px 12px 12px }

.back-header { flex-direction: row; align-items: center; margin-bottom: 16px; padding: 0 4px }
.back-btn-wrapper { width: 48px; height: 40px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 24px; height: 24px }
.header-title { flex: 1; font-size: 28px; font-weight: bold; text-align: center; line-height: 38px }
.header-placeholder { width: 48px; height: 48px; flex-shrink: 0 }

.loading-area { align-items: center; padding: 30px 0 }
.loading-text { font-size: 22px; line-height: 30px }

.empty-area { align-items: center; padding: 30px 0 }
.empty-text { font-size: 22px; line-height: 30px }

/* 独立首页化修正：底色原硬编码 rgba(255,255,255,0.05)，浅色主题下白叠加隐形；
   改模板行内 theme.card（见 template），此处仅保留形状属性 */
.course-card { flex-direction: row; border-radius: 14px; margin-bottom: 10px; overflow: hidden }
.color-stripe { width: 8px; flex-shrink: 0 }
.card-body { flex: 1; flex-direction: column; padding: 16px 14px }
.card-name { font-size: 26px; font-weight: bold; line-height: 34px; margin-bottom: 4px }
.card-time { font-size: 20px; line-height: 28px }
.card-location { font-size: 18px; line-height: 26px; margin-top: 2px }

@media (width >= 200px) {
  .page-body { padding: 44px 16px 14px 16px }
  .course-card { border-radius: 16px; margin-bottom: 12px }
  .color-stripe { width: 10px }
  .card-body { padding: 20px 16px }
  .card-name { font-size: 28px; line-height: 36px }
  .card-time { font-size: 22px; line-height: 30px }
}
</style>