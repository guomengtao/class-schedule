<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <!-- Header: CSS classes from @import '../../common/header.css' -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">Header Demo 1</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- Content -->
    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.accent }}">CSS方案测试页 #1</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">
        本页头部样式来自 @import 'common/header.css'
      </text>
    </div>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">验证要点</text>
      <div class="check-item">
        <text class="check-label" style="color: {{ theme.textSecondary }}">头部背景色：</text>
        <text class="check-value" style="color: {{ theme.accent }}">应与页面背景一致</text>
      </div>
      <div class="check-item">
        <text class="check-label" style="color: {{ theme.textSecondary }}">返回按钮：</text>
        <text class="check-value" style="color: {{ theme.accent }}">◀ 左对齐，可点击</text>
      </div>
      <div class="check-item">
        <text class="check-label" style="color: {{ theme.textSecondary }}">标题文字：</text>
        <text class="check-value" style="color: {{ theme.accent }}">"Header Demo 1" 居中显示</text>
      </div>
      <div class="check-item">
        <text class="check-label" style="color: {{ theme.textSecondary }}">屏型适配：</text>
        <text class="check-value" style="color: {{ theme.accent }}">胶囊/方形/圆形 自动适配字号</text>
      </div>
    </div>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">与 Demo 2 对比</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">
        点击下方按钮跳转到 Header Demo 2，两个页面共用同一套 header.css，头部样式应完全一致。
      </text>
    </div>

    <input class="nav-btn" type="button" value="前往 Header Demo 2 ›" onclick="goDemo2"
           style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

    <text class="footer-note" style="color: {{ theme.textMuted }}">
      这是方案一的页面文件 1/2
    </text>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goBack() {
    router.back()
  },

  goDemo2() {
    router.push({ uri: "/pages/header-demo2" })
  }
}
</script>

