<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">Scroll 滚动视图 Demo</text>
    </div>

    <scroll class="page-scroll" scroll-y="true">
      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.accent }}">scroll-snap-type & scroll-snap-align</text>
        <text class="section-desc" style="color: {{ theme.textSecondary }}">横向滚动吸附，A-H 卡片吸附到 start/center/end</text>
        <div class="scroll-wrap">
          <scroll class="snap-box" scroll-x="true" style="scroll-snap-type: x proximity;">
            <text class="snap-item color-1">A</text>
            <text class="snap-item color-2">B</text>
            <text class="snap-item color-1" style="scroll-snap-align: start;">C</text>
            <text class="snap-item color-2">D</text>
            <text class="snap-item color-1" style="scroll-snap-align: center;">E</text>
            <text class="snap-item color-2">F</text>
            <text class="snap-item color-1" style="scroll-snap-align: end;">G</text>
            <text class="snap-item color-2">H</text>
          </scroll>
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.accent }}">scroll-snap-stop: always</text>
        <text class="section-desc" style="color: {{ theme.textSecondary }}">不能跨越元素吸附，每个 center 对齐的卡片都会停住</text>
        <div class="scroll-wrap">
          <scroll class="snap-box" scroll-x="true" style="scroll-snap-type: x cross; scroll-snap-stop: always;">
            <text class="snap-item color-1">A</text>
            <text class="snap-item color-2" style="scroll-snap-align: center;">B</text>
            <text class="snap-item color-1" style="scroll-snap-align: center;">C</text>
            <text class="snap-item color-2" style="scroll-snap-align: center;">D</text>
            <text class="snap-item color-1" style="scroll-snap-align: center;">E</text>
            <text class="snap-item color-2" style="scroll-snap-align: center;">F</text>
            <text class="snap-item color-1">G</text>
          </scroll>
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.accent }}">竖向滚动 + 事件监听</text>
        <text class="section-desc" style="color: {{ theme.textSecondary }}">滚动到顶部/底部触发事件，scroll 事件实时显示位置</text>
        <scroll id="scrollVertical" class="v-scroll-box" scroll-y="true"
                onscrolltop="handleScrollTop" onscrollbottom="handleScrollBottom"
                onscroll="handleScroll">
          <div class="v-item" style="background-color: {{ theme.cardLight }}">
            <text class="v-item-text" style="color: {{ theme.text }}">北京</text>
          </div>
          <div class="v-item" style="background-color: {{ theme.cardLight }}">
            <text class="v-item-text" style="color: {{ theme.text }}">上海</text>
          </div>
          <div class="v-item" style="background-color: {{ theme.cardLight }}">
            <text class="v-item-text" style="color: {{ theme.text }}">广州</text>
          </div>
          <div class="v-item" style="background-color: {{ theme.cardLight }}">
            <text class="v-item-text" style="color: {{ theme.text }}">深圳</text>
          </div>
          <div class="v-item" style="background-color: {{ theme.cardLight }}">
            <text class="v-item-text" style="color: {{ theme.text }}">杭州</text>
          </div>
          <div class="v-item" style="background-color: {{ theme.cardLight }}">
            <text class="v-item-text" style="color: {{ theme.text }}">成都</text>
          </div>
        </scroll>
        <text class="scroll-info" style="color: {{ theme.accent }}">scrollX: {{ scrollX }}  scrollY: {{ scrollY }}</text>
        <text class="scroll-info" style="color: {{ theme.textMuted }}">事件日志: {{ eventLog }}</text>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.accent }}">scrollTo / scrollBy 方法</text>
        <text class="section-desc" style="color: {{ theme.textSecondary }}">编程控制滚动位置</text>
        <scroll id="scrollMethod" class="v-scroll-box" scroll-y="true">
          <div class="v-item" for="{{ cityList }}" style="background-color: {{ theme.cardLight }}">
            <text class="v-item-text" style="color: {{ theme.text }}">{{ $item }}</text>
          </div>
        </scroll>
        <div class="btn-row">
          <input class="act-btn" type="button" value="scrollTo(0)" onclick="doScrollToTop"
                 style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
          <input class="act-btn" type="button" value="scrollTo(200)" onclick="doScrollTo200"
                 style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
          <input class="act-btn" type="button" value="scrollBy(50)" onclick="doScrollBy"
                 style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        </div>
        <text class="scroll-info" style="color: {{ theme.accent }}">滚动内容尺寸: {{ rectInfo }}</text>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.accent }}">横向滚动 + bounces 回弹</text>
        <text class="section-desc" style="color: {{ theme.textSecondary }}">横向滚动，边界回弹效果</text>
        <scroll class="h-scroll-box" scroll-x="true" bounces="true">
          <div class="h-item color-1"><text class="h-item-text">1</text></div>
          <div class="h-item color-2"><text class="h-item-text">2</text></div>
          <div class="h-item color-1"><text class="h-item-text">3</text></div>
          <div class="h-item color-2"><text class="h-item-text">4</text></div>
          <div class="h-item color-1"><text class="h-item-text">5</text></div>
          <div class="h-item color-2"><text class="h-item-text">6</text></div>
          <div class="h-item color-1"><text class="h-item-text">7</text></div>
          <div class="h-item color-2"><text class="h-item-text">8</text></div>
        </scroll>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.accent }}">诗词滚动 - 将进酒</text>
        <text class="section-desc" style="color: {{ theme.textSecondary }}">竖向滚动朗诵经典诗词，体验流畅滚动效果</text>
        <scroll class="poem-scroll" scroll-y="true" onscroll="handlePoemScroll">
          <div class="poem-author-row">
            <text class="poem-author" style="color: {{ theme.accent }}">【唐】李白</text>
          </div>
          <text class="poem-line" for="{{ poemLines }}" style="color: {{ theme.text }}">{{ $item }}</text>
        </scroll>
        <text class="scroll-info" style="color: {{ theme.accent }}">诗词滚动位置: {{ poemScrollY }}</text>
      </div>

      <div class="bottom-spacer"></div>
    </scroll>

    <div class="bottom-bar">
      <input class="bar-btn" type="button" value="Scroll 吸附" onclick="scrollToSnap"
             style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <input class="bar-btn" type="button" value="Scroll 事件" onclick="scrollToEvents"
             style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <input class="bar-btn" type="button" value="Scroll 方法" onclick="scrollToMethods"
             style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <input class="bar-btn" type="button" value="诗词" onclick="scrollToPoem"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="bar-btn" type="button" value="返回首页" onclick="goBack"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    scrollX: 0,
    scrollY: 0,
    poemScrollY: 0,
    eventLog: '',
    rectInfo: '',
    cityList: ['北京', '上海', '广州', '深圳', '杭州', '成都', '武汉', '南京', '重庆', '西安'],
    poemLines: [
      '君不见黄河之水天上来，奔流到海不复回。',
      '君不见高堂明镜悲白发，朝如青丝暮成雪。',
      '人生得意须尽欢，莫使金樽空对月。',
      '天生我材必有用，千金散尽还复来。',
      '烹羊宰牛且为乐，会须一饮三百杯。',
      '岑夫子，丹丘生，将进酒，杯莫停。',
      '与君歌一曲，请君为我倾耳听。',
      '钟鼓馔玉不足贵，但愿长醉不愿醒。',
      '古来圣贤皆寂寞，惟有饮者留其名。',
      '陈王昔时宴平乐，斗酒十千恣欢谑。',
      '主人何为言少钱，径须沽取对君酌。',
      '五花马，千金裘，',
      '呼儿将出换美酒，与尔同销万古愁。'
    ]
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.getScrollRectInfo()
  },

  handleScrollTop() {
    console.log('[SCROLL-DEMO] scrolled to top')
    this.eventLog = '触发 scrolltop'
  },

  handleScrollBottom() {
    console.log('[SCROLL-DEMO] scrolled to bottom')
    this.eventLog = '触发 scrollbottom'
  },

  handleScroll(e) {
    this.scrollX = e.scrollX || 0
    this.scrollY = e.scrollY || 0
  },

  handlePoemScroll(e) {
    this.poemScrollY = e.scrollY || 0
  },

  getScrollRectInfo() {
    var self = this
    this.$element('scrollMethod').getScrollRect({
      success: function(rect) {
        self.rectInfo = 'width: ' + rect.width + '  height: ' + rect.height
      },
      fail: function() {
        self.rectInfo = 'getScrollRect failed'
      }
    })
  },

  doScrollToTop() {
    this.$element('scrollMethod').scrollTo({
      top: 0,
      behavior: 'smooth'
    })
  },

  doScrollTo200() {
    this.$element('scrollMethod').scrollTo({
      top: 200,
      behavior: 'smooth'
    })
  },

  doScrollBy() {
    this.$element('scrollMethod').scrollBy({
      top: 50,
      behavior: 'smooth'
    })
  },

  scrollToSnap() {
    this.$element('scrollVertical').scrollTo({
      top: 0,
      behavior: 'smooth'
    })
  },

  scrollToEvents() {
    this.$element('scrollVertical').scrollTo({
      top: 200,
      behavior: 'smooth'
    })
  },

  scrollToMethods() {
    this.$element('scrollVertical').scrollTo({
      top: 400,
      behavior: 'smooth'
    })
  },

  scrollToPoem() {
    this.$element('scrollVertical').scrollTo({
      top: 600,
      behavior: 'smooth'
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  padding: 44px 8px 8px 8px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

