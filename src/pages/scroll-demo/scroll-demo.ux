  font-size: 17px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.page-scroll {
  flex: 1;
  padding: 0 8px;
}

.section {
  flex-direction: column;
  border-radius: 12px;
  padding: 14px 12px;
  margin-bottom: 8px;
}

.section-title {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 4px;
}

.section-desc {
  font-size: 11px;
  margin-bottom: 10px;
  line-height: 16px;
}

.scroll-wrap {
  width: 100%;
}

.snap-box {
  height: 80px;
  width: 100%;
  margin-bottom: 10px;
}

.snap-item {
  width: 80%;
  height: 80px;
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
}

.color-1 {
  background-color: cadetblue;
}

.color-2 {
  background-color: orangered;
}

.v-scroll-box {
  height: 120px;
  flex-direction: column;
  background-color: #1a1a3e;
  border-radius: 8px;
  margin-bottom: 6px;
}

.v-item {
  width: 100%;
  height: 40px;
  justify-content: center;
  padding-left: 12px;
  border-bottom: 1px solid #2a2a5a;
}

.v-item-text {
  font-size: 14px;
}

.scroll-info {
  font-size: 11px;
  margin-top: 4px;
}

.poem-scroll {
  height: 160px;
  flex-direction: column;
  background-color: #1a1a3e;
  border-radius: 8px;
  padding: 10px 12px;
  margin-bottom: 6px;
}

.poem-author-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 8px;
}

.poem-author {
  font-size: 13px;
  font-weight: bold;
}

.poem-line {
  font-size: 13px;
  line-height: 22px;
  margin-bottom: 2px;
}

.btn-row {
  flex-direction: row;
  margin-top: 6px;
}

.act-btn {
  height: 30px;
  border-radius: 6px;
  font-size: 12px;
  padding: 0 10px;
  margin-right: 6px;
}

.h-scroll-box {
  height: 60px;
  width: 100%;
}

.h-item {
  width: 80px;
  height: 60px;
  justify-content: center;
  align-items: center;
  margin-right: 4px;
  border-radius: 6px;
}

.h-item-text {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.bottom-spacer {
  height: 60px;
}

.bottom-bar {
  flex-direction: row;
  padding: 6px 8px;
  justify-content: space-between;
}

.bar-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin: 0 3px;
}
</style>