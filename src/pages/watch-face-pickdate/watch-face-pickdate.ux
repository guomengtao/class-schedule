<template>
  <div class="page">

    <div class="back" onclick="onTap"></div>

    <text class="brand">EV</text>
    <text class="brand-sub">时 间 表 盘</text>

    <!-- 三列原生 picker：上下滑就是系统原生滚动，不写任何手势代码 -->
    <div class="drum" onclick="stopBubble">
      <picker class="pick" type="text" range="{{ hours }}" selected="{{ hIdx }}" onchange="onH"></picker>
      <text class="c">:</text>
      <picker class="pick" type="text" range="{{ mins }}" selected="{{ mIdx }}" onchange="onM"></picker>
      <text class="c">:</text>
      <picker class="pick" type="text" range="{{ secs }}" selected="{{ sIdx }}" onchange="onS"></picker>
    </div>

    <div class="edge-t"></div>
    <div class="edge-b"></div>

    <text class="date">{{ dateText }}</text>
    <div class="hr"></div>
    <text class="doy">{{ doyText }}</text>

    <text class="hint">{{ hintText }}</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const WD = ["日", "一", "二", "三", "四", "五", "六"]
const HINT_IDLE = "上下滑调时 · 点顶部返回"

function pad2(n) {
  return n < 10 ? "0" + n : "" + n
}

/* 0..n-1 的两位字符串数组，picker 的 range 要字符串 */
function seq(n) {
  const a = []
  for (let i = 0; i < n; i++) a.push(pad2(i))
  return a
}

function isLeap(y) {
  return (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0
}

export default {
  data: {
    hours: seq(24),
    mins: seq(60),
    secs: seq(60),
    hIdx: 0,
    mIdx: 0,
    sIdx: 0,
    dateText: "",
    doyText: "",
    hintText: HINT_IDLE
  },

  onInit() {
    /* shown = 三列当前真实值的脏检查基准 */
    this.shown = [-1, -1, -1]
    this.manualTs = 0
    this.tick()
    this.align()
  },

  /* 表盘可能被系统挂起，回到前台先对齐一次 */
  onShow() {
    this.align()
  },

  onHide() {
    this.stopAll()
  },

  onDestroy() {
    this.stopAll()
  },

  /* ── 定时器 ─────────────────────────────────────────── */

  stopAll() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
    if (this.alignTimer) {
      clearTimeout(this.alignTimer)
      this.alignTimer = undefined
    }
  },

  /* 先对齐整秒再起 interval，避免跳秒与长跑漂移 */
  align() {
    this.stopAll()
    this.tick()
    const self = this
    this.alignTimer = setTimeout(function() {
      self.alignTimer = undefined
      self.tick()
      self.timer = setInterval(function() {
        self.tick()
      }, 1000)
    }, 1000 - (new Date().getTime() % 1000))
  },

  /* ── 走时 ───────────────────────────────────────────── */

  tick() {
    const now = new Date()

    /* 手动滑动后进入 browse 态：3 秒无操作回到现在 */
    if (this.manualTs) {
      const left = 3 - Math.floor((now.getTime() - this.manualTs) / 1000)
      if (left <= 0) {
        this.manualTs = 0
        this.syncNow(now)
        this.setHint(HINT_IDLE)
      } else {
        this.setHint(left + " 秒后回到现在")
      }
      return
    }

    this.syncNow(now)
  },

  syncNow(now) {
    const H = now.getHours()
    const M = now.getMinutes()
    const S = now.getSeconds()

    /* 脏检查：常态每秒只写 1 个字段（秒列） */
    if (H !== this.shown[0]) {
      this.shown[0] = H
      this.hIdx = H
    }
    if (M !== this.shown[1]) {
      this.shown[1] = M
      this.mIdx = M
    }
    if (S !== this.shown[2]) {
      this.shown[2] = S
      this.sIdx = S
    }

    const dt = pad2(now.getMonth() + 1) + "-" + pad2(now.getDate()) + " 周" + WD[now.getDay()]
    if (dt !== this.dateText) this.dateText = dt

    const y = now.getFullYear()
    const doy = Math.floor((now.getTime() - new Date(y, 0, 0).getTime()) / 86400000)
    const ds = doy + " / " + (isLeap(y) ? 366 : 365) + " 天"
    if (ds !== this.doyText) this.doyText = ds
  },

  setHint(s) {
    if (s !== this.hintText) this.hintText = s
  },

  /* ── 用户手动滑动 ───────────────────────────────────── */

  onH(e) { this.onManual(0, e) },
  onM(e) { this.onManual(1, e) },
  onS(e) { this.onManual(2, e) },

  /*
    程序写 selected 可能回环一次 change，带回的就是刚写进去的值。
    所以"值没变就忽略"比布尔标记更稳：不会残留状态把下一次真手滑吞掉。
  */
  /* 鼓区吞掉点击：滑动不该被页面当成"返回目录"（同 time-picker-demo） */
  stopBubble() {
    return
  },

  onManual(i, e) {
    const v = e && typeof e.newSelected === "number" ? e.newSelected : -1
    if (v < 0 || v === this.shown[i]) return
    this.shown[i] = v
    this.manualTs = new Date().getTime()
    this.setHint("3 秒后回到现在")
  },

  /* ── 交互出口 ───────────────────────────────────────── */

  onTap() {
    this.stopAll()
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  /* 布局铁律：relative 容器 + absolute 子元素；禁群组选择器；禁 transform 数据绑定 */
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #0f1115;
  }

  /* 返回热区：顶部 0~120，与鼓区完全分离 */
  .back {
    position: absolute;
    left: 0;
    top: 0;
    width: 192px;
    height: 120px;
  }

  .brand {
    position: absolute;
    left: 0;
    top: 52px;
    width: 192px;
    height: 24px;
    font-size: 20px;
    letter-spacing: 3px;
    text-align: center;
    color: #d8dde8;
  }

  .brand-sub {
    position: absolute;
    left: 0;
    top: 76px;
    width: 192px;
    height: 14px;
    font-size: 11px;
    text-align: center;
    color: #5a6274;
  }

  /* 鼓容器：6 + 52 + 12 + 52 + 12 + 52 = 186，右留 6 */
  .drum {
    position: absolute;
    left: 6px;
    top: 150px;
    width: 180px;
    height: 150px;
    flex-direction: row;
  }

  /* 三列同一套参数，就是日期选择器的基础样式 */
  .pick {
    width: 52px;
    height: 150px;
    font-size: 25px;
    color: #5a6470;
    selected-font-size: 30px;
    selected-color: #7ec8e3;
    selected-background-color: #0f3460;
  }

  .c {
    width: 12px;
    height: 150px;
    font-size: 26px;
    line-height: 150px;
    text-align: center;
    color: #4a5265;
  }

  /* 鼓窗上下沿：纯装饰 1px，不覆盖触摸区（选中行 200~250） */
  .edge-t {
    position: absolute;
    left: 4px;
    top: 200px;
    width: 184px;
    height: 1px;
    background-color: #2f3846;
  }

  .edge-b {
    position: absolute;
    left: 4px;
    top: 249px;
    width: 184px;
    height: 1px;
    background-color: #232a34;
  }

  .date {
    position: absolute;
    left: 0;
    top: 300px;
    width: 192px;
    height: 18px;
    font-size: 13px;
    text-align: center;
    color: #98a1aa;
  }

  .hr {
    position: absolute;
    left: 76px;
    top: 324px;
    width: 40px;
    height: 1px;
    background-color: #2b3138;
  }

  .doy {
    position: absolute;
    left: 0;
    top: 336px;
    width: 192px;
    height: 14px;
    font-size: 9px;
    text-align: center;
    color: #4d545c;
  }

  .hint {
    position: absolute;
    left: 0;
    top: 452px;
    width: 192px;
    height: 14px;
    font-size: 9px;
    text-align: center;
    color: #343b43;
  }
</style>
