<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">Demo4: 四边定位</text>
    </div>

    <text class="info" style="color: {{ theme.accent }}">测试: 浮层用 right/bottom 定位 (无显式宽高)</text>
    <text class="desc" style="color: {{ theme.textSecondary }}">点击下方按钮显示弹窗，弹窗使用 right:0; bottom:0 定位</text>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.text }}">正常内容区域</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">页面内容应全屏显示</text>
    </div>

    <input class="test-btn" type="button" value="显示弹窗" onclick="showSheet"
           style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

    <input class="test-btn" type="button" value="测试全屏覆盖" onclick="showOverlay"
           style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />

    <div class="sheet-overlay" show="{{ showSheetOverlay }}" style="background-color: rgba(0,0,0,0.5)">
      <div class="sheet-box" style="background-color: {{ theme.card }}">
        <text class="sheet-title" style="color: {{ theme.accent }}">四边定位弹窗</text>
        <text class="sheet-desc" style="color: {{ theme.textSecondary }}">此遮罩使用 right/bottom 定位</text>
        <text class="sheet-desc" style="color: {{ theme.textMuted }}">如果塌缩到左上角 → Vela不支持四边定位</text>
        <input class="close-btn" type="button" value="关闭" onclick="hideSheet"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="overlay-full" show="{{ showFullOverlay }}" style="background-color: rgba(0,0,0,0.5)">
      <div class="overlay-box" style="background-color: {{ theme.card }}">
        <text class="overlay-title" style="color: {{ theme.accent }}">全屏覆盖弹窗</text>
        <text class="overlay-desc" style="color: {{ theme.textSecondary }}">此遮罩使用 width:100%; height:100%</text>
        <text class="overlay-desc" style="color: {{ theme.textMuted }}">对比四边定位与显式宽高的差异</text>
        <input class="close-btn" type="button" value="关闭" onclick="hideFullOverlay"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="nav-bar" style="background-color: {{ theme.card }}">
      <input class="nav-btn" type="button" value="‹ 上一项" onclick="goPrev"
             style="background-color: {{ theme.border }}; color: {{ theme.textSecondary }}" />
      <text class="nav-page" style="color: {{ theme.textMuted }}">4 / 5</text>
      <input class="nav-btn" type="button" value="下一项 ›" onclick="goNext"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    showSheetOverlay: false,
    showFullOverlay: false,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  showSheet() {
    this.showSheetOverlay = true
  },

  hideSheet() {
    this.showSheetOverlay = false
  },

  showOverlay() {
    this.showFullOverlay = true
  },

  hideFullOverlay() {
    this.showFullOverlay = false
  },

  goBack() {
    router.back()
  },

  goPrev() {
    router.push({ uri: "/pages/bs-demo3" })
  },

  goNext() {
    router.push({ uri: "/pages/bs-demo5" })
  }
}
</script>

