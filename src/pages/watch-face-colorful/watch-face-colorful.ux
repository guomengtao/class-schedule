<template>
  <!--
    彩色表盘 ② · 色块构成
    ─────────────────────────────────────────────────────────
    这一版不是「加宽屏分支」，是重做。母题 = 硬边界几何色块，
    与渐变表盘（色彩流动）刻意错开：
      · 渐变：48 条色带连续插值、上亮下暗、秒用连续进度条
      · 彩色：四段硬色标、数字下同色 chip、秒用 5 段离散方格
    本页不出现任何渐变（探针已证 Vela 不支持 linear-gradient，正好符合母题）。
    内容占屏 18.6% → 约 45%；192 主数字 60px 原值不动，336 改 104px。
  -->
  <div class="page">
    <!-- ===== 192×490（手环 9）：主数字 60px 原值 ===== -->
    <div if="{{ !wide }}" class="stack">
      <!-- 四段色标：40×4=160，居中走排版流。
           首版做的是通栏 48×4=192 贴顶，实测被胶囊圆角吃掉 ——
           y=3 处 192 屏只有中间约 30px 可见，两侧全是黑的。 -->
      <div class="s-caps">
        <div for="{{ caps }}" class="s-cap" style="background-color: {{ $item }}"></div>
      </div>
      <text class="s-brand">EV</text>

      <div class="s-clock">
        <div class="s-col">
          <text class="s-digit" style="color: {{ c0 }}">{{ d0 }}</text>
          <div class="s-chip" style="background-color: {{ c0 }}"></div>
        </div>
        <div class="s-col">
          <text class="s-digit" style="color: {{ c1 }}">{{ d1 }}</text>
          <div class="s-chip" style="background-color: {{ c1 }}"></div>
        </div>
        <text class="s-colon" style="color: {{ cColon }}">:</text>
        <div class="s-col">
          <text class="s-digit" style="color: {{ c2 }}">{{ d2 }}</text>
          <div class="s-chip" style="background-color: {{ c2 }}"></div>
        </div>
        <div class="s-col">
          <text class="s-digit" style="color: {{ c3 }}">{{ d3 }}</text>
          <div class="s-chip" style="background-color: {{ c3 }}"></div>
        </div>
      </div>

      <text class="s-date">{{ dateText }}</text>

      <!-- 秒：5 段离散方格，每 12 秒亮一格 -->
      <div class="s-secs">
        <div for="{{ secs }}" class="s-seg" style="background-color: {{ $item }}"></div>
      </div>

      <div class="s-acts">
        <text class="s-act" style="color: {{ cAct }}" onclick="openPanel">配色</text>
        <div class="s-div"></div>
        <text class="s-act2" onclick="goBack">返回</text>
      </div>
    </div>

    <!-- ===== 336×480（手环 10Pro）：主数字 104px =====
         104 反算：4×0.6×104 + 冒号 0.35×96 + 间隙 6×4 ≈ 308 ≤ 316（336 减两侧各 10）；
         116 会到 343 直接溢出，故不取更满。 -->
    <div if="{{ wide }}" class="stack">
      <div class="w-caps">
        <div for="{{ caps }}" class="w-cap" style="background-color: {{ $item }}"></div>
      </div>
      <text class="w-brand">EV</text>

      <div class="w-clock">
        <div class="w-col">
          <text class="w-digit" style="color: {{ c0 }}">{{ d0 }}</text>
          <div class="w-chip" style="background-color: {{ c0 }}"></div>
        </div>
        <div class="w-col">
          <text class="w-digit" style="color: {{ c1 }}">{{ d1 }}</text>
          <div class="w-chip" style="background-color: {{ c1 }}"></div>
        </div>
        <text class="w-colon" style="color: {{ cColon }}">:</text>
        <div class="w-col">
          <text class="w-digit" style="color: {{ c2 }}">{{ d2 }}</text>
          <div class="w-chip" style="background-color: {{ c2 }}"></div>
        </div>
        <div class="w-col">
          <text class="w-digit" style="color: {{ c3 }}">{{ d3 }}</text>
          <div class="w-chip" style="background-color: {{ c3 }}"></div>
        </div>
      </div>

      <text class="w-date">{{ dateText }}</text>

      <div class="w-secs">
        <div for="{{ secs }}" class="w-seg" style="background-color: {{ $item }}"></div>
      </div>

      <div class="w-acts">
        <text class="w-act" style="color: {{ cAct }}" onclick="openPanel">配色</text>
        <div class="w-div"></div>
        <text class="w-act2" onclick="goBack">返回</text>
      </div>
    </div>

    <!-- ===== 配色面板：色卡化（色块 + 名称），两屏共用一份 ===== -->
    <div class="mask" if="{{ showPanel }}" onclick="closePanel">
      <div class="panel" style="width: {{ panelW }}px">
        <text class="p-title">配色方案</text>
        <div class="p-row" onclick="pick(0)">
          <div class="p-chip" style="background-color: {{ pal0c }}"></div>
          <text class="p-item">糖果</text>
        </div>
        <div class="p-row" onclick="pick(1)">
          <div class="p-chip" style="background-color: {{ pal1c }}"></div>
          <text class="p-item">霓虹</text>
        </div>
        <div class="p-row" onclick="pick(2)">
          <div class="p-chip" style="background-color: {{ pal2c }}"></div>
          <text class="p-item">马卡龙</text>
        </div>
        <div class="p-row" onclick="pick(3)">
          <div class="p-chip" style="background-color: {{ pal3c }}"></div>
          <text class="p-item">冷色</text>
        </div>
        <text class="p-cancel" onclick="closePanel">取消</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"

const storage = require("@system.storage")

const LIST_PAGE = "/pages/watch-face-list"
const PAL_KEY = "wf_colorful_palette"   // 沿用原键：老用户配色继续生效
const DAY = ["日", "一", "二", "三", "四", "五", "六"]

/* 4 套配色 × 5 色（色值与旧版逐一相同，纯为兼容）
   依次 = 时十位 / 时个位 / 冒号 / 分十位 / 分个位 */
const PALETTES = [
  ["#ff6b6b", "#ffd166", "#7ec8e3", "#7dffb0", "#c792ea"], // 糖果
  ["#ff0090", "#00e5ff", "#ffee00", "#00ff85", "#ff6a00"], // 霓虹
  ["#ff9aa2", "#ffb7b2", "#ffdac1", "#e2f0cb", "#b5ead7"], // 马卡龙
  ["#4fc3f7", "#81d4fa", "#a5d6a7", "#c5e1a5", "#e6ee9c"]  // 冷色
]

const BASE = "#1a1a2e"                 // 页面底色：顶部色标与底同源混合
const CAP_TONE = 0.70                  // 色标 = 主色 70% 混底，够醒目又不刺眼
const SEG_OFF = "rgba(255,255,255,0.14)"

function pad2(n) {
  return n < 10 ? ("0" + n) : ("" + n)
}

function h2r(h) {
  return [parseInt(h.substr(1, 2), 16), parseInt(h.substr(3, 2), 16), parseInt(h.substr(5, 2), 16)]
}

function c2(n) {
  const v = Math.max(0, Math.min(255, Math.round(n)))
  const s = v.toString(16)
  return s.length < 2 ? ("0" + s) : s
}

function mixHex(a, b, k) {
  if (k <= 0) return a
  if (k >= 1) return b
  const A = h2r(a)
  const B = h2r(b)
  return "#" + c2(A[0] + (B[0] - A[0]) * k) + c2(A[1] + (B[1] - A[1]) * k) + c2(A[2] + (B[2] - A[2]) * k)
}

export default {
  data: {
    d0: "0", d1: "0", d2: "0", d3: "0",
    /* 文字色（糖果初始） */
    c0: "#ff6b6b", c1: "#ffd166", cColon: "#7ec8e3", c2: "#7dffb0", c3: "#c792ea",
    cAct: "#ff6b6b",
    /* 四段色标：首帧直接给「糖果配色混底 70%」的结果，不从回调里追 */
    caps: ["#ba5259", "#ba9a55", "#5fba89", "#936eb2"],
    /* 秒方格 5 段（首帧全灭） */
    secs: [SEG_OFF, SEG_OFF, SEG_OFF, SEG_OFF, SEG_OFF],
    /* 面板里四套配色的代表色块 */
    pal0c: "#ff6b6b", pal1c: "#ff0090", pal2c: "#ff9aa2", pal3c: "#4fc3f7",
    dateText: "--",
    wide: false,
    panelW: 240,
    showPanel: false,
    suppressTap: false
  },

  onInit() {
    this.lit = 0
    this.segOn = "#ff6b6b"
    this.fitScreen()
    this.loadPalette()
    this.tick()
  },

  /* 屏宽 ≥300 → 宽屏版式。读不到按 192 渲染，绝不白屏。 */
  fitScreen() {
    const self = this
    try {
      device.getInfo({
        success: function(d) {
          if (d && d.screenWidth >= 300) {
            self.wide = true
            self.panelW = 284
            self.tick()
          }
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.loadPalette()   // 回页时再读一次：别处改了配色也能跟上
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* 先对齐整秒再起 interval：秒方格 12 秒跳一格，漂移会让跳格时刻前后乱 */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.alignTimer = setTimeout(function() {
      self.alignTimer = undefined
      self.tick()
      self.timer = setInterval(function() {
        self.tick()
      }, 1000)
    }, 1000 - (new Date().getTime() % 1000))
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
    if (this.alignTimer) {
      clearTimeout(this.alignTimer)
      this.alignTimer = undefined
    }
  },

  tick() {
    const n = new Date()
    const hh = pad2(n.getHours())
    const mm = pad2(n.getMinutes())
    if (hh[0] !== this.d0) this.d0 = hh[0]
    if (hh[1] !== this.d1) this.d1 = hh[1]
    if (mm[0] !== this.d2) this.d2 = mm[0]
    if (mm[1] !== this.d3) this.d3 = mm[1]

    const dt = pad2(n.getMonth() + 1) + "-" + pad2(n.getDate()) + " 周" + DAY[n.getDay()]
    if (dt !== this.dateText) this.dateText = dt

    /* 5 段：0-11 亮 1 格，12-23 亮 2 格 …… 48-59 亮满 5 格 */
    const lit = Math.min(5, Math.floor(n.getSeconds() / 12) + 1)
    if (lit !== this.lit) {
      this.lit = lit
      this.setSecs(lit)
    }
  },

  /* 数组整体替换（for 渲染会整段重建），避免逐格赋值漏项 */
  setSecs(lit) {
    const out = []
    for (let k = 0; k < 5; k++) {
      out.push(k < lit ? this.segOn : SEG_OFF)
    }
    this.secs = out
  },

  applyPalette(i) {
    const p = PALETTES[i] || PALETTES[0]
    this.c0 = p[0]
    this.c1 = p[1]
    this.cColon = p[2]
    this.c2 = p[3]
    this.c3 = p[4]
    this.cAct = p[0]
    this.segOn = p[0]
    /* 色标四段 = 四位数字的色，各混底 30%：硬色块但不刺眼 */
    this.caps = [
      mixHex(BASE, p[0], CAP_TONE),
      mixHex(BASE, p[1], CAP_TONE),
      mixHex(BASE, p[3], CAP_TONE),
      mixHex(BASE, p[4], CAP_TONE)
    ]
    this.setSecs(this.lit || 1)
  },

  /* 先同步落一次默认配色，再异步读存储覆盖。
     实测：本环境下 storage.get 的回调在首帧不稳（色标一度停在首帧暗色），
     把「首帧该长什么样」从回调里摘出来，画面才确定。 */
  loadPalette() {
    const self = this
    this.applyPalette(0)
    try {
      storage.get({
        key: PAL_KEY,
        success: function(res) {
          var i = 0
          if (res && res.value !== undefined && res.value !== null) {
            i = parseInt(res.value, 10)
            if (isNaN(i)) i = 0
          }
          self.applyPalette(i)
        },
        fail: function() {
          self.applyPalette(0)
        }
      })
    } catch (e) {
      this.applyPalette(0)
    }
  },

  savePalette(i) {
    try {
      storage.set({ key: PAL_KEY, value: String(i) })
    } catch (e) {}
  },

  openPanel() {
    this.suppressTap = true
    this.showPanel = true
  },

  closePanel() {
    this.showPanel = false
    const self = this
    setTimeout(function() {
      self.suppressTap = false
    }, 300)
  },

  pick(i) {
    this.applyPalette(i)
    this.savePalette(i)
    this.closePanel()
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* ===== 四段色标（排版流内居中，避开胶囊圆角）===== */
  .s-caps {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
  }

  .s-cap {
    width: 40px;
    height: 8px;
    margin: 0 1px;
    border-radius: 1px;
  }

  .w-caps {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
  }

  .w-cap {
    width: 65px;
    height: 10px;
    margin: 0 2px;
    border-radius: 2px;
  }

  /* ===== 两屏共用骨架 ===== */
  .stack {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* ===== 192×490 =====
     ev-six：可读文字 24px 为绝对下限（旧版 22px 不合规，本次统一抬到 24）。
     主数字 60px 属表盘图形本体，不套四档——套 44 就不是表盘了。 */
  .s-brand {
    font-size: 24px;
    line-height: 28px;
    letter-spacing: 4px;
    color: #cfd4e0;
  }

  .s-clock {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 26px;
  }

  .s-col {
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .s-digit {
    font-size: 60px;
    line-height: 68px;
    font-weight: bold;
  }

  .s-chip {
    width: 14px;
    height: 4px;
    margin-top: 4px;
    border-radius: 1px;
  }

  .s-colon {
    font-size: 54px;
    line-height: 68px;
    font-weight: bold;
    margin: 0 2px;
  }

  .s-date {
    font-size: 24px;
    line-height: 28px;
    letter-spacing: 1px;
    margin-top: 14px;
    color: #b9bdc9;
  }

  .s-secs {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 24px;
  }

  .s-seg {
    width: 24px;
    height: 6px;
    margin: 0 3px;
    border-radius: 1px;
  }

  .s-acts {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 44px;
  }

  .s-act {
    font-size: 24px;
    line-height: 28px;
  }

  .s-act2 {
    font-size: 24px;
    line-height: 28px;
    color: #8a90a0;
  }

  /* 分隔靠排版（1px 竖线），不用「|」「/」等符号 —— ev-six 第 5 条 */
  .s-div {
    width: 1px;
    height: 20px;
    margin: 0 18px;
    background-color: rgba(255, 255, 255, 0.22);
  }

  /* ===== 336×480（10Pro）=====
     ev-six：宽屏可读文字 24/28 两档，24 为下限。主数字 104px 属图形本体，豁免。 */
  .w-brand {
    font-size: 28px;
    line-height: 32px;
    letter-spacing: 6px;
    color: #cfd4e0;
  }

  .w-clock {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 28px;
  }

  .w-col {
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .w-digit {
    font-size: 104px;
    line-height: 116px;
    font-weight: bold;
  }

  .w-chip {
    width: 20px;
    height: 6px;
    margin-top: 6px;
    border-radius: 2px;
  }

  .w-colon {
    font-size: 96px;
    line-height: 116px;
    font-weight: bold;
    margin: 0 6px;
  }

  .w-date {
    font-size: 28px;
    line-height: 32px;
    letter-spacing: 2px;
    margin-top: 16px;
    color: #b9bdc9;
  }

  .w-secs {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 26px;
  }

  .w-seg {
    width: 44px;
    height: 8px;
    margin: 0 4px;
    border-radius: 2px;
  }

  .w-acts {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 48px;
  }

  .w-act {
    font-size: 28px;
    line-height: 32px;
  }

  .w-act2 {
    font-size: 28px;
    line-height: 32px;
    color: #8a90a0;
  }

  .w-div {
    width: 1px;
    height: 24px;
    margin: 0 22px;
    background-color: rgba(255, 255, 255, 0.22);
  }

  /* ===== 配色面板（两屏共用，宽度走 panelW）===== */
  .mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.62);
    justify-content: center;
    align-items: center;
  }

  .panel {
    flex-direction: column;
    align-items: center;
    background-color: #232238;
    border-radius: 14px;
    padding: 16px 0 12px 0;
  }

  .p-title {
    font-size: 24px;
    color: #ffffff;
    margin-bottom: 8px;
  }

  /* 一行 = 色块 + 名称：色卡化的关键，选色不再盲选 */
  .p-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 7px 0;
  }

  .p-chip {
    width: 14px;
    height: 14px;
    margin-right: 10px;
    border-radius: 3px;
  }

  .p-item {
    font-size: 28px;
    color: #e8e8f0;
  }

  .p-cancel {
    margin-top: 8px;
    font-size: 24px;
    color: #888899;
  }
</style>
