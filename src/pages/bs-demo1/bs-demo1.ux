<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">Demo1: min-height</text>
    </div>

    <text class="info" style="color: {{ theme.accent }}">测试: 根容器用 min-height:100% (Vela不支持)</text>
    <text class="desc" style="color: {{ theme.textSecondary }}">如果此页黑屏 → min-height:100% 是元凶之一</text>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.text }}">观察区域</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">此卡片应填满整个屏幕宽度</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">如果只在左上角一小块出现 → 容器塌缩</text>
    </div>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.text }}">第二块区域</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">正常应显示在上一块下方</text>
      <text class="card-text" style="color: {{ theme.textMuted }}">如果看不到 → 页面渲染异常</text>
    </div>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.text }}">底部标记</text>
      <text class="card-text" style="color: {{ theme.accent }}">如果你能看到这行 → 页面正常渲染</text>
    </div>

    <div class="nav-bar" style="background-color: {{ theme.card }}">
      <text class="nav-page" style="color: {{ theme.textMuted }}">1 / 5</text>
      <input class="nav-btn" type="button" value="下一项 ›" onclick="goNext"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  goBack() {
    router.back()
  },

  goNext() {
    router.push({ uri: "/pages/bs-demo2" })
  }
}
</script>

