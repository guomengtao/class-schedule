<!--
  4 联世界时钟（watch-face-worldclock）
  ─────────────────────────────────────────────────────────────
  复刻对象：macOS 时钟 App「世界时钟」四联组件（基准图
  docs/reference/apple-clock-widget/worldclock-4up-desktop-20261026.png）

  原版规格（逻辑 px，从 2x 截图量测）：
    面板 347x167 / 圆角 28 / 深蓝径向渐变 #2b3a8c → #1b2060
    单盘 68，无外圈圆环、无刻度线，仅 12 个阿拉伯数字（沿 R=26 排布）
    白针两根（无秒针），中心白点 d=4
    城市名 14 粗体白 / 日期 Today·Tomorrow 12 灰 / 时区 ±nHRS 12 灰

  两机型布局（几何死结，必须分叉）：
    10Pro 336x480 → 1x4，盘 68，与原版 1:1
    9     192x490 → 2x2 宫格，盘 68（同尺寸，盘内零改动）
  192 屏上 1x4 每盘仅 39px，数字需缩到 6px 不可辨（相邻数字弦长仅 7），
  不是参数问题而是几何约束，故 9 机型改宫格。这是设计决策，不是缺陷。

  走针方案（沿用 watch-face-metal / evpointer 实拍标定结论）：
    ① transform-origin 不按 CSS 语义生效，引擎轴 = 元素顶部中点
       → 针的 left 使其水平中点 = 盘心 x，top = 盘心 y，向下延伸
    ② 禁动态 transform 绑定（整页黑屏），只允许字面量
    ③ 禁 @keyframes 承载当前时刻（针角错、粗针消失、画面冻结）
    ④ 角度用 120 档字面量类 .r0~.r119（3° 一档），每秒只换 class 名

  布局铁律：.page 只给 position:relative + 100%，子元素全 absolute；
  不叠 flex 居中（与 absolute 共同触发黑屏）。
-->

<template>
  <div class="page">

    <!-- 面板 -->
    <div class="panel {{panelCls}}">
    <div class="cell {{c0}}">
      <div class="dial">
        <text class="num" style="left:27px;top:2px">12</text>
        <text class="num" style="left:40px;top:5.5px">1</text>
        <text class="num" style="left:49.5px;top:15px">2</text>
        <text class="num" style="left:53px;top:28px">3</text>
        <text class="num" style="left:49.5px;top:41px">4</text>
        <text class="num" style="left:40px;top:50.5px">5</text>
        <text class="num" style="left:27px;top:54px">6</text>
        <text class="num" style="left:14px;top:50.5px">7</text>
        <text class="num" style="left:4.5px;top:41px">8</text>
        <text class="num" style="left:1px;top:28px">9</text>
        <text class="num" style="left:4.5px;top:15px">10</text>
        <text class="num" style="left:14px;top:5.5px">11</text>
        <div class="hand hour {{h0}}"></div>
        <div class="hand minute {{m0}}"></div>
        <div class="hub"></div>
      </div>
      <text class="city">{{city0}}</text>
      <text class="day">{{d0}}</text>
      <text class="tz">{{z0}}</text>
    </div>
    <div class="cell {{c1}}">
      <div class="dial">
        <text class="num" style="left:27px;top:2px">12</text>
        <text class="num" style="left:40px;top:5.5px">1</text>
        <text class="num" style="left:49.5px;top:15px">2</text>
        <text class="num" style="left:53px;top:28px">3</text>
        <text class="num" style="left:49.5px;top:41px">4</text>
        <text class="num" style="left:40px;top:50.5px">5</text>
        <text class="num" style="left:27px;top:54px">6</text>
        <text class="num" style="left:14px;top:50.5px">7</text>
        <text class="num" style="left:4.5px;top:41px">8</text>
        <text class="num" style="left:1px;top:28px">9</text>
        <text class="num" style="left:4.5px;top:15px">10</text>
        <text class="num" style="left:14px;top:5.5px">11</text>
        <div class="hand hour {{h1}}"></div>
        <div class="hand minute {{m1}}"></div>
        <div class="hub"></div>
      </div>
      <text class="city">{{city1}}</text>
      <text class="day">{{d1}}</text>
      <text class="tz">{{z1}}</text>
    </div>
    <div class="cell {{c2}}">
      <div class="dial">
        <text class="num" style="left:27px;top:2px">12</text>
        <text class="num" style="left:40px;top:5.5px">1</text>
        <text class="num" style="left:49.5px;top:15px">2</text>
        <text class="num" style="left:53px;top:28px">3</text>
        <text class="num" style="left:49.5px;top:41px">4</text>
        <text class="num" style="left:40px;top:50.5px">5</text>
        <text class="num" style="left:27px;top:54px">6</text>
        <text class="num" style="left:14px;top:50.5px">7</text>
        <text class="num" style="left:4.5px;top:41px">8</text>
        <text class="num" style="left:1px;top:28px">9</text>
        <text class="num" style="left:4.5px;top:15px">10</text>
        <text class="num" style="left:14px;top:5.5px">11</text>
        <div class="hand hour {{h2}}"></div>
        <div class="hand minute {{m2}}"></div>
        <div class="hub"></div>
      </div>
      <text class="city">{{city2}}</text>
      <text class="day">{{d2}}</text>
      <text class="tz">{{z2}}</text>
    </div>
    <div class="cell {{c3}}">
      <div class="dial">
        <text class="num" style="left:27px;top:2px">12</text>
        <text class="num" style="left:40px;top:5.5px">1</text>
        <text class="num" style="left:49.5px;top:15px">2</text>
        <text class="num" style="left:53px;top:28px">3</text>
        <text class="num" style="left:49.5px;top:41px">4</text>
        <text class="num" style="left:40px;top:50.5px">5</text>
        <text class="num" style="left:27px;top:54px">6</text>
        <text class="num" style="left:14px;top:50.5px">7</text>
        <text class="num" style="left:4.5px;top:41px">8</text>
        <text class="num" style="left:1px;top:28px">9</text>
        <text class="num" style="left:4.5px;top:15px">10</text>
        <text class="num" style="left:14px;top:5.5px">11</text>
        <div class="hand hour {{h3}}"></div>
        <div class="hand minute {{m3}}"></div>
        <div class="hub"></div>
      </div>
      <text class="city">{{city3}}</text>
      <text class="day">{{d3}}</text>
      <text class="tz">{{z3}}</text>
    </div>
    </div>

    <!-- 本机时间 -->
    <text class="time-line {{timeCls}}">{{timeText}}</text>
    <text class="date-line {{dateCls}}">{{dateText}}</text>
    <text class="back {{backCls}}" onclick="onBack">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const FULL_DAY = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

/* 城市表：zone 为 IANA 区域代号，真实偏移由 zoneOffset() 按夏令时算 */
const CITIES = [
  { name: "Cupertino", zone: "us" },
  { name: "Tokyo",     zone: "jp" },
  { name: "Sydney",    zone: "au" },
  { name: "Paris",     zone: "eu" }
]

function pad2(n) {
  return (n < 10 ? "0" : "") + n
}

/* 角度 → 120 档类名（3° 一档）；.rN 内部为 rotate(180 + 3N)，180° 由「向下」转「向上」 */
function stepClass(deg) {
  let s = Math.round(deg / 3) % 120
  if (s < 0) s += 120
  return "r" + s
}

/* ── 夏令时判定：全部用 UTC 时间戳比较，不依赖本机时区字符串 ──
   Date.UTC 构造出的时刻是「UTC 毫秒」，夏令时切换点在各地都定义在本地钟点，
   故换算成 UTC 时必须带上切换前的偏移（美东 02:00 PST=10:00Z、02:00 PDT=09:00Z），
   写错这两个数字会让切换日当天错 1 小时。 */
function firstSunday(y, m) {
  return 1 + ((7 - new Date(Date.UTC(y, m, 1)).getUTCDay()) % 7)
}
function nthSunday(y, m, n) {
  return firstSunday(y, m) + (n - 1) * 7
}
function lastSunday(y, m) {
  const d = new Date(Date.UTC(y, m + 1, 0))
  return d.getUTCDate() - d.getUTCDay()
}
function inUsDst(ts, y) {
  const s = Date.UTC(y, 2, nthSunday(y, 2, 2), 10)
  const e = Date.UTC(y, 10, nthSunday(y, 10, 1), 9)
  return ts >= s && ts < e
}
function inEuDst(ts, y) {
  const s = Date.UTC(y, 2, lastSunday(y, 2), 1)
  const e = Date.UTC(y, 9, lastSunday(y, 9), 1)
  return ts >= s && ts < e
}
function inAuDst(ts, y) {
  const sPrev = Date.UTC(y - 1, 9, firstSunday(y - 1, 9), 16)
  const eThis = Date.UTC(y, 3, firstSunday(y, 3), 16)
  const sThis = Date.UTC(y, 9, firstSunday(y, 9), 16)
  return (ts >= sPrev && ts < eThis) || ts >= sThis
}
function zoneOffset(zone, ts, y) {
  if (zone === "jp") return 9
  if (zone === "us") return inUsDst(ts, y) ? -7 : -8
  if (zone === "eu") return inEuDst(ts, y) ? 2 : 1
  if (zone === "au") return inAuDst(ts, y) ? 11 : 10
  return 0
}
function tzLabel(diff) {
  if (diff === 0) return "Same"
  const a = Math.abs(diff)
  return (diff > 0 ? "+" : "-") + a + (a === 1 ? "HR" : "HRS")
}

export default {
  data: {
    /* cell 位置类：默认 2x2（192 屏），宽屏换 1x4 */
    c0: "co0", c1: "co1", c2: "co2", c3: "co3",
    /* 四盘指针：h=时针 m=分针，共 8 个字段（4 个定时器会叠加唤醒，只用一个） */
    h0: "r0", h1: "r0", h2: "r0", h3: "r0",
    m0: "r0", m1: "r0", m2: "r0", m3: "r0",
    city0: "Cupertino", city1: "Tokyo", city2: "Sydney", city3: "Paris",
    d0: "Today", d1: "Today", d2: "Today", d3: "Today",
    z0: "", z1: "", z2: "", z3: "",
    timeText: "--:--",
    dateText: "",
    panelCls: "",
    timeCls: "",
    dateCls: "",
    backCls: "",
    timer: null
  },

  onInit() {
    this.fitScreen()
    this.tick()
  },

  /* ── 布局分叉（336x480 → 1x4；其余 → 2x2）──
     onReady 在 Vela 不可靠（watch-face-functional 实测不触发），故从 onInit 调；
     必须异步 getInfo：同步读到 192 屏会返回 ≥300，把小屏误判成宽屏；
     @system.device 必须页内 require，顶部 import 会静默失败。 */
  fitScreen() {
    const self = this
    try {
      const dev = require("@system.device")
      dev.getInfo({
        success: function(d) {
          const w = (d && d.screenWidth) ? d.screenWidth : 0
          if (w < 300) return
          self.c0 = "wco0"
          self.c1 = "wco1"
          self.c2 = "wco2"
          self.c3 = "wco3"
          self.panelCls = "w-panel"
          self.timeCls = "w-time"
          self.dateCls = "w-date"
          self.backCls = "w-back"
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  onShow() {
    this.tick()
    this.startTimer()
  },

  onReady() {
    this.startTimer()
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  startTimer() {
    this.stopTimer()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tick() {
    const ts = Date.now()
    const now = new Date()
    let localOff = -now.getTimezoneOffset() / 60
    if (isNaN(localOff)) localOff = 8
    const y = now.getUTCFullYear()
    const todayNo = Math.floor((ts + localOff * 3600000) / 86400000)

    const hs = []
    const ms = []
    const ds = []
    const zs = []
    for (let i = 0; i < 4; i++) {
      const off = zoneOffset(CITIES[i].zone, ts, y)
      const t = new Date(ts + off * 3600000)
      const hh = t.getUTCHours() % 12
      const mm = t.getUTCMinutes()
      hs.push(stepClass((hh + mm / 60) * 30))
      ms.push(stepClass(mm * 6))
      const dayNo = Math.floor((ts + off * 3600000) / 86400000)
      ds.push(dayNo > todayNo ? "Tomorrow" : (dayNo < todayNo ? "Yesterday" : "Today"))
      zs.push(tzLabel(off - localOff))
    }
    this.h0 = hs[0]; this.h1 = hs[1]; this.h2 = hs[2]; this.h3 = hs[3]
    this.m0 = ms[0]; this.m1 = ms[1]; this.m2 = ms[2]; this.m3 = ms[3]
    this.d0 = ds[0]; this.d1 = ds[1]; this.d2 = ds[2]; this.d3 = ds[3]
    this.z0 = zs[0]; this.z1 = zs[1]; this.z2 = zs[2]; this.z3 = zs[3]

    this.timeText = pad2(now.getHours()) + ":" + pad2(now.getMinutes())
    this.dateText = pad2(now.getMonth() + 1) + "-" + pad2(now.getDate()) + " " + FULL_DAY[now.getDay()]
  },

  onBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  /* 布局铁律：纯 relative + 子元素绝对定位，禁 flex 居中 */
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #0a0c1c;
  }

  /* ── 面板（192 屏 2x2 默认尺寸）──
     原版是径向渐变；Vela 径向支持不稳，用线性近似，视觉差在深蓝底上不可辨 */
  .panel {
    position: absolute;
    left: 6px;
    top: 46px;
    width: 180px;
    height: 294px;
    border-radius: 22px;
    background: linear-gradient(135deg, #2b3a8c 0%, #22307a 45%, #1b2060 100%);
  }

  /* ── 格 ──
     盘 68 + 城市 16 + 日期 14 + 时区 14 = 126 高
     2x2：列间距 96（8 + 68 + 28 + 68 + 8 = 180），行间距 136 */
  .cell {
    position: absolute;
    width: 68px;
    height: 126px;
  }
  .co0 { left: 8px;   top: 16px; }
  .co1 { left: 104px; top: 16px; }
  .co2 { left: 8px;   top: 152px; }
  .co3 { left: 104px; top: 152px; }

  /* ── 盘（68x68，盘心 (34,34)）── */
  .dial {
    position: absolute;
    left: 0;
    top: 0;
    width: 68px;
    height: 68px;
  }

  /* 12 个数字：R=26 圆周，盒 14x12，字号 11（原版 11） */
  .num {
    position: absolute;
    width: 14px;
    height: 12px;
    text-align: center;
    font-size: 11px;
    color: #ffffff;
  }

  /* ── 针：顶部中点压在盘心 (34,34)，向下延伸，rotate(180+θ) 指向 θ ──
     原版时针 18 / 分针 27（盘半径 34），此处按 68 盘等比取 16 / 25 */
  .hand {
    position: absolute;
  }
  .hour {
    left: 32.5px;
    top: 34px;
    width: 3px;
    height: 16px;
    border-radius: 1.5px;
    background-color: #ffffff;
  }
  .minute {
    left: 32.5px;
    top: 34px;
    width: 3px;
    height: 25px;
    border-radius: 1.5px;
    background-color: #ffffff;
  }
  .hub {
    position: absolute;
    left: 32px;
    top: 32px;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: #ffffff;
  }

  /* ── 城市 / 日期 / 时区 ──
     width 必须 100%（相对 cell），固定值会让 text-align:center 停在旧屏宽的一半 */
  .city {
    position: absolute;
    left: 0;
    top: 76px;
    width: 100%;
    height: 16px;
    text-align: center;
    font-size: 12px;
    font-weight: bold;
    color: #ffffff;
  }
  .day {
    position: absolute;
    left: 0;
    top: 96px;
    width: 100%;
    height: 14px;
    text-align: center;
    font-size: 10px;
    color: #9aa0c8;
  }
  .tz {
    position: absolute;
    left: 0;
    top: 112px;
    width: 100%;
    height: 14px;
    text-align: center;
    font-size: 10px;
    color: #9aa0c8;
  }

  /* ── 本机时间 / 日期 / 返回（192 屏）── */
  .time-line {
    position: absolute;
    left: 0;
    top: 356px;
    width: 100%;
    height: 44px;
    text-align: center;
    font-size: 40px;
    color: #ffffff;
  }
  .date-line {
    position: absolute;
    left: 0;
    top: 404px;
    width: 100%;
    height: 22px;
    text-align: center;
    font-size: 18px;
    color: #9aa0c8;
  }
  .back {
    position: absolute;
    left: 0;
    top: 446px;
    width: 100%;
    height: 22px;
    text-align: center;
    font-size: 18px;
    color: #6a7098;
  }

  /* ── 宽屏 336x480（手环 10Pro）：1x4 还原原版 ──
     面板 328x160，盘 68 四个 = 272，剩 56 → padding 7 + 3 gap 14 = 56（整数吻合）
     字号按屏宽比例放大：城市 12→14、日期/时区 10→12、时间 40→64
     盘内字号不放大（盘仍是 68），这是「比例字号」的正确边界 */
  .w-panel {
    left: 4px;
    top: 60px;
    width: 328px;
    height: 160px;
    border-radius: 26px;
  }
  .wco0 { left: 7px;   top: 22px; }
  .wco1 { left: 89px;  top: 22px; }
  .wco2 { left: 171px; top: 22px; }
  .wco3 { left: 253px; top: 22px; }

  .w-time {
    top: 250px;
    height: 74px;
    font-size: 64px;
  }
  .w-date {
    top: 336px;
    height: 28px;
    font-size: 22px;
  }
  .w-back {
    top: 420px;
    height: 26px;
    font-size: 20px;
  }

  /* ── 120 档字面量旋转：rotate(180 + 3N) ── */
  .r0 { transform: rotate(180deg); }
  .r1 { transform: rotate(183deg); }
  .r2 { transform: rotate(186deg); }
  .r3 { transform: rotate(189deg); }
  .r4 { transform: rotate(192deg); }
  .r5 { transform: rotate(195deg); }
  .r6 { transform: rotate(198deg); }
  .r7 { transform: rotate(201deg); }
  .r8 { transform: rotate(204deg); }
  .r9 { transform: rotate(207deg); }
  .r10 { transform: rotate(210deg); }
  .r11 { transform: rotate(213deg); }
  .r12 { transform: rotate(216deg); }
  .r13 { transform: rotate(219deg); }
  .r14 { transform: rotate(222deg); }
  .r15 { transform: rotate(225deg); }
  .r16 { transform: rotate(228deg); }
