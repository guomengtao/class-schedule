<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">首页模块版</text>
    </div>

    <text class="desc" style="color: {{ theme.textSecondary }}">加载 1 个模块（lab-list.js），展示实验室列表</text>

    <div class="card {{ status === 'ok' ? 'card-ok' : 'card-fail' }}" style="background-color: {{ theme.card }}">
      <text class="card-label" style="color: {{ theme.textMuted }}">lab-list.js</text>
      <text class="card-value" style="color: {{ theme.accent }}">{{ moduleText }}</text>
      <text class="card-status {{ status === 'ok' ? 'status-ok' : 'status-fail' }}">{{ status === 'ok' ? '✓' : '✗' }}</text>
    </div>

    <div if="{{ status === 'ok' }}" class="list-section">
      <text class="list-title" style="color: {{ theme.text }}">模块提供的实验室列表：</text>
      <div class="list-item" for="{{ labItems }}" style="background-color: {{ theme.card }}">
        <text class="item-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <div class="item-right">
          <text class="item-desc" style="color: {{ theme.textMuted }}">{{ $item.desc }}</text>
          <text class="item-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div if="{{ hasErrors }}" class="error-panel">
      <text class="error-title">错误详情</text>
      <div for="{{ errorList }}" class="error-item">
        <text class="error-text">{{ $item }}</text>
      </div>
    </div>

    <text class="status-text {{ hasErrors ? 'status-fail' : 'status-ok' }}">
      {{ hasErrors ? '模块加载失败 ✗' : '1 个模块加载成功 ✓' }}
    </text>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}; font-size: 13px;">📌 固定到首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var pinHelper = require("../../data/pin-helper.js")

var errorList = []
var module1 = null

function addError(msg) {
  console.error("[home-module-demo] " + msg)
  errorList.push(msg)
}

try {
  console.log("[home-module-demo] requiring lab-list module...")
  module1 = require("./modules/lab-list.js")
  console.log("[home-module-demo] lab-list required: " + JSON.stringify(typeof module1))
} catch (e) {
  addError("lab-list.js require 失败: " + (e.message || e))
}

export default {
  private: {
    moduleText: "",
    status: "",
    labItems: [],
    hasErrors: false,
    errorList: [],
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    console.log("[home-module-demo] onInit start")
    self.errorList = errorList

    store.getTheme(function(t) {
      self.theme = t
    })

    if (module1 && module1.init) {
      try {
        module1.init(self)
        self.status = "ok"
        console.log("[home-module-demo] lab-list init OK")
      } catch (e) {
        addError("lab-list.init 失败: " + (e.message || e))
        self.status = "fail"
        self.moduleText = "错误"
      }
    } else {
      addError("lab-list 未加载或无 init 方法")
      self.status = "fail"
      self.moduleText = "未加载"
    }

    self.errorList = errorList
    self.hasErrors = errorList.length > 0
    console.log("[home-module-demo] onInit done, errors: " + errorList.length)
  },

  goBack() {
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("首页模块版", "/pages/home-module-demo")
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
  padding: 0;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.desc {
  font-size: 13px;
  text-align: center;
  margin-bottom: 16px;
}

.card {
  flex-direction: row;
  align-items: center;
  padding: 16px;
  margin-bottom: 12px;
  border-radius: 10px;
}

.card-ok {
  border-left-width: 4px;
  border-left-color: #4ecb71;
}

.card-fail {
  border-left-width: 4px;
  border-left-color: #e08080;
}

.card-label {
  font-size: 14px;
  width: 100px;
}

.card-value {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
}

.card-status {
  font-size: 18px;
  width: 30px;
  text-align: center;
}

.status-ok {
  color: #4ecb71;
}

.status-fail {
  color: #e08080;
}

.list-section {
  flex-direction: column;
  margin-bottom: 12px;
}

.list-title {
  font-size: 14px;
  margin-bottom: 8px;
  padding: 0 4px;
}

.list-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  margin-bottom: 6px;
  border-radius: 10px;
}

.item-name {
  font-size: 14px;
  flex-shrink: 0;
  margin-right: 8px;
}

.item-right {
  flex-direction: row;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.item-desc {
  font-size: 11px;
  margin-right: 6px;
}

.item-arrow {
  font-size: 18px;
}

.error-panel {
  flex-direction: column;
  padding: 12px;
  margin-top: 8px;
  margin-bottom: 8px;
  border-radius: 10px;
  background-color: #2a1a1a;
  border-left-width: 4px;
  border-left-color: #e08080;
}

.error-title {
  font-size: 13px;
  font-weight: bold;
  color: #e08080;
  margin-bottom: 6px;
}

.error-item {
  padding: 2px 0;
}

.error-text {
  font-size: 11px;
  color: #e0a0a0;
}

.status-text {
  font-size: 13px;
  text-align: center;
  margin-top: 8px;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 16px 0 8px 0;
}

.pin-link {
  text-align: center;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    padding: 0 20px;
    justify-content: center;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
}
</style>