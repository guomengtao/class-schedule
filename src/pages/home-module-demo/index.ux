<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">首页模块版</text>
    </div>

    <text class="desc" style="color: {{ theme.textSecondary }}">加载 {{ moduleCount }} 个模块，逐个还原老版本首页功能</text>

    <text class="section-label" style="color: {{ theme.accent }}">模块 1: clock.js</text>
    <div class="card {{ status1 === 'ok' ? 'card-ok' : 'card-fail' }}" style="background-color: {{ theme.card }}">
      <text class="card-label" style="color: {{ theme.textMuted }}">clock.js</text>
      <text class="card-value" style="color: {{ theme.accent }}">{{ moduleText1 }}</text>
      <text class="card-status {{ status1 === 'ok' ? 'status-ok' : 'status-fail' }}">{{ status1 === 'ok' ? '✓' : '✗' }}</text>
    </div>

    <div if="{{ status1 === 'ok' }}" class="clock-display" style="background-color: {{ theme.card }}">
      <text class="clock-icon" style="color: {{ theme.textMuted }}">🕐</text>
      <text class="clock-time" style="color: {{ theme.text }}">{{ currentTime }}</text>
    </div>

    <div class="module-divider" style="background-color: {{ theme.borderLight }}"></div>

    <text class="section-label" style="color: {{ theme.accent }}">模块 2: day-nav.js</text>
    <div class="card {{ status2 === 'ok' ? 'card-ok' : 'card-fail' }}" style="background-color: {{ theme.card }}">
      <text class="card-label" style="color: {{ theme.textMuted }}">day-nav.js</text>
      <text class="card-value" style="color: {{ theme.accent }}">{{ moduleText2 }}</text>
      <text class="card-status {{ status2 === 'ok' ? 'status-ok' : 'status-fail' }}">{{ status2 === 'ok' ? '✓' : '✗' }}</text>
    </div>

    <div if="{{ status2 === 'ok' }}" class="day-nav-display" style="background-color: {{ theme.card }}">
      <input class="day-nav-btn" type="button" value="◀" onclick="prevDay" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
      <text class="day-title" style="color: {{ theme.text }}">{{ currentDay }}</text>
      <input class="day-nav-btn" type="button" value="▶" onclick="nextDay" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
    </div>

    <div if="{{ status2 === 'ok' }}" class="day-nav-quick" style="background-color: {{ theme.card }}">
      <input class="quick-btn" type="button" value="今" onclick="goToToday" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
    </div>

    <div if="{{ hasErrors }}" class="error-panel">
      <text class="error-title">错误详情</text>
      <div for="{{ errorList }}" class="error-item">
        <text class="error-text">{{ $item }}</text>
      </div>
    </div>

    <text class="status-text {{ hasErrors ? 'status-fail' : 'status-ok' }}">
      {{ hasErrors ? '模块加载失败 ✗' : '2 个模块全部加载成功 ✓' }}
    </text>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}; font-size: 13px;">📌 固定到首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var pinHelper = require("../../data/pin-helper.js")

var errorList = []
var module1 = null
var module2 = null

function addError(msg) {
  console.error("[home-module-demo] " + msg)
  errorList.push(msg)
}

try {
  console.log("[home-module-demo] requiring clock module...")
  module1 = require("./modules/clock.js")
  console.log("[home-module-demo] clock required: " + JSON.stringify(typeof module1))
} catch (e) {
  addError("clock.js require 失败: " + (e.message || e))
}

try {
  console.log("[home-module-demo] requiring day-nav module...")
  module2 = require("./modules/day-nav.js")
  console.log("[home-module-demo] day-nav required: " + JSON.stringify(typeof module2))
} catch (e) {
  addError("day-nav.js require 失败: " + (e.message || e))
}

export default {
  private: {
    moduleCount: 2,
    moduleText1: "",
    status1: "",
    moduleText2: "",
    status2: "",
    currentTime: "",
    currentDay: "星期日",
    currentDayIndex: 0,
    hasErrors: false,
    errorList: [],
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    console.log("[home-module-demo] onInit start")
    self.errorList = errorList

    store.getTheme(function(t) {
      self.theme = t
    })

    if (module1 && module1.init) {
      try {
        module1.init(self)
        self.status1 = "ok"
        self.moduleText1 = "时钟"
        console.log("[home-module-demo] clock init OK")
      } catch (e) {
        addError("clock.init 失败: " + (e.message || e))
        self.status1 = "fail"
        self.moduleText1 = "错误"
      }
    } else {
      addError("clock 未加载或无 init 方法")
      self.status1 = "fail"
      self.moduleText1 = "未加载"
    }

    if (module2 && module2.init) {
      try {
        module2.init(self)
        self.status2 = "ok"
        self.moduleText2 = "日期导航"
        console.log("[home-module-demo] day-nav init OK")
      } catch (e) {
        addError("day-nav.init 失败: " + (e.message || e))
        self.status2 = "fail"
        self.moduleText2 = "错误"
      }
    } else {
      addError("day-nav 未加载或无 init 方法")
      self.status2 = "fail"
      self.moduleText2 = "未加载"
    }

    self.errorList = errorList
    self.hasErrors = errorList.length > 0
    console.log("[home-module-demo] onInit done, errors: " + errorList.length)
  },

  onDestroy() {
    if (this.stopClockTimer) {
      this.stopClockTimer()
    }
  },

  goBack() {
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("首页模块版", "/pages/home-module-demo")
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
  padding: 0;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.desc {
  font-size: 13px;
  text-align: center;
  margin-bottom: 16px;
}

.section-label {
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 6px;
  padding: 0 4px;
}

.module-divider {
  height: 1px;
  margin: 12px 0;
}

.card {
  flex-direction: row;
  align-items: center;
  padding: 16px;
  margin-bottom: 12px;
  border-radius: 10px;
}

.card-ok {
  border-left-width: 4px;
  border-left-color: #4ecb71;
}

.card-fail {
  border-left-width: 4px;
  border-left-color: #e08080;
}

.card-label {
  font-size: 14px;
  width: 100px;
}

.card-value {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
}

.card-status {
  font-size: 18px;
  width: 30px;
  text-align: center;
}

.status-ok {
  color: #4ecb71;
}

.status-fail {
  color: #e08080;
}

.clock-display {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 20px;
  margin-bottom: 12px;
  border-radius: 10px;
}

.clock-icon {
  font-size: 28px;
  margin-right: 12px;
}

.clock-time {
  font-size: 36px;
  font-weight: bold;
}

.day-nav-display {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  margin-bottom: 8px;
  border-radius: 10px;
}

.day-nav-btn {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  font-size: 18px;
  text-align: center;
}

.day-title {
  font-size: 22px;
  font-weight: bold;
}

.day-nav-quick {
  flex-direction: row;
  justify-content: center;
  padding: 8px 16px;
  margin-bottom: 12px;
  border-radius: 10px;
}

.quick-btn {
  width: 50px;
  height: 40px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}

.error-panel {
  flex-direction: column;
  padding: 12px;
  margin-top: 8px;
  margin-bottom: 8px;
  border-radius: 10px;
  background-color: #2a1a1a;
  border-left-width: 4px;
  border-left-color: #e08080;
}

.error-title {
  font-size: 13px;
  font-weight: bold;
  color: #e08080;
  margin-bottom: 6px;
}

.error-item {
  padding: 2px 0;
}

.error-text {
  font-size: 11px;
  color: #e0a0a0;
}

.status-text {
  font-size: 13px;
  text-align: center;
  margin-top: 8px;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 16px 0 8px 0;
}

.pin-link {
  text-align: center;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    padding: 0 20px;
    justify-content: center;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
}
</style>