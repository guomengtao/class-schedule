  font-size: 16px;
  font-weight: bold;
  margin-left: 6px;
}

.cells-grid {
  flex-direction: column;
  border-radius: 12px;
  padding: 8px;
  margin-bottom: 14px;
  width: 100%;
}

.cells-row {
  flex-direction: row;
  justify-content: center;
}

