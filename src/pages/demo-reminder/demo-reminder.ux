<template>
  <div class="demo-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="&#9664;" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">提醒时间设置Demo</text>
    </div>
    <text class="subtitle" style="color: {{ theme.textMuted }}">5种时间设置方式演示</text>

    <div class="time-display" style="background-color: {{ theme.card }}">
      <text class="time-label" style="color: {{ theme.textMuted }}">当前设置时间</text>
      <text class="time-value" style="color: {{ theme.accent }}">{{ padZero(hour) }}:{{ padZero(minute) }}</text>
    </div>

    <scroll class="content-scroll" scroll-y="{{true}}">
      <div class="method-card" style="background-color: {{ theme.card }}">
        <text class="method-title" style="color: {{ theme.accent }}">方式1: 滑动条选择</text>
        <text class="method-desc" style="color: {{ theme.textMuted }}">拖动滑块设置分钟数</text>
        <div class="slider-row">
          <text class="slider-label" style="color: {{ theme.text }}">0</text>
          <slider class="time-slider" min="0" max="59" value="{{ sliderValue }}" onchange="onSliderChange" style="flex: 1" />
          <text class="slider-label" style="color: {{ theme.text }}">59</text>
        </div>
        <text class="slider-val" style="color: {{ theme.accent }}">{{ sliderValue }} 分钟</text>
      </div>

      <div class="method-card" style="background-color: {{ theme.card }}">
        <text class="method-title" style="color: {{ theme.accent }}">方式2: +/- 按钮调整</text>
        <text class="method-desc" style="color: {{ theme.textMuted }}">点击按钮增减小时和分钟</text>
        <div class="stepper-row">
          <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ hour }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        </div>
        <div class="stepper-row">
          <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseMinute" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ minute }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseMinute" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        </div>
      </div>

      <div class="method-card" style="background-color: {{ theme.card }}">
        <text class="method-title" style="color: {{ theme.accent }}">方式3: 点击预设时间</text>
        <text class="method-desc" style="color: {{ theme.textMuted }}">快速选择常用时间</text>
        <div class="preset-row">
          <div class="preset-chip" for="{{ presets }}" onclick="selectPreset($idx)" style="background-color: {{ selectedPreset === $idx ? theme.accent : theme.cardLight }}">
            <text class="preset-text" style="color: {{ selectedPreset === $idx ? theme.bg : theme.text }}">{{ $item.label }}</text>
          </div>
        </div>
      </div>

      <div class="method-card" style="background-color: {{ theme.card }}">
        <text class="method-title" style="color: {{ theme.accent }}">方式4: 滑动切换时间</text>
        <text class="method-desc" style="color: {{ theme.textMuted }}">左右滑动切换时间值</text>
        <div class="swipe-area" ontouchstart="onSwipeStart" ontouchend="onSwipeEnd" style="background-color: {{ theme.cardLight }}">
          <text class="swipe-hint" style="color: {{ theme.textMuted }}">← 滑动 →</text>
          <text class="swipe-time" style="color: {{ theme.accent }}">{{ padZero(swipeHour) }}:{{ padZero(swipeMinute) }}</text>
          <text class="swipe-sub" style="color: {{ theme.textMuted }}">左右滑切换小时 · 上下滑切换分钟</text>
        </div>
      </div>

      <div class="method-card" style="background-color: {{ theme.card }}">
        <text class="method-title" style="color: {{ theme.accent }}">方式5: 点击数字循环</text>
        <text class="method-desc" style="color: {{ theme.textMuted }}">点击数字逐个切换</text>
        <div class="tap-area" style="background-color: {{ theme.cardLight }}">
          <div class="tap-digit" onclick="cycleHour">
            <text class="tap-digit-label" style="color: {{ theme.textMuted }}">小时</text>
            <text class="tap-digit-val" style="color: {{ theme.accent }}">{{ padZero(tapHour) }}</text>
          </div>
          <text class="tap-colon" style="color: {{ theme.text }}">:</text>
          <div class="tap-digit" onclick="cycleMinute">
            <text class="tap-digit-label" style="color: {{ theme.textMuted }}">分钟</text>
            <text class="tap-digit-val" style="color: {{ theme.accent }}">{{ padZero(tapMinute) }}</text>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {},
    hour: 8,
    minute: 30,
    sliderValue: 30,
    selectedPreset: -1,
    presets: [
      { label: "5分钟", hour: 0, minute: 5 },
      { label: "15分钟", hour: 0, minute: 15 },
      { label: "30分钟", hour: 0, minute: 30 },
      { label: "1小时", hour: 1, minute: 0 },
      { label: "2小时", hour: 2, minute: 0 }
    ],
    swipeHour: 8,
    swipeMinute: 30,
    swipeStartX: 0,
    swipeStartY: 0,
    tapHour: 8,
    tapMinute: 30
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  padZero(n) {
    return n < 10 ? "0" + n : String(n)
  },

  goBack() {
    router.back()
  },

  onSliderChange(evt) {
    if (evt && evt.progress !== undefined) {
      this.sliderValue = evt.progress
      this.minute = evt.progress
    }
  },

  increaseHour() {
    if (this.hour < 23) {
      this.hour++
    } else {
      this.hour = 0
    }
  },

  decreaseHour() {
    if (this.hour > 0) {
      this.hour--
    } else {
      this.hour = 23
    }
  },

  increaseMinute() {
    if (this.minute < 59) {
      this.minute++
    } else {
      this.minute = 0
    }
  },

  decreaseMinute() {
    if (this.minute > 0) {
      this.minute--
    } else {
      this.minute = 59
    }
  },

  selectPreset(idx) {
    this.selectedPreset = idx
    var p = this.presets[idx]
    this.hour = p.hour
    this.minute = p.minute
    this.sliderValue = p.minute
  },

  onSwipeStart(evt) {
    if (!evt || !evt.touches || evt.touches.length === 0) return
    this.swipeStartX = evt.touches[0].clientX
    this.swipeStartY = evt.touches[0].clientY
  },

  onSwipeEnd(evt) {
    if (!evt || !evt.changedTouches || evt.changedTouches.length === 0) return
    var dx = evt.changedTouches[0].clientX - this.swipeStartX
    var dy = evt.changedTouches[0].clientY - this.swipeStartY
    var adx = dx < 0 ? -dx : dx
    var ady = dy < 0 ? -dy : dy

    if (adx > ady) {
      if (dx > 30) {
        if (this.swipeHour < 23) {
          this.swipeHour++
        } else {
          this.swipeHour = 0
        }
      } else if (dx < -30) {
        if (this.swipeHour > 0) {
          this.swipeHour--
        } else {
          this.swipeHour = 23
        }
      }
    } else {
      if (dy > 30) {
        if (this.swipeMinute < 59) {
          this.swipeMinute++
        } else {
          this.swipeMinute = 0
        }
      } else if (dy < -30) {
        if (this.swipeMinute > 0) {
          this.swipeMinute--
        } else {
          this.swipeMinute = 59
        }
      }
    }
    this.hour = this.swipeHour
    this.minute = this.swipeMinute
    this.sliderValue = this.swipeMinute
  },

  cycleHour() {
    if (this.tapHour < 23) {
      this.tapHour++
    } else {
      this.tapHour = 0
    }
    this.hour = this.tapHour
  },

  cycleMinute() {
    if (this.tapMinute < 59) {
      this.tapMinute++
    } else {
      this.tapMinute = 0
    }
    this.minute = this.tapMinute
    this.sliderValue = this.tapMinute
  }
}
</script>

<style>
  .demo-page{flex-direction:column;padding:16px;height:100%}
  .header{flex-direction:row;align-items:center;padding:12px 4px;margin-bottom:4px}
  .back-btn{width:56px;height:44px;border-radius:10px;font-size:18px;text-align:center}
  .title{font-size:28px;font-weight:bold;margin-left:10px;flex:1}
  .subtitle{font-size:16px;padding:0 4px 8px;margin-bottom:4px}
  .time-display{flex-direction:column;align-items:center;border-radius:14px;padding:16px;margin-bottom:12px}
  .time-label{font-size:16px;margin-bottom:4px}
  .time-value{font-size:48px;font-weight:bold}
  .content-scroll{flex:1;flex-direction:column}
  .method-card{flex-direction:column;border-radius:14px;padding:16px;margin-bottom:12px}
  .method-title{font-size:22px;font-weight:bold;margin-bottom:4px}
  .method-desc{font-size:16px;margin-bottom:10px}
  .slider-row{flex-direction:row;align-items:center;margin-bottom:8px}
  .slider-label{font-size:18px;width:40px;text-align:center}
  .slider-val{font-size:20px;font-weight:bold;text-align:center}
  .stepper-row{flex-direction:row;align-items:center;justify-content:center;margin-bottom:8px}
  .stepper-label{font-size:20px;width:60px}
  .stepper-btn{width:48px;height:40px;border-radius:10px;font-size:22px;font-weight:bold;text-align:center}
  .stepper-val{font-size:28px;font-weight:bold;width:50px;text-align:center}
  .preset-row{flex-direction:row;flex-wrap:wrap;justify-content:center}
  .preset-chip{height:44px;border-radius:22px;justify-content:center;align-items:center;padding:0 16px;margin:4px}
  .preset-text{font-size:18px;font-weight:bold}
  .swipe-area{flex-direction:column;align-items:center;border-radius:12px;padding:20px}
  .swipe-hint{font-size:18px;margin-bottom:6px}
  .swipe-time{font-size:40px;font-weight:bold}
  .swipe-sub{font-size:14px;margin-top:4px}
  .tap-area{flex-direction:row;align-items:center;justify-content:center;border-radius:12px;padding:20px}
  .tap-digit{flex-direction:column;align-items:center;padding:10px 16px;border-radius:10px}
  .tap-digit-label{font-size:14px;margin-bottom:4px}
  .tap-digit-val{font-size:40px;font-weight:bold}
  .tap-colon{font-size:36px;font-weight:bold;margin:0 8px}
</style>