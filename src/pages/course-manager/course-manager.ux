    padding: 38px 12px 16px 12px;
  }
        .add-btn {
    width: 80px;
    height: 44px;
    border-radius: 22px;
    font-size: 24px;
    line-height: 40px;
  }
  .clear-hint {
    font-size: 24px;
    line-height: 32px;
  }
  .clear-btn {
    width: 64px;
    height: 44px;
    border-radius: 22px;
    font-size: 24px;
    line-height: 40px;
  }
  .course-item {
    padding: 10px;
    margin-bottom: 6px;
  }
  .item-index {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    margin-right: 6px;
  }
  .index-text {
    font-size: 22px;
