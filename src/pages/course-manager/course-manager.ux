<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 头部统一骨架（ev-six 规则①②③）：返回键 30 + 居中标题 28px + 等宽占位 30，不放其他按钮 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">课程</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 操作行：左清空（有课时才显示）/ 右添加（常驻）。两键各 76/84 宽，中间留 8px 呼吸 -->
    <div class="action-bar">
      <input class="clear-btn" type="button" value="清空" onclick="clearAllCourses"
             style="display: {{ courseList.length > 0 ? 'flex' : 'none' }}; background-color: {{ clearAllConfirm ? theme.deleteText : theme.card }}; color: {{ clearAllConfirm ? theme.bg : theme.textSecondary }}" />
      <input class="add-btn" type="button" value="+ 添加" onclick="startAdd"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <!-- ev-six 第 6 条：删掉圆形序号徽标（占 1.0P 只给顺序不给信息，排序本就按时间）。
         单行卡片 = 左侧可点的课名区（cardLight 亮底＝可点性线索）+ 右侧删除键 38px。
         原设计上下两层（序号/课名 + 编辑/删除两个 56×48 按钮）单屏只能放 3 项，现为 6 项。 -->
    <scroll class="course-list-scroll" scroll-y="{{true}}">
      <div for="{{ courseList }}" class="course-item" style="background-color: {{ theme.card }}">
        <div class="item-main" onclick="startRename($idx)" style="background-color: {{ theme.cardLight }}">
          <text class="course-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        </div>
        <!-- 确认态：底色切 deleteText（亮红），字色切 bg 保证对比；文案恒定「删」，靠颜色表达主次 -->
        <input class="del-btn" type="button" value="删" onclick="deleteCourse($idx)"
               style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : theme.deleteBg }}; color: {{ deleteConfirmIndex === $idx ? theme.bg : theme.deleteText }}" />
      </div>
      <text class="empty-hint" style="display: {{ courseList.length === 0 ? 'flex' : 'none' }}; color: {{ theme.textMuted }}">暂无课程，点上方添加</text>
    </scroll>

    <!-- ev-six 第 13 条：禁用 prompt.showToast（系统浮层固定弹上部，会压住内容）。
         全部提示走这条底部内联条：高度固定 52px，只换文案与按钮显隐，不换高度。 -->
    <div class="tip-bar" style="display: {{ tipVisible ? 'flex' : 'none' }}; background-color: {{ theme.card }}; border-color: {{ theme.borderLight }}">
      <text class="tip-msg" style="color: {{ theme.text }}">{{ tipText }}</text>
      <input class="tip-btn" type="button" value="撤销" onclick="undoDelete"
             style="display: {{ canUndo ? 'flex' : 'none' }}; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var COURSE_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "老师", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "老师", location: "" },
  { name: "政治", time: "13:55 - 14:40", teacher: "老师", location: "" },
  { name: "音乐", time: "15:00 - 15:45", teacher: "老师", location: "" },
  { name: "体育", time: "15:55 - 16:40", teacher: "老师", location: "" },
  { name: "美术", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "历史", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "地理", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "生物", time: "10:55 - 11:40", teacher: "老师", location: "" }
]

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    courseList: [],
    editingIndex: -1,
    isAdding: false,
    clearAllConfirm: false,
    deleteConfirmIndex: -1,
    tipVisible: false,
    tipText: "",
    canUndo: false,
    tipTimer: null,
    deleteTimer: null,
    clearTimer: null,
    undoBackup: null
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(' - ')[0] : '00:00'
      var tb = b.time ? b.time.split(' - ')[0] : '00:00'
      var taParts = ta.split(':')
      var tbParts = tb.split(':')
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadCourses()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })

    // 顺序关键：先看有没有从 chinese-input 带回的改名/新增结果。
    // 有则直接处理（内存 courseList 已是最新），**不能再调 loadCourses**——
    // 否则异步 storage.get 带着旧列表返回，会把刚改好的名字覆盖回去。
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.processInputResult(data)
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        } else {
          self.loadCourses()
        }
      },
      fail: function() {
        self.loadCourses()
      }
    })
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.courseList = self.sortByTime(list)
            } else {
              self.courseList = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.courseList = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.courseList = self.sortByTime(defaultCourses.slice())
        }
      },
      fail: function() {
        self.courseList = self.sortByTime(defaultCourses.slice())
      }
    })
  },

  saveCourses() {
    var storage = require("@system.storage")
    storage.set({
      key: COURSE_KEY,
      value: JSON.stringify(this.courseList)
    })
  },

  // 底部内联提示条：canUndo=true 时带撤销按钮并延长到 5s，普通提示 3.5s
  showTip(text, canUndo) {
    this.tipText = text
    this.canUndo = !!canUndo
    this.tipVisible = true
    var self = this
    if (this.tipTimer) clearTimeout(this.tipTimer)
    this.tipTimer = setTimeout(function() {
      self.hideTip()
    }, canUndo ? 5000 : 3500)
  },

  hideTip() {
    if (this.tipTimer) {
      clearTimeout(this.tipTimer)
      this.tipTimer = null
    }
    this.tipVisible = false
    this.canUndo = false
  },

  startRename(idx) {
    var item = this.courseList[idx]
    if (!item) return
    this.editingIndex = idx
    this.isAdding = false
    this.deleteConfirmIndex = -1
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "重命名课程", success: function() {} })
    storage.set({ key: "chinese_input_value", value: item.name || "", success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "10", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  startAdd() {
    this.isAdding = true
    this.editingIndex = -1
    this.deleteConfirmIndex = -1
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "添加课程", success: function() {} })
    storage.set({ key: "chinese_input_value", value: "", success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "10", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  processInputResult(text) {
    text = (text || "").trim()
    if (!text) return
    if (this.editingIndex >= 0) {
      this.doRenameCourse(text)
    } else if (this.isAdding) {
      this.doAddCourse(text)
    }
  },

  doRenameCourse(newName) {
    newName = (newName || "").trim()
    var idx = this.editingIndex
    this.editingIndex = -1
    if (!newName || idx < 0 || idx >= this.courseList.length) {
      return
    }
    if (newName === this.courseList[idx].name) {
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (i !== idx && this.courseList[i].name === newName) {
        this.showTip("名称已存在", false)
        return
      }
    }
    this.courseList[idx].name = newName
    this.saveCourses()
    this.showTip("已改名", false)
  },

  doAddCourse(newName) {
    newName = (newName || "").trim()
    if (!newName) {
      this.isAdding = false
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (this.courseList[i].name === newName) {
        this.showTip("名称已存在", false)
        this.isAdding = false
        return
      }
    }
    this.courseList.push({
      name: newName,
      time: "08:00 - 08:45",
      teacher: "老师",
      location: ""
    })
    this.courseList = this.sortByTime(this.courseList)
    this.saveCourses()
    this.isAdding = false
    this.showTip("已添加", false)
  },

  deleteCourse(idx) {
    if (idx < 0 || idx >= this.courseList.length) return
    if (this.deleteConfirmIndex !== idx) {
      this.deleteConfirmIndex = idx
      var self = this
      if (this.deleteTimer) clearTimeout(this.deleteTimer)
      this.showTip("再点一次删除", false)
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirmIndex = -1
        self.deleteTimer = null
      }, 5000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    // 真正删除：先暂存被删课程，再删除并持久化，然后给 5 秒撤销窗口。
    // 二次确认只降低误删概率，撤销才能挽回已发生的误删（数据安全性维度）。
    this.undoBackup = { course: this.courseList[idx], index: idx }
    this.courseList.splice(idx, 1)
    this.deleteConfirmIndex = -1
    this.saveCourses()
    this.showTip("已删除", true)
  },

  undoDelete() {
    if (!this.undoBackup) {
      this.hideTip()
      return
    }
    // 恢复：把课程按时间重新插入列表并写回，保证顺序正确
    this.courseList.push(this.undoBackup.course)
    this.courseList = this.sortByTime(this.courseList)
    this.saveCourses()
    this.undoBackup = null
    this.showTip("已恢复", false)
  },

  clearAllCourses() {
    var self = this
    if (!this.clearAllConfirm) {
      this.clearAllConfirm = true
      if (this.clearTimer) clearTimeout(this.clearTimer)
      this.showTip("再点清空全部", false)
      this.clearTimer = setTimeout(function() {
        self.clearAllConfirm = false
        self.clearTimer = null
      }, 5000)
      return
    }
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    this.undoBackup = null
    this.courseList = []
    this.saveCourses()
    this.clearAllConfirm = false
    this.showTip("已清空", false)
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    if (this.tipTimer) {
      clearTimeout(this.tipTimer)
      this.tipTimer = null
    }
  }
}
</script>

<style>
@import '../../common/header.css';
/* ================================================================
   BASE CSS = 手环 9 基准（内容宽 168px = 192 − 12×2）
   手环 9 默认命中，无需任何 media query。弹性 flex + % 撑满。
   原则：base 属性一旦设定，大屏断点只改物理必须区分的值，不覆盖。
   手环 9 黑屏根因：独立 @media (shape: pill-shaped) 大块命中即崩，
   故 base 以 9 为基准，彻底移除独立 pill-shaped 分支。

   高度账（490 − 顶 30 − 底 60 = 400）：
     header 44+10=54 ｜ action-bar 40+8=48 ｜ 列表 298 ⇒ 6 项 @50px
   目标：单屏 6 项（原设计卡片上下两层、单屏 3 项）。
   ================================================================ */

.page {
  flex-direction: column;
  padding: 30px 12px 60px 12px;
  height: 100%;
}

.header-placeholder {
  width: 30px;
  flex-shrink: 0;
}

/* ---- 操作行：清空 + 添加，同高 40px（≈返回键档） ---- */
.action-bar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 40px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.clear-btn {
  width: 76px;
  height: 40px;
  border-radius: 20px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  flex-shrink: 0;
}

/* 「+ 添加」= 2.85P @24px ≈ 68px，84 宽留足两侧余量 */
.add-btn {
  width: 84px;
  height: 40px;
  border-radius: 20px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  flex-shrink: 0;
}

.course-list-scroll {
  flex: 1;
  height: 100%;
  flex-direction: column;
}

/* ---- 单行课程条：46px（课名 38 + 上下 4），一屏 6 项 ---- */
.course-item {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding: 4px;
  margin-bottom: 6px;
  border-radius: 12px;
  flex-shrink: 0;
}

/* 课名区用 cardLight 亮底 = 可点性线索（ev-six 第 5 条：靠底色三级层次表达，不靠符号） */
.item-main {
  flex: 1;
  min-width: 0;
  min-height: 38px;
  justify-content: center;
  padding: 0 8px;
  border-radius: 9px;
}

/* 课名 28px：102px 可用 ⇒ 3.6 字。2~3 字课名一屏读全，超长自然折行（不省略号） */
.course-name {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
}

/* 删除键 38×38：2 字中文课名之外只占 0.42P，确认态靠切亮红底表达，文案恒为「删」 */
.del-btn {
  width: 38px;
  height: 38px;
  border-radius: 9px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 38px;
  flex-shrink: 0;
  margin-left: 4px;
}

.empty-hint {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  padding: 40px 8px;
}

/* ---- 底部内联提示条（替代全部 toast）：高度固定 52px，只换文案与按钮显隐 ---- */
.tip-bar {
  position: fixed;
  left: 12px;
  right: 12px;
  bottom: 8px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 14px;
  border-width: 1px;
  border-style: solid;
  padding: 0 8px 0 12px;
}

.tip-msg {
  flex: 1;
  font-size: 24px;
  line-height: 34px;
}

.tip-btn {
  width: 56px;
  height: 40px;
  border-radius: 10px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  flex-shrink: 0;
  margin-left: 8px;
}

/* ================================================================
   宽度断点：手环 10 / 胶囊屏大号（width >= 200px，内容区 ~180px）
   ================================================================ */
@media (width >= 200px) {
  .course-name {
    font-size: 28px;
    line-height: 38px;
  }
}

/* ================================================================
   宽度断点：Watch 6 / 方屏（width >= 400px，内容区 ~400px）
   方屏空间充裕，卡片改单行横排，按钮与字放大到 30/24。
   ================================================================ */
@media (width >= 400px) {
  .page {
    padding: 6px 12px 16px 12px;
  }
  .action-bar {
    height: 44px;
  }
  .add-btn {
    width: 96px;
    height: 44px;
    border-radius: 22px;
    font-size: 24px;
    line-height: 44px;
  }
  .clear-btn {
    width: 88px;
    height: 44px;
    border-radius: 22px;
    font-size: 24px;
    line-height: 44px;
  }
  .course-item {
    padding: 6px;
    margin-bottom: 6px;
  }
  .item-main {
    min-height: 44px;
  }
  .course-name {
    font-size: 30px;
    line-height: 40px;
  }
  .del-btn {
    width: 48px;
    height: 44px;
    border-radius: 10px;
    font-size: 24px;
    line-height: 44px;
  }
  .tip-bar {
    height: 56px;
  }
  .tip-msg {
    font-size: 24px;
    line-height: 34px;
  }
  .tip-btn {
    width: 88px;
    height: 44px;
    font-size: 24px;
    line-height: 44px;
  }
}

/* ================================================================
   圆形表盘（唯一保留的 shape 查询——圆方不同构，非宽度可替代）
   手环 9 不会命中此分支，天然安全。
   ================================================================ */
@media (shape: circle) {
  .page {
    padding: 38px 36px 44px 36px;
  }
  .course-item {
    padding: 6px;
    margin-bottom: 6px;
  }
  .item-main {
    min-height: 44px;
  }
  .course-name {
    font-size: 28px;
    line-height: 38px;
  }
  .del-btn {
    width: 48px;
    height: 44px;
    border-radius: 10px;
    font-size: 24px;
    line-height: 44px;
  }
  .add-btn {
    width: 96px;
    height: 44px;
    border-radius: 22px;
    font-size: 24px;
    line-height: 44px;
  }
  .clear-btn {
    width: 88px;
    height: 44px;
    border-radius: 22px;
    font-size: 24px;
    line-height: 44px;
  }
}
</style>
