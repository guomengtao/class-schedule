<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="manager-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">课程管理</text>
    </div>

    <div class="rename-bar" show="{{ editingIndex >= 0 }}" style="background-color: {{ theme.card }}">
      <div class="rename-display" onclick="showKeyboard" style="background-color: {{ theme.cardLight }}; border-color: {{ theme.accent }}">
        <text class="rename-text" style="color: {{ theme.text }}">{{ editName || '输入新名称' }}</text>
        <text class="rename-cursor" show="{{ showCursor }}">_</text>
      </div>
      <input class="rename-ok-btn" type="button" value="保存" onclick="finishEdit" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="rename-cancel-btn" type="button" value="取消" onclick="cancelEdit" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>

    <div class="add-bar" style="background-color: {{ theme.card }}">
      <div class="add-display" onclick="startAdd" style="background-color: {{ theme.cardLight }}; border-color: {{ theme.accent }}">
        <text class="add-text" style="color: {{ theme.text }}">{{ newCourseName || '输入新课程名称' }}</text>
        <text class="add-cursor" show="{{ showCursor && isAdding }}">_</text>
      </div>
      <input class="add-ok-btn" type="button" value="添加" onclick="confirmAddCourse" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="add-cancel-btn" type="button" value="取消" onclick="cancelAdd" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>

    <scroll class="course-list-scroll" scroll-y="{{true}}">
      <div for="{{ courseList }}" class="course-item" style="background-color: {{ theme.card }}; border-left-color: {{ theme.accent }}">
        <div class="item-left">
          <text class="course-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        </div>
        <div class="item-right">
          <input class="link-btn" type="button" value="重命名" onclick="startRename($idx)" style="background-color: transparent; color: {{ theme.accent }}" />
          <input class="link-btn delete-btn" type="button" value="删除" onclick="deleteCourse($idx)" style="background-color: transparent; color: {{ theme.deleteText }}" />
        </div>
      </div>
    </scroll>

    <input-method
      hide="{{ hideKeyboard }}"
      keyboardtype="QWERTY"
      maxlength="10"
      vibratemode="short"
      screentype="rect"
      @visibility-change="onVisibilityChange"
      @key-down="onKeyDown"
      @delete="onDelete"
      @complete="onComplete"
    ></input-method>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")

var COURSE_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "老师", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "老师", location: "" },
  { name: "政治", time: "13:55 - 14:40", teacher: "老师", location: "" },
  { name: "音乐", time: "15:00 - 15:45", teacher: "老师", location: "" },
  { name: "体育", time: "15:55 - 16:40", teacher: "老师", location: "" },
  { name: "美术", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "历史", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "地理", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "生物", time: "10:55 - 11:40", teacher: "老师", location: "" }
]

export default {
  private: {
    theme: {},
    courseList: [],
    editingIndex: -1,
    editName: "",
    isAdding: false,
    newCourseName: "",
    hideKeyboard: true,
    showCursor: false
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(' - ')[0] : '00:00'
      var tb = b.time ? b.time.split(' - ')[0] : '00:00'
      var taParts = ta.split(':')
      var tbParts = tb.split(':')
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadCourses()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_KEY,
      success: function(data) {
        if (data) {
          try {
            var list = JSON.parse(data)
            if (list && list.length > 0) {
              self.courseList = self.sortByTime(list)
            } else {
              self.courseList = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.courseList = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.courseList = self.sortByTime(defaultCourses.slice())
        }
      },
      fail: function() {
        self.courseList = self.sortByTime(defaultCourses.slice())
      }
    })
  },

  saveCourses() {
    var storage = require("@system.storage")
    storage.set({
      key: COURSE_KEY,
      value: JSON.stringify(this.courseList)
    })
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.showCursor = true
  },

  onVisibilityChange(evt) {
    if (evt.detail && evt.detail.visible === false) {
      this.showCursor = false
    }
  },

  onKeyDown() {},

  onDelete() {
    if (this.editingIndex >= 0) {
      this.editName = this.editName.slice(0, -1)
    } else if (this.isAdding) {
      this.newCourseName = this.newCourseName.slice(0, -1)
    }
  },

  onComplete(evt) {
    if (this.editingIndex >= 0) {
      this.editName += evt.detail.content
    } else if (this.isAdding) {
      this.newCourseName += evt.detail.content
    }
  },

  startRename(idx) {
    var item = this.courseList[idx]
    if (!item) return
    this.editingIndex = idx
    this.editName = item.name
    this.showKeyboard()
  },

  finishEdit() {
    var newName = this.editName.trim()
    var idx = this.editingIndex
    if (!newName || idx < 0 || idx >= this.courseList.length) {
      this.cancelEdit()
      return
    }
    var item = this.courseList[idx]
    if (newName === item.name) {
      this.cancelEdit()
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (i !== idx && this.courseList[i].name === newName) {
        prompt.showToast({ message: "名称已存在", duration: 300 })
        return
      }
    }
    this.courseList[idx].name = newName
    this.saveCourses()
    this.cancelEdit()
    prompt.showToast({ message: "已更新", duration: 300 })
  },

  cancelEdit() {
    this.editingIndex = -1
    this.editName = ""
    this.hideKeyboard = true
    this.showCursor = false
  },

  startAdd() {
    this.isAdding = true
    this.newCourseName = ""
    this.showKeyboard()
  },

  confirmAddCourse() {
    var newName = this.newCourseName.trim()
    if (!newName) {
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (this.courseList[i].name === newName) {
        prompt.showToast({ message: "名称已存在", duration: 300 })
        return
      }
    }
    this.courseList.push({
      name: newName,
      time: "08:00 - 08:45",
      teacher: "老师",
      location: ""
    })
    this.courseList = this.sortByTime(this.courseList)
    this.saveCourses()
    this.cancelAdd()
    prompt.showToast({ message: "已添加", duration: 300 })
  },

  cancelAdd() {
    this.isAdding = false
    this.newCourseName = ""
    this.hideKeyboard = true
    this.showCursor = false
  },

  deleteCourse(idx) {
    if (idx < 0 || idx >= this.courseList.length) return
    this.courseList.splice(idx, 1)
    this.saveCourses()
  },

  goBack() {
    if (this.isAdding) {
      this.cancelAdd()
    } else if (this.editingIndex >= 0) {
      this.cancelEdit()
    } else if (!this.hideKeyboard) {
      this.hideKeyboard = true
      this.showCursor = false
    } else {
      router.back()
    }
  }
}
</script>

<style>
.manager-page {
  flex-direction: column;
  padding: 12px;
  height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.back-btn {
  width: 44px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
  flex-shrink: 0;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  margin-left: 10px;
}

.rename-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
  padding: 8px;
  border-radius: 10px;
  flex-shrink: 0;
}

.rename-display {
  flex: 1;
  height: 36px;
  border-radius: 10px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  padding: 0 12px;
  margin-right: 8px;
}

.rename-text {
  font-size: 14px;
}

.rename-cursor {
  font-size: 14px;
  color: #7ec8e3;
  margin-left: 2px;
}

.rename-ok-btn {
  width: 44px;
  height: 36px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
  margin-right: 6px;
  flex-shrink: 0;
}

.rename-cancel-btn {
  width: 44px;
  height: 36px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
  flex-shrink: 0;
}

.add-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
  padding: 8px;
  border-radius: 10px;
  flex-shrink: 0;
}

.add-display {
  flex: 1;
  height: 36px;
  border-radius: 10px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  padding: 0 12px;
  margin-right: 8px;
}

.add-text {
  font-size: 14px;
}

.add-cursor {
  font-size: 14px;
  color: #7ec8e3;
  margin-left: 2px;
}

.add-ok-btn {
  width: 44px;
  height: 36px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
  margin-right: 6px;
  flex-shrink: 0;
}

.add-cancel-btn {
  width: 44px;
  height: 36px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
  flex-shrink: 0;
}

.course-list-scroll {
  flex: 1;
  height: 100%;
  flex-direction: column;
}

.course-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 8px;
  padding: 6px 4px 6px 12px;
  margin-bottom: 4px;
  border-left-width: 3px;
  border-left-style: solid;
}

.item-left {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  margin-right: 4px;
}

.course-name {
  font-size: 15px;
  lines: 1;
}

.item-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.link-btn {
  font-size: 11px;
  padding: 1px 2px;
  border: none;
  background-color: transparent;
}

.delete-btn {
  color: #e74c3c;
}
</style>