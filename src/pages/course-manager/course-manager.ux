  width: 56px;
  height: 26px;
  border-radius: 13px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  line-height: 24px;
  flex-shrink: 0;
}

.clear-bar {
  flex-direction: row;
  align-items: center;
  padding: 4px 0;
  margin-bottom: 4px;
  flex-shrink: 0;
}

