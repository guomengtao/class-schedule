}

.undo-bar {
  position: fixed;
  left: 12px;
  right: 12px;
  bottom: 12px;
  height: 64px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  padding: 0 10px 0 16px;
}
.undo-msg {
  font-size: 24px;
  flex: 1;
