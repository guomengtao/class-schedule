<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper {{ isCapsule ? 'back-btn-cap' : '' }}" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon {{ isCapsule ? 'back-icon-cap' : '' }}" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title {{ isCapsule ? 'header-title-cap' : '' }}" style="color: {{ theme.text }}">课程管理</text>
      <input class="add-btn" if="{{ !isCapsule }}" type="button" value="+ 添加" onclick="startAdd" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <div class="header-placeholder {{ isCapsule ? 'placeholder-cap' : '' }}" if="{{ isCapsule }}"></div>
    </div>

    <div class="add-toolbar" if="{{ isCapsule }}">
      <input class="add-btn-toolbar" type="button" value="+ 添加" onclick="startAdd" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="clear-bar" if="{{ courseList.length > 0 }}">
      <text class="clear-hint" style="color: {{ theme.deleteText }}">{{ clearAllConfirm ? '再次点击确认' : '清除全部' }}</text>
      <input class="clear-btn" type="button" value="{{ clearAllConfirm ? '确认' : '清除' }}" onclick="clearAllCourses" style="background-color: {{ clearAllConfirm ? theme.deleteText : theme.deleteBg }}; color: {{ clearAllConfirm ? theme.text : theme.deleteText }}" />
    </div>

    <scroll class="course-list-scroll" scroll-y="{{true}}">
      <div for="{{ courseList }}" class="course-item" style="background-color: {{ theme.card }}">
        <div class="item-main">
          <div class="item-index" style="background-color: {{ theme.accent }}">
            <text class="index-text">{{ $idx + 1 }}</text>
          </div>
          <text class="course-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        </div>
        <div class="item-actions">
          <!-- 确认态下隐藏"编辑"并改显提示，既给出明确文案，也避免误触相邻按钮 -->
          <text class="item-del-hint" if="{{ deleteConfirmIndex === $idx }}" style="color: {{ theme.deleteText }}">再点确认</text>
          <input class="edit-btn" if="{{ deleteConfirmIndex !== $idx }}" type="button" value="编辑" onclick="startRename($idx)" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
          <input class="delete-btn" type="button" value="{{ deleteConfirmIndex === $idx ? '确认' : '删除' }}" onclick="deleteCourse($idx)" style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : theme.deleteBg }}; color: {{ deleteConfirmIndex === $idx ? theme.text : theme.deleteText }}" />
        </div>
      </div>
      <text if="{{ courseList.length === 0 }}" class="empty-hint" style="color: {{ theme.textMuted }}; text-align: center; padding: 40px 10px;">暂无课程，点击右上角 + 添加</text>
    </scroll>

    <div class="undo-bar" if="{{ undoVisible }}" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
      <text class="undo-msg" style="color: {{ theme.text }}">{{ undoMessage }}</text>
      <input class="undo-btn" type="button" value="撤销" onclick="undoDelete" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const device = require("@system.device")

var COURSE_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "老师", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "老师", location: "" },
  { name: "政治", time: "13:55 - 14:40", teacher: "老师", location: "" },
  { name: "音乐", time: "15:00 - 15:45", teacher: "老师", location: "" },
  { name: "体育", time: "15:55 - 16:40", teacher: "老师", location: "" },
  { name: "美术", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "历史", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "地理", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "生物", time: "10:55 - 11:40", teacher: "老师", location: "" }
]

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    courseList: [],
    isCapsule: false,
    editingIndex: -1,
    isAdding: false,
    clearAllConfirm: false,
    deleteConfirmIndex: -1,
    undoVisible: false,
    undoMessage: "",
    undoBackup: null,
    undoTimer: null
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(' - ')[0] : '00:00'
      var tb = b.time ? b.time.split(' - ')[0] : '00:00'
      var taParts = ta.split(':')
      var tbParts = tb.split(':')
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    device.getInfo({
      success: function(data) {
        var shape = data.screenShape || ""
        self.isCapsule = (shape === "capsule" || shape === "pill-shaped")
      },
      fail: function() {}
    })
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadCourses()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadCourses()

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.processInputResult(data)
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.courseList = self.sortByTime(list)
            } else {
              self.courseList = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.courseList = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.courseList = self.sortByTime(defaultCourses.slice())
        }
      },
      fail: function() {
        self.courseList = self.sortByTime(defaultCourses.slice())
      }
    })
  },

  saveCourses() {
    var storage = require("@system.storage")
    storage.set({
      key: COURSE_KEY,
      value: JSON.stringify(this.courseList)
    })
  },

  startRename(idx) {
    var item = this.courseList[idx]
    if (!item) return
    this.editingIndex = idx
    this.isAdding = false
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "重命名课程", success: function() {} })
    storage.set({ key: "chinese_input_value", value: item.name || "", success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "10", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  startAdd() {
    this.isAdding = true
    this.editingIndex = -1
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "添加课程", success: function() {} })
    storage.set({ key: "chinese_input_value", value: "", success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "10", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  processInputResult(text) {
    text = (text || "").trim()
    if (!text) return
    if (this.editingIndex >= 0) {
      this.doRenameCourse(text)
    } else if (this.isAdding) {
      this.doAddCourse(text)
    }
  },

  doRenameCourse(newName) {
    newName = (newName || "").trim()
    var idx = this.editingIndex
    this.editingIndex = -1
    if (!newName || idx < 0 || idx >= this.courseList.length) {
      return
    }
    if (newName === this.courseList[idx].name) {
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (i !== idx && this.courseList[i].name === newName) {
        prompt.showToast({ message: "名称已存在", duration: 300 })
        return
      }
    }
    this.courseList[idx].name = newName
    this.saveCourses()
    prompt.showToast({ message: "已更新", duration: 300 })
  },

  doAddCourse(newName) {
    newName = (newName || "").trim()
    if (!newName) {
      this.isAdding = false
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (this.courseList[i].name === newName) {
        prompt.showToast({ message: "名称已存在", duration: 300 })
        this.isAdding = false
        return
      }
    }
    this.courseList.push({
      name: newName,
      time: "08:00 - 08:45",
      teacher: "老师",
      location: ""
    })
    this.courseList = this.sortByTime(this.courseList)
    this.saveCourses()
    this.isAdding = false
    prompt.showToast({ message: "已添加", duration: 300 })
  },

  deleteCourse(idx) {
    if (idx < 0 || idx >= this.courseList.length) return
    if (this.deleteConfirmIndex !== idx) {
      this.deleteConfirmIndex = idx
      var self = this
      // 确认超时后必须给出显式反馈，否则用户再点会误以为"点了没反应"
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirmIndex = -1
        self.deleteTimer = null
        prompt.showToast({ message: "已取消删除" })
      }, 8000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    // 真正删除：先暂存被删课程，再删除并持久化，然后给 5 秒撤销窗口。
    // 二次确认只降低误删概率，撤销才能挽回已发生的误删（数据安全性维度）。
    this.undoBackup = { course: this.courseList[idx], index: idx }
    this.courseList.splice(idx, 1)
    this.deleteConfirmIndex = -1
    this.saveCourses()
    this.showUndo("课程已删除")
  },

  showUndo(message) {
    this.undoVisible = true
    this.undoMessage = message
    var self = this
    if (this.undoTimer) clearTimeout(this.undoTimer)
    this.undoTimer = setTimeout(function() {
      self.hideUndo()
    }, 5000)
  },

  hideUndo() {
    if (this.undoTimer) {
      clearTimeout(this.undoTimer)
      this.undoTimer = null
    }
    this.undoVisible = false
  },

  undoDelete() {
    if (!this.undoBackup) {
      this.hideUndo()
      return
    }
    // 恢复：把课程按时间重新插入列表并写回，保证顺序正确
    this.courseList.push(this.undoBackup.course)
    this.courseList = this.sortByTime(this.courseList)
    this.saveCourses()
    this.undoBackup = null
    this.hideUndo()
    prompt.showToast({ message: "已恢复", duration: 300 })
  },

  clearAllCourses() {
    if (!this.clearAllConfirm) {
      this.clearAllConfirm = true
      var self = this
      this.clearTimer = setTimeout(function() {
        self.clearAllConfirm = false
        self.clearTimer = null
        prompt.showToast({ message: "已取消清除" })
      }, 8000)
      return
    }
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    this.courseList = []
    this.saveCourses()
    this.clearAllConfirm = false
    prompt.showToast({ message: "所有课程已清除" })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    if (this.undoTimer) {
      clearTimeout(this.undoTimer)
      this.undoTimer = null
    }
  }
}
</script>

