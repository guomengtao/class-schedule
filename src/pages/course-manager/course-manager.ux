  font-size: 20px;
  flex: 1;
  line-height: 28px;
  lines: 1;
}

.clear-btn {
  width: 54px;
  height: 26px;
  border-radius: 13px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  line-height: 24px;
  flex-shrink: 0;
  margin-left: 4px;
}

.course-list-scroll {
  flex: 1;
  height: 100%;
  flex-direction: column;
}

.course-item {
  flex-direction: row;
  align-items: center;
  border-radius: 8px;
  padding: 8px;
  margin-bottom: 5px;
}

.item-index {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 4px;
}

.index-text {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  line-height: 22px;
}

.course-name {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  line-height: 32px;
  lines: 1;
}

.edit-btn {
  width: 36px;
  height: 24px;
  border-radius: 12px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  line-height: 22px;
  flex-shrink: 0;
  margin-left: 4px;
}

.delete-btn {
  width: 36px;
  height: 24px;
  border-radius: 12px;
  font-size: 18px;
  line-height: 22px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
  margin-left: 3px;
}

@media (shape: circle) {
  .page {
    padding: 38px 36px 44px 36px;
  }
  .header {
    height: 44px;
    margin-bottom: 10px;
  }
  .back-btn {
    width: 42px;
    height: 32px;
    font-size: 22px;
    line-height: 32px;
  }
  .title {
    font-size: 30px;
    line-height: 40px;
  }
  .add-btn {
    width: 64px;
    height: 32px;
    font-size: 22px;
    line-height: 30px;
  }
  .course-item {
    padding: 10px;
    margin-bottom: 6px;
  }
  .item-index {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    margin-right: 6px;
  }
  .index-text {
    font-size: 20px;
    line-height: 26px;
  }
  .course-name {
    font-size: 26px;
    line-height: 34px;
  }
  .edit-btn {
    width: 44px;
    height: 28px;
    font-size: 20px;
    line-height: 26px;
    margin-left: 4px;
  }
  .delete-btn {
    width: 44px;
    height: 28px;
    font-size: 20px;
    line-height: 26px;
    margin-left: 3px;
  }
  .clear-hint {
    font-size: 22px;
    line-height: 30px;
  }
  .clear-btn {
    width: 58px;
    height: 28px;
    font-size: 22px;
    line-height: 26px;
  }
}

@media (shape: rect) {
  .page {
    padding: 38px 12px 16px 12px;
  }
  .header {
    height: 44px;
    margin-bottom: 10px;
  }
  .back-btn {
    width: 44px;
    height: 34px;
    font-size: 22px;
    line-height: 34px;
  }
  .title {
    font-size: 30px;
    line-height: 40px;
  }
  .add-btn {
    width: 70px;
    height: 34px;
    font-size: 24px;
    line-height: 32px;
  }
  .clear-hint {
    font-size: 24px;
    line-height: 32px;
  }
  .clear-btn {
    width: 60px;
    height: 32px;
    font-size: 24px;
    line-height: 30px;
  }
  .course-item {
    padding: 10px;
    margin-bottom: 6px;
  }
  .item-index {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    margin-right: 6px;
  }
  .index-text {
    font-size: 22px;
    line-height: 28px;
  }
  .course-name {
    font-size: 28px;
    line-height: 36px;
  }
  .edit-btn {
    width: 48px;
    height: 30px;
    font-size: 20px;
    line-height: 28px;
    margin-left: 4px;
  }
  .delete-btn {
    width: 48px;
    height: 30px;
    font-size: 20px;
    line-height: 28px;
    margin-left: 3px;
  }
}
</style>