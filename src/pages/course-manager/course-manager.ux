<template>
  <div class="manager-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="&#9664;" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">课程管理</text>
      <text class="header-count" style="color: {{ theme.textMuted }}">{{ courseList.length }}门</text>
      <input class="add-btn" type="button" value="+ 添加" onclick="startAdd" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <scroll class="course-list-scroll" scroll-y="{{true}}">
      <div for="{{ courseList }}" class="course-item" style="background-color: {{ theme.card }}">
        <div class="item-index" style="background-color: {{ theme.accent }}">
          <text class="index-text">{{ $idx + 1 }}</text>
        </div>
        <text class="course-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <input class="edit-btn" type="button" value="编辑" onclick="startRename($idx)" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="delete-btn" type="button" value="删除" onclick="deleteCourse($idx)" style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}" />
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")

var COURSE_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "老师", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "老师", location: "" },
  { name: "政治", time: "13:55 - 14:40", teacher: "老师", location: "" },
  { name: "音乐", time: "15:00 - 15:45", teacher: "老师", location: "" },
  { name: "体育", time: "15:55 - 16:40", teacher: "老师", location: "" },
  { name: "美术", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "历史", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "地理", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "生物", time: "10:55 - 11:40", teacher: "老师", location: "" }
]

export default {
  private: {
    theme: {},
    courseList: [],
    editingIndex: -1,
    isAdding: false
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(' - ')[0] : '00:00'
      var tb = b.time ? b.time.split(' - ')[0] : '00:00'
      var taParts = ta.split(':')
      var tbParts = tb.split(':')
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadCourses()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          if (self.editingIndex >= 0) {
            self.doRenameCourse(data)
          } else if (self.isAdding) {
            self.doAddCourse(data)
          }
          storage.delete({ key: "chinese_input_result" })
        }
      }
    })
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_KEY,
      success: function(data) {
        if (data) {
          try {
            var list = JSON.parse(data)
            if (list && list.length > 0) {
              self.courseList = self.sortByTime(list)
            } else {
              self.courseList = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.courseList = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.courseList = self.sortByTime(defaultCourses.slice())
        }
      },
      fail: function() {
        self.courseList = self.sortByTime(defaultCourses.slice())
      }
    })
  },

  saveCourses() {
    var storage = require("@system.storage")
    storage.set({
      key: COURSE_KEY,
      value: JSON.stringify(this.courseList)
    })
  },

  navigateToInput(title, value) {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: title })
    storage.set({ key: "chinese_input_placeholder", value: "点击输入" })
    storage.set({ key: "chinese_input_value", value: value || "" })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  startRename(idx) {
    var item = this.courseList[idx]
    if (!item) return
    this.editingIndex = idx
    this.navigateToInput("重命名课程", item.name)
  },

  doRenameCourse(newName) {
    newName = (newName || "").trim()
    var idx = this.editingIndex
    this.editingIndex = -1
    if (!newName || idx < 0 || idx >= this.courseList.length) {
      return
    }
    if (newName === this.courseList[idx].name) {
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (i !== idx && this.courseList[i].name === newName) {
        prompt.showToast({ message: "名称已存在", duration: 300 })
        return
      }
    }
    this.courseList[idx].name = newName
    this.saveCourses()
    prompt.showToast({ message: "已更新", duration: 300 })
  },

  startAdd() {
    this.isAdding = true
    this.navigateToInput("添加课程", "")
  },

  doAddCourse(newName) {
    newName = (newName || "").trim()
    if (!newName) {
      this.isAdding = false
      return
    }
    for (var i = 0; i < this.courseList.length; i++) {
      if (this.courseList[i].name === newName) {
        prompt.showToast({ message: "名称已存在", duration: 300 })
        this.isAdding = false
        return
      }
    }
    this.courseList.push({
      name: newName,
      time: "08:00 - 08:45",
      teacher: "老师",
      location: ""
    })
    this.courseList = this.sortByTime(this.courseList)
    this.saveCourses()
    this.isAdding = false
    prompt.showToast({ message: "已添加", duration: 300 })
  },

  deleteCourse(idx) {
    if (idx < 0 || idx >= this.courseList.length) return
    this.courseList.splice(idx, 1)
    this.saveCourses()
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.manager-page {
  flex-direction: column;
  padding: 10px;
  height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.back-btn {
  width: 40px;
  height: 34px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
  flex-shrink: 0;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  margin-left: 8px;
  flex: 1;
}

.header-count {
  font-size: 13px;
  margin-right: 8px;
}

.add-btn {
  width: 68px;
  height: 34px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
}

.course-list-scroll {
  flex: 1;
  height: 100%;
  flex-direction: column;
}

.course-item {
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
  padding: 10px;
  margin-bottom: 6px;
}

.item-index {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 10px;
}

.index-text {
  font-size: 13px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.course-name {
  flex: 1;
  font-size: 16px;
  font-weight: bold;
  max-lines: 1;
  text-overflow: ellipsis;
}

.edit-btn {
  width: 46px;
  height: 32px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
  margin-left: 6px;
}

.delete-btn {
  width: 46px;
  height: 32px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
  margin-left: 4px;
}
</style>