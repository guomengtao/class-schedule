}

.course-name {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  line-height: 36px;
  lines: 1;
  text-overflow: ellipsis;
}

.edit-btn {
  width: 56px;
  height: 40px;
  border-radius: 20px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  line-height: 36px;
  flex-shrink: 0;
}

.delete-btn {
  width: 56px;
  height: 40px;
  border-radius: 20px;
  font-size: 22px;
  line-height: 36px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
  margin-left: 8px;
}

.back-btn-cap {
  width: 40px;
  height: 40px;
  border-radius: 8px;
}

.back-icon-cap {
  width: 20px;
  height: 20px;
}

.header-title-cap {
  font-size: 20px;
  line-height: 28px;
}

.placeholder-cap {
  width: 40px;
}

.course-name {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  line-height: 36px;
  lines: 1;
  text-overflow: ellipsis;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 30px 16px 56px 16px;
