}

.course-item {
  flex-direction: row;
  align-items: center;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 8px;
}

.item-index {
  width: 34px;
  height: 34px;
  border-radius: 17px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 10px;
}

.index-text {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  line-height: 32px;
}

.course-name {
  flex: 1;
  font-size: 32px;
  font-weight: bold;
  max-lines: 1;
  text-overflow: ellipsis;
  line-height: 40px;
}

.edit-btn {
  width: 56px;
  height: 34px;
  border-radius: 8px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 32px;
  flex-shrink: 0;
  margin-left: 8px;
}

.delete-btn {
  width: 56px;
  height: 34px;
  border-radius: 8px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
  margin-left: 6px;
}

@media (shape: circle) {
  .manager-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    height: 48px;
    margin-bottom: 12px;
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 44px;
    height: 40px;
    font-size: 28px;
  }
  .title {
    font-size: 36px;
  }
  .add-btn {
    width: 64px;
    height: 36px;
    font-size: 24px;
  }
  .course-item {
    padding: 10px;
    margin-bottom: 6px;
  }
  .item-index {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    margin-right: 8px;
  }
  .index-text {
    font-size: 20px;
  }
  .course-name {
    font-size: 28px;
  }
  .edit-btn {
    width: 50px;
    height: 30px;
    font-size: 20px;
  }
  .delete-btn {
    width: 50px;
    height: 30px;
    font-size: 20px;
  }
  .clear-hint {
    font-size: 24px;
  }
  .clear-btn {
    width: 56px;
    height: 30px;
    font-size: 24px;
  }
}

@media (shape: capsule) {
  .manager-page {
    padding: 44px 10px 12px 10px;
  }
  .header {
    height: 40px;
    margin-bottom: 10px;
  }
  .back-btn {
    width: 36px;
    height: 32px;
    font-size: 24px;
  }
  .title {
    font-size: 28px;
  }
  .add-btn {
    width: 62px;
    height: 34px;
    font-size: 20px;
  }
  .course-item {
    padding: 9px;
    margin-bottom: 6px;
  }
  .item-index {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    margin-right: 8px;
  }
  .index-text {
    font-size: 20px;
  }
  .course-name {
    font-size: 28px;
  }
  .edit-btn {
    width: 48px;
    height: 28px;
    font-size: 20px;
  }
  .delete-btn {
    width: 48px;
    height: 28px;
    font-size: 20px;
  }
  .clear-hint {
    font-size: 20px;
  }
  .clear-btn {
    width: 54px;
    height: 28px;
    font-size: 20px;
  }
}

@media (shape: rect) {
  .manager-page {
    padding: 44px 8px 8px 8px;
  }
  .header {
    height: 36px;
    margin-bottom: 10px;
  }
  .back-btn {
    width: 36px;
    height: 32px;
    font-size: 24px;
  }
  .title {
    font-size: 28px;
  }
  .add-btn {
    width: 60px;
    height: 32px;
    font-size: 20px;
  }
  .course-item {
    padding: 8px;
    margin-bottom: 6px;
  }
  .item-index {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    margin-right: 8px;
  }
  .index-text {
    font-size: 20px;
  }
  .course-name {
