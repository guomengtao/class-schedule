  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
}

.nickname-text {
  font-size: 32px;
  lines: 1;
  text-overflow: ellipsis;
  max-width: 80%;
  line-height: 40px;
}

