<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="edit-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">编辑昵称</text>
      <input class="toggle-btn" type="button" value="{{ useInputMethod ? '舒适' : '标准' }}" onclick="toggleInputMethod" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
      <input class="save-btn" type="button" value="保存" onclick="saveNickname" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="edit-content">
      <div class="nickname-display" onclick="onDisplayClick" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="nickname-text" style="color: {{ theme.text }}">{{ currentName || '输入昵称' }}</text>
        <text class="cursor" show="{{ showCursor && useInputMethod }}" style="color: {{ theme.accent }}">|</text>
      </div>
      <text class="input-hint" show="{{ !useInputMethod }}" style="color: {{ theme.textMuted }}">跳转至输入页</text>
    </div>

    <div class="keyboard-area" show="{{ showKeyboard && useInputMethod }}">
      <input-method
        hide="{{ hideKeyboard }}"
        keyboardtype="QWERTY"
        maxlength="5"
        vibratemode="short"
        screentype="{{ screenType }}"
        oncomplete="onInputComplete"
        ondelete="onInputDelete"
        onkey-down="onKeyDown"
      ></input-method>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import device from "@system.device"
const store = require("../../data/store.js")

export default {
  private: {
    currentName: "",
    savedName: "",
    showKeyboard: false,
    hideKeyboard: false,
    showCursor: false,
    screenType: "circle",
    useInputMethod: true,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getNickname(function(name) {
      self.savedName = name || ""
      self.currentName = self.savedName
    })
    device.getInfo({
      success: function(data) {
        self.screenType = data.screenShape || "circle"
        self.showKeyboardFn()
      },
      fail: function() {
        self.showKeyboardFn()
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })

    // Read result from chinese-input-full page if we switched away
    if (!this.useInputMethod) {
      var storage = require("@system.storage")
      storage.get({
        key: "chinese_input_result",
        success: function(data) {
          if (data !== undefined && data !== null && data !== "") {
            self.currentName = data
            storage.delete({
              key: "chinese_input_result",
              fail: function() {}
            })
          }
        },
        fail: function() {}
      })
    }
  },

  showKeyboardFn() {
    this.showKeyboard = true
    this.hideKeyboard = false
    this.showCursor = true
  },

  showKeyboard() {
    this.showKeyboard = true
    this.hideKeyboard = false
    this.showCursor = true
  },

  toggleInputMethod() {
    this.useInputMethod = !this.useInputMethod
    if (this.useInputMethod) {
      // Switch to inline keyboard
      this.showKeyboard = true
      this.hideKeyboard = false
      this.showCursor = true
    }
  },

  onDisplayClick() {
    if (this.useInputMethod) {
      // Inline mode: just ensure keyboard is visible
      this.showKeyboard()
    } else {
      // Page mode: navigate to chinese-input-full
      var storage = require("@system.storage")
      storage.set({ key: "chinese_input_title", value: "编辑昵称" })
      storage.set({ key: "chinese_input_placeholder", value: "点击输入昵称" })
      storage.set({ key: "chinese_input_value", value: this.currentName || "" })
      storage.set({ key: "chinese_input_maxlen", value: "5" })
      storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
      router.push({ uri: "/pages/chinese-input-full" })
    }
  },

  onInputComplete(e) {
    if (e && e.detail && e.detail.content) {
      if (this.currentName.length < 5) {
        this.currentName += e.detail.content
      }
    }
  },

  onInputDelete() {
    this.currentName = this.currentName.slice(0, -1)
  },

  onKeyDown(e) {
    if (e && e.detail && e.detail.content) {
      var key = e.detail.content
      if (key === 'enter' || key === 'done') {
        this.saveNickname()
      }
    }
  },

  saveNickname() {
    var newName = this.currentName.trim()
    if (!newName) {
      prompt.showToast({ message: "昵称不能为空" })
      return
    }
    var self = this
    store.setNickname(newName, function() {
      self.savedName = newName
      prompt.showToast({ message: "昵称已保存" })
      router.back()
    })
  },

  goBack() {
    router.back()
  }
}
</script>

