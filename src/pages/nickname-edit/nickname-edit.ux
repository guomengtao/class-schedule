<template>
  <div class="edit-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="header-title" style="color: {{ theme.text }}">编辑昵称</text>
      <input class="save-btn" type="button" value="保存" onclick="saveNickname" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="edit-content">
      <div class="nickname-display" onclick="openInput" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="nickname-text" style="color: {{ theme.text }}">{{ currentName || '输入昵称' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")

export default {
  private: {
    currentName: "",
    savedName: "",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getNickname(function(name) {
      self.savedName = name || ""
      self.currentName = self.savedName
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.currentName = data
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  openInput() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "编辑昵称", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "输入昵称", success: function() {} })
    storage.set({ key: "chinese_input_value", value: this.currentName, success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "5", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  saveNickname() {
    var newName = this.currentName.trim()
    if (!newName) {
      prompt.showToast({ message: "昵称不能为空" })
      return
    }
    var self = this
    store.setNickname(newName, function() {
      self.savedName = newName
      prompt.showToast({ message: "昵称已保存" })
      router.back()
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.edit-page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
  
}

.back-header {
  flex-direction: row;
  align-items: center;
  height: 48px;
  margin-bottom: 14px;
  padding: 4px 0;
}

.back-btn {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  font-size: 28px;
  text-align: center;
  line-height: 36px;
}

.header-title {
  font-size: 36px;
  font-weight: bold;
  margin-left: 8px;
  flex: 1;
  line-height: 44px;
}

.save-btn {
  width: 56px;
  height: 34px;
  border-radius: 8px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 32px;
}

.edit-content {
  flex-direction: column;
  align-items: center;
  padding: 10px 4px 0 4px;
}

.nickname-display {
  width: 100%;
  height: 60px;
  border-radius: 12px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
}

.nickname-text {
  font-size: 32px;
  lines: 1;
  text-overflow: ellipsis;
  max-width: 80%;
  line-height: 40px;
}

@media (shape: circle) {
  .edit-page {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    height: 48px;
    margin-bottom: 12px;
    padding: 0 2px;
    justify-content: center;
  }
  .back-btn {
    width: 44px;
    height: 40px;
    font-size: 28px;
  }
  .header-title {
    font-size: 36px;
    margin-left: 4px;
  }
  .save-btn {
    width: 50px;
    height: 30px;
    font-size: 20px;
  }
  .edit-content {
    padding: 6px 0 0 0;
  }
  .nickname-display {
    height: 52px;
  }
  .nickname-text {
    font-size: 28px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .header {
    height: 48px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
  }
  .back-btn {
    width: 48px;
    height: 40px;
    border-radius: 20px;
    font-size: 24px;
    text-align: center;
    line-height: 40px;
    flex-shrink: 0;
  }
  .title {
    font-size: 28px;
    line-height: 44px;
    text-align: center;
    flex: 1;
    lines: 1;
    margin: 0 4px;
  }

}

@media (shape: rect) {
  .edit-page {
    padding: 44px 8px 8px 8px;
  }
  .back-header {
    height: 36px;
    margin-bottom: 10px;
  }
  .back-btn {
    width: 36px;
    height: 32px;
    font-size: 24px;
  }
  .header-title {
    font-size: 28px;
    margin-left: 4px;
  }
  .save-btn {
    width: 48px;
    height: 30px;
    font-size: 20px;
  }
  .edit-content {
    padding: 6px 0 0 0;
  }
  .nickname-display {
    height: 48px;
  }
  .nickname-text {
    font-size: 28px;
  }
}
</style>