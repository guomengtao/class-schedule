  font-size: 32px;
  margin-left: 2px;
  line-height: 40px;
}

.input-hint {
  font-size: 24px;
  margin-top: 8px;
  text-align: center;
  line-height: 32px;
}

.keyboard-area {
  flex: 1;
  flex-direction: column;
  margin-top: 10px;
}

