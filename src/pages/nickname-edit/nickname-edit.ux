  .edit-page {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    height: 48px;
    margin-bottom: 12px;
    padding: 0 2px;
    justify-content: center;
  }
  .back-btn {
    width: 44px;
    height: 40px;
    font-size: 28px;
  }
  .header-title {
    font-size: 36px;
    margin-left: 4px;
  }
  .toggle-btn {
    width: 50px;
    height: 30px;
    font-size: 20px;
    margin-right: 4px;
  }
  .save-btn {
    width: 50px;
    height: 30px;
    font-size: 20px;
  }
  .edit-content {
    padding: 6px 0 0 0;
  }
  .nickname-display {
    height: 52px;
  }
