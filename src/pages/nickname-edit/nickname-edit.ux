<template>
  <div class="edit-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">编辑昵称</text>
    </div>

    <div class="edit-content">
      <text class="input-label" style="color: {{ theme.textSecondary }}">请输入昵称</text>
      <div class="nickname-display" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="nickname-text" style="color: {{ theme.text }}">{{ currentName || '点击输入昵称' }}</text>
      </div>

      <div class="button-row">
        <input class="cancel-btn" type="button" value="取消" onclick="goBack" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="recommend-btn" type="button" value="推荐" onclick="showRecommend" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="save-btn" type="button" value="保存" onclick="saveNickname" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="overlay-bottom-sheet" if="{{ showRecommendPanel }}" onclick="hideRecommend">
      <div class="bottom-sheet" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <div class="sheet-handle" style="background-color: {{ theme.textMuted }}"></div>
        <text class="sheet-title" style="color: {{ theme.accent }}">推荐昵称</text>
        <text class="sheet-desc" style="color: {{ theme.textSecondary }}">点击选择一条推荐昵称，再点保存即可</text>
        <div class="recommend-list">
          <div for="{{ recommendWords }}" class="recommend-item" onclick="selectRecommend($item)" style="background-color: {{ theme.cardLight }}">
            <text class="recommend-text" style="color: {{ theme.text }}">{{ $item }}</text>
          </div>
        </div>
        <input class="sheet-cancel" type="button" value="关闭" onclick="hideRecommend"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const recommendWords = require("../../common/recommend-words.js")

export default {
  private: {
    currentName: "",
    savedName: "",
    showRecommendPanel: false,
    recommendWords: [],
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getNickname(function(name) {
      self.savedName = name || ""
      self.currentName = self.savedName
    })
    this.recommendWords = recommendWords.getNicknameWords()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null) {
          self.currentName = data
          storage.delete({ key: "chinese_input_result" })
        }
      }
    })
  },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "编辑昵称" })
    storage.set({ key: "chinese_input_placeholder", value: "点击输入昵称" })
    storage.set({ key: "chinese_input_value", value: this.currentName || "" })
    storage.set({ key: "chinese_input_maxlen", value: "5" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  saveNickname() {
    var newName = this.currentName.trim()
    if (!newName) {
      return
    }
    var self = this
    store.setNickname(newName, function() {
      self.savedName = newName
      prompt.showToast({ message: "昵称已保存" })
      router.back()
    })
  },

  showRecommend() {
    this.showRecommendPanel = true
  },

  hideRecommend() {
    this.showRecommendPanel = false
  },

  selectRecommend(word) {
    this.currentName = word
    this.showRecommendPanel = false
  },

  stopBubble() {
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
