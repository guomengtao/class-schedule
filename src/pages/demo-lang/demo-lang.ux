<template>
  <div class="demo-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="&#9664;" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">{{ pageTitle }}</text>
    </div>
    <div class="add-row">
      <input class="add-btn" type="button" value="+ 添加" onclick="showAddDialog" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
    <div class="quick-jump" style="background-color: {{ theme.card }}">
      <scroll class="jump-scroll" scroll-x="{{true}}">
        <input for="{{ listData }}" class="jump-num" type="button" value="{{ $idx + 1 }}" onclick="scrollToItem($idx)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
      </scroll>
    </div>
    <scroll id="demoScroll" class="list-scroll" scroll-y="{{true}}" scroll-top="{{ scrollTarget }}">
    <div class="list">
      <div for="{{ listData }}" class="item-wrapper">
        <div class="list-item" style="border-bottom: 1px dashed {{ theme.border }}; padding: 44px 8px"
             ontouchstart="onTouchStart($event, $idx)" ontouchend="onTouchEnd($event, $idx)" onclick="onItemClick($idx)">
          <text class="minimal-name" style="font-size: 32px; color: {{ theme.text }}">{{ $item }}</text>
          <text class="minimal-idx" style="font-size: 24px; color: #00bcd4">{{ $idx < 9 ? "0" + ($idx + 1) : $idx + 1 }}</text>
        </div>
        <div class="delete-btn" if="{{ swipedIdx === $idx }}" onclick="confirmDelete($idx)"><text class="delete-icon">&#10005;</text></div>
      </div>
    </div>
    </scroll>
    <div class="footer" style="border-top: 1px solid {{ theme.border }}">
      <text class="footer-text" style="color: {{ theme.textMuted }}">共 {{ listData.length }} 个</text>
      <input class="undo-btn" if="{{ undoItem }}" type="button" value="撤消删除" onclick="undoDelete" style="background-color: #3498db; color: #ffffff" />
    </div>
  </div>
</template>
<script>
import router from "@system.router"
import prompt from "@system.prompt"
var storage = require("@system.storage")
var store = require("../../data/store.js")
var STORAGE_KEY = "demo_demo-lang"
var DEFAULT_DATA = ["中文","英语","日语","韩语","法语","德语","西班牙语","俄语","阿拉伯语","葡萄牙语"]

export default {
  private: {
    theme: {},
    listData: [],
    swipedIdx: -1,
    touchStartX: 0,
    undoItem: null,
    undoIdx: -1,
    undoTimer: null
    ,pageTitle: "语言列表"
    ,scrollTarget: 0
    ,itemHeight: 130
  },
  scrollToItem: function(idx) {
    this.scrollTarget = -1
    var self = this
    setTimeout(function() {
      self.scrollTarget = idx * self.itemHeight
    }, 50)
  },
  onInit: function() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadData()
  },
  onShow: function() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadData()
  },
  loadData: function() {
    var self = this
    storage.get({
      key: STORAGE_KEY,
      success: function(data) {
        if (data) {
          try { var list = JSON.parse(data); self.listData = (list && list.length > 0) ? list : DEFAULT_DATA.slice() }
          catch (e) { self.listData = DEFAULT_DATA.slice() }
        } else { self.listData = DEFAULT_DATA.slice() }
        self.swipedIdx = -1
      },
      fail: function() { self.listData = DEFAULT_DATA.slice(); self.swipedIdx = -1 }
    })
  },
  saveData: function() {
    storage.set({ key: STORAGE_KEY, value: JSON.stringify(this.listData) })
  },
  showAddDialog: function() {
    var self = this
    prompt.showDialog({
      title: "添加", message: "输入名称", edittype: "text", value: "",
      buttons: [
        { text: "取消", color: "#888899" },
        { text: "确定", color: "#7ec8e3", onclick: function(_err, d) {
          if (d && d.value) {
            var name = d.value.trim()
            if (!name) return
            for (var i = 0; i < self.listData.length; i++) {
              if (self.listData[i] === name) { prompt.showToast({ message: "已存在", duration: 300 }); return }
            }
            self.listData.push(name); self.saveData()
            prompt.showToast({ message: "已添加", duration: 300 })
          }
        }}
      ]
    })
  },
  onItemClick: function(idx) {
    if (this.swipedIdx !== -1) { this.swipedIdx = -1; return }
    this.showMenu(idx)
  },
  showMenu: function(idx) {
    var self = this; var item = this.listData[idx]; if (!item) return
    prompt.showDialog({
      title: item, message: "选择操作",
      buttons: [
        { text: "编辑", color: "#7ec8e3", onclick: function() { self.startEdit(idx) } },
        { text: "复制", color: "#7ec8e3", onclick: function() { self.copyItem(idx) } },
        { text: "删除", color: "#e74c3c", onclick: function() { self.confirmDelete(idx) } },
        { text: "取消", color: "#888899" }
      ]
    })
  },
  startEdit: function(idx) {
    var self = this; var item = this.listData[idx]
    prompt.showDialog({
      title: "编辑", message: "输入新名称", edittype: "text", value: item,
      buttons: [
        { text: "取消", color: "#888899" },
        { text: "保存", color: "#7ec8e3", onclick: function(_err, d) {
          if (d && d.value) {
            var nn = d.value.trim()
            if (nn && nn !== item) {
              for (var i = 0; i < self.listData.length; i++) {
                if (i !== idx && self.listData[i] === nn) { prompt.showToast({ message: "名称已存在", duration: 300 }); return }
              }
              self.listData[idx] = nn; self.saveData()
              prompt.showToast({ message: "已更新", duration: 300 })
            }
          }
        }}
      ]
    })
  },
  copyItem: function(idx) {
    var item = this.listData[idx]; var nn = item + " (副本)"; var ex = false
    for (var i = 0; i < this.listData.length; i++) { if (this.listData[i] === nn) { ex = true; break } }
    if (ex) {
      var c = 1
      while (true) {
        var tn = item + " (副本" + c + ")"; var fd = false
        for (var i = 0; i < this.listData.length; i++) { if (this.listData[i] === tn) { fd = true; break } }
        if (!fd) { nn = tn; break }
        c++
      }
    }
    this.listData.push(nn); this.saveData()
    prompt.showToast({ message: "已复制", duration: 300 })
  },
  confirmDelete: function(idx) {
    var self = this; var item = this.listData[idx]
    var removed = this.listData.splice(idx, 1)[0]
    this.swipedIdx = -1; this.saveData()
    prompt.showToast({ message: "已删除，点击撤销", duration: 3000 })
    this.undoItem = removed
    this.undoIdx = idx
    var self2 = self
    this.undoTimer = setTimeout(function() {
      self2.undoItem = null
      self2.undoIdx = -1
    }, 3000)
  },
  undoDelete: function() {
    if (!this.undoItem) return
    if (this.undoTimer) { clearTimeout(this.undoTimer) }
    this.listData.splice(this.undoIdx, 0, this.undoItem)
    this.undoItem = null
    this.undoIdx = -1
    this.saveData()
    prompt.showToast({ message: "已撤销", duration: 300 })
  },
  goBack: function() { router.back() },
  onTouchStart: function(e, _idx) {
    if (!e || !e.touches || e.touches.length === 0) return
    this.touchStartX = e.touches[0].clientX
  },
  onTouchEnd: function(e, idx) {
    if (!e || !e.changedTouches || e.changedTouches.length === 0) return
    var dx = e.changedTouches[0].clientX - this.touchStartX
    var adx = dx < 0 ? -dx : dx
    if (adx > 30) {
      if (dx < 0) { this.swipedIdx = idx }
      else { if (this.swipedIdx === idx) { this.swipedIdx = -1 } }
    }
  },
}
</script>
<style>
  .demo-page{flex-direction:column;padding:16px;height:100%}
  .header{flex-direction:row;align-items:center;padding:12px 4px;margin-bottom:8px}
  .back-btn{width:56px;height:44px;border-radius:10px;font-size:18px;text-align:center}
  .title{font-size:28px;font-weight:bold;margin-left:10px;flex:1}
  .add-row{flex-direction:row;align-items:center;padding:8px 0;margin-bottom:12px}
  .add-btn{flex:1;height:48px;border-radius:12px;font-size:20px;font-weight:bold;text-align:center}
  .quick-jump{padding:4px 8px;margin-bottom:6px;border-radius:8px}
  .jump-scroll{flex-direction:row;height:36px}
  .jump-num{width:32px;height:32px;border-radius:6px;font-size:14px;text-align:center;margin:0 2px}
  .list-scroll{flex:1;flex-direction:column}
  .list{flex-direction:column}
  .footer{padding:8px 0;border-top:1px solid;margin-top:8px;flex-direction:row;align-items:center;justify-content:space-between}
  .footer-text{font-size:16px}
  .undo-btn{height:36px;padding:0 16px;border-radius:18px;font-size:14px;text-align:center}
  .item-wrapper{flex-direction:row;align-items:center;margin-bottom:24px}
  .list-item{flex:1;flex-direction:row;justify-content:space-between;align-items:center}
  .delete-btn{width:72px;height:72px;background-color:#e74c3c;border-radius:10px;justify-content:center;align-items:center;margin-left:8px;flex-shrink:0}
  .delete-icon{font-size:18px;color:#ffffff}
  .minimal-name{flex:1}
  .minimal-idx{width:48px;text-align:right}
</style>