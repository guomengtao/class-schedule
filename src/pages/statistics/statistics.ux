    margin-left: 6px;
  }
  .overview {
    padding: 8px;
    margin-bottom: 4px;
  }
  .overview-number {
    font-size: 20px;
  }
  .overview-label {
    font-size: 10px;
  }
  .section {
    padding: 8px 10px;
    margin-bottom: 4px;
  }
  .section-title {
    font-size: 12px;
    margin-bottom: 4px;
  }
  .rank-item {
