  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 7px;
  margin: 0 8px;
}

.rank-bar {
  height: 100%;
  border-radius: 7px;
}

.rank-count {
  font-size: 12px;
  width: 24px;
  text-align: right;
}

.empty-text {
  font-size: 13px;
  text-align: center;
  padding: 12px 0;
}

@media (shape: capsule) {
  .stats-page {
    padding: 44px 8px 16px 8px;
  }
  .header {
    height: 30px;
    margin-bottom: 4px;
