<!--
  方形仿真机械表盘（watch-face-vibrate）
  ─────────────────────────────────────────────────────────────
  由「震动表盘」（大号数字钟）整页重写而来：方形表壳，盘内无任何圆形轮廓。
  震动功能完整保留（默认开、每 30s 一次），但按钮从表盘撤进长按面板 —— 按钮是拟真杀手。

  方表三条命门（见 docs/方形仿真机械表盘-方案.md §2）：
  ① 四边不等亮：上边最亮、左边次亮、右边中等、下边最暗（主光在左上）。
  ② 必须有倒角：外框 → 45° 倒角 → 盘框 → 盘面，四级下沉，每级用「错位同心方框」造。
  ③ 必须有方表零件：表冠（3 点位齿纹圆柱）、直线表耳、铁路分钟轨、双线框。

  刻度几何（方表与圆表的唯一差别）：
    圆表 P = C + (sinθ, -cosθ) × r
    方表 R(θ) = half / max(|sinθ|, |cosθ|)   ← 射线与方形边界求交
    于是 12/3/6/9 落在四条边的中点，1/2/10/11 自然落到角部并呈 45° 斜向 ——
    这正是真方表（Tank / Reverso）的观感，而不是「圆刻度环塞进方框」。

  走针方案（沿用 2026-10-19 实拍标定，不重新发明）：
    禁动态 transform → 120 档字面量 .rN；引擎轴 = 元素顶部中点 → 针必须「顶部中点压在盘心向下延伸」，
    rotate(180 + 3N) 才指向 θ；三层针共用同一档位 class，靠 left/top 固定偏移造立体。

  布局铁律：.page 只给 position:relative + 100%，子元素全部 absolute；不叠 flex 居中。
-->

<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">

    <!-- 顶部品牌区（陈列感） -->
    <text class="brand {{ brandCls }}">EV · MECHANICAL</text>
    <text class="brand-sub {{ bsubCls }}">SQUARE COLLECTION</text>

    <!-- 表耳：直线表耳，上下各一条，被表壳压住 4px -->
    <div class="lug lug-top {{ lugtCls }}"></div>
    <div class="lug lug-bottom {{ lugbCls }}"></div>

    <!-- 表壳 + 盘面：172×172，中心 (86,86) -->
    <div class="dial-wrap {{ dialCls }}" style="{{ dialStyle }}">

      <!-- 表冠：移进盘容器内，随盘一起缩放 —— 这样宽屏不用另算坐标。
           坐标已改为相对盘左上：left 180−10=170，top 187−112=75。
           画在表壳之前 → 被表壳压住左半，凸出 2px 的圆柱。 -->
      <div class="crown"></div>
      <div class="crown-rib c1"></div>
      <div class="crown-rib c2"></div>
      <div class="crown-rib c3"></div>

      <!-- 8 层错位同心方框：每层向内缩 2–6px，左上自动露 L 形倒角高光 -->
      <div class="case-outer"></div>
      <div class="case-shade"></div>
      <div class="bezel-hi"></div>
      <div class="bezel-lo"></div>
      <div class="bezel-in"></div>
      <div class="dial-rim"></div>
      <div class="dial-face"></div>
      <div class="dial-tex"></div>

      <!-- 四边异亮：上亮 / 左次亮 / 右中 / 下最暗（方表立体感的 70% 来自这里） -->
      <div class="edge edge-t"></div>
      <div class="edge edge-l"></div>
      <div class="edge edge-r"></div>
      <div class="edge edge-b"></div>

      <!-- 铁路分钟轨（chemin de fer）：盘面内缩 4px 的 1px 双线方框 -->
      <div class="rail rail-t"></div>
      <div class="rail rail-b"></div>
      <div class="rail rail-l"></div>
      <div class="rail rail-r"></div>
      <div class="rail2 r2t"></div>
      <div class="rail2 r2b"></div>
      <div class="rail2 r2l"></div>
      <div class="rail2 r2r"></div>

      <!-- 表圈螺钉 ×4（四角内凹，左上高光点） -->
      <div class="screw sc1"></div>
      <div class="screw-hi sc1h"></div>
      <div class="screw sc2"></div>
      <div class="screw-hi sc2h"></div>
      <div class="screw sc3"></div>
      <div class="screw-hi sc3h"></div>
      <div class="screw sc4"></div>
      <div class="screw-hi sc4h"></div>

      <!-- 蓝宝石反光：左上 45° 两条窄亮条，止于盘心（大片灰块会读成污渍） -->
      <div class="glare gl1"></div>
      <div class="glare gl2"></div>

      <!-- 48 分钟刻度：外端贴 R(θ)，长 4、宽 1（跳过 5 的倍数） -->
      <div class="mtick" style="left:92.3px;top:21px;transform:rotate(6deg)"></div>
      <div class="mtick" style="left:99.3px;top:21px;transform:rotate(12deg)"></div>
      <div class="mtick" style="left:106.6px;top:21px;transform:rotate(18deg)"></div>
      <div class="mtick" style="left:114.4px;top:21px;transform:rotate(24deg)"></div>
      <div class="mtick" style="left:132.7px;top:21px;transform:rotate(36deg)"></div>
      <div class="mtick" style="left:144px;top:21px;transform:rotate(42deg)"></div>
      <div class="mtick" style="left:150.5px;top:27.5px;transform:rotate(48deg)"></div>
      <div class="mtick" style="left:150.5px;top:38.8px;transform:rotate(54deg)"></div>
      <div class="mtick" style="left:150.5px;top:57.1px;transform:rotate(66deg)"></div>
      <div class="mtick" style="left:150.5px;top:64.9px;transform:rotate(72deg)"></div>
      <div class="mtick" style="left:150.5px;top:72.2px;transform:rotate(78deg)"></div>
      <div class="mtick" style="left:150.5px;top:79.2px;transform:rotate(84deg)"></div>
      <div class="mtick" style="left:150.5px;top:92.8px;transform:rotate(96deg)"></div>
      <div class="mtick" style="left:150.5px;top:99.8px;transform:rotate(102deg)"></div>
      <div class="mtick" style="left:150.5px;top:107.1px;transform:rotate(108deg)"></div>
      <div class="mtick" style="left:150.5px;top:114.9px;transform:rotate(114deg)"></div>
      <div class="mtick" style="left:150.5px;top:133.2px;transform:rotate(126deg)"></div>
      <div class="mtick" style="left:150.5px;top:144.5px;transform:rotate(132deg)"></div>
      <div class="mtick" style="left:144px;top:151px;transform:rotate(138deg)"></div>
      <div class="mtick" style="left:132.7px;top:151px;transform:rotate(144deg)"></div>
      <div class="mtick" style="left:114.4px;top:151px;transform:rotate(156deg)"></div>
      <div class="mtick" style="left:106.6px;top:151px;transform:rotate(162deg)"></div>
      <div class="mtick" style="left:99.3px;top:151px;transform:rotate(168deg)"></div>
      <div class="mtick" style="left:92.3px;top:151px;transform:rotate(174deg)"></div>
      <div class="mtick" style="left:78.7px;top:151px;transform:rotate(186deg)"></div>
      <div class="mtick" style="left:71.7px;top:151px;transform:rotate(192deg)"></div>
      <div class="mtick" style="left:64.4px;top:151px;transform:rotate(198deg)"></div>
      <div class="mtick" style="left:56.6px;top:151px;transform:rotate(204deg)"></div>
      <div class="mtick" style="left:38.3px;top:151px;transform:rotate(216deg)"></div>
      <div class="mtick" style="left:27px;top:151px;transform:rotate(222deg)"></div>
      <div class="mtick" style="left:20.5px;top:144.5px;transform:rotate(228deg)"></div>
      <div class="mtick" style="left:20.5px;top:133.2px;transform:rotate(234deg)"></div>
      <div class="mtick" style="left:20.5px;top:114.9px;transform:rotate(246deg)"></div>
      <div class="mtick" style="left:20.5px;top:107.1px;transform:rotate(252deg)"></div>
      <div class="mtick" style="left:20.5px;top:99.8px;transform:rotate(258deg)"></div>
      <div class="mtick" style="left:20.5px;top:92.8px;transform:rotate(264deg)"></div>
      <div class="mtick" style="left:20.5px;top:79.2px;transform:rotate(276deg)"></div>
      <div class="mtick" style="left:20.5px;top:72.2px;transform:rotate(282deg)"></div>
      <div class="mtick" style="left:20.5px;top:64.9px;transform:rotate(288deg)"></div>
      <div class="mtick" style="left:20.5px;top:57.1px;transform:rotate(294deg)"></div>
      <div class="mtick" style="left:20.5px;top:38.8px;transform:rotate(306deg)"></div>
      <div class="mtick" style="left:20.5px;top:27.5px;transform:rotate(312deg)"></div>
      <div class="mtick" style="left:27px;top:21px;transform:rotate(318deg)"></div>
      <div class="mtick" style="left:38.3px;top:21px;transform:rotate(324deg)"></div>
      <div class="mtick" style="left:56.6px;top:21px;transform:rotate(336deg)"></div>
      <div class="mtick" style="left:64.4px;top:21px;transform:rotate(342deg)"></div>
      <div class="mtick" style="left:71.7px;top:21px;transform:rotate(348deg)"></div>
      <div class="mtick" style="left:78.7px;top:21px;transform:rotate(354deg)"></div>

      <!-- 12 整点刻度：外端贴 R(θ)，长 9、宽 2 -->
      <div class="tick" style="left:85px;top:21px;transform:rotate(0deg)"></div>
      <div class="tick" style="left:122.5px;top:21px;transform:rotate(30deg)"></div>
      <div class="tick" style="left:150px;top:48.5px;transform:rotate(60deg)"></div>
      <div class="tick" style="left:150px;top:86px;transform:rotate(90deg)"></div>
      <div class="tick" style="left:150px;top:123.5px;transform:rotate(120deg)"></div>
      <div class="tick" style="left:122.5px;top:151px;transform:rotate(150deg)"></div>
      <div class="tick" style="left:85px;top:151px;transform:rotate(180deg)"></div>
      <div class="tick" style="left:47.5px;top:151px;transform:rotate(210deg)"></div>
      <div class="tick" style="left:20px;top:123.5px;transform:rotate(240deg)"></div>
      <div class="tick" style="left:20px;top:86px;transform:rotate(270deg)"></div>
      <div class="tick" style="left:20px;top:48.5px;transform:rotate(300deg)"></div>
      <div class="tick" style="left:47.5px;top:21px;transform:rotate(330deg)"></div>

      <!-- 夜光点：12 个，贴整点刻度内端 -->
      <div class="lume" style="left:85px;top:31px"></div>
      <div class="lume" style="left:117px;top:29.5px"></div>
      <div class="lume" style="left:140.5px;top:53px"></div>
      <div class="lume" style="left:139px;top:85px"></div>
      <div class="lume" style="left:140.5px;top:117px"></div>
      <div class="lume" style="left:117px;top:140.5px"></div>
      <div class="lume" style="left:85px;top:139px"></div>
      <div class="lume" style="left:53px;top:140.5px"></div>
      <div class="lume" style="left:29.5px;top:117px"></div>
      <div class="lume" style="left:31px;top:85px"></div>
      <div class="lume" style="left:29.5px;top:53px"></div>
      <div class="lume" style="left:53px;top:29.5px"></div>

      <!-- 阿拉伯时标（沿射线内缩 17）；3 点位置让给日期窗，不写 3 -->
      <text class="num num-lg" style="left:75px;top:30px">12</text>
      <text class="num" style="left:104px;top:27.7px">1</text>
      <text class="num" style="left:125.3px;top:49px">2</text>
      <text class="num" style="left:125.3px;top:107px">4</text>
      <text class="num" style="left:104px;top:128.3px">5</text>
      <text class="num num-lg" style="left:75px;top:126px">6</text>
      <text class="num" style="left:46px;top:128.3px">7</text>
      <text class="num" style="left:24.7px;top:107px">8</text>
      <text class="num num-lg" style="left:27px;top:78px">9</text>
      <text class="num" style="left:24.7px;top:49px">10</text>
      <text class="num" style="left:46px;top:27.7px">11</text>

      <!-- 盘面铭文：字很小、密度本身就是真实感 -->
      <text class="mark mark-brand">EV</text>
      <text class="mark mark-auto">AUTOMATIC</text>
      <text class="mark mark-jewels">36 JEWELS</text>

      <!-- 日期窗（3 点位，开窗而非贴纸）：金属框 + 内井 + 框上缘亮线 + 井内上缘暗线 -->
      <div class="date-frame"></div>
      <div class="date-well"></div>
      <div class="date-hl"></div>
      <div class="date-sh"></div>
      <text class="date-num">{{dayText}}</text>

      <!-- 三针：暗影（右下 +2）+ 主针 + 左缘高光，共用同一档位 class -->
      <div class="hand hour-sh {{hourCls}}"></div>
      <div class="hand hour {{hourCls}}"></div>
      <div class="hand-hl hour-hl {{hourCls}}"></div>

      <div class="hand minute-sh {{minuteCls}}"></div>
      <div class="hand minute {{minuteCls}}"></div>
      <div class="hand-hl minute-hl {{minuteCls}}"></div>

      <div class="hand second-sh {{secondCls}}"></div>
      <div class="hand second {{secondCls}}"></div>
      <div class="hand-hl second-hl {{secondCls}}"></div>

      <!-- 盘心轴：暗底 + 亮环 + 铆钉 -->
      <div class="hub-base"></div>
      <div class="hub-ring"></div>
      <div class="hub-dot"></div>
    </div>

    <!-- 底部：只留一行淡日期（32px 时间大字会把「实物表」打回「电子屏」） -->
    <text class="date-line" style="{{ dateStyle }}">{{dateText}}</text>
    <text class="hint" style="{{ hintStyle }}">长按设置</text>

    <!-- 设置面板：震动开关 + 倒计时（长按打开，避免表面出现按钮） -->
    <div class="mask" if="{{showPanel}}" onclick="closePanel">
      <div class="panel" onclick="keepPanel">
        <text class="p-title">方形机械表</text>
        <text class="p-time">{{timeText}}</text>
        <div class="p-div"></div>
        <text class="p-item" style="color: {{ vibrateOn ? '#8fe3b0' : '#8d949c' }}" onclick="toggleVibrate">{{vibrateLabel}}</text>
        <text class="p-count">{{countdownText}}</text>
        <div class="p-div"></div>
        <text class="p-cancel" onclick="closePanel">关闭</text>
      </div>
    </div>

    <text style="position:absolute;left:0;bottom:16px;width:100%;text-align:center;font-size:22px;color:#8d949c" onclick="onBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import device from "@system.device"

const storage = require("@system.storage")

const LIST_PAGE = "/pages/watch-face-list"
const VIBRATE_KEY = "wf_vibrate_30s"
const FULL_DAY = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]
const VIBRATE_INTERVAL = 30   // 秒
const LONG_PRESS_MS = 600     // 长按开门槛

function pad2(n) {
  return (n < 10 ? "0" : "") + n
}

// 角度 → 120 档类名（3°/档）。引擎轴在顶部中点，故 .rN 内部为 rotate(180 + 3N)
function stepClass(deg) {
  let step = Math.round(deg / 3) % 120
  if (step < 0) step += 120
  return "r" + step
}

export default {
  data: {
    hourCls: "r0",
    minuteCls: "r0",
    secondCls: "r0",
    timeText: "--:--",
    dateText: "",
    dayText: "1",
    showPanel: false,
    suppressTap: false,
    vibrateOn: true,                      // 用户指定：默认打开
    vibrateLabel: "震动 30秒：开",
    countdownText: "下次震动 30s",
    /* 屏型标记：192 屏全部空串（零变化），336 屏才填值。
       位置类走 style 绑定（探针已验证 left/top 可绑），样式类走单类选择器。 */
    dialCls: "",
    dialStyle: "",
    lugtCls: "",
    lugbCls: "",
    brandCls: "",
    bsubCls: "",
    dateStyle: "",
    hintStyle: "",
  },

  onInit() {
    this.fitScreen()
    this.loadVibrate()
    this.syncHands()
    this.tick()
  },

  onReady() {
    this.startTimer()
  },

  onShow() {
    this.syncHands()
    this.tick()
    this.startTimer()
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  /* ── 屏型适配：192 屏一个字段都不填（零回归），336 屏才填 8 个标记 ──
     盘内 140 个节点一个坐标不改：宽屏靠 .w-dial 的 scale(1.674) 整体放大，
     探针实测父级 scale 会带动绝对定位子块、子块 left/top 按比例缩放，
     所以刻度方框半径 / 表壳四级内缩 / 字号全部自动等比。 */
  fitScreen() {
    const self = this
    try {
      device.getInfo({
        success: function (d) {
          const w = (d && d.screenWidth) || 0
          if (w < 300) return          /* 192 屏：一个字段都不填，零回归 */
          self.dialCls = "w-dial"
          self.dialStyle = "left:24px;top:96px;"
          self.lugtCls = "w-lug w-lugt"
          self.lugbCls = "w-lug w-lugb"
          self.brandCls = "w-brand"
          self.bsubCls = "w-bsub"
          self.dateStyle = "top:392px;"
          self.hintStyle = "top:424px;"
        }
      })
    } catch (e) {}
    /* ⚠️ 必须用异步回调形式。实测同步 device.getInfo() 拿到的 screenWidth
       在 192 屏上会 ≥300，导致小屏误套宽屏样式（盘心从 110 跑到 167）。 */
  },

  /* ── 1s 心跳：时间 + 走针 + 震动计数 ── */
  startTimer() {
    this.stopTimer()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
      if (!self.vibrateOn) return
      self.tickCount = (self.tickCount || 0) + 1
      if (self.tickCount >= VIBRATE_INTERVAL) {
        self.tickCount = 0
        self.fireVibrate()
      }
      if (self.showPanel) self.updateCountdown()
    }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
    this.tickCount = 0
  },

  /* ── 走针：当前时刻 → 三针角度 → 120 档 class ── */
  syncHands() {
    const now = new Date()
    const h = now.getHours() % 12
    const m = now.getMinutes()
    const s = now.getSeconds()

    var hc = stepClass((h + m / 60 + s / 3600) * 30)
    var mc = stepClass((m + s / 60) * 6)
    var sc = stepClass(s * 6)
    // 脏值判断：Vela 每次赋值 = 一轮全树 diff + 整屏重绘，且同帧不合并 ——
    // 不判脏就是 6 次/秒重绘，肉眼即「整页闪」。
    if (hc !== this.hourCls) this.hourCls = hc
    if (mc !== this.minuteCls) this.minuteCls = mc
    if (sc !== this.secondCls) this.secondCls = sc
  },

  tick() {
    const now = new Date()
    var t = pad2(now.getHours()) + ":" + pad2(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
    var d = pad2(now.getMonth() + 1) + "-" + pad2(now.getDate()) + " " + FULL_DAY[now.getDay()]
    if (d !== this.dateText) this.dateText = d
    var day = pad2(now.getDate())
    if (day !== this.dayText) this.dayText = day
    this.syncHands()
  },

  /* ── 震动：单次 vibrate 不占振动任务；API 缺失一律 try/catch 吃掉 ── */
  fireVibrate(mode) {
    try {
      vibrator.vibrate({
        mode: mode || "long",
        fail: function() {}
      })
    } catch (e) {}
  },

  updateCountdown() {
    if (!this.showPanel) return
    if (!this.vibrateOn) {
      this.countdownText = "震动已关闭"
      return
    }
    this.countdownText = "下次震动 " + (VIBRATE_INTERVAL - (this.tickCount || 0)) + "s"
  },

  toggleVibrate() {
    this.guardTap()
    this.vibrateOn = !this.vibrateOn
    this.vibrateLabel = this.vibrateOn ? "震动 30秒：开" : "震动 30秒：关"
    this.tickCount = 0
    this.updateCountdown()
    this.saveVibrate(this.vibrateOn)
    // 开关各回执一下：开 → 长震，关 → 短震
    this.fireVibrate(this.vibrateOn ? "long" : "short")
  },

  /* ── 持久化：震动开关（取不到历史时保持 true） ── */
  loadVibrate() {
    const self = this
    try {
      storage.get({
        key: VIBRATE_KEY,
        success: function(res) {
          if (res && res.value !== undefined && res.value !== null) {
            const v = (res.value === false || res.value === "false") ? false : true
            self.vibrateOn = v
            self.vibrateLabel = v ? "震动 30秒：开" : "震动 30秒：关"
          }
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  saveVibrate(on) {
    try {
      storage.set({ key: VIBRATE_KEY, value: on ? "true" : "false" })
    } catch (e) {}
  },

  /* ── 触摸：长按开面板 / 上下滑切表盘 / 单击返回 ── */
  onTouchStart(e) {
    const t = (e && e.touches && e.touches[0]) || e || {}
    this.pressTs = Date.now()
  },

  onTouchEnd(e) {
    const t = (e && e.touches && e.touches[0]) || (e && e.changedTouches && e.changedTouches[0]) || e || {}
    const held = this.pressTs ? (Date.now() - this.pressTs) : 0

    this.pressTs = 0

    // 已移除「上下滑切表盘」：本页只保留长按开设置面板（guardTap 会挡住随后的 click）
    if (held >= LONG_PRESS_MS) {
      this.openPanel()
    }
  },

  /* 挡住整页点击：面板、开关按钮共用 */
  guardTap() {
    this.suppressTap = true
    const self = this
    setTimeout(function() {
      self.suppressTap = false
    }, 300)
  },

  openPanel() {
    this.guardTap()
    this.showPanel = true
    this.updateCountdown()
  },

  closePanel() {
    this.showPanel = false
    this.guardTap()
  },

  keepPanel() {
    this.guardTap()
  },

  /* 返回目录（按钮，系列统一；已移除点击空白返回 / 上下滑切表盘） */
  onBack() {
    this.stopTimer()
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

