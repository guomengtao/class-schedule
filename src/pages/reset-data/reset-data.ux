<template>
  <div class="reset-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">恢复默认数据</text>
    </div>

    <div class="warning-section" style="background-color: {{ theme.card }}">
      <text class="warning-icon" style="color: {{ theme.accent }}">▲</text>
      <text class="warning-title" style="color: {{ theme.accent }}">重要提示</text>
      <text class="warning-text" style="color: {{ theme.textSecondary }}">以下操作将覆盖您当前的课程数据。</text>
      <text class="warning-text" style="color: {{ theme.textSecondary }}">您自己添加、修改的所有课程都可能丢失。</text>
      <text class="warning-text" style="color: {{ theme.deleteText }}">请仔细阅读每个操作的说明，谨慎操作！</text>
    </div>

    <div class="preview-section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">默认课程列表（共12门）</text>
      <div class="course-grid">
        <div class="course-tag" for="{{ defaultCourses }}" style="background-color: {{ theme.cardLight }}">
          <text class="course-tag-num" style="color: {{ theme.accent }}">{{ $idx + 1 }}</text>
          <text class="course-tag-name" style="color: {{ theme.text }}">{{ $item }}</text>
        </div>
      </div>
    </div>

    <div class="action-section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">操作一：恢复默认课程</text>
      <text class="action-desc" style="color: {{ theme.textSecondary }}">仅重置课程名称列表为默认12门课程（语文、数学、英语、物理、化学、政治、音乐、体育、美术、历史、地理、生物），不影响已有的课程表和课程安排。</text>
      <text class="action-warn" style="color: {{ theme.deleteText }}">!! 您自定义的课程名称将被覆盖</text>

      <input class="action-btn {{ presetConfirm ? 'danger' : '' }}" type="button"
             value="{{ presetConfirm ? '!! 再次点击确认恢复' : '恢复默认课程' }}"
             onclick="handleResetPresets"
             style="background-color: {{ presetConfirm ? theme.deleteText : theme.accent }}; color: {{ presetConfirm ? '#ffffff' : theme.bg }}" />

      <text class="reset-hint" if="{{ presetConfirm }}" style="color: {{ theme.deleteText }}">请再次点击按钮确认恢复默认课程</text>
      <text class="reset-hint" if="{{ !presetConfirm }}" style="color: {{ theme.textMuted }}">点击按钮后需要二次确认才会执行</text>
      <text class="result-text" if="{{ presetDone }}" style="color: {{ theme.accent }}">默认课程已恢复成功！</text>
    </div>

    <div class="action-section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">操作二：一键重置全部</text>
      <text class="action-desc" style="color: {{ theme.textSecondary }}">将所有数据恢复为默认状态，包括：2张课程表（周一至周五，每天8节课）、12门课程随机分配、课程名称列表恢复默认。</text>
      <text class="action-warn" style="color: {{ theme.deleteText }}">!! 所有课程安排、课程表名称、课程名称列表都将被覆盖，此操作不可撤销！</text>

      <input class="action-btn {{ fullConfirm ? 'danger' : '' }}" type="button"
             value="{{ fullConfirm ? '!! 再次点击确认全部重置' : '一键重置全部' }}"
             onclick="handleResetAll"
             style="background-color: {{ fullConfirm ? theme.deleteText : theme.accent }}; color: {{ fullConfirm ? '#ffffff' : theme.bg }}" />

      <text class="reset-hint" if="{{ fullConfirm }}" style="color: {{ theme.deleteText }}">请再次点击按钮确认全部重置</text>
      <text class="reset-hint" if="{{ !fullConfirm }}" style="color: {{ theme.textMuted }}">点击按钮后需要二次确认才会执行</text>
      <text class="result-text" if="{{ fullDone }}" style="color: {{ theme.accent }}">全部数据已重置成功！请返回首页查看。</text>
    </div>

    <div class="action-section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">操作三：重置为空</text>
      <text class="action-desc" style="color: {{ theme.textSecondary }}">清除所有数据，恢复为空白状态。不包含任何默认课程和课程表，方便从零开始自定义。</text>
      <text class="action-warn" style="color: {{ theme.deleteText }}">!! 所有课程安排、课程表名称、课程名称列表都将被清空，此操作不可撤销！</text>

      <input class="action-btn {{ emptyConfirm ? 'danger' : '' }}" type="button"
             value="{{ emptyConfirm ? '!! 再次点击确认重置为空' : '重置为空' }}"
             onclick="handleResetEmpty"
             style="background-color: {{ emptyConfirm ? theme.deleteText : theme.accent }}; color: {{ emptyConfirm ? '#ffffff' : theme.bg }}" />

      <text class="reset-hint" if="{{ emptyConfirm }}" style="color: {{ theme.deleteText }}">请再次点击按钮确认重置为空</text>
      <text class="reset-hint" if="{{ !emptyConfirm }}" style="color: {{ theme.textMuted }}">点击按钮后需要二次确认才会执行</text>
      <text class="result-text" if="{{ emptyDone }}" style="color: {{ theme.accent }}">已重置为空！请返回首页开始自定义。</text>
    </div>

    <div class="overlay-modal" show="{{ showDialog }}">
      <div class="modal-card" style="background-color: {{ theme.card }}">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁高级功能</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">一次性解锁，永久使用全部高级功能</text>
        <div class="benefit-list">
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多课表管理</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
        </div>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="暂不需要" onclick="goBack"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var presetTimer = null
var fullTimer = null
var emptyTimer = null

export default {
  private: {
    theme: store.DEFAULT_THEME,
    defaultCourses: [
      "语文", "数学", "英语", "物理", "化学", "政治",
      "音乐", "体育", "美术", "历史", "地理", "生物"
    ],
    presetConfirm: false,
    presetDone: false,
    fullConfirm: false,
    fullDone: false,
    emptyConfirm: false,
    emptyDone: false,
    showDialog: false
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },
  onReady() {
    console.log("[RESET-DATA] onReady: checking premium...")
    this.checkAndShowOverlay()
  },

  handleResetPresets() {
    if (!this.presetConfirm) {
      this.presetConfirm = true
      var self = this
      presetTimer = setTimeout(function() {
        self.presetConfirm = false
      }, 5000)
      return
    }

    if (presetTimer) {
      clearTimeout(presetTimer)
      presetTimer = null
    }

    var self = this
    database.resetCoursePresets(function(err) {
      self.presetConfirm = false
      self.presetDone = true
      if (!err) {
        prompt.showToast({ message: "默认课程已恢复" })
        console.log("[RESET] Course presets restored successfully")
      } else {
        prompt.showToast({ message: "恢复失败: " + err })
      }
    })
  },

  handleResetAll() {
    if (!this.fullConfirm) {
      this.fullConfirm = true
      var self = this
      fullTimer = setTimeout(function() {
        self.fullConfirm = false
      }, 5000)
      return
    }

    if (fullTimer) {
      clearTimeout(fullTimer)
      fullTimer = null
    }

    var self = this
    database.resetToDemoData(function(err) {
      database.resetCoursePresets(function(presetErr) {
        self.fullConfirm = false
        self.fullDone = true
        if (!err && !presetErr) {
          prompt.showToast({ message: "全部数据已重置" })
          console.log("[RESET] Full demo data restored successfully")
        } else {
          prompt.showToast({ message: "重置失败: " + (err || presetErr) })
        }
      })
    })
  },

  handleResetEmpty() {
    if (!this.emptyConfirm) {
      this.emptyConfirm = true
      var self = this
      emptyTimer = setTimeout(function() {
        self.emptyConfirm = false
      }, 5000)
      return
    }

    if (emptyTimer) {
      clearTimeout(emptyTimer)
      emptyTimer = null
    }

    var self = this
    database.resetToEmpty(function(err) {
      self.emptyConfirm = false
      self.emptyDone = true
      if (!err) {
        prompt.showToast({ message: "已重置为空" })
        console.log("[RESET] Empty reset completed successfully")
      } else {
        prompt.showToast({ message: "重置失败: " + err })
      }
    })
  },

  checkAndShowOverlay() {
    console.log("[RESET-DATA] checkAndShowOverlay: checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (!unlocked) {
        console.log("[RESET-DATA] checkAndShowOverlay: not premium, showing dialog")
        self.showDialog = true
      }
    })
  },

  goToPremium() {
    console.log("[RESET-DATA] goToPremium: navigating to activation")
    this.showDialog = false
    router.push({ uri: "/pages/activation" })
  },

  goBack() {
    if (presetTimer) {
      clearTimeout(presetTimer)
      presetTimer = null
    }
    if (fullTimer) {
      clearTimeout(fullTimer)
      fullTimer = null
    }
    if (emptyTimer) {
      clearTimeout(emptyTimer)
      emptyTimer = null
    }
    router.back()
  }
}
</script>

<style>
