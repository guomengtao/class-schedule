<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 页头（2026-11-03 迁移到 common/header.css 的 .hdr 胶囊）
         原先是「方块返回键 + 居中标题 + 等宽占位」三件套，与 settings / 总课表 两页不一致。
         .hdr 自带居中，不再需要占位元素凑对称；旧骨架类一律不再本页定义。 -->
    <div class="hdr rd-hdr">
      <div class="hdr-pill" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="hdr-pill-ic" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        <text class="hdr-pill-t" style="color: {{ theme.text }}">重置数据</text>
      </div>
    </div>

    <!-- 内容超过 1 屏（3 张操作卡 + 12 个课程标签 ≈ 1.5 屏），必须滚动。
         ev-six §7.7：允许 1.5 屏，但禁止靠压字号塞进一屏。 -->
    <scroll class="body-scroll" scroll-y="{{true}}">
      <!-- 提示卡：原文 3 行 13/11 字，24px 下行宽 312px、192 屏必折行后被 lines:1 硬裁。
           按 ev-six §7.2 单行 ≤6 位置压成两行，信息不丢：「覆盖」+「不可撤销」。 -->
      <div class="card warn-card" style="background-color: {{ theme.card }}">
        <text class="warn-title" style="color: {{ theme.deleteText }}">▲ 不可撤销</text>
        <text class="warn-line" style="color: {{ theme.textSecondary }}">数据将被覆盖</text>
      </div>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">默认课程</text>
        <div class="course-grid">
          <text class="course-tag" for="{{ defaultCourses }}" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}">{{ $item }}</text>
        </div>
      </div>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">恢复默认</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">只改课程名</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">课表不变</text>

        <div class="act-btn" onclick="handleResetPresets"
             style="background-color: {{ presetConfirm ? theme.deleteText : theme.accent }}">
          <text class="act-btn-text" style="color: {{ presetConfirm ? theme.text : theme.bg }}">{{ presetConfirm ? '确认恢复' : '恢复默认' }}</text>
        </div>
        <text class="act-hint" style="color: {{ presetConfirm ? theme.deleteText : theme.textMuted }}">{{ presetConfirm ? '再次点击确认' : '需二次确认' }}</text>
        <text class="act-done" if="{{ presetDone }}" style="color: {{ theme.accent }}">已恢复</text>
      </div>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">全部重置</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">回到初始状态</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">2 张课表 12 门课</text>

        <div class="act-btn" onclick="handleResetAll"
             style="background-color: {{ fullConfirm ? theme.deleteText : theme.accent }}">
          <text class="act-btn-text" style="color: {{ fullConfirm ? theme.text : theme.bg }}">{{ fullConfirm ? '确认重置' : '全部重置' }}</text>
        </div>
        <text class="act-hint" style="color: {{ fullConfirm ? theme.deleteText : theme.textMuted }}">{{ fullConfirm ? '再次点击确认' : '需二次确认' }}</text>
        <text class="act-done" if="{{ fullDone }}" style="color: {{ theme.accent }}">已重置</text>
      </div>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">重置为空</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">清空全部数据</text>
        <text class="card-desc" style="color: {{ theme.textSecondary }}">从零开始自建</text>

        <div class="act-btn" onclick="handleResetEmpty"
             style="background-color: {{ emptyConfirm ? theme.deleteText : theme.accent }}">
          <text class="act-btn-text" style="color: {{ emptyConfirm ? theme.text : theme.bg }}">{{ emptyConfirm ? '确认清空' : '重置为空' }}</text>
        </div>
        <text class="act-hint" style="color: {{ emptyConfirm ? theme.deleteText : theme.textMuted }}">{{ emptyConfirm ? '再次点击确认' : '需二次确认' }}</text>
        <text class="act-done" if="{{ emptyDone }}" style="color: {{ theme.accent }}">已清空</text>
      </div>

      <div class="scroll-tail"></div>
    </scroll>

    <!-- 升级引导弹层（2026-11-03 重构）
         ① 行为：原先 onReady 里 checkAndShowOverlay() 会「进页即弹」，把只读浏览也打断。
            现改为「点击三个重置按钮时才弹」——先判权限，未解锁则弹窗并中止本次操作。
            权限状态在 onInit/onShow 预取（refreshPremium），点击路径同步判定，
            不重演 backup-restore 记录的「点击后等异步回调，等于石沉大海」。
         ② 形态：对齐 unlock-dialog 组件的标准规格，但**不套该组件**——
            backup-restore.ux 已实测：store 单例存的是页面栈下方某页的实例，
            show() 返回 true 却看不到弹窗。本页自绘，零共享状态，与备份页同一路线。 -->
    <div class="upgrade-screen" if="{{ showUpgrade }}" onclick="closeUpgrade">
      <div class="upgrade-card" onclick="stopBubble" style="background-color: {{ theme.card }}">
        <text class="upgrade-title" style="color: {{ theme.accent }}">解锁高级版</text>
        <text class="upgrade-desc" style="color: {{ theme.textSecondary }}">一次购买 永久可用</text>

        <div class="upgrade-benefits">
          <div class="upgrade-benefit-row" for="{{ upgradeBenefits }}">
            <text class="upgrade-benefit-mark" style="color: {{ theme.accent }}">✓</text>
            <text class="upgrade-benefit-text" style="color: {{ theme.text }}">{{ $item }}</text>
          </div>
        </div>

        <div class="upgrade-btn upgrade-btn-primary" onclick="goActivate" style="background-color: {{ theme.accent }}">
          <text class="upgrade-btn-text" style="color: {{ theme.bg }}">立即解锁</text>
        </div>
        <div class="upgrade-btn upgrade-btn-cancel" style="background-color: {{ theme.btnSecondary }}" onclick="closeUpgrade">
          <text class="upgrade-btn-text" style="color: {{ theme.btnSecondaryText }}">继续标准版</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var presetTimer = null
var fullTimer = null
var emptyTimer = null

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    defaultCourses: [
      "语文", "数学", "英语", "物理", "化学", "政治",
      "音乐", "体育", "美术", "历史", "地理", "生物"
    ],
    presetConfirm: false,
    presetDone: false,
    fullConfirm: false,
    fullDone: false,
    emptyConfirm: false,
    emptyDone: false,
    // 解锁引导：默认关闭。整页默认不弹任何弹窗，只有点按钮且未解锁时才开。
    showUpgrade: false,
    isPremium: false,
    premiumChecked: false,
    upgradeBenefits: ["多课表管理", "数据备份", "首页自定义", "多套主题"]
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.refreshPremium()
  },

  // 会员状态「进页预取 + 点击时同步判定」：点击路径零异步依赖。
  // 原实现在 onReady 里查完就直接弹窗，正是「默认弹出」的来源，已删除。
  refreshPremium() {
    var self = this
    store.isPremiumUnlocked(function(u) {
      self.isPremium = !!u
      self.premiumChecked = true
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.refreshPremium()
  },

  // 三个重置入口共用的权限闸：未解锁 → 弹升级引导并中止本次点击
  guardPremium() {
    if (this.isPremium) return true
    this.showUpgrade = true
    if (!this.premiumChecked) this.refreshPremium()
    return false
  },

  handleResetPresets() {
    if (!this.guardPremium()) return
    if (!this.presetConfirm) {
      this.presetConfirm = true
      var self = this
      presetTimer = setTimeout(function() {
        self.presetConfirm = false
      }, 5000)
      return
    }

    if (presetTimer) {
      clearTimeout(presetTimer)
      presetTimer = null
    }

    var self = this
    database.resetCoursePresets(function(err) {
      self.presetConfirm = false
      self.presetDone = true
      if (!err) {
        prompt.showToast({ message: "默认课程已恢复" })
        dlog("[RESET] Course presets restored successfully")
      } else {
        prompt.showToast({ message: "恢复失败: " + err })
      }
    })
  },

  handleResetAll() {
    if (!this.guardPremium()) return
    if (!this.fullConfirm) {
      this.fullConfirm = true
      var self = this
      fullTimer = setTimeout(function() {
        self.fullConfirm = false
      }, 5000)
      return
    }

    if (fullTimer) {
      clearTimeout(fullTimer)
      fullTimer = null
    }

    var self = this
    database.resetToDemoData(function(err) {
      database.resetCoursePresets(function(presetErr) {
        self.fullConfirm = false
        self.fullDone = true
        if (!err && !presetErr) {
          prompt.showToast({ message: "全部数据已重置" })
          dlog("[RESET] Full demo data restored successfully")
        } else {
          prompt.showToast({ message: "重置失败: " + (err || presetErr) })
        }
      })
    })
  },

  handleResetEmpty() {
    if (!this.guardPremium()) return
    if (!this.emptyConfirm) {
      this.emptyConfirm = true
      var self = this
      emptyTimer = setTimeout(function() {
        self.emptyConfirm = false
      }, 5000)
      return
    }

    if (emptyTimer) {
      clearTimeout(emptyTimer)
      emptyTimer = null
    }

    var self = this
    database.resetToEmpty(function(err) {
      self.emptyConfirm = false
      self.emptyDone = true
      if (!err) {
        prompt.showToast({ message: "已重置为空" })
        dlog("[RESET] Empty reset completed successfully")
      } else {
        prompt.showToast({ message: "重置失败: " + err })
      }
    })
  },

  goActivate() {
    this.showUpgrade = false
    this.clearTimers()
    router.push({ uri: "/pages/activation" })
  },

  closeUpgrade() {
    this.showUpgrade = false
  },

  stopBubble() {
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  // 返回优先级：升级弹层开着时先收弹层，不要把整页弹掉（同 backup-restore 的教训）。
  // 只在真的关掉弹层时 return true，其余交还系统默认返回，避免「退不出去」。
  onBackPress() {
    if (this.showUpgrade) {
      this.showUpgrade = false
      return true
    }
    return false
  },

  clearTimers() {
    if (presetTimer) {
      clearTimeout(presetTimer)
      presetTimer = null
    }
    if (fullTimer) {
      clearTimeout(fullTimer)
      fullTimer = null
    }
    if (emptyTimer) {
      clearTimeout(emptyTimer)
      emptyTimer = null
    }
  },

  goBack() {
    this.clearTimers()
    router.back()
  },

  onDestroy() {
    this.clearTimers()
  }
}
</script>

<style>
@import '../../common/header.css';

/* 基准值 = 胶囊屏（192×490）的正确形态，@media 只负责在大屏放大。
   媒体查询若整条不命中，最坏只是字小一圈，不会形态错乱。 */

.page {
  flex-direction: column;
  padding: 0;
  width: 100%;
  height: 100%;
}

/* 页头只补本页独有的外距，**不重定义 .hdr** ——
   week-view 那轮已经踩过：页面本地与公共类同名会静默整体覆盖，
   导致 flex 居中丢失、胶囊被顶到左边。故另起 .rd-hdr 叠加。 */
.rd-hdr {
  padding: 0 12px;
  margin-top: 12px;
}

.body-scroll {
  flex: 1;
  flex-direction: column;
  padding: 0 12px;
}

/* 卡片内距 8：ev-six 留白税要求卡片 ≤8（原 12 在 168 可用宽里白扔 24px） */
.card {
  flex-direction: column;
  border-radius: 12px;
  padding: 8px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.warn-card {
  align-items: center;
}

.warn-title {
  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
  lines: 1;
  margin-bottom: 2px;
}

.warn-line {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}

.card-title {
  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
  lines: 1;
  margin-bottom: 4px;
}

/* 说明行：24px 是 ev-six 绝对下限，原 22px（胶囊屏）/ 20px（弹窗）一律作废 */
.card-desc {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}

/* 12 个标签排 3 列：内容宽 168 − 卡片内距 16 = 152。
   首版取 50：50×3 + margin 6 = 156 超 152，实测只排下 2 列。
   收到 48：48×3 + 6 = 150 ≤ 152，3 列成立；2 字 @24 ≈46px 仍放得下。
   序号徽标按 ev-six §7.3「装饰优先省掉」删除。 */
.course-grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.course-tag {
  width: 48px;
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  border-radius: 8px;
  padding: 3px 0;
  margin: 0 1px 4px 1px;
}

/* 按钮 44 高：手环触摸目标下限，与全项目一致 */
.act-btn {
  width: 100%;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin-top: 6px;
  flex-shrink: 0;
}

.act-btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
  lines: 1;
  text-align: center;
}

.act-hint {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  text-align: center;
  margin-top: 4px;
}

.act-done {
  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
  lines: 1;
  text-align: center;
  margin-top: 4px;
}

/* 底部留白：让最后一张卡片不贴屏幕下缘被圆弧压到 */
.scroll-tail {
  height: 12px;
  flex-shrink: 0;
}

/* ── 升级引导弹层 ──
   绝对定位铺满根容器（.page 无 padding，故不与内容盒错位）。 */
.upgrade-screen {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px 12px;
  z-index: 1000;
}

.upgrade-card {
  width: 100%;
  border-radius: 14px;
  padding: 12px 8px;
  flex-direction: column;
  align-items: center;
}

.upgrade-title {
  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
  lines: 1;
  margin-bottom: 4px;
}

.upgrade-desc {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  margin-bottom: 8px;
}

.upgrade-benefits {
  width: 100%;
  flex-direction: column;
  margin-bottom: 10px;
}

.upgrade-benefit-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.upgrade-benefit-mark {
  width: 24px;
  font-size: 24px;
  line-height: 30px;
  text-align: center;
  flex-shrink: 0;
}

.upgrade-benefit-text {
  flex: 1;
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}

.upgrade-btn {
  width: 100%;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.upgrade-btn-primary {
  margin-bottom: 8px;
}

.upgrade-btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
  lines: 1;
  text-align: center;
}

/* ── 方屏 / 圆屏放大 ── */
@media (shape: rect) {
  .rd-hdr {
    padding: 0 12px;
    margin-top: 8px;
  }
  .body-scroll {
    padding: 0 12px;
  }
  .card {
    padding: 10px;
    margin-bottom: 10px;
  }
  .warn-title {
    font-size: 30px;
    line-height: 38px;
  }
  .warn-line {
    font-size: 26px;
    line-height: 34px;
  }
  .card-title {
    font-size: 30px;
    line-height: 38px;
  }
  .card-desc {
    font-size: 26px;
    line-height: 34px;
  }
  .course-tag {
    width: 74px;
    font-size: 26px;
    line-height: 34px;
    padding: 4px 0;
    margin: 0 2px 6px 2px;
  }
  .act-btn {
    height: 50px;
    border-radius: 25px;
  }
  .act-btn-text {
    font-size: 30px;
    line-height: 38px;
  }
  .act-hint {
    font-size: 26px;
    line-height: 32px;
  }
  .act-done {
    font-size: 30px;
    line-height: 38px;
  }
  .upgrade-screen {
    padding: 60px 60px;
  }
  .upgrade-card {
    padding: 18px 16px;
  }
  .upgrade-title {
    font-size: 32px;
    line-height: 40px;
  }
  .upgrade-desc {
    font-size: 26px;
    line-height: 34px;
    margin-bottom: 12px;
  }
  .upgrade-benefit-mark,
  .upgrade-benefit-text {
    font-size: 26px;
    line-height: 34px;
  }
  .upgrade-btn {
    height: 50px;
    border-radius: 25px;
  }
  .upgrade-btn-text {
    font-size: 30px;
    line-height: 38px;
  }
}

@media (shape: circle) {
  .rd-hdr {
    padding: 0 36px;
    margin-top: 40px;
  }
  .body-scroll {
    padding: 0 36px;
  }
  .card {
    padding: 10px;
    margin-bottom: 10px;
  }
  .warn-title {
    font-size: 30px;
    line-height: 38px;
  }
  .warn-line {
    font-size: 26px;
    line-height: 34px;
  }
  .card-title {
    font-size: 30px;
    line-height: 38px;
  }
  .card-desc {
    font-size: 26px;
    line-height: 34px;
  }
  .course-tag {
    width: 74px;
    font-size: 26px;
    line-height: 34px;
    padding: 4px 0;
    margin: 0 2px 6px 2px;
  }
  .act-btn {
    height: 50px;
    border-radius: 25px;
  }
  .act-btn-text {
    font-size: 30px;
    line-height: 38px;
  }
  .act-hint {
    font-size: 26px;
    line-height: 32px;
  }
  .act-done {
    font-size: 30px;
    line-height: 38px;
  }
  .upgrade-screen {
    padding: 60px 60px;
  }
  .upgrade-card {
    padding: 18px 16px;
  }
  .upgrade-title {
    font-size: 32px;
    line-height: 40px;
  }
  .upgrade-desc {
    font-size: 26px;
    line-height: 34px;
    margin-bottom: 12px;
  }
  .upgrade-benefit-mark,
  .upgrade-benefit-text {
    font-size: 26px;
    line-height: 34px;
  }
  .upgrade-btn {
    height: 50px;
    border-radius: 25px;
  }
  .upgrade-btn-text {
    font-size: 30px;
    line-height: 38px;
  }
}
</style>
