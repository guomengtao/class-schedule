<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">添加课程(胶囊)</text>
    </div>

    <div class="step-dots">
      <div class="dot {{ step >= 1 ? 'dot-active' : '' }}" style="background-color: {{ step >= 1 ? theme.accent : theme.border }}"></div>
      <div class="dot-line {{ step >= 2 ? 'line-active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></div>
      <div class="dot {{ step >= 2 ? 'dot-active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></div>
      <div class="dot-line {{ step >= 3 ? 'line-active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></div>
      <div class="dot {{ step >= 3 ? 'dot-active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></div>
      <div class="dot-line {{ step >= 4 ? 'line-active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></div>
      <div class="dot {{ step >= 4 ? 'dot-active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></div>
    </div>

    <div class="form-body" if="{{ step === 1 }}">
      <text class="step-heading" style="color: {{ theme.text }}">选择课程</text>
      <text class="step-sub" style="color: {{ theme.textSecondary }}">共 {{ presetCourses.length }} 门</text>

      <div class="swiper-row">
        <input class="arrow-btn" type="button" value="◀" onclick="swipePrev"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <div class="course-card" onclick="swipeNext" style="background-color: {{ theme.card }}">
          <text class="card-name" style="color: {{ theme.text }}">{{ presetCourses[courseIndex].name }}</text>
        </div>
        <input class="arrow-btn" type="button" value="▶" onclick="swipeNext"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>

      <text class="index-text" style="color: {{ theme.textMuted }}">{{ courseIndex + 1 }} / {{ presetCourses.length }}</text>

      <div class="nav-row">
        <input class="manage-btn" type="button" value="管理" onclick="openCourseManager"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-body" if="{{ step === 2 }}">
      <text class="step-heading" style="color: {{ theme.text }}">时间 · {{ courseName }}</text>

      <scroll class="time-scroll" scroll-y="true">
        <text class="time-label" style="color: {{ theme.text }}">开始时间</text>
        <div class="time-card" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ startHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">分</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ startMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

        <text class="time-label" style="color: {{ theme.text }}">结束时间</text>
        <div class="time-card" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ endHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">分</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ endMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>
      </scroll>

      <div class="nav-row">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-body" if="{{ step === 3 }}">
      <text class="step-heading" style="color: {{ theme.text }}">位置</text>
      <text class="step-sub" style="color: {{ theme.textSecondary }}">{{ courseName }} | {{ courseTime }}</text>

      <div class="location-box" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="location-val" style="color: {{ theme.text }}">{{ courseLocation || '点击输入位置' }}</text>
      </div>

      <text class="optional-tip" style="color: {{ theme.textMuted }}">选填</text>

      <div class="nav-row">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-body" if="{{ step === 4 }}">
      <text class="step-heading" style="color: {{ theme.text }}">确认信息</text>

      <div class="confirm-card" style="background-color: {{ theme.card }}">
        <text class="confirm-tag" style="color: {{ theme.accent }}">课程</text>
        <text class="confirm-val" style="color: {{ theme.text }}">{{ courseName }}</text>
        <text class="confirm-tag" style="color: {{ theme.accent }}">时间</text>
        <text class="confirm-val" style="color: {{ theme.text }}">{{ courseTime }}</text>
        <text class="confirm-tag" style="color: {{ theme.accent }}">位置</text>
        <text class="confirm-val" style="color: {{ theme.text }}">{{ courseLocation || '(无)' }}</text>
      </div>

      <div class="nav-row">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="save-btn" type="button" value="保存" onclick="saveCourse"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
var store = require("../../data/store.js")
var database = require("../../data/database.js")

var COURSE_LIST_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "", location: "" },
  { name: "生物", time: "13:55 - 14:40", teacher: "", location: "" },
  { name: "历史", time: "15:00 - 15:45", teacher: "", location: "" },
  { name: "地理", time: "15:55 - 16:40", teacher: "", location: "" },
  { name: "政治", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "音乐", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "美术", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "体育", time: "10:55 - 11:40", teacher: "", location: "" }
]

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  if (!timeStr) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

export default {
  private: {
    courseName: "",
    courseTime: "",
    courseLocation: "",
    day: "",
    nextId: 100,
    isSaving: false,
    step: 1,
    courseIndex: 0,
    presetCourses: [],
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      keyBg: "#1a1a3e",
      keyBorder: "#2a2a5a",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080",
      icon: "●",
      progressOngoing: "rgba(126,200,227,0.2)",
      progressDone: "rgba(74,138,154,0.25)"
    }
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(" - ")[0] : "00:00"
      var tb = b.time ? b.time.split(" - ")[0] : "00:00"
      var taParts = ta.split(":")
      var tbParts = tb.split(":")
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadCourses()

    var storage = require("@system.storage")
    storage.get({
      key: "add_course_day",
      success: function(val) {
        self.day = val || ""
        if (!self.day) { self.setDefaultDay() }
      },
      fail: function() {
        self.day = ""
        self.setDefaultDay()
      }
    })
    storage.get({
      key: "add_course_nextId",
      success: function(val) {
        self.nextId = parseInt(val) || 100
      },
      fail: function() {
        self.nextId = 100
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.refreshCourseList()

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.courseLocation = data
          storage.delete({
            key: "chinese_input_result",
            fail: function() {}
          })
        }
      },
      fail: function() {}
    })
  },

  refreshCourseList() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            }
          } catch (e) {}
        }
      },
      fail: function() {}
    })
  },

  setDefaultDay() {
    var dayNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
    var now = new Date()
    this.day = dayNames[now.getDay()]
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            } else {
              self.presetCourses = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.presetCourses = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.presetCourses = self.sortByTime(defaultCourses.slice())
        }
        self.selectCourse(self.courseIndex)
      },
      fail: function() {
        self.presetCourses = self.sortByTime(defaultCourses.slice())
        self.selectCourse(self.courseIndex)
      }
    })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  selectCourse(index) {
    if (this.presetCourses.length === 0) {
      this.courseName = ""
      this.courseTime = ""
      return
    }
    if (index < 0 || index >= this.presetCourses.length) {
      index = 0
    }
    this.courseIndex = index
    var c = this.presetCourses[index]
    this.courseName = c.name
    this.courseLocation = c.location
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
  },

  swipePrev() {
    if (this.courseIndex > 0) {
      this.selectCourse(this.courseIndex - 1)
    }
  },

  swipeNext() {
    if (this.courseIndex < this.presetCourses.length - 1) {
      this.selectCourse(this.courseIndex + 1)
    }
  },

  updateTimeString() {
    this.courseTime = padZero(this.startHour) + ":" + padZero(this.startMin) + " - " + padZero(this.endHour) + ":" + padZero(this.endMin)
  },

  increaseStartHour() { if (this.startHour < 23) { this.startHour++ } else { this.startHour = 0 } this.updateTimeString() },
  decreaseStartHour() { if (this.startHour > 0) { this.startHour-- } else { this.startHour = 23 } this.updateTimeString() },
  increaseStartMin() { if (this.startMin < 59) { this.startMin++ } else { this.startMin = 0 } this.updateTimeString() },
  decreaseStartMin() { if (this.startMin > 0) { this.startMin-- } else { this.startMin = 59 } this.updateTimeString() },
  increaseEndHour() { if (this.endHour < 23) { this.endHour++ } else { this.endHour = 0 } this.updateTimeString() },
  decreaseEndHour() { if (this.endHour > 0) { this.endHour-- } else { this.endHour = 23 } this.updateTimeString() },
  increaseEndMin() { if (this.endMin < 59) { this.endMin++ } else { this.endMin = 0 } this.updateTimeString() },
  decreaseEndMin() { if (this.endMin > 0) { this.endMin-- } else { this.endMin = 59 } this.updateTimeString() },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "输入位置" })
    storage.set({ key: "chinese_input_placeholder", value: "点击输入位置, 例如: 301教室" })
    storage.set({ key: "chinese_input_value", value: this.courseLocation || "" })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  nextStep() {
    if (this.step < 4) { this.step = this.step + 1 }
  },

  prevStep() {
    if (this.step > 1) { this.step = this.step - 1 }
  },

  goBack() {
    router.back()
  },

  saveCourse() {
    if (this.isSaving) { return }
    if (!this.courseName) { prompt.showToast({ message: "请先选择课程" }); return }
    if (!this.courseTime) { prompt.showToast({ message: "请先设置时间" }); return }
    if (!this.day) { this.setDefaultDay() }

    this.isSaving = true
    var self = this
    var newCourse = {
      id: String(this.nextId),
      day: this.day,
      name: this.courseName,
      time: this.courseTime,
      location: this.courseLocation || "",
      notes: ""
    }
    this.nextId++
    var storage = require("@system.storage")
    storage.set({ key: "add_course_nextId", value: String(this.nextId) })
    database.insertCourse(newCourse, function(err) {
      if (!err) {
        prompt.showToast({ message: "课程已添加" })
        router.back()
      } else {
        self.isSaving = false
        prompt.showToast({ message: "保存失败，请重试" })
      }
    })
  }
}
</script>

<style>
.page-root {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 30px 16px 30px 16px;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.back-btn {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  font-size: 28px;
  line-height: 48px;
  text-align: center;
  background-color: transparent;
  border: none;
}

.title {
  font-size: 30px;
  line-height: 40px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  margin-right: 52px;
}

.step-dots {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  flex-shrink: 0;
}

.dot {
  width: 14px;
  height: 14px;
  border-radius: 7px;
}

.dot-line {
  width: 32px;
  height: 3px;
  margin: 0 3px;
}

.form-body {
  flex-direction: column;
  flex: 1;
}

.step-heading {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  margin-bottom: 6px;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.step-sub {
  font-size: 24px;
  line-height: 32px;
  margin-bottom: 12px;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.swiper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}

.arrow-btn {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  font-size: 26px;
  line-height: 40px;
  font-weight: bold;
  text-align: center;
  background-color: transparent;
  border: none;
}

.course-card {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  padding: 20px;
  margin: 0 10px;
  border: 3px solid #7ec8e3;
  width: 180px;
  height: 100px;
}

.card-name {
  font-size: 32px;
  line-height: 42px;
  font-weight: bold;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

.index-text {
  font-size: 22px;
  line-height: 30px;
  margin-bottom: 10px;
  text-align: center;
}

.nav-row {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 12px;
}

.manage-btn {
  width: 100px;
  border-radius: 12px;
  font-size: 26px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  height: 44px;
  background-color: transparent;
  border: none;
}

.next-btn {
  width: 100px;
  border-radius: 12px;
  font-size: 26px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  height: 44px;
  background-color: transparent;
  border: none;
}

.prev-btn {
  width: 100px;
  border-radius: 12px;
  font-size: 26px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  height: 44px;
  background-color: transparent;
  border: none;
}

.save-btn {
  width: 100px;
  border-radius: 12px;
  font-size: 26px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  height: 44px;
  background-color: transparent;
  border: none;
}

.time-scroll {
  flex: 1;
  flex-direction: column;
}

.time-label {
  font-size: 26px;
  line-height: 36px;
  font-weight: bold;
  margin-top: 8px;
  margin-bottom: 6px;
  text-align: center;
}

.time-card {
  flex-direction: column;
  align-items: center;
  border-radius: 14px;
  padding: 10px;
  margin-bottom: 8px;
}

.stepper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
}

.stepper-tag {
  font-size: 24px;
  line-height: 34px;
  width: 48px;
}

.stepper-btn {
  width: 44px;
  height: 38px;
  border-radius: 10px;
  font-size: 26px;
  line-height: 34px;
  font-weight: bold;
  text-align: center;
  background-color: transparent;
  border: none;
}

.stepper-num {
  font-size: 36px;
  line-height: 46px;
  font-weight: bold;
  width: 56px;
  text-align: center;
}

.optional-tip {
  font-size: 22px;
  line-height: 30px;
  margin-bottom: 10px;
  text-align: center;
}

.location-box {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  padding: 0 14px;
  margin-bottom: 6px;
}

.location-val {
  font-size: 28px;
  line-height: 38px;
  max-lines: 1;
  text-overflow: ellipsis;
}

.confirm-card {
  flex-direction: column;
  border-radius: 14px;
  padding: 14px;
  flex: 1;
}

.confirm-tag {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  margin-top: 8px;
}

.confirm-val {
  font-size: 28px;
  line-height: 38px;
  max-lines: 1;
  text-overflow: ellipsis;
