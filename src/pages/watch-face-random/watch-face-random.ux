<template>
  <!--
    无框机械表盘 · 由「随机表盘」重写（方案：docs/无框机械表盘-方案.md）
    与圆表/方表的区别：
      ① 无框：不画表壳/表圈/表耳/盘面轮廓线。整个屏幕即盘面（底色 #17191d + 6 条纵向拉丝带），
         盘的「边」只由印刷分钟轨（48 根分钟刻度）+ 整点时标暗示。
      ② 12 时位按屏幕比例分配：运行时 device.getInfo 取真实宽高，椭圆
         a=min(0.44W, 0.42H)、b=min(0.42H, 1.35a)，长短比跟随屏幕比例（方形屏收敛为正圆）。
      ③ 三针/时标朝向全部走 120 档字面量 .rN = rotate(180+3N)，无任何动态 transform、无嵌套旋转。
      ④ 交互：点空白返回、右下「轻触返回」。原随机跳字与换色面板取消。
  -->
  <div class="page">
    <!-- 底层透明点击层：只有点「空白」才会命中它 → 返回 -->
    <div class="bg-tap" onclick="onTap"></div>

    <!-- 纵向拉丝 ×6（百分比定位，静态） -->
    <div class="band b1"></div>
    <div class="band b2"></div>
    <div class="band b3"></div>
    <div class="band b4"></div>
    <div class="band b5"></div>
    <div class="band b6"></div>

    <!-- 印刷分钟轨：48 根分钟刻度（每 5 分位置让给整点时标） -->
    <div class="mt {{$item.c}}" for="{{mt}}" style="left:{{$item.x}}px;top:{{$item.y}}px"></div>

    <!-- 整点时标 ×12：金属条，外端贴椭圆轨 -->
    <div class="hm {{$item.c}}" for="{{hm}}" style="left:{{$item.x}}px;top:{{$item.y}}px"></div>

    <!-- 夜光点 ×11（3 点让位日期窗） -->
    <div class="lume" for="{{lm}}" style="left:{{$item.x}}px;top:{{$item.y}}px"></div>

    <!-- 阿拉伯数字 ×11 -->
    <text class="num {{$item.big}}" for="{{nms}}" style="left:{{$item.x}}px;top:{{$item.y}}px">{{$item.t}}</text>

    <!-- 日期窗凹槽：框上缘亮线 + 窗内上缘暗线 + 天数 -->
    <div class="dw" style="left:{{dwx}}px;top:{{dwy}}px">
      <div class="dw-hi"></div>
      <div class="dw-sh"></div>
      <text class="dw-num">{{dayText}}</text>
    </div>

    <!-- 印刷铭文 -->
    <text class="brand" style="left:{{brL}}px;top:{{brT}}px">EV</text>
    <text class="mark2" style="left:{{brL2}}px;top:{{brT2}}px">AUTOMATIC</text>
    <text class="mark2" style="left:{{jwL}}px;top:{{jwT}}px">36 JEWELS</text>
    <text class="dateline" style="left:{{dlL}}px;top:{{dlT}}px">{{dateText}}</text>

    <!-- 三针：暗影（右下偏 1px）+ 主针 + 左缘高光，共用同一档位 class；秒针另配重尾（+60 档） -->
    <div class="hand hour-sh {{hourCls}}" style="left:{{hxs}}px;top:{{hys}}px;width:6px;height:{{hh}}px"></div>
    <div class="hand hour {{hourCls}}" style="left:{{hx}}px;top:{{hy}}px;width:6px;height:{{hh}}px"></div>
    <div class="hand-hl hour-hl {{hourCls}}" style="left:{{hxl}}px;top:{{hy}}px;width:1px;height:{{hh}}px"></div>

    <div class="hand minute-sh {{minuteCls}}" style="left:{{mxs}}px;top:{{mys}}px;width:4px;height:{{mh}}px"></div>
    <div class="hand minute {{minuteCls}}" style="left:{{mx}}px;top:{{my}}px;width:4px;height:{{mh}}px"></div>
    <div class="hand-hl minute-hl {{minuteCls}}" style="left:{{mxl}}px;top:{{my}}px;width:1px;height:{{mh}}px"></div>

    <div class="hand second {{secondCls}}" style="left:{{sx}}px;top:{{sy}}px;width:1px;height:{{sh}}px"></div>
    <div class="hand sec-tail {{secTailCls}}" style="left:{{tx}}px;top:{{sy}}px;width:2px;height:{{sth}}px"></div>

    <!-- 中轴三层 -->
    <div class="hub" style="left:{{hbx}}px;top:{{hby}}px">
      <div class="hub-base"></div>
      <div class="hub-ring"></div>
      <div class="hub-dot"></div>
    </div>

    <!-- 返回 -->
    <text class="back" style="top:{{backT}}px">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const DAY_NAMES = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

// 角度 → 120 档类名（3°/档）。引擎旋转轴在元素顶部中点，故 .rN 内部为 rotate(180 + 3N)
function stepClass(deg) {
  var step = Math.round(deg / 3) % 120
  if (step < 0) step += 120
  return "r" + step
}

function r1(v) {
  return Math.round(v * 10) / 10
}

export default {
  data: {
    mt: [],
    hm: [],
    lm: [],
    nms: [],
    dwx: 150,
    dwy: 237,
    brL: 66,
    brT: 103,
    brL2: 56,
    brT2: 118,
    jwL: 56,
    jwT: 367,
    dlL: 51,
    dlT: 381,
    backT: 460,
    hx: 93,
    hxs: 94,
    hxl: 94,
    hy: 245,
    hys: 246,
    hh: 41,
    mx: 94,
    mxs: 95,
    mxl: 95,
    my: 245,
    mys: 246,
    mh: 71,
    sx: 95.5,
    sy: 245,
    sh: 77,
    tx: 95,
    sth: 20,
    hbx: 93.5,
    hby: 242.5,
    hourCls: "r0",
    minuteCls: "r0",
    secondCls: "r0",
    secTailCls: "r60",
    dateText: "",
    dayText: "1",
    timer: undefined
  },

  onInit() {
    // 先用 192×490 出图，避免首帧空；拿到真实屏幕后再重建
    this.build(192, 490)
    var self = this
    try {
      var device = require("@system.device")
      device.getInfo({
        success: function(ret) {
          var w = ret && ret.screenWidth ? ret.screenWidth : 192
          var h = ret && ret.screenHeight ? ret.screenHeight : 490
          self.build(w, h)
        },
        fail: function() {}
      })
    } catch (e) {
      /* 取不到机型信息就保持 192 基准 */
    }
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* ── 几何：12 时位按屏幕比例分配（比例封顶椭圆，见方案 §3）── */
  build(W, H) {
    if (!W || !H || W < 100 || H < 100) {
      W = 192
      H = 490
    }
    var cx = W / 2
    var cy = H / 2
    var a = Math.min(0.44 * W, 0.42 * H)
    var b = Math.min(0.42 * H, 1.35 * a)
    var L0 = Math.sqrt(a * b)

    var mt = []
    var hm = []
    var lm = []
    var nms = []
    var i, th, x, y, lx, ly, nx, ny

    // 分钟刻度：每分一根（跳过整点），外端贴 (a,b)
    for (i = 0; i < 60; i++) {
      if (i % 5 === 0) continue
      th = (i * 6) * Math.PI / 180
      x = cx + a * Math.sin(th)
      y = cy - b * Math.cos(th)
      mt.push({ x: r1(x - 0.5), y: r1(y), c: "r" + (i * 2) })
    }

    // 整点时标 + 夜光点 + 阿拉伯数字（3 点让位日期窗）
    for (i = 0; i < 12; i++) {
      th = (i * 30) * Math.PI / 180
      x = cx + a * Math.sin(th)
      y = cy - b * Math.cos(th)
      hm.push({ x: r1(x - 1), y: r1(y), c: "r" + (i * 10) })
      if (i === 3) continue
      lx = cx + (a - 12) * Math.sin(th)
      ly = cy - (b - 12) * Math.cos(th)
      lm.push({ x: r1(lx - 1), y: r1(ly - 1) })
      nx = cx + 0.7 * a * Math.sin(th)
      ny = cy - 0.7 * b * Math.cos(th)
      nms.push({
        x: r1(nx - 8),
        y: r1(ny - 6),
        t: i === 0 ? "12" : "" + i,
        big: i % 3 === 0 ? "num-big" : ""
      })
    }

    this.mt = mt
    this.hm = hm
    this.lm = lm
    this.nms = nms

    // 日期窗（3 点位内侧）+ 铭文 + 底部信息
    this.dwx = r1(cx + 0.66 * a - 11)
    this.dwy = r1(cy - 8)
    this.brL = r1(cx - 30)
    this.brT = r1(cy - b - 28)
    this.brL2 = r1(cx - 40)
    this.brT2 = r1(cy - b - 13)
    this.jwL = r1(cx - 40)
    this.jwT = r1(cy + b + 8)
    this.dlL = r1(cx - 45)
    this.dlT = r1(cy + b + 22)
    this.backT = r1(H - 30)

    // 三针：顶部中点压在盘心 (cx,cy)，向下延伸（配合 180° 档指向上）
    this.hx = r1(cx - 3)
    this.hxs = r1(cx - 2)
    this.hxl = r1(cx - 2)
    this.mx = r1(cx - 2)
    this.mxs = r1(cx - 1)
    this.mxl = r1(cx - 1)
    this.hy = r1(cy)
    this.hys = r1(cy + 1)
    this.my = r1(cy)
    this.mys = r1(cy + 1)
    this.hh = Math.round(0.42 * L0)
    this.mh = Math.round(0.72 * L0)
    this.sx = r1(cx - 0.5)
    this.sy = r1(cy)
    this.sh = Math.round(0.78 * L0)
    this.tx = r1(cx - 1)
    this.sth = Math.round(0.2 * L0)
    this.hbx = r1(cx - 2.5)
    this.hby = r1(cy - 2.5)
  },

  /* ── 时间：1s 心跳；只写变化字段（稳态 1 次/秒重绘，防整页闪）── */
  refresh() {
    this.stop()
    this.tick()
    var self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    var now = new Date()
    var h = now.getHours()
    var m = now.getMinutes()
    var s = now.getSeconds()
    this.hourCls = stepClass((h % 12 + m / 60 + s / 3600) * 30)
    this.minuteCls = stepClass((m + s / 60) * 6)
    this.secondCls = stepClass(s * 6)
    this.secTailCls = stepClass(s * 6 + 180)
    var d = (now.getMonth() + 1) + "-" + (now.getDate() < 10 ? "0" + now.getDate() : "" + now.getDate())
    var line = DAY_NAMES[now.getDay()] + " " + d
    if (line !== this.dateText) this.dateText = line
    var dd = now.getDate() < 10 ? "0" + now.getDate() : "" + now.getDate()
    if (dd !== this.dayText) this.dayText = dd
  },

  /* ── 返回 ── */
  onTap() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #17191d;
    position: relative;
  }

  /* 底层透明点击层：撑满整屏，承接「点空白返回」 */
  .bg-tap {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
  }

  /* ── 纵向拉丝带：极淡横向明暗交替，替代框的「材质存在感」── */
  .band {
    position: absolute;
    left: 0;
    width: 100%;
    background-color: #ffffff;
  }

  .b1 { top: 0%; height: 17%; opacity: 0.020; }
  .b2 { top: 16.7%; height: 17%; opacity: 0.008; }
  .b3 { top: 33.3%; height: 17%; opacity: 0.020; }
  .b4 { top: 50%; height: 17%; opacity: 0.008; }
  .b5 { top: 66.7%; height: 17%; opacity: 0.020; }
  .b6 { top: 83.3%; height: 17%; opacity: 0.008; }

  /* ── 印刷分钟轨 ── */
  .mt {
    position: absolute;
    width: 1px;
    height: 4px;
    background-color: #98a3ad;
  }

  /* ── 整点时标 ── */
  .hm {
    position: absolute;
    width: 2px;
    height: 11px;
    background-color: #dde4ea;
  }

  /* ── 夜光点 ── */
  .lume {
    position: absolute;
    width: 2px;
    height: 2px;
    background-color: #aec6bb;
  }

  /* ── 阿拉伯数字 ── */
  .num {
    position: absolute;
    width: 18px;
    height: 11px;
    font-size: 10px;
    color: #c2ccd5;
    text-align: center;
  }

  .num-big {
    height: 16px;
    font-size: 13px;
    color: #e6ecf1;
  }

  /* ── 日期窗凹槽 ── */
  .dw {
    position: absolute;
    width: 22px;
    height: 16px;
    background-color: #101216;
    border-radius: 2px;
  }

  .dw-hi {
    position: absolute;
    left: 0;
    top: -1px;
    width: 22px;
    height: 1px;
    background-color: #4d565f;
  }

  .dw-sh {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 20px;
    height: 1px;
    background-color: #04050a;
  }

  .dw-num {
    width: 22px;
    height: 16px;
    text-align: center;
    font-size: 11px;
    color: #d3dae1;
  }

  /* ── 铭文 ── */
  .brand {
    position: absolute;
    width: 60px;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #c9d2da;
    text-align: center;
  }

  .mark2 {
    position: absolute;
    width: 80px;
    font-size: 7px;
    letter-spacing: 1px;
    color: #6f767e;
    text-align: center;
  }

  .dateline {
    position: absolute;
    width: 90px;
    font-size: 10px;
    color: #9aa3ab;
    text-align: center;
  }

  .back {
    position: absolute;
    left: 16px;
    font-size: 10px;
    color: #767c84;
  }

  /* ── 三针：顶部中点压在盘心，向下延伸 ── */
  .hand {
    position: absolute;
  }

  .hand-hl {
    position: absolute;
  }

  .hour {
    background-color: #ccd5dd;
  }

  .hour-sh {
    background-color: #2a2f36;
  }

  .hour-hl {
    background-color: #eef3f7;
  }

  .minute {
    background-color: #d8dfe6;
  }

  .minute-sh {
    background-color: #2a2f36;
  }

  .minute-hl {
    background-color: #f2f6f9;
  }

  .second {
    background-color: #e8611f;
  }

  .sec-tail {
    background-color: #e8611f;
  }

  /* ── 中轴三层 ── */
  .hub {
    position: absolute;
    width: 5px;
    height: 5px;
  }

  .hub-base {
    position: absolute;
    left: 0;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
    background-color: #101216;
  }

  .hub-ring {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 3px;
    height: 3px;
    border-radius: 1.5px;
    background-color: #b9c2cb;
  }

  .hub-dot {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 1px;
    height: 1px;
    background-color: #e6ecf1;
  }

  /* ── 120 档字面量旋转：rotate(180 + 3N)，180° 使针由「向下」转为「向上」── */
  .r0 { transform: rotate(180deg); }
  .r1 { transform: rotate(183deg); }
  .r2 { transform: rotate(186deg); }
  .r3 { transform: rotate(189deg); }
  .r4 { transform: rotate(192deg); }
  .r5 { transform: rotate(195deg); }
  .r6 { transform: rotate(198deg); }
  .r7 { transform: rotate(201deg); }
  .r8 { transform: rotate(204deg); }
  .r9 { transform: rotate(207deg); }
  .r10 { transform: rotate(210deg); }
  .r11 { transform: rotate(213deg); }
  .r12 { transform: rotate(216deg); }
  .r13 { transform: rotate(219deg); }
  .r14 { transform: rotate(222deg); }
  .r15 { transform: rotate(225deg); }
  .r16 { transform: rotate(228deg); }
  .r17 { transform: rotate(231deg); }
  .r18 { transform: rotate(234deg); }
  .r19 { transform: rotate(237deg); }
  .r20 { transform: rotate(240deg); }
  .r21 { transform: rotate(243deg); }
  .r22 { transform: rotate(246deg); }
  .r23 { transform: rotate(249deg); }
  .r24 { transform: rotate(252deg); }
  .r25 { transform: rotate(255deg); }
  .r26 { transform: rotate(258deg); }
  .r27 { transform: rotate(261deg); }
  .r28 { transform: rotate(264deg); }
  .r29 { transform: rotate(267deg); }
  .r30 { transform: rotate(270deg); }
  .r31 { transform: rotate(273deg); }
  .r32 { transform: rotate(276deg); }
  .r33 { transform: rotate(279deg); }
  .r34 { transform: rotate(282deg); }
  .r35 { transform: rotate(285deg); }
  .r36 { transform: rotate(288deg); }
  .r37 { transform: rotate(291deg); }
  .r38 { transform: rotate(294deg); }
  .r39 { transform: rotate(297deg); }
  .r40 { transform: rotate(300deg); }
  .r41 { transform: rotate(303deg); }
  .r42 { transform: rotate(306deg); }
  .r43 { transform: rotate(309deg); }
  .r44 { transform: rotate(312deg); }
  .r45 { transform: rotate(315deg); }
  .r46 { transform: rotate(318deg); }
  .r47 { transform: rotate(321deg); }
  .r48 { transform: rotate(324deg); }
  .r49 { transform: rotate(327deg); }
  .r50 { transform: rotate(330deg); }
  .r51 { transform: rotate(333deg); }
  .r52 { transform: rotate(336deg); }
  .r53 { transform: rotate(339deg); }
  .r54 { transform: rotate(342deg); }
  .r55 { transform: rotate(345deg); }
  .r56 { transform: rotate(348deg); }
  .r57 { transform: rotate(351deg); }
  .r58 { transform: rotate(354deg); }
  .r59 { transform: rotate(357deg); }
  .r60 { transform: rotate(360deg); }
