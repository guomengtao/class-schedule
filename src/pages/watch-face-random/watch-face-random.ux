<template>
  <!--
    随机表盘 · 由「经典表盘」派生
    与经典表盘不同之处：
      ① 大时间改为「绝对定位」，每 2.5 秒随机跳到一个新位置（192×490 跑道屏）。
         68px 大字宽约 176px，水平只留 4~16px 防溢出；垂直 24~400px 自由跳。
      ② 其余交互完全沿用经典表盘：
         · 「换色」按钮 → 弹出颜色选择面板（5 种默认色，storage 持久化）
         · 「返回」按钮
         · 点击页面空白处返回（用底层透明 .bg-tap 承接，点到大时间本身不返回）
    颜色面板同经典表盘，自绘 overlay 实现。
  -->
  <div class="page">
    <!-- 底层透明点击层：只有点「空白」才会命中它 → 返回 -->
    <div class="bg-tap" onclick="onTap"></div>

    <!-- 随机跳动的大时间（绝对定位，left/top 由 clockLeft/clockTop 绑定） -->
    <text class="clock" style="left: {{ clockLeft }}px; top: {{ clockTop }}px; color: {{ clockColor }}">{{timeText}}</text>

    <text class="btn-color" onclick="openPanel">换色</text>
    <text class="back" onclick="goBack">返回</text>

    <!-- 颜色选择面板 -->
    <div class="mask" if="{{ showPanel }}" onclick="closePanel">
      <div class="panel">
        <text class="p-title">文字颜色</text>
        <text class="p-item" style="color: #e8e4da" onclick="pick(0)">米白</text>
        <text class="p-item" style="color: #7dffb0" onclick="pick(1)">青绿</text>
        <text class="p-item" style="color: #ffd166" onclick="pick(2)">金色</text>
        <text class="p-item" style="color: #7ec8e3" onclick="pick(3)">天蓝</text>
        <text class="p-item" style="color: #ff8fa3" onclick="pick(4)">玫红</text>
        <text class="p-cancel" onclick="closePanel">取消</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

const storage = require("@system.storage")

const LIST_PAGE = "/pages/watch-face-list"
const COLOR_KEY = "wf_clock_color"
const COLORS = ["#e8e4da", "#7dffb0", "#ffd166", "#7ec8e3", "#ff8fa3"]

const RND_MS = 2500          // 每隔几秒换一次位置
const LEFT_MIN = 4, LEFT_MAX = 16   // 68px 大字宽 ~176，水平仅留防溢出余量
const TOP_MIN = 24, TOP_MAX = 400   // 垂直自由跳动区间（避开底部按钮）

export default {
  data: {
    timeText: "--:--",
    clockColor: COLORS[0],
    showPanel: false,
    clockLeft: 60,
    clockTop: 200,
    timer: undefined,
    rndTimer: undefined
  },

  onInit() {
    this.loadColor()
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* ── 时间：1s 心跳；同时启动随机移位 ── */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
    this.startRandom()
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
    this.stopRandom()
  },

  tick() {
    const now = new Date()
    const t = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* ── 随机移位 ── */
  startRandom() {
    this.stopRandom()
    const self = this
    this.rndTimer = setInterval(function() {
      self.moveRandom()
    }, RND_MS)
    this.moveRandom()
  },

  stopRandom() {
    if (this.rndTimer) {
      clearInterval(this.rndTimer)
      this.rndTimer = undefined
    }
  },

  moveRandom() {
    const l = LEFT_MIN + Math.floor(Math.random() * (LEFT_MAX - LEFT_MIN + 1))
    const t = TOP_MIN + Math.floor(Math.random() * (TOP_MAX - TOP_MIN + 1))
    this.clockLeft = l
    this.clockTop = t
  },

  /* ── 颜色持久化 ── */
  loadColor() {
    const self = this
    try {
      storage.get({
        key: COLOR_KEY,
        success: function(res) {
          if (res && res.value) self.clockColor = res.value
        },
        fail: function() {}
      })
    } catch (e) {
      /* 存储不可用就用默认色，不影响显示 */
    }
  },

  saveColor(c) {
    try {
      storage.set({ key: COLOR_KEY, value: c })
    } catch (e) {}
  },

  /* ── 面板开关 ── */
  openPanel() {
    this.showPanel = true
  },

  closePanel() {
    this.showPanel = false
  },

  pick(i) {
    const c = COLORS[i]
    if (!c) return
    this.clockColor = c
    this.saveColor(c)
    this.closePanel()
  },

  /* ── 返回（仅点空白触发）── */
  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    position: relative;
  }

  /* 底层透明点击层：撑满整屏，承接「点空白返回」 */
  .bg-tap {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
  }

  /* 随机跳动的大时间，颜色由 clockColor 绑定 */
  .clock {
    position: absolute;
    font-size: 68px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .btn-color {
    position: absolute;
    left: 16px;
    top: 430px;
    font-size: 22px;
    color: #7ec8e3;
  }

  .back {
    position: absolute;
    left: 16px;
    top: 462px;
    font-size: 22px;
    color: #888899;
  }

  /* ── 颜色面板（撑满整屏，盖在最上层）── */
  .mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
  }

  .panel {
    width: 240px;
    flex-direction: column;
    align-items: center;
    background-color: #16213e;
    border-radius: 12px;
    padding: 16px 0 12px 0;
  }

  .p-title {
    font-size: 22px;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .p-item {
    font-size: 26px;
    padding: 7px 0;
  }

  .p-cancel {
    margin-top: 8px;
    font-size: 22px;
    color: #888899;
  }
</style>
