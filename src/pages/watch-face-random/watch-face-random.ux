<template>
  <!--
    计时码表圆盘 · 复刻参考图（方案：docs/WatchFace-复刻计时码表Pro-方案.md）
    叠层结构（由下至上）：
      ① 表壳：黑壳圆 → 盘沿浅灰细线 → 米白盘面（三层同轴圆，靠 DOM 顺序叠压）
      ② 刻度：12 根灰矩形，3/6/9/12 位加长加粗（旧款 60 根分钟轨 / 阿拉伯数字 / 夜光点 / 铭文已移除）
      ③ 双凹陷小表盘：左上 / 右上，各含 12 根白刻度 + 指示小针 + 100/25/50/75（盘径过小时不画数字）
      ④ 日期：OCTOBER 灰字 + 白底黑框数字
      ⑤ 三针：纯黑，秒针带配重尾；朝向全走 120 档字面量 .rN = rotate(180+3N)，无动态 transform
    几何：运行时 device.getInfo 取真实宽高。圆心恒为屏幕几何中心；屏比 ≤1.15（方屏/圆屏）
          盘径取短边 86% 留边，屏比 >1.15（长条屏）盘径取屏宽 94%、上下留信息区。
  -->
  <div class="page">
    <!-- 表壳三层：黑圈 → 盘边浅灰细线 → 米白盘面（参考图的黑壳 + 盘沿描边） -->
    <div class="bezel" style="left:{{bezL}}px;top:{{bezT}}px;width:{{bezD}}px;height:{{bezD}}px;border-radius:{{bezR}}px"></div>
    <div class="cring" style="left:{{rgL}}px;top:{{rgT}}px;width:{{rgD}}px;height:{{rgD}}px;border-radius:{{rgR}}px"></div>
    <div class="dial" style="left:{{dpL}}px;top:{{dpT}}px;width:{{dpD}}px;height:{{dpD}}px;border-radius:{{dpR}}px"></div>

    <!-- 主刻度 ×12：灰矩形，3/6/9/12 位加长加粗（内联尺寸，角度走 rN 档） -->
    <div class="tick {{$item.c}}" for="{{tk}}" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.w}}px;height:{{$item.h}}px"></div>

    <!-- 双凹陷小表盘：浅灰外缘圈 + 深灰盘面（左上 / 右上） -->
    <div class="sub-edge" for="{{se}}" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.d}}px;height:{{$item.d}}px;border-radius:{{$item.r}}px"></div>
    <div class="sub-face" for="{{sf}}" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.d}}px;height:{{$item.d}}px;border-radius:{{$item.r}}px"></div>

    <!-- 小表盘内刻度 ×12 + 指示小针 -->
    <div class="sub-tick {{$item.c}}" for="{{st}}" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.w}}px;height:{{$item.h}}px"></div>

    <!-- 小表盘数字 100 / 25 / 50 / 75（盘径过小时由 build 决定不生成） -->
    <text class="sub-num" for="{{sn}}" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.w}}px;height:{{$item.h}}px;font-size:{{$item.fs}}px">{{$item.t}}</text>

    <!-- 日期：OCTOBER 小字 + 白底黑框数字 -->
    <text class="mon" style="left:{{moL}}px;top:{{moT}}px;width:{{moW}}px;height:{{moH}}px;font-size:{{moFs}}px">OCTOBER</text>
    <div class="datebox" style="left:{{dbL}}px;top:{{dbT}}px;width:{{dbW}}px;height:{{dbH}}px;border:{{dbBw}}px solid #26241f"></div>
    <text class="dtext" style="left:{{dbL}}px;top:{{dbT}}px;width:{{dbW}}px;height:{{dbH}}px;font-size:{{dbFs}}px">{{dayText}}</text>

    <!-- 三针：纯黑（参考图为黑针，白盘上不需要阴影层）。顶部中点压在盘心，向下延伸 -->
    <div class="hand hour {{hourCls}}" style="left:{{hx}}px;top:{{hy}}px;width:{{hw}}px;height:{{hh}}px"></div>
    <div class="hand minute {{minuteCls}}" style="left:{{mx}}px;top:{{my}}px;width:{{mw}}px;height:{{mh}}px"></div>
    <div class="hand second {{secondCls}}" style="left:{{sx}}px;top:{{sy}}px;width:{{sw}}px;height:{{sh}}px"></div>
    <div class="hand sec-tail {{secTailCls}}" style="left:{{tx}}px;top:{{sy}}px;width:{{tw}}px;height:{{sth}}px"></div>

    <!-- 中轴：米白圆帽 + 灰环 -->
    <div class="hub" style="left:{{hbx}}px;top:{{hby}}px;width:{{hbd}}px;height:{{hbd}}px;border-radius:{{hbr}}px"></div>

    <!-- 盘下日期行 + 返回 -->
    <text class="dateline" style="left:{{dlL}}px;top:{{dlT}}px;width:{{dlW}}px;font-size:{{dlFs}}px">{{dateText}}</text>
    <text class="back" style="left:{{bkL}}px;top:{{backT}}px;font-size:{{bkFs}}px" onclick="onBack">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const DAY_NAMES = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

// 角度 → 120 档类名（3°/档）。引擎旋转轴在元素顶部中点，故 .rN 内部为 rotate(180 + 3N)
function stepClass(deg) {
  var step = Math.round(deg / 3) % 120
  if (step < 0) step += 120
  return "r" + step
}

function r1(v) {
  return Math.round(v * 10) / 10
}

export default {
  data: {
    /* 表圈 / 盘面（复刻计时码表 Pro）：默认值按 192×490 预算，build() 里按真实屏幕重算 */
    bezL: 6,
    bezT: 36,
    bezD: 180,
    bezR: 90,
    dpL: 13,
    dpT: 43,
    dpD: 166,
    dpR: 83,
    mt: [],
    hm: [],
    lm: [],
    nms: [],
    /* 表壳内圈浅灰细线 */
    rgL: 12,
    rgT: 161,
    rgD: 168,
    rgR: 84,
    /* 复刻版元素数组：主刻度 / 小表盘外缘 / 盘面 / 内刻度+小针 / 数字 */
    tk: [],
    se: [],
    sf: [],
    st: [],
    sn: [],
    /* 日期：OCTOBER + 白底黑框 */
    moL: 12,
    moT: 269,
    moW: 168,
    moH: 12,
    moFs: 9,
    dbL: 66,
    dbT: 290,
    dbW: 60,
    dbH: 21,
    dbBw: 1,
    dbFs: 14,
    /* 盘下日期行 / 返回 */
    dlL: 6,
    dlT: 341,
    dlW: 180,
    dlFs: 16,
    bkL: 8,
    backT: 460,
    bkFs: 14,
    hx: 93,
    hy: 245,
    hh: 36,
    mx: 94,
    my: 245,
    mh: 56,
    sx: 95.5,
    sy: 245,
    sh: 69,
    tx: 95,
    sth: 13,
    hbx: 91.5,
    hby: 240.5,
    hbd: 9,
    hbr: 4.5,
    hourCls: "r0",
    minuteCls: "r0",
    secondCls: "r0",
    secTailCls: "r60",
    hw: 4,
    mw: 2,
    sw: 1,
    tw: 2,
    dateText: "",
    dayText: "1",
    timer: undefined
  },

  onInit() {
    // 先用 192×490 出图，避免首帧空；拿到真实屏幕后再重建
    this.build(192, 490)
    var self = this
    try {
      var device = require("@system.device")
      device.getInfo({
        success: function(ret) {
          var w = ret && ret.screenWidth ? ret.screenWidth : 192
          var h = ret && ret.screenHeight ? ret.screenHeight : 490
          self.build(w, h)
        },
        fail: function() {}
      })
    } catch (e) {
      /* 取不到机型信息就保持 192 基准 */
    }
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* ── 几何：12 时位按屏幕比例分配（比例封顶椭圆，见方案 §3）── */
  build(W, H) {
    if (!W || !H || W < 100 || H < 100) {
      W = 192
      H = 490
    }
    var wide = W > 300
    var S = wide ? 1.75 : 1
    // ── 圆盘几何（阶段 1 · 复刻计时码表 Pro）──
    // 方屏/圆屏（H/W ≤ 1.15）→ 1:1 正圆居中；长条屏 → 盘径取屏宽 94%，圆心下移让出顶栏
    var cx = W / 2
    var ratio = H / W
    var Rout, cy
    if (ratio <= 1.15) {
      // 方屏/圆屏：盘径取短边 86%，四周留 7% 边距（0.47 会顶到屏幕边、裁掉顶部铭文）
      Rout = Math.min(W, H) * 0.43
      cy = H / 2
    } else {
      // 长条屏：盘径取屏宽 94%，圆心上下居中（顶栏/底栏由后续信息区填充）
      Rout = W * 0.47
      cy = H / 2
    }
    var bezelW = Math.round(Rout * 0.08)
    var a = Rout - bezelW
    var b = a
    var L0 = a
    this.bezD = r1(2 * Rout)
    this.bezR = r1(Rout)
    this.bezL = r1(cx - Rout)
    this.bezT = r1(cy - Rout)
    this.dpD = r1(2 * a)
    this.dpR = r1(a)
    this.dpL = r1(cx - a)
    this.dpT = r1(cy - a)
    var tk = []
    var se = []
    var sf = []
    var st = []
    var sn = []
    var i, k, th, tw, tl, ro, big, th2, tr, nr, nw, nh, sxc, rs, scy, edgeW, nss

    // ── 主刻度 ×12：外端 0.90a 向内延伸；3/6/9/12 位加长加粗 ──
    for (i = 0; i < 12; i++) {
      big = i % 3 === 0
      th = (i * 30) * Math.PI / 180
      ro = 0.90 * a
      tl = (big ? 0.155 : 0.115) * a
      tw = (big ? 0.034 : 0.024) * a
      tk.push({
        x: r1(cx + ro * Math.sin(th) - tw / 2),
        y: r1(cy - ro * Math.cos(th)),
        w: r1(tw),
        h: r1(tl),
        c: "r" + (i * 10) + (big ? " k-long" : "")
      })
    }

    // ── 双凹陷小表盘（左上 / 右上）：外缘圈 + 深灰盘 + 内刻度 + 指示小针 ──
    rs = 0.30 * a
    scy = cy - 0.40 * a
    edgeW = 0.014 * a
    for (k = 0; k < 2; k++) {
      sxc = cx + (k === 0 ? -0.36 : 0.36) * a
      se.push({
        x: r1(sxc - rs - edgeW), y: r1(scy - rs - edgeW),
        d: r1(2 * (rs + edgeW)), r: r1(rs + edgeW)
      })
      sf.push({ x: r1(sxc - rs), y: r1(scy - rs), d: r1(2 * rs), r: r1(rs) })
      // 内刻度 ×12：起点 0.62rs，朝外
      for (i = 0; i < 12; i++) {
        th2 = (i * 30) * Math.PI / 180
        tr = 0.62 * rs
        tw = Math.max(1, 0.045 * rs)
        tl = Math.max(1, 0.26 * rs)
        st.push({
          x: r1(sxc + tr * Math.sin(th2) - tw / 2),
          y: r1(scy - tr * Math.cos(th2)),
          w: r1(tw), h: r1(tl),
          c: "r" + (i * 10)
        })
      }
      // 指示小针：左盘朝上（指向 100），右盘朝右（指向 25）
      st.push({
        x: r1(sxc - 1), y: r1(scy),
        w: Math.max(1, r1(0.055 * rs)), h: r1(0.66 * rs),
        c: stepClass(k === 0 ? 0 : 90)
      })
      // 数字 100 / 25 / 50 / 75：仅盘径足够时生成（192 上 rs≈25，字会糊成一团）
      if (rs >= 40) {
        nss = ["100", "25", "50", "75"]
        for (i = 0; i < 4; i++) {
          th2 = (i * 90) * Math.PI / 180
          nr = 0.74 * rs
          nw = 0.52 * rs
          nh = 0.26 * rs
          sn.push({
            x: r1(sxc + nr * Math.sin(th2) - nw / 2),
            y: r1(scy - nr * Math.cos(th2) - nh / 2),
            w: r1(nw), h: r1(nh), t: nss[i],
            fs: Math.max(7, Math.round(0.20 * rs))
          })
        }
      }
    }

    this.tk = tk
    this.se = se
    this.sf = sf
    this.st = st
    this.sn = sn

    // ── 表壳内圈浅灰细线（盘沿描边）──
    var ringW = Math.max(2, Math.round(0.012 * a))
    this.rgD = r1(2 * a + 2 * ringW)
    this.rgR = r1(a + ringW)
    this.rgL = r1(cx - a - ringW)
    this.rgT = r1(cy - a - ringW)

    // ── 日期：OCTOBER 小字 + 白底黑框数字（参考图形式）──
    this.moFs = Math.max(9, Math.round(0.098 * a))
    this.moW = r1(0.72 * a)
    this.moL = r1(cx - this.moW / 2)
    this.moH = Math.round(this.moFs * 1.4)
    this.moT = r1(cy + 0.28 * a)
    this.dbW = r1(0.36 * a)
    this.dbH = r1(0.26 * a)
    this.dbL = r1(cx - this.dbW / 2)
    this.dbT = r1(cy + 0.50 * a)
    this.dbBw = a > 120 ? 2 : 1
    this.dbFs = Math.max(13, Math.round(0.17 * a))

    // ── 盘下日期行 + 返回（方屏：日期居中、返回右下；长条屏：日期居中、返回左下）──
    this.dlW = r1(W * 0.9)
    this.dlL = r1(cx - this.dlW / 2)
    this.dlFs = wide ? 16 : 15
    this.dlT = r1(cy + Rout + 6)
    this.bkL = wide ? r1(W - 86) : 8
    this.bkFs = wide ? 14 : 14
    this.backT = r1(H - 26)

    // ── 三针：黑针，顶部中点压在盘心 (cx,cy)，向下延伸（配合 180° 档指向上）──
    this.hh = Math.round(0.44 * a)
    this.mh = Math.round(0.68 * a)
    this.sh = Math.round(0.84 * a)
    this.sth = Math.round(0.16 * a)
    this.hw = Math.max(3, Math.round(0.048 * a))
    this.mw = Math.max(2, Math.round(0.030 * a))
    this.sw = Math.max(1, Math.round(0.010 * a))
    this.tw = this.sw
    this.hx = r1(cx - this.hw / 2)
    this.hy = r1(cy)
    this.mx = r1(cx - this.mw / 2)
    this.my = r1(cy)
    this.sx = r1(cx - this.sw / 2)
    this.sy = r1(cy)
    this.tx = r1(cx - this.tw / 2)

    // ── 中轴：米白圆帽（直径随盘径）──
    this.hbd = Math.max(6, Math.round(0.115 * a))
    this.hbr = r1(this.hbd / 2)
    this.hbx = r1(cx - this.hbd / 2)
    this.hby = r1(cy - this.hbd / 2)
  },

  /* ── 时间：1s 心跳；只写变化字段（稳态 1 次/秒重绘，防整页闪）── */
  refresh() {
    this.stop()
    this.tick()
    var self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    var now = new Date()
    var h = now.getHours()
    var m = now.getMinutes()
    var s = now.getSeconds()
    this.hourCls = stepClass((h % 12 + m / 60 + s / 3600) * 30)
    this.minuteCls = stepClass((m + s / 60) * 6)
    this.secondCls = stepClass(s * 6)
    this.secTailCls = stepClass(s * 6 + 180)
    var d = (now.getMonth() + 1) + "-" + (now.getDate() < 10 ? "0" + now.getDate() : "" + now.getDate())
    var line = DAY_NAMES[now.getDay()] + " " + d
    if (line !== this.dateText) this.dateText = line
    var dd = now.getDate() < 10 ? "0" + now.getDate() : "" + now.getDate()
    if (dd !== this.dayText) this.dayText = dd
  },

  /* ── 返回（按钮，系列统一；已移除「点击空白返回」透明层）── */
  onBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #121212;
    position: relative;
  }

  /* ── 表壳三层：黑壳 / 盘沿浅灰细线 / 米白盘面（靠 DOM 顺序叠出壳感）── */
  .bezel { position: absolute; background-color: #121212; }
  .cring { position: absolute; background-color: #cfccc2; }
  .dial { position: absolute; background-color: #f2f0e8; }

  /* ── 主刻度 ×12 ── */
  .tick { position: absolute; background-color: #767268; }
  .k-long { background-color: #4a4843; }

  /* ── 双凹陷小表盘 ── */
  .sub-edge { position: absolute; background-color: #8e8b83; }
  .sub-face { position: absolute; background-color: #3b3a38; }
  .sub-tick { position: absolute; background-color: #efede4; }

  .sub-num {
    position: absolute;
    color: #efede4;
    text-align: center;
  }

  /* ── 日期：OCTOBER 灰字 + 白底黑框数字 ── */
  .mon {
    position: absolute;
    color: #6a6760;
    text-align: center;
    letter-spacing: 1px;
  }

  .datebox {
    position: absolute;
    background-color: #f7f5ee;
  }

  .dtext {
    position: absolute;
    color: #1f1d19;
    text-align: center;
    font-weight: bold;
  }

  .dateline {
    position: absolute;
    color: #6f6c63;
    text-align: center;
  }

  .back {
    position: absolute;
    color: #7d7a71;
  }

  /* ── 三针：纯黑（白盘用黑针，不需要阴影/高光层）── */
  .hand {
    position: absolute;
  }

  .hour {
    background-color: #1d1c1a;
  }

  .minute {
    background-color: #1d1c1a;
  }

  .second {
    background-color: #1d1c1a;
  }

  .sec-tail {
    background-color: #1d1c1a;
  }

  /* ── 中轴：米白圆帽 + 灰环 ── */
  .hub {
    position: absolute;
    background-color: #efece2;
    border: 1px solid #8a8780;
  }

  /* ── 120 档字面量旋转：rotate(180 + 3N)，180° 使针由「向下」转为「向上」── */
  .r0 { transform: rotate(180deg); }
  .r1 { transform: rotate(183deg); }
  .r2 { transform: rotate(186deg); }
  .r3 { transform: rotate(189deg); }
  .r4 { transform: rotate(192deg); }
  .r5 { transform: rotate(195deg); }
  .r6 { transform: rotate(198deg); }
  .r7 { transform: rotate(201deg); }
  .r8 { transform: rotate(204deg); }
  .r9 { transform: rotate(207deg); }
  .r10 { transform: rotate(210deg); }
  .r11 { transform: rotate(213deg); }
  .r12 { transform: rotate(216deg); }
  .r13 { transform: rotate(219deg); }
  .r14 { transform: rotate(222deg); }
  .r15 { transform: rotate(225deg); }
  .r16 { transform: rotate(228deg); }
  .r17 { transform: rotate(231deg); }
  .r18 { transform: rotate(234deg); }
  .r19 { transform: rotate(237deg); }
  .r20 { transform: rotate(240deg); }
  .r21 { transform: rotate(243deg); }
  .r22 { transform: rotate(246deg); }
  .r23 { transform: rotate(249deg); }
  .r24 { transform: rotate(252deg); }
  .r25 { transform: rotate(255deg); }
  .r26 { transform: rotate(258deg); }
  .r27 { transform: rotate(261deg); }
  .r28 { transform: rotate(264deg); }
  .r29 { transform: rotate(267deg); }
  .r30 { transform: rotate(270deg); }
  .r31 { transform: rotate(273deg); }
  .r32 { transform: rotate(276deg); }
  .r33 { transform: rotate(279deg); }
  .r34 { transform: rotate(282deg); }
  .r35 { transform: rotate(285deg); }
  .r36 { transform: rotate(288deg); }
  .r37 { transform: rotate(291deg); }
  .r38 { transform: rotate(294deg); }
  .r39 { transform: rotate(297deg); }
  .r40 { transform: rotate(300deg); }
  .r41 { transform: rotate(303deg); }
  .r42 { transform: rotate(306deg); }
  .r43 { transform: rotate(309deg); }
  .r44 { transform: rotate(312deg); }
  .r45 { transform: rotate(315deg); }
  .r46 { transform: rotate(318deg); }
  .r47 { transform: rotate(321deg); }
  .r48 { transform: rotate(324deg); }
  .r49 { transform: rotate(327deg); }
  .r50 { transform: rotate(330deg); }
  .r51 { transform: rotate(333deg); }
  .r52 { transform: rotate(336deg); }
  .r53 { transform: rotate(339deg); }
  .r54 { transform: rotate(342deg); }
  .r55 { transform: rotate(345deg); }
  .r56 { transform: rotate(348deg); }
  .r57 { transform: rotate(351deg); }
  .r58 { transform: rotate(354deg); }
  .r59 { transform: rotate(357deg); }
  .r60 { transform: rotate(360deg); }
  .r61 { transform: rotate(363deg); }
  .r62 { transform: rotate(366deg); }
