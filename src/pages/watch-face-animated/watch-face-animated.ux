<!--
  动画表盘 ④ · v2（2026-10-20 重构：秒环转盘 + 呼吸光晕 + 大字时间）
  ─────────────────────────────────────────────────────────────
  三层结构（详见 docs/动画表盘-重构方案.md）：
    L1 秒环 60 格 + 秒游标 —— 极坐标算 left/top，靠数据绑定移动，不碰 transform
    L2 HH / MM 88px 大字   —— 整分脏检查，读数优先准确
    L3 呼吸光晕            —— 唯一一条 @keyframes，只改 opacity（字面量、纯色 div、无文字）

  硬约束（本项目血泪，改本文件前必须读）：
  ① 禁 transform 数据绑定（rotate({{deg}}deg)）→ 整页黑屏（metal 头注释）；
  ② 禁 scroll + scrolltop → 引擎无效（flip v1 日志 domUpdate type:0）；
  ③ 禁群组选择器 → 整张样式表被丢弃 → 黑屏；
  ④ .page 只给 width/height:100% + position:relative，子元素全 absolute 手写坐标，
     不叠 flex 居中（与 absolute 共存会黑屏，见 metal 头注释）；
  ⑤ keyframes 里只放字面量；只挂在纯色无文字的节点上。
-->
<template>
  <div class="page" onclick="onTap">

    <text class="brand">EV</text>

    <!-- L3 呼吸光晕：外圈暗环 + 内圈底色挖空 = 10px 光带 -->
    <div class="halo"></div>
    <div class="haloIn"></div>

    <!-- L1 秒环：60 格静态刻度（5 的倍数加亮） -->
    <div class="dot {{ $item.c }}" for="{{ dots }}" style="left: {{ $item.l }}px; top: {{ $item.t }}px"></div>

    <!-- 秒游标：每秒沿环跳一格（6°）；后面两级渐隐拖尾表明走向 -->
    <div class="cur3" style="left: {{ cur3L }}px; top: {{ cur3T }}px"></div>
    <div class="cur2" style="left: {{ cur2L }}px; top: {{ cur2T }}px"></div>
    <div class="cur" style="left: {{ curL }}px; top: {{ curT }}px"></div>

    <!-- 环心：秒数 -->
    <text class="sec">{{ secText }}</text>
    <text class="seclab">SEC</text>

    <!-- L2 时间大字 -->
    <text class="dg" style="top: 186px">{{ timeH }}</text>
    <text class="dg" style="top: 290px">{{ timeM }}</text>

    <text class="date">{{ dateText }}</text>
    <text class="hint">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"

/* 秒环几何：圆心 (96,96)、半径 66、6° 一格 —— 与 CSS 里的 .halo 同圆心 */
const CX = 96
const CY = 96
const R = 66
const DOT = 5      // 普通刻度边长
const DOT_M = 7    // 5 的倍数刻度边长
const CUR = 14     // 游标边长
const TRAIL1 = 12  // 拖尾第 1 级（前 1 秒）
const TRAIL2 = 10  // 拖尾第 2 级（前 2 秒）
const WEEKS = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

function round1(v) {
  return Math.round(v * 10) / 10
}

export default {
  data: {
    dots: [],
    curL: 0,
    curT: 0,
    cur2L: 0,
    cur2T: 0,
    cur3L: 0,
    cur3T: 0,
    secText: "--",
    timeH: "--",
    timeM: "--",
    dateText: "--"
  },

  onInit() {
    this.buildDots()
    this.tick()
  },

  onReady() {
    this.start()
  },

  onShow() {
    this.start()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* 60 格刻度只生成一次，之后永不重绘 */
  buildDots() {
    const list = []
    for (let i = 0; i < 60; i++) {
      const deg = i * 6 * Math.PI / 180
      const major = i % 5 === 0
      const size = major ? DOT_M : DOT
      list.push({
        l: round1(CX + R * Math.sin(deg) - size / 2),
        t: round1(CY - R * Math.cos(deg) - size / 2),
        c: major ? "dotM" : "dot"
      })
    }
    this.dots = list
  },

  /* 走时：整秒对齐后再起 1s 心跳，避免跳秒与长跑漂移 */
  start() {
    this.stop()
    this.tick()
    const self = this
    const rest = 1000 - (Date.now() % 1000)
    this.alignTimer = setTimeout(function() {
      self.alignTimer = undefined
      self.tick()
      self.timer = setInterval(function() {
        self.tick()
      }, 1000)
    }, rest === 1000 ? 1000 : rest)
  },

  stop() {
    if (this.alignTimer) {
      clearTimeout(this.alignTimer)
      this.alignTimer = undefined
    }
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  /* 分级脏检查：秒每拍写；分只在上位变化时写；日期只在跨日时写 */
  tick() {
    const now = new Date()
    const s = now.getSeconds()
    const ss = this.pad(s)
    if (ss !== this.secText) {
      this.secText = ss
      this.placeCur(s)
    }
    const hh = this.pad(now.getHours())
    const mm = this.pad(now.getMinutes())
    if (hh !== this.timeH) this.timeH = hh
    if (mm !== this.timeM) this.timeM = mm
    const d = this.pad(now.getMonth() + 1) + "-" + this.pad(now.getDate())
            + " " + WEEKS[now.getDay()]
    if (d !== this.dateText) this.dateText = d
  },

  /* 游标 + 两级拖尾按极坐标落位（数据绑定 left/top，不涉及 transform） */
  placeCur(sec) {
    const a = this.posOf(sec * 6, CUR)
    const b = this.posOf(((sec + 59) % 60) * 6, TRAIL1)
    const c = this.posOf(((sec + 58) % 60) * 6, TRAIL2)
    this.curL = a.l
    this.curT = a.t
    this.cur2L = b.l
    this.cur2T = b.t
    this.cur3L = c.l
    this.cur3T = c.t
  },

  posOf(deg, size) {
    const rad = deg * Math.PI / 180
    return {
      l: round1(CX + R * Math.sin(rad) - size / 2),
      t: round1(CY - R * Math.cos(rad) - size / 2)
    }
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  onTap() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #0e0f16;
    position: relative;
  }

  .brand {
    position: absolute;
    left: 0;
    top: 6px;
    width: 192px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 3px;
    color: #5c7a8c;
  }

  /* 呼吸光带：140 外圈 - 120 内圈 = 10px 环 */
  .halo {
    position: absolute;
    left: 26px;
    top: 26px;
    width: 140px;
    height: 140px;
    border-radius: 70px;
    background-color: #16232e;
    animation-name: kf-breathe;
    animation-duration: 3s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .haloIn {
    position: absolute;
    left: 36px;
    top: 36px;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: #0e0f16;
  }

  .dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: #2a3b49;
  }

  .dotM {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: #46687f;
  }

  .cur {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #7ec8e3;
  }

  /* 拖尾两级：越靠后越小越暗，静帧也能看出转动方向 */
  .cur2 {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #3d7f95;
  }

  .cur3 {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #274b5c;
  }

  .sec {
    position: absolute;
    left: 0;
    top: 70px;
    width: 192px;
    text-align: center;
    font-size: 40px;
    line-height: 46px;
    font-weight: bold;
    color: #eaf6fb;
  }

  .seclab {
    position: absolute;
    left: 0;
    top: 120px;
    width: 192px;
    text-align: center;
    font-size: 10px;
    letter-spacing: 2px;
    color: #4f6a7a;
  }

  .dg {
    position: absolute;
    left: 0;
    width: 192px;
    text-align: center;
    font-size: 96px;
    line-height: 100px;
    font-weight: bold;
    color: #f2fbff;
  }

  .date {
    position: absolute;
    left: 0;
    top: 404px;
    width: 192px;
    text-align: center;
    font-size: 14px;
    color: #8fa6b5;
  }

  .hint {
    position: absolute;
    left: 0;
    top: 432px;
    width: 192px;
    text-align: center;
    font-size: 11px;
    color: #5a6b78;
  }

  /* 全页唯一动画：只动 opacity，纯色无文字节点 → 允许 */
  @keyframes kf-breathe {
    0%   { opacity: 0.35; }
    50%  { opacity: 1; }
    100% { opacity: 0.35; }
  }
</style>
