.step-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 12px;
  min-height: 100%;
  align-items: center;
}

.step-indicator {
  font-size: 48px;
  color: #7ec8e3;
  margin-bottom: 8px;
  text-align: center;
}

.step-title {
  font-size: 48px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
  text-align: center;
}

.step-input {
  width: 100%;
  height: 60px;
  border-radius: 10px;
  background-color: #16213e;
  font-size: 48px;
  color: #ffffff;
  padding: 0 14px;
  placeholder-color: #555566;
  text-align: center;
}

.nav-buttons {
  flex-direction: row;
  justify-content: space-between;
  width: 100%;
  margin-top: 20px;
}

.nav-btn {
  width: 120px;
  height: 54px;
  border-radius: 10px;
  font-size: 48px;
  font-weight: bold;
  text-align: center;
}

.back-btn {
  background-color: #333355;
  color: #a0a0b0;
}

.save-btn {
  background-color: #00cc66;
  color: #1a1a2e;
}
</style>