<template>
  <div class="step-page">
    <text class="step-indicator">Step 5/5</text>
    <text class="step-title">Notes</text>

    <input class="step-input" type="text" placeholder="Optional notes" value="{{ notes }}" onchange="onNotesChange" />

    <div class="nav-buttons">
      <input class="nav-btn back-btn" type="button" value="Back" onclick="goPrev" />
      <input class="nav-btn save-btn" type="button" value="Save" onclick="saveCourse" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  private: {
    notes: "",
    day: "",
    nextId: 100
  },

  onInit() {
    const params = this.$page.params || {}
    this.day = params.day || ""
    this.nextId = parseInt(params.nextId) || 100
    const course = this.$app.$data.newCourse || {}
    this.notes = course.notes || ""
  },

  onNotesChange(e) {
    this.notes = e.value || ""
  },

  goPrev() {
    router.back()
  },

  saveCourse() {
    const course = this.$app.$data.newCourse || {}
    if (!course.name || !course.time) {
      return
    }
    const newCourse = {
      id: String(this.nextId),
      name: course.name,
      time: course.time,
      teacher: course.teacher || "TBD",
      location: course.location || "TBD",
      notes: this.notes || ""
    }

    this.$app.$data.savedCourse = newCourse
    delete this.$app.$data.newCourse
    router.back()
  }
}
</script>

