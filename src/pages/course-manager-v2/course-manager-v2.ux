  font-size: 22px;
  font-weight: bold;
  margin-right: 10px;
  line-height: 30px;
}

.toolbar-clear {
  width: 60px;
  height: 42px;
  border-radius: 21px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
  line-height: 38px;
}

.list-scroll {
  flex: 1;
  flex-direction: column;
}

.course-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 14px;
  padding: 14px 12px;
  margin-bottom: 10px;
}

.row-left {
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.row-index {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 10px;
}

.index-num {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  line-height: 28px;
}

.row-info {
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.row-name {
  font-size: 28px;
  font-weight: bold;
  max-lines: 1;
  text-overflow: ellipsis;
  line-height: 36px;
}

.row-time {
  font-size: 22px;
  max-lines: 1;
  text-overflow: ellipsis;
  line-height: 28px;
  margin-top: 2px;
}

.row-loc {
  font-size: 20px;
  max-lines: 1;
  text-overflow: ellipsis;
  line-height: 26px;
  margin-top: 2px;
}

.row-actions {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 8px;
}

.action-btn {
  width: 56px;
  height: 44px;
  border-radius: 22px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  flex-shrink: 0;
}

.edit-btn {
  margin-right: 6px;
}

.empty-text {
  font-size: 24px;
  text-align: center;
  padding: 60px 20px;
  line-height: 34px;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 30px 16px 30px 16px;
  }
        .add-btn {
    width: 80px;
    height: 52px;
    border-radius: 26px;
    font-size: 28px;
    line-height: 48px;
  }
  .toolbar {
    padding: 8px 0;
    margin-bottom: 10px;
  }
  .toolbar-sort {
    font-size: 22px;
    margin-right: 10px;
  }
  .toolbar-clear {
    width: 60px;
    height: 42px;
    border-radius: 21px;
    font-size: 22px;
    line-height: 38px;
  }
  .course-row {
    padding: 14px 12px;
    margin-bottom: 10px;
    border-radius: 14px;
  }
  .row-index {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    margin-right: 10px;
  }
  .index-num {
    font-size: 20px;
    line-height: 28px;
  }
  .row-name {
    font-size: 28px;
    line-height: 36px;
  }
  .row-time {
    font-size: 22px;
    line-height: 28px;
  }
  .row-loc {
    font-size: 20px;
    line-height: 28px;
  }
  .action-btn {
    width: 56px;
    height: 44px;
    border-radius: 22px;
    font-size: 22px;
    line-height: 40px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 10px 12px 10px;
  }
        .add-btn {
    width: 64px;
    height: 36px;
    border-radius: 8px;
    font-size: 22px;
    line-height: 32px;
  }
  .toolbar {
    padding: 4px 0;
    margin-bottom: 6px;
  }
  .toolbar-count {
    font-size: 20px;
  }
  .toolbar-sort {
    font-size: 20px;
    margin-right: 8px;
  }
  .toolbar-clear {
    width: 50px;
    height: 32px;
    border-radius: 8px;
    font-size: 20px;
    line-height: 28px;
  }
  .course-row {
    padding: 8px 10px;
    margin-bottom: 6px;
    border-radius: 10px;
  }
  .row-index {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin-right: 8px;
  }
  .index-num {
    font-size: 20px;
    line-height: 28px;
  }
  .row-name {
    font-size: 26px;
    line-height: 34px;
  }
  .row-time {
    font-size: 20px;
    line-height: 26px;
  }
  .action-btn {
    width: 46px;
    height: 34px;
    border-radius: 8px;
    font-size: 20px;
    line-height: 30px;
  }
  .empty-text {
    font-size: 22px;
    padding: 40px 20px;
  }
}
</style>