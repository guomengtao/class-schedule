  width: 80px;
  height: 52px;
  border-radius: 26px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  flex-shrink: 0;
  line-height: 48px;
}

.toolbar {
  flex-direction: row;
  align-items: center;
  padding: 8px 0;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.toolbar-count {
  font-size: 22px;
  flex: 1;
  max-lines: 1;
  text-overflow: ellipsis;
  line-height: 30px;
}

