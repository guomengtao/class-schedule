  flex-direction: column;
  width: 100%;
  height: 100%;
}

.fb-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

