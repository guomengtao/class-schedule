  }
  .header-title {
    font-size: 32px;
  }
  .section {
    padding: 22px 18px;
  }
}

/* ================================================================
   圆形表盘（唯一保留的 shape 查询）
   ================================================================ */
@media (shape: circle) {
  .page-body {
    padding: 44px 36px 44px 36px;
  }
}
</style>