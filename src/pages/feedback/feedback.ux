  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
}

.item-label {
  font-size: 26px;
  line-height: 36px;
  flex-shrink: 0;
}

.item-value {
  font-size: 24px;
  line-height: 34px;
}

.row-divider {
  width: 100%;
  height: 1px;
}

.sec-title {
  font-size: 26px;
  font-weight: bold;
  margin-bottom: 6px;
  line-height: 36px;
}

.sec-desc {
  font-size: 22px;
  line-height: 30px;
  margin-bottom: 12px;
}

.qr-wrapper {
  width: 176px;
  height: 176px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  align-self: center;
  margin-bottom: 8px;
}

.qr-url {
  font-size: 18px;
  line-height: 26px;
  text-align: center;
  word-break: break-all;
}

