<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="fb-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">反馈</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">当前版本</text>
        <text class="item-value" style="color: {{ theme.textMuted }}">v{{ versionName }}</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">发布渠道</text>
        <text class="item-value" style="color: {{ theme.textMuted }}">{{ channel }}</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">设备型号</text>
        <text class="item-value" style="color: {{ theme.textMuted }}">{{ deviceModel }}</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="sec-title" style="color: {{ theme.text }}">扫码反馈</text>
      <text class="sec-desc" style="color: {{ theme.textMuted }}">手机扫码提交反馈</text>
      <div class="qr-wrapper" style="background-color: #ffffff">
        <qrcode value="{{ feedbackUrl }}" style="color: #000000; background-color: #ffffff; width: 120px; height: 120px;"></qrcode>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="sec-title" style="color: {{ theme.text }}">QQ 群</text>
      <text class="sec-desc" style="color: {{ theme.textMuted }}">群号与暗号见网页</text>
      <!-- ev-six 第 11 条：页面不展示 URL 正文（手环上 30+ 字符必然折成 5 行残句）。
           链接只保留在复制按钮背后，用户点一下就到手机端。 -->
      <div class="copy-btn" onclick="copyUrl" style="background-color: {{ theme.accent }}">
        <text class="copy-text" style="color: #ffffff">复制反馈链接</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="sec-title" style="color: {{ theme.text }}">常见问题</text>
      <div class="faq-item">
        <text class="faq-q" style="color: {{ theme.text }}">课程不显示</text>
        <text class="faq-a" style="color: {{ theme.textMuted }}">查周课表勾选</text>
      </div>
      <div class="faq-item">
        <text class="faq-q" style="color: {{ theme.text }}">备份与恢复</text>
        <text class="faq-a" style="color: {{ theme.textMuted }}">设置里可备份</text>
      </div>
      <div class="faq-item">
        <text class="faq-q" style="color: {{ theme.text }}">主题怎么换</text>
        <text class="faq-a" style="color: {{ theme.textMuted }}">设置里换主题</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
var store = require("../../data/store.js")
var version = require("../../data/version.js")
var device = require("@system.device")
var clipboard = require("@system.clipboard")
var prompt = require("@system.prompt")

export default {
  private: {
    theme: {},
    iconTheme: "dark",
    versionName: version.versionName,
    channel: version.channel,
    deviceModel: "",
    feedbackUrl: "",
    feedbackUrlShort: ""
  },

  onInit() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.iconTheme = themeName === "dark" ? "dark" : "light"
    })
    device.getInfo({
      success: function (ret) {
        self.deviceModel = ret.model || ret.brand || "unknown"
        self.buildUrl()
      },
      fail: function () {
        self.deviceModel = "unknown"
        self.buildUrl()
      }
    })
  },

  buildUrl() {
    var base = "https://app-auth.gudq.com/feedback.html"
    var url = base
      + "?src=watch"
      + "&v=" + encodeURIComponent(version.versionName)
      + "&m=" + encodeURIComponent(this.deviceModel)
      + "&ch=" + encodeURIComponent(version.channel)
    this.feedbackUrl = url
    this.feedbackUrlShort = "app-auth.gudq.com/feedback.html"
  },

  copyUrl() {
    var url = "https://app-auth.gudq.com/feedback.html"
    clipboard.set({
      text: url,
      success: function () {
        prompt.showToast({ message: "网址已复制，请在手机打开" })
      },
      fail: function () {
        prompt.showToast({ message: "请手动记下 " + url })
      }
    })
  },

  goBack() {
    var router = require("@system.router")
    router.back()
  }
}
</script>

<style>
/* ================================================================
   BASE CSS = 手环 9 基准（160px 内容区）
   ================================================================ */
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.fb-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
}

.back-btn-wrapper {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 22px;
  height: 22px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 36px;
}

.header-placeholder {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
}

.section {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.item-row {
  /* 两行制：192px 宽屏放不下「当前版本 v1.9.41」这种 label+value 同行（104+84=188 > 140） */
  flex-direction: column;
  align-items: flex-start;
  padding: 8px 0;
}

.item-label {
  font-size: 24px;
  line-height: 32px;
}

.item-value {
  font-size: 24px;
  line-height: 34px;
}

.row-divider {
  width: 100%;
  height: 1px;
}

.sec-title {
  font-size: 26px;
  font-weight: bold;
  margin-bottom: 6px;
  line-height: 36px;
}

.sec-desc {
  font-size: 22px;
  line-height: 31px;
  margin-bottom: 12px;
  text-align: center;
}

.qr-wrapper {
  /* 132px = 内容区 140px − 8px 余量：原 176px 直接顶出卡片（真机反馈「歪的」） */
  width: 132px;
  height: 132px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  align-self: center;
  margin-bottom: 8px;
}

.qq-num {
  font-size: 28px;
  font-weight: bold;
  letter-spacing: 1px;
  line-height: 38px;
}

.copy-btn {
  /* 整行按钮：URL 文本删除后，按钮就是这一栏唯一的操作入口，行内小胶囊太弱 */
  width: 100%;
  height: 52px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-top: 8px;
}

.copy-text {
  font-size: 26px;
  line-height: 34px;
}

.faq-item {
  flex-direction: column;
  padding: 10px 0;
}

.faq-q {
  font-size: 24px;
  font-weight: bold;
  line-height: 34px;
  margin-bottom: 2px;
}

.faq-a {
  font-size: 22px;
  line-height: 30px;
  text-align: center;
}

/* ================================================================
   宽度断点：手环 10 / 胶囊屏大号（width >= 200px）
   ================================================================ */
@media (width >= 200px) {
  .page-body {
    padding: 44px 10px 12px 10px;
  }
  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
  .item-label {
    font-size: 28px;
