}

.faq-item {
  flex-direction: column;
  padding: 10px 0;
}

.faq-q {
  font-size: 24px;
  font-weight: bold;
  line-height: 34px;
  margin-bottom: 2px;
}

.faq-a {
  font-size: 22px;
  line-height: 30px;
}

/* ================================================================
   宽度断点：手环 10 / 胶囊屏大号（width >= 200px）
   ================================================================ */
@media (width >= 200px) {
  .page-body {
    padding: 44px 10px 12px 10px;
  }
  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
  .item-label {
    font-size: 28px;
