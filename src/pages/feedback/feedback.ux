  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.qq-num {
  font-size: 28px;
  font-weight: bold;
  letter-spacing: 1px;
  line-height: 38px;
}

.copy-btn {
  padding: 8px 14px;
  border-radius: 8px;
}

