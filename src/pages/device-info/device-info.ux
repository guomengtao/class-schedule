<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="di-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">设备信息</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="loading" if="{{ loading }}" style="background-color: {{ theme.card }}">
      <text class="loading-icon">⬡</text>
      <text class="loading-text" style="color: {{ theme.textMuted }}">获取中...</text>
    </div>

    <div class="error-card" if="{{ errorMsg }}" style="background-color: {{ theme.card }}">
      <text class="error-icon">⚠</text>
      <text class="error-text" style="color: #e74c3c">{{ errorMsg }}</text>
      <input class="retry-btn" type="button" value="重试" onclick="fetchDeviceInfo" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="info-section" if="{{ !loading && !errorMsg }}">
      <div class="hero-card" style="background-color: {{ theme.card }}">
        <text class="hero-model" style="color: {{ theme.text }}">{{ heroModel }}</text>
        <text class="hero-sub" style="color: {{ theme.textSecondary }}">{{ heroSub }}</text>
      </div>

      <div class="grp" for="{{ groups }}" style="background-color: {{ theme.card }}">
        <text class="grp-title" style="color: {{ theme.textSecondary }}">{{ $item.title }}</text>
        <div class="item" for="{{ $item.items }}">
          <text class="item-k" style="color: {{ theme.textSecondary }}">{{ $item.label }}</text>
          <text class="item-v" style="color: {{ theme.text }}">{{ $item.value || '未知' }}</text>
        </div>
      </div>
    </div>

    <div class="pin-row">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}">钉首页</text>
    </div>
    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")
import device from "@system.device"
const store = require("../../data/store.js")

var screenShapeMap = {
  "rect": "方形屏",
  "circle": "圆形屏",
  "pill-shaped": "胶囊形屏"
}

var deviceTypeMap = {
  "watch": "手表",
  "band": "手环",
  "smartspeaker": "智能音箱"
}

function formatStorage(bytes) {
  if (bytes == null) return "未知"
  if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2) + " GB"
  if (bytes >= 1048576) return (bytes / 1048576).toFixed(2) + " MB"
  if (bytes >= 1024) return (bytes / 1024).toFixed(2) + " KB"
  return bytes + " B"
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    loading: true,
    errorMsg: "",
    infoList: [],
    groups: [],
    heroModel: "",
    heroSub: ""
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    this.fetchDeviceInfo()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  fetchDeviceInfo() {
    var self = this
    self.loading = true
    self.errorMsg = ""

    device.getInfo({
      success: function(ret) {
        self.infoList = [
          { label: "设备型号", value: ret.model, grp: 0 },
          { label: "设备品牌", value: ret.brand, grp: 0 },
          { label: "设备类型", value: deviceTypeMap[ret.deviceType] || ret.deviceType, grp: 0 },
          { label: "屏幕形状", value: screenShapeMap[ret.screenShape] || ret.screenShape, grp: 0 },
          { label: "屏幕分辨率", value: (ret.screenWidth && ret.screenHeight) ? ret.screenWidth + " × " + ret.screenHeight + " px" : "", grp: 1 },
          { label: "屏幕密度", value: ret.screenDensity, grp: 1 },
          { label: "系统版本", value: ret.osVersionName, grp: 2 },
          { label: "平台版本", value: ret.platformVersionName, grp: 2 },
          { label: "API Level", value: ret.APILevel, grp: 2 },
          { label: "总存储空间", value: "", grp: 2 },
          { label: "语言 / 地区", value: ret.language ? ret.language + " · " + ret.region : "", grp: 2 },
          { label: "设备代号", value: ret.product, grp: 3 },
          { label: "制造商", value: ret.manufacturer, grp: 3 },
          { label: "操作系统", value: ret.osType, grp: 3 },
          { label: "系统版本号", value: ret.osVersionCode, grp: 3 },
          { label: "平台版本号", value: ret.platformVersionCode, grp: 3 },
          { label: "设备 ID", value: "", grp: 4 },
          { label: "序列号", value: "", grp: 4 }
        ]
        self.heroModel = ret.model || "未知设备"
        self.heroSub = (ret.brand || "") + " · " + (deviceTypeMap[ret.deviceType] || ret.deviceType || "") + " · " + (screenShapeMap[ret.screenShape] || "")
        self.buildGroups()
        self.loading = false
      },
      fail: function(data, code) {
        self.errorMsg = "获取设备信息失败，错误码：" + code
        self.loading = false
      }
    })

    device.getDeviceId({
      success: function(data) {
        self.infoList.push({ label: "设备 ID", value: data.deviceId, grp: 4 })
        self.buildGroups()
      },
      fail: function(data, code) {
        self.infoList.push({ label: "设备 ID", value: "获取失败(" + code + ")", grp: 4 })
        self.buildGroups()
      }
    })

    device.getSerial({
      success: function(data) {
        self.infoList.push({ label: "序列号", value: data.serial, grp: 4 })
        self.buildGroups()
      },
      fail: function(data, code) {
        self.infoList.push({ label: "序列号", value: "获取失败(" + code + ")", grp: 4 })
        self.buildGroups()
      }
    })

    device.getTotalStorage({
      success: function(data) {
        self.setItemValue("总存储空间", formatStorage(data.totalStorage))
      },
      fail: function() {
        self.setItemValue("总存储空间", "获取失败")
      }
    })

    device.getAvailableStorage({
      success: function(data) {
        self.setItemValue("可用存储空间", formatStorage(data.availableStorage))
      },
      fail: function() {
        self.setItemValue("可用存储空间", "获取失败")
      }
    })
  },

  // 把 infoList 按 grp 分组为 groups（两行式键值：值独占整行，超长自动换行禁省略）
  buildGroups() {
    var titles = ["设备", "屏幕", "系统", "调试", "标识"]
    var groups = []
    for (var g = 0; g < titles.length; g++) {
      var items = []
      for (var i = 0; i < this.infoList.length; i++) {
        var it = this.infoList[i]
        if (it.grp === g && it.value !== "") items.push({ label: it.label, value: it.value })
      }
      if (items.length) groups.push({ title: titles[g], items: items })
    }
    this.groups = groups
  },

  setItemValue(label, value) {
    for (var i = 0; i < this.infoList.length; i++) {
      if (this.infoList[i].label === label) {
        this.infoList[i].value = value
        break
      }
    }
    this.buildGroups()
  },

  goBack() {
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("设备信息", "/pages/device-info")
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

/* 滚动容器：21 条信息约 1302px 高，超过一屏必须可滚（QA P0-18，
   参照 settings.ux / homepage-settings.ux 已验证写法） */
.di-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

/* 内层容器承载 padding：Vela 绝对定位按父级内容盒计算，根容器不放 padding */
.page-body {
  flex-direction: column;
  width: 100%;
  padding: 38px 8px 10px 8px;
}

.info-section {
  width: 100%;
  flex-direction: column;
}

.hero-card {
  flex-direction: column;
  border-radius: 14px;
  padding: 12px 12px 10px 12px;
  margin-bottom: 8px;
  align-items: center;
}

.hero-model {
  font-size: 26px;
  line-height: 34px;
  text-align: center;
}

.hero-sub {
  font-size: 20px;
  line-height: 28px;
  text-align: center;
  margin-top: 2px;
}

.grp {
  flex-direction: column;
  border-radius: 12px;
  padding: 6px 10px 2px 10px;
  margin-bottom: 8px;
}

.grp-title {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
  margin-bottom: 2px;
}

/* 两行式键值：值独占整行，超长自动换行（禁省略）——外部数据长度不可控的兜底 */
.item {
  flex-direction: column;
  padding: 6px 0;
  border-top-width: 1px;
  border-top-color: rgba(128, 128, 128, 0.25);
}

.item-k {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
}

.item-v {
  font-size: 24px;
  line-height: 32px;
}

.pin-row {
  flex-direction: row;
  justify-content: center;
  padding: 10px 0 6px 0;
}

.pin-link {
  text-align: center;
  font-size: 22px;
  line-height: 30px;
  lines: 1;
}

.loading {
  flex-direction: column;
  border-radius: 10px;
  padding: 40px 16px;
  align-items: center;
}

.loading-icon {
  font-size: 28px;
  margin-bottom: 8px;
  line-height: 36px;
}

.loading-text {
  font-size: 24px;
  line-height: 32px;
  lines: 1;
}

.error-card {
  flex-direction: column;
  border-radius: 10px;
  padding: 16px 14px;
  margin-bottom: 6px;
  align-items: center;
}

.error-icon {
  font-size: 28px;
  margin-bottom: 6px;
  line-height: 36px;
}

.error-text {
  font-size: 24px;
  text-align: center;
  margin-bottom: 8px;
  line-height: 32px;
  lines: 1;
}

.retry-btn {
  width: 72px;
  height: 32px;
  border-radius: 16px;
  font-size: 22px;
  text-align: center;
  line-height: 30px;
}

/*
 * Capsule screen width budget (192px screen):
 *   192 - 16*2(page padding) = 160px content area
 *   160 - 12*2(menu-item padding) = 136px inner width
 *
 *   Horizontal layout fails: shortest label "品牌"(2ch*22px=44px)
 *   leaves only 136-44-8(gap)=84px for value; longest label
 *   "平台版本名称"(6ch*22px=132px) leaves just 136-132-8=-4px.
 *   Most device info values (model names, IDs, versions) exceed 84px.
 *
 *   Solution: stacked vertical layout, label on top, value wraps below.
 */
@media screen and (shape: pill-shaped) {
  .page-body {
    padding: 30px 16px 30px 16px;
  }
  .menu-item {
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 12px;
    margin-bottom: 8px;
  }
  .menu-label {
    font-size: 22px;
    line-height: 30px;
    margin-bottom: 2px;
  }
  .menu-value {
    font-size: 20px;
    line-height: 28px;
    text-align: left;
    margin-left: 0;
    lines: 0;
  }
  .retry-btn {
    height: 38px;
    font-size: 24px;
    line-height: 32px;
  }
  .pin-link {
    font-size: 24px;
    line-height: 32px;
  }
}

@media screen and (shape: circle) {
  .page-body {
    padding: 38px 36px 44px 36px;
  }
  .menu-item {
    padding: 12px 12px;
    margin-bottom: 8px;
  }
  .menu-label {
    font-size: 26px;
    line-height: 34px;
  }
  .menu-value {
    font-size: 24px;
    line-height: 32px;
  }
  .loading-text {
    font-size: 26px;
    line-height: 34px;
  }
  .error-text {
    font-size: 26px;
    line-height: 34px;
  }
  .retry-btn {
    height: 36px;
    font-size: 24px;
    line-height: 32px;
  }
  .pin-link {
    font-size: 24px;
    line-height: 32px;
  }
}

@media screen and (shape: rect) {
  .page-body {
    padding: 6px 10px 12px 10px;
  }
  .menu-item {
    padding: 12px 12px;
  }
  .menu-label {
    font-size: 28px;
    line-height: 36px;
  }
  .menu-value {
    font-size: 26px;
    line-height: 34px;
  }
  .pin-link {
    font-size: 24px;
    line-height: 32px;
  }
}
</style>