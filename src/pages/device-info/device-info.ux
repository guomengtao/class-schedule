  flex-direction: column;
  border-radius: 12px;
  padding: 50px 16px;
  align-items: center;
}

.loading-icon {
  font-size: 36px;
  margin-bottom: 10px;
  line-height: 44px;
}

.loading-text {
  font-size: 28px;
  line-height: 36px;
}

.error-card {
  flex-direction: column;
  border-radius: 12px;
  padding: 20px 16px;
  margin-bottom: 8px;
  align-items: center;
}

.error-icon {
  font-size: 36px;
  margin-bottom: 8px;
  line-height: 44px;
}

.error-text {
  font-size: 28px;
  text-align: center;
  margin-bottom: 10px;
  line-height: 36px;
}

.retry-btn {
  width: 80px;
  height: 38px;
  border-radius: 8px;
  font-size: 24px;
