<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="di-scroll" scroll-y="{{true}}">
      <div class="page-body">
        <div class="header">
          <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
            <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
          </div>
          <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">设备信息</text>
          <div class="header-placeholder"></div>
        </div>

        <div class="loading" if="{{ loading }}" style="background-color: {{ theme.card }}">
          <text class="loading-icon">⬡</text>
          <text class="loading-text" style="color: {{ theme.textMuted }}">读取铭牌中...</text>
        </div>

        <div class="error-card" if="{{ errorMsg }}" style="background-color: {{ theme.card }}">
          <text class="error-icon">⚠</text>
          <text class="error-text" style="color: #e74c3c">{{ errorMsg }}</text>
          <input class="retry-btn" type="button" value="重试" onclick="fetchDeviceInfo" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        </div>

        <div class="info-section" if="{{ !loading && !errorMsg }}">
          <div class="hr"></div>

          <!-- 全部数据统一「两行成对」：标签一行、值一行。
               值不设 lines —— 超宽时自动换行，完整显示，绝不截断。 -->
          <div class="kv" for="{{ rows }}">
            <text class="lbl" style="color: {{ theme.textSecondary }}">{{ $item.label }}</text>
            <text class="val" style="color: {{ theme.text }}">{{ $item.value }}</text>
          </div>
        </div>

        <div class="pin-row">
          <input class="pin-chip" type="button" value="钉首页" onclick="pinToHome" style="background-color: {{ theme.card }}; color: {{ theme.textSecondary }}" />
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")
import device from "@system.device"
const store = require("../../data/store.js")

var screenShapeMap = {
  "rect": "方形屏",
  "circle": "圆形屏",
  "pill-shaped": "胶囊形屏"
}

var deviceTypeMap = {
  "watch": "手表",
  "band": "手环",
  "smartspeaker": "智能音箱"
}

function formatStorage(bytes) {
  if (bytes == null) return "未知"
  if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2) + " GB"
  if (bytes >= 1048576) return (bytes / 1048576).toFixed(2) + " MB"
  if (bytes >= 1024) return (bytes / 1024).toFixed(2) + " KB"
  return bytes + " B"
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    loading: true,
    errorMsg: "",
    rows: [],
    totalBytes: 0,
    availBytes: 0
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    this.fetchDeviceInfo()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  fetchDeviceInfo() {
    var self = this
    self.loading = true
    self.errorMsg = ""
    self.totalBytes = 0
    self.availBytes = 0

    device.getInfo({
      success: function(ret) {
        // 一份顺序固定的两行成对清单；异步字段先占位，到达后原位更新，布局不跳
        self.rows = [
          { label: "设备型号", value: ret.model || "未知" },
          { label: "设备品牌", value: ret.brand || "未知" },
          { label: "设备类型", value: deviceTypeMap[ret.deviceType] || ret.deviceType || "未知" },
          { label: "屏幕形状", value: screenShapeMap[ret.screenShape] || ret.screenShape || "未知" },
          { label: "屏幕分辨率", value: (ret.screenWidth && ret.screenHeight) ? ret.screenWidth + " × " + ret.screenHeight + " px" : "未知" },
          { label: "屏幕密度", value: ret.screenDensity || "未知" },
          { label: "系统版本", value: ret.osVersionName || "未知" },
          { label: "平台版本", value: ret.platformVersionName ? "快应用 " + ret.platformVersionName : "未知" },
          { label: "API Level", value: (ret.APILevel != null) ? "" + ret.APILevel : "未知" },
          { label: "可用存储空间", value: "读取中…" },
          { label: "总存储空间", value: "读取中…" },
          { label: "存储余量", value: "读取中…" },
          { label: "语言 / 地区", value: ret.language ? ret.language + " · " + ret.region : "未知" },
          { label: "设备代号", value: ret.product || "未知" },
          { label: "制造商", value: ret.manufacturer || "未知" },
          { label: "操作系统", value: ret.osType || "未知" },
          { label: "设备 ID", value: "读取中…" },
          { label: "序列号", value: "读取中…" }
        ]
        self.loading = false
      },
      fail: function(data, code) {
        self.errorMsg = "铭牌读取失败，错误码：" + code
        self.loading = false
      }
    })

    device.getDeviceId({
      success: function(data) {
        self.setRow("设备 ID", data.deviceId || "未知")
      },
      fail: function(data, code) {
        self.setRow("设备 ID", "获取失败(" + code + ")")
      }
    })

    device.getSerial({
      success: function(data) {
        self.setRow("序列号", data.serial || "未知")
      },
      fail: function(data, code) {
        self.setRow("序列号", "获取失败(" + code + ")")
      }
    })

    device.getTotalStorage({
      success: function(data) {
        self.totalBytes = data.totalStorage || 0
        self.setRow("总存储空间", formatStorage(data.totalStorage))
        self.refreshStoragePct()
      },
      fail: function() {
        self.setRow("总存储空间", "获取失败")
      }
    })

    device.getAvailableStorage({
      success: function(data) {
        self.availBytes = data.availableStorage || 0
        self.setRow("可用存储空间", formatStorage(data.availableStorage))
        self.refreshStoragePct()
      },
      fail: function() {
        self.setRow("可用存储空间", "获取失败")
      }
    })
  },

  // 按标签原位更新；找不到则追加。值再长也不截断，交给 text 自动换行
  setRow(label, value) {
    var rows = (this.rows || []).slice()
    for (var i = 0; i < rows.length; i++) {
      if (rows[i].label === label) {
        rows[i] = { label: label, value: value }
        this.rows = rows
        return
      }
    }
    rows.push({ label: label, value: value })
    this.rows = rows
  },

  // 总量与余量都到手后算一次百分比（两个异步回调谁后到都行）
  refreshStoragePct() {
    if (this.totalBytes > 0 && this.availBytes > 0) {
      var pct = Math.min(100, Math.round(this.availBytes / this.totalBytes * 100))
      this.setRow("存储余量", "余 " + pct + "%")
    }
  },

  goBack() {
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("设备信息", "/pages/device-info")
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

/* 滚动容器：18 组成对数据超过一屏必须可滚 */
.di-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

/* 内层容器承载 padding：Vela 绝对定位按父级内容盒计算，根容器不放 padding */
.page-body {
  flex-direction: column;
  width: 100%;
  padding: 38px 8px 10px 8px;
}

.info-section {
  width: 100%;
  flex-direction: column;
}

.hr {
  height: 1px;
  background-color: rgba(128, 128, 128, 0.25);
  margin: 12px 0 6px 0;
}

/* ── 两行成对（全页唯一数据行样式） ─────────────────────────
 * 标签上行、值下行，值独占整行 164px。
 * 不设 lines：值超宽时自动换行，从结构上杜绝
 * 「隐藏 / 省略 / 截断」——长数据（如 32 位设备 ID）
 * 会完整折成多行显示。
 * ──────────────────────────────────────────────────────── */
.kv {
  flex-direction: column;
  align-items: flex-start;
  padding: 6px 0;
}

/* 2026-10-21 规则 §七：14px → 18px。标签都是 4–5 字（设备型号/屏幕分辨率），
   18px 下最宽 90px，值仍独占整行 164px，两行成对的结构不变 */
.lbl {
  font-size: 18px;
  letter-spacing: 1px;
}

.val {
  font-family: monospace;
  font-size: 18px;
  margin-top: 2px;
  text-align: left;
}

.pin-row {
  flex-direction: row;
  justify-content: center;
  padding: 12px 0 8px 0;
}

.pin-chip {
  width: 110px;
  height: 44px;
  border-radius: 9px;
  font-size: 18px;
  text-align: center;
  line-height: 40px;
}

.loading {
  flex-direction: column;
  border-radius: 10px;
  padding: 40px 16px;
  align-items: center;
}

.loading-icon {
  font-size: 28px;
  margin-bottom: 8px;
  line-height: 36px;
}

/* 不设 lines：文案允许换行，绝不截断 */
.loading-text {
  font-size: 22px;
  text-align: center;
  line-height: 30px;
}

.error-card {
  flex-direction: column;
  border-radius: 10px;
  padding: 16px 14px;
  margin-bottom: 6px;
  align-items: center;
}

.error-icon {
  font-size: 28px;
  margin-bottom: 6px;
  line-height: 36px;
}

/* 不设 lines：错误码文案允许换行，绝不截断 */
.error-text {
  font-size: 22px;
  text-align: center;
  margin-bottom: 8px;
  line-height: 30px;
}

.retry-btn {
  width: 72px;
  height: 44px;
  border-radius: 16px;
  font-size: 22px;
  text-align: center;
  line-height: 40px;
}

/*
 * 胶囊屏（9 标准版 192×490，r96 标准跑道形）：
 *   安全区 y≥38 / 侧边 14px / 内容宽 164px
 *   字号全局统一：标签 18px、值 18px，两行成对，
 *   长值自动换行，不截断
 */
@media screen and (shape: pill-shaped) {
  .page-body {
    padding: 30px 14px 16px 14px;
  }
}

@media screen and (shape: circle) {
  .page-body {
    padding: 38px 36px 44px 36px;
  }
  .loading-text {
    font-size: 24px;
    line-height: 32px;
  }
  .error-text {
    font-size: 24px;
    line-height: 32px;
  }
  .retry-btn {
    height: 44px;
    font-size: 24px;
    line-height: 40px;
  }
}

@media screen and (shape: rect) {
  .page-body {
    padding: 6px 10px 12px 10px;
  }
}
</style>
