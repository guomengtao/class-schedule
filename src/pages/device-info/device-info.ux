    font-size: 28px;
  }
  .menu-value {
    font-size: 24px;
  }
  .loading-text {
    font-size: 24px;
  }
  .error-text {
    font-size: 24px;
  }
  .retry-btn {
    height: 34px;
    font-size: 20px;
  }
  .pin-link {
