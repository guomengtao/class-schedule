<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="di-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">设备信息</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="loading" if="{{ loading }}" style="background-color: {{ theme.card }}">
      <text class="loading-icon">⬡</text>
      <text class="loading-text" style="color: {{ theme.textMuted }}">读取铭牌中...</text>
    </div>

    <div class="error-card" if="{{ errorMsg }}" style="background-color: {{ theme.card }}">
      <text class="error-icon">⚠</text>
      <text class="error-text" style="color: #e74c3c">{{ errorMsg }}</text>
      <input class="retry-btn" type="button" value="重试" onclick="fetchDeviceInfo" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="info-section" if="{{ !loading && !errorMsg }}">
      <!-- 铭牌头版：车号 + 关键参数 + 载重表 -->
      <text class="kicker" style="color: {{ theme.textSecondary }}">设备铭牌 · DEVICE PLATE</text>
      <text class="unit" style="color: {{ theme.text }}">{{ heroModel }}</text>
      <text class="unit-code" if="{{ product }}">CODE · {{ product }}</text>
      <text class="unit-sub" style="color: {{ theme.textSecondary }}">{{ heroSub }}</text>

      <div class="hr"></div>
      <div class="kv" for="{{ keyRows }}">
        <text class="lbl" style="color: {{ theme.textSecondary }}">{{ $item.label }}</text>
        <div class="lead"></div>
        <text class="val" style="color: {{ theme.text }}">{{ $item.value }}</text>
      </div>

      <div class="gauge" if="{{ storage.has }}">
        <div class="kv" style="padding-bottom: 0">
          <text class="lbl" style="color: {{ theme.textSecondary }}">存储</text>
          <div class="lead"></div>
          <text class="val" style="color: {{ theme.accent }}">余 {{ storage.pct }}%</text>
        </div>
        <div class="bar">
          <div class="fill" style="width: {{ storage.pct }}%; background-color: {{ theme.accent }}"></div>
        </div>
        <div class="cap" style="color: {{ theme.textMuted }}">
          <text>可用 {{ storage.avail }}</text>
          <text>总 {{ storage.total }}</text>
        </div>
      </div>

      <!-- 续页：全量参数（分组点线表 + 长值整行下沉） -->
      <text class="spec-hint" style="color: {{ theme.textMuted }}">── 完整参数 ──</text>
      <div class="grp" for="{{ groups }}" style="background-color: {{ theme.card }}">
        <text class="gt" style="color: {{ theme.textSecondary }}">{{ $item.title }}</text>
        <block for="{{ $item.items }}">
          <div class="kv" if="{{ !$item.long }}">
            <text class="lbl" style="color: {{ theme.textSecondary }}">{{ $item.label }}</text>
            <div class="lead"></div>
            <text class="val" style="color: {{ theme.text }}">{{ $item.value }}</text>
          </div>
          <div class="longrow" if="{{ $item.long }}">
            <text class="long-k" style="color: {{ theme.textSecondary }}">{{ $item.label }}</text>
            <text class="long-v" style="color: {{ theme.text }}">{{ $item.value }}</text>
          </div>
        </block>
      </div>
    </div>

    <div class="pin-row">
      <input class="pin-chip" type="button" value="钉首页" onclick="pinToHome" style="background-color: {{ theme.card }}; color: {{ theme.textSecondary }}" />
    </div>
    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")
import device from "@system.device"
const store = require("../../data/store.js")

var screenShapeMap = {
  "rect": "方形屏",
  "circle": "圆形屏",
  "pill-shaped": "胶囊形屏"
}

var deviceTypeMap = {
  "watch": "手表",
  "band": "手环",
  "smartspeaker": "智能音箱"
}

function formatStorage(bytes) {
  if (bytes == null) return "未知"
  if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2) + " GB"
  if (bytes >= 1048576) return (bytes / 1048576).toFixed(2) + " MB"
  if (bytes >= 1024) return (bytes / 1024).toFixed(2) + " KB"
  return bytes + " B"
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    loading: true,
    errorMsg: "",
    infoList: [],
    groups: [],
    heroModel: "",
    heroSub: "",
    product: "",
    keyRows: [],
    storage: { totalBytes: 0, availBytes: 0, has: false, pct: 0, avail: "", total: "" }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    this.fetchDeviceInfo()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  fetchDeviceInfo() {
    var self = this
    self.loading = true
    self.errorMsg = ""

    device.getInfo({
      success: function(ret) {
        self.infoList = [
          { label: "设备型号", value: ret.model, grp: 0 },
          { label: "设备品牌", value: ret.brand, grp: 0 },
          { label: "设备类型", value: deviceTypeMap[ret.deviceType] || ret.deviceType, grp: 0 },
          { label: "屏幕形状", value: screenShapeMap[ret.screenShape] || ret.screenShape, grp: 0 },
          { label: "屏幕分辨率", value: (ret.screenWidth && ret.screenHeight) ? ret.screenWidth + " × " + ret.screenHeight + " px" : "", grp: 1 },
          { label: "屏幕密度", value: ret.screenDensity, grp: 1 },
          { label: "系统版本", value: ret.osVersionName, grp: 2 },
          { label: "平台版本", value: ret.platformVersionName, grp: 2 },
          { label: "API Level", value: ret.APILevel, grp: 2 },
          { label: "总存储空间", value: "", grp: 2 },
          { label: "语言 / 地区", value: ret.language ? ret.language + " · " + ret.region : "", grp: 2 },
          { label: "设备代号", value: ret.product, grp: 3 },
          { label: "制造商", value: ret.manufacturer, grp: 3 },
          { label: "操作系统", value: ret.osType, grp: 3 },
          { label: "系统版本号", value: ret.osVersionCode, grp: 3 },
          { label: "平台版本号", value: ret.platformVersionCode, grp: 3 },
          { label: "设备 ID", value: "", grp: 4 },
          { label: "序列号", value: "", grp: 4 }
        ]
        self.heroModel = ret.model || "未知设备"
        self.heroSub = (ret.brand || "") + " · " + (deviceTypeMap[ret.deviceType] || ret.deviceType || "") + " · " + (screenShapeMap[ret.screenShape] || "")
        self.product = ret.product || ""
        self.keyRows = [
          { label: "系统", value: ret.osVersionName || "未知" },
          { label: "平台", value: ret.platformVersionName ? "快应用 " + ret.platformVersionName : "未知" },
          { label: "屏幕", value: (ret.screenWidth && ret.screenHeight) ? ret.screenWidth + " × " + ret.screenHeight : "未知" },
          { label: "API", value: (ret.APILevel != null) ? "" + ret.APILevel : "未知" }
        ]
        self.buildGroups()
        self.loading = false
      },
      fail: function(data, code) {
        self.errorMsg = "铭牌读取失败，错误码：" + code
        self.loading = false
      }
    })

    device.getDeviceId({
      success: function(data) {
        self.infoList.push({ label: "设备 ID", value: data.deviceId, grp: 4 })
        self.buildGroups()
      },
      fail: function(data, code) {
        self.infoList.push({ label: "设备 ID", value: "获取失败(" + code + ")", grp: 4 })
        self.buildGroups()
      }
    })

    device.getSerial({
      success: function(data) {
        self.infoList.push({ label: "序列号", value: data.serial, grp: 4 })
        self.buildGroups()
      },
      fail: function(data, code) {
        self.infoList.push({ label: "序列号", value: "获取失败(" + code + ")", grp: 4 })
        self.buildGroups()
      }
    })

    device.getTotalStorage({
      success: function(data) {
        self.setItemValue("总存储空间", formatStorage(data.totalStorage))
        self.setStorage("total", data.totalStorage)
      },
      fail: function() {
        self.setItemValue("总存储空间", "获取失败")
      }
    })

    device.getAvailableStorage({
      success: function(data) {
        self.setItemValue("可用存储空间", formatStorage(data.availableStorage))
        self.setStorage("avail", data.availableStorage)
      },
      fail: function() {
        self.setItemValue("可用存储空间", "获取失败")
      }
    })
  },

  // 载重表：总量与余量都到手后点亮（两次异步回调谁后到都行）
  setStorage(key, bytes) {
    var old = this.storage
    var s = {
      totalBytes: key === "total" ? bytes : old.totalBytes,
      availBytes: key === "avail" ? bytes : old.availBytes,
      has: false, pct: 0, avail: "", total: ""
    }
    if (s.totalBytes > 0 && s.availBytes > 0) {
      s.has = true
      s.pct = Math.min(100, Math.round(s.availBytes / s.totalBytes * 100))
      s.avail = formatStorage(s.availBytes)
      s.total = formatStorage(s.totalBytes)
    }
    this.storage = s
  },

  // 按 grp 分组；值超 16 字符标记 long → 整行下沉换行禁省略
  buildGroups() {
    var titles = ["设备", "屏幕", "系统", "调试", "标识"]
    var groups = []
    for (var g = 0; g < titles.length; g++) {
      var items = []
      for (var i = 0; i < this.infoList.length; i++) {
        var it = this.infoList[i]
        if (it.grp === g && it.value !== "") {
          var v = String(it.value || "未知")
          if (v.length > 16) items.push({ label: it.label, value: v, long: true })
          else items.push({ label: it.label, value: v })
        }
      }
      if (items.length) groups.push({ title: titles[g], items: items })
    }
    this.groups = groups
  },

  setItemValue(label, value) {
    for (var i = 0; i < this.infoList.length; i++) {
      if (this.infoList[i].label === label) {
        this.infoList[i].value = value
        break
      }
    }
    this.buildGroups()
  },

  goBack() {
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("设备信息", "/pages/device-info")
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

/* 滚动容器：铭牌头版 + 全量参数超过一屏必须可滚 */
.di-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

/* 内层容器承载 padding：Vela 绝对定位按父级内容盒计算，根容器不放 padding */
.page-body {
  flex-direction: column;
  width: 100%;
  padding: 38px 8px 10px 8px;
}

.info-section {
  width: 100%;
  flex-direction: column;
}

/* ── 铭牌头版 ── */
.kicker {
  font-family: monospace;
  font-size: 19px;
  text-align: center;
  letter-spacing: 2px;
}

.unit {
  font-size: 30px;
  font-weight: 800;
  text-align: center;
  margin-top: 8px;
}

.unit-code {
  font-family: monospace;
  font-size: 18px;
  color: #FFB300;
  text-align: center;
  letter-spacing: 2px;
  margin-top: 4px;
}

.unit-sub {
  font-size: 20px;
  text-align: center;
  margin-top: 5px;
}

.hr {
  height: 1px;
  background-color: rgba(128, 128, 128, 0.25);
  margin: 14px 0 8px 0;
}

/* 点线检定行：label ···· value（等宽右对齐） */
.kv {
  flex-direction: row;
  align-items: flex-end;
  padding: 7px 0;
}

.lbl {
  font-size: 20px;
  flex-shrink: 0;
}

.lead {
  flex: 1;
  height: 1px;
  border-bottom-width: 1px;
  border-bottom-style: dotted;
  border-bottom-color: rgba(128, 128, 128, 0.4);
  margin: 0 6px 4px 6px;
}

.val {
  font-family: monospace;
  font-size: 21px;
  flex-shrink: 0;
}

/* 载重表（存储余量） */
.gauge {
  margin-top: 2px;
}

.bar {
  height: 7px;
  border-radius: 4px;
  background-color: rgba(128, 128, 128, 0.18);
  overflow: hidden;
  margin: 6px 0 4px 0;
}

.fill {
  height: 7px;
  border-radius: 4px;
}

.cap {
  flex-direction: row;
  justify-content: space-between;
  font-size: 18px;
  font-family: monospace;
}

/* ── 续页：全量参数 ── */
.spec-hint {
  font-family: monospace;
  font-size: 18px;
  text-align: center;
  margin: 16px 0 8px 0;
}

.grp {
  flex-direction: column;
  border-radius: 12px;
  padding: 8px 10px 4px 10px;
  margin-bottom: 8px;
}

.gt {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 2px;
}

/* 长值整行下沉：独占整行、换行禁省略 */
.longrow {
  flex-direction: column;
  padding: 6px 0;
}

.long-k {
  font-size: 19px;
}

.long-v {
  font-family: monospace;
  font-size: 18px;
  line-height: 26px;
  margin-top: 2px;
}

.pin-row {
  flex-direction: row;
  justify-content: center;
  padding: 12px 0 8px 0;
}

.pin-chip {
  width: 110px;
  height: 30px;
  border-radius: 9px;
  font-size: 20px;
  text-align: center;
  line-height: 30px;
}

.loading {
  flex-direction: column;
  border-radius: 10px;
  padding: 40px 16px;
  align-items: center;
}

.loading-icon {
  font-size: 28px;
  margin-bottom: 8px;
  line-height: 36px;
}

.loading-text {
  font-size: 24px;
  line-height: 32px;
  lines: 1;
}

.error-card {
  flex-direction: column;
  border-radius: 10px;
  padding: 16px 14px;
  margin-bottom: 6px;
  align-items: center;
}

.error-icon {
  font-size: 28px;
  margin-bottom: 6px;
  line-height: 36px;
}

.error-text {
  font-size: 24px;
  text-align: center;
  margin-bottom: 8px;
  line-height: 32px;
  lines: 1;
}

.retry-btn {
  width: 72px;
  height: 32px;
  border-radius: 16px;
  font-size: 22px;
  text-align: center;
  line-height: 30px;
}

/*
 * 胶囊屏（9 标准版 192×490，r96 标准跑道形）：
 *   安全区 y≥38 / 侧边 14px / 内容宽 164px
 *   点线检定行、载重表、铭牌头版字号按此调校
 */
@media screen and (shape: pill-shaped) {
  .page-body {
    padding: 30px 14px 16px 14px;
  }
  .kicker {
    font-size: 17px;
    letter-spacing: 3px;
  }
  .unit {
    font-size: 27px;
    line-height: 36px;
  }
  .unit-code {
    font-size: 16px;
    letter-spacing: 2px;
  }
  .unit-sub {
    font-size: 18px;
  }
  .lbl {
    font-size: 18px;
  }
  .val {
    font-size: 19px;
  }
  .gt {
    font-size: 19px;
  }
  .long-k {
    font-size: 17px;
  }
  .long-v {
    font-size: 16px;
    line-height: 24px;
  }
  .spec-hint {
    font-size: 16px;
  }
  .cap {
    font-size: 16px;
  }
  .pin-chip {
    height: 32px;
    font-size: 19px;
    line-height: 32px;
  }
  .retry-btn {
    height: 38px;
    font-size: 24px;
    line-height: 32px;
  }
}

@media screen and (shape: circle) {
  .page-body {
    padding: 38px 36px 44px 36px;
  }
  .loading-text {
    font-size: 26px;
    line-height: 34px;
  }
  .error-text {
    font-size: 26px;
    line-height: 34px;
  }
  .retry-btn {
    height: 36px;
    font-size: 24px;
    line-height: 32px;
  }
}

@media screen and (shape: rect) {
  .page-body {
    padding: 6px 10px 12px 10px;
  }
}
</style>
