<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 弹层显示时用 block 把整页内容摘掉，而不是叠一层 absolute 覆盖：
         absolute 版视觉正常但在模拟器上收不到点击（命中框不跟定位走），
         整屏替换没有定位与命中不一致的问题，真机同样稳。 -->
    <!-- 页头（2026-11-02 迁移）：与设置页同一套 .hdr 胶囊，「‹ 备份」整体可点返回。
         本地 .header / .back-btn-* / .header-title / .header-placeholder 五条已删，
         连同两处 width 媒体查询里的同名覆盖一并清掉，避免新旧两套类名互相打架。 -->
    <!-- 2026-11-02 底部结构：页头/标题固定，列表独立滚动，底栏（按钮 + 版本号）固定。
         高度用的是固定像素而不是 flex:1 —— 实测本机 Vela 里 scroll 只吃显式 px 高度，
         给 flex:1 会退化成「内容高」：不裁剪、不滚、直接压到底栏上。
         192×490：490 − 页头 44 − 标题 46 − 底栏 84 ≈ 316。 -->
    <!-- 2026-11-02 修「弹窗被压缩」：.list-scroll / .sheet-screen / .upgrade-screen 都是 .page
         的直接子元素且都写了 flex:1 —— 同级平分剩余高度，弹层只拿到「列表那一半」，
         于是卡片落在列表区域的正中（也就是底栏上方），而不是屏幕正中。
         这里在弹层打开时把四段常规内容整体摘出渲染树（if 为假时确实不参与 flex 分配），
         弹层独子 flex:1 才是整页高，justify-content:center 才等于屏幕居中。
         注意：不加外层 wrapper —— 多套一层 div 会让内部 scroll 再次丢掉高度约束。 -->
    <!-- 2026-11-02 二次改版：底部固定栏废弃，动作按钮上移到页头下方。
         原因是实测两条硬证据（不是审美偏好）：
         ① 点 (96,448) 的「添加新备份」连续两次完全没有反应，而同一帧点顶部返回胶囊
            立即生效 —— 胶囊屏底部那片是边界/手势死区，点击到不了页面；
         ② 底部圆弧把按钮和版本号压在该区域里，字被弧线盖掉一部分。
         放顶部一次解决两件事：满宽 160 的按钮在 y≈52 的弧内宽度内，且顶部已验证可点。 -->
    <div class="hdr" if="{{ !showSheet && !showUpgrade }}">
      <div class="hdr-pill" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="hdr-pill-ic" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        <text class="hdr-pill-t" style="color: {{ theme.text }}">备份</text>
      </div>
    </div>

    <div class="act-row" if="{{ !showSheet && !showUpgrade }}">
      <div class="btn-add" onclick="createBackup" style="background-color: {{ theme.accent }}">
        <text class="btn-add-text" style="color: {{ theme.text }}">添加新备份</text>
      </div>
    </div>

    <div class="list-head" if="{{ !showSheet && !showUpgrade }}">
      <text class="section-title" style="color: {{ theme.textSecondary }}">已有备份</text>
      <text class="ver-text" style="color: {{ theme.textMuted }}">v{{ versionText }}</text>
    </div>

    <scroll class="list-scroll" if="{{ !showSheet && !showUpgrade }}" scroll-y="{{true}}">
    <div class="empty-msg" if="{{ backupList.length === 0 }}">
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无备份</text>
    </div>

    <div class="backup-row" for="$item in backupList" style="background-color: {{ theme.card }}">
      <div class="backup-body">
        <text class="backup-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <text class="backup-meta" style="color: {{ theme.textSecondary }}">{{ $item.courseCount }}门课程 · {{ $item.scheduleCount }}张课表</text>
      </div>
      <div class="backup-actions">
        <div class="action-btn action-restore" onclick="confirmRestoreBackup($idx)" style="background-color: {{ theme.accent }}">
          <text class="action-text" style="color: {{ theme.text }}">恢复</text>
        </div>
        <div class="action-btn action-delete" onclick="confirmDeleteBackup($idx)" style="background-color: transparent">
          <text class="action-text" style="color: {{ theme.deleteText }}">删除</text>
        </div>
      </div>
    </div>
    </scroll>

    <!-- 确认/进度/结果统一弹层（2026-11-02 重构）。
         为什么不再用 absolute 覆盖层：那个版本的 `height: 100%` 在长页面里等于整页内容高，
         `justify-content: center` 就把卡片居中到「内容中点」而不是「屏幕中点」——
         备份一多，弹窗直接被推到可视区之外，用户在任意位置点「恢复」都看不到。
         这里改用与解锁引导同构的「整屏替换 + flex:1 居中」：页面内容被 block 摘掉，
         弹层独占 .page 高度，无论列表多长、用户滚到哪儿，卡片恒在屏幕正中。 -->
    <div class="sheet-screen" if="{{ showSheet }}">
      <div class="sheet-card" style="background-color: {{ theme.card }}">
        <text class="sheet-title" style="color: {{ sheetOk ? theme.accent : theme.deleteText }}">{{ sheetTitle }}</text>
        <text class="sheet-desc" if="{{ sheetDesc }}" style="color: {{ theme.textSecondary }}">{{ sheetDesc }}</text>
        <div class="pg-track" if="{{ showProgress }}" style="background-color: {{ theme.cardLight }}">
          <div class="pg-fill" style="width: {{ progressPct }}%; background-color: {{ sheetOk ? theme.accent : theme.deleteText }}"></div>
        </div>
        <text class="sheet-sub" if="{{ statusSub }}" style="color: {{ theme.textSecondary }}">{{ statusSub }}</text>
        <div class="sheet-actions" if="{{ sheetCancelText || sheetBtnText }}">
          <div class="sheet-btn sheet-btn-cancel" if="{{ sheetCancelText }}" onclick="dismissSheet" style="background-color: {{ theme.cardLight }}">
            <text class="sheet-btn-text" style="color: {{ theme.text }}">{{ sheetCancelText }}</text>
          </div>
          <div class="sheet-btn sheet-btn-primary" if="{{ sheetBtnText }}" onclick="sheetAction" style="background-color: {{ sheetOk ? theme.accent : theme.deleteText }}">
            <text class="sheet-btn-text" style="color: {{ theme.text }}">{{ sheetBtnText }}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 升级引导（2026-11-02 改为本页自绘）：原先套 unlock-dialog 组件 + store 单例，
         实测点击后 store.showUnlockDialog 返回 true（ref 非空）却看不到任何弹窗 ——
         单例里存的未必是本页实例，可能是页面栈下方某一页注册的，show() 生效在看不到的层。
         这里复用本页 overlay-modal 的自绘弹层，同步改 showUpgrade 即可，零异步、零共享状态。 -->
    <div class="upgrade-screen" if="{{ showUpgrade }}" onclick="closeUpgrade">
      <div class="upgrade-card" onclick="stopBubble" style="background-color: {{ theme.card }}">
        <text class="upgrade-title" style="color: {{ theme.accent }}">解锁备份</text>
        <text class="upgrade-desc" style="color: {{ theme.textSecondary }}">备份与恢复是高级版功能</text>
        <div class="upgrade-benefits">
          <text class="upgrade-benefit" for="{{ upgradeBenefits }}" style="color: {{ theme.text }}">✓ {{ $item }}</text>
        </div>
        <!-- 按钮基础态为纵向堆叠：192 宽屏内两个 5 字按钮横排需 250px，物理放不下 -->
        <div class="upgrade-actions">
          <div class="upgrade-btn upgrade-btn-cancel" onclick="closeUpgrade" style="background-color: {{ theme.cardLight }}">
            <text class="upgrade-btn-text" style="color: {{ theme.text }}">继续标准版</text>
          </div>
          <div class="upgrade-btn upgrade-btn-primary" onclick="goActivate" style="background-color: {{ theme.accent }}">
            <text class="upgrade-btn-text" style="color: {{ theme.text }}">立即解锁</text>
          </div>
        </div>
      </div>
    </div>

  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const version = require("../../data/version.js")
var BACKUP_LIST_KEY = "backup_list"
var MAX_BACKUPS = 20

var DATA_KEYS = [
  "allCourses_0", "allCourses_1", "allCourses_2", "allCourses_3", "allCourses_4",
  "allCourses_5", "allCourses_6", "allCourses_7", "allCourses_8", "allCourses_9",
  "scheduleNames", "currentScheduleIndex",
  "remindSettings", "homepage_settings",
  "appTheme", "baseFontSize", "premium_unlocked",
  "course_preset_list"
]

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    backupList: [],
    // 统一弹层（确认/进度/结果），整屏替换式，恒在屏幕中央
    versionText: "",
    showSheet: false,
    sheetTitle: "",
    sheetDesc: "",
    sheetOk: true,
    sheetCancelText: "",
    sheetBtnText: "",
    dialogType: '',
    deleteIndex: -1,
    deleteName: '',
    restoreIndex: -1,
    restoreName: '',
    // 弹层内容（备份/恢复/删除共用）
    statusSub: "",
    progressPct: 0,
    showProgress: false,
    // 运行中标志：备份/恢复期间锁住所有按钮，防止重复点导致并发写同一个 key
    busy: false,
    isPremium: false,
    premiumChecked: false,
    showUpgrade: false,
    upgradeBenefits: ["多份备份", "一键恢复", "防丢失", "永久使用"],
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.versionText = version.versionName
    this.loadBackupList()
    this.refreshPremium()
  },

  // 2026-11-02：会员状态改为「进页预取 + 点击时同步判定」。
  // 原先是在点击回调里才去问 isPremiumUnlocked，一旦它的两层异步回调没回来，
  // 这次点击就等于石沉大海（真机反馈「点了没有任何提示」）。预取后点击路径零异步依赖。
  refreshPremium() {
    var self = this
    store.isPremiumUnlocked(function(u) {
      self.isPremium = !!u
      self.premiumChecked = true
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadBackupList()
    this.refreshPremium()
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light") ? "dark" : "dark"
  },

  onBackPress() {
    // 返回优先级：解锁引导弹层 > 删除/恢复确认框 > 页面本身。
    // 弹层开着时真机「左边缘右滑」会走这里；若不拦，系统默认返回会把整页弹掉，
    // 用户只是想把弹层收起来，结果直接退出备份页。
    // 只在确实关掉了弹层时 return true；其余一律 return false 交还系统默认返回
    // （上一页 / 栈底退出），避免无条件吃返回键导致「退不出去」（见 index/welcome 教训）。
    if (this.showUpgrade) {
      this.showUpgrade = false
      return true
    }
    if (this.showSheet) {
      // 进行中（busy）不允许用返回键中断，避免写一半退出导致数据不一致
      if (!this.busy) this.dismissSheet()
      return true
    }
    return false
  },

  goBack() {
    router.back()
  },

  loadBackupList() {
    var self = this
    storage.get({
      key: BACKUP_LIST_KEY,
      success: function(data) {
        try {
          var list = JSON.parse(data)
          if (Array.isArray(list)) {
            self.backupList = list
          } else {
            self.backupList = []
          }
        } catch (e) {
          self.backupList = []
        }
      },
      fail: function() {
        self.backupList = []
      }
    })
  },

  saveBackupList(list) {
    var self = this
    storage.set({
      key: BACKUP_LIST_KEY,
      value: JSON.stringify(list),
      success: function() {
        self.backupList = list
      },
      fail: function() {
        self.backupList = list
      }
    })
  },


  createBackup() {
    var self = this
    if (this.busy) return
    if (this.premiumChecked && !this.isPremium) {
      self.showUpgradeDialog()
      return
    }
    if (!this.premiumChecked) {
      // 进页预取还没回来就点了：按标准版处理先弹引导，同时补一次取数
      self.showUpgradeDialog()
      self.refreshPremium()
      return
    }
    self.doCreateBackup()
  },

  showUpgradeDialog() {
    // 同步打开本页自绘弹层：不查 store 单例、不等组件注册、不依赖 setTimeout。
    this.showUpgrade = true
  },

  closeUpgrade() {
    this.showUpgrade = false
  },

  goActivate() {
    this.showUpgrade = false
    router.push({ uri: "/pages/activation" })
  },

  doCreateBackup() {
    var self = this
    var backupData = {}
    var total = DATA_KEYS.length

    // 备份阶段也给反馈：读 18 个 key 在真机上约 200-400ms，原先这段时间页面无变化，
    // 用户会以为按钮没生效而重复点。
    self.busy = true
    self.openSheet({
      title: "正在备份…",
      ok: true,
      progress: true,
      sub: "0/" + total + " 项 · 0%",
      cancelText: "",
      btnText: ""
    })

    function loadKey(index) {
      if (index >= total) {
        saveBackup(backupData)
        return
      }
      self.progressPct = Math.round(index / total * 100)
      self.statusSub = index + "/" + total + " 项 · " + self.progressPct + "%"
      var key = DATA_KEYS[index]
      storage.get({
        key: key,
        success: function(data) {
          if (data) {
            backupData[key] = data
          }
          loadKey(index + 1)
        },
        fail: function() {
          loadKey(index + 1)
        }
      })
    }

    function saveBackup(data) {
      var now = new Date()
      var timeStr = now.getFullYear() + "-" +
        (now.getMonth() + 1 < 10 ? "0" : "") + (now.getMonth() + 1) + "-" +
        (now.getDate() < 10 ? "0" : "") + now.getDate() + " " +
        (now.getHours() < 10 ? "0" : "") + now.getHours() + ":" +
        (now.getMinutes() < 10 ? "0" : "") + now.getMinutes()

      var courseCount = 0
      var scheduleCount = 0

      try {
        var namesRaw = data["scheduleNames"]
        if (namesRaw) {
          var names = JSON.parse(namesRaw)
          if (Array.isArray(names)) {
            scheduleCount = names.length
          }
        }
      } catch (e) {}

      for (var i = 0; i < 10; i++) {
        var raw = data["allCourses_" + i]
        if (raw) {
          try {
            var schedule = JSON.parse(raw)
            if (Array.isArray(schedule)) {
              for (var d = 0; d < schedule.length; d++) {
                var classes = schedule[d].classes
                if (classes && Array.isArray(classes)) {
                  courseCount += classes.length
                }
              }
            }
          } catch (e) {}
        }
      }

      var backupEntry = {
        id: now.getTime(),
        name: "备份 " + timeStr,
        time: timeStr,
        courseCount: courseCount,
        scheduleCount: scheduleCount,
        data: data
      }

      var list = self.backupList.slice()
      list.unshift(backupEntry)

      if (list.length > MAX_BACKUPS) {
        list = list.slice(0, MAX_BACKUPS)
      }

      self.saveBackupList(list)
      self.busy = false
      self.openSheet({
        title: "备份成功",
        ok: true,
        progress: true,
        pct: 100,
        sub: timeStr + " · " + courseCount + " 门课程 / " + scheduleCount + " 张课表",
        cancelText: "",
        btnText: "完成"
      })
    }

    loadKey(0)
  },

  restoreBackup() {
    var self = this
    var index = self.restoreIndex
    var backup = self.backupList[index]
    if (!backup || !backup.data) {
      self.restoreIndex = -1
      self.dialogType = ''
      self.failStatus("备份数据无效")
      return
    }

    var backupData = backup.data
    var keys = Object.keys(backupData)
    var total = keys.length

    if (total === 0) {
      self.restoreIndex = -1
      self.dialogType = ''
      self.failStatus("备份数据为空")
      return
    }

    // 恢复阶段状态：把确认框收掉、进度条立刻显示 0%，让用户在点下「恢复」的
    // 同一帧就看到变化。写入是逐 key 串行的，进度按写完项数推进。
    self.restoreIndex = -1
    self.dialogType = ''
    self.busy = true
    self.openSheet({
      title: "正在恢复…",
      ok: true,
      progress: true,
      sub: "0/" + total + " 项 · 0%",
      cancelText: "",
      btnText: ""
    })

    var failed = 0

    function saveKey(i) {
      if (i >= total) {
        self.busy = false
        if (failed > 0) {
          self.openSheet({
            title: "恢复完成，但 " + failed + " 项写入失败",
            ok: false,
            progress: true,
            pct: 100,
            sub: "成功 " + (total - failed) + "/" + total + " 项，建议再恢复一次",
            cancelText: "",
            btnText: "完成"
          })
        } else {
          self.openSheet({
            title: "恢复成功",
            ok: true,
            progress: true,
            pct: 100,
            sub: "已写入 " + total + " 项 · " + (backup.time || ""),
            cancelText: "",
            btnText: "完成"
          })
        }
        if (database.resetCache) database.resetCache()
        database.init(function() {
          store.getTheme(function() {}, true)
        })
        return
      }
      var key = keys[i]
      storage.set({
        key: key,
        value: backupData[key],
        success: function() {
          self.progressPct = Math.round((i + 1) / total * 100)
          self.statusSub = (i + 1) + "/" + total + " 项 · " + self.progressPct + "%"
          saveKey(i + 1)
        },
        fail: function() {
          failed++
          self.progressPct = Math.round((i + 1) / total * 100)
          self.statusSub = (i + 1) + "/" + total + " 项 · " + self.progressPct + "%"
          saveKey(i + 1)
        }
      })
    }

    saveKey(0)
  },

  // 前置校验失败时的统一收口：卡片红字 + 关掉进度条，避免只闪一行小字
  failStatus(msg) {
    this.busy = false
    this.openSheet({
      title: msg,
      ok: false,
      progress: false,
      sub: "",
      cancelText: "",
      btnText: "完成"
    })
  },

  // 打开统一弹层（居中）。所有字段一次给全，避免残留上一态的文字。
  openSheet(o) {
    this.sheetTitle = o.title || ""
    this.sheetDesc = o.desc || ""
    this.sheetOk = o.ok !== false
    this.sheetCancelText = o.cancelText || ""
    this.sheetBtnText = o.btnText || ""
    this.showProgress = !!o.progress
    this.progressPct = (o.pct === undefined ? 0 : o.pct)
    this.statusSub = o.sub || ""
    this.showSheet = true
  },

  dismissSheet() {
    if (this.busy) return
    this.showSheet = false
    this.dialogType = ''
  },

  confirmDeleteBackup(index) {
    if (this.busy) return
    var item = this.backupList[index]
    this.deleteIndex = index
    this.deleteName = item ? item.name : ''
    this.dialogType = 'delete'
    this.openSheet({
      title: "确认删除",
      desc: (item ? item.name : '') + " ？删除后不可恢复",
      ok: false,
      progress: false,
      sub: "",
      cancelText: "取消",
      btnText: "删除"
    })
  },

  confirmRestoreBackup(index) {
    if (this.busy) return
    var item = this.backupList[index]
    this.restoreIndex = index
    this.restoreName = item ? item.name : ''
    this.dialogType = 'restore'
    this.openSheet({
      title: "确认恢复",
      desc: (item ? item.name : '') + " ？当前课表将被覆盖",
      ok: true,
      progress: false,
      sub: "",
      cancelText: "取消",
      btnText: "恢复"
    })
  },

  deleteBackup() {
    var self = this
    var index = self.deleteIndex
    if (index < 0 || index >= self.backupList.length) {
      self.dismissSheet()
      return
    }
    var list = self.backupList.slice()
    list.splice(index, 1)
    self.saveBackupList(list)
    self.deleteIndex = -1
    self.dialogType = ''
    self.openSheet({
      title: "备份已删除",
      ok: true,
      progress: false,
      sub: "",
      cancelText: "",
      btnText: "完成"
    })
  },

  // 弹层主按钮：确认键 / 完成键共用同一个入口，按 dialogType 分派
  sheetAction() {
    if (this.busy) return
    if (this.dialogType === 'delete') {
      this.deleteBackup()
      return
    }
    if (this.dialogType === 'restore') {
      this.restoreBackup()
      return
    }
    this.dismissSheet()
  },

  stopBubble() {
  }
}
</script>

<style>
/* 统一返回按钮（2026-11-02）：.hdr / .hdr-pill / .hdr-pill-ic / .hdr-pill-t 全部来自
   公共 header.css，本页不再各写一套。注意本文件必须在页面本地规则「之前」引入：
   同特异性下后加载者赢，公共文件先来，本地才压得住。 */
@import '../../common/header.css';

/* 2026-11-02：原来只有 height:100%。Vela 里这种写法给不出确定的尺寸约束，
   里面的 scroll 拿不到「剩余高度」，于是不裁剪也不滚（列表直接压到底栏上）。
   设置页一直是四边定位，scroll:flex:1 在那儿是好的 —— 照抄过来。 */
.page {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
  box-sizing: border-box;
}

/* 原 .header / .back-btn-wrapper / .back-btn-icon / .header-title / .header-placeholder
   五条已于 2026-11-02 删除（迁移到 .hdr 胶囊），连同下方两处 width 媒体查询里的同名
   覆盖一并清空 —— 留着只会在下一次改样式时误以为还在生效。 */

.section-title {
  font-size: 24px;
  margin: 0;
}

/* 统一弹层（2026-11-02 重构）：确认 / 进度 / 结果三态共用。
   结构与解锁引导同构 —— 整屏替换（页面内容被 block 摘掉）+ flex:1 吃满 .page 高 +
   justify-content: center，因此卡片恒在屏幕正中，与列表多长、当前滚到哪儿无关。
   这是刻意的：absolute 覆盖层在长页面里 height:100% 等于「内容高」，
   居中落到内容中点（屏幕外），真机实测点下方条目的「恢复」完全看不到弹窗。
   进度条用两层 div 自绘，不用 progress 组件（Vela 不支持 progress.color）。 */
.sheet-screen {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 12px;
}

.sheet-card {
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 14px 12px;
  border-radius: 16px;
}

.sheet-title {
  font-size: 26px;
  font-weight: bold;
  text-align: center;
  lines: 2;
}

.sheet-desc {
  font-size: 22px;
  line-height: 28px;
  margin-top: 6px;
  text-align: center;
  lines: 3;
}

.sheet-sub {
  font-size: 22px;
  line-height: 28px;
  margin-top: 6px;
  text-align: center;
  lines: 2;
}

.sheet-actions {
  flex-direction: column;
  align-items: stretch;
