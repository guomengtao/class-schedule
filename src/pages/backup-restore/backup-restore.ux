<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">数据备份与恢复</text>
      <input class="create-btn" type="button" value="+ 新建" onclick="doBackup"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <text class="result-text" if="{{ resultMessage }}" style="color: {{ resultSuccess ? theme.accent : theme.deleteText }}">{{ resultMessage }}</text>

    <div class="progress-bar" if="{{ restoreProgress >= 0 }}" style="background-color: {{ theme.cardLight }}">
      <text class="progress-text" style="color: {{ theme.accent }}">恢复进度: {{ restoreProgress }}/{{ restoreTotal }}</text>
      <div class="progress-track" style="background-color: {{ theme.border || theme.borderLight }}">
        <div class="progress-fill" style="width: {{ restoreProgress / restoreTotal * 100 }}%; background-color: {{ theme.accent }}"></div>
      </div>
    </div>

    <text class="empty-msg" if="{{ backupList.length === 0 }}" style="color: {{ theme.textMuted }}">暂无备份，点击右上角"+ 新建"创建备份</text>

    <div class="backup-row" for="$item in backupList" style="background-color: {{ theme.card }}">
      <div class="backup-row-left">
        <text class="backup-row-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <text class="backup-row-meta" style="color: {{ theme.textSecondary }}">{{ $item.time }} · {{ $item.courseCount }}门课 · {{ $item.scheduleCount }}个课表</text>
      </div>
      <div class="backup-row-actions">
        <input class="row-restore-btn" type="button" value="恢复" onclick="restoreBackup($idx)"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="row-delete-btn" type="button" value="{{ deleteConfirmIndex === $idx ? '确认' : '删除' }}"
               onclick="handleDeleteBackup($idx)"
               style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : 'transparent' }}; color: {{ deleteConfirmIndex === $idx ? '#ffffff' : theme.deleteText }}; border-color: {{ theme.deleteText }}" />
      </div>
    </div>

    <div class="info-section" style="background-color: {{ theme.card }}">
      <text class="info-title" style="color: {{ theme.text }}">备份包含</text>
      <text class="info-text" style="color: {{ theme.textSecondary }}">课程数据 · 课表列表 · 首页设置 · 主题 · 提醒 · 解锁状态</text>
    </div>

    <unlock-dialog id="unlockDialog"></unlock-dialog>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")

var BACKUP_LIST_KEY = "backup_list"
var MAX_BACKUPS = 20

var DATA_KEYS = [
  "allCourses_0", "allCourses_1", "allCourses_2", "allCourses_3", "allCourses_4",
  "allCourses_5", "allCourses_6", "allCourses_7", "allCourses_8", "allCourses_9",
  "scheduleNames", "currentScheduleIndex",
  "remindSettings", "homepage_settings",
  "theme", "fontScale", "premium_unlocked",
  "course_preset_list"
]

export default {
  private: {
    theme: store.DEFAULT_THEME,
    backupList: [],
    resultMessage: "",
    resultSuccess: false,
    deleteConfirmIndex: -1,
    restoreProgress: -1,
    restoreTotal: 0
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadBackupList()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadBackupList()
  },

  loadBackupList() {
    var self = this
    storage.get({
      key: BACKUP_LIST_KEY,
      success: function(data) {
        try {
          var list = JSON.parse(data)
          if (Array.isArray(list)) {
            self.backupList = list
          } else {
            self.backupList = []
          }
        } catch (e) {
          self.backupList = []
        }
      },
      fail: function() {
        self.backupList = []
      }
    })
  },

  saveBackupList(list) {
    var self = this
    storage.set({
      key: BACKUP_LIST_KEY,
      value: JSON.stringify(list),
      success: function() {
        self.backupList = list
      },
      fail: function() {
        self.backupList = list
      }
    })
  },

  goBack() {
    router.back()
  },

  doBackup() {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        self.performBackup()
      } else {
        store.showUnlockDialog({
          title: "解锁数据备份",
          benefits: ["多课表管理", "数据备份与恢复", "首页自定义", "10套主题"],
          cancelText: "继续使用标准版"
        })
      }
    })
  },

  performBackup() {
    var self = this
    var backupData = {}
    var total = DATA_KEYS.length

    function loadKey(index) {
      if (index >= total) {
        saveBackup(backupData)
        return
      }
      var key = DATA_KEYS[index]
      storage.get({
        key: key,
        success: function(data) {
          if (data) {
            backupData[key] = data
          }
          loadKey(index + 1)
        },
        fail: function() {
          loadKey(index + 1)
        }
      })
    }

    function saveBackup(data) {
      var now = new Date()
      var timeStr = now.getFullYear() + "-" +
        (now.getMonth() + 1 < 10 ? "0" : "") + (now.getMonth() + 1) + "-" +
        (now.getDate() < 10 ? "0" : "") + now.getDate() + " " +
        (now.getHours() < 10 ? "0" : "") + now.getHours() + ":" +
        (now.getMinutes() < 10 ? "0" : "") + now.getMinutes()

      var courseCount = 0
      var scheduleCount = 0

      try {
        var namesRaw = data["scheduleNames"]
        if (namesRaw) {
          var names = JSON.parse(namesRaw)
          if (Array.isArray(names)) {
            scheduleCount = names.length
          }
        }
      } catch (e) {}

      for (var i = 0; i < 10; i++) {
        var raw = data["allCourses_" + i]
        if (raw) {
          try {
            var schedule = JSON.parse(raw)
            if (Array.isArray(schedule)) {
              for (var d = 0; d < schedule.length; d++) {
                var classes = schedule[d].classes
                if (classes && Array.isArray(classes)) {
                  courseCount += classes.length
                }
              }
            }
          } catch (e) {}
        }
      }

      var backupEntry = {
        id: now.getTime(),
        name: "备份 " + timeStr,
        time: timeStr,
        courseCount: courseCount,
        scheduleCount: scheduleCount,
        data: data
      }

      var list = self.backupList.slice()
      list.unshift(backupEntry)

      if (list.length > MAX_BACKUPS) {
        list = list.slice(0, MAX_BACKUPS)
      }

      self.saveBackupList(list)
      self.resultMessage = "备份成功！(" + timeStr + ")"
      self.resultSuccess = true
    }

    loadKey(0)
  },

  restoreBackup(index) {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        self.performRestore(index)
      } else {
        store.showUnlockDialog({
          title: "解锁数据恢复",
          benefits: ["多课表管理", "数据备份与恢复", "首页自定义", "10套主题"],
          cancelText: "继续使用标准版"
        })
      }
    })
  },

  performRestore(index) {
    var self = this
    var backup = self.backupList[index]
    if (!backup || !backup.data) {
      self.resultMessage = "备份数据无效"
      self.resultSuccess = false
      return
    }

    var backupData = backup.data
    var keys = Object.keys(backupData)
    var total = keys.length

    if (total === 0) {
      self.resultMessage = "备份数据为空"
      self.resultSuccess = false
      return
    }

    self.restoreProgress = 0
    self.restoreTotal = total

    function saveKey(i) {
      if (i >= total) {
        self.restoreProgress = -1
        self.resultMessage = "恢复成功！已恢复 " + total + " 项数据"
        self.resultSuccess = true
        return
      }
      var key = keys[i]
      storage.set({
        key: key,
        value: backupData[key],
        success: function() {
          self.restoreProgress = i + 1
          saveKey(i + 1)
        },
        fail: function() {
          self.restoreProgress = i + 1
          saveKey(i + 1)
        }
      })
    }

    saveKey(0)
  },

  handleDeleteBackup(index) {
    var self = this
    if (self.deleteConfirmIndex === index) {
      var list = self.backupList.slice()
      list.splice(index, 1)
      self.saveBackupList(list)
      self.deleteConfirmIndex = -1
      self.resultMessage = "备份已删除"
      self.resultSuccess = true
    } else {
      self.deleteConfirmIndex = index
    }
  }
}
</script>

<style>
.page {
  flex: 1;
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn {
  width: 64px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
}

.create-btn {
  width: 64px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
}

.result-text {
  font-size: 13px;
  text-align: center;
  margin-bottom: 6px;
  font-weight: bold;
}

.progress-bar {
  flex-direction: column;
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 8px;
}

.progress-text {
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 6px;
  text-align: center;
}

.progress-track {
  height: 6px;
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 3px;
}

.empty-msg {
  font-size: 14px;
  text-align: center;
  padding: 20px 0;
}

.backup-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 6px;
}

.backup-row-left {
  flex-direction: column;
  flex: 1;
}

.backup-row-name {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 3px;
}

.backup-row-meta {
  font-size: 12px;
}

.backup-row-actions {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 8px;
}

.row-restore-btn {
  width: 50px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
  margin-right: 6px;
}

.row-delete-btn {
  width: 50px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
  border-width: 1px;
}

.info-section {
  border-radius: 12px;
  padding: 14px;
  margin-top: 6px;
}

.info-title {
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 6px;
}

.info-text {
  font-size: 12px;
  line-height: 20px;
}

@media (shape: circle) {
  .page {
    padding: 44px 24px 24px 24px;
  }
  .back-btn {
    width: 52px;
    height: 28px;
    font-size: 12px;
  }
  .title {
    font-size: 14px;
  }
  .create-btn {
    width: 52px;
    height: 28px;
    font-size: 12px;
  }
}
</style>