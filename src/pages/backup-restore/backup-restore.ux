<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <div class="header-title-wrapper">
        <text class="header-title" style="color: {{ theme.text }}">数据备份</text>
      </div>
    </div>

    <text class="section-title" style="color: {{ theme.textSecondary }}">已有备份</text>

    <div class="empty-msg" if="{{ backupList.length === 0 }}">
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无备份</text>
    </div>

    <div class="backup-row" for="$item in backupList" style="background-color: {{ theme.card }}">
      <div class="backup-body">
        <text class="backup-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <text class="backup-meta" style="color: {{ theme.textSecondary }}">{{ $item.courseCount }}门课程 · {{ $item.scheduleCount }}张课表</text>
      </div>
      <div class="backup-actions">
        <div class="action-btn action-restore" onclick="confirmRestoreBackup($idx)" style="background-color: {{ theme.accent }}">
          <text class="action-text" style="color: {{ theme.text }}">恢复</text>
        </div>
        <div class="action-btn action-delete" onclick="confirmDeleteBackup($idx)" style="background-color: transparent">
          <text class="action-text" style="color: {{ theme.deleteText }}">删除</text>
        </div>
      </div>
    </div>

    <div class="add-bottom">
      <div class="btn-add" onclick="createBackup" style="background-color: {{ theme.accent }}">
        <text class="btn-add-text" style="color: {{ theme.text }}">添加新备份</text>
      </div>
    </div>

    <text class="result-msg" if="{{ resultMessage }}" style="color: {{ resultSuccess ? theme.accent : theme.deleteText }}">{{ resultMessage }}</text>

    <div class="overlay-modal" if="{{ showDialog }}" onclick="dismissDialog"
         style="position: absolute; left: 0; top: 0; width: 100%; height: 100%">
      <div class="dialog-box" onclick="stopBubble" style="background-color: {{ theme.card }}">
        <text class="dialog-title" style="color: {{ theme.text }}">{{ dialogType === 'delete' ? '确认删除' : '确认恢复' }}</text>
        <text class="dialog-desc" style="color: {{ theme.textSecondary }}">{{ dialogType === 'delete' ? '删除 ' + deleteName + ' ？' : '恢复 ' + restoreName + ' ？' }}</text>
        <div class="dialog-buttons">
          <div class="dialog-btn dialog-btn-cancel" onclick="dismissDialog" style="background-color: {{ theme.cardLight }}">
            <text class="dialog-btn-text" style="color: {{ theme.text }}">取消</text>
          </div>
          <div class="dialog-btn dialog-btn-delete" onclick="dialogAction" style="background-color: {{ dialogType === 'delete' ? theme.deleteText : theme.accent }}">
            <text class="dialog-btn-text" style="color: {{ theme.text }}">{{ dialogType === 'delete' ? '删除' : '恢复' }}</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var BACKUP_LIST_KEY = "backup_list"
var MAX_BACKUPS = 20

var DATA_KEYS = [
  "allCourses_0", "allCourses_1", "allCourses_2", "allCourses_3", "allCourses_4",
  "allCourses_5", "allCourses_6", "allCourses_7", "allCourses_8", "allCourses_9",
  "scheduleNames", "currentScheduleIndex",
  "remindSettings", "homepage_settings",
  "appTheme", "baseFontSize", "premium_unlocked",
  "course_preset_list"
]

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    backupList: [],
    showDialog: false,
    dialogType: '',
    deleteIndex: -1,
    deleteName: '',
    restoreIndex: -1,
    restoreName: '',
    resultMessage: "",
    resultSuccess: false,
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadBackupList()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadBackupList()
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light") ? "dark" : "dark"
  },

  goBack() {
    router.back()
  },

  loadBackupList() {
    var self = this
    storage.get({
      key: BACKUP_LIST_KEY,
      success: function(data) {
        try {
          var list = JSON.parse(data)
          if (Array.isArray(list)) {
            self.backupList = list
          } else {
            self.backupList = []
          }
        } catch (e) {
          self.backupList = []
        }
      },
      fail: function() {
        self.backupList = []
      }
    })
  },

  saveBackupList(list) {
    var self = this
    storage.set({
      key: BACKUP_LIST_KEY,
      value: JSON.stringify(list),
      success: function() {
        self.backupList = list
      },
      fail: function() {
        self.backupList = list
      }
    })
  },

  createBackup() {
    var self = this
    var backupData = {}
    var total = DATA_KEYS.length

    function loadKey(index) {
      if (index >= total) {
        saveBackup(backupData)
        return
      }
      var key = DATA_KEYS[index]
      storage.get({
        key: key,
        success: function(data) {
          if (data) {
            backupData[key] = data
          }
          loadKey(index + 1)
        },
        fail: function() {
          loadKey(index + 1)
        }
      })
    }

    function saveBackup(data) {
      var now = new Date()
      var timeStr = now.getFullYear() + "-" +
        (now.getMonth() + 1 < 10 ? "0" : "") + (now.getMonth() + 1) + "-" +
        (now.getDate() < 10 ? "0" : "") + now.getDate() + " " +
        (now.getHours() < 10 ? "0" : "") + now.getHours() + ":" +
        (now.getMinutes() < 10 ? "0" : "") + now.getMinutes()

      var courseCount = 0
      var scheduleCount = 0

      try {
        var namesRaw = data["scheduleNames"]
        if (namesRaw) {
          var names = JSON.parse(namesRaw)
          if (Array.isArray(names)) {
            scheduleCount = names.length
          }
        }
      } catch (e) {}

      for (var i = 0; i < 10; i++) {
        var raw = data["allCourses_" + i]
        if (raw) {
          try {
            var schedule = JSON.parse(raw)
            if (Array.isArray(schedule)) {
              for (var d = 0; d < schedule.length; d++) {
                var classes = schedule[d].classes
                if (classes && Array.isArray(classes)) {
                  courseCount += classes.length
                }
              }
            }
          } catch (e) {}
        }
      }

      var backupEntry = {
        id: now.getTime(),
        name: "备份 " + timeStr,
        time: timeStr,
        courseCount: courseCount,
        scheduleCount: scheduleCount,
        data: data
      }

      var list = self.backupList.slice()
      list.unshift(backupEntry)

      if (list.length > MAX_BACKUPS) {
        list = list.slice(0, MAX_BACKUPS)
      }

      self.saveBackupList(list)
      self.resultMessage = "备份成功 (" + timeStr + ")"
      self.resultSuccess = true
    }

    loadKey(0)
  },

  restoreBackup() {
    var self = this
    var index = self.restoreIndex
    var backup = self.backupList[index]
    if (!backup || !backup.data) {
      self.resultMessage = "备份数据无效"
      self.resultSuccess = false
      return
    }

    var backupData = backup.data
    var keys = Object.keys(backupData)
    var total = keys.length

    if (total === 0) {
      self.resultMessage = "备份数据为空"
      self.resultSuccess = false
      return
    }

    function saveKey(i) {
      if (i >= total) {
        self.restoreIndex = -1
        self.showDialog = false
        self.resultMessage = "已恢复 " + total + " 项"
        self.resultSuccess = true
        if (database.resetCache) database.resetCache()
        database.init(function() {
          store.getTheme(function() {}, true)
        })
        return
      }
      var key = keys[i]
      storage.set({
        key: key,
        value: backupData[key],
        success: function() {
          saveKey(i + 1)
        },
        fail: function() {
          saveKey(i + 1)
        }
      })
    }

    saveKey(0)
  },

  confirmDeleteBackup(index) {
    var item = this.backupList[index]
    this.deleteIndex = index
    this.deleteName = item ? item.name : ''
    this.dialogType = 'delete'
    this.showDialog = true
  },

  confirmRestoreBackup(index) {
    var item = this.backupList[index]
    this.restoreIndex = index
    this.restoreName = item ? item.name : ''
    this.dialogType = 'restore'
    this.showDialog = true
  },

  deleteBackup() {
    var self = this
    var index = self.deleteIndex
    if (index < 0 || index >= self.backupList.length) {
      self.showDialog = false
      return
    }
    var list = self.backupList.slice()
    list.splice(index, 1)
    self.saveBackupList(list)
    self.deleteIndex = -1
    self.showDialog = false
    self.resultMessage = "备份已删除"
    self.resultSuccess = false
  },

  dismissDialog() {
    this.showDialog = false
  },

  dialogAction() {
    if (this.dialogType === 'delete') {
      this.deleteBackup()
    } else {
      this.restoreBackup()
    }
  },

  stopBubble() {
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: column;
  align-items: center;
  padding: 8px 10px 10px 10px;
}

.back-btn-wrapper {
  width: 62px;
  height: 62px;
  border-radius: 31px;
  justify-content: center;
  align-items: center;
}

.back-btn-icon {
  width: 40px;
  height: 40px;
}

.header-title-wrapper {
  align-items: center;
  margin-top: 4px;
}

.header-title {
  font-size: 24px;
  font-weight: bold;
}

.section-title {
  font-size: 16px;
  margin: 8px 8px 4px 8px;
}

.empty-msg {
  align-items: center;
  padding: 16px 8px;
}

.empty-text {
  font-size: 18px;
}

.backup-row {
  flex-direction: column;
  margin: 4px 8px;
  padding: 8px;
  border-radius: 8px;
}

.backup-body {
  flex-direction: column;
}

.backup-name {
  font-size: 20px;
}

.backup-meta {
  font-size: 14px;
  margin-top: 2px;
}

.backup-actions {
  flex-direction: row;
  margin-top: 6px;
}

.action-btn {
  flex: 1;
  height: 32px;
  border-radius: 16px;
  justify-content: center;
  align-items: center;
}

.action-restore {
  margin-right: 6px;
}

.action-text {
  font-size: 18px;
}

.add-bottom {
  align-items: center;
  margin: 8px 8px 0 8px;
}

.btn-add {
  width: 100%;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}

.btn-add-text {
  font-size: 22px;
  font-weight: bold;
}

.result-msg {
  font-size: 14px;
  text-align: center;
  margin: 8px 8px 0 8px;
}

.overlay-modal {
  background-color: rgba(0, 0, 0, 0.5);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 40px 16px;
}

.dialog-box {
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 16px 12px;
  border-radius: 12px;
}

.dialog-title {
  font-size: 20px;
  font-weight: bold;
}

.dialog-desc {
  font-size: 16px;
  margin-top: 8px;
  text-align: center;
}

.dialog-buttons {
  flex-direction: row;
  margin-top: 16px;
}

.dialog-btn {
  height: 36px;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
  padding: 0 16px;
}

.dialog-btn-cancel {
  margin-right: 8px;
}

.dialog-btn-text {
  font-size: 18px;
}

@media (width >= 220px) {
  .header {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px 10px 10px;
  }

  .back-btn-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 25px;
  }

  .back-btn-icon {
    width: 31px;
    height: 31px;
  }

  .header-title-wrapper {
    flex: 1;
    align-items: center;
    margin-top: 0;
    margin-left: 8px;
  }

  .header-title {
    font-size: 26px;
  }

  .section-title {
    font-size: 18px;
    margin: 10px 10px 4px 10px;
  }

  .backup-row {
    margin: 4px 10px;
    padding: 10px;
  }

  .backup-name {
    font-size: 22px;
  }

  .backup-meta {
    font-size: 16px;
  }

  .action-btn {
    height: 36px;
    border-radius: 18px;
  }

  .action-restore {
    margin-right: 8px;
  }

  .btn-add {
    height: 48px;
    border-radius: 24px;
  }

  .btn-add-text {
    font-size: 24px;
  }
}

@media (width >= 400px) {
  .header {
    padding: 20px 12px 20px 12px;
  }

  .header-title {
    font-size: 28px;
  }

  .section-title {
    font-size: 20px;
  }

  .backup-name {
    font-size: 24px;
  }
}

@media (shape: circle) {
  .backup-row {
    margin: 2px 16px;
    padding: 6px 12px;
  }

  .action-btn {
    height: 28px;
    border-radius: 14px;
  }

  .btn-add {
    height: 40px;
    border-radius: 20px;
  }
}
</style>