}

.sheet-btn-primary {
  margin-bottom: 0;
}

.sheet-btn-text {
  font-size: 22px;
  lines: 1;
}

.pg-track {
  width: 100%;
  height: 8px;
  border-radius: 4px;
  margin-top: 8px;
}

/* 宽度走 progressPct%，与 index.ux / statistics.ux 的进度条同一套写法，
   百分比宽度在该框架上已被大量验证，不用 flex 比例凑。 */
.pg-fill {
  height: 8px;
  border-radius: 4px;
}

.empty-msg {
  align-items: center;
  padding: 16px 8px;
}

.empty-text {
  font-size: 24px;
}

