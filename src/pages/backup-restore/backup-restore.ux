<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="page-body">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">备份</text>
      <div class="header-placeholder"></div>
    </div>

    <text class="result-text" if="{{ resultMessage }}" style="color: {{ resultSuccess ? theme.accent : theme.deleteText }}">{{ resultMessage }}</text>

    <div class="progress-bar" if="{{ restoreProgress >= 0 }}" style="background-color: {{ theme.cardLight }}">
      <text class="progress-text" style="color: {{ theme.accent }}">进度: {{ restoreProgress }}/{{ restoreTotal }}</text>
      <div class="progress-track" style="background-color: {{ theme.border || theme.borderLight }}">
        <div class="progress-fill" style="width: {{ restoreProgress / restoreTotal * 100 }}%; background-color: {{ theme.accent }}"></div>
      </div>
    </div>

    <text class="empty-msg" if="{{ backupList.length === 0 }}" style="color: {{ theme.textMuted }}">暂无备份</text>

    <div class="backup-row" for="$item in backupList" style="background-color: {{ theme.card }}">
      <scroll scroll-x="true" class="name-scroll">
        <text class="backup-row-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
      </scroll>
      <div class="backup-row-footer">
        <scroll scroll-x="true" class="meta-scroll">
          <text class="backup-row-meta" style="color: {{ theme.textSecondary }}">{{ $item.courseCount }}门课程 · {{ $item.scheduleCount }}张课表</text>
        </scroll>
        <div class="backup-row-actions">
          <input class="row-restore-btn" type="button" value="恢复" onclick="restoreBackup($idx)"
                 style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
          <input class="row-delete-btn" type="button" value="{{ deleteConfirmIndex === $idx ? '确认' : '删除' }}"
                 onclick="handleDeleteBackup($idx)"
                 style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : 'transparent' }}; color: {{ deleteConfirmIndex === $idx ? theme.text : theme.deleteText }}; border-color: {{ theme.deleteText }}" />
        </div>
      </div>
    </div>

    <div class="create-section">
      <input class="bottom-create-btn" type="button" value="+ 新建备份" onclick="doBackup"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="info-section" style="background-color: {{ theme.card }}">
      <text class="info-title" style="color: {{ theme.text }}">备份内容</text>
      <text class="info-text" style="color: {{ theme.textSecondary }}">课程·课表·设置·主题·提醒·状态</text>
    </div>

    </div>

    <div class="overlay-modal" show="{{ showDialog }}" onclick="dismissDialog"
         style="position: absolute; left: 0; top: 0; width: 100%; height: 100%">
      <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁高级版</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">云备份恢复需要高级版，一次性解锁永久使用</text>
        <div class="benefit-list">
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 多课表管理</text>
          </scroll>
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          </scroll>
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
          </scroll>
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
          </scroll>
        </div>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="取消" onclick="dismissDialog"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")
const database = require("../../data/database.js")

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}

var BACKUP_LIST_KEY = "backup_list"
var MAX_BACKUPS = 20

var DATA_KEYS = [
  "allCourses_0", "allCourses_1", "allCourses_2", "allCourses_3", "allCourses_4",
  "allCourses_5", "allCourses_6", "allCourses_7", "allCourses_8", "allCourses_9",
  "scheduleNames", "currentScheduleIndex",
  "remindSettings", "homepage_settings",
  "appTheme", "baseFontSize", "premium_unlocked",
  "course_preset_list"
]

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    backupList: [],
    resultMessage: "",
    resultSuccess: false,
    deleteConfirmIndex: -1,
    restoreProgress: -1,
    restoreTotal: 0,
    showDialog: false
  },

  _logStatus() {
    dlog("[BACKUP] ===== ACCOUNT STATUS DEBUG =====")

    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] isPremiumUnlocked: " + unlocked)
      dlog("[BACKUP] status: " + (unlocked ? "高级会员" : "标准版"))
    })

    storage.get({
      key: "premium_unlocked",
      success: function(data) {
        dlog("[BACKUP] premium_unlocked storage: " + (data || "empty"))
      },
      fail: function() {
        dlog("[BACKUP] premium_unlocked storage: NOT FOUND")
      }
    })

    storage.get({
      key: "auth_data",
      success: function(data) {
        if (data) {
          try {
            var auth = JSON.parse(data)
            dlog("[BACKUP] auth_data: isActivated=" + auth.isActivated + " | isPermanent=" + auth.isPermanent + " | expireAt=" + (auth.expireAt || "none"))
          } catch (e) {
            dlog("[BACKUP] auth_data: parse error: " + e.message)
          }
        } else {
          dlog("[BACKUP] auth_data: empty")
        }
      },
      fail: function() {
        dlog("[BACKUP] auth_data: NOT FOUND")
      }
    })
    dlog("[BACKUP] ===== STATUS DEBUG END =====")
  },

  onInit() {
    dlog("[BACKUP] onInit: page created")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadBackupList()
    this._logStatus()
  },

  onReady() {
    dlog("[BACKUP] onReady: all components ready")
  },

  onShow() {
    dlog("[BACKUP] onShow: page shown")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this._logStatus()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  checkAndShowOverlay() {
    dlog("[BACKUP] checkAndShowOverlay: START, calling store.isPremiumUnlocked...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] checkAndShowOverlay: CALLBACK fired, unlocked=" + unlocked)
      if (!unlocked) {
        dlog("[BACKUP] checkAndShowOverlay: setting showDialog=true, was=" + self.showDialog)
        self.showDialog = true
        dlog("[BACKUP] checkAndShowOverlay: showDialog now=" + self.showDialog)
      } else {
        dlog("[BACKUP] checkAndShowOverlay: user IS premium, skip overlay")
      }
    })
    dlog("[BACKUP] checkAndShowOverlay: END (async pending)")
  },

  goToPremium() {
    dlog("[BACKUP] goToPremium: navigating to premium page")
    this.showDialog = false
    router.push({ uri: "/pages/activation" })
  },

  loadBackupList() {
    var self = this
    storage.get({
      key: BACKUP_LIST_KEY,
      success: function(data) {
        try {
          var list = JSON.parse(data)
          if (Array.isArray(list)) {
            self.backupList = list
          } else {
            self.backupList = []
          }
        } catch (e) {
          self.backupList = []
        }
      },
      fail: function() {
        self.backupList = []
      }
    })
  },

  saveBackupList(list) {
    var self = this
    storage.set({
      key: BACKUP_LIST_KEY,
      value: JSON.stringify(list),
      success: function() {
        self.backupList = list
      },
      fail: function() {
        self.backupList = list
      }
    })
  },

  goBack() {
    router.back()
  },

  dismissDialog() {
    this.showDialog = false
  },

  stopBubble() {
  },

  doBackup() {
    dlog("[BACKUP] doBackup: START, user clicked backup, checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] doBackup: CALLBACK, unlocked=" + unlocked + ", showDialog=" + self.showDialog)
      if (unlocked) {
        dlog("[BACKUP] doBackup: premium, performing backup")
        self.performBackup()
      } else {
        dlog("[BACKUP] doBackup: NOT premium, setting showDialog=true")
        self.showDialog = true
        dlog("[BACKUP] doBackup: showDialog now=" + self.showDialog)
      }
    })
  },

  performBackup() {
    var self = this
    var backupData = {}
    var total = DATA_KEYS.length

    function loadKey(index) {
      if (index >= total) {
        saveBackup(backupData)
        return
      }
      var key = DATA_KEYS[index]
      storage.get({
        key: key,
        success: function(data) {
          if (data) {
            backupData[key] = data
          }
          loadKey(index + 1)
        },
        fail: function() {
          loadKey(index + 1)
        }
      })
    }

    function saveBackup(data) {
      var now = new Date()
      var timeStr = now.getFullYear() + "-" +
        (now.getMonth() + 1 < 10 ? "0" : "") + (now.getMonth() + 1) + "-" +
        (now.getDate() < 10 ? "0" : "") + now.getDate() + " " +
        (now.getHours() < 10 ? "0" : "") + now.getHours() + ":" +
        (now.getMinutes() < 10 ? "0" : "") + now.getMinutes()

      var courseCount = 0
      var scheduleCount = 0

      try {
        var namesRaw = data["scheduleNames"]
        if (namesRaw) {
          var names = JSON.parse(namesRaw)
          if (Array.isArray(names)) {
            scheduleCount = names.length
          }
        }
      } catch (e) {}

      for (var i = 0; i < 10; i++) {
        var raw = data["allCourses_" + i]
        if (raw) {
          try {
            var schedule = JSON.parse(raw)
            if (Array.isArray(schedule)) {
              for (var d = 0; d < schedule.length; d++) {
                var classes = schedule[d].classes
                if (classes && Array.isArray(classes)) {
                  courseCount += classes.length
                }
              }
            }
          } catch (e) {}
        }
      }

      var backupEntry = {
        id: now.getTime(),
        name: "备份 " + timeStr,
        time: timeStr,
        courseCount: courseCount,
        scheduleCount: scheduleCount,
        data: data
      }

      var list = self.backupList.slice()
      list.unshift(backupEntry)

      if (list.length > MAX_BACKUPS) {
        list = list.slice(0, MAX_BACKUPS)
      }

      self.saveBackupList(list)
      self.resultMessage = "备份成功！(" + timeStr + ")"
      self.resultSuccess = true
    }

    loadKey(0)
  },

  restoreBackup(index) {
    dlog("[BACKUP] restoreBackup: START, index=" + index + ", checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] restoreBackup: CALLBACK, unlocked=" + unlocked + ", showDialog=" + self.showDialog)
      if (unlocked) {
        dlog("[BACKUP] restoreBackup: premium, performing restore")
        self.performRestore(index)
      } else {
        dlog("[BACKUP] restoreBackup: NOT premium, setting showDialog=true")
        self.showDialog = true
        dlog("[BACKUP] restoreBackup: showDialog now=" + self.showDialog)
      }
    })
  },

  performRestore(index) {
    var self = this
    var backup = self.backupList[index]
    if (!backup || !backup.data) {
      self.resultMessage = "备份数据无效"
      self.resultSuccess = false
      return
    }

    var backupData = backup.data
    var keys = Object.keys(backupData)
    var total = keys.length

    if (total === 0) {
      self.resultMessage = "备份数据为空"
      self.resultSuccess = false
      return
    }

    self.restoreProgress = 0
    self.restoreTotal = total

    function saveKey(i) {
      if (i >= total) {
        self.restoreProgress = -1
        self.resultMessage = "已恢复 " + total + " 项"
        self.resultSuccess = true
        // 备份是直接写存储的，先清掉内存缓存再重新加载，否则会读到恢复前的旧数据
        if (database.resetCache) database.resetCache()
        database.init(function() {
          store.getTheme(function() {}, true)
        })
        return
      }
      var key = keys[i]
      storage.set({
        key: key,
        value: backupData[key],
        success: function() {
          self.restoreProgress = i + 1
          saveKey(i + 1)
        },
        fail: function() {
          self.restoreProgress = i + 1
          saveKey(i + 1)
        }
      })
    }

    saveKey(0)
  },

  handleDeleteBackup(index) {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (!unlocked) {
        self.showDialog = true
        return
      }
      if (self.deleteConfirmIndex === index) {
        var list = self.backupList.slice()
        list.splice(index, 1)
        self.saveBackupList(list)
        self.deleteConfirmIndex = -1
        self.resultMessage = "备份已删除"
        self.resultSuccess = true
      } else {
        self.deleteConfirmIndex = index
      }
    })
  }
}
</script>

<style>
@import '../../common/header.css';

/* ================================================================
   BASE CSS = 手环 9 基准（160px 内容区）
   手环 9 默认命中，无需任何 media query。弹性 flex + % 撑满。
   屏幕增大时，下方宽度断点「增量」调整。
   手环 9 黑屏根因：独立 @media (shape: pill-shaped) 大块命中即崩，
   故 base 以 9 为基准，彻底移除独立 pill-shaped 分支。
   ================================================================ */
.page {
  flex: 1;
  flex-direction: column;
  padding: 0;
  width: 100%;
  height: 100%;
}

/* padding 承载在内层：弹窗 absolute 按父级内容盒计算，根容器带 padding 会让弹窗内缩不对称 */
.page-body {
  padding: 30px 8px 30px 8px;
}

.create-section {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 10px;
}

.bottom-create-btn {
  width: 100%;
  height: 40px;
  border-radius: 10px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
}

.result-text {
  font-size: 20px;
  text-align: center;
  margin-bottom: 10px;
  font-weight: bold;
  line-height: 28px;
}

.progress-bar {
  flex-direction: column;
  border-radius: 12px;
  padding: 12px 10px;
  margin-bottom: 10px;
}

.progress-text {
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 8px;
  text-align: center;
}

.progress-track {
  height: 8px;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4px;
}

.empty-msg {
  font-size: 24px;
  text-align: center;
  padding: 20px 0;
}

.backup-row {
  flex-direction: column;
  border-radius: 12px;
  padding: 10px 8px;
  margin-bottom: 8px;
}

.backup-row-name {
  font-size: 24px;
  font-weight: bold;
  line-height: 32px;
}

.name-scroll {
  width: 100%;
  height: 32px;
  margin-bottom: 4px;
}

.backup-row-footer {
  flex-direction: column;
  align-items: stretch;
  margin-top: 4px;
}

.backup-row-meta {
  font-size: 20px;
  line-height: 26px;
}

.meta-scroll {
  width: 100%;
  height: 26px;
  margin-bottom: 4px;
}

.backup-row-actions {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 0;
}

.row-restore-btn {
  width: 56px;
  height: 32px;
  border-radius: 6px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  margin-right: 6px;
}

.row-delete-btn {
  width: 56px;
  height: 32px;
  border-radius: 6px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  border-width: 1px;
}

.info-section {
  border-radius: 12px;
  padding: 14px 10px;
  margin-top: 10px;
}

.info-title {
  font-size: 24px;
  font-weight: bold;
  line-height: 32px;
  margin-bottom: 8px;
}

.info-text {
  font-size: 20px;
  line-height: 26px;
}

/* ---- 高级版弹窗（base = 手环 9）---- */
.overlay-modal {
  background-color: rgba(0, 0, 0, 0.35);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 40px 16px;
}

.modal-card {
  width: 100%;
  border-radius: 14px;
  padding: 14px 8px;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 24px;
  font-weight: bold;
  line-height: 30px;
  margin-bottom: 8px;
  text-align: center;
}

.modal-desc {
  font-size: 18px;
  text-align: center;
  line-height: 25px;
  margin-bottom: 10px;
}

.benefit-list {
  width: 100%;
  flex-direction: column;
  padding-left: 0;
  margin-bottom: 10px;
}

.benefit-item {
  font-size: 17px;
  line-height: 24px;
  margin-bottom: 6px;
}

.benefit-scroll {
  width: 100%;
  height: 24px;
  margin-bottom: 6px;
}

.modal-btn-primary {
  width: 100%;
  height: 40px;
  border-radius: 20px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  line-height: 28px;
  margin-bottom: 8px;
}

.modal-btn-secondary {
  width: 100%;
  height: 34px;
  border-radius: 17px;
  font-size: 20px;
  text-align: center;
  line-height: 26px;
}

/* ================================================================
   宽度断点：手环 10 / 胶囊屏大号（width >= 200px，内容区 ~180px）
   在 base 基础上「增量」：字号/间距略增。
   ================================================================ */
@media (width >= 200px) {
  .page-body {
    padding: 34px 10px 34px 10px;
  }
  .bottom-create-btn {
    height: 42px;
    font-size: 26px;
  }
  .result-text {
    font-size: 22px;
    line-height: 30px;
  }
  .backup-row-name {
    font-size: 26px;
    line-height: 34px;
  }
  .name-scroll {
    height: 34px;
    margin-bottom: 4px;
  }
  .backup-row-meta {
    font-size: 22px;
    line-height: 28px;
  }
  .meta-scroll {
    height: 28px;
  }
  .info-title {
    font-size: 26px;
    line-height: 34px;
  }
  .info-text {
    font-size: 22px;
    line-height: 28px;
  }
}

/* ================================================================
   宽度断点：Watch 6 / 方屏（width >= 400px，内容区 ~400px）
   在 base 基础上「增量」：布局紧凑、字号提升、行内按钮排布。
   ================================================================ */
@media (width >= 400px) {
  .page-body {
    padding: 6px 8px 10px 8px;
  }
  .bottom-create-btn {
    height: 38px;
    font-size: 24px;
  }
  .backup-row-name {
    font-size: 26px;
    line-height: 36px;
  }
  .name-scroll {
    height: 36px;
    margin-bottom: 4px;
  }
  .backup-row-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 0;
  }
  .backup-row-meta {
    font-size: 24px;
    line-height: 32px;
  }
  .meta-scroll {
    flex: 1;
    height: 32px;
    margin-right: 6px;
  }
  .info-section {
    padding: 14px 12px;
  }
  .info-title {
    font-size: 26px;
    line-height: 36px;
  }
  .info-text {
    font-size: 24px;
    line-height: 34px;
  }
  .modal-card {
    width: 80%;
    padding: 20px 16px;
  }
  .modal-title {
    font-size: 30px;
    line-height: 40px;
  }
  .modal-desc {
    font-size: 24px;
    line-height: 32px;
  }
  .benefit-item {
    font-size: 24px;
    line-height: 32px;
  }
  .modal-btn-primary {
    height: 44px;
    border-radius: 22px;
    font-size: 26px;
    line-height: 32px;
  }
  .modal-btn-secondary {
    height: 38px;
    border-radius: 19px;
    font-size: 24px;
    line-height: 30px;
  }
}

/* ================================================================
   圆形表盘（唯一保留的 shape 查询——圆方不同构，非宽度可替代）
   手环 9 不会命中此分支，天然安全。
   ================================================================ */
@media (shape: circle) {
  .page-body {
    padding: 44px 36px 44px 36px;
  }
  .bottom-create-btn {
    width: 100%;
    height: 44px;
    font-size: 28px;
  }
  .backup-row {
    padding: 14px 12px;
  }
  .backup-row-name {
    font-size: 30px;
    line-height: 40px;
  }
  .name-scroll {
    height: 40px;
    margin-bottom: 6px;
  }
  .backup-row-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .backup-row-meta {
    font-size: 26px;
    line-height: 34px;
  }
  .meta-scroll {
    flex: 1;
    height: 34px;
    margin-right: 6px;
  }
  .info-section {
    padding: 18px 16px;
    margin-top: 12px;
  }
  .info-title {
    font-size: 30px;
    line-height: 40px;
  }
  .info-text {
