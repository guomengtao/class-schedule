<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="hp-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">首页设置</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section section-first" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">快速添加</text>
        <div class="switch-track" style="background-color: {{ showQuickAdd ? theme.accent : theme.border }}" onclick="toggleQuickAdd">
          <div class="switch-thumb" style="left: {{ showQuickAdd ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row item-row-last">
        <text class="item-label" style="color: {{ theme.text }}">课程提醒</text>
        <div class="switch-track" style="background-color: {{ showStatusBar ? theme.accent : theme.border }}" onclick="toggleStatusBar">
          <div class="switch-thumb" style="left: {{ showStatusBar ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">总课程</text>
        <div class="switch-track" style="background-color: {{ showDayNavZong ? theme.accent : theme.border }}" onclick="toggleDayNavZong">
          <div class="switch-thumb" style="left: {{ showDayNavZong ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">今日</text>
        <div class="switch-track" style="background-color: {{ showDayNavJin ? theme.accent : theme.border }}" onclick="toggleDayNavJin">
          <div class="switch-thumb" style="left: {{ showDayNavJin ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row item-row-last">
        <text class="item-label" style="color: {{ theme.text }}">明日</text>
        <div class="switch-track" style="background-color: {{ showDayNavMing ? theme.accent : theme.border }}" onclick="toggleDayNavMing">
          <div class="switch-thumb" style="left: {{ showDayNavMing ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">自定义</text>
        <div class="switch-track" style="background-color: {{ showCustomContent ? theme.accent : theme.border }}" onclick="toggleCustomContent">
          <div class="switch-thumb" style="left: {{ showCustomContent ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div if="{{ showCustomContent }}" class="sub-block">
        <div class="row-divider" style="background-color: {{ theme.border }}"></div>
        <div class="input-row" onclick="openCustomContentEdit">
          <text class="input-text" style="color: {{ customContent ? theme.text : theme.textMuted }}">{{ customContent || '输入...' }}</text>
          <text class="input-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
        <div class="preview-row" if="{{ customContent }}">
          <text class="preview-text" style="color: {{ theme.accent }}">{{ customContent }}</text>
        </div>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row" onclick="toggleFontSize">
        <text class="item-label" style="color: {{ theme.text }}">课程字号</text>
        <div class="row-right">
          <text class="item-hint" style="color: {{ theme.textMuted }}">{{ displaySize }}px</text>
          <text class="fold-arrow" style="color: {{ theme.textMuted }}">{{ showFontSize ? 'v' : '›' }}</text>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}" if="{{ showFontSize }}"></div>
      <div if="{{ showFontSize }}" class="font-size-body">
        <div class="scale-row">
          <input class="scale-btn" type="button" value="−" onclick="decreaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="scale-value" style="color: {{ theme.accent }}">{{ displaySize }}px</text>
          <input class="scale-btn" type="button" value="+" onclick="increaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
        <div class="preview-box" style="background-color: {{ theme.cardLight }}">
          <text class="preview-font" style="font-size: {{ displaySize }}px; color: {{ theme.text }}">数学 08:00</text>
        </div>
        <text class="scope-hint" style="color: {{ theme.textMuted }}">仅影响首页课程卡片</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">钉首页</text>
        <div class="switch-track" style="background-color: {{ showPinnedBar ? theme.accent : theme.border }}" onclick="togglePinnedBar">
          <div class="switch-thumb" style="left: {{ showPinnedBar ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div if="{{ showPinnedBar }}" class="sub-block">
        <div class="row-divider" style="background-color: {{ theme.border }}"></div>
        <div class="item-row item-row-last" onclick="openPinnedPages">
          <text class="item-label" style="color: {{ theme.text }}">管理钉首页</text>
          <text class="item-hint" style="color: {{ theme.textMuted }}">管理</text>
        </div>
      </div>
    </div>

    </div>
    </scroll>

    <div class="overlay-modal" show="{{ showDialog }}" onclick="dismissDialog">
      <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁高级版</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">一次性解锁，永久使用全部高级功能</text>
        <div class="benefit-list">
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多课表管理</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
        </div>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="返回" onclick="goBack"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

const sizeLevels = [20, 28, 36, 48, 62, 76]

var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    showQuickAdd: true,
    showCustomContent: false,
    customContent: "",
    showStatusBar: true,
    showPinnedBar: true,
    showDayNavZong: true,
    showDayNavJin: true,
    showDayNavMing: true,
    displaySize: 48,
    showFontSize: false,
    showDialog: false
  },
  onInit() {
    dlog("[HOMEPAGE-SETTINGS] onInit: page created")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadSettings()
  },
  onReady() {
    dlog("[HOMEPAGE-SETTINGS] onReady: checking premium...")
    this.checkAndShowOverlay()
  },
  onShow() {
    dlog("[HOMEPAGE-SETTINGS] onShow: page shown")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadSettings()
  },
  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },
  loadSettings() {
    var self = this
    store.getHomepageSettings(function(settings) {
      self.showQuickAdd = settings.showQuickAdd !== false
      self.showCustomContent = settings.showCustomContent || false
      self.customContent = settings.customContent || ""
      self.showStatusBar = settings.showStatusBar !== false
      self.showPinnedBar = settings.showPinnedBar !== false
      self.showDayNavZong = settings.showDayNavZong !== false
      self.showDayNavJin = settings.showDayNavJin !== false
      self.showDayNavMing = settings.showDayNavMing !== false
    })
    // 课程字号真实数据源是 baseFontSize（settings.ux 同源），不是 homepage_settings.displaySize
    store.getBaseFontSize(function(size) {
      self.displaySize = size
    }, true)
  },
  saveSettings() {
    store.setHomepageSettings({
      showQuickAdd: this.showQuickAdd,
      showCustomContent: this.showCustomContent,
      customContent: this.customContent,
      showStatusBar: this.showStatusBar,
      showPinnedBar: this.showPinnedBar,
      showDayNavZong: this.showDayNavZong,
      showDayNavJin: this.showDayNavJin,
      showDayNavMing: this.showDayNavMing
    })
  },
  checkAndShowOverlay() {
    dlog("[HOMEPAGE-SETTINGS] checkAndShowOverlay: checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (!unlocked) {
        dlog("[HOMEPAGE-SETTINGS] checkAndShowOverlay: not premium, showing dialog")
        self.showDialog = true
      }
    })
  },

  goToPremium() {
    dlog("[HOMEPAGE-SETTINGS] goToPremium: navigating to activation")
    this.showDialog = false
    router.push({ uri: "/pages/activation" })
  },

  goBack() {
    store.setHomepageSettings({
      showQuickAdd: this.showQuickAdd,
      showCustomContent: this.showCustomContent,
      customContent: this.customContent,
      showStatusBar: this.showStatusBar,
      showPinnedBar: this.showPinnedBar,
      showDayNavZong: this.showDayNavZong,
      showDayNavJin: this.showDayNavJin,
      showDayNavMing: this.showDayNavMing
    }, function() { router.back() })
  },

  dismissDialog() {
    this.showDialog = false
  },

  stopBubble() {
  },

  toggleQuickAdd() {
    this.showQuickAdd = !this.showQuickAdd
    this.saveSettings()
  },
  toggleCustomContent() {
    this.showCustomContent = !this.showCustomContent
    this.saveSettings()
  },
  toggleStatusBar() {
    this.showStatusBar = !this.showStatusBar
    this.saveSettings()
  },
  togglePinnedBar() {
    this.showPinnedBar = !this.showPinnedBar
    this.saveSettings()
  },
  toggleDayNavZong() {
    this.showDayNavZong = !this.showDayNavZong
    this.saveSettings()
  },
  toggleDayNavJin() {
    this.showDayNavJin = !this.showDayNavJin
    this.saveSettings()
  },
  toggleDayNavMing() {
    this.showDayNavMing = !this.showDayNavMing
    this.saveSettings()
  },
  toggleFontSize() {
    this.showFontSize = !this.showFontSize
  },
  setSize(size) {
    this.displaySize = size
    store.setBaseFontSize(size)
  },
  decreaseFont() {
    for (var i = sizeLevels.length - 1; i >= 0; i--) {
      if (sizeLevels[i] < this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },
  increaseFont() {
    for (var i = 0; i < sizeLevels.length; i++) {
      if (sizeLevels[i] > this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },
  openCustomContentEdit() {
    router.push({ uri: "/pages/custom-content-edit" })
  },

  openPinnedPages() {
    router.push({ uri: "/pages/pinned-pages" })
  }
}
</script>

<style>
@import '../../common/header.css';

.page-root {
  width: 100%;
  height: 100%;
}

.page {
  flex: 1;
  flex-direction: column;
  width: 100%;
  height: 100%;
  
}

/* 滚动容器：内容超过一屏时不再被裁切（参照 settings.ux 已验证写法）。
   弹窗留在根容器下，避免被 scroll 裁掉 */
.hp-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

/* 内容内层容器：承载页面 padding —— Vela 绝对定位按父级内容框计算，
   根容器留 padding 会把弹窗一起内缩，导致左右不对称、贴不到屏幕边 */
.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

/* 显式宽度与方向：部分真机 Vela（如 432 宽 rect）对"隐式宽度的中间层"会退化到内容宽，
   导致行内 space-between 失效、开关叠压文字 —— 这里全部显式声明，窄屏上是 no-op */
.section {
  width: 100%;
  flex-direction: column;
  border-radius: 14px;
  padding: 0 16px;
  margin-bottom: 18px;
  overflow: hidden;
}

.section-first {
  margin-top: 2px;
}

/* 条件渲染的包裹层同样必须显式宽度（无 class 的裸 div 是典型隐式宽度中间层） */
.sub-block {
  width: 100%;
  flex-direction: column;
}

.item-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
}

.row-divider {
  width: 100%;
  height: 1px;
}

.item-label {
  font-size: 32px;
  flex: 1;
  min-width: 0;
  lines: 1;
  text-overflow: ellipsis;
}

.item-hint {
  font-size: 24px;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.fold-arrow {
  font-size: 24px;
  width: 20px;
  text-align: center;
  flex-shrink: 0;
}

.font-size-body {
  width: 100%;
  flex-direction: column;
  padding-bottom: 16px;
}

.scale-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 16px;
  margin-bottom: 12px;
}

.scale-btn {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
}

.scale-value {
  font-size: 28px;
  font-weight: bold;
  width: 72px;
  text-align: center;
  line-height: 38px;
}

.preview-box {
  width: 100%;
  padding: 14px;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
}

.preview-font {
  font-weight: bold;
  text-align: center;
}

.scope-hint {
  font-size: 20px;
  line-height: 24px;
  text-align: center;
  margin-top: 10px;
}

.switch-track {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  position: relative;
  flex-shrink: 0;
}

.switch-thumb {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  position: absolute;
  top: 2px;
}

.input-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
}

.input-text {
  font-size: 32px;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.input-arrow {
  font-size: 28px;
  margin-left: 10px;
}

.preview-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 14px 0 18px 0;
}

.preview-text {
  font-size: 32px;
  font-weight: bold;
}

.overlay-modal {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-card {
  width: 80%;
  border-radius: 16px;
  padding: 28px 24px;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 36px;
  font-weight: bold;
  margin-bottom: 12px;
  text-align: center;
}

.modal-desc {
  font-size: 28px;
  text-align: center;
  margin-bottom: 20px;
  line-height: 38px;
}

.benefit-list {
  width: 100%;
  flex-direction: column;
  padding-left: 12px;
  margin-bottom: 24px;
}

.benefit-item {
  font-size: 32px;
  margin-bottom: 10px;
  lines: 1;
  text-overflow: ellipsis;
}

.modal-btn-primary {
  width: 100%;
  height: 48px;
  border-radius: 24px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 10px;
}

.modal-btn-secondary {
  width: 100%;
  height: 42px;
  border-radius: 21px;
  font-size: 28px;
  text-align: center;
}

@media screen and (shape: circle) {
  .page-body {
    padding: 44px 36px 44px 36px;
  }
  
  
  
  .overlay-modal {
    padding: 44px 36px 44px 36px;
  }
  .modal-card {
    width: 72%;
    padding: 24px 20px;
  }
}

@media screen and (shape: pill-shaped) {
  .page-body {
    padding: 30px 8px 30px 8px;
  }

  
  
  

  .section {
    padding: 0 8px;
  }

  .item-row {
    padding: 12px 0;
  }

  .item-label {
    font-size: 24px;
    line-height: 32px;
  }

  .item-hint {
    font-size: 20px;
  }

  .input-text {
    font-size: 24px;
    line-height: 32px;
  }

  .input-arrow {
    font-size: 24px;
    margin-left: 6px;
  }

  .preview-font {
    font-size: 24px;
  }

  .switch-track {
    width: 48px;
    height: 26px;
    border-radius: 13px;
  }

  .switch-thumb {
    width: 22px;
    height: 22px;
    border-radius: 11px;
  }

  .fold-arrow {
    font-size: 20px;
    width: 18px;
  }

  .font-size-body {
    padding-bottom: 12px;
  }

  .scale-row {
    margin-top: 12px;
    margin-bottom: 10px;
  }

  .scale-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    font-size: 22px;
    line-height: 36px;
  }

  .scale-value {
    font-size: 24px;
    width: 60px;
    line-height: 32px;
  }

  .preview-box {
    padding: 10px;
    border-radius: 8px;
  }

  .scope-hint {
    font-size: 18px;
    line-height: 22px;
    margin-top: 8px;
  }

  .modal-card {
    width: 100%;
    border-radius: 12px;
    padding: 14px 8px;
  }

  .modal-title {
    font-size: 28px;
    margin-bottom: 8px;
    line-height: 36px;
    text-align: center;
  }

  .modal-desc {
    font-size: 24px;
    margin-bottom: 12px;
    line-height: 30px;
    lines: 4;
    text-align: center;
  }

  .benefit-list {
    margin-bottom: 12px;
    padding-left: 6px;
  }

  .benefit-item {
    font-size: 17px;
    margin-bottom: 6px;
    line-height: 24px;
    lines: 1;
    text-overflow: ellipsis;
  }

  .modal-btn-primary {
    height: 40px;
    border-radius: 20px;
    font-size: 24px;
    margin-bottom: 8px;
  }

  .modal-btn-secondary {
    height: 36px;
    border-radius: 18px;
    font-size: 24px;
  }

}

@media screen and (shape: rect) {
  .page-body {
    padding: 6px 8px 8px 8px;
  }
  
  
  
}
/* ===== 胶囊屏（192px）统一适配：解锁/高级版弹窗 =====
   背景：同一套弹窗在 6 处各写一份，胶囊适配缺失/不一致 → 192×490 上出现
   标题截成 3 字、✓ 条目只剩 1 字、内容顶到屏幕右缘被裁（2026-09-27 实测）。
   统一策略：卡片占满安全宽度、字号降档、文本允许 2 行/1 行 + 省略号。 */
@media screen and (shape: pill-shaped) {
  .overlay-modal {
    padding: 40px 16px;
  }

  .modal-card {
    width: 100%;
    border-radius: 14px;
    padding: 14px 8px;
  }

  .modal-title {
    font-size: 24px;
    line-height: 30px;
    margin-bottom: 8px;
    lines: 2;
    text-overflow: ellipsis;
  }

  .modal-desc {
    font-size: 18px;
    line-height: 25px;
    margin-bottom: 10px;
    lines: 4;
  }

  .benefit-list {
    width: 100%;
    padding-left: 0;
    margin-bottom: 10px;
  }

  .benefit-item {
    font-size: 17px;
    line-height: 24px;
    margin-bottom: 6px;
    lines: 1;
    text-overflow: ellipsis;
  }

  .modal-btn-primary {
    height: 40px;
    border-radius: 20px;
    font-size: 22px;
    line-height: 28px;
    margin-bottom: 8px;
  }

  .modal-btn-secondary {
    height: 34px;
    border-radius: 17px;
    font-size: 20px;
    line-height: 26px;
  }
}
</style>