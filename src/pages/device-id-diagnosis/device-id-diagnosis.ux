<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">设备ID诊断</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="crash-banner" if="{{ crashedAt }}" style="background-color: {{ theme.card }}">
      <text class="crash-banner-text" style="color: #e74c3c">⚠ 上次崩在: {{ crashedAt }}</text>
      <text class="crash-banner-text" style="color: {{ theme.textSecondary }}">该项建议不要再点</text>
    </div>

    <text class="tip" style="color: {{ theme.textSecondary }}">每次只点一项，出结果后再点下一项。标 ⚠ 的可能导致设备重启，建议最后测。</text>

    <scroll class="body" scroll-y="true">
      <div class="btn-item" for="{{ testList }}" onclick="runOne($idx)" style="background-color: {{ theme.card }}">
        <text class="btn-label" style="color: {{ $item.danger ? '#e74c3c' : theme.accent }}">{{ $item.label }}</text>
        <text class="btn-flag" style="color: {{ $item.danger ? '#e74c3c' : theme.textMuted }}">{{ $item.danger ? '⚠ 有风险' : '安全' }}</text>
      </div>

      <text class="result-title" if="{{ results.length > 0 }}" style="color: {{ theme.textSecondary }}">结果</text>
      <div class="row" for="{{ results }}" style="flex-shrink: 0">
        <text class="row-label" style="color: {{ theme.accent }}">{{ $item.label }}</text>
        <text class="row-value" style="color: {{ $item.ok ? theme.text : '#e74c3c' }}">{{ $item.value }}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
var device = require("@system.device")
var storage = require("@system.storage")
var prompt = require("@system.prompt")
var store = require("../../data/store.js")

var PROGRESS_KEY = "diag_progress_v2"
var UUID_KEY = "diag_uuid_v1"

function generateUUID() {
  var d = new Date().getTime()
  var uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'
  return uuid.replace(/[xy]/g, function(c) {
    var r = (d + Math.random() * 16) % 16 | 0
    d = Math.floor(d / 16)
    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16)
  })
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    testList: [
      { key: 'localUUID',   label: '本地 UUID',   danger: false },
      { key: 'getInfo',     label: 'getInfo',     danger: false },
      { key: 'getUA',       label: 'getUA',       danger: false },
      { key: 'getDeviceId', label: 'getDeviceId', danger: true  },
      { key: 'getSerial',   label: 'getSerial',   danger: true  },
      { key: 'getMac',      label: 'getMac',      danger: true  },
      { key: 'getId',       label: 'getId',       danger: true  }
    ],
    results: [],
    crashedAt: '',
    running: false
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    self.loadProgress()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  // 只读取上次崩溃记录，绝不自动跑测试
  loadProgress() {
    var self = this
    storage.get({
      key: PROGRESS_KEY,
      success: function(data) {
        if (data) {
          self.crashedAt = String(data)
          self.addResult('⚠ 上次崩在', false, String(data))
          storage.set({ key: PROGRESS_KEY, value: '' })
        }
      },
      fail: function() {}
    })
  },

  // 点击某一项：危险项先二次确认，再单次执行
  runOne(idx) {
    var self = this
    if (self.running) return
    var item = self.testList[idx]
    if (!item) return

    if (item.danger) {
      var go = function() { self.startOne(item) }
      try {
        prompt.showDialog({
          title: '风险提示',
          message: '测试 ' + item.label + ' 可能导致设备重启，确定继续？',
          buttons: [{ text: '取消', color: '#888899' }, { text: '继续', color: '#e74c3c' }],
          success: function(res) {
            if (res && res.index === 1) { go() }
          },
          fail: function() { go() }
        })
      } catch (e) {
        go()
      }
      return
    }
    self.startOne(item)
  },

  // 单次执行：先落盘"正在测 X"（崩溃前已记录），延时后再调 API
  startOne(item) {
    var self = this
    if (self.running) return
    self.running = true
    storage.set({
      key: PROGRESS_KEY,
      value: item.key,
      success: function() { self.launch(item) },
      fail: function() { self.launch(item) }
    })
  },

  launch(item) {
    var self = this
    // 延时确保 storage 落盘完成，再调用可能崩溃的 API
    setTimeout(function() {
      self.callTest(item.key, function(ok, value) {
        self.running = false
        self.addResult(item.label, ok, value)
        // 没崩、正常返回 → 清除进度记录
        storage.set({ key: PROGRESS_KEY, value: '' })
      })
    }, 350)
  },

  callTest(key, cb) {
    var fnName = 'test_' + key
    if (typeof this[fnName] !== 'function') {
      cb(false, '未知测试')
      return
    }
    try {
      this[fnName](cb)
    } catch (e) {
      cb(false, '异常')
    }
  },

  test_localUUID(cb) {
    try {
      storage.get({
        key: UUID_KEY,
        success: function(data) {
          if (data) {
            cb(true, String(data))
          } else {
            var uuid = generateUUID()
            storage.set({
              key: UUID_KEY,
              value: uuid,
              success: function() { cb(true, uuid) },
              fail: function() { cb(false, uuid + '(存储失败)') }
            })
          }
        },
        fail: function() { cb(false, '读取失败') }
      })
    } catch (e) { cb(false, '异常') }
  },

  test_getInfo(cb) {
    try {
      device.getInfo({
        success: function(ret) {
          var id = ret.deviceId || ret.serialNumber || ret.udid || ''
          cb(!!id, id || '(无)')
        },
        fail: function() { cb(false, '获取失败') }
      })
    } catch (e) { cb(false, '异常') }
  },

  test_getUA(cb) {
    try {
      if (typeof device.getUA !== 'function') { cb(false, 'API不存在'); return }
      device.getUA({
        success: function(data) { cb(true, JSON.stringify(data)) },
        fail: function() { cb(false, '获取失败') }
      })
    } catch (e) { cb(false, '异常') }
  },

  test_getDeviceId(cb) {
    try {
      device.getDeviceId({
        success: function(data) {
          var raw = data.deviceId
          cb(!!(raw && raw !== 'NA'), raw || '(空)')
        },
        fail: function() { cb(false, '获取失败') }
      })
    } catch (e) { cb(false, '异常') }
  },

  test_getSerial(cb) {
    try {
      device.getSerial({
        success: function(data) {
          var raw = data.serial
          cb(!!(raw && raw !== 'NA'), raw || '(空)')
        },
        fail: function() { cb(false, '获取失败') }
      })
    } catch (e) { cb(false, '异常') }
  },

  test_getMac(cb) {
    try {
      if (typeof device.getMac !== 'function') { cb(false, 'API不存在'); return }
      device.getMac({
        success: function(data) {
          var raw = data.mac || data.address || ''
          cb(!!raw, raw || '(空)')
        },
        fail: function() { cb(false, '获取失败') }
      })
    } catch (e) { cb(false, '异常') }
  },

  test_getId(cb) {
    try {
      if (typeof device.getId !== 'function') { cb(false, 'API不存在'); return }
      device.getId({
        success: function(data) { cb(true, JSON.stringify(data)) },
        fail: function() { cb(false, '获取失败') }
      })
    } catch (e) { cb(false, '异常') }
  },

  addResult(label, ok, value) {
    this.results.push({ label: label, ok: ok, value: value })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 8px 8px 6px 8px;
}

.crash-banner {
  flex-direction: column;
  flex-shrink: 0;
  border-radius: 8px;
  padding: 6px 10px;
  margin-bottom: 6px;
}

.crash-banner-text {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
  text-overflow: ellipsis;
}

.tip {
  flex-shrink: 0;
  font-size: 20px;
  line-height: 27px;
  padding: 2px 2px 8px 2px;
}

.body {
  flex: 1;
  flex-direction: column;
}

.btn-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 8px;
  padding: 10px 12px;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.btn-label {
  font-size: 24px;
  line-height: 32px;
  lines: 1;
}

.btn-flag {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
  flex-shrink: 0;
  margin-left: 8px;
}

.result-title {
  flex-shrink: 0;
  font-size: 22px;
  line-height: 30px;
  padding: 8px 2px 4px 2px;
}

.row {
  flex-direction: column;
  padding: 4px 2px;
  flex-shrink: 0;
}

.row-label {
  font-size: 22px;
  line-height: 30px;
  lines: 1;
}

.row-value {
  font-size: 22px;
  line-height: 30px;
  lines: 0;
  word-break: break-all;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 8px 10px 6px 10px;
  }
}

@media (shape: circle) {
  .page {
    padding: 24px 36px 24px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 6px 10px 12px 10px;
  }
}
</style>
