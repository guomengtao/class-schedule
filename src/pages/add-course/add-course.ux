<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- header 3 元素：返回键 30 + 居中标题（2 字）+ 等宽占位 30。
         占位不能归零，否则 flex 标题被推向左侧、整体不居中。 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">添加</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="content-scroll" scroll-y="true">
      <!-- 选课程：删掉原「管理」按钮（与末尾 + 卡同一入口，纯冗余占位） -->
      <text class="section-title" style="color: {{ theme.text }}">选课程</text>
      <scroll class="course-scroll" scroll-x="true">
        <div class="course-item"
             for="{{ (idx, c) in presetCourses }}"
             onclick="selectCourseByIdx(idx)"
             style="background-color: {{ courseIndex === idx ? theme.accent : theme.card }}">
          <text class="course-name"
                style="color: {{ courseIndex === idx ? theme.bg : theme.text }}">{{ c.name }}</text>
        </div>
        <div class="course-item course-add-item" onclick="openCourseManager"
             style="background-color: {{ theme.cardLight }}">
          <text class="course-add-icon" style="color: {{ theme.accent }}">+</text>
        </div>
      </scroll>

      <!-- 首屏放三个「真会改」的字段：课程、星期、位置。
           时间由所选课程自动带出，改得最少，沉到最下方，避免首屏被两张时间卡吃掉。 -->
      <text class="section-title" style="color: {{ theme.text }}">星期</text>
      <scroll scroll-x="true" class="weekday-scroll" id="weekdayScroll" scroll-left="{{ weekdayScrollLeft }}">
        <div class="weekday-row">
          <div class="weekday-btn" onclick="selectDay(1)"
               style="background-color: {{ dayIndex === 1 ? theme.accent : theme.card }}">
            <text class="weekday-text" style="color: {{ dayIndex === 1 ? theme.bg : theme.text }}">一</text>
          </div>
          <div class="weekday-btn" onclick="selectDay(2)"
               style="background-color: {{ dayIndex === 2 ? theme.accent : theme.card }}">
            <text class="weekday-text" style="color: {{ dayIndex === 2 ? theme.bg : theme.text }}">二</text>
          </div>
          <div class="weekday-btn" onclick="selectDay(3)"
               style="background-color: {{ dayIndex === 3 ? theme.accent : theme.card }}">
            <text class="weekday-text" style="color: {{ dayIndex === 3 ? theme.bg : theme.text }}">三</text>
          </div>
          <div class="weekday-btn" onclick="selectDay(4)"
               style="background-color: {{ dayIndex === 4 ? theme.accent : theme.card }}">
            <text class="weekday-text" style="color: {{ dayIndex === 4 ? theme.bg : theme.text }}">四</text>
          </div>
          <div class="weekday-btn" onclick="selectDay(5)"
               style="background-color: {{ dayIndex === 5 ? theme.accent : theme.card }}">
            <text class="weekday-text" style="color: {{ dayIndex === 5 ? theme.bg : theme.text }}">五</text>
          </div>
          <div class="weekday-btn" onclick="selectDay(6)"
               style="background-color: {{ dayIndex === 6 ? theme.accent : theme.card }}">
            <text class="weekday-text" style="color: {{ dayIndex === 6 ? theme.bg : theme.text }}">六</text>
          </div>
          <div class="weekday-btn" onclick="selectDay(0)"
               style="background-color: {{ dayIndex === 0 ? theme.accent : theme.card }}">
            <text class="weekday-text" style="color: {{ dayIndex === 0 ? theme.bg : theme.text }}">日</text>
          </div>
        </div>
      </scroll>

      <!-- 上课时间：两张卡（开始/结束），卡内时、分两列，值下方各自 −/+。
           原设计 4 个 label 独占整行 + 4 行按钮 = 328px，现为 2×(34+34+44) 共 224px。 -->
      <text class="section-title" style="color: {{ theme.text }}">上课时间</text>
      <div class="time-card" style="background-color: {{ theme.card }}">
        <text class="time-head" style="color: {{ theme.text }}">开始</text>
        <div class="time-grid">
          <div class="time-col">
            <text class="time-val" style="color: {{ theme.text }}">{{ padZero(startHour) }}时</text>
            <div class="step-pair">
              <input class="step-btn" type="button" value="-" onclick="decreaseStartHour"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
              <input class="step-btn" type="button" value="+" onclick="increaseStartHour"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            </div>
          </div>
          <div class="time-col">
            <text class="time-val" style="color: {{ theme.text }}">{{ padZero(startMin) }}分</text>
            <div class="step-pair">
              <input class="step-btn" type="button" value="-" onclick="decreaseStartMin"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
              <input class="step-btn" type="button" value="+" onclick="increaseStartMin"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            </div>
          </div>
        </div>
      </div>
      <div class="time-card" style="background-color: {{ theme.card }}">
        <text class="time-head" style="color: {{ theme.text }}">结束</text>
        <div class="time-grid">
          <div class="time-col">
            <text class="time-val" style="color: {{ theme.text }}">{{ padZero(endHour) }}时</text>
            <div class="step-pair">
              <input class="step-btn" type="button" value="-" onclick="decreaseEndHour"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
              <input class="step-btn" type="button" value="+" onclick="increaseEndHour"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            </div>
          </div>
          <div class="time-col">
            <text class="time-val" style="color: {{ theme.text }}">{{ padZero(endMin) }}分</text>
            <div class="step-pair">
              <input class="step-btn" type="button" value="-" onclick="decreaseEndMin"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
              <input class="step-btn" type="button" value="+" onclick="increaseEndMin"
                     style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            </div>
          </div>
        </div>
      </div>      <text class="section-title" style="color: {{ theme.text }}">上课位置</text>
      <div class="input-box" onclick="showKeyboard" style="background-color: {{ theme.card }}">
        <text class="input-text {{ courseLocation ? '' : 'input-placeholder' }}"
              style="color: {{ courseLocation ? theme.text : theme.textSecondary }}">
          {{ courseLocation || '输入位置' }}
        </text>
      </div>


    </scroll>

    <!-- ev-six 第 13 条：禁用 prompt.showToast（系统浮层固定弹上部，会压住内容）。
         校验/冲突/失败一律走这条页内状态条：高度固定 34px，只换颜色不换高度。 -->
    <div class="tip-row" style="display: {{ tipText ? 'flex' : 'none' }}">
      <text class="tip-text" style="color: {{ tipColor }}">{{ tipText }}</text>
    </div>

    <div class="bottom-bar">
      <input class="cancel-btn" type="button" value="取消" onclick="goBack"
             style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <input class="save-btn" type="button" value="{{ saveLabel }}" onclick="saveCourse"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var store = require("../../data/store.js")
var database = require("../../data/database.js")

var COURSE_LIST_KEY = "course_preset_list"
var MIN_STEP = 5   // 分钟步进：课程表时间全为 5 的倍数，±1 需点 30 次不可用

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "", location: "" },
  { name: "生物", time: "13:55 - 14:40", teacher: "", location: "" },
  { name: "历史", time: "15:00 - 15:45", teacher: "", location: "" },
  { name: "地理", time: "15:55 - 16:40", teacher: "", location: "" },
  { name: "政治", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "音乐", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "美术", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "体育", time: "10:55 - 11:40", teacher: "", location: "" }
]

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  if (!timeStr) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

export default {
  private: {
    courseName: "",
    courseTime: "",
    courseLocation: "",
    courseIndex: 0,
    presetCourses: [],
    iconTheme: "dark",
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    dayIndex: 1,
    weekdayScrollLeft: 0,
    day: "",
    nextId: 100,
    isSaving: false,
    conflictConfirmed: false,
    tipText: "",
    tipColor: "#ff6b6b",
    saveLabel: "添加",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0"
    }
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(" - ")[0] : "00:00"
      var tb = b.time ? b.time.split(" - ")[0] : "00:00"
      var taParts = ta.split(":")
      var tbParts = tb.split(":")
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadCourses()
    this.setDefaultDay()
    var storage = require("@system.storage")
    storage.get({
      key: "add_course_nextId",
      success: function(val) {
        self.nextId = parseInt(val) || 100
      },
      fail: function() {
        self.nextId = 100
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.refreshCourseList()
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.courseLocation = data
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  refreshCourseList() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            }
          } catch (e) {}
        }
      },
      fail: function() {}
    })
  },

  setDefaultDay() {
    var self = this
    var storage = require("@system.storage")
    // 优先使用首页传入的星期：用户在首页翻到某一天后再点「添加课程」，
    // 表单应默认停在那一天，而不是永远停在今天。
    storage.get({
      key: "add_course_day",
      success: function(val) {
        var idx = -1
        if (val !== undefined && val !== null && val !== "") {
          idx = DAY_NAMES.indexOf(val)
        }
        if (idx < 0) idx = new Date().getDay()
        self.dayIndex = idx
        self.day = DAY_NAMES[idx]
        storage.delete({ key: "add_course_day", fail: function() {} })
        self.scrollToCurrentDay()
      },
      fail: function() {
        var idx = new Date().getDay()
        self.dayIndex = idx
        self.day = DAY_NAMES[idx]
        self.scrollToCurrentDay()
      }
    })
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            } else {
              self.presetCourses = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.presetCourses = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.presetCourses = self.sortByTime(defaultCourses.slice())
        }
        self.selectCourse(self.courseIndex)
      },
      fail: function() {
        self.presetCourses = self.sortByTime(defaultCourses.slice())
        self.selectCourse(self.courseIndex)
      }
    })
  },

  openCourseManager() {
    router.replace({ uri: "/pages/course-manager" })
  },

  padZero(n) {
    return padZero(n)
  },

  // 页内状态条（替代 prompt.showToast）。高度固定 34px，只换颜色。
  showTip(text, color) {
    this.tipText = text
    this.tipColor = color || "#ff6b6b"
  },

  // 任何一次有效的表单改动都清掉旧提示，并把主按钮复位成「添加」
  clearTip() {
    if (this.tipText !== "") { this.tipText = "" }
    if (this.saveLabel !== "添加") { this.saveLabel = "添加" }
    if (this.conflictConfirmed) { this.conflictConfirmed = false }
  },

  selectCourseByIdx(idx) {
    this.courseIndex = idx
    var c = this.presetCourses[idx]
    if (!c) { return }
    this.courseName = c.name
    this.courseLocation = c.location || ""
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
    this.clearTip()
  },

  selectCourse(index) {
    if (this.presetCourses.length === 0) {
      this.courseName = ""
      this.courseTime = ""
      return
    }
    if (index < 0 || index >= this.presetCourses.length) {
      index = 0
    }
    this.courseIndex = index
    var c = this.presetCourses[index]
    this.courseName = c.name
    this.courseLocation = c.location
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
    this.updateTimeString()
  },

  // 时间步进：小时 ±1，分钟 ±5（MIN_STEP），分钟跨 60 自动进位/退位
  increaseStartHour() {
    this.startHour = this.startHour >= 23 ? 0 : this.startHour + 1
    this.adjustEndTime()
    this.clearTip()
  },
  decreaseStartHour() {
    this.startHour = this.startHour <= 0 ? 23 : this.startHour - 1
    this.adjustEndTime()
    this.clearTip()
  },
  increaseStartMin() {
    this.shiftStartMin(MIN_STEP)
    this.adjustEndTime()
    this.clearTip()
  },
  decreaseStartMin() {
    this.shiftStartMin(-MIN_STEP)
    this.adjustEndTime()
    this.clearTip()
  },
  increaseEndHour() {
    this.endHour = this.endHour >= 23 ? 0 : this.endHour + 1
    this.applyEnd()
    this.clearTip()
  },
  decreaseEndHour() {
    this.endHour = this.endHour <= 0 ? 23 : this.endHour - 1
    this.applyEnd()
    this.clearTip()
  },
  increaseEndMin() {
    this.shiftEndMin(MIN_STEP)
    this.applyEnd()
    this.clearTip()
  },
  decreaseEndMin() {
    this.shiftEndMin(-MIN_STEP)
    this.applyEnd()
    this.clearTip()
  },

  shiftStartMin(delta) {
    var total = this.startHour * 60 + this.startMin + delta
    if (total < 0) { total = 1440 + total }
    if (total > 1439) { total = total - 1440 }
    this.startHour = Math.floor(total / 60)
    this.startMin = total % 60
  },

  shiftEndMin(delta) {
    var total = this.endHour * 60 + this.endMin + delta
    if (total < 0) { total = 1440 + total }
    if (total > 1439) { total = total - 1440 }
    this.endHour = Math.floor(total / 60)
    this.endMin = total % 60
  },

  // 开始时间变化后：结束必须晚于开始，不足则自动给 45 分钟（原默认课时）
  adjustEndTime() {
    var s = this.startHour * 60 + this.startMin
    var e = this.endHour * 60 + this.endMin
    if (e <= s) {
      e = s + 45
      if (e > 1439) { e = 1439 }
    }
    this.endHour = Math.floor(e / 60)
    this.endMin = e % 60
    this.updateTimeString()
  },

  // 结束时间自身调整：只保证严格大于开始（最少 5 分钟），不做 45 分钟跳变
  applyEnd() {
    var s = this.startHour * 60 + this.startMin
    var e = this.endHour * 60 + this.endMin
    if (e <= s) {
      e = s + MIN_STEP
      if (e > 1439) { e = 1439 }
    }
    this.endHour = Math.floor(e / 60)
    this.endMin = e % 60
    this.updateTimeString()
  },

  updateTimeString() {
    this.courseTime = padZero(this.startHour) + ":" + padZero(this.startMin) + " - " + padZero(this.endHour) + ":" + padZero(this.endMin)
  },

  selectDay(idx) {
    this.dayIndex = idx
    this.day = DAY_NAMES[idx]
    this.scrollToCurrentDay()
    this.clearTip()
  },

  // 自动滚动到当前选中的星期：模板排列是「一二三四五六日」，dayIndex 0=周日排在末尾，
  // 168px 内容宽仅能看到约 3 个按钮，若不滚动用户看不到已选的周日，需二次滑动。
  // 与编辑课程页(detail.ux)的 scrollToCurrentDay 保持一致：属性先行 + $element.scrollTo 兜底。
  scrollToCurrentDay() {
    var order = [1, 2, 3, 4, 5, 6, 0]
    var pos = order.indexOf(this.dayIndex)
    if (pos < 0) { pos = 0 }
    var left = pos * 49 // 每项 44px 宽 + 左右 margin 2px + 间距
    this.weekdayScrollLeft = left
    var self = this
    // 部分运行时不响应 scroll-left 属性，用组件方法兜底（不支持时静默跳过）
    setTimeout(function() {
      try {
        var el = self.$element("weekdayScroll")
        if (el && typeof el.scrollTo === "function") {
          el.scrollTo({ left: left })
        }
      } catch (e) {}
    }, 80)
  },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "输入位置" })
    storage.set({ key: "chinese_input_placeholder", value: "点击输入位置, 例如: 301教室" })
    storage.set({ key: "chinese_input_value", value: this.courseLocation || "" })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  goBack() {
    router.back()
  },

  saveCourse() {
    if (this.isSaving) { return }
    if (!this.courseName) { this.showTip("请选课程"); return }
    if (!this.courseTime) { this.showTip("请设时间"); return }
    if (!this.day) {
      this.dayIndex = new Date().getDay()
      this.day = DAY_NAMES[this.dayIndex]
      this.setDefaultDay()
    }

    var self = this
    var newCourse = {
      id: String(this.nextId),
      day: this.day,
      name: this.courseName,
      time: this.courseTime,
      location: this.courseLocation || "",
      notes: ""
    }
    // 时间冲突检测：同天已有课程时间重叠时，先提示，需再次确认才保存
    database.checkDayConflict(this.day, newCourse, null, function(conflict) {
      if (conflict && !self.conflictConfirmed) {
        self.showTip("时间重叠", "#ff6b6b")
        self.saveLabel = "确认"
        self.conflictConfirmed = true
        return
      }
      self.conflictConfirmed = false
      self.saveLabel = "添加"
      self.doInsert(newCourse)
    })
  },

  doInsert(newCourse) {
    this.isSaving = true
    var self = this
    this.nextId++
    var storage = require("@system.storage")
    storage.set({ key: "add_course_nextId", value: String(this.nextId) })
    database.insertCourse(newCourse, function(err) {
      if (!err) {
        self.tipText = ""
        router.back()
      } else {
        self.isSaving = false
        self.showTip("保存失败", "#ff6b6b")
      }
    })
  }
}
</script>

<style>
@import '../../common/header.css';
/* ================================================================
   ev-six 六位开发准则（v5）落地
   容器：192 − 12×2 = 168px 页面级；卡片内 168 − 8×2 = 152px
   字号：只有 24 / 28 两档（44/30 本页无用途），无 12~23px
   行高：24→34、28→38（比例 1.36~1.42）
   留白：横向几乎不动，呼吸感只在纵向买
   ================================================================ */

.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 32px 12px 16px 12px;
}

.content-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
  padding-bottom: 6px;
}

.header-title {
  font-size: 28px;
  line-height: 38px;
}

/* 区块标题：4 字 @28 = 149px ≤ 168px。原来 20px 属禁用档，且右侧挂「管理」按钮
 * 会把标题压到 96px 内（4 字必裁）——按钮已删，+ 卡是同一入口。 */
.section-title {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  flex-shrink: 0;
  margin: 0 0 6px 0;
}

/* 课程横滑：88px 卡 + 28px 字（2 字 = 75px ≤ 88px）。
 * 原 120px 卡一屏只见 1.35 个，现见 1.8 个，且选中态改用底色不用边框。 */
.course-scroll {
  flex-direction: row;
  width: 100%;
  flex-shrink: 0;
  height: 52px;
  margin-bottom: 10px;
}

.course-item {
  width: 88px;
  height: 52px;
  border-radius: 12px;
  margin-right: 6px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.course-add-item {
  width: 56px;
}

.course-name {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.course-add-icon {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  text-align: center;
}

/* 时间卡：卡头 24px + 时/分两列（列宽 74px：34+34 按钮 + 6 间隙）
 * 值「08时」= 2.1P @24 ≈ 67px ≤ 74px，不裁 */
.time-card {
  width: 100%;
  flex-direction: column;
  border-radius: 14px;
  padding: 6px 8px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.time-head {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  margin-bottom: 2px;
}

.time-grid {
  flex-direction: row;
  width: 100%;
  justify-content: space-between;
}

.time-col {
  width: 70px;
  flex-direction: column;
  align-items: center;
}

.time-val {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  text-align: center;
}

.step-pair {
  flex-direction: row;
  width: 70px;
  justify-content: space-between;
}

.step-btn {
  width: 32px;
  height: 44px;
  border-radius: 12px;
  font-size: 24px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  border: none;
}

/* 位置输入：border 不写（quickapp 单位写 border 会被渲染成四边，且禁装饰边框） */
.input-box {
  width: 100%;
  height: 48px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  padding: 0 8px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.input-text {
  font-size: 24px;
  line-height: 34px;
}

.input-placeholder {
  font-size: 24px;
  line-height: 34px;
}

/* 星期：7 个 44px 按钮横滑，一屏可见 3.7 个；选中项自动滚入视野 */
.weekday-scroll {
  width: 100%;
  height: 44px;
  flex-shrink: 0;
}

.weekday-row {
  flex-direction: row;
}

.weekday-btn {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-right: 5px;
  flex-shrink: 0;
}

.weekday-text {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  text-align: center;
}

/* 页内状态条：高度固定 34px，只换颜色不换高度（ev-six 第 13 条） */
.tip-row {
  width: 100%;
  height: 34px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

/* 底部：取消 74px 定宽（「取消」@24 = 64）+ 添加 flex（「添加」@28 = 75 ≤ 88） */
.bottom-bar {
  flex-direction: row;
  width: 100%;
  align-items: center;
  flex-shrink: 0;
  margin-top: 6px;
}

.cancel-btn {
  width: 74px;
  height: 44px;
  border-radius: 12px;
  font-size: 24px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  border: none;
  flex-shrink: 0;
}

.save-btn {
  flex: 1;
  height: 44px;
  border-radius: 12px;
  font-size: 28px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  border: none;
  margin-left: 6px;
}

/* ================================================================
   大屏断点：只改物理必须区分的值，不覆盖 base 的字号档位
   ================================================================ */
@media (width >= 200px) {
  .course-item { width: 96px; }
  .time-col { width: 78px; }
  .step-pair { width: 78px; }
  .step-btn { width: 36px; }
  .weekday-btn { width: 48px; height: 48px; }
  .weekday-scroll { height: 48px; }
  .cancel-btn { width: 80px; }
}

@media (width >= 400px) {
  .page { padding: 40px 20px 20px 20px; }
  .section-title { font-size: 30px; line-height: 40px; margin-bottom: 10px; }
  .course-scroll { height: 64px; }
  .course-item { width: 120px; height: 64px; margin-right: 10px; }
  .course-name { font-size: 30px; line-height: 40px; }
  .time-card { padding: 14px; margin-bottom: 14px; }
  .time-head { font-size: 30px; line-height: 40px; }
  .time-col { width: 150px; }
  .step-pair { width: 150px; }
  .time-val { font-size: 30px; line-height: 40px; }
  .step-btn { width: 56px; height: 52px; line-height: 52px; font-size: 30px; }
  .input-box { height: 56px; }
  .input-text { font-size: 30px; line-height: 40px; }
  .input-placeholder { font-size: 30px; line-height: 40px; }
  .weekday-btn { width: 56px; height: 56px; }
  .weekday-scroll { height: 56px; }
  .weekday-text { font-size: 30px; line-height: 40px; }
  .tip-text { font-size: 30px; line-height: 40px; }
  .tip-row { height: 40px; }
  .cancel-btn { width: 140px; height: 56px; line-height: 56px; font-size: 30px; }
  .save-btn { height: 56px; line-height: 56px; font-size: 30px; }
}
</style>
