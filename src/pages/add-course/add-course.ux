<template>
  <div class="add-course-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">添加课程</text>
    </div>

    <div class="step-indicator">
      <text class="step-dot {{ step >= 1 ? 'active' : '' }}" style="background-color: {{ step >= 1 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 2 ? 'active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 2 ? 'active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 3 ? 'active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 3 ? 'active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 4 ? 'active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 4 ? 'active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></text>
    </div>

    <div class="form-section" if="{{ step === 1 }}">
      <text class="step-title" style="color: {{ theme.text }}">选择</text>
      <text class="step-hint" style="color: {{ theme.textSecondary }}">{{ presetCourses.length }}门</text>

      <div class="swiper-wrapper">
        <input class="swipe-arrow" type="button" value="◀" onclick="swipePrev" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <div class="course-card" onclick="swipeNext" style="background-color: {{ theme.card }}">
          <text class="card-course-name" style="color: {{ theme.text }}">{{ presetCourses[courseIndex].name }}</text>
        </div>
        <input class="swipe-arrow" type="button" value="▶" onclick="swipeNext" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>

      <text class="course-index-hint" style="color: {{ theme.textMuted }}">{{ courseIndex + 1 }} / {{ presetCourses.length }}</text>

      <div class="step-nav">
        <input class="manage-btn" type="button" value="管理" onclick="openCourseManager" style="height: 48px; background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-section" if="{{ step === 2 }}">
      <text class="step-title" style="color: {{ theme.text }}">时间 · {{ courseName }}</text>

      <scroll class="step2-scroll" scroll-y="true">
        <text class="picker-label" style="color: {{ theme.text }}">开始</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ startHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ startMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

        <text class="picker-label" style="color: {{ theme.text }}">结束</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ endHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ endMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>
      </scroll>

      <div class="step-nav">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep" style="height: 48px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-section" if="{{ step === 3 }}">
      <text class="step-title" style="color: {{ theme.text }}">位置</text>
      <text class="step-hint" style="color: {{ theme.textSecondary }}">{{ courseName }} | {{ courseTime }}</text>
      <div class="location-display" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="location-text" style="color: {{ theme.text }}">{{ courseLocation || '如：301教室' }}</text>
        <text class="location-cursor" show="{{ showCursor }}">_</text>
      </div>
      <text class="optional-hint" style="color: {{ theme.textMuted }}">选填</text>
      <div class="step-nav">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep" style="height: 48px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-section" if="{{ step === 4 }}">
      <text class="step-title" style="color: {{ theme.text }}">确认</text>
      <div class="confirm-card" style="background-color: {{ theme.card }}">
        <text class="confirm-label" style="color: {{ theme.accent }}">课程</text>
        <text class="confirm-value" style="color: {{ theme.text }}">{{ courseName }}</text>
        <text class="confirm-label" style="color: {{ theme.accent }}">时间</text>
        <text class="confirm-value" style="color: {{ theme.text }}">{{ courseTime }}</text>
        <text class="confirm-label" style="color: {{ theme.accent }}">位置</text>
        <text class="confirm-value" style="color: {{ theme.text }}">{{ courseLocation || '(无)' }}</text>
      </div>
      <div class="step-nav">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep" style="height: 48px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="save-btn" type="button" value="保存" onclick="saveCourse" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var COURSE_LIST_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "老师", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "老师", location: "" },
  { name: "政治", time: "13:55 - 14:40", teacher: "老师", location: "" },
  { name: "音乐", time: "15:00 - 15:45", teacher: "老师", location: "" },
  { name: "体育", time: "15:55 - 16:40", teacher: "老师", location: "" },
  { name: "美术", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "历史", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "地理", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "生物", time: "10:55 - 11:40", teacher: "老师", location: "" }
]

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  if (!timeStr) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

export default {
  private: {
    courseName: "",
    courseTime: "",
    courseLocation: "",
    courseTeacher: "",
    day: "",
    nextId: 100,
    isSaving: false,
    step: 1,
    courseIndex: 0,
    presetCourses: [],
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    titleStyle: "",
    labelStyle: "",
    hintStyle: "",
    inputStyle: "",
    inputHeight: 80,
    btnStyle: "",
    btnHeight: 72,
    pickerValueStyle: "",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(' - ')[0] : '00:00'
      var tb = b.time ? b.time.split(' - ')[0] : '00:00'
      var taParts = ta.split(':')
      var tbParts = tb.split(':')
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getFontSizes(function(sizes) {
      self.applyFontSizes(sizes)
    })
    this.applyFontSizes({title: 36, label: 34, hint: 28, input: 34, inputHeight: 80, btn: 28, btnHeight: 72, pickerValue: 40})

    this.loadCourses()

    var storage = require("@system.storage")
    storage.get({
      key: "add_course_day",
      success: function(val) {
        self.day = val || ""
        if (!self.day) { self.setDefaultDay() }
      },
      fail: function() {
        self.day = ""
        self.setDefaultDay()
      }
    })
    storage.get({
      key: "add_course_nextId",
      success: function(val) {
        self.nextId = parseInt(val) || 100
      },
      fail: function() {
        self.nextId = 100
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.refreshCourseList()

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.courseLocation = data
          storage.delete({
            key: "chinese_input_result",
            fail: function() {}
          })
        }
      },
      fail: function() {}
    })
  },

  refreshCourseList() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            }
          } catch (e) {
              // keep existing list
          }
        }
      },
      fail: function() {}
    })
  },

  setDefaultDay() {
    var dayNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
    var now = new Date()
    this.day = dayNames[now.getDay()]
  },

  applyFontSizes(s) {
    this.titleStyle = "font-size: " + s.title + "px"
    this.labelStyle = "font-size: " + s.label + "px"
    this.hintStyle = "font-size: " + s.hint + "px"
    this.inputStyle = "font-size: " + s.input + "px"
    this.inputHeight = s.inputHeight
    this.btnStyle = "font-size: " + s.btn + "px"
    this.btnHeight = s.btnHeight
    this.pickerValueStyle = "font-size: " + s.pickerValue + "px"
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            } else {
              self.presetCourses = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.presetCourses = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.presetCourses = self.sortByTime(defaultCourses.slice())
        }
        self.selectCourse(self.courseIndex)
      },
      fail: function() {
        self.presetCourses = self.sortByTime(defaultCourses.slice())
        self.selectCourse(self.courseIndex)
      }
    })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  padZero(n) {
    return padZero(n)
  },

  selectCourse(index) {
    if (this.presetCourses.length === 0) {
      this.courseName = ""
      this.courseTime = ""
      return
    }
    if (index < 0 || index >= this.presetCourses.length) {
      index = 0
    }
    this.courseIndex = index
    var c = this.presetCourses[index]
    this.courseName = c.name
    this.courseTeacher = c.teacher
    this.courseLocation = c.location
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
  },

  swipePrev() {
    if (this.courseIndex > 0) {
      this.selectCourse(this.courseIndex - 1)
    }
  },

  swipeNext() {
    if (this.courseIndex < this.presetCourses.length - 1) {
      this.selectCourse(this.courseIndex + 1)
    }
  },

  updateTimeString() {
    this.courseTime = padZero(this.startHour) + ":" + padZero(this.startMin) + " - " + padZero(this.endHour) + ":" + padZero(this.endMin)
  },

  increaseStartHour() {
    if (this.startHour < 23) {
      this.startHour++
    } else {
      this.startHour = 0
    }
    this.updateTimeString()
  },
  decreaseStartHour() {
    if (this.startHour > 0) {
      this.startHour--
    } else {
      this.startHour = 23
    }
    this.updateTimeString()
  },
  increaseStartMin() {
    if (this.startMin < 59) {
      this.startMin++
    } else {
      this.startMin = 0
    }
    this.updateTimeString()
  },
  decreaseStartMin() {
    if (this.startMin > 0) {
      this.startMin--
    } else {
      this.startMin = 59
    }
    this.updateTimeString()
  },
  increaseEndHour() {
    if (this.endHour < 23) {
      this.endHour++
    } else {
      this.endHour = 0
    }
    this.updateTimeString()
  },
  decreaseEndHour() {
    if (this.endHour > 0) {
      this.endHour--
    } else {
      this.endHour = 23
    }
    this.updateTimeString()
  },
  increaseEndMin() {
    if (this.endMin < 59) {
      this.endMin++
    } else {
      this.endMin = 0
    }
    this.updateTimeString()
  },
  decreaseEndMin() {
    if (this.endMin > 0) {
      this.endMin--
    } else {
      this.endMin = 59
    }
    this.updateTimeString()
  },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "输入位置" })
    storage.set({ key: "chinese_input_placeholder", value: "点击输入位置, 例如: 301教室" })
    storage.set({ key: "chinese_input_value", value: this.courseLocation || "" })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  nextStep() {
    if (this.step < 4) {
      this.step = this.step + 1
    }
  },

  prevStep() {
    if (this.step > 1) {
      this.step = this.step - 1
    }
  },

  goBack() {
    router.back()
  },

  saveCourse() {
    if (this.isSaving) {
      return
    }
    if (!this.courseName) {
      prompt.showToast({ message: "请先选择课程" })
      return
    }
    if (!this.courseTime) {
      prompt.showToast({ message: "请先设置时间" })
      return
    }
    if (!this.day) {
      this.setDefaultDay()
    }
    this.isSaving = true
    var self = this
    var newCourse = {
      id: String(this.nextId),
      day: this.day,
      name: this.courseName,
      time: this.courseTime,
      teacher: this.courseTeacher || "TBD",
      location: this.courseLocation || "",
      notes: ""
    }
    this.nextId++
    var storage = require("@system.storage")
    storage.set({
      key: "add_course_nextId",
      value: String(this.nextId)
    })
    database.insertCourse(newCourse, function(err) {
      if (!err) {
        prompt.showToast({ message: "课程已添加" })
        router.back()
      } else {
        self.isSaving = false
        prompt.showToast({ message: "保存失败，请重试" })
      }
    })
  }
}
</script>

<style>
.add-course-page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
}

.back-btn {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  font-size: 28px;
  text-align: center;
}

.title {
  font-size: 36px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  margin-right: 64px;
}

.step-indicator {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.step-dot {
  width: 20px;
  height: 20px;
  border-radius: 10px;
}

.step-line {
  width: 40px;
  height: 4px;
  margin: 0 4px;
}

.form-section {
  flex-direction: column;
  flex: 1;
}

.step-title {
  font-size: 34px;
  line-height: 44px;
  font-weight: bold;
  margin-bottom: 8px;
  text-align: center;
}

.step-hint {
  font-size: 28px;
  margin-bottom: 14px;
  text-align: center;
}

.swiper-wrapper {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.swipe-arrow {
  width: 50px;
  height: 50px;
  border-radius: 25px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
}

.course-card {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  padding: 24px;
  margin: 0 12px;
  border: 3px solid #7ec8e3;
  width: 200px;
  height: 120px;
}

.card-course-name {
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

.stepper-time {
  flex-direction: column;
  align-items: center;
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 10px;
}

.step2-scroll {
  flex: 1;
  flex-direction: column;
}

.picker-label {
  font-size: 32px;
  font-weight: bold;
  margin-top: 10px;
  margin-bottom: 8px;
  text-align: center;
}

.stepper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.stepper-label {
  font-size: 28px;
  width: 60px;
}

.stepper-btn {
  width: 48px;
  height: 40px;
  border-radius: 10px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
}

.stepper-val {
  font-size: 40px;
  font-weight: bold;
  width: 60px;
  text-align: center;
}

.optional-hint {
  font-size: 24px;
  margin-bottom: 14px;
  text-align: center;
}

.location-display {
  width: 100%;
  height: 56px;
  border-radius: 12px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  padding: 0 14px;
  margin-bottom: 8px;
}

.location-text {
  font-size: 32px;
}

.location-cursor {
  font-size: 32px;
  margin-left: 2px;
}

.step-nav {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16px;
}

.prev-btn {
  width: 120px;
  border-radius: 12px;
  font-size: 28px;
  line-height: 48px;
  font-weight: bold;
  text-align: center;
}

