<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">添加课程</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="content-scroll" scroll-y="true">
      <div class="section">
        <div class="section-title-row">
          <text class="section-title" style="color: {{ theme.text }}">选择课程</text>
          <input class="mgmt-btn" type="button" value="管理" onclick="openCourseManager"
                 style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        </div>
        <scroll class="course-scroll" scroll-x="true">
          <div class="course-item {{ courseIndex === idx ? 'course-item-selected' : '' }}"
               for="{{ (idx, c) in presetCourses }}"
               onclick="selectCourseByIdx(idx)"
               style="background-color: {{ theme.card }}">
            <text class="course-name" style="color: {{ theme.text }}">{{ c.name }}</text>
          </div>
          <div class="course-item course-add-item" onclick="openCourseManager"
               style="background-color: {{ theme.cardLight }}">
            <text class="course-add-icon" style="color: {{ theme.accent }}">+</text>
          </div>
        </scroll>
      </div>

      <div class="section">
        <text class="section-title" style="color: {{ theme.text }}">上课时间</text>
        <text class="picker-label" style="color: {{ theme.text }}">开始</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ padZero(startHour) }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ padZero(startMin) }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

        <text class="picker-label" style="color: {{ theme.text }}">结束</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ padZero(endHour) }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ padZero(endMin) }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>
      </div>

      <div class="section">
        <text class="section-title" style="color: {{ theme.text }}">上课位置</text>
        <div class="input-box" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
          <text class="input-text {{ courseLocation ? '' : 'input-placeholder' }}"
                style="color: {{ courseLocation ? theme.text : theme.textMuted }}">
            {{ courseLocation || '点击输入位置' }}
          </text>
        </div>
      </div>

      <div class="weekday-section">
        <text class="section-title" style="color: {{ theme.text }}">星期</text>
        <scroll scroll-x="true" class="weekday-scroll" id="weekdayScroll" scroll-left="{{ weekdayScrollLeft }}">
          <div class="weekday-row">
            <div class="weekday-btn {{ dayIndex === 1 ? 'weekday-btn-active' : '' }}"
                 onclick="selectDay(1)"
                 style="background-color: {{ dayIndex === 1 ? theme.accent : theme.card }}">
              <text class="weekday-text" style="color: {{ dayIndex === 1 ? theme.bg : theme.text }}">一</text>
            </div>
            <div class="weekday-btn {{ dayIndex === 2 ? 'weekday-btn-active' : '' }}"
                 onclick="selectDay(2)"
                 style="background-color: {{ dayIndex === 2 ? theme.accent : theme.card }}">
              <text class="weekday-text" style="color: {{ dayIndex === 2 ? theme.bg : theme.text }}">二</text>
            </div>
            <div class="weekday-btn {{ dayIndex === 3 ? 'weekday-btn-active' : '' }}"
                 onclick="selectDay(3)"
                 style="background-color: {{ dayIndex === 3 ? theme.accent : theme.card }}">
              <text class="weekday-text" style="color: {{ dayIndex === 3 ? theme.bg : theme.text }}">三</text>
            </div>
            <div class="weekday-btn {{ dayIndex === 4 ? 'weekday-btn-active' : '' }}"
                 onclick="selectDay(4)"
                 style="background-color: {{ dayIndex === 4 ? theme.accent : theme.card }}">
              <text class="weekday-text" style="color: {{ dayIndex === 4 ? theme.bg : theme.text }}">四</text>
            </div>
            <div class="weekday-btn {{ dayIndex === 5 ? 'weekday-btn-active' : '' }}"
                 onclick="selectDay(5)"
                 style="background-color: {{ dayIndex === 5 ? theme.accent : theme.card }}">
              <text class="weekday-text" style="color: {{ dayIndex === 5 ? theme.bg : theme.text }}">五</text>
            </div>
            <div class="weekday-btn {{ dayIndex === 6 ? 'weekday-btn-active' : '' }}"
                 onclick="selectDay(6)"
                 style="background-color: {{ dayIndex === 6 ? theme.accent : theme.card }}">
              <text class="weekday-text" style="color: {{ dayIndex === 6 ? theme.bg : theme.text }}">六</text>
            </div>
            <div class="weekday-btn {{ dayIndex === 0 ? 'weekday-btn-active' : '' }}"
                 onclick="selectDay(0)"
                 style="background-color: {{ dayIndex === 0 ? theme.accent : theme.card }}">
              <text class="weekday-text" style="color: {{ dayIndex === 0 ? theme.bg : theme.text }}">日</text>
            </div>
          </div>
        </scroll>
      </div>
    </scroll>

    <div class="bottom-bar">
      <input class="cancel-btn" type="button" value="取消" onclick="goBack"
             style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      <input class="save-btn" type="button" value="确认添加" onclick="saveCourse"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
var store = require("../../data/store.js")
var database = require("../../data/database.js")

var COURSE_LIST_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "", location: "" },
  { name: "生物", time: "13:55 - 14:40", teacher: "", location: "" },
  { name: "历史", time: "15:00 - 15:45", teacher: "", location: "" },
  { name: "地理", time: "15:55 - 16:40", teacher: "", location: "" },
  { name: "政治", time: "08:00 - 08:45", teacher: "", location: "" },
  { name: "音乐", time: "08:55 - 09:40", teacher: "", location: "" },
  { name: "美术", time: "10:00 - 10:45", teacher: "", location: "" },
  { name: "体育", time: "10:55 - 11:40", teacher: "", location: "" }
]

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  if (!timeStr) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

export default {
  private: {
    courseName: "",
    courseTime: "",
    courseLocation: "",
    courseIndex: 0,
    presetCourses: [],
    iconTheme: "dark",
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    dayIndex: 1,
    weekdayScrollLeft: 0,
    day: "",
    nextId: 100,
    isSaving: false,
    conflictConfirmed: false,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0"
    }
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(" - ")[0] : "00:00"
      var tb = b.time ? b.time.split(" - ")[0] : "00:00"
      var taParts = ta.split(":")
      var tbParts = tb.split(":")
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadCourses()
    this.setDefaultDay()
    var storage = require("@system.storage")
    storage.get({
      key: "add_course_nextId",
      success: function(val) {
        self.nextId = parseInt(val) || 100
      },
      fail: function() {
        self.nextId = 100
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.refreshCourseList()
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.courseLocation = data
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  refreshCourseList() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            }
          } catch (e) {}
        }
      },
      fail: function() {}
    })
  },

  setDefaultDay() {
    var self = this
    var storage = require("@system.storage")
    // 优先使用首页传入的星期：用户在首页翻到某一天后再点"添加课程"，
    // 表单应默认停在那一天，而不是永远停在今天。
    storage.get({
      key: "add_course_day",
      success: function(val) {
        var idx = -1
        if (val !== undefined && val !== null && val !== "") {
          idx = DAY_NAMES.indexOf(val)
        }
        if (idx < 0) idx = new Date().getDay()
        self.dayIndex = idx
        self.day = DAY_NAMES[idx]
        storage.delete({ key: "add_course_day", fail: function() {} })
        self.scrollToCurrentDay()
      },
      fail: function() {
        var idx = new Date().getDay()
        self.dayIndex = idx
        self.day = DAY_NAMES[idx]
        self.scrollToCurrentDay()
      }
    })
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          try {
            var list = JSON.parse(data)
            if (Array.isArray(list)) {
              self.presetCourses = self.sortByTime(list)
            } else {
              self.presetCourses = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.presetCourses = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.presetCourses = self.sortByTime(defaultCourses.slice())
        }
        self.selectCourse(self.courseIndex)
      },
      fail: function() {
        self.presetCourses = self.sortByTime(defaultCourses.slice())
        self.selectCourse(self.courseIndex)
      }
    })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  padZero(n) {
    return padZero(n)
  },

  selectCourseByIdx(idx) {
    this.courseIndex = idx
    var c = this.presetCourses[idx]
    this.courseName = c.name
    this.courseLocation = c.location || ""
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
  },

  selectCourse(index) {
    if (this.presetCourses.length === 0) {
      this.courseName = ""
      this.courseTime = ""
      return
    }
    if (index < 0 || index >= this.presetCourses.length) {
      index = 0
    }
    this.courseIndex = index
    var c = this.presetCourses[index]
    this.courseName = c.name
    this.courseLocation = c.location
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
  },

  // 时间步进：与编辑页（detail.ux）完全一致，改完立即回写 courseTime
  increaseStartHour() {
    if (this.startHour < 23) { this.startHour = this.startHour + 1 }
    else { this.startHour = 0 }
    this.adjustEndTime()
  },
  decreaseStartHour() {
    if (this.startHour > 0) { this.startHour = this.startHour - 1 }
    else { this.startHour = 23 }
    this.adjustEndTime()
  },
  increaseStartMin() {
    if (this.startMin < 59) { this.startMin = this.startMin + 1 }
    else { this.startMin = 0 }
    this.adjustEndTime()
  },
  decreaseStartMin() {
    if (this.startMin > 0) { this.startMin = this.startMin - 1 }
    else { this.startMin = 59 }
    this.adjustEndTime()
  },
  increaseEndHour() {
    if (this.endHour < 23) { this.endHour = this.endHour + 1 }
    else { this.endHour = 0 }
    this.adjustEndTime()
  },
  decreaseEndHour() {
    if (this.endHour > 0) { this.endHour = this.endHour - 1 }
    else { this.endHour = 23 }
    this.adjustEndTime()
  },
  increaseEndMin() {
    if (this.endMin < 59) { this.endMin = this.endMin + 1 }
    else { this.endMin = 0 }
    this.adjustEndTime()
  },
  decreaseEndMin() {
    if (this.endMin > 0) { this.endMin = this.endMin - 1 }
    else { this.endMin = 59 }
    this.adjustEndTime()
  },

  adjustEndTime() {
    var startTotal = this.startHour * 60 + this.startMin
    var endTotal = this.endHour * 60 + this.endMin
    if (endTotal <= startTotal) {
      endTotal = startTotal + 45
      if (endTotal >= 1440) { endTotal = 1439 }
      this.endHour = Math.floor(endTotal / 60)
      this.endMin = endTotal % 60
    }
    this.updateTimeString()
  },

  updateTimeString() {
    this.courseTime = padZero(this.startHour) + ":" + padZero(this.startMin) + " - " + padZero(this.endHour) + ":" + padZero(this.endMin)
  },

  selectDay(idx) {
    this.dayIndex = idx
    this.day = DAY_NAMES[idx]
    this.scrollToCurrentDay()
  },

  // 自动滚动到当前选中的星期：模板排列是「一二三四五六日」，dayIndex 0=周日排在末尾，
  // 胶囊屏 160px 仅能看到约 3 个按钮，若不滚动用户看不到已选的周日，需二次滑动。
  // 与编辑课程页(detail.ux)的 scrollToCurrentDay 保持一致：属性先行 + $element.scrollTo 兜底。
  scrollToCurrentDay() {
    var order = [1, 2, 3, 4, 5, 6, 0]
    var pos = order.indexOf(this.dayIndex)
    if (pos < 0) { pos = 0 }
    var left = pos * 52 // 每项 48px 宽 + 左右 margin 约 4px
    this.weekdayScrollLeft = left
    var self = this
    // 部分运行时不响应 scroll-left 属性，用组件方法兜底（不支持时静默跳过）
    setTimeout(function() {
      try {
        var el = self.$element("weekdayScroll")
        if (el && typeof el.scrollTo === "function") {
          el.scrollTo({ left: left })
        }
      } catch (e) {}
    }, 80)
  },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "输入位置" })
    storage.set({ key: "chinese_input_placeholder", value: "点击输入位置, 例如: 301教室" })
    storage.set({ key: "chinese_input_value", value: this.courseLocation || "" })
    storage.set({ key: "chinese_input_maxlen", value: "10" })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result" })
    router.push({ uri: "/pages/chinese-input" })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  goBack() {
    router.back()
  },

  saveCourse() {
    if (this.isSaving) { return }
    if (!this.courseName) { prompt.showToast({ message: "请先选择课程" }); return }
    if (!this.courseTime) { prompt.showToast({ message: "请先设置时间" }); return }
    if (!this.day) { this.setDefaultDay() }

    var self = this
    var newCourse = {
      id: String(this.nextId),
      day: this.day,
      name: this.courseName,
      time: this.courseTime,
      location: this.courseLocation || "",
      notes: ""
    }
    // 时间冲突检测：同天已有课程时间重叠时，先提示，需再次确认才保存
    database.checkDayConflict(this.day, newCourse, null, function(conflict) {
      if (conflict && !self.conflictConfirmed) {
        prompt.showToast({ message: "时间冲突：与《" + conflict.name + "》" + conflict.time + " 重叠，再点确认添加" })
        self.conflictConfirmed = true
        return
      }
      self.conflictConfirmed = false
      self.doInsert(newCourse)
    })
  },

  doInsert(newCourse) {
    this.isSaving = true
    var self = this
    this.nextId++
    var storage = require("@system.storage")
    storage.set({ key: "add_course_nextId", value: String(this.nextId) })
    database.insertCourse(newCourse, function(err) {
      if (!err) {
        prompt.showToast({ message: "课程已添加" })
        router.back()
      } else {
        self.isSaving = false
        prompt.showToast({ message: "保存失败，请重试" })
      }
    })
  }
}
</script>

<style>
@import '../../common/header.css';

.page-root {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 30px 16px 12px 16px;
}

.content-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
}

.mgmt-btn {
  width: 60px;
  height: 48px;
  border-radius: 24px;
  font-size: 22px;
  line-height: 48px;
  text-align: center;
  background-color: transparent;
  border: none;
  flex-shrink: 0;
}

.section {
  flex-direction: column;
  margin-bottom: 16px;
  flex-shrink: 0;
}

.section-title-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.section-title {
  font-size: 26px;
  line-height: 36px;
  font-weight: bold;
  max-lines: 1;
  text-overflow: ellipsis;
  flex-shrink: 1;
  margin-right: 8px;
}

.course-scroll {
  flex-direction: row;
  flex-shrink: 0;
  height: 72px;
}

.course-item {
  width: 100px;
  height: 64px;
  border-radius: 14px;
  margin-right: 10px;
  justify-content: center;
  align-items: center;
  border: 2px solid transparent;
  flex-shrink: 0;
}

.course-item-selected {
  border-color: #7ec8e3;
}

.course-name {
  font-size: 26px;
  line-height: 34px;
  font-weight: bold;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.course-add-item {
  justify-content: center;
  align-items: center;
}

.course-add-icon {
  font-size: 40px;
  line-height: 48px;
  font-weight: bold;
  text-align: center;
}

/* 时间步进区：与编辑页（detail.ux）保持同一套结构与数值 */
.picker-label {
  font-size: 30px;
  font-weight: bold;
  line-height: 40px;
  margin-top: 8px;
  margin-bottom: 8px;
  text-align: center;
}

.stepper-time {
  flex-direction: column;
  align-items: center;
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 10px;
}

.stepper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.stepper-label {
  font-size: 28px;
  line-height: 40px;
  width: 60px;
  text-align: center;
}

.stepper-btn {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  font-size: 28px;
