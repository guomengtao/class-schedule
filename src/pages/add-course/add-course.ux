<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="add-course-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="{{ titleStyle }}; color: {{ theme.text }}">添加课程</text>
    </div>

    <div class="step-indicator">
      <text class="step-dot {{ step >= 1 ? 'active' : '' }}" style="background-color: {{ step >= 1 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 2 ? 'active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 2 ? 'active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 3 ? 'active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 3 ? 'active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 4 ? 'active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 4 ? 'active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></text>
    </div>

    <div class="form-section" if="{{ step === 1 }}">
      <text class="step-title" style="{{ labelStyle }}; color: {{ theme.text }}">第1步: 选择课程</text>
      <text class="step-hint" style="{{ hintStyle }}; color: {{ theme.textSecondary }}">滑动选择，共{{ presetCourses.length }}门</text>

      <div class="swiper-wrapper">
        <input class="swipe-arrow" type="button" value="◀" onclick="swipePrev" style="{{ btnStyle }}; background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <div class="course-card" onclick="swipeNext" style="background-color: {{ theme.card }}">
          <text class="card-course-name" style="{{ inputStyle }}; color: {{ theme.text }}">{{ presetCourses[courseIndex].name }}</text>
        </div>
        <input class="swipe-arrow" type="button" value="▶" onclick="swipeNext" style="{{ btnStyle }}; background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>

      <text class="course-index-hint" style="{{ hintStyle }}; color: {{ theme.textMuted }}">{{ courseIndex + 1 }} / {{ presetCourses.length }}</text>

      <div class="step-nav">
        <input class="manage-btn" type="button" value="管理课程" onclick="openCourseManager" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        <input class="next-btn" type="button" value="下一步 ▶" onclick="nextStep" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-section" if="{{ step === 2 }}">
      <text class="step-title" style="{{ labelStyle }}; color: {{ theme.text }}">第2步: 时间</text>
      <text class="step-hint" style="{{ hintStyle }}; color: {{ theme.textSecondary }}">课程: {{ courseName }}</text>

      <scroll class="step2-scroll" scroll-y="true">
        <text class="picker-label" style="{{ labelStyle }}; color: {{ theme.text }}">开始时间</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ startHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ startMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

        <text class="picker-label" style="{{ labelStyle }}; color: {{ theme.text }}">结束时间</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ endHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ endMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>
      </scroll>

      <div class="step-nav">
        <input class="prev-btn" type="button" value="◀ 上一步" onclick="prevStep" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步 ▶" onclick="nextStep" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-section" if="{{ step === 3 }}">
      <text class="step-title" style="{{ labelStyle }}; color: {{ theme.text }}">第3步: 位置</text>
      <text class="step-hint" style="{{ hintStyle }}; color: {{ theme.textSecondary }}">课程: {{ courseName }}  |  时间: {{ courseTime }}</text>
      <div class="location-display" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="location-text" style="color: {{ theme.text }}">{{ courseLocation || '点击输入位置, 例如: 301教室' }}</text>
        <text class="location-cursor" show="{{ showCursor }}">_</text>
      </div>
      <text class="optional-hint" style="{{ hintStyle }}; color: {{ theme.textMuted }}">可以为空</text>
      <div class="step-nav">
        <input class="prev-btn" type="button" value="◀ 上一步" onclick="prevStep" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步 ▶" onclick="nextStep" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <input-method
      hide="{{ hideKeyboard }}"
      keyboardtype="QWERTY"
      maxlength="10"
      vibratemode="short"
      screentype="rect"
      @visibility-change="onVisibilityChange"
      @key-down="onKeyDown"
      @delete="onDelete"
      @complete="onComplete"
    ></input-method>

    <div class="form-section" if="{{ step === 4 }}">
      <text class="step-title" style="{{ labelStyle }}; color: {{ theme.text }}">第4步: 确认</text>
      <div class="confirm-card" style="background-color: {{ theme.card }}">
        <text class="confirm-label" style="{{ labelStyle }}; color: {{ theme.accent }}">课程</text>
        <text class="confirm-value" style="{{ inputStyle }}; color: {{ theme.text }}">{{ courseName }}</text>
        <text class="confirm-label" style="{{ labelStyle }}; color: {{ theme.accent }}">时间</text>
        <text class="confirm-value" style="{{ inputStyle }}; color: {{ theme.text }}">{{ courseTime }}</text>
        <text class="confirm-label" style="{{ labelStyle }}; color: {{ theme.accent }}">位置</text>
        <text class="confirm-value" style="{{ inputStyle }}; color: {{ theme.text }}">{{ courseLocation || '(无)' }}</text>
      </div>
      <div class="step-nav">
        <input class="prev-btn" type="button" value="◀ 上一步" onclick="prevStep" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="save-btn" type="button" value="保存" onclick="saveCourse" style="{{ btnStyle }}; height: {{ btnHeight }}px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var COURSE_LIST_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "老师", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "老师", location: "" },
  { name: "政治", time: "13:55 - 14:40", teacher: "老师", location: "" },
  { name: "音乐", time: "15:00 - 15:45", teacher: "老师", location: "" },
  { name: "体育", time: "15:55 - 16:40", teacher: "老师", location: "" },
  { name: "美术", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "历史", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "地理", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "生物", time: "10:55 - 11:40", teacher: "老师", location: "" }
]

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

export default {
  private: {
    courseName: "",
    courseTime: "",
    courseLocation: "",
    courseTeacher: "",
    day: "",
    nextId: 100,
    step: 1,
    courseIndex: 0,
    presetCourses: [],
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    titleStyle: "",
    labelStyle: "",
    hintStyle: "",
    inputStyle: "",
    inputHeight: 80,
    btnStyle: "",
    btnHeight: 72,
    pickerValueStyle: "",
    theme: {},
    hideKeyboard: true,
    showCursor: false
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(' - ')[0] : '00:00'
      var tb = b.time ? b.time.split(' - ')[0] : '00:00'
      var taParts = ta.split(':')
      var tbParts = tb.split(':')
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getFontScale(function(scale) {
      self.applyFontScale(scale)
    })
    this.applyFontScale(1.0)

    this.loadCourses()

    var storage = require("@system.storage")
    storage.get({
      key: "add_course_day",
      success: function(val) {
        self.day = val || ""
        if (!self.day) { self.setDefaultDay() }
      },
      fail: function() {
        self.day = ""
        self.setDefaultDay()
      }
    })
    storage.get({
      key: "add_course_nextId",
      success: function(val) {
        self.nextId = parseInt(val) || 100
      },
      fail: function() {
        self.nextId = 100
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadCourses()
  },

  setDefaultDay() {
    var dayNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
    var now = new Date()
    this.day = dayNames[now.getDay()]
  },

  applyFontScale(s) {
    if (!s || s < 0.5) { s = 1.0 }
    this.titleStyle = "font-size: " + Math.round(28 * s) + "px"
    this.labelStyle = "font-size: " + Math.round(24 * s) + "px"
    this.hintStyle = "font-size: " + Math.round(20 * s) + "px"
    this.inputStyle = "font-size: " + Math.round(26 * s) + "px"
    this.inputHeight = Math.round(80 * s)
    this.btnStyle = "font-size: " + Math.round(28 * s) + "px"
    this.btnHeight = Math.round(72 * s)
    this.pickerValueStyle = "font-size: " + Math.round(36 * s) + "px"
  },

  loadCourses() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data) {
          try {
            var list = JSON.parse(data)
            if (list && list.length > 0) {
              self.presetCourses = self.sortByTime(list)
            } else {
              self.presetCourses = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.presetCourses = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.presetCourses = self.sortByTime(defaultCourses.slice())
        }
        self.selectCourse(self.courseIndex)
      },
      fail: function() {
        self.presetCourses = self.sortByTime(defaultCourses.slice())
        self.selectCourse(self.courseIndex)
      }
    })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  padZero(n) {
    return padZero(n)
  },

  selectCourse(index) {
    this.courseIndex = index
    var c = this.presetCourses[index]
    this.courseName = c.name
    this.courseTeacher = c.teacher
    this.courseLocation = c.location
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
  },

  swipePrev() {
    if (this.courseIndex > 0) {
      this.selectCourse(this.courseIndex - 1)
    }
  },

  swipeNext() {
    if (this.courseIndex < this.presetCourses.length - 1) {
      this.selectCourse(this.courseIndex + 1)
    }
  },

  updateTimeString() {
    this.courseTime = padZero(this.startHour) + ":" + padZero(this.startMin) + " - " + padZero(this.endHour) + ":" + padZero(this.endMin)
  },

  increaseStartHour() {
    if (this.startHour < 23) {
      this.startHour++
    } else {
      this.startHour = 0
    }
    this.updateTimeString()
  },
  decreaseStartHour() {
    if (this.startHour > 0) {
      this.startHour--
    } else {
      this.startHour = 23
    }
    this.updateTimeString()
  },
  increaseStartMin() {
    if (this.startMin < 59) {
      this.startMin++
    } else {
      this.startMin = 0
    }
    this.updateTimeString()
  },
  decreaseStartMin() {
    if (this.startMin > 0) {
      this.startMin--
    } else {
      this.startMin = 59
    }
    this.updateTimeString()
  },
  increaseEndHour() {
    if (this.endHour < 23) {
      this.endHour++
    } else {
      this.endHour = 0
    }
    this.updateTimeString()
  },
  decreaseEndHour() {
    if (this.endHour > 0) {
      this.endHour--
    } else {
      this.endHour = 23
    }
    this.updateTimeString()
  },
  increaseEndMin() {
    if (this.endMin < 59) {
      this.endMin++
    } else {
      this.endMin = 0
    }
    this.updateTimeString()
  },
  decreaseEndMin() {
    if (this.endMin > 0) {
      this.endMin--
    } else {
      this.endMin = 59
    }
    this.updateTimeString()
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.showCursor = true
  },

  onVisibilityChange(evt) {
    if (evt.detail && evt.detail.visible === false) {
      this.showCursor = false
    }
  },

  onKeyDown(evt) {
    console.log("keyDown:" + JSON.stringify(evt))
  },

  onDelete() {
    this.courseLocation = this.courseLocation.slice(0, -1)
  },

  onComplete(evt) {
    this.courseLocation += evt.detail.content
  },

  nextStep() {
    if (this.step < 4) {
      this.step = this.step + 1
    }
  },

  prevStep() {
    if (!this.hideKeyboard) {
      this.hideKeyboard = true
      this.showCursor = false
      return
    }
    if (this.step > 1) {
      this.step = this.step - 1
    }
  },

  goBack() {
    if (!this.hideKeyboard) {
      this.hideKeyboard = true
      this.showCursor = false
    } else {
      router.back()
    }
  },

  saveCourse() {
    if (!this.courseName || !this.courseTime) {
      return
    }
    var newCourse = {
      id: String(this.nextId),
      day: this.day,
      name: this.courseName,
      time: this.courseTime,
      teacher: this.courseTeacher || "TBD",
      location: this.courseLocation || "",
      notes: ""
    }
    database.insertCourse(newCourse, function() {
      router.back()
    })
  }
}
</script>

<style>
.add-course-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 16px;
  height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16px;
  padding: 12px 0;
}

.back-btn {
  width: 90px;
  height: 50px;
  border-radius: 10px;
  background-color: #16213e;
  font-size: 18px;
  color: #7ec8e3;
  text-align: center;
}

.header-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  margin-left: 12px;
}

.step-indicator {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.step-dot {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  background-color: #333355;
}

.step-dot.active {
  background-color: #7ec8e3;
}

.step-line {
  width: 40px;
  height: 4px;
  background-color: #333355;
  margin: 0 4px;
}

.step-line.active {
  background-color: #7ec8e3;
}

.form-section {
  flex-direction: column;
  flex: 1;
}

.step-title {
  font-size: 24px;
  font-weight: bold;
  color: #7ec8e3;
  margin-bottom: 8px;
  text-align: center;
}

.step-hint {
  font-size: 20px;
  color: #555566;
  margin-bottom: 16px;
  text-align: center;
}

.swiper-wrapper {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.swipe-arrow {
  width: 50px;
  height: 50px;
  border-radius: 25px;
  background-color: #0f3460;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}

.course-card {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #16213e;
  border-radius: 14px;
  padding: 24px;
  margin: 0 12px;
  border: 3px solid #7ec8e3;
  width: 200px;
  height: 120px;
}

.card-course-name {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.card-dots {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 20px;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  background-color: #333355;
  margin: 0 6px;
}

.dot.active {
  background-color: #7ec8e3;
}

.stepper-time {
  flex-direction: column;
  align-items: center;
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 14px;
}

.step2-scroll {
  flex: 1;
  flex-direction: column;
}

.picker-label {
  font-size: 24px;
  font-weight: bold;
  margin-top: 14px;
  margin-bottom: 8px;
  text-align: center;
}

.stepper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}

.stepper-label {
  font-size: 20px;
  width: 60px;
}

.stepper-btn {
  width: 48px;
  height: 40px;
  border-radius: 10px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
}

.stepper-val {
  font-size: 28px;
  font-weight: bold;
  width: 50px;
  text-align: center;
}

.field-input {
  border-radius: 12px;
  background-color: #16213e;
  color: #ffffff;
  padding: 0 16px;
  placeholder-color: #555566;
  margin-bottom: 8px;
}

.optional-hint {
  font-size: 20px;
  color: #555566;
  margin-bottom: 16px;
  text-align: center;
}

.location-display {
  width: 100%;
  height: 48px;
  border-radius: 12px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  padding: 0 14px;
  margin-bottom: 8px;
}

.location-text {
  font-size: 20px;
}

.location-cursor {
  font-size: 20px;
  color: #7ec8e3;
  margin-left: 2px;
}

.step-nav {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16px;
}

.prev-btn {
  width: 120px;
  border-radius: 12px;
  background-color: #333355;
  color: #a0a0b0;
  font-weight: bold;
  text-align: center;
}

.next-btn {
  width: 120px;
  border-radius: 12px;
  background-color: #0f3460;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}

.save-btn {
