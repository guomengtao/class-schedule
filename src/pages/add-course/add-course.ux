<template>
  <div class="edit-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="header-title" style="color: {{ theme.text }}">编辑课程</text>
      <input class="save-btn" type="button" value="保存" onclick="save" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="edit-content">
      <text class="label" style="color: {{ theme.textSecondary }}">课程名称</text>
      <div class="name-display" onclick="openInput" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="name-text" style="color: {{ theme.text }}">{{ courseName || '输入课程名称' }}</text>
      </div>

      <text class="label" style="color: {{ theme.textSecondary }}; margin-top: 12px">授课地点</text>
      <div class="name-display" onclick="openLocationInput" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="name-text" style="color: {{ theme.text }}">{{ courseLocation || '输入上课地点' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
var storage = require("@system.storage")
var store = require("../../data/store.js")
var courses = require("../../data/courses.js")
var schedule = require("../../data/schedule.js")
var templateUtils = require("../../data/template-utils.js")

export default {
  private: {
    courseName: "",
    courseLocation: "",
    courseColor: "#7ec8e3",
    isEdit: false,
    editIndex: -1,
    inputTarget: "name",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    var sid = this.$app && this.$app.$data && this.$app.$data.sid
    if (sid === undefined || sid < 0) {
      this.isEdit = false
      return
    }
    this.isEdit = true
    courses.get(function(list) {
      self.editIndex = -1
      for (var i = 0; i < list.length; i++) {
        if (list[i].sid === sid) {
          self.editIndex = i
          self.courseName = list[i].name || ""
          self.courseLocation = list[i].location || ""
          self.courseColor = list[i].color || "#7ec8e3"
          break
        }
      }
    })
  },

  onShow() {
    var self = this
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          if (self.inputTarget === "name") {
            self.courseName = data
          } else if (self.inputTarget === "location") {
            self.courseLocation = data
          }
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  openInput() {
    this.inputTarget = "name"
    storage.set({
      key: "chinese_input_title",
      value: "课程名称",
      success: function() {}
    })
    storage.set({
      key: "chinese_input_placeholder",
      value: "输入课程名称",
      success: function() {}
    })
    storage.set({
      key: "chinese_input_value",
      value: this.courseName,
      success: function() {}
    })
    storage.set({
      key: "chinese_input_maxlen",
      value: "10",
      success: function() {}
    })
    storage.set({
      key: "chinese_input_return_key",
      value: "chinese_input_result",
      success: function() {
        router.push({ uri: "/pages/chinese-input" })
      }
    })
  },

  openLocationInput() {
    this.inputTarget = "location"
    storage.set({
      key: "chinese_input_title",
      value: "授课地点",
      success: function() {}
    })
    storage.set({
      key: "chinese_input_placeholder",
      value: "输入上课地点",
      success: function() {}
    })
    storage.set({
      key: "chinese_input_value",
      value: this.courseLocation,
      success: function() {}
    })
    storage.set({
      key: "chinese_input_maxlen",
      value: "20",
      success: function() {}
    })
    storage.set({
      key: "chinese_input_return_key",
      value: "chinese_input_result",
      success: function() {
        router.push({ uri: "/pages/chinese-input" })
      }
    })
  },

  save() {
    var name = this.courseName.trim()
    var location = this.courseLocation.trim()
    if (!name) {
      prompt.showToast({ message: "课程名称不能为空" })
      return
    }
    var self = this
    var id = templateUtils.generateId()
    var course = {
      id: id,
      name: name,
      location: location,
      color: this.courseColor
    }
    if (this.isEdit && this.editIndex >= 0) {
      courses.update(this.editIndex, course, function() {
        schedule.updateCourseName(id, name, function() {
          prompt.showToast({ message: "课程已更新" })
          router.back()
        })
      })
    } else {
      courses.add(course, function() {
        prompt.showToast({ message: "课程已添加" })
        router.back()
      })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.edit-page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.back-header {
  flex-direction: row;
  align-items: center;
  height: 48px;
  margin-bottom: 14px;
  padding: 4px 0;
}

.back-btn {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  font-size: 28px;
  text-align: center;
  line-height: 36px;
}

.header-title {
  font-size: 36px;
  font-weight: bold;
  margin-left: 8px;
  flex: 1;
  line-height: 44px;
}

.save-btn {
  width: 56px;
  height: 34px;
  border-radius: 8px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 32px;
}

.edit-content {
  flex-direction: column;
  padding: 10px 4px 0 4px;
}

.label {
  font-size: 24px;
  margin-bottom: 4px;
}

.name-display {
  flex-direction: row;
  align-items: center;
  padding: 12px 16px;
  border-radius: 10px;
  border-width: 2px;
  min-height: 50px;
}

.name-text {
  font-size: 32px;
  flex: 1;
}
</style>