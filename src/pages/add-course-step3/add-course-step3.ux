<template>
  <div class="step-page">
    <text class="step-indicator">Step 3/5</text>
    <text class="step-title">Teacher</text>

    <input class="step-input" type="text" placeholder="Enter teacher name" value="{{ teacher }}" onchange="onTeacherChange" />

    <div class="nav-buttons">
      <input class="nav-btn back-btn" type="button" value="Back" onclick="goPrev" />
      <input class="nav-btn next-btn" type="button" value="Next" onclick="goNext" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  private: {
    teacher: "",
    day: "",
    nextId: 100
  },

  onInit() {
    const params = this.$page.params || {}
    this.day = params.day || ""
    this.nextId = parseInt(params.nextId) || 100
    const course = this.$app.$data.newCourse || {}
    this.teacher = course.teacher || ""
  },

  onTeacherChange(e) {
    this.teacher = e.value || ""
  },

  goPrev() {
    router.back()
  },

  goNext() {
    this.$app.$data.newCourse.teacher = this.teacher || "TBD"
    router.push({
      uri: "/pages/add-course-step4",
      params: {
        day: this.day,
        nextId: this.nextId
      }
    })
  }
}
</script>

