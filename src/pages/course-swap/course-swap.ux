<!-- 临时调课双向选择器（ev-six）
     场景：学生不能带手机，老师在课堂上临时宣布换课，手环上点一下记录。
     只允许已有课程互换；两节课内容互换，格位（日期 + 节次 + 时间）不动。
     2026-11-09 晚改成双滑动选择器：第一行左右滑选周一~周五，候选课程
     同样左右滑切换，当前显示项即待换目标，确认按钮一步提交。
     字号守四档：本页只用 28 / 24，行高 38 / 34；禁符号、禁徽标、禁箭头
     （「左右滑动 2/5」是进度读数，不是装饰符号）。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 页头同步改成设置页同款 .hdr 胶囊（2026-11-09 晚）。本次两条选择器接管了
         left / right 手势，把返回热区从 30×30 扩到整颗胶囊，返回仍一步可达。 -->
    <div class="hdr">
      <div class="hdr-pill" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="hdr-pill-ic" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        <text class="hdr-pill-t" style="color: {{ theme.text }}">调课</text>
      </div>
    </div>

    <!-- 第一行：周几滑动选择器（2026-11-09 晚）。取代原来「今天 / 明天」两颗按钮，
         改成周一~周五五个工作日左右滑动切换，进页默认落在今天对应的工作日。
         整条 onswipe 左滑下一天 / 右滑上一天（到端点循环），两侧小字也可点，
         手势不生效时仍有可用的点击热区。固定在页头之下、不跟随 scroll，
         保留 11-09 上午「第二行看不到」那次修复的成果。
         宽度用固定百分比（32/36/32），不用 flex:1 —— 小屏上曾塌成细条。 -->
    <div class="day-strip" onswipe="onDaySwipe">
      <div class="day-side" onclick="stepDay(-1)">
        <text class="day-side-t" style="color: {{ theme.textMuted }}">{{ prevDayLabel }}</text>
      </div>
      <div class="day-current" style="background-color: {{ theme.accent }}">
        <text class="day-current-t" style="color: {{ theme.bg }}">{{ curDayLabel }}</text>
      </div>
      <div class="day-side" onclick="stepDay(1)">
        <text class="day-side-t" style="color: {{ theme.textMuted }}">{{ nextDayLabel }}</text>
      </div>
    </div>

    <scroll class="scroll-area" scroll-y="true">
      <div class="content-area">
        <div class="card" style="background-color: {{ theme.card }}">
          <text class="card-label" style="color: {{ theme.accent }}">这节课</text>
          <text class="card-value" style="color: {{ theme.text }}">{{ sourceName }}</text>
          <text class="card-sub" style="color: {{ theme.textSecondary }}">{{ sourceWhen }}</text>
        </div>

        <text class="pick-label" style="color: {{ theme.accent }}">{{ pickLabel }}</text>

        <!-- 候选课程同样改成左右滑动选择（2026-11-09 晚）：一屏只显示一节，
             左滑下一节 / 右滑上一节（端点循环），点按整卡也翻下一节作为手势兜底；
             当前显示项即待换目标，底部「确认换课」直接提交它，省掉长列表里逐条点选。
             onswipe 只挂在这条与周几条上；页头、卡片间隙、footer 仍是系统
             右滑返回区，页头另有显式返回按钮。按 pit-20261102-80/81，right
             方向已显式处理，不会留下未接管的死手势。 -->
        <div class="course-strip" if="{{ candidates.length > 0 }}" onclick="pickCourse" onswipe="onCourseSwipe" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
          <div class="course-main">
            <text class="course-period" style="color: {{ theme.textSecondary }}">{{ curCoursePeriod }}</text>
            <text class="course-name" style="color: {{ theme.text }}">{{ curCourseName }}</text>
          </div>
          <text class="course-hint" style="color: {{ theme.textMuted }}">{{ courseHint }}</text>
        </div>

        <text class="empty-hint" if="{{ candidates.length === 0 }}" style="color: {{ theme.textSecondary }}">{{ emptyHint }}</text>
      </div>
    </scroll>

    <div class="footer">
      <input class="confirm-btn" type="button" value="确认换课" onclick="confirmSwap" style="background-color: {{ selectedKey ? theme.accent : theme.card }}; color: {{ selectedKey ? theme.bg : theme.textMuted }}" />
      <input class="clear-btn" if="{{ hasSwap }}" type="button" value="撤销调课" onclick="clearSwaps" style="color: {{ theme.accent }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const courseSwap = require("../../data/course-swap.js")
const scheduleData = require("../../data/schedule.js")
const prompt = require("@system.prompt")
const storage = require("@system.storage")

var CN_CHARS = "一二三四五六"
// 从课程详情跳进来时由 router 参数带过来的上下文；直达页 / 冷启动时为空，
// build() 会用内置课表兜出「这门课」。模块级一份即可，本页同时只会有一个实例。
var CTX = { id: "", date: "", period: "" }

// 与 class-list.js 同一口径：数据里 day 可能是「星期一 / 周一 / 数字」
function dayIndexOf(raw) {
  if (raw === undefined || raw === null) return -1
  var s = String(raw).replace(/\s/g, "")
  if (!s) return -1
  var m = s.match(/^(星期|周|礼拜)([日天一二三四五六七])$/)
  if (m) {
    var ch = m[2]
    if (ch === "日" || ch === "天" || ch === "七") return 0
    return CN_CHARS.indexOf(ch) + 1
  }
  var low = s.toLowerCase()
  var en = { sunday: 0, monday: 1, tuesday: 2, wednesday: 3, thursday: 4, friday: 5, saturday: 6 }
  if (en[low] !== undefined) return en[low]
  if (/^[0-6]$/.test(s)) return parseInt(s)
  if (s === "7") return 0
  return -1
}

function timeOf(t) {
  if (!t) return 0
  var p = String(t).split(":")
  return parseInt(p[0]) * 60 + parseInt(p[1] || 0)
}

export default {
  private: {
    iconTheme: "dark",
    theme: {},
    sourceName: "这门课",
    sourceWhen: "",
    sourceItem: {},
    dayTab: 0,
    dayLabels: ["周一", "周二", "周三", "周四", "周五"],
    prevDayLabel: "",
    curDayLabel: "周一",
    nextDayLabel: "周二",
    candidates: [],
    courseIndex: 0,
    curCourseKey: "",
    curCoursePeriod: "",
    curCourseName: "",
    courseHint: "",
    selectedKey: "",
    pickLabel: "换到这节",
    emptyHint: "这天没有别的课",
    hasSwap: false,
    dateStrs: [],
    allLists: []
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
    })
    // 首帧同步铺内置课表，不读 storage、不等任何回调。
    // pit-20261025-24：onInit 阶段同步发起的 @system.storage 回调在首帧渲染前
    // 不会派发；此前本页把 build() 挂在这条回调链末端，冷启动 / 直达页 / 清空
    // 数据后就永远停在「这天没有别的课」的空态，周几与课程两条滑动条都没数据。
    // 现在首帧必然有五个工作日的候选课程，storage 的成功与否只影响后续刷新。
    this.build(scheduleData.schedule, {}, CTX)
  },

  onShow() {
    // 首帧之后才允许发起 storage 读：拿用户真实课表、已有调课记录与
    // detail_classId 刷新一次。回调即便仍不派发，首帧的内置课表也够用。
    if (this._refined) return
    this._refined = true
    var self = this
    storage.get({
      key: "detail_classId",
      success: function(v) { CTX.id = v || ""; self.loadData(CTX) },
      fail: function() { self.loadData(CTX) }
    })
  },

  loadData(ctx) {
    var self = this
    // 串行而非双回调计数：getAllCourses 在子页面可用（编辑页同款），
    // readAll 自带 fail 兜底；再加一道超时，任何一环不回调也不停在空态。
    database.getAllCourses(function(data) {
      // readAll 现在是同步回调，不会再卡住 build()
      courseSwap.readAll(function(swaps) {
        self.build(data || [], swaps || {}, ctx)
      }, true)
    })
  },

  build(schedule, swaps, ctx) {
    var self = this
    var today = new Date()
    var dow = today.getDay()
    // 周一为一周起点：周日 -6、周六 -5、周一 0、周五 -4。
    // 五个标签固定映射到「今天所在那一周」的周一~周五；dateStr 仍是真实日期，
    // 所以 courseSwap 的存储 / 撤销口径一行都不用改。
    var mondayOffset = (dow === 0) ? -6 : (1 - dow)
    var monday = courseSwap.plusDays(today, mondayOffset)
    var dates = []
    var dateStrs = []
    for (var q = 0; q < 5; q++) {
      var dt = courseSwap.plusDays(monday, q)
      dates.push(dt)
      dateStrs.push(courseSwap.dateStrOf(dt))
    }
    self.dateStrs = dateStrs
    // 默认落在今天对应的工作日；周六 / 周日没有对应标签，回落周一
    var defaultIdx = (dow >= 1 && dow <= 5) ? (dow - 1) : 0

    var lists = []
    for (var d = 0; d < dates.length; d++) {
      var ds = dateStrs[d]
      var weekIdx = dates[d].getDay()
      var raw = []
      for (var i = 0; i < schedule.length; i++) {
        if (dayIndexOf(schedule[i].day) === weekIdx) {
          raw = schedule[i].classes || []
          break
        }
      }
      var overrides = swaps[ds] || {}
      var list = []
      for (var j = 0; j < raw.length; j++) {
        var c = raw[j]
        // 晚课是注入出来的虚拟条目，存储里没有，不能拿来交换
        if (!c || c._rotation) continue
        var ov = overrides[c.id]
        list.push({
          key: ds + "#" + c.id,
          dateStr: ds,
          courseId: String(c.id),
          name: ov ? ov.name : (c.name || ""),
          teacher: ov ? (ov.teacher || "") : (c.teacher || ""),
          location: ov ? (ov.location || "") : (c.location || ""),
          time: c.time || "",
          period: "",
          selected: false
        })
      }
      list.sort(function(a, b) { return timeOf(a.time) - timeOf(b.time) })
      for (var k = 0; k < list.length; k++) {
        list[k].period = "第" + (k + 1) + "节"
      }
      lists.push(list)
    }
    self.allLists = lists
    self.emptyHint = schedule.length === 0 ? "课表读取失败请重试" : "这天没有别的课"

    var src = null
    for (var a = 0; a < lists.length && !src; a++) {
      for (var b = 0; b < lists[a].length; b++) {
        var it = lists[a][b]
        if (it.courseId === String(ctx.id) && (!ctx.date || it.dateStr === ctx.date)) {
          src = it
          break
        }
      }
    }
    if (!src) {
      src = {
        key: dateStrs[defaultIdx] + "#" + ctx.id,
        dateStr: ctx.date || dateStrs[defaultIdx],
        courseId: String(ctx.id),
        name: self.sourceName,
        teacher: "",
        location: "",
        period: ctx.period || ""
      }
    }
    self.sourceItem = src
    self.sourceName = src.name || "这门课"
    var when = "本周"
    for (var w = 0; w < dateStrs.length; w++) {
      if (dateStrs[w] === src.dateStr) { when = self.dayLabels[w]; break }
    }
    self.sourceWhen = when + " " + (src.period || ctx.period || "")

    var has = false
    for (var h = 0; h < dateStrs.length; h++) {
      if (Object.keys(swaps[dateStrs[h]] || {}).length > 0) { has = true; break }
    }
    self.hasSwap = has
    self.setTab(defaultIdx)
  },

  setTab(i) {
    if (i < 0 || i > 4) return
    this.dayTab = i
    this.prevDayLabel = i > 0 ? this.dayLabels[i - 1] : ""
    this.curDayLabel = this.dayLabels[i]
    this.nextDayLabel = i < 4 ? this.dayLabels[i + 1] : ""

    var list = this.allLists[i] || []
    var srcKey = this.sourceItem ? this.sourceItem.key : ""
    var out = []
    for (var k = 0; k < list.length; k++) {
      var it = list[k]
      if (it.key === srcKey) continue
      out.push({ key: it.key, period: it.period, name: it.name })
    }
    this.candidates = out
    this.courseIndex = 0
    this.syncCourseView()
  },

  // 当前预览项即待换目标：滑动 / 点击切换预览，selectedKey 始终跟着它走。
  // 底部「确认换课」直接提交屏幕上那一节，不再需要「先点选再确认」两步。
  syncCourseView() {
    var list = this.candidates || []
    var n = list.length
    if (n === 0) {
      this.curCourseKey = ""
      this.curCoursePeriod = ""
      this.curCourseName = ""
      this.courseHint = ""
      this.selectedKey = ""
      this.pickLabel = "换到这节"
      return
    }
    if (this.courseIndex < 0) this.courseIndex = 0
    if (this.courseIndex >= n) this.courseIndex = n - 1
    var it = list[this.courseIndex]
    this.curCourseKey = it.key
    this.curCoursePeriod = it.period
    this.curCourseName = it.name
    this.courseHint = "左右滑动 " + (this.courseIndex + 1) + "/" + n
    this.selectedKey = it.key
    this.pickLabel = "换到这节"
  },

  // 点击课程卡 = 切到下一节（与左滑等价）。当前显示项本来就是待换目标，
  // 不需要「再点一次选中」；点按同时充当手势不生效时的兜底热区（模拟器验收也走它）。
  pickCourse() {
    this.stepCourse(1)
  },

  onDaySwipe(evt) {
    var dir = (evt && evt.direction) || ""
    if (dir === "left") { this.stepDay(1); return }
    if (dir === "right") { this.stepDay(-1); return }
    // up / down 交回系统滚动。right 已显式接管为「上一天」，不是未处理的死手势；
    // 本页 onswipe 只挂周几条与课程卡，页头 / 空白 / footer 的系统右滑返回仍在，
    // 页头另有整颗可点的胶囊返回按钮。
  },

  stepDay(delta) {
    var n = this.dayLabels.length
    var i = (this.dayTab + delta + n) % n
    this.setTab(i)
  },

  onCourseSwipe(evt) {
    var dir = (evt && evt.direction) || ""
    if (dir === "left") { this.stepCourse(1); return }
    if (dir === "right") { this.stepCourse(-1); return }
  },

  stepCourse(delta) {
    var n = (this.candidates || []).length
    if (n === 0) return
    this.courseIndex = (this.courseIndex + delta + n) % n
    this.syncCourseView()
  },

  findCourse(key) {
    for (var d = 0; d < this.allLists.length; d++) {
      var list = this.allLists[d] || []
      for (var i = 0; i < list.length; i++) {
        if (list[i].key === key) return list[i]
      }
    }
    return null
  },

  confirmSwap() {
    var target = this.findCourse(this.selectedKey)
    var src = this.sourceItem
    if (!target || !src || !src.courseId) {
      prompt.showToast({ message: "先选一节课" })
      return
    }
    if (target.key === src.key) {
      prompt.showToast({ message: "换一节别的课" })
      return
    }
    courseSwap.applySwap({
      a: { date: src.dateStr, courseId: src.courseId, name: src.name, teacher: src.teacher, location: src.location },
      b: { date: target.dateStr, courseId: target.courseId, name: target.name, teacher: target.teacher, location: target.location }
    }, function(ok) {
      if (!ok) {
        prompt.showToast({ message: "保存失败请重试" })
        return
      }
      prompt.showToast({ message: "已调课" })
      router.replace({ uri: "/pages/index" })
    })
  },

  clearSwaps() {
    courseSwap.clearDates(this.dateStrs, function(ok) {
      if (!ok) {
        prompt.showToast({ message: "撤销失败请重试" })
        return
      }
      prompt.showToast({ message: "已撤销调课" })
      router.replace({ uri: "/pages/index" })
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';
/* 页头走 header.css 的 .hdr 胶囊；本页旧的 .header / .back-btn-wrapper /
   .back-btn-icon / .header-title / .header-placeholder 本地同名定义全部下线，
   否则页面后加载会静默盖掉公共样式（统一返回按钮方案 §4）。 */
.page { flex-direction: column; padding: 32px 12px 12px 12px; width: 100%; height: 100%; }
.scroll-area { flex: 1; width: 100%; }
.content-area { flex-direction: column; width: 100%; padding-bottom: 8px; }
.card { flex-direction: column; width: 100%; padding: 10px 8px; border-radius: 14px; margin-bottom: 10px; }
.card-label { font-size: 24px; line-height: 34px; }
.card-value { font-size: 28px; line-height: 38px; font-weight: bold; lines: 1; }
.card-sub { font-size: 24px; line-height: 34px; }
/* 周几滑动条：固定在页头之下、不随内容滚动。32/36/32 固定百分比，不用 flex:1：
 * 小屏上 flex:1 + 无显式高度的行曾渲染成一条细缝，视觉上等于「没有这行」。
 * 宽度账（192 屏，可用 168）：中间 36%≈60px 放 28px×2 字（实宽 54），
 * 两侧 32%≈54px 放 24px×2 字（实宽 46），都不裁字。 */
.day-strip { flex-direction: row; align-items: center; width: 100%; height: 44px; margin-bottom: 8px; flex-shrink: 0; }
.day-side { width: 32%; height: 44px; justify-content: center; align-items: center; flex-shrink: 0; }
.day-side-t { font-size: 24px; line-height: 34px; lines: 1; }
.day-current { width: 36%; height: 44px; border-radius: 22px; justify-content: center; align-items: center; flex-shrink: 0; }
.day-current-t { font-size: 28px; line-height: 38px; font-weight: bold; lines: 1; }
.pick-label { font-size: 24px; line-height: 34px; margin-bottom: 6px; }
/* 课程滑动卡：一屏只放一节，行内「第N节 + 课名」，下一行是进度提示。
   整块挂 onswipe + onclick，border 用 accent 表达「当前即待换目标」。 */
.course-strip { flex-direction: column; width: 100%; padding: 8px 10px; border-radius: 14px; border-width: 2px; margin-bottom: 8px; }
.course-main { flex-direction: row; align-items: center; width: 100%; }
.course-period { font-size: 24px; line-height: 34px; width: 76px; flex-shrink: 0; }
.course-name { flex: 1; font-size: 28px; line-height: 38px; font-weight: bold; lines: 1; }
.course-hint { font-size: 24px; line-height: 34px; text-align: center; width: 100%; }
.empty-hint { font-size: 24px; line-height: 34px; }
.footer { flex-direction: column; width: 100%; padding-top: 6px; }
.confirm-btn { width: 100%; height: 48px; border-radius: 24px; font-size: 28px; font-weight: bold; text-align: center; }
.clear-btn { width: 100%; height: 44px; border-radius: 22px; font-size: 24px; text-align: center; margin-top: 6px; background-color: transparent; }
</style>
