<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">打赏支持</text>
    </div>

    <div class="tab-bar">
      <div class="tab-item {{ currentTab === 0 ? 'active' : '' }}" onclick="switchTab(0)" style="background-color: {{ currentTab === 0 ? '#07C160' : theme.card }}">
        <text class="tab-text" style="color: {{ currentTab === 0 ? theme.text : theme.textSecondary }}">微信</text>
      </div>
      <div class="tab-item {{ currentTab === 1 ? 'active' : '' }}" onclick="switchTab(1)" style="background-color: {{ currentTab === 1 ? '#1677FF' : theme.card }}">
        <text class="tab-text" style="color: {{ currentTab === 1 ? theme.text : theme.textSecondary }}">支付宝</text>
      </div>
      <div class="tab-item {{ currentTab === 2 ? 'active' : '' }}" onclick="switchTab(2)" style="background-color: {{ currentTab === 2 ? '#FF6B35' : theme.card }}">
        <text class="tab-text" style="color: {{ currentTab === 2 ? theme.text : theme.textSecondary }}">爱发电</text>
      </div>
    </div>

    <div class="qr-section">
      <div class="qr-card" style="background-color: {{ theme.card }}">
        <text class="platform-name" style="color: {{ platformColor }}">{{ platformName }}</text>

        <div class="qr-wrapper">
          <qrcode value="{{ qrText }}" style="color: #000000; background-color: #ffffff; width: {{ qrSize }}px; height: {{ qrSize }}px;"></qrcode>
        </div>

        <text class="scan-hint" style="color: {{ theme.textMuted }}">扫码 {{ platformName }}</text>
      </div>
    </div>

    <div class="thanks-section">
      <text class="thanks-icon">♥</text>
      <text class="thanks-text" style="color: {{ theme.textSecondary }}">感谢支持</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const store = require("../../data/store.js")

var WECHAT_URL = "wxp://f2f0i7FYfQ5xBhxQtXDwsQpkyGZLB7UsjrRjsrXn02Qx8NQHjn8WlZEnozT2BURX_JRy"
var ALIPAY_URL = "https://qr.alipay.com/fkx11582syvbdeymczggr3c"
var AFDIAN_URL = "https://ifdian.net/a/peipeijin/plan"

var PLATFORMS = [
  { name: "微信", desc: "微信扫一扫，向我付款", color: "#07C160" },
  { name: "支付宝", desc: "支付宝扫一扫，向我转账", color: "#1677FF" },
  { name: "爱发电", desc: "浏览器扫码，访问我的主页", color: "#FF6B35" }
]

var QR_TEXTS = [WECHAT_URL, ALIPAY_URL, AFDIAN_URL]

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    currentTab: 0,
    qrText: WECHAT_URL,
    qrSize: 140,
    platformName: "微信",
    platformDesc: "微信扫一扫，向我付款",
    platformColor: "#07C160"
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    device.getInfo({
      success: function(data) {
        var shape = data.screenShape || "circle"
        if (shape === "rect") {
          self.qrSize = 130
        } else if (shape === "capsule") {
          self.qrSize = 120
        } else {
          self.qrSize = 160
        }
      },
      fail: function() {
        self.qrSize = 140
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  switchTab(index) {
    this.currentTab = index
    this.qrText = QR_TEXTS[index]
    this.platformName = PLATFORMS[index].name
    this.platformDesc = PLATFORMS[index].desc
    this.platformColor = PLATFORMS[index].color
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 38px 8px 10px 8px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  height: 40px;
  margin-bottom: 8px;
}

.back-btn {
  width: 40px;
  height: 30px;
  border-radius: 15px;
  font-size: 20px;
  text-align: center;
  line-height: 30px;
  flex-shrink: 0;
}

.title {
  font-size: 26px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  margin-right: 40px;
  line-height: 34px;
  lines: 1;
}

.tab-bar {
  flex-direction: row;
  margin-bottom: 10px;
  border-radius: 10px;
}

.tab-item {
  flex: 1;
  height: 38px;
  justify-content: center;
  align-items: center;
  border-radius: 10px;
  margin: 0 2px;
}

.tab-text {
  font-size: 24px;
  font-weight: bold;
  line-height: 32px;
  lines: 1;
}

.qr-section {
  flex-direction: column;
  align-items: center;
  flex: 1;
  justify-content: center;
}

.qr-card {
  flex-direction: column;
  align-items: center;
  border-radius: 14px;
  padding: 16px 14px;
  width: 100%;
}

.platform-name {
  font-size: 32px;
  font-weight: bold;
  margin-bottom: 14px;
  line-height: 40px;
  lines: 1;
}

.qr-wrapper {
  padding: 8px;
  background-color: #ffffff;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.scan-hint {
  font-size: 22px;
  line-height: 30px;
  lines: 1;
}

.thanks-section {
  flex-direction: column;
  align-items: center;
  padding: 12px 0 6px 0;
}

.thanks-icon {
  font-size: 36px;
  margin-bottom: 6px;
  line-height: 44px;
}

.thanks-text {
  font-size: 24px;
  text-align: center;
  line-height: 32px;
  lines: 1;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    height: 44px;
    margin-bottom: 12px;
  }
  .back-btn {
    width: 44px;
    height: 34px;
    font-size: 22px;
    line-height: 34px;
  }
  .title {
    font-size: 28px;
    line-height: 38px;
    margin-right: 44px;
  }
  .tab-item {
    height: 42px;
  }
  .tab-text {
    font-size: 26px;
    line-height: 36px;
  }
  .qr-card {
    padding: 20px 16px;
  }
  .platform-name {
    font-size: 36px;
    line-height: 48px;
  }
  .scan-hint {
    font-size: 24px;
    line-height: 34px;
  }
  .thanks-icon {
    font-size: 40px;
    line-height: 52px;
  }
  .thanks-text {
    font-size: 28px;
    line-height: 38px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 12px 16px 12px;
  }
  .header {
    height: 44px;
    margin-bottom: 10px;
  }
  .back-btn {
    width: 44px;
    height: 34px;
    font-size: 22px;
    line-height: 34px;
  }
  .title {
    font-size: 30px;
    line-height: 40px;
    margin-right: 44px;
  }
  .tab-item {
    height: 44px;
  }
  .tab-text {
    font-size: 28px;
    line-height: 38px;
  }
  .qr-card {
    padding: 20px 18px;
  }
  .platform-name {
    font-size: 34px;
    line-height: 44px;
  }
  .scan-hint {
    font-size: 24px;
    line-height: 34px;
  }
}
