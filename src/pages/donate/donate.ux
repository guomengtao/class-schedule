  margin-bottom: 12px;
}

.scan-hint {
  font-size: 13px;
  margin-bottom: 4px;
}

.scan-sub-hint {
  font-size: 11px;
}

.thanks-section {
  flex-direction: column;
  align-items: center;
  padding: 12px 0 8px 0;
}

.thanks-icon {
  font-size: 24px;
  margin-bottom: 6px;
}

.thanks-text {
  font-size: 13px;
  text-align: center;
  line-height: 18px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .qr-card {
    padding: 12px;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 6px 6px 6px;
  }
  .header {
