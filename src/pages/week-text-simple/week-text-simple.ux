<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">纯文课表</text>
    </div>

    <scroll class="scroll-wrap" scroll-y="true">
      <div class="grid">
        <div class="grid-row header-row">
          <text class="day-label" for="day in days" style="color: {{ theme.accent }};">{{ day }}</text>
        </div>

        <div class="grid-row" for="(rowIdx, row) in schedule">
          <div class="cell-wrap" for="(colIdx, cls) in row">
            <text if="{{cls.name}}" class="cell-text" style="color: {{ theme.text }};">{{ cls.name }}</text>
          </div>
        </div>

        <text if="{{ schedule.length === 0 }}" class="empty-hint" style="color: {{ theme.textMuted }}">暂无课程数据</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var log = (function() {
  var seq = 0
  return function(msg, data) {
    seq++
    var line = "[WTS:" + seq + "] " + msg
    if (data !== undefined) {
      try { line += " " + JSON.stringify(data) } catch(e) { line += " " + String(data) }
    }
    console.log(line)
  }
})()

var DAY_MAP = {
  "星期一": "Monday", "星期二": "Tuesday", "星期三": "Wednesday",
  "星期四": "Thursday", "星期五": "Friday", "星期六": "Saturday", "星期日": "Sunday",
  "Monday": "Monday", "Tuesday": "Tuesday", "Wednesday": "Wednesday",
  "Thursday": "Thursday", "Friday": "Friday", "Saturday": "Saturday", "Sunday": "Sunday"
}

export default {
  private: {
    theme: {},
    days: ["一", "二", "三", "四", "五"],
    displayDays: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    schedule: [],
    hideWeekend: true
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getHideWeekend(function(hide) {
      self.hideWeekend = hide
      if (hide) {
        self.days = ["一", "二", "三", "四", "五"]
        self.displayDays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
      } else {
        self.days = ["一", "二", "三", "四", "五", "六", "日"]
        self.displayDays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
      }
      self.loadData()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadData()
  },

  loadData() {
    var self = this
    log("loadData start, displayDays=" + self.displayDays.join(","))
    database.getAllCourses(function(allData) {
      log("getAllCourses callback, allData length=" + (allData ? allData.length : "null"))
      if (!allData || allData.length === 0) {
        log("no data, schedule=[]")
        self.schedule = []
        return
      }

      var allCourses = {}
      for (var d = 0; d < allData.length; d++) {
        var dayData = allData[d]
        if (dayData && dayData.day) {
          var enDay = DAY_MAP[dayData.day] || dayData.day
          var classes = dayData.classes || []
          allCourses[enDay] = classes
          log("dayData[" + d + "] day=" + dayData.day + " -> enDay=" + enDay + " classes=" + classes.length)
        }
      }
      log("allCourses keys=" + Object.keys(allCourses).join(","))

      var timeSet = {}
      var dayList = self.displayDays
      for (var i = 0; i < dayList.length; i++) {
        var day = dayList[i]
        var courses = allCourses[day] || []
        for (var c = 0; c < courses.length; c++) {
          var time = courses[c].time
          if (time && !timeSet[time]) {
            timeSet[time] = true
          }
        }
      }

      var timeKeys = Object.keys(timeSet)
      timeKeys.sort(function(a, b) {
        var aStart = a.split("-")[0].trim()
        var bStart = b.split("-")[0].trim()
        if (aStart < bStart) return -1
        if (aStart > bStart) return 1
        return 0
      })
      log("timeKeys count=" + timeKeys.length + " keys=" + timeKeys.join("|"))

      var schedule = []
      for (var t = 0; t < timeKeys.length; t++) {
        var time = timeKeys[t]
        var row = []
        for (var d = 0; d < dayList.length; d++) {
          var day = dayList[d]
          var courses = allCourses[day] || []
          var found = null
          for (var c = 0; c < courses.length; c++) {
            if (courses[c].time === time) {
              found = courses[c]
              break
            }
          }
          if (found) {
            row.push({ name: found.name })
          } else {
            row.push({})
          }
        }
        schedule.push(row)
      }

      log("schedule built, rows=" + schedule.length + " cols=" + (schedule[0] ? schedule[0].length : 0))
      if (schedule.length > 0 && schedule[0].length > 0) {
        log("first cell=" + JSON.stringify(schedule[0][0]))
      }
      self.schedule = schedule
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
  padding: 0 4px;
}

.back-btn {
  width: 54px;
  height: 34px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.title {
  flex: 1;
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  margin: 0 8px;
}

.scroll-wrap {
  flex: 1;
}

.grid {
  width: 100%;
  flex-direction: column;
  padding: 0 2px;
}

.grid-row {
  flex-direction: row;
  width: 100%;
  margin-bottom: 8px;
}

.header-row {
  margin-bottom: 12px;
  padding: 0 4px;
}

.day-label {
  flex: 1;
  text-align: center;
  font-size: 24px;
  height: 34px;
  line-height: 34px;
  font-weight: bold;
}

.cell-wrap {
  flex: 1;
  height: 60px;
  padding: 0 4px;
  justify-content: center;
  align-items: center;
}

.cell-text {
  font-size: 28px;
  line-height: 38px;
  font-weight: normal;
  text-align: center;
  text-overflow: ellipsis;
}

.empty-hint {
  font-size: 28px;
  text-align: center;
  margin-top: 40px;
}

@media (shape: circle) {
  .page {
    padding: 44px 28px 44px 28px;
  }
  .header {
    padding: 0 10px;
    margin-bottom: 8px;
  }
  .back-btn {
    width: 44px;
    height: 30px;
    font-size: 12px;
  }
  .title {
    font-size: 32px;
  }
  .grid {
    padding: 0;
  }
  .header-row {
    margin-bottom: 8px;
  }
  .day-label {
    font-size: 20px;
    height: 28px;
    line-height: 28px;
  }
  .cell-wrap {
    height: 42px;
    padding: 0 2px;
  }
  .cell-text {
    font-size: 24px;
    line-height: 30px;
  }
}
</style>