<template>
  <div class="page">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" />
      <text class="title">多模块加载测试</text>
    </div>

    <text class="desc">此页面由 3 个独立 JS 模块组合而成</text>

    <div class="card">
      <text class="card-label">module1.js 输出：</text>
      <text class="card-value">{{ text1 }}</text>
    </div>

    <div class="card">
      <text class="card-label">module2.js 输出：</text>
      <text class="card-value">{{ text2 }}</text>
    </div>

    <div class="card">
      <text class="card-label">module3.js 输出：</text>
      <text class="card-value">{{ text3 }}</text>
    </div>

    <text class="status">3 个模块全部加载成功 ✓</text>
  </div>
</template>

<script>
import router from "@system.router"

var module1 = require("./modules/module1.js")
var module2 = require("./modules/module2.js")
var module3 = require("./modules/module3.js")

export default {
  private: {
    text1: "",
    text2: "",
    text3: ""
  },

  onInit() {
    module1.init(this)
    module2.init(this)
    module3.init(this)
  },

  goBack() {
    router.back()
  }
}
</script>

