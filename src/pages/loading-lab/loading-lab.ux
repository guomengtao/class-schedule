  flex: 1;
  width: 100%;
  flex-direction: column;
}

.lab-body {
  width: 100%;
  flex-direction: column;
}

.demo {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 10px;
}

.demo-name {
  font-size: 32px;
  line-height: 40px;
  margin-bottom: 4px;
}

.demo-desc {
  font-size: 24px;
  line-height: 32px;
  margin-top: 6px;
}

.stage {
  width: 100%;
  height: 84px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.foot-note {
  font-size: 24px;
  line-height: 32px;
  margin: 2px 4px 8px 4px;
}

.row-center {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.row-bars {
  flex-direction: row;
  justify-content: center;
  align-items: flex-end;
  height: 44px;
}

.dot6 {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 3px;
  animation-name: kf-spin-dot;
  animation-duration: 1.2s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.bar {
  width: 5px;
  height: 36px;
  border-radius: 3px;
  margin: 0 2px;
  /* transform-origin / animation-direction 均为快应用无先例的实验特性：
     往返效果改由 keyframes 内部往返实现（0.5s×2 周期） */
  animation-name: kf-bars;
  animation-duration: 1s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.bar-d2 { animation-delay: 0.1s; }
.bar-d3 { animation-delay: 0.2s; }
.bar-d4 { animation-delay: 0.3s; }
.bar-d5 { animation-delay: 0.4s; }

.pulse-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  margin: 0 4px;
  animation-name: kf-pulse;
  animation-duration: 1.3s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.pulse-d2 { animation-delay: 0.16s; }
.pulse-d3 { animation-delay: 0.32s; }

.ring-spin {
  position: relative;
  width: 52px;
  height: 52px;
  animation-name: kf-rot;
  animation-duration: 1.4s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.ring40 {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 40px;
  height: 40px;
  border-radius: 20px;
  border-width: 4px;
  border-style: solid;
}

.ring-dot {
  position: absolute;
  left: 22px;
  top: 2px;
  width: 8px;
  height: 8px;
  border-radius: 4px;
}

.rip-wrap {
  position: relative;
  width: 48px;
  height: 48px;
}

.ripring {
  position: absolute;
  left: 0;
  top: 0;
  width: 48px;
  height: 48px;
  border-width: 3px;
  border-style: solid;
  /* border-radius: 50% 是快应用样式解析器的实验特性（全项目无先例）→ 用定值 */
  border-radius: 24px;
  animation-name: kf-ripple;
  animation-duration: 1.8s;
  animation-timing-function: ease-out;
  animation-iteration-count: infinite;
}
.ripring-d2 { animation-delay: 0.9s; }

.tick-wrap {
  position: relative;
  width: 56px;
  height: 56px;
}

.tick0 { animation-delay: 0s; }
/* 负 animation-delay 是快应用样式解析器的实验特性（全项目无先例），
   会触发页面级渲染失败（黑屏）→ 全部换算为等效正延迟 */
.tick1 { animation-delay: 1.05s; }
.tick2 { animation-delay: 0.9s; }
.tick3 { animation-delay: 0.75s; }
.tick4 { animation-delay: 0.6s; }
.tick5 { animation-delay: 0.45s; }
.tick6 { animation-delay: 0.3s; }
.tick7 { animation-delay: 0.15s; }

.bubble {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 14px 16px;
  border-radius: 16px;
}

.typing-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  margin: 0 4px;
  animation-name: kf-typing;
  animation-duration: 1.1s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.typing-d2 { animation-delay: 0.15s; }
.typing-d3 { animation-delay: 0.3s; }

.skel {
  width: 88px;
  position: relative;
}

.skel-line {
  height: 9px;
  border-radius: 5px;
  margin-bottom: 7px;
}

.skel-line-short {
  width: 55%;
  margin-bottom: 0;
}

.skel-hl {
  position: absolute;
  left: 0;
  top: 0;
  width: 26px;
  height: 41px;
  opacity: 0.12;
  animation-name: kf-shine;
  animation-duration: 1.6s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.dna {
  width: 66px;
  height: 52px;
  position: relative;
}

.ddot {
  position: absolute;
  top: 23px;
  width: 6px;
  height: 6px;
  border-radius: 3px;
  animation-name: kf-dna;
  animation-duration: 2s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.dna0 { animation-delay: 0s; }
.dna1 { animation-delay: 1.84s; }
.dna2 { animation-delay: 1.68s; }
.dna3 { animation-delay: 1.52s; }
.dna4 { animation-delay: 1.36s; }
.dna5 { animation-delay: 1.2s; }
.dna6 { animation-delay: 1.04s; }
.dna7 { animation-delay: 0.88s; }

.orbit-spin {
  position: relative;
  width: 60px;
  height: 60px;
  animation-name: kf-rot;
  animation-duration: 1.6s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.oball {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 5px;
}
.oball-a { left: 0; top: 25px; }
.oball-b { left: 50px; top: 25px; opacity: 0.45; }

.clock-spin {
  position: relative;
  width: 56px;
  height: 56px;
  animation-name: kf-rot;
  animation-duration: 1.5s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.ring44 {
  position: absolute;
  left: 4px;
  top: 4px;
  width: 44px;
  height: 44px;
  border-radius: 22px;
  border-width: 3px;
  border-style: solid;
}

.clock-dot {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 4px;
}
.clock-d0 { left: 24px; top: 0; }
.clock-d1 { left: 19px; top: 6px; opacity: 0.4; }
.clock-d2 { left: 14px; top: 13px; opacity: 0.18; }

.grid-box {
  position: relative;
  width: 48px;
  height: 48px;
}

.gsq {
  position: absolute;
  width: 20px;
  height: 20px;
  border-radius: 4px;
  animation-name: kf-grid;
  animation-duration: 1.4s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.gsq-d1 { animation-delay: 0s; }
.gsq-d2 { animation-delay: 0.175s; }
.gsq-d3 { animation-delay: 0.35s; }
.gsq-d4 { animation-delay: 0.525s; }

.ptrack {
  width: 100px;
  height: 10px;
  border-radius: 5px;
  position: relative;
  overflow: hidden;
}

.phl {
  position: absolute;
  left: 0;
  top: 0;
  width: 26px;
  height: 10px;
  border-radius: 5px;
  animation-name: kf-prog;
  animation-duration: 1.6s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

/* ---- animation keyframes ---- */
@keyframes kf-rot {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes kf-pulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

@keyframes kf-bars {
  /* 右先左后：先 scaleY 再 translateY(全量 13.5px)，模拟底部锚点缩放 */
  0% { transform: translateY(13.5px) scaleY(0.25); }
  50% { transform: translateY(0) scaleY(1); }
  100% { transform: translateY(13.5px) scaleY(0.25); }
}

@keyframes kf-ripple {
  from { transform: scale(0.2); opacity: 1; }
  to { transform: scale(1); opacity: 0; }
}

@keyframes kf-spin-dot {
  0%, 20% { opacity: 0.12; }
  40% { opacity: 0.95; }
  60%, 100% { opacity: 0.12; }
}

@keyframes kf-typing {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-6px); opacity: 1; }
}

@keyframes kf-shine {
  from { transform: translateX(-26px); }
  to { transform: translateX(88px); }
}

@keyframes kf-dna {
  0%, 100% { opacity: 0.15; transform: translateX(-6px); }
  25% { opacity: 0.95; transform: translateX(10px); }
  50% { opacity: 0.15; transform: translateX(6px); }
  75% { opacity: 0.95; transform: translateX(-10px); }
}

@keyframes kf-grid {
  0%, 100% { opacity: 0.15; }
  50% { opacity: 1; }
}

@keyframes kf-prog {
  0% { transform: translateX(-26px); opacity: 0; }
  12% { opacity: 1; }
  88% { opacity: 1; }
  100% { transform: translateX(100px); opacity: 0; }
}

@media (shape: pill-shaped) {
  .page {
    padding: 30px 14px 30px 14px;
  }
  .back-header {
    padding: 0 4px;
  }
  .back-btn-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 18px;
  }
  .back-btn-icon {
    width: 18px;
    height: 18px;
  }
  .header-placeholder {
    width: 34px;
  }
  .header-title {
    font-size: 20px;
    line-height: 28px;
  }
  .stage {
    height: 76px;
  }
}
</style>