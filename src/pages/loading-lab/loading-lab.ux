<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">加载动画</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="lab-scroll" scroll-y="{{true}}">
      <div class="lab-body" style="background-color: {{ theme.bg }}">

        <div class="ctrl-row" onclick="togglePlay" style="background-color: {{ theme.card }}">
          <text class="ctrl-label" style="color: {{ theme.text }}">循环演示 · 12 种</text>
          <text class="ctrl-btn" style="color: {{ theme.accent }}">{{ paused ? '继续' : '暂停' }}</text>
        </div>

        <!-- 1 旋转圆环 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">旋转圆环</text>
          <div class="stage">
            <div class="box52">
              <div class="ring40" style="border-color: {{ theme.borderLight }}"></div>
              <div class="dot8" style="left: 22px; top: 22px; background-color: {{ theme.accent }}; transform: translateX({{ ringX }}px) translateY({{ ringY }}px)"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">轨道圆点绕环匀速公转</text>
        </div>

        <!-- 2 脉冲圆点 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">脉冲圆点</text>
          <div class="stage">
            <div class="row-center">
              <div for="{{ dots }}" class="dot12" style="background-color: {{ theme.accent }}; opacity: {{ $item.o }}"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">三点呼吸明暗，简约节奏感</text>
        </div>

        <!-- 3 弹跳柱条 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">弹跳柱条</text>
          <div class="stage">
            <div class="row-bars">
              <div for="{{ bars }}" class="bar" style="background-color: {{ theme.accent }}; height: {{ $item.h }}px"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">五柱交错伸缩，音频可视化</text>
        </div>

        <!-- 4 波纹圆圈 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">波纹圆圈</text>
          <div class="stage">
            <div class="box48">
              <div for="{{ ripples }}" class="rip" style="width: {{ $item.d }}px; height: {{ $item.d }}px; left: {{ $item.l }}px; top: {{ $item.t }}px; opacity: {{ $item.o }}; border-color: {{ theme.accent }}"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">涟漪扩散，雷达探测感</text>
        </div>

        <!-- 5 点阵旋转器 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">点阵旋转器</text>
          <div class="stage">
            <div class="box56">
              <div for="{{ ticks }}" class="dot6" style="left: 25px; top: 25px; background-color: {{ theme.accent }}; transform: translateX({{ $item.x }}px) translateY({{ $item.y }}px); opacity: {{ $item.o }}"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">八点渐隐旋转（锥形渐变降级版）</text>
        </div>

        <!-- 6 打字指示器 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">打字指示器</text>
          <div class="stage">
            <div class="bubble" style="background-color: {{ theme.cardLight }}">
              <div for="{{ typing }}" class="dot7" style="background-color: {{ theme.text }}; transform: translateY({{ $item.y }}px)"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">聊天气泡跳动，对话 UI 必备</text>
        </div>

        <!-- 7 骨架屏微光 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">骨架屏微光</text>
          <div class="stage">
            <div class="skel">
              <div class="skel-line" style="background-color: {{ theme.borderLight }}"></div>
              <div class="skel-line" style="background-color: {{ theme.borderLight }}"></div>
              <div class="skel-line skel-line-short" style="background-color: {{ theme.borderLight }}"></div>
              <div class="skel-hl" style="background-color: {{ theme.text }}; transform: translateX({{ skelX }}px)"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">占位内容扫光，加载过渡自然</text>
        </div>

        <!-- 8 DNA 双螺旋 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">DNA 双螺旋</text>
          <div class="stage">
            <div class="dna">
              <div for="{{ dnaF }}" class="ddot" style="left: {{ $item.l }}px; background-color: {{ theme.accent }}; transform: translateX({{ $item.x }}px); opacity: {{ $item.o }}"></div>
              <div for="{{ dnaB }}" class="ddot" style="left: {{ $item.l }}px; background-color: {{ theme.accent }}; transform: translateX({{ $item.x }}px); opacity: {{ $item.o }}"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">双链正弦交织，科技生物感</text>
        </div>

        <!-- 9 轨道双球 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">轨道双球</text>
          <div class="stage">
            <div class="box60">
              <div class="oball" style="background-color: {{ theme.accent }}; transform: translateX({{ orbit.ax }}px) translateY({{ orbit.ay }}px)"></div>
              <div class="oball" style="background-color: {{ theme.accent }}; opacity: 0.45; transform: translateX({{ orbit.bx }}px) translateY({{ orbit.by }}px)"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">双球对转追逐，行星轨道感</text>
        </div>

        <!-- 10 时钟扫描 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">时钟扫描</text>
          <div class="stage">
            <div class="box56">
              <div class="ring44" style="border-color: {{ theme.borderLight }}"></div>
              <div for="{{ clock }}" class="dot8" style="left: 24px; top: 24px; background-color: {{ theme.accent }}; transform: translateX({{ $item.x }}px) translateY({{ $item.y }}px); opacity: {{ $item.o }}"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">指针扫描 + 渐隐拖尾</text>
        </div>

        <!-- 11 方块拼图 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">方块拼图</text>
          <div class="stage">
            <div class="box48">
              <div for="{{ grid }}" class="gsq" style="left: {{ $item.x }}px; top: {{ $item.y }}px; background-color: {{ theme.accent }}; opacity: {{ $item.o }}"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">四格轮询明暗，极简开销</text>
        </div>

        <!-- 12 进度条扫光 -->
        <div class="demo" style="background-color: {{ theme.card }}">
          <text class="demo-name" style="color: {{ theme.text }}">进度条扫光</text>
          <div class="stage">
            <div class="ptrack" style="background-color: {{ theme.borderLight }}">
              <div class="phl" style="background-color: {{ theme.accent }}; transform: translateX({{ progX }}px); opacity: {{ progO }}"></div>
            </div>
          </div>
          <text class="demo-desc" style="color: {{ theme.textMuted }}">不定进度往返滑动</text>
        </div>

        <text class="foot-note" style="color: {{ theme.textMuted }}">快应用无 CSS keyframes，本页由定时器驱动 transform/opacity 模拟；卡顿时点上方「暂停」</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    paused: false,
    ringX: 0,
    ringY: -20,
    dots: [],
    bars: [],
    ripples: [],
    ticks: [],
    typing: [],
    skelX: -26,
    dnaF: [],
    dnaB: [],
    orbit: { ax: 0, ay: -22, bx: 0, by: 22 },
    clock: [],
    grid: [],
    progX: 0,
    progO: 1
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.buildStatics()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.start()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  // 静态几何：点阵位置 / DNA 列位置 / 拼图格子位置
  buildStatics() {
    var tk = [], i, a
    for (i = 0; i < 8; i++) {
      a = i * Math.PI / 4
      tk.push({ x: Math.round(20 * Math.sin(a)), y: Math.round(-20 * Math.cos(a)), o: 1 })
    }
    this._tkBase = tk
    this.ticks = tk.slice()

    var df = [], db = [], c
    for (c = 0; c < 8; c++) {
      df.push({ l: c * 8 + 1, x: 0, o: 1 })
      db.push({ l: c * 8 + 1, x: 0, o: 1 })
    }
    this._dnaBase = { f: df, b: db }
    this.dnaF = df.slice()
    this.dnaB = db.slice()

    var gx = [3, 25, 3, 25], gy = [3, 3, 25, 25], g = []
    for (i = 0; i < 4; i++) g.push({ x: gx[i], y: gy[i], o: 1 })
    this._gridBase = g
    this.grid = g.slice()

    this.clock = [
      { x: 0, y: -20, o: 1 },
      { x: -10, y: -17, o: 0.4 },
      { x: -17, y: -10, o: 0.18 }
    ]
  },

  start() {
    if (this._timer || this.paused) return
    var self = this
    this._timer = setInterval(function() {
      self.tick()
    }, 40)
  },

  stop() {
    if (this._timer) {
      clearInterval(this._timer)
      this._timer = null
    }
  },

  togglePlay() {
    this.paused = !this.paused
    if (this.paused) {
      this.stop()
    } else {
      this.start()
    }
  },

  tick() {
    var t = Date.now() / 1000
    var R = Math.round, PI = Math.PI, sin = Math.sin, cos = Math.cos
    var r2 = function(x) { return R(x * 100) / 100 }
    var i, c, p, d, sn, fd

    // 1 旋转圆环：轨道点 r=20
    this.ringX = R(20 * sin(t * 3.6))
    this.ringY = R(-20 * cos(t * 3.6))

    // 2 脉冲圆点：透明度呼吸
    var dots = []
    for (i = 0; i < 3; i++) {
      p = (sin(t * 2.6 - i * 0.6) + 1) / 2
      dots.push({ o: r2(0.3 + 0.7 * p) })
    }
    this.dots = dots

    // 3 弹跳柱条：高度 12~38
    var bars = []
    for (i = 0; i < 5; i++) {
      bars.push({ h: R(12 + 26 * Math.abs(sin(t * 3 - i * 0.5))) })
    }
    this.bars = bars

    // 4 波纹圆圈：直径 10→44，透明度 1→0
    var ripples = []
    for (i = 0; i < 2; i++) {
      var cyc = (t / 1.7 + i * 0.5) % 1
      d = R(10 + 34 * cyc)
      ripples.push({ d: d, l: R((48 - d) / 2), t: R((48 - d) / 2), o: r2(1 - cyc) })
    }
    this.ripples = ripples

    // 5 点阵旋转器：八点相位渐隐
    var ticks = []
    for (i = 0; i < 8; i++) {
      p = (sin(t * 4.5 - i * PI / 4) + 1) / 2
      ticks.push({ x: this._tkBase[i].x, y: this._tkBase[i].y, o: r2(0.15 + 0.85 * p) })
    }
    this.ticks = ticks

    // 6 打字指示器：向上弹跳
    var typing = []
    for (i = 0; i < 3; i++) {
      typing.push({ y: R(-6 * Math.max(0, sin(t * 3.4 - i * 0.7))) })
    }
    this.typing = typing

    // 7 骨架屏扫光：-26 → 88
    var sc = (t / 1.8) % 1
    this.skelX = R(-26 + 114 * sc)

    // 8 DNA 双螺旋：正弦交织，前链亮后链暗
    var df = [], db = []
    for (c = 0; c < 8; c++) {
      var ph = t * 2.4 - c * 0.42
      sn = sin(ph)
      fd = (sn + 1) / 2
      df.push({ l: this._dnaBase.f[c].l, x: R(16 * sn), o: r2(0.25 + 0.75 * fd) })
      db.push({ l: this._dnaBase.b[c].l, x: R(-16 * sn), o: r2(0.25 + 0.75 * (1 - fd)) })
    }
    this.dnaF = df
    this.dnaB = db

    // 9 轨道双球：r=22 对转
    var a9 = t * 2.8
    var ax = R(22 * sin(a9)), ay = R(-22 * cos(a9))
    this.orbit = { ax: ax, ay: ay, bx: -ax, by: -ay }

    // 10 时钟扫描：主点 + 两级拖尾
    var clock = []
    for (i = 0; i < 3; i++) {
      var a10 = t * 2.4 - i * 0.5
      clock.push({ x: R(20 * sin(a10)), y: R(-20 * cos(a10)), o: [1, 0.4, 0.18][i] })
    }
    this.clock = clock

    // 11 方块拼图：四格轮询
    var grid = []
    for (i = 0; i < 4; i++) {
      p = (sin(t * 3 - i * PI / 2) + 1) / 2
      grid.push({ x: this._gridBase[i].x, y: this._gridBase[i].y, o: r2(0.15 + 0.85 * p) })
    }
    this.grid = grid

    // 12 进度条扫光：0→74，两端淡入淡出
    var pc = (t / 1.6) % 1
    this.progX = R(74 * pc)
    var e = 0.15, po = 1
    if (pc < e) po = pc / e
    else if (pc > 1 - e) po = (1 - pc) / e
    this.progO = r2(Math.max(0, po))
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  line-height: 44px;
  lines: 1;
  text-overflow: ellipsis;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.lab-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.lab-body {
  width: 100%;
  flex-direction: column;
}

.ctrl-row {
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 10px;
}

.ctrl-label {
  font-size: 32px;
  line-height: 40px;
}

.ctrl-btn {
  font-size: 32px;
  line-height: 40px;
  font-weight: bold;
}

.demo {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 10px;
}

.demo-name {
  font-size: 32px;
  line-height: 40px;
  margin-bottom: 4px;
}

.demo-desc {
  font-size: 24px;
  line-height: 32px;
  margin-top: 6px;
}

.stage {
  width: 100%;
  height: 84px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.foot-note {
  font-size: 24px;
  line-height: 32px;
  margin: 2px 4px 8px 4px;
}

/* ---- 舞台内的固定几何（尺寸固定 + 绝对定位，仅绑定 transform/opacity/高度） ---- */
.row-center {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.row-bars {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 44px;
}

.dot12 {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  margin: 0 4px;
}

.dot8 {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 4px;
}

.dot7 {
  width: 7px;
  height: 7px;
  border-radius: 4px;
  margin: 0 3px;
}

.dot6 {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 3px;
}

.bar {
  width: 5px;
  border-radius: 3px;
  margin: 0 2px;
}

.box48 { width: 48px; height: 48px; position: relative; }
.box52 { width: 52px; height: 52px; position: relative; }
.box56 { width: 56px; height: 56px; position: relative; }
.box60 { width: 60px; height: 60px; position: relative; }

.ring40 {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 40px;
  height: 40px;
  border-radius: 20px;
  border-width: 4px;
  border-style: solid;
}

.ring44 {
  position: absolute;
  left: 4px;
  top: 4px;
  width: 44px;
  height: 44px;
  border-radius: 22px;
  border-width: 3px;
  border-style: solid;
}

.rip {
  position: absolute;
  border-radius: 50%;
  border-width: 3px;
  border-style: solid;
}

.bubble {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 14px 16px;
  border-radius: 16px;
}

.skel {
  width: 88px;
  position: relative;
}

.skel-line {
  height: 9px;
  border-radius: 5px;
  margin-bottom: 7px;
}

.skel-line-short {
  width: 55%;
  margin-bottom: 0;
}

.skel-hl {
  position: absolute;
  left: 0;
  top: 0;
  width: 26px;
  height: 41px;
  opacity: 0.12;
}

.dna {
  width: 66px;
  height: 52px;
  position: relative;
}

.ddot {
  position: absolute;
  top: 23px;
  width: 6px;
  height: 6px;
  border-radius: 3px;
}

.oball {
  position: absolute;
  left: 25px;
  top: 25px;
  width: 10px;
  height: 10px;
  border-radius: 5px;
}

.gsq {
  position: absolute;
  width: 20px;
  height: 20px;
  border-radius: 4px;
}

.ptrack {
  width: 100px;
  height: 10px;
  border-radius: 5px;
  position: relative;
}

.phl {
  position: absolute;
  left: 0;
  top: 0;
  width: 26px;
  height: 10px;
  border-radius: 5px;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 30px 14px 30px 14px;
  }
  .back-header {
    padding: 0 4px;
  }
  .back-btn-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 18px;
  }
  .back-btn-icon {
    width: 18px;
    height: 18px;
  }
  .header-placeholder {
    width: 34px;
  }
  .header-title {
    font-size: 20px;
    line-height: 28px;
  }
  .stage {
    height: 76px;
  }
}
</style>
