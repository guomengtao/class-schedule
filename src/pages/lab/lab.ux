  font-size: 36px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  margin-right: 64px;
  line-height: 48px;
}

.hint {
  font-size: 28px;
  margin-bottom: 14px;
  padding: 0 6px;
  line-height: 38px;
}

.list-scroll {
  flex-direction: column;
}

.list-row {
  flex-direction: row;
  align-items: center;
  border-radius: 12px;
  padding: 24px 16px;
  margin-bottom: 14px;
}

.pin-check {
  width: 28px;
  height: 28px;
  margin-right: 12px;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

