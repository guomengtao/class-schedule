  font-size: 32px;
  margin-bottom: 8px;
  line-height: 50px;
}

.row-desc {
  font-size: 28px;
  line-height: 42px;
}

.action-btn {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  font-size: 24px;
  text-align: center;
  margin-left: 6px;
  background-color: transparent;
  border: 1px solid transparent;
}

.del-btn {
  border: none;
  width: 28px;
  height: 28px;
  font-size: 24px;
  font-weight: bold;
}

@media (shape: circle) {
  .page-root {
    padding: 44px 36px 44px 36px;
  }
  .header {
    justify-content: center;
    margin-bottom: 14px;
  }
  .back-btn {
    width: 52px;
    height: 40px;
    font-size: 24px;
  }
  .title {
    font-size: 36px;
    line-height: 48px;
  }
  .list-row {
    padding: 20px 14px;
    margin-bottom: 12px;
  }
  .row-name {
    font-size: 30px;
    line-height: 46px;
  }
  .row-desc {
    font-size: 26px;
    line-height: 40px;
  }
  .modal-card {
    width: 72%;
    padding: 20px 18px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
