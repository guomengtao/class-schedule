    flex: 1;
    lines: 1;
    margin: 0 4px;
  }

  .modal-card {
    width: 90%;
    border-radius: 12px;
    padding: 18px 16px;
  }

  .modal-title {
    font-size: 26px;
    margin-bottom: 10px;
  }

  .modal-desc {
    font-size: 20px;
    margin-bottom: 14px;
    line-height: 30px;
  }

  .benefit-list {
    margin-bottom: 14px;
    padding-left: 8px;
  }

  .benefit-item {
    font-size: 20px;
    margin-bottom: 6px;
    line-height: 28px;
  }

  .modal-btn-primary {
    width: 100%;
    height: 44px;
