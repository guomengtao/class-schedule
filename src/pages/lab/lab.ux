<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">实验室</text>
    </div>

    <text class="hint" style="color: {{ theme.textSecondary }}">实验功能</text>

    <div class="list-scroll">
      <div class="list-row" for="(idx, item) in labItems" style="background-color: {{ theme.card }}">
        <input class="pin-check" type="checkbox" checked="{{ item.pinned }}" onclick="onTogglePin(idx)"
               style="accent-color: {{ theme.accent }}" />
        <div class="row-main" onclick="onOpenItem(idx)">
          <text class="row-name" style="color: {{ theme.text }}">{{ item.name }}</text>
          <text class="row-desc" style="color: {{ theme.textMuted }}">{{ item.desc }}</text>
        </div>
        <input class="action-btn del-btn" type="button" value="✕" onclick="onDelete(idx)"
               style="color: {{ theme.deleteText }}" />
      </div>
    </div>

    <text class="dev-hint" style="color: {{ theme.textSecondary }}">反馈建议</text>

    <div class="overlay-modal" show="{{ showDialog }}">
      <div class="modal-card" style="background-color: {{ theme.card }}">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁高级功能</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">解锁高级功能</text>
        <div class="benefit-list">
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多课表管理</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
        </div>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="暂不需要" onclick="dismissDialog"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var labList = require("../../data/lab-list.js")

export default {
  private: {
    labItems: [],
    labStatus: "loading",
    showDialog: false,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      keyBg: "#1a1a3e",
      keyBorder: "#2a2a5a",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080",
      icon: '●',
      progressOngoing: "rgba(126,200,227,0.2)",
      progressDone: "rgba(74,138,154,0.25)"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadList()
  },
  onReady() {
    console.log("[TEST-AREA] onReady: checking premium...")
    this.checkAndShowOverlay()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadList()
  },

  loadList() {
    var self = this
    labList.init(self, function() {})
  },

  onOpenItem(idx) {
    var item = this.labItems[idx]
    if (item && item.uri) {
      router.push({ uri: item.uri })
    }
  },

  onTogglePin(idx) {
    var self = this
    labList.togglePin(self, idx, function() {})
  },

  onDelete(idx) {
    var self = this
    labList.deleteItem(self, idx, function() {})
  },

  checkAndShowOverlay() {
    console.log("[TEST-AREA] checkAndShowOverlay: checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (!unlocked) {
        console.log("[TEST-AREA] checkAndShowOverlay: not premium, showing dialog")
        self.showDialog = true
      }
    })
  },

  goToPremium() {
    console.log("[TEST-AREA] goToPremium: navigating to activation")
    this.showDialog = false
    router.push({ uri: "/pages/activation" })
  },

  goBack() {
    router.back()
  },

  dismissDialog() {
    this.showDialog = false
  }
}
</script>

