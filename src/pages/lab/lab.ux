<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">实验室</text>
    </div>

    <text class="hint" style="color: {{ theme.textSecondary }}">实验功能</text>

    <div class="list-scroll">
      <div class="list-row" for="(idx, item) in labItems" style="background-color: {{ theme.card }}">
        <input class="pin-check" type="checkbox" checked="{{ item.pinned }}" onclick="onTogglePin(idx)"
               style="accent-color: {{ theme.accent }}" />
        <div class="row-main" onclick="onOpenItem(idx)">
          <text class="row-name" style="color: {{ theme.text }}">{{ item.name }}</text>
          <text class="row-desc" style="color: {{ theme.textMuted }}">{{ item.desc }}</text>
        </div>
        <input class="action-btn del-btn" type="button" value="✕" onclick="onDelete(idx)"
               style="color: {{ theme.deleteText }}" />
      </div>
    </div>

    </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var labList = require("../../data/lab-list.js")

export default {
  private: {
    labItems: [],
    labStatus: "loading",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      keyBg: "#1a1a3e",
      keyBorder: "#2a2a5a",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080",
      icon: '●',
      progressOngoing: "rgba(126,200,227,0.2)",
      progressDone: "rgba(74,138,154,0.25)"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadList()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadList()
  },

  loadList() {
    var self = this
    labList.init(self, function() {})
  },

  onOpenItem(idx) {
    var item = this.labItems[idx]
    if (item && item.uri) {
      router.push({ uri: item.uri })
    }
  },

  onTogglePin(idx) {
    var self = this
    labList.togglePin(self, idx, function() {})
  },

  onDelete(idx) {
    var self = this
    labList.deleteItem(self, idx, function() {})
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
