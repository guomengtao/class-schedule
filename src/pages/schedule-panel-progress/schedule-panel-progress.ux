<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div if="{{ !isRoot }}" class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.textSecondary }}">当前进度</text>
      <div if="{{ !isRoot }}" class="header-placeholder"></div>
    </div>

    <!-- A 课名：整屏最大字（56px，两行后省略） -->
    <text class="a-name" style="color: {{ nameColor }}">{{ focusName }}</text>

    <!-- B 状态行：第几节 / 剩几分 / 距上课 -->
    <text class="b-status" style="color: {{ theme.textSecondary }}">{{ statusText }}</text>

    <!-- C 进度条：宽度绑定 progressPercent，别写死 -->
    <div class="c-bar-bg" style="background-color: {{ theme.border }}">
      <div class="c-bar-fill" style="width: {{ progressPercent }}%; background-color: {{ theme.accent }}"></div>
    </div>

    <!-- D 下一节：label + 定长时间 + 弹性课名（课名省略，整行永不溢出） -->
    <div if="{{ nextName }}" class="d-next">
      <text class="d-label" style="color: {{ theme.textMuted }}">{{ nextLabel }}</text>
      <text class="d-time" style="color: {{ theme.textSecondary }}">{{ nextTime }}</text>
      <text class="d-name" style="color: {{ theme.text }}">{{ nextName }}</text>
    </div>

    <!-- 弹性占位：本引擎 margin-top:auto 不生效（实测时钟卡在内容下方而非贴底），用 flex:1 撑开 -->
    <div class="spacer"></div>

    <!-- E 时钟：右下角小字（课名才是王，时钟只做参照） -->
    <text class="e-clock" style="color: {{ theme.textMuted }}">{{ clockText }}</text>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")
const utils = require("../../data/utils.js")
const builtinSchedule = require("../../data/schedule.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

// "08:00 - 09:35" → {startMin, endMin}；格式不合规返回 null（脏数据不参与计算）
function parseTimeRange(timeStr) {
  if (!timeStr) return null
  var parts = timeStr.split(" - ")
  if (parts.length !== 2) return null
  var s1 = parts[0].trim().split(":")
  var s2 = parts[1].trim().split(":")
  if (s1.length !== 2 || s2.length !== 2) return null
  var st = parseInt(s1[0]) * 60 + parseInt(s1[1])
  var en = parseInt(s2[0]) * 60 + parseInt(s2[1])
  if (isNaN(st) || isNaN(en)) return null
  return { startMin: st, endMin: en }
}

function pad2(n) { return (n < 10 ? "0" : "") + n }

// 分钟数 → "08:00"（下一节行宽只有 168，必须定长）
function clockOf(min) {
  var m = min % 1440
  return pad2(Math.floor(m / 60)) + ":" + pad2(m % 60)
}

// 百分比一律夹在 0..100，脏数据不许把进度条撑出容器
function clampPct(v) {
  if (!(v > 0)) return 0
  return v > 100 ? 100 : v
}

// 某天的课 → 按开始时间升序的条目；解析失败的脏数据直接丢弃
function buildItems(classes) {
  var out = []
  var list = classes || []
  for (var i = 0; i < list.length; i++) {
    var r = parseTimeRange(list[i].time)
    if (!r) continue
    out.push({ id: list[i].id, name: list[i].name, time: list[i].time, startMin: r.startMin, endMin: r.endMin })
  }
  out.sort(function(a, b) { return a.startMin - b.startMin })
  return out
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    state: "none",          // class | break | done | none
    focusName: "—",         // A 区主角：当前课 / 下节课 / 放学 / 没课
    nameColor: "#ffffff",
    statusText: "",
    progressPercent: 0,
    nextLabel: "",          // 下节 | 明日
    nextTime: "",
    nextName: "",
    clockText: "",
    schedule: [],
    tickTimer: null,
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    // 独立首页 root 判定：被「更多首页」push 带 fromPanel='1'；作为 root 冷启动则无此参
    self.fromPanel = (self.fromPanel === '1') ? '1' : ''
    self.isRoot = self.fromPanel !== '1'
    // 首帧同步出内容：先用内置课表算一遍，storage 慢/丢回调都不会停在空白帧
    self.apply((builtinSchedule && builtinSchedule.schedule) ? builtinSchedule.schedule : [])
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
      self.tick()
      self.loadData()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    // 回前台立即重算（后台期间可能跨节），再按整分续排
    self.tick()
  },

  onHide() {
    // 后台不空转：清掉定时器，onShow 再补算
    this.clearTickTimer()
  },

  /* 分钟级刷新：对齐「下一个整分」只挂一个 setTimeout。
     课程表是分钟级事件，本页禁止 setInterval / 秒级轮询（方案 §0）。
     「剩 N 分」与右下角时钟都按整分走，10s 轮询属于白烧电量。 */
  scheduleNextMinute: function() {
    var self = this
    this.clearTickTimer()
    var now = new Date()
    var ms = 60000 - (now.getSeconds() * 1000)
    if (ms < 1000) ms = 1000
    this.tickTimer = setTimeout(function() { self.tick() }, ms)
  },

  clearTickTimer: function() {
    if (this.tickTimer) { clearTimeout(this.tickTimer); this.tickTimer = null }
  },

  apply: function(schedule) {
    this.schedule = schedule || []
    this.tick()
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.apply(schedule || [])
      })
    })
  },

  classesOf: function(dayName) {
    var schedule = this.schedule || []
    for (var i = 0; i < schedule.length; i++) {
      if (schedule[i].day === dayName) return schedule[i].classes || []
    }
    return []
  },

  tick: function() {
    try {
      this.compute()
    } catch (e) {
      // 计算异常不许把页面钉在旧读数上：退回「没课」让人看得懂
      this.state = "none"
      this.focusName = "没课"
      this.nameColor = this.theme.textSecondary
      this.statusText = "今天没有安排"
      this.progressPercent = 0
      this.nextName = ""
      console.error("[progress] compute failed: " + e)
    }
    this.scheduleNextMinute()
  },

  /* 三态 + 空态：
     class 上课中 → A 当前课名，B 第N节·剩X分，C 本节进度，D 本节之后那节
     break 课间   → A 下节课名，B 距上课X分，C 课间进度，D 空（A 已是下节，不重复）
     done  已放学 → A 放学，B 今天的课上完了，C 100%，D 明日首节
     none  没课   → A 没课，B 今天没有安排，C 0%，D 明日首节（若有） */
  compute: function() {
    var now = new Date()
    var nowMin = now.getHours() * 60 + now.getMinutes()
    this.clockText = pad2(now.getHours()) + ":" + pad2(now.getMinutes())

    var todayItems = buildItems(this.classesOf(DAY_NAMES[now.getDay()]))
    var tomorrowItems = buildItems(this.classesOf(DAY_NAMES[(now.getDay() + 1) % 7]))

    this.nextLabel = ""
    this.nextTime = ""
    this.nextName = ""

    var idx = -1
    for (var i = 0; i < todayItems.length; i++) {
      if (nowMin >= todayItems[i].startMin && nowMin < todayItems[i].endMin) { idx = i; break }
    }

    if (idx >= 0) {
      var cur = todayItems[idx]
      var total = cur.endMin - cur.startMin
      var elapsed = nowMin - cur.startMin
      this.state = "class"
      this.focusName = cur.name
      this.nameColor = this.theme.accent
      this.statusText = "第" + (idx + 1) + "节 · 剩 " + (cur.endMin - nowMin) + " 分"
      this.progressPercent = total > 0 ? clampPct(Math.round(elapsed / total * 100)) : 100
      if (idx + 1 < todayItems.length) {
        var nx = todayItems[idx + 1]
        this.nextLabel = "下节"
        this.nextTime = clockOf(nx.startMin)
        this.nextName = nx.name
      }
      return
    }

    var nextIdx = -1
    for (var j = 0; j < todayItems.length; j++) {
      if (todayItems[j].startMin > nowMin) { nextIdx = j; break }
    }

    if (nextIdx >= 0) {
      var upcoming = todayItems[nextIdx]
      this.state = "break"
      this.focusName = upcoming.name
      this.nameColor = this.theme.accent
      this.statusText = "距上课 " + (upcoming.startMin - nowMin) + " 分"
      // 课间进度 = 上节下课 → 本节上课；一天的第一节之前没有「上节」，记 0
      var prevEnd = nextIdx > 0 ? todayItems[nextIdx - 1].endMin : nowMin
      var span = upcoming.startMin - prevEnd
      this.progressPercent = span > 0 ? clampPct(Math.round((nowMin - prevEnd) / span * 100)) : 0
      return
    }

    var hadClass = todayItems.length > 0
    this.state = hadClass ? "done" : "none"
    this.focusName = hadClass ? "放学" : "没课"
    this.nameColor = this.theme.textSecondary
    this.statusText = hadClass ? "今天的课上完了" : "今天没有安排"
    this.progressPercent = hadClass ? 100 : 0
    if (tomorrowItems.length > 0) {
      this.nextLabel = "明日"
      this.nextTime = clockOf(tomorrowItems[0].startMin)
      this.nextName = tomorrowItems[0].name
    }
  },

  goBack() {
    // 双模返回：被「更多首页」push（fromPanel）→ 回父页；作为 root 首页 → 回「更多首页」
    if (this.fromPanel === '1') {
      router.back()
    } else {
      // 面板被当独立首页（root）时无可退返回栈，直接回「更多首页」
      router.push({ uri: '/pages/schedule-panel' })
    }
  },

  onBackPress() {
    // 硬件返回键：push 态交还系统默认返回（回更多首页）；root 态退出（与默认首页 index 一致）
    if (this.fromPanel === '1') return false
    return utils.exitApp() === true
  },

  onDestroy() {
    // 双清：onHide 已清一次，销毁再兜一次
    this.clearTickTimer()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 12px 12px 12px;
}
.back-header {
  flex-direction: row;
  align-items: center;
  height: 40px;
  flex-shrink: 0;
  padding: 0 4px;
}
.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.back-btn-icon { width: 24px; height: 24px }
.header-title {
  flex: 1;
  font-size: 18px;
  line-height: 24px;
  text-align: center;
}
.header-placeholder { width: 48px; height: 40px; flex-shrink: 0 }

/* A 课名：56px，最多两行（3 字/行），超长两行后省略。
   不写死 height：单行课名（放学/没课/两字科目）固定 124 会在下方留一大块空白，
   自然高度让 1 行贴紧 B、2 行自动撑到 124；总高最坏 246 < 434，不会溢出。 */
.a-name {
  margin-top: 14px;
  font-size: 56px;
  line-height: 62px;
  font-weight: bold;
  lines: 2;
  text-overflow: ellipsis;
  flex-shrink: 0;
}

/* B 状态行：只许一行，折行会把 C/D 顶出坐标 */
.b-status {
  margin-top: 16px;
  height: 26px;
  font-size: 20px;
  line-height: 26px;
  lines: 1;
  text-overflow: ellipsis;
  flex-shrink: 0;
}

/* C 进度条：168×10，宽度由 progressPercent 绑定 */
.c-bar-bg {
  margin-top: 12px;
  width: 168px;
  height: 10px;
  border-radius: 5px;
  overflow: hidden;
  flex-shrink: 0;
}
.c-bar-fill { height: 10px; border-radius: 5px }

/* D 下一节：label + 定长时间 + 弹性课名（课名省略，整行永不溢出） */
.d-next {
  margin-top: 20px;
  height: 24px;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}
.d-label { font-size: 16px; line-height: 24px; margin-right: 6px; flex-shrink: 0 }
.d-time { font-size: 18px; line-height: 24px; margin-right: 6px; flex-shrink: 0 }
.d-name {
  flex: 1;
  font-size: 18px;
  line-height: 24px;
  lines: 1;
  text-overflow: ellipsis;
}

/* E 时钟：贴底右对齐，16px 小字 */
.spacer { flex: 1; width: 100% }
.e-clock {
  width: 100%;
  text-align: right;
  font-size: 16px;
  line-height: 22px;
  flex-shrink: 0;
}

@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px }
  .a-name { font-size: 60px; line-height: 65px }
  .c-bar-bg { width: 100% }
}
</style>
