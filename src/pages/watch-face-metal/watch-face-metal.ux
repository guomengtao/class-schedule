    font-size: 12px;
    text-align: center;
    color: #c9a961;
  }

  /* ── 三针：顶部中点压在盘心，向下延伸（引擎轴=顶部中点）── */
  .hand {
    position: absolute;
  }

  .hour {
    left: 89.5px;
    top: 92px;
