<!--
  仿古金属表盘（watch-face-metal）
  ─────────────────────────────────────────────────────────────
  设计：184px 黄铜四层同心表壳 + 罗马数字时标 + 12 整点刻度 + 4 铆钉
        + 三针（做旧黄铜 / 氧化铜）+ 底部日期与数字时间。

  走针方案（沿用 watch-face-evpointer 2026-10-19 实拍标定的定稿路线）：
  ① 禁动态 transform —— `transform: rotate({{deg}}deg)` 数据绑定会整页黑屏；
     只允许字面量 transform。
  ② 禁 @keyframes 承载「当前时刻」—— 实测动画合成不可靠：针角与盘面时间
     不符、粗针周期性整根消失、画面冻结 12s（10 帧 md5 全同）。
  ③ 引擎旋转轴 = 【元素顶部中点】，`transform-origin` 不按 CSS 语义生效。
     故三针一律「顶部中点压在盘心 (92,92) + 向下延伸」，rotate(180+θ) 即指向 θ。
  ④ 角度用 120 档字面量类 `.r0…​.r119`（3° 一档，比 evpointer 的 6° 更细腻），
     每秒只改 class 名、不改 transform 值，引擎走普通样式重算。

  历史背景：本页此前是「找不到旋转轴」时期的试验场，带着 5 种找圆心辅助线、
  5 个预设时刻按钮、停止/继续开关与硬编码版本号。轴已标定明确，全部移除。

  布局铁律：`.page` 只给 position:relative + width/height:100%，
  子元素全部 absolute 手写坐标；不叠 flex 居中（会与 absolute 共同触发黑屏）。
-->

<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd" onclick="onTap">

    <!-- 顶部品牌 -->
    <text class="brand {{brandCls}}">EV</text>
    <text class="brand-sub {{subCls}}">仿古金属</text>

    <!-- 表盘 -->
    <div class="dial-wrap {{dialCls}}">
      <!-- 黄铜表壳：四层同心色阶造厚度（不用渐变） -->
      <div class="ring-outer"></div>
      <div class="ring-mid"></div>
      <div class="ring-in"></div>
      <div class="dial-face"></div>

      <!-- 表壳铆钉 ×4（斜 45°） -->

      <div class="rivet" style="left:147px;top:31px"></div>
      <div class="rivet" style="left:147px;top:147px"></div>
      <div class="rivet" style="left:31px;top:147px"></div>
      <div class="rivet" style="left:31px;top:31px"></div>

      <!-- 12 整点刻度（静态字面量 rotate，安全） -->

      <div class="tick" style="left:91px;top:22px;transform:rotate(0deg)"></div>
      <div class="tick" style="left:126px;top:31.5px;transform:rotate(30deg)"></div>
      <div class="tick" style="left:151.5px;top:57px;transform:rotate(60deg)"></div>
      <div class="tick" style="left:161px;top:92px;transform:rotate(90deg)"></div>
      <div class="tick" style="left:151.5px;top:127px;transform:rotate(120deg)"></div>
      <div class="tick" style="left:126px;top:152.5px;transform:rotate(150deg)"></div>
      <div class="tick" style="left:91px;top:162px;transform:rotate(180deg)"></div>
      <div class="tick" style="left:56px;top:152.5px;transform:rotate(210deg)"></div>
      <div class="tick" style="left:30.5px;top:127px;transform:rotate(240deg)"></div>
      <div class="tick" style="left:21px;top:92px;transform:rotate(270deg)"></div>
      <div class="tick" style="left:30.5px;top:57px;transform:rotate(300deg)"></div>
      <div class="tick" style="left:56px;top:31.5px;transform:rotate(330deg)"></div>

      <!-- 罗马数字时标 I–XII（半径 54） -->

      <text class="roman" style="left:82px;top:30px">XII</text>
      <text class="roman" style="left:109px;top:37px">I</text>
      <text class="roman" style="left:129px;top:57px">II</text>
      <text class="roman" style="left:136px;top:84px">III</text>
      <text class="roman" style="left:129px;top:111px">IV</text>
      <text class="roman" style="left:109px;top:131px">V</text>
      <text class="roman" style="left:82px;top:138px">VI</text>
      <text class="roman" style="left:55px;top:131px">VII</text>
      <text class="roman" style="left:35px;top:111px">VIII</text>
      <text class="roman" style="left:28px;top:84px">IX</text>
      <text class="roman" style="left:35px;top:57px">X</text>
      <text class="roman" style="left:55px;top:37px">XI</text>

      <!-- 三针：顶部中点压在盘心 (92,92)，向下延伸，rotate(180+θ) 指向 θ -->
      <div class="hand hour {{hourCls}}"></div>
      <div class="hand minute {{minuteCls}}"></div>
      <div class="hand second {{secondCls}}"></div>

      <!-- 盘心铜轴 -->
      <div class="hub"></div>
    </div>

    <!-- 底部：日期 / 数字时间 / 返回提示 -->
    <text class="date-line {{dateCls}}">{{dateText}}</text>
    <text class="time-line {{timeCls}}">{{timeText}}</text>
    <text class="back {{backCls}}">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const FULL_DAY = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

function pad2(n) {
  return (n < 10 ? "0" : "") + n
}

// 角度 → 120 档类名（3° 一档）。引擎轴在顶部中点，故 .rN 内部为 rotate(180 + 3N)
function stepClass(deg) {
  let step = Math.round(deg / 3) % 120
  if (step < 0) step += 120
  return "r" + step
}

export default {
  data: {
    hourCls: "r0",
    minuteCls: "r0",
    secondCls: "r0",
    timeText: "--:--",
    dateText: "",
    brandCls: "",
    subCls: "",
    dialCls: "",
    dateCls: "",
    timeCls: "",
    backCls: "",
    touchStartY: 0,
    suppressTap: false,
    timer: null
  },

  onInit() {
    this.fitScreen()
    this.syncHands()
    this.tick()
  },

  /* ── 宽屏适配（336×480，手环 10Pro）──
     本页 onReady 不可靠（同仓 watch-face-functional 实测不触发），故从 onInit 调。
     必须异步 getInfo：同步形式在 192 屏读到 ≥300，会把小屏误判成宽屏。
     必须页内 require：顶部 import 与 require 同一系统模块并存时绑定取不到、静默抛错。 */
  fitScreen() {
    const self = this
    try {
      const dev = require("@system.device")
      dev.getInfo({
        success: function(d) {
          const w = (d && d.screenWidth) ? d.screenWidth : 0
          if (w < 300) return
          self.brandCls = "w-brand"
          self.subCls = "w-sub"
          self.dialCls = "w-dial"
          self.dateCls = "w-date"
          self.timeCls = "w-time"
          self.backCls = "w-back"
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  onReady() {
    this.startTimer()
  },

  onShow() {
    this.syncHands()
    this.tick()
    this.startTimer()
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  /* ── 走针：当前时刻 → 三针角度 → 120 档 class ── */
  syncHands() {
    const now = new Date()
    const h = now.getHours() % 12
    const m = now.getMinutes()
    const s = now.getSeconds()

    this.hourCls = stepClass((h + m / 60 + s / 3600) * 30)
    this.minuteCls = stepClass((m + s / 60) * 6)
    this.secondCls = stepClass(s * 6)
  },

  startTimer() {
    this.stopTimer()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tick() {
    const now = new Date()
    this.timeText = pad2(now.getHours()) + ":" + pad2(now.getMinutes())
    this.dateText = pad2(now.getMonth() + 1) + "-" + pad2(now.getDate()) + " " + FULL_DAY[now.getDay()]
    this.syncHands()
  },

  /* ── 上下滑动切表盘（Vela 无 onswipe，靠 Y 位移手算；阈值 40px）──
     目录环：EV指针表 ← 上滑 ｜ 下滑 → 经典表盘（收尾回绕） */
  onTouchStart(e) {
    const t = (e && e.touches && e.touches[0]) || e || {}
    this.touchStartY = t.clientY || t.offsetY || t.pageY || 0
  },

  onTouchEnd(e) {
    const t = (e && e.touches && e.touches[0]) || (e && e.changedTouches && e.changedTouches[0]) || e || {}
    const endY = t.clientY || t.offsetY || t.pageY || 0
    const d = this.touchStartY ? (this.touchStartY - endY) : 0
    if (d >= 40) {
      this.suppressTap = true
      router.replace({ uri: "/pages/watch-face-evpointer" })
    } else if (d <= -40) {
      this.suppressTap = true
      router.replace({ uri: "/pages/watch-face" })
    }
    this.touchStartY = 0
  },

  /* ── 退出：单击任意位置返回目录（系列统一）── */
  onTap() {
    if (this.suppressTap) return
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  /* 布局铁律：纯 relative + 子元素绝对定位，禁 flex 居中 */
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #12100c;
  }

  /* ── 顶部品牌 ── */
  .brand {
    position: absolute;
    left: 0;
    top: 48px;
    width: 192px;
    height: 26px;
    text-align: center;
    font-size: 22px;
    color: #d8b45a;
    letter-spacing: 3px;
  }

  .brand-sub {
    position: absolute;
    left: 0;
    top: 74px;
