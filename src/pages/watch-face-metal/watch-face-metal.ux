    height: 38px;
    background-color: #d8b45a;
  }

  .minute {
    left: 90px;
    top: 92px;
    width: 4px;
    height: 54px;
    background-color: #e8c877;
  }

  .second {
    left: 91px;
    top: 92px;
    width: 2px;
    height: 72px;
    background-color: #c0562f;
  }

  .hub {
    position: absolute;
    left: 85px;
    top: 85px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #caa64a;
  }

  /* ── 底部信息 ── */
  .date-line {
    position: absolute;
    left: 0;
    top: 352px;
    width: 192px;
    height: 26px;
    text-align: center;
    font-size: 24px;
    color: #b9a86f;
  }

  .time-line {
    position: absolute;
    left: 0;
    top: 386px;
    width: 192px;
    height: 34px;
    text-align: center;
    font-size: 34px;
    color: #f0e2b6;
  }

  .back {
    position: absolute;
    left: 0;
    top: 444px;
    width: 192px;
    height: 26px;
    text-align: center;
    font-size: 24px;
    color: #9a8f72;
  }

  /* ── 宽屏适配：336×480（手环 10Pro）──
     Vela 不支持后代选择器，故全部单类；
     text 基线 width 写死 192px，必须用 width:100% 覆盖，否则 text-align:center 的中心停在 96。
     .w-dial 的 scale(1.5)：盘 184→276，盘心 (30+138, 78+138) = (168,216)，36 个盘内节点零改动。 */
  .w-brand {
    top: 18px;
    width: 100%;
    font-size: 28px;
  }
  .w-sub {
    top: 46px;
    width: 100%;
    font-size: 24px;
  }
  .w-dial {
    left: 30px;
    top: 78px;
    transform: scale(1.5);
  }
  .w-date {
    top: 360px;
    width: 100%;
    height: 26px;
    font-size: 24px;
  }
  .w-time {
    top: 388px;
    width: 100%;
    height: 54px;
    font-size: 52px;
  }
  .w-back {
    top: 446px;
    width: 100%;
    height: 26px;
    font-size: 24px;
    color: #9a8f72;
  }

  /* ── 120 档字面量旋转：rotate(180 + 3N)，180° 使其由「向下」转为「向上」── */
  .r0 { transform: rotate(180deg); }
  .r1 { transform: rotate(183deg); }
