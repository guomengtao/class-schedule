<template>
  <!--
    经典表盘 ① · 最简版
    页面上只有两件事：
      ① 一个可见的「返回」按钮
      ② 点击页面任何位置（含四周空白区）也能返回
    两者都导航到「表盘目录」。
    已撤掉：时钟 / setInterval / 上下滑动 / 长按退出 / 防重入 等全部逻辑。
  -->
  <div class="page" onclick="onTap">
    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"

export default {
  /* 点击页面任意位置（空白区）→ 回表盘目录 */
  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  /* 点击「返回」按钮 → 回表盘目录。
     它会先触发自身、再冒泡到 .page 的 onTap，即导航被调两次；
     这里是幂等的 replace，重复触发只会停在同一个页面，无害。 */
  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .back {
    font-size: 28px;
    color: #e8e4da;
  }
</style>
