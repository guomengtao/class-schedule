<template>
  <!--
    经典表盘 ① · 简单版 + 换色
    页面元素：
      ① 一行大号时间（HH:MM，每分钟刷新），颜色可换
      ② 「换色」按钮 → 弹出颜色选择面板（5 种默认色）
      ③ 「返回」按钮
      ④ 点击页面空白处也能返回
    颜色选择面板用「自绘 overlay」实现 —— 与 backup-restore.ux 的 overlay-modal 同套路，
    不用系统的 prompt.showDialog（项目里无先例，未验证）。
  -->
  <div class="page">
    <!-- ===== 192×490（手环 9）：原版式，一个像素都不改 ===== -->
    <text if="{{ !wide }}" class="clock" style="color: {{ clockColor }}">{{timeText}}</text>
    <text if="{{ !wide }}" class="btn-color" onclick="openPanel">换色</text>
    <text if="{{ !wide }}" class="back" onclick="goBack">返回</text>

    <!-- ===== 宽屏（10Pro 336×480 起）=====
         192 版是「一竖列居中」：68px 时间 + 换色 + 返回 上下叠。缩放到 336 屏后
         时间只占 190/336，左右各空 73px，而纵向反而更挤（480 < 490）。
         故宽屏换版式不换比例：时间放大到 96px 吃满宽度（5×0.6×96+4×4 ≈ 304 ≤ 316 安全区），
         换色与返回由竖排改为横排一行，省下的纵向全部给主数字。 -->
    <text if="{{ wide }}" class="w-clock" style="color: {{ clockColor }}">{{timeText}}</text>
    <div if="{{ wide }}" class="w-actions">
      <text class="w-btn" onclick="openPanel">换色</text>
      <div class="w-sep"></div>
      <text class="w-btn2" onclick="goBack">返回</text>
    </div>

    <!-- 颜色选择面板 -->
    <div class="mask" if="{{ showPanel }}" onclick="closePanel">
      <div if="{{ !wide }}" class="panel">
        <text class="p-title">文字颜色</text>
        <text class="p-item" style="color: #e8e4da" onclick="pick(0)">米白</text>
        <text class="p-item" style="color: #7dffb0" onclick="pick(1)">青绿</text>
        <text class="p-item" style="color: #ffd166" onclick="pick(2)">金色</text>
        <text class="p-item" style="color: #7ec8e3" onclick="pick(3)">天蓝</text>
        <text class="p-item" style="color: #ff8fa3" onclick="pick(4)">玫红</text>
        <text class="p-cancel" onclick="closePanel">取消</text>
      </div>
      <!-- 宽屏面板：240 → 284 撑宽，字号抬到 ev-six 24/28 两档 -->
      <div if="{{ wide }}" class="w-panel">
        <text class="w-p-title">文字颜色</text>
        <text class="w-p-item" style="color: #e8e4da" onclick="pick(0)">米白</text>
        <text class="w-p-item" style="color: #7dffb0" onclick="pick(1)">青绿</text>
        <text class="w-p-item" style="color: #ffd166" onclick="pick(2)">金色</text>
        <text class="w-p-item" style="color: #7ec8e3" onclick="pick(3)">天蓝</text>
        <text class="w-p-item" style="color: #ff8fa3" onclick="pick(4)">玫红</text>
        <text class="w-p-cancel" onclick="closePanel">取消</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"

const storage = require("@system.storage")

const LIST_PAGE = "/pages/watch-face-list"
const COLOR_KEY = "wf_clock_color"
const COLORS = ["#e8e4da", "#7dffb0", "#ffd166", "#7ec8e3", "#ff8fa3"]

export default {
  data: {
    timeText: "--:--",
    clockColor: COLORS[0],
    showPanel: false,
    suppressTap: false,
    wide: false
  },

  onInit() {
    this.loadColor()
    this.fitScreen()
    this.tick()
  },

  /* 屏宽 ≥300 → 宽屏版式（10Pro 336 起）。读不到就按 192 基准渲染，绝不白屏。 */
  fitScreen() {
    const self = this
    device.getInfo({
      success: function(d) {
        if (d && d.screenWidth >= 300) self.wide = true
      },
      fail: function() {}
    })
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* ── 时间：1s 心跳，但只在分钟变化时才写文本，避免无谓重渲染 ── */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const t = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* ── 颜色持久化 ── */
  loadColor() {
    const self = this
    try {
      storage.get({
        key: COLOR_KEY,
        success: function(res) {
          if (res && res.value) self.clockColor = res.value
        },
        fail: function() {}
      })
    } catch (e) {
      /* 存储不可用就用默认色，不影响显示 */
    }
  },

  saveColor(c) {
    try {
      storage.set({ key: COLOR_KEY, value: c })
    } catch (e) {}
  },

  /* ── 面板开关 ──
     打开面板期间用 suppressTap 挡住整页的「点击返回」，
     否则面板里的点击会冒泡到 .page 直接把表盘关掉。 */
  openPanel() {
    this.suppressTap = true
    this.showPanel = true
  },

  closePanel() {
    this.showPanel = false
    const self = this
    setTimeout(function() {
      self.suppressTap = false
    }, 300)
  },

  pick(i) {
    const c = COLORS[i]
    if (!c) return
    this.clockColor = c
    this.saveColor(c)
    this.closePanel()
  },

  /* ── 返回（按钮，系列统一；已移除点击空白返回）── */
  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 主角：大号时间，颜色由 clockColor 绑定 */
  .clock {
    font-size: 68px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .btn-color {
    margin-top: 36px;
    font-size: 22px;
    color: #7ec8e3;
  }

  .back {
    margin-top: 14px;
    font-size: 22px;
    color: #888899;
  }

  /* ── 颜色面板 ── */
  .mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
  }

  .panel {
    width: 240px;
    flex-direction: column;
    align-items: center;
    background-color: #16213e;
    border-radius: 12px;
    padding: 16px 0 12px 0;
  }

  .p-title {
    font-size: 22px;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .p-item {
    font-size: 26px;
    padding: 7px 0;
  }

  .p-cancel {
    margin-top: 8px;
    font-size: 22px;
    color: #888899;
  }

  /* ===== 宽屏（10Pro 336×480 起）版式 =====
     ev-six 约束：可读文字只用 24/28/30/44 四档，24 为绝对下限。
     192 版的 22px 按钮文字在宽屏一律抬到 24 档。
     主数字 96px 属「表盘图形本体」，不套四档——套 44 档就不是表盘了。
     字号取值：HH:MM 共 5 字符，按最坏字宽 0.6F 反算 5×0.6×96 + 4×4(字距) ≈ 304，
     336 减两侧各 10 安全边得 316 → 不裁。等比放大到 120 会到 380，必裁。 */
  .w-clock {
    font-size: 96px;
    font-weight: bold;
    letter-spacing: 4px;
  }

  /* 换色 / 返回 由竖排改横排：纵向省下的空间给主数字 */
  .w-actions {
    margin-top: 44px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .w-btn {
    font-size: 24px;
    color: #7ec8e3;
    padding: 0 18px;
  }

  .w-btn2 {
    font-size: 24px;
    color: #888899;
    padding: 0 18px;
  }

  .w-sep {
    width: 1px;
    height: 24px;
    background-color: #2a3350;
  }

  /* 颜色面板：240 → 284（336 屏两侧各留 26），字号 22/26 → 24/28 */
  .w-panel {
    width: 284px;
    flex-direction: column;
    align-items: center;
    background-color: #16213e;
    border-radius: 14px;
    padding: 18px 0 14px 0;
  }

  .w-p-title {
    font-size: 24px;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .w-p-item {
    font-size: 28px;
    padding: 8px 0;
  }

  .w-p-cancel {
    margin-top: 10px;
    font-size: 24px;
    color: #888899;
  }
</style>
