<template>
  <!--
    经典表盘 ① · 简单版
    页面上就三样，别的一概没有：
      ① 一行大号时间（HH:MM，每分钟自己刷新）
      ② 一个可见的「返回」按钮
      ③ 点击页面任何位置（含四周空白区）也能返回
    不加：上下滑动 / 长按退出 / 秒针 / 日期 / 课程信息。
  -->
  <div class="page" onclick="onTap">
    <text class="clock">{{timeText}}</text>
    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"

export default {
  data: {
    timeText: "--:--"
  },

  onInit() {
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* 1s 一跳：到分钟才重设文本，避免无谓重渲染（Vela 对高频刷新敏感） */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const t = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* 点击页面任意位置（空白区）→ 回表盘目录 */
  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  /* 点击「返回」按钮 → 回表盘目录。
     它会先触发自身、再冒泡到 .page 的 onTap，即导航被调两次；
     这里是幂等的 replace，重复触发只会停在同一个页面，无害。 */
  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 主角：大号时间，水平垂直居中 */
  .clock {
    font-size: 68px;
    color: #e8e4da;
    font-weight: bold;
    letter-spacing: 2px;
  }

  /* 返回按钮：低调灰字，挂在时间下方 */
  .back {
    margin-top: 44px;
    font-size: 22px;
    color: #888899;
  }
</style>
