<template>
  <!--
    经典表盘 ① · 极简 —— 全屏只留一行动态大数字，不留任何按钮、不画任何元素。
    退出（两条，全部隐形，不占画面）：
      ① 长按屏幕 2 秒 —— 松手即中止计时（防误触），满 2 秒震动一下并回表盘目录
      ② 双击屏幕（两次间隔 <500ms）—— 直接回表盘目录
    切换：上滑 → ⑤仿古金属表盘；下滑 → ②课程表盘。
    Vela 无 onswipe，滑动方向靠 touchstart/touchend 手算 Y 位移。
  -->
  <div class="page"
       ontouchstart="onTouchStart"
       ontouchend="onTouchEnd"
       onlongpress="onLongPress"
       onclick="onTap">
    <text class="clock">{{timeText}}</text>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"

const SWIPE_MIN = 40   // 判定为滑动的最小 Y 位移
const LONG_PRESS_MS = 2000
const DOUBLE_TAP_MS = 500

export default {
  data: {
    timeText: "--:--",
    touchStartY: 0,
    pressTimer: null,
    lastTap: 0
  },

  onInit() {
    this.tick()
  },

  onReady() {
    this.timer = setInterval(() => this.tick(), 1000)
  },

  onHide() {
    this.clearPress()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
    this.clearPress()
  },

  tick() {
    const now = new Date()
    this.timeText = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* ── 退出途径一：长按 2 秒 ── */
  onLongPress() {
    const self = this
    this.clearPress()
    this.pressTimer = setTimeout(function() {
      self.exit()
    }, LONG_PRESS_MS)
  },

  clearPress() {
    if (this.pressTimer) {
      clearTimeout(this.pressTimer)
      this.pressTimer = null
    }
  },

  /* ── 退出途径二：单击任意位置（主路径）──
     单击即返回，所以「双击」在效果上同样成立（第一击就退出去了）。── */
  onTap() {
    const now = new Date().getTime()
    if (this.lastTap && (now - this.lastTap) < DOUBLE_TAP_MS) {
      this.lastTap = 0
      this.exit()
      return
    }
    this.lastTap = now
    this.exit()
  },

  /* ── 上下滑动切换表盘（环：①经典 上滑→⑤仿古金属 / 下滑→②课程） ── */
  onTouchStart(e) {
    const t = (e && e.touches && e.touches[0]) || e || {}
    this.touchStartY = t.clientY || t.offsetY || t.pageY || 0
  },

  onTouchEnd(e) {
    this.clearPress()   // 松手即中止长按计时，避免误退出
    const t = (e && e.touches && e.touches[0]) || (e && e.changedTouches && e.changedTouches[0]) || e || {}
    const endY = t.clientY || t.offsetY || t.pageY || 0
    const d = this.touchStartY ? (this.touchStartY - endY) : 0
    if (d >= SWIPE_MIN) {
      router.replace({ uri: "/pages/watch-face-metal" })
    } else if (d <= -SWIPE_MIN) {
      router.replace({ uri: "/pages/watch-face-class" })
    }
    this.touchStartY = 0
  },

  exit() {
    this.clearPress()
    this.lastTap = 0
    try {
      vibrator.vibrate({ mode: "short" })
    } catch (e) {
      /* 无震动模块不影响退出 */
    }
    // 用 replace 精确落到「表盘目录」，不依赖返回栈 ——
    // back() 在 replace 切换过页面的场景下会落到已销毁的页面，是黑屏高发点。
    router.replace({ uri: "/pages/watch-face-list" })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 全屏唯一元素：大号等宽数字，水平垂直居中 */
  .clock {
    font-size: 68px;
    color: #e8e4da;
    font-weight: bold;
    letter-spacing: 2px;
  }
</style>
