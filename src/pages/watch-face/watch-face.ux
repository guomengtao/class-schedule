<template>
  <!--
    经典表盘 · 最小 demo（排障专用，临时版）
    目的：隔离「返回黑屏」到底出在表盘页，还是在目标页 / 导航本身。

    刻意剔除一切可疑变量：
      ✗ 时钟与 setInterval   ✗ 上下滑动（touchstart/touchend）
      ✗ 整页 onclick         ✗ onlongpress      ✗ import vibrator
      ✗ router.replace       ✗ exit()/防重入
    .page 上零事件绑定，只有一个子元素「返回」，用最朴素的 router.back()。
  -->
  <div class="page">
    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  goBack() {
    router.back()
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .back {
    font-size: 28px;
    color: #e8e4da;
  }
