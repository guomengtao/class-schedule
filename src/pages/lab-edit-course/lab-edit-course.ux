  line-height: 44px;
  font-weight: bold;
  text-align: center;
  height: 48px;
  background-color: transparent;
  border: none;
}

@media (shape: circle) {
  .page-root {
    padding: 44px 36px 44px 36px;
  }
  .back-btn {
    width: 52px;
    height: 40px;
    font-size: 24px;
  }
  .title {
    font-size: 36px;
    line-height: 48px;
  }
  .step-heading {
    font-size: 34px;
    line-height: 44px;
  }
  .step-sub {
    font-size: 28px;
    line-height: 38px;
  }
  .card-name {
    font-size: 36px;
  }
  .course-card {
    width: 200px;
    height: 120px;
    padding: 24px;
  }
  .arrow-btn-icon {
    width: 50px;
    height: 50px;
    border-radius: 25px;
  }
  .dot {
    width: 20px;
    height: 20px;
    border-radius: 10px;
  }
  .dot-line {
    width: 40px;
    margin: 0 4px;
  }
  .manage-btn,
  .next-btn,
  .prev-btn,
  .save-btn {
    width: 100px;
    font-size: 28px;
  }
  .stepper-btn {
    width: 48px;
    height: 40px;
    font-size: 28px;
  }
  .stepper-num {
    font-size: 40px;
  }
  .confirm-label {
    font-size: 32px;
  }
  .confirm-value {
    font-size: 34px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .page-root {
    padding: 30px 16px 30px 16px;
  }
  .back-btn {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    font-size: 24px;
    line-height: 44px;
  }
