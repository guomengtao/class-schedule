  flex-direction: column;
  flex: 1;
}

.step-heading {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  margin-bottom: 6px;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.step-sub {
  font-size: 22px;
  line-height: 32px;
  margin-bottom: 10px;
  text-align: center;
  max-lines: 1;
  text-overflow: ellipsis;
}

.swiper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.arrow-btn-icon {
  width: 36px;
  height: 36px;
  border-radius: 18px;
}

.course-card {
  flex-direction: column;
  align-items: center;
