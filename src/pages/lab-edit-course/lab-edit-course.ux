  font-size: 20px;
  line-height: 28px;
  margin-bottom: 8px;
  text-align: center;
}

.nav-row {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 12px;
}

.manage-btn {
  width: 72px;
  border-radius: 24px;
  font-size: 24px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  height: 48px;
  background-color: transparent;
  border: none;
}

.next-btn {
  width: 72px;
  border-radius: 24px;
  font-size: 24px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
  height: 48px;
  background-color: transparent;
  border: none;
}

