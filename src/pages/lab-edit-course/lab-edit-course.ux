}

.confirm-label {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  margin-top: 6px;
  margin-bottom: 2px;
}

.confirm-value {
  font-size: 28px;
  line-height: 38px;
  max-lines: 1;
  text-overflow: ellipsis;
}

.delete-row {
