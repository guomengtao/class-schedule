<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="title" style="color: {{ theme.text }}">编辑课程(胶囊)</text>
      <div class="trash-btn" onclick="onDeleteCourse" style="background-color: {{ deleteConfirm ? theme.deleteText : theme.deleteBg }}">
        <image class="trash-icon" src="/common/icons/{{ iconTheme }}/icon_trash.png"></image>
      </div>
    </div>

    <div class="step-dots">
      <div class="dot {{ step >= 1 ? 'dot-active' : '' }}" style="background-color: {{ step >= 1 ? theme.accent : theme.border }}"></div>
      <div class="dot-line {{ step >= 2 ? 'line-active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></div>
      <div class="dot {{ step >= 2 ? 'dot-active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></div>
      <div class="dot-line {{ step >= 3 ? 'line-active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></div>
      <div class="dot {{ step >= 3 ? 'dot-active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></div>
      <div class="dot-line {{ step >= 4 ? 'line-active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></div>
      <div class="dot {{ step >= 4 ? 'dot-active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></div>
    </div>

    <div class="form-body" if="{{ step === 1 }}">
      <text class="step-heading" style="color: {{ theme.text }}">选择课程</text>
      <text class="step-sub" style="color: {{ theme.textSecondary }}">共 {{ demoCourses.length }} 门</text>

      <div class="swiper-row">
        <image class="arrow-btn-icon" src="/common/icons/{{ iconTheme }}/icon_arrow_left.png" onclick="swipePrev" style="background-color: {{ theme.cardLight }}" />
        <div class="course-card" onclick="swipeNext" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
          <text class="card-name" style="color: {{ theme.text }}">{{ demoCourses[courseIndex].name }}</text>
        </div>
        <image class="arrow-btn-icon" src="/common/icons/{{ iconTheme }}/icon_arrow_right.png" onclick="swipeNext" style="background-color: {{ theme.cardLight }}" />
      </div>

      <text class="index-text" style="color: {{ theme.textMuted }}">{{ courseIndex + 1 }} / {{ demoCourses.length }}</text>

      <div class="nav-row">
        <input class="manage-btn" type="button" value="管理" onclick="openCourseManager"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-body" if="{{ step === 2 }}">
      <text class="step-heading" style="color: {{ theme.text }}">时间 · {{ courseName }}</text>

      <scroll class="time-scroll" scroll-y="true">
        <text class="time-label" style="color: {{ theme.text }}">开始时间</text>
        <div class="time-card" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ startHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">分</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ startMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

        <text class="time-label" style="color: {{ theme.text }}">结束时间</text>
        <div class="time-card" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ endHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndHour"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-tag" style="color: {{ theme.text }}">分</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-num" style="color: {{ theme.text }}">{{ endMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndMin"
                   style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>
      </scroll>

      <div class="nav-row">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-body" if="{{ step === 3 }}">
      <text class="step-heading" style="color: {{ theme.text }}">位置</text>
      <text class="step-sub" style="color: {{ theme.textSecondary }}">{{ courseName }} | {{ courseTime }}</text>

      <div class="location-box" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="location-val" style="color: {{ courseLocation ? theme.text : theme.textMuted }}">{{ courseLocation || '如：301教室' }}</text>
      </div>
      <text class="optional-tip" style="color: {{ theme.textMuted }}">选填</text>

      <div class="nav-row">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-body" if="{{ step === 4 }}">
      <text class="step-heading" style="color: {{ theme.text }}">确认</text>

      <scroll class="confirm-scroll" scroll-y="true">
        <div class="confirm-card" style="background-color: {{ theme.card }}">
          <text class="confirm-label" style="color: {{ theme.accent }}">课程</text>
          <text class="confirm-value" style="color: {{ theme.text }}">{{ courseName }}</text>
          <text class="confirm-label" style="color: {{ theme.accent }}">时间</text>
          <text class="confirm-value" style="color: {{ theme.text }}">{{ courseTime }}</text>
          <text class="confirm-label" style="color: {{ theme.accent }}">位置</text>
          <text class="confirm-value" style="color: {{ theme.text }}">{{ courseLocation || '(无)' }}</text>
        </div>
      </scroll>

      <div class="nav-row">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="save-btn" type="button" value="更新" onclick="onUpdateCourse"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="delete-row">
        <input class="delete-btn" type="button" value="{{ deleteConfirm ? '确认删除' : '删除课程' }}" onclick="onDeleteCourse"
               style="background-color: {{ deleteConfirm ? theme.deleteText : theme.deleteBg }}; color: {{ deleteConfirm ? theme.text : theme.deleteText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")

var demoCourses = [
  { name: "语文", time: "08:00 - 08:45" },
  { name: "数学", time: "08:55 - 09:40" },
  { name: "英语", time: "10:00 - 10:45" },
  { name: "物理", time: "10:55 - 11:40" },
  { name: "化学", time: "13:00 - 13:45" },
  { name: "政治", time: "13:55 - 14:40" },
  { name: "历史", time: "15:00 - 15:45" },
  { name: "体育", time: "15:55 - 16:40" }
]

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

function formatTime(h, m) {
  return padZero(h) + ":" + padZero(m)
}

export default {
  private: {
    demoCourses: demoCourses,
    courseIndex: 2,
    courseName: "",
    courseTime: "",
    courseLocation: "",
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    step: 1,
    deleteConfirm: false,
    iconTheme: "dark",
    deleteTimer: null,
    showCursor: false,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.initDemoData()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.courseLocation = data
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  initDemoData() {
    this.courseIndex = 2
    var c = this.demoCourses[2]
    this.courseName = c.name
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
    this.courseTime = c.time
    this.courseLocation = "301教室"
  },

  selectCourse(index) {
    this.courseIndex = index
    var c = this.demoCourses[index]
    this.courseName = c.name
    this.courseTime = c.time
    var tp = parseTimeParts(c.time)
    this.startHour = tp.startH
    this.startMin = tp.startM
    this.endHour = tp.endH
    this.endMin = tp.endM
  },

  swipePrev() {
    if (this.courseIndex > 0) {
      this.courseIndex = this.courseIndex - 1
      this.courseName = this.demoCourses[this.courseIndex].name
    }
  },

  swipeNext() {
    if (this.courseIndex < this.demoCourses.length - 1) {
      this.courseIndex = this.courseIndex + 1
      this.courseName = this.demoCourses[this.courseIndex].name
    }
  },

  updateTimeString() {
    this.courseTime = formatTime(this.startHour, this.startMin) + " - " + formatTime(this.endHour, this.endMin)
  },

  increaseStartHour() { if (this.startHour < 23) { this.startHour++ } else { this.startHour = 0 } this.updateTimeString() },
  decreaseStartHour() { if (this.startHour > 0) { this.startHour-- } else { this.startHour = 23 } this.updateTimeString() },
  increaseStartMin() { if (this.startMin < 59) { this.startMin++ } else { this.startMin = 0 } this.updateTimeString() },
  decreaseStartMin() { if (this.startMin > 0) { this.startMin-- } else { this.startMin = 59 } this.updateTimeString() },
  increaseEndHour() { if (this.endHour < 23) { this.endHour++ } else { this.endHour = 0 } this.updateTimeString() },
  decreaseEndHour() { if (this.endHour > 0) { this.endHour-- } else { this.endHour = 23 } this.updateTimeString() },
  increaseEndMin() { if (this.endMin < 59) { this.endMin++ } else { this.endMin = 0 } this.updateTimeString() },
  decreaseEndMin() { if (this.endMin > 0) { this.endMin-- } else { this.endMin = 59 } this.updateTimeString() },

  nextStep() {
    if (this.step < 4) { this.step = this.step + 1 }
  },

  prevStep() {
    if (this.step > 1) { this.step = this.step - 1 }
  },

  goBack() {
    router.back()
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "上课地点", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "如：301教室", success: function() {} })
    storage.set({ key: "chinese_input_value", value: this.courseLocation, success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "10", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  onUpdateCourse() {
    if (!this.courseName) {
      prompt.showToast({ message: "请选择课程" })
      return
    }
    if (!this.courseTime) {
      prompt.showToast({ message: "请设置时间" })
      return
    }
    prompt.showToast({ message: "课程已更新 (Demo)" })
    router.back()
  },

  onDeleteCourse() {
    if (!this.deleteConfirm) {
      this.deleteConfirm = true
      var self = this
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirm = false
      }, 5000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    prompt.showToast({ message: "课程已删除 (Demo)" })
    router.back()
  },

  onDestroy() {
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
  }
}
</script>

<style>
.page-root {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 30px 6px 30px 6px;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
  flex-shrink: 0;
  height: 48px;
}

.back-btn {
  width: 48px;
  height: 40px;
  border-radius: 20px;
  font-size: 24px;
  line-height: 36px;
  text-align: center;
  background-color: transparent;
  border: none;
  flex-shrink: 0;
}

.title {
  font-size: 28px;
  line-height: 44px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  lines: 1;
  margin: 0 4px;
}

.trash-btn {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.trash-icon {
  width: 24px;
  height: 24px;
}

.step-dots {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
}

.dot-line {
  width: 24px;
  height: 3px;
  margin: 0 2px;
}

