<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="back" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">Schedule</text>
    </div>

    <scroll class="scroll-wrap">
      <div class="grid">
        <div class="grid-row header-row">
          <text class="day-label" for="day in days" style="color: {{ theme.accent }}; font-weight: bold;">{{ day }}</text>
        </div>

        <div class="grid-row" for="(rowIdx, row) in schedule">
          <div class="cell-wrap" for="(colIdx, cls) in row">
            <div if="{{cls.ch}}" class="block" style="background-color: {{ cls.color }};">
              <text class="block-text">{{ cls.ch }}</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var COLORS = {
  math: "#4A90D9",
  eng: "#50B86C",
  chn: "#9B59B6",
  phy: "#E67E22",
  pe: "#E74C3C",
  chem: "#1ABC9C",
  bio: "#F39C12",
  history: "#3498DB",
  geo: "#E91E63"
}

export default {
  private: {
    theme: {},
    days: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94"],
    schedule: [
      [
        { ch: "\u6570", color: COLORS.math },
        { ch: "\u82f1", color: COLORS.eng },
        {},
        { ch: "\u8bed", color: COLORS.chn },
        { ch: "\u7269", color: COLORS.phy }
      ],
      [
        { ch: "\u82f1", color: COLORS.eng },
        { ch: "\u6570", color: COLORS.math },
        { ch: "\u7269", color: COLORS.phy },
        {},
        { ch: "\u6570", color: COLORS.math }
      ],
      [
        {},
        { ch: "\u8bed", color: COLORS.chn },
        { ch: "\u6570", color: COLORS.math },
        { ch: "\u82f1", color: COLORS.eng },
        {}
      ],
      [
        { ch: "\u4f53", color: COLORS.pe },
        {},
        { ch: "\u82f1", color: COLORS.eng },
        { ch: "\u6570", color: COLORS.math },
        { ch: "\u8bed", color: COLORS.chn }
      ],
      [
        { ch: "\u5316", color: COLORS.chem },
        { ch: "\u5316", color: COLORS.chem },
        { ch: "\u8bed", color: COLORS.chn },
        {},
        { ch: "\u4f53", color: COLORS.pe }
      ]
    ]
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  goBack() {
    router.back()
  }
}
</script>

