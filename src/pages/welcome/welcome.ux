  flex-direction: column;
  align-items: center;
  margin-bottom: 24px;
}

.app-name {
  font-size: 36px;
  font-weight: bold;
  margin-bottom: 8px;
  line-height: 44px;
}

.app-subtitle {
  font-size: 20px;
  line-height: 28px;
}

.action-area {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.enter-btn {
  width: 220px;
  height: 52px;
  border-radius: 26px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin-bottom: 16px;
  line-height: 28px;
}

.settings-btn {
  width: 180px;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  text-align: center;
  border-width: 0;
  line-height: 28px;
}

@media (shape: circle) {
  .home-page {
    padding: 44px 36px;
  }
  .app-name {
    font-size: 28px;
    margin-bottom: 4px;
  }
  .app-subtitle {
    font-size: 20px;
  }
  .enter-btn {
    width: 180px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    margin-bottom: 12px;
  }
  .settings-btn {
    width: 160px;
    height: 44px;
    border-radius: 22px;
    font-size: 20px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .home-page {
    padding: 60px 12px 30px 12px;
  }
  .app-name {
    font-size: 30px;
  }
  .enter-btn {
    width: 160px;
    max-width: 100%;
    height: 48px;
    font-size: 22px;
    line-height: 32px;
  }
  .settings-btn {
    width: 140px;
    max-width: 100%;
    height: 40px;
    border-radius: 20px;
    font-size: 20px;
    line-height: 30px;
  }
}

@media (shape: rect) {
  .home-page {
    padding: 44px 8px 20px 8px;
  }
}
</style>