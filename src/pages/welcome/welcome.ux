<template>
  <div class="home-page" style="background-color: {{ theme.bg }}">
    <div class="logo-area">
      <text class="app-name" style="color: {{ theme.accent }}">Ev课程表</text>
      <text class="app-subtitle" style="color: {{ theme.textSecondary }}">你的随身课程助手</text>
      <text class="app-version" style="color: {{ theme.textMuted }}">v{{ versionName }}</text>
    </div>

    <div class="action-area">
      <input class="enter-btn" type="button" value="进入首页" onclick="enterSchedule" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="settings-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <!-- 显式退出入口：作为返回键在某些运行时不生效时的最后兜底 -->
      <input class="exit-btn" type="button" value="退出" onclick="exitApp" style="background-color: {{ theme.cardLight }}; color: {{ theme.textSecondary }}" />
    </div>
  </div>
</template>

<script>
const store = require("../../data/store.js")
const version = require("../../data/version.js")

// ── 探针对照组（临时诊断，定位完整体删除）────────────────────────────────
// 欢迎页是「能正常显示」的页面。在这里写一个对照标记，用来证明
// **storage 写入在真机上确实能落盘**：
//   · 有对照标记、但 index_boot_stage 无记录 → 首页模块真的没开始执行（加载期挂）
//   · 连对照标记都没有 → 写入本身没落盘，探针方案不成立，得换取证通道
// 见 docs/首页黑屏并重启-深度分析.md 第 12 章。
var BOOT_CONTROL_KEY = "boot_probe_welcome"
function bootControlStamp(tag) {
  try {
    var t = new Date()
    function p(v) { return v < 10 ? "0" + v : "" + v }
    var at = p(t.getMonth() + 1) + "-" + p(t.getDate()) + " " + p(t.getHours()) + ":" + p(t.getMinutes()) + ":" + p(t.getSeconds())
    var storage = require("@system.storage")
    storage.set({
      key: BOOT_CONTROL_KEY,
      value: tag + " · " + at,
      success: function() {},
      fail: function() {}
    })
  } catch (e) {}
}
bootControlStamp("欢迎页模块求值")

// 极简快速启动：欢迎页只做静态展示 + 一次主题/默认首页读取，
// 不再预热首页数据（课程库、字号、课表名等由首页按需加载，store 自带缓存）。

export default {
  private: {
    versionName: version.versionName,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    targetPage: "index"
  },

  onInit() {
    var self = this
    // 对照组二次打点：页面已经显示出来了再写一次，确保落盘（见文件顶部说明）
    bootControlStamp("欢迎页 onInit")
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getDefaultHomepage(function(settings) {
      self.targetPage = settings.targetPage || "index"
    })
  },

  enterSchedule() {
    var router = require("@system.router")
    var uri = "/pages/" + this.targetPage
    router.replace({
      uri: uri
    })
  },

  openSettings() {
    var router = require("@system.router")
    router.push({ uri: "/pages/settings" })
  },

  exitApp() {
    var utils = require("../../data/utils.js")
    var ok = utils.exitApp()
    if (!ok) {
      // 运行时不提供任何退出入口时，明确告知用户改用系统手势，避免"点了没反应"
      var prompt = require("@system.prompt")
      prompt.showToast({ message: "请用系统手势退出应用" })
    }
  },

  onBackPress() {
    // 只有主动退出成功才消费返回键（return true）。
    // 若退出入口不可用却仍 return true，返回键会被"吃掉"且毫无反应——
    // 这正是"安装后无法退出"的根因。失败时必须 return false 交还系统默认行为。
    var utils = require("../../data/utils.js")
    return utils.exitApp() === true
  }
}
</script>

<style>
