<template>
  <div class="home-page" style="background-color: {{ theme.bg }}">
    <div class="logo-area">
      <text class="app-name" style="color: {{ theme.accent }}">Ev课程表</text>
      <text class="app-subtitle" style="color: {{ theme.textSecondary }}">你的随身课程助手</text>
    </div>

    <div class="countdown-area" show="{{ showCountdown }}">
      <text class="countdown-text" style="color: {{ theme.accent }}">{{ countdownText }}</text>
      <text class="countdown-hint" style="color: {{ theme.textSecondary }}">即将进入 {{ targetPageLabel }}</text>
    </div>

    <div class="action-area">
      <input class="enter-btn" type="button" value="进入{{ targetPageLabel }}" onclick="enterSchedule" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="settings-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
    </div>
  </div>
</template>

<script>
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    showCountdown: false,
    countdownText: "",
    targetPageLabel: "标准页",
    targetPage: "index-full",
    autoSeconds: 3,
    countdownRemaining: 0,
    countdownTimer: null
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    this.loadDefaultHomepage()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    }, true)
    if (!self._hasEntered) {
      this.loadDefaultHomepage(true)
    }
  },

  onDestroy() {
    this.stopCountdown()
  },

  loadDefaultHomepage(forceRefresh) {
    var self = this
    store.getDefaultHomepage(function(settings) {
      self.targetPage = settings.targetPage || "index-full"
      self.autoSeconds = settings.autoSeconds
      if (self.autoSeconds === undefined || self.autoSeconds === null) self.autoSeconds = 3
      self.targetPageLabel = self.targetPage === "week-view" ? "总课表" : "标准页"
      console.log("[INDEX] loadDefaultHomepage: autoSeconds=" + self.autoSeconds + " targetPage=" + self.targetPage)
      self.startCountdownIfNeeded()
    }, forceRefresh)
  },

  startCountdownIfNeeded() {
    this.stopCountdown()
    var self = this
    console.log("[INDEX] startCountdownIfNeeded: autoSeconds=" + self.autoSeconds + " showCountdown=" + self.showCountdown)
    if (self.autoSeconds === -1) {
      self.showCountdown = false
      self.countdownText = ""
      return
    }
    self.countdownRemaining = self.autoSeconds
    if (self.countdownRemaining === 0) {
      self.showCountdown = false
      self.doEnter()
      return
    }
    self.showCountdown = true
    self.updateCountdownText()
    console.log("[INDEX] starting countdown: remaining=" + self.countdownRemaining + " showCountdown=" + self.showCountdown)
    self.countdownTimer = setInterval(function() {
      self.countdownRemaining = self.countdownRemaining - 1
      if (self.countdownRemaining <= 0) {
        self.stopCountdown()
        self.showCountdown = false
        self.doEnter()
      } else {
        self.updateCountdownText()
      }
    }, 1000)
  },

  updateCountdownText() {
    this.countdownText = String(this.countdownRemaining)
  },

  stopCountdown() {
    if (this.countdownTimer) {
      clearInterval(this.countdownTimer)
      this.countdownTimer = null
    }
  },

  doEnter() {
    if (this._hasEntered) {
      return
    }
    this._hasEntered = true
    var router = require("@system.router")
    var uri = "/pages/" + this.targetPage
    router.replace({ uri: uri })
  },

  enterSchedule() {
    if (this._hasEntered) {
      return
    }
    this._hasEntered = true
    this.stopCountdown()
    var router = require("@system.router")
    var uri = "/pages/" + this.targetPage
    router.replace({ uri: uri })
  },

  openSettings() {
    this.stopCountdown()
    var router = require("@system.router")
    router.push({ uri: "/pages/settings" })
  }
}
</script>

<style>
.home-page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 20px;
}

.logo-area {
  flex-direction: column;
  align-items: center;
  margin-bottom: 24px;
}

.app-name {
  font-size: 36px;
  font-weight: bold;
  margin-bottom: 8px;
  line-height: 44px;
}

.app-subtitle {
  font-size: 16px;
  line-height: 22px;
}

.countdown-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.countdown-text {
  font-size: 56px;
  font-weight: bold;
  line-height: 64px;
}

.countdown-hint {
  font-size: 14px;
  margin-top: 4px;
  line-height: 20px;
}

.action-area {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.enter-btn {
  width: 220px;
  height: 52px;
  border-radius: 26px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin-bottom: 16px;
  line-height: 28px;
}

.settings-btn {
  width: 160px;
  height: 44px;
  border-radius: 22px;
  font-size: 16px;
  text-align: center;
  border-width: 0;
  line-height: 22px;
}

@media (shape: circle) {
  .home-page {
    padding: 44px 36px;
  }
  .app-name {
    font-size: 28px;
    margin-bottom: 4px;
  }
  .app-subtitle {
    font-size: 14px;
  }
  .countdown-text {
    font-size: 44px;
  }
  .countdown-hint {
    font-size: 12px;
  }
  .enter-btn {
    width: 180px;
    height: 46px;
    border-radius: 23px;
    font-size: 18px;
    margin-bottom: 12px;
  }
  .settings-btn {
    width: 140px;
    height: 40px;
    border-radius: 20px;
    font-size: 14px;
  }
}

@media (shape: capsule) {
  .home-page {
    padding: 44px 12px 20px 12px;
  }
  .app-name {
    font-size: 30px;
  }
  .enter-btn {
    width: 200px;
    height: 48px;
    font-size: 19px;
  }
}

@media (shape: rect) {
  .home-page {
    padding: 44px 8px 20px 8px;
  }
}
</style>