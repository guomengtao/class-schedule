  width: 220px;
  height: 52px;
  border-radius: 26px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin-bottom: 16px;
  line-height: 28px;
}

.settings-btn {
  width: 180px;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  text-align: center;
  border-width: 0;
  line-height: 28px;
}

.exit-btn {
  width: 180px;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  text-align: center;
  border-width: 0;
  line-height: 28px;
  margin-top: 12px;
}

@media screen and (shape: circle) {
  .home-page {
    padding: 44px 36px;
  }
  .app-name {
    font-size: 28px;
    margin-bottom: 4px;
  }
  .app-subtitle {
    font-size: 20px;
  }
  .enter-btn {
    width: 180px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    margin-bottom: 12px;
  }
  /* 原为 44px（低于 48px 规范），提到 48px */
  .settings-btn {
    width: 160px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
  }
  .exit-btn {
    width: 160px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    margin-top: 12px;
  }
}

@media screen and (shape: pill-shaped) {
  .home-page {
    padding: 60px 12px 30px 12px;
  }
  .app-name {
    font-size: 30px;
  }
  .enter-btn {
    width: 160px;
    max-width: 100%;
    height: 48px;
    font-size: 22px;
    line-height: 32px;
  }
  /* 原为 40px（低于 48px 规范），提到 48px */
  .settings-btn {
    width: 140px;
    max-width: 100%;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    line-height: 30px;
  }
  .exit-btn {
    width: 140px;
