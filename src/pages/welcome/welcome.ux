<template>
  <div class="home-page" style="background-color: {{ theme.bg }}">
    <div class="logo-area">
      <text class="app-name" style="color: {{ theme.accent }}">Ev课程表</text>
      <text class="app-subtitle" style="color: {{ theme.textSecondary }}">你的随身课程助手</text>
    </div>

    <div class="action-area">
      <input class="enter-btn" type="button" value="进入首页" onclick="enterSchedule" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="settings-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <!-- 显式退出入口：作为返回键在某些运行时不生效时的最后兜底 -->
      <input class="exit-btn" type="button" value="退出" onclick="exitApp" style="background-color: {{ theme.cardLight }}; color: {{ theme.textSecondary }}" />
    </div>

    <text class="app-version" style="color: {{ theme.bg }}; background-color: {{ theme.accent }}">v{{ versionName }}</text>
  </div>
</template>

<script>
const store = require("../../data/store.js")
const version = require("../../data/version.js")

// 极简快速启动：欢迎页只做静态展示 + 一次主题/默认首页读取，
// 不再预热首页数据（课程库、字号、课表名等由首页按需加载，store 自带缓存）。

export default {
  private: {
    versionName: version.versionName,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    targetPage: "index"
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getDefaultHomepage(function(settings) {
      self.targetPage = settings.targetPage || "index"
    })
  },

  enterSchedule() {
    var router = require("@system.router")
    var uri = "/pages/" + this.targetPage
    router.replace({
      uri: uri
    })
  },

  openSettings() {
    var router = require("@system.router")
    router.push({ uri: "/pages/settings" })
  },

  exitApp() {
    var utils = require("../../data/utils.js")
    var ok = utils.exitApp()
    if (!ok) {
      // 运行时不提供任何退出入口时，明确告知用户改用系统手势，避免"点了没反应"
      var prompt = require("@system.prompt")
      prompt.showToast({ message: "请用系统手势退出应用" })
    }
  },

  onBackPress() {
    // 只有主动退出成功才消费返回键（return true）。
    // 若退出入口不可用却仍 return true，返回键会被"吃掉"且毫无反应——
    // 这正是"安装后无法退出"的根因。失败时必须 return false 交还系统默认行为。
    var utils = require("../../data/utils.js")
    return utils.exitApp() === true
  }
}
</script>

<style>

/* ================================================================
   BASE CSS = 手环 9 基准（160px 内容区）
   手环 9 默认命中，无需任何 media query。
   弹性 flex + % 撑满。屏幕增大时，下方宽度断点「增量」调整。
   原则：base 属性一旦设定，大屏断点只改物理必须区分的值，不覆盖。
   触底自适应方案详见 .trae/rules/project_rules.md Section 10
   ================================================================ */

.home-page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 60px 12px 30px 12px;
}

.logo-area {
  flex-direction: column;
  align-items: center;
  margin-bottom: 16px;
}

.app-name {
  font-size: 30px;
  font-weight: bold;
  margin-bottom: 4px;
  line-height: 38px;
}

.app-subtitle {
  font-size: 18px;
  line-height: 24px;
}

.app-version {
  font-size: 22px;
  font-weight: bold;
  line-height: 28px;
  margin-top: 16px;
  padding: 2px 12px;
  border-radius: 14px;
}

.action-area {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.enter-btn {
  width: 160px;
  max-width: 100%;
  height: 48px;
  border-radius: 24px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin-bottom: 12px;
  line-height: 32px;
}

.settings-btn {
  width: 140px;
  max-width: 100%;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  text-align: center;
  border-width: 0;
  line-height: 30px;
}

.exit-btn {
  width: 140px;
  max-width: 100%;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  text-align: center;
  border-width: 0;
  line-height: 30px;
  margin-top: 12px;
}


/* ================================================================
   宽度断点：手环 10 / 胶囊屏大号（width >= 200px）
   在 base 基础上「增量」：字号变大、按钮加宽、间距放松。
   ================================================================ */
@media (width >= 200px) {
  .home-page {
    padding: 20px;
  }
  .logo-area {
    margin-bottom: 24px;
  }
  .app-name {
    font-size: 36px;
    margin-bottom: 8px;
    line-height: 44px;
  }
  .app-subtitle {
    font-size: 20px;
    line-height: 28px;
  }
  .app-version {
    font-size: 24px;
    line-height: 32px;
    padding: 4px 14px;
    border-radius: 16px;
  }
  .enter-btn {
    width: 220px;
    height: 52px;
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 16px;
  }
  .settings-btn {
    width: 180px;
    font-size: 20px;
    line-height: 28px;
  }
  .exit-btn {
    width: 180px;
    font-size: 20px;
    line-height: 28px;
  }
}


/* ================================================================
   宽度断点：Watch 6 / 方屏（width >= 400px）
   rect 屏上下空间充裕，顶部 padding 大幅压缩。
   ================================================================ */
@media (width >= 400px) {
  .home-page {
    padding: 6px 8px 20px 8px;
  }
}


/* ================================================================
   圆形表盘（唯一保留的 shape 查询——圆方不同构，非宽度可替代）
   手环 9 不会命中此分支，天然安全。
   ================================================================ */
@media (shape: circle) {
  .home-page {
    padding: 44px 36px;
  }
  .app-name {
    font-size: 28px;
    margin-bottom: 4px;
    line-height: 36px;
  }
  .app-subtitle {
    font-size: 20px;
    line-height: 28px;
  }
  .app-version {
    font-size: 18px;
    line-height: 24px;
    padding: 2px 10px;
    border-radius: 12px;
  }
  .enter-btn {
    width: 180px;
    height: 48px;
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 12px;
  }
  .settings-btn {
    width: 160px;
    height: 48px;
    font-size: 20px;
    line-height: 28px;
  }
  .exit-btn {
    width: 160px;
    height: 48px;
    font-size: 20px;
    line-height: 28px;
    margin-top: 12px;
  }
}
</style>