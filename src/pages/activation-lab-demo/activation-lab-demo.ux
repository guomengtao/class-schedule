<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">16位激活码算法Demo</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">加密演示</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">输入产品ID、设备ID、天数，查看每一步加密过程</text>

      <text class="field-label" style="color: {{ theme.text }}">参数输入</text>
      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">参数</text>
        <div class="text-input" onclick="inputEncryptParams" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ encryptParams ? theme.text : theme.textMuted }}">{{ encryptParams || '产品ID 设备ID 天数 (如 0001 wS09 2)' }}</text>
        </div>
      </div>
      <input class="action-btn" type="button" value="执行加密" onclick="doEncrypt" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="steps-box" show="{{ showEncryptSteps }}" style="background-color: {{ theme.bg }}">
        <text class="step-line" style="color: {{ theme.text }}">步骤1: 设备ID "{{ encDeviceId }}" → 哈希 → "{{ encIdHash }}"</text>
        <text class="step-line" style="color: {{ theme.text }}">步骤2: 天数 {{ encDays }} → 补零 → "{{ encDaysPart }}"</text>
        <text class="step-line" style="color: {{ theme.text }}">步骤3: 明文 = "{{ encProductId }}" + "{{ encIdHash }}" + "{{ encDaysPart }}" = "{{ encPlain }}"</text>
        <text class="step-line" style="color: {{ theme.text }}">步骤4: 校验码 = checksum("{{ encPlain }}") = "{{ encChecksum }}"</text>
        <text class="step-line" style="color: {{ theme.accent }}; font-weight: bold">步骤5: 激活码 = "{{ encPlain }}" + "{{ encChecksum }}" = "{{ encFull }}"</text>
        <text class="result-code" style="color: {{ theme.accent }}">{{ encFullFmt }}</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">解密演示</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">输入16位激活码，查看每一步解密验证过程</text>

      <text class="field-label" style="color: {{ theme.text }}">16位激活码</text>
      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">激活码</text>
        <div class="text-input" onclick="inputDecryptCode" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ decryptCode ? theme.text : theme.textMuted }}">{{ decryptCode || '如 0001643700025787' }}</text>
        </div>
      </div>
      <input class="action-btn" type="button" value="执行解密" onclick="doDecrypt" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="steps-box" show="{{ showDecryptSteps }}" style="background-color: {{ theme.bg }}">
        <text class="step-line" style="color: {{ theme.text }}">步骤1: 拆分 → 产品ID="{{ decProductId }}" 设备哈希="{{ decIdHash }}" 天数="{{ decDaysPart }}" 校验码="{{ decCode }}"</text>
        <text class="step-line" style="color: {{ theme.text }}">步骤2: 明文 = "{{ decProductId }}" + "{{ decIdHash }}" + "{{ decDaysPart }}" = "{{ decPlain }}"</text>
        <text class="step-line" style="color: {{ decMatch ? '#27ae60' : '#e74c3c' }}">步骤3: checksum("{{ decPlain }}") = "{{ decRecomputed }}" {{ decMatch ? '✓ 匹配' : '✗ 不匹配' }}</text>
        <text show="{{ decMatch }}" class="step-line" style="color: {{ theme.text }}">步骤4: 天数 = {{ decDays === -1 ? '9999 (永久)' : decDays + '天' }}</text>
        <text show="{{ decMatch }}" class="step-line" style="color: {{ theme.accent }}; font-weight: bold">结果: 验证通过，{{ decProductName }}，{{ decDays === -1 ? '永久激活' : decDays + '天' }}</text>
        <text show="{{ !decMatch }}" class="step-line" style="color: #e74c3c; font-weight: bold">结果: 校验失败，激活码无效或被篡改</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const PRODUCTS = require("../../data/products.js").PRODUCTS

var DEFAULT_THEME = {
  bg: '#1a1a2e',
  card: '#16213e',
  cardLight: '#0f3460',
  accent: '#7ec8e3',
  text: '#ffffff',
  textSecondary: '#888899',
  textMuted: '#555566',
  border: '#0f3460',
  borderLight: '#2a2a5a'
}

function encode4(n) {
  return (Math.abs(n) % 10000).toString().padStart(4, '0')
}

function rollingHash(str) {
  var hash = 0
  for (var i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i)
    hash = hash & hash
  }
  return Math.abs(hash)
}

function deviceIdToHashV2(id) {
  return encode4(rollingHash(id))
}

function checksumV2(str) {
  return encode4(rollingHash(str))
}

function decryptV2(encrypted) {
  if (!/^\d{16}$/.test(encrypted)) return null

  var productId = encrypted.substring(0, 4)
  var idHash = encrypted.substring(4, 8)
  var daysPart = encrypted.substring(8, 12)
  var code = encrypted.substring(12, 16)

  var plain = productId + idHash + daysPart
  if (checksumV2(plain) !== code) return null

  var days = parseInt(daysPart, 10)

  return {
    productId: productId,
    productName: PRODUCTS[productId] ? PRODUCTS[productId].name : 'Unknown Product',
    idHash: idHash,
    days: days === 9999 ? -1 : days,
    isPermanent: days === 9999
  }
}

function fmtCode16(code) {
  if (!code || code.length !== 16) return code
  return code.substring(0, 4) + ' ' + code.substring(4, 8) + ' ' + code.substring(8, 12) + ' ' + code.substring(12, 16)
}

export default {
  private: {
    theme: DEFAULT_THEME,

    encryptParams: '',
    showEncryptSteps: false,
    encDeviceId: '',
    encProductId: '',
    encDays: 0,
    encIdHash: '',
    encDaysPart: '',
    encPlain: '',
    encChecksum: '',
    encFull: '',
    encFullFmt: '',

    decryptCode: '',
    showDecryptSteps: false,
    decProductId: '',
    decIdHash: '',
    decDaysPart: '',
    decCode: '',
    decPlain: '',
    decRecomputed: '',
    decMatch: false,
    decDays: 0,
    decProductName: ''
  },

  onInit() {
    var self = this
    try {
      store.getTheme(function(t) {
        if (t && t.bg && t.card && t.text) {
          self.theme = t
        }
      })
    } catch (e) {}
  },

  onShow() {
    var self = this
    try {
      store.getTheme(function(t) {
        if (t && t.bg) { self.theme = t }
      })
    } catch (e) {}

    try {
      var storage = require("@system.storage")
      storage.get({
        key: "demo_encrypt_params",
        success: function(data) {
          if (data) { self.encryptParams = String(data) }
          storage.delete({ key: "demo_encrypt_params" })
        },
        fail: function() {}
      })
      storage.get({
        key: "demo_decrypt_code",
        success: function(data) {
          if (data) { self.decryptCode = String(data) }
          storage.delete({ key: "demo_decrypt_code" })
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  goBack() {
    router.back()
  },

  inputEncryptParams() {
    try {
      var storage = require("@system.storage")
      storage.set({ key: "chinese_input_title", value: "加密参数" })
      storage.set({ key: "chinese_input_placeholder", value: "产品ID 设备ID 天数 (如 0001 wS09 2)" })
      storage.set({ key: "chinese_input_value", value: this.encryptParams || "" })
      storage.set({ key: "chinese_input_maxlen", value: "20" })
      storage.set({ key: "chinese_input_return_key", value: "demo_encrypt_params" })
      router.push({ uri: "/pages/chinese-input" })
    } catch (e) {}
  },

  inputDecryptCode() {
    try {
      var storage = require("@system.storage")
      storage.set({ key: "chinese_input_title", value: "解密激活码" })
      storage.set({ key: "chinese_input_placeholder", value: "16位激活码 (如 0001643700025787)" })
      storage.set({ key: "chinese_input_value", value: this.decryptCode || "" })
      storage.set({ key: "chinese_input_maxlen", value: "16" })
      storage.set({ key: "chinese_input_return_key", value: "demo_decrypt_code" })
      router.push({ uri: "/pages/chinese-input" })
    } catch (e) {}
  },

  doEncrypt() {
    var input = (this.encryptParams || '').trim()
    if (!input) {
      this.showEncryptSteps = false
      return
    }

    var parts = input.split(/\s+/)
    if (parts.length < 3) {
      this.showEncryptSteps = false
      return
    }

    var productId = parts[0]
    var deviceId = parts[1]
    var days = parseInt(parts[2], 10)

    if (!PRODUCTS[productId] || isNaN(days) || days < 1 || days > 9999) {
      this.showEncryptSteps = false
      return
    }

    this.encDeviceId = deviceId
    this.encProductId = productId
    this.encDays = days
    this.encIdHash = deviceIdToHashV2(deviceId)
    this.encDaysPart = days.toString().padStart(4, '0')
    this.encPlain = productId + this.encIdHash + this.encDaysPart
    this.encChecksum = checksumV2(this.encPlain)
    this.encFull = this.encPlain + this.encChecksum
    this.encFullFmt = fmtCode16(this.encFull)
    this.showEncryptSteps = true
  },

  doDecrypt() {
    var code = (this.decryptCode || '').replace(/\s/g, '')
    if (!code) {
      this.showDecryptSteps = false
      return
    }

    var result = decryptV2(code)

    if (result) {
      this.decProductId = result.productId
      this.decIdHash = result.idHash
      this.decDaysPart = code.substring(8, 12)
      this.decCode = code.substring(12, 16)
      this.decPlain = this.decProductId + this.decIdHash + this.decDaysPart
      this.decRecomputed = checksumV2(this.decPlain)
      this.decMatch = this.decRecomputed === this.decCode
      this.decDays = result.days
      this.decProductName = result.productName
    } else {
      this.decProductId = code.substring(0, 4) || '????'
      this.decIdHash = code.substring(4, 8) || '????'
      this.decDaysPart = code.substring(8, 12) || '????'
      this.decCode = code.substring(12, 16) || '????'
      this.decPlain = this.decProductId + this.decIdHash + this.decDaysPart
      this.decRecomputed = checksumV2(this.decPlain)
      this.decMatch = false
      this.decDays = 0
      this.decProductName = 'Unknown'
    }
    this.showDecryptSteps = true
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  margin-left: 8px;
}

.section {
  flex-direction: column;
  border-radius: 10px;
  padding: 14px 12px;
  margin-bottom: 10px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 4px;
}

.section-desc {
  font-size: 12px;
  margin-bottom: 10px;
}

.field-label {
  font-size: 13px;
  margin-top: 8px;
  margin-bottom: 6px;
}

.input-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.input-prefix {
  font-size: 13px;
  width: 50px;
}

.text-input {
  flex: 1;
  height: 36px;
  border-radius: 6px;
  padding: 0 8px;
  border-width: 1px;
  justify-content: center;
}

.input-text {
  font-size: 14px;
}

.action-btn {
  height: 40px;
  border-radius: 8px;
  font-size: 15px;
  margin-top: 8px;
  text-align: center;
}

.steps-box {
  flex-direction: column;
  border-radius: 8px;
  padding: 10px;
  margin-top: 10px;
}

.step-line {
  font-size: 13px;
  margin-bottom: 6px;
  line-height: 20px;
}

.result-code {
  font-size: 22px;
  font-weight: bold;
  letter-spacing: 4px;
  text-align: center;
  margin-top: 4px;
}
</style>