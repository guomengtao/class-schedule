<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">命令行 Debug 测试</text>
    </div>

    <div class="guide-section" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
      <text class="guide-title" style="color: {{ theme.accent }}">📖 查看方式</text>
      <text class="guide-text" style="color: {{ theme.text }}">1. 本页面下方直接显示日志</text>
      <text class="guide-text" style="color: {{ theme.text }}">2. AIoT IDE 底部 → 控制台面板</text>
      <text class="guide-text" style="color: {{ theme.textSecondary }}">   查找 [DEBUG-DEMO] 前缀的输出</text>
      <text class="guide-divider" style="color: {{ theme.border }}">────────────</text>
      <text class="guide-text" style="color: {{ theme.accent }}">💡 点击按钮，日志同时显示在：</text>
      <text class="guide-text" style="color: {{ theme.textSecondary }}">   - 下方日志区域</text>
      <text class="guide-text" style="color: {{ theme.textSecondary }}">   - AIoT IDE 控制台</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.accent }}">基础输出测试</text>
      <div class="btn-grid">
        <input class="test-btn" type="button" value="console.log" onclick="testLog"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="test-btn" type="button" value="console.warn" onclick="testWarn"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="test-btn" type="button" value="console.error" onclick="testError"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="test-btn" type="button" value="console.info" onclick="testInfo"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.accent }}">对象/数组输出</text>
      <div class="btn-grid">
        <input class="test-btn" type="button" value="输出对象" onclick="testObject"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="test-btn" type="button" value="输出数组" onclick="testArray"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="test-btn" type="button" value="JSON 序列化" onclick="testJson"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.accent }}">Premium 弹窗测试</text>
      <div class="btn-grid">
        <input class="test-btn" type="button" value="checkAndShow" onclick="testPremiumCheck"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="test-btn" type="button" value="show 弹窗" onclick="testPremiumShow"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="test-btn" type="button" value="hide 弹窗" onclick="testPremiumHide"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.accent }}">批量测试</text>
      <div class="btn-grid">
        <input class="test-btn primary-btn" type="button" value="▶ 全部测试" onclick="testAll"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="test-btn" type="button" value="清空日志" onclick="clearLogs"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>
    </div>

    <div class="log-area" style="background-color: {{ theme.card }}">
      <text class="log-title" style="color: {{ theme.accent }}">📋 Debug 输出日志 ({{ debugLogs.length }})</text>
      <div class="log-list" style="background-color: {{ theme.bg }}">
        <block for="{{ debugLogs }}">
          <text class="log-line" style="color: {{ theme.text }}; font-size: 10px;">{{ $item }}</text>
        </block>
        <text class="log-empty" style="color: {{ theme.textMuted }}"
              if="{{ debugLogs.length === 0 }}">点击上方按钮，日志会显示在这里</text>
      </div>
    </div>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}; font-size: 13px;">📌 固定到首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var premiumOverlay = require("../../data/premium-overlay.js")
var pinHelper = require("../../data/pin-helper.js")

var MAX_LOGS = 50

export default {
  private: {
    theme: store.DEFAULT_THEME,
    debugLogs: [],
    totalRuns: 0,
    lastAction: "无",
    loadTime: ""
  },

  _addLog(level, msg) {
    var time = new Date().toLocaleTimeString()
    var prefix = level === "ERROR" ? "ERR" : level === "WARN" ? "WRN" : level === "INFO" ? "INF" : "LOG"
    var line = "[" + prefix + " " + time + "] " + msg
    this.debugLogs.push(line)
    if (this.debugLogs.length > MAX_LOGS) {
      this.debugLogs.shift()
    }
  },

  onInit() {
    console.log("[DEBUG-DEMO] ========== onInit: page created ==========")
    var self = this
    var startTime = Date.now()
    self.loadTime = new Date().toLocaleString()
    self._addLog("LOG", "page created, init start")
    store.getTheme(function(t) {
      self.theme = t
      self._addLog("INFO", "theme loaded, accent=" + t.accent)
    })
    self._addLog("LOG", "init done, " + (Date.now() - startTime) + "ms")
  },

  onShow() {
    console.log("[DEBUG-DEMO] ========== onShow: page shown ==========")
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self._addLog("LOG", "page shown")
  },

  testLog() {
    console.log("[DEBUG-DEMO] testLog: normal log message")
    console.log("[DEBUG-DEMO] testLog: timestamp=" + Date.now())
    this._addLog("LOG", "normal console.log message")
    this._addLog("LOG", "timestamp=" + Date.now())
    this.totalRuns++
    this.lastAction = "console.log"
  },

  testWarn() {
    console.warn("[DEBUG-DEMO] testWarn: WARNING message!")
    this._addLog("WARN", "WARNING! (console.warn)")
    this.totalRuns++
    this.lastAction = "console.warn"
  },

  testError() {
    console.error("[DEBUG-DEMO] testError: ERROR message!")
    this._addLog("ERROR", "ERROR! (console.error)")
    this.totalRuns++
    this.lastAction = "console.error"
  },

  testInfo() {
    console.info("[DEBUG-DEMO] testInfo: INFO level message")
    this._addLog("INFO", "INFO level (console.info)")
    this.totalRuns++
    this.lastAction = "console.info"
  },

  testObject() {
    var sampleObj = {
      name: "DebugDemo",
      version: "1.0.0",
      features: ["log", "warn", "error", "info"],
      timestamp: Date.now()
    }
    var json = JSON.stringify(sampleObj)
    console.log("[DEBUG-DEMO] testObject: " + json)
    this._addLog("LOG", "object: " + json)
    this.totalRuns++
    this.lastAction = "output object"
  },

  testArray() {
    var arr = ["apple", "banana", "cherry", "date", "elderberry"]
    console.log("[DEBUG-DEMO] testArray: length=" + arr.length)
    this._addLog("LOG", "array length=" + arr.length + " items")
    for (var i = 0; i < arr.length; i++) {
      console.log("[DEBUG-DEMO] testArray: [" + i + "] " + arr[i])
      this._addLog("LOG", "  [" + i + "] " + arr[i])
    }
    this.totalRuns++
    this.lastAction = "output array"
  },

  testJson() {
    var payload = {
      event: "debug_test",
      data: { count: this.totalRuns, action: this.lastAction },
      meta: { page: "debug-demo", time: Date.now() }
    }
    var json = JSON.stringify(payload)
    console.log("[DEBUG-DEMO] testJson: " + json)
    this._addLog("LOG", "JSON: " + json)
    this.totalRuns++
    this.lastAction = "JSON serialize"
  },

  testPremiumCheck() {
    console.log("[DEBUG-DEMO] testPremiumCheck: calling checkAndShow()")
    this._addLog("LOG", "calling premiumOverlay.checkAndShow()")
    premiumOverlay.checkAndShow()
    this._addLog("INFO", "checkAndShow() called, see [PREMIUM] in IDE console")
    this.totalRuns++
    this.lastAction = "premium checkAndShow"
  },

  testPremiumShow() {
    console.log("[DEBUG-DEMO] testPremiumShow: calling show()")
    this._addLog("LOG", "calling premiumOverlay.show()")
    premiumOverlay.show()
    this._addLog("INFO", "show() called, overlay should appear")
    this.totalRuns++
    this.lastAction = "premium show"
  },

  testPremiumHide() {
    console.log("[DEBUG-DEMO] testPremiumHide: calling hide()")
    this._addLog("LOG", "calling premiumOverlay.hide()")
    premiumOverlay.hide()
    this._addLog("INFO", "hide() called, overlay should disappear")
    this.totalRuns++
    this.lastAction = "premium hide"
  },

  testAll() {
    console.log("[DEBUG-DEMO] ========== testAll: START ==========")
    this._addLog("LOG", "========== RUNNING ALL TESTS ==========")
    this.testLog()
    this.testWarn()
    this.testError()
    this.testInfo()
    this.testObject()
    this.testArray()
    this.testJson()
    this.testPremiumCheck()
    console.log("[DEBUG-DEMO] ========== testAll: DONE ==========")
    this._addLog("LOG", "========== ALL TESTS DONE ==========")
    this.lastAction = "all tests done"
  },

  clearLogs() {
    console.log("[DEBUG-DEMO] clearLogs: clearing all")
    this.debugLogs = []
    this.totalRuns = 0
    this.lastAction = "logs cleared"
    this._addLog("LOG", "logs cleared")
  },

  goBack() {
    console.log("[DEBUG-DEMO] goBack: navigating back")
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("命令行 Debug", "/pages/debug-demo")
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.guide-section {
  flex-direction: column;
  border-radius: 10px;
  border-width: 1px;
  border-style: solid;
  padding: 8px 12px;
  margin-bottom: 6px;
}

.guide-title {
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 4px;
}

.guide-text {
  font-size: 11px;
  margin-bottom: 1px;
  line-height: 1.4;
}

.guide-divider {
  font-size: 9px;
  text-align: center;
  margin: 4px 0;
}

.section {
  flex-direction: column;
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 4px;
}

.section-title {
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 4px;
}

.btn-grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.test-btn {
  height: 30px;
  min-width: 46%;
  border-radius: 6px;
  font-size: 11px;
  text-align: center;
  margin-bottom: 4px;
  margin-right: 4px;
  padding: 0 6px;
  flex: 1;
}

.primary-btn {
  font-weight: bold;
}

.log-area {
  flex-direction: column;
  flex: 1;
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 4px;
  margin-top: 4px;
  min-height: 120px;
}

.log-title {
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 4px;
}

.log-list {
  flex-direction: column;
  flex: 1;
  border-radius: 6px;
  padding: 6px;
  min-height: 80px;
}

.log-line {
  font-size: 10px;
  margin-bottom: 1px;
  line-height: 1.3;
  word-break: break-all;
}

.log-empty {
  font-size: 11px;
  text-align: center;
  padding: 20px 0;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 8px 0;
}

.pin-link {
  text-align: center;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
}
</style>