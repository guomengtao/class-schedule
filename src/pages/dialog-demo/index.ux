<import name="simple-dialog" src="../../components/simple-dialog"></import>

<template>
  <div class="page" style="background-color: #1a1a2e">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: #16213e; color: #7ec8e3" />
      <text class="title" style="color: #ffffff">弹窗组件测试</text>
      <input class="pin-btn" type="button" value="📌钉首页" onclick="pinToHome" style="background-color: #7ec8e3; color: #1a1a2e" />
    </div>

    <div class="content">
      <text class="desc" style="color: #888899">通过 props 控制弹窗显隐</text>

      <input class="test-btn" type="button" value="触发弹窗" onclick="showDialog"
             style="background-color: #7ec8e3; color: #1a1a2e" />

      <text class="log-text" style="color: {{ logColor }}">{{ logText }}</text>
    </div>

    <simple-dialog title="测试弹窗" message="基于组件化模式的弹窗，props 控制显隐！" visible="{{ dialogVisible }}" onclose="onDialogClose"></simple-dialog>
  </div>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")

export default {
  private: {
    dialogVisible: false,
    logText: '等待触发...',
    logColor: '#555566'
  },

  onInit() {
    console.log('[dialog-demo] onInit')
  },

  showDialog() {
    console.log('[dialog-demo] showDialog')
    this.dialogVisible = true
    this.logText = '弹窗已触发！'
    this.logColor = '#7ec8e3'
  },

  onDialogClose() {
    console.log('[dialog-demo] onDialogClose')
    this.dialogVisible = false
    this.logText = '弹窗已关闭'
    this.logColor = '#888899'
  },

  goBack() {
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("弹窗组件测试", "/pages/dialog-demo")
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 16px 16px 16px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 20px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.pin-btn {
  width: 80px;
  height: 36px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.content {
  flex-direction: column;
  align-items: center;
}

.desc {
  font-size: 13px;
  margin-bottom: 16px;
}

.test-btn {
  width: 80%;
  height: 40px;
  border-radius: 20px;
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 16px;
}

.log-text {
  font-size: 13px;
  text-align: center;
}
</style>