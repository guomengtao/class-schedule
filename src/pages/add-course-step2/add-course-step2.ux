<template>
  <div class="step-page">
    <text class="step-indicator">Step 2/5</text>
    <text class="step-title">Time</text>

    <text class="step-label">Start Time</text>
    <input class="step-input" type="text" placeholder="08:00" value="{{ startTime }}" onchange="onStartChange" />

    <text class="step-label">End Time</text>
    <input class="step-input" type="text" placeholder="08:45" value="{{ endTime }}" onchange="onEndChange" />

    <div class="nav-buttons">
      <input class="nav-btn back-btn" type="button" value="Back" onclick="goPrev" />
      <input class="nav-btn next-btn" type="button" value="Next" onclick="goNext" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  private: {
    startTime: "",
    endTime: "",
    day: "",
    nextId: 100
  },

  onInit() {
    const params = this.$page.params || {}
    this.day = params.day || ""
    this.nextId = parseInt(params.nextId) || 100
    const course = this.$app.$data.newCourse || {}
    if (course.time) {
      const parts = course.time.split(" - ")
      this.startTime = parts[0] || ""
      this.endTime = parts[1] || ""
    }
  },

  onStartChange(e) {
    this.startTime = e.value || ""
  },

  onEndChange(e) {
    this.endTime = e.value || ""
  },

  goPrev() {
    router.back()
  },

  goNext() {
    if (!this.startTime || !this.endTime) {
      return
    }
    this.$app.$data.newCourse.time = this.startTime + " - " + this.endTime
    router.push({
      uri: "/pages/add-course-step3",
      params: {
        day: this.day,
        nextId: this.nextId
      }
    })
  }
}
</script>

