<template>
  <div class="pinned-pages-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">已钉首页</text>
    </div>

    <text class="section-desc" style="color: {{ theme.textSecondary }}">已固定的页面，点击快速访问，点击方框取消固定</text>

    <div class="empty-hint" if="pinnedList.length === 0" style="background-color: {{ theme.card }}">
      <text class="empty-icon">📌</text>
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无固定页面</text>
      <text class="empty-sub" style="color: {{ theme.textSecondary }}">在实验室中可将页面固定到首页</text>
    </div>

    <div class="pinned-section" if="pinnedList.length > 0">
      <div class="pinned-item" for="{{ pinnedList }}" style="background-color: {{ theme.card }}">
        <div class="pinned-checkbox" onclick="togglePin($idx)" style="border-color: {{ theme.accent }}; color: {{ theme.accent }}">
          <text>☑</text>
        </div>
        <div class="pinned-info" onclick="openPage($item.uri)">
          <text class="pinned-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="pinned-uri" style="color: {{ theme.textMuted }}">{{ $item.uri }}</text>
        </div>
        <text class="pinned-arrow" onclick="openPage($item.uri)" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}">📌 {{ isThisPinned ? '已固定' : '固定到首页' }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var pinHelper = require("../../data/pin-helper.js")

export default {
  private: {
    pinnedList: [],
    isThisPinned: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.loadPinnedList()
    self.checkThisPinned()
  },

  loadPinnedList() {
    var self = this
    pinHelper.getList(function(list) {
      self.pinnedList = list
    })
  },

  checkThisPinned() {
    var self = this
    pinHelper.isPinned("/pages/pinned-pages", function(yes) {
      self.isThisPinned = yes
    })
  },

  openPage(uri) {
    router.push({ uri: uri })
  },

  togglePin(idx) {
    var self = this
    var item = self.pinnedList[idx]
    pinHelper.unpinPage(item.uri, function() {
      self.loadPinnedList()
    })
  },

  pinToHome() {
    var self = this
    if (self.isThisPinned) {
      pinHelper.unpinPage("/pages/pinned-pages", function() {
        self.isThisPinned = false
      })
    } else {
      pinHelper.pinPage("已钉首页", "/pages/pinned-pages", function() {
        self.isThisPinned = true
      })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.pinned-pages-page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
}

.back-btn {
  width: 64px;
  height: 34px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.title {
  font-size: 36px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  margin-right: 64px;
}

.section-desc {
  font-size: 28px;
  margin-bottom: 14px;
}

.empty-hint {
  flex-direction: column;
  align-items: center;
  border-radius: 12px;
  padding: 28px 18px;
  margin-bottom: 14px;
}

.empty-icon {
  font-size: 36px;
  margin-bottom: 10px;
}

.empty-text {
  font-size: 28px;
  margin-bottom: 6px;
}

.empty-sub {
  font-size: 24px;
  text-align: center;
}

.pinned-section {
  flex-direction: column;
}

.pinned-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 12px;
  padding: 16px 14px;
  margin-bottom: 10px;
}

.pinned-checkbox {
  width: 28px;
  height: 28px;
  border-width: 2px;
  border-radius: 6px;
  justify-content: center;
  align-items: center;
  margin-right: 12px;
  flex-shrink: 0;
  font-size: 20px;
}

.pinned-info {
  flex-direction: column;
  flex: 1;
}

.pinned-name {
  font-size: 32px;
  margin-bottom: 4px;
}

.pinned-uri {
  font-size: 24px;
}

.pinned-arrow {
  font-size: 28px;
  margin-left: 10px;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 18px 0 10px 0;
}

.pin-link {
  font-size: 28px;
  text-align: center;
}

@media (shape: circle) {
  .pinned-pages-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    margin-bottom: 12px;
  }
  .back-btn {
    width: 56px;
    height: 30px;
    font-size: 13px;
  }
  .title {
    font-size: 34px;
    margin-right: 56px;
  }
  .section-desc {
    font-size: 24px;
  }
  .empty-text {
    font-size: 28px;
  }
  .empty-sub {
    font-size: 24px;
  }
  .pinned-name {
    font-size: 28px;
  }
  .pinned-uri {
    font-size: 24px;
  }
  .pin-link {
    font-size: 24px;
  }
}

@media (shape: capsule) {
  .pinned-pages-page {
    padding: 44px 10px 12px 10px;
  }
  .header {
    margin-bottom: 10px;
  }
  .back-btn {
    width: 52px;
    height: 30px;
    font-size: 13px;
  }
  .title {
    font-size: 34px;
    margin-right: 52px;
  }
  .section-desc {
    font-size: 24px;
  }
  .pinned-name {
    font-size: 28px;
  }
  .pin-link {
    font-size: 24px;
  }
}

@media (shape: rect) {
  .pinned-pages-page {
    padding: 44px 10px 12px 10px;
  }
  .header {
    margin-bottom: 10px;
  }
  .back-btn {
    width: 50px;
    height: 28px;
