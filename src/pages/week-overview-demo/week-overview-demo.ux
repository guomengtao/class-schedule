<template>
  <div class="page" style="background: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">周课程总览</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="status-bar">
      <div class="date-info">
        <text class="date-main" style="color: {{ theme.text }}">{{ dateMain }}</text>
        <text class="date-sub" style="color: {{ theme.textMuted }}">第{{ weekNumber }}周</text>
      </div>
      <text class="week-indicator">{{ todayDayName }}</text>
    </div>

    <div class="week-header">
      <text
        class="week-day {{ $idx === todayColIndex ? 'today' : '' }}"
        for="{{ dayHeaders }}"
        style="color: {{ $idx === todayColIndex ? theme.text : theme.textMuted }}"
      >{{ $item }}</text>
    </div>

    <div class="timetable">
      <div class="course-row">
        <div class="course-cell {{ $item.cssClass }} {{ $item.isCurrent ? 'current' : '' }}" for="{{ row0Cells }}" style="background: {{ $item.bgColor }}">
          <text class="course-name" if="{{ $item.char }}" style="color: {{ $item.textColor }}">{{ $item.char }}</text>
        </div>
      </div>
      <div class="course-row">
        <div class="course-cell {{ $item.cssClass }} {{ $item.isCurrent ? 'current' : '' }}" for="{{ row1Cells }}" style="background: {{ $item.bgColor }}">
          <text class="course-name" if="{{ $item.char }}" style="color: {{ $item.textColor }}">{{ $item.char }}</text>
        </div>
      </div>
      <div class="course-row">
        <div class="course-cell {{ $item.cssClass }} {{ $item.isCurrent ? 'current' : '' }}" for="{{ row2Cells }}" style="background: {{ $item.bgColor }}">
          <text class="course-name" if="{{ $item.char }}" style="color: {{ $item.textColor }}">{{ $item.char }}</text>
        </div>
      </div>
      <div class="course-row">
        <div class="course-cell {{ $item.cssClass }} {{ $item.isCurrent ? 'current' : '' }}" for="{{ row3Cells }}" style="background: {{ $item.bgColor }}">
          <text class="course-name" if="{{ $item.char }}" style="color: {{ $item.textColor }}">{{ $item.char }}</text>
        </div>
      </div>
      <div class="course-row">
        <div class="course-cell {{ $item.cssClass }} {{ $item.isCurrent ? 'current' : '' }}" for="{{ row4Cells }}" style="background: {{ $item.bgColor }}">
          <text class="course-name" if="{{ $item.char }}" style="color: {{ $item.textColor }}">{{ $item.char }}</text>
        </div>
      </div>
      <div class="course-row">
        <div class="course-cell {{ $item.cssClass }} {{ $item.isCurrent ? 'current' : '' }}" for="{{ row5Cells }}" style="background: {{ $item.bgColor }}">
          <text class="course-name" if="{{ $item.char }}" style="color: {{ $item.textColor }}">{{ $item.char }}</text>
        </div>
      </div>
    </div>

    <div class="period-indicator">
      <div
        class="period-dot {{ $idx === currentPeriodIndex ? 'active' : '' }}"
        for="{{ periodList }}"
        style="background: {{ $idx === currentPeriodIndex ? '#ff9500' : theme.border }}"
      ></div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

var COURSE_COLORS = {
  "语文": { bg: "linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%)", text: "#ffffff", css: "chinese" },
  "数学": { bg: "linear-gradient(135deg, #4ecdc4 0%, #3bb09a 100%)", text: "#ffffff", css: "math" },
  "英语": { bg: "linear-gradient(135deg, #667eea 0%, #764ba2 100%)", text: "#ffffff", css: "english" },
  "物理": { bg: "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)", text: "#ffffff", css: "physics" },
  "化学": { bg: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)", text: "#ffffff", css: "chemistry" },
  "体育": { bg: "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)", text: "#ffffff", css: "pe" },
  "历史": { bg: "linear-gradient(135deg, #fa709a 0%, #fee140 100%)", text: "#ffffff", css: "history" },
  "地理": { bg: "linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)", text: "#333333", css: "geography" },
  "生物": { bg: "linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)", text: "#333333", css: "biology" },
  "政治": { bg: "linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)", text: "#333333", css: "politics" },
  "音乐": { bg: "linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)", text: "#ffffff", css: "music" },
  "美术": { bg: "linear-gradient(135deg, #ffd89b 0%, #19547b 100%)", text: "#ffffff", css: "art" },
  "计算机": { bg: "linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%)", text: "#ffffff", css: "computer" },
  "科学": { bg: "linear-gradient(135deg, #d4fc79 0%, #96e6a1 100%)", text: "#333333", css: "science" }
}

var DEFAULT_COLOR = { bg: "linear-gradient(135deg, #6c757d 0%, #495057 100%)", text: "#ffffff", css: "default" }

var CHAR_MAP = {
  "语文": "语", "数学": "数", "英语": "英", "物理": "物", "化学": "化",
  "体育": "体", "历史": "史", "地理": "地", "生物": "生", "政治": "政",
  "音乐": "音", "美术": "美", "计算机": "计", "科学": "科"
}

var MAX_PERIODS = 6

function getCourseChar(name) {
  if (CHAR_MAP[name]) return CHAR_MAP[name]
  return name.length > 0 ? name.charAt(0) : ""
}

function getCourseColor(name) {
  return COURSE_COLORS[name] || DEFAULT_COLOR
}

export default {
  private: {
    theme: {
      bg: '#12121a',
      card: '#1a1a2e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#666677',
      border: '#222233',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    dateMain: "",
    weekNumber: 1,
    todayDayName: "",
    todayColIndex: 0,
    currentPeriodIndex: 0,
    dayHeaders: ["周一", "周二", "周三", "周四", "周五"],
    periodList: [0, 1, 2, 3, 4, 5],
    row0Cells: [],
    row1Cells: [],
    row2Cells: [],
    row3Cells: [],
    row4Cells: [],
    row5Cells: [],
    isLoading: true
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.initDateInfo()
    self.loadCourses()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  initDateInfo() {
    var now = new Date()
    var month = now.getMonth() + 1
    var day = now.getDate()
    this.dateMain = month + "月" + day + "日"

    var dayOfWeek = now.getDay()
    this.todayDayName = DAY_NAMES[dayOfWeek]
    this.todayColIndex = dayOfWeek === 0 || dayOfWeek === 6 ? 2 : dayOfWeek - 1

    var oneJan = new Date(now.getFullYear(), 0, 1)
    var days = Math.floor((now - oneJan) / (24 * 60 * 60 * 1000))
    this.weekNumber = Math.ceil((days + oneJan.getDay() + 1) / 7)

    var hours = now.getHours()
    var minutes = now.getMinutes()
    var totalMinutes = hours * 60 + minutes
    if (totalMinutes < 480) {
      this.currentPeriodIndex = 0
    } else if (totalMinutes < 535) {
      this.currentPeriodIndex = 1
    } else if (totalMinutes < 600) {
      this.currentPeriodIndex = 2
    } else if (totalMinutes < 655) {
      this.currentPeriodIndex = 3
    } else if (totalMinutes < 720) {
      this.currentPeriodIndex = 4
    } else {
      this.currentPeriodIndex = 5
    }
  },

  loadCourses() {
    var self = this
    database.getAllCourses(function(data) {
      self.buildGrid(data)
      self.isLoading = false
    })
  },

  buildGrid(schedule) {
    var dayMap = {}
    for (var i = 0; i < schedule.length; i++) {
      var dayData = schedule[i]
      dayMap[dayData.day] = dayData.classes || []
    }

    var allRows = []
    for (var p = 0; p < MAX_PERIODS; p++) {
      var cells = []
      for (var d = 0; d < 5; d++) {
        var dayName = DAY_NAMES[d + 1]
        var classes = dayMap[dayName] || []

        var course = null
        if (p < classes.length) {
          course = classes[p]
        }

        var cell = {
          char: "",
          cssClass: "empty",
          bgColor: "#0a0a0a",
          textColor: "#ffffff",
          isCurrent: false
        }

        if (course) {
          var colorInfo = getCourseColor(course.name)
          cell.char = getCourseChar(course.name)
          cell.cssClass = colorInfo.css
          cell.bgColor = colorInfo.bg
          cell.textColor = colorInfo.text
          if (p === this.currentPeriodIndex && d === this.todayColIndex) {
            cell.isCurrent = true
          }
        }

        cells.push(cell)
      }
      allRows.push(cells)
    }

    this.row0Cells = allRows[0] || []
    this.row1Cells = allRows[1] || []
    this.row2Cells = allRows[2] || []
    this.row3Cells = allRows[3] || []
    this.row4Cells = allRows[4] || []
    this.row5Cells = allRows[5] || []
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 38px 6px 8px 6px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
  padding: 0 4px;
}

.back-btn {
  width: 36px;
  height: 32px;
  border-radius: 8px;
  font-size: 16px;
  text-align: center;
}

.title {
  font-size: 17px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.header-placeholder {
  width: 36px;
}

.status-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 2px 6px 10px;
}

.date-info {
  flex-direction: column;
}

.date-main {
  font-size: 15px;
  font-weight: 600;
}

.date-sub {
  font-size: 11px;
  margin-top: 2px;
}

.week-indicator {
  font-size: 12px;
  font-weight: 600;
  color: #ff9500;
  background: #332600;
  padding: 4px 10px;
  border-radius: 20px;
}

.week-header {
  flex-direction: row;
  padding: 0 6px 8px;
  border-bottom-width: 1px;
  border-bottom-color: #222233;
  margin-bottom: 8px;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 14px;
  font-weight: 500;
  padding: 4px 0;
}

.week-day.today {
  font-weight: 700;
  color: #ffffff;
}

.timetable {
  flex-direction: column;
  flex: 1;
  padding: 0 2px;
}

.course-row {
  flex-direction: row;
  flex: 1;
  margin-bottom: 5px;
}

.course-cell {
  flex: 1;
  border-radius: 10px;
  margin: 0 2.5px;
  justify-content: center;
  align-items: center;
}

.course-cell.empty {
  border-width: 1px;
  border-color: #222233;
  border-style: dashed;
  background: #0a0a0a;
}

.course-cell.current {
  border-width: 2px;
  border-color: #4d4d4d;
  border-style: solid;
}

.course-name {
  font-size: 26px;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.period-indicator {
  flex-direction: row;
  justify-content: center;
  padding-top: 8px;
  margin-top: 4px;
  border-top-width: 1px;
  border-top-color: #222233;
}

.period-dot {
  width: 5px;
  height: 5px;
  border-radius: 3px;
  margin: 0 3px;
}

.period-dot.active {
  width: 16px;
  border-radius: 3px;
}

@media (shape: circle) {
  .page {
    padding: 44px 32px 44px 32px;
  }
  .course-name {
    font-size: 24px;
  }
  .course-cell {
    margin: 0 2px;
    border-radius: 9px;
  }
}

@media (shape: capsule) {
  .page {
    padding: 40px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 36px 4px 6px 4px;
  }
  .course-name {
    font-size: 22px;
  }
  .course-cell {
    border-radius: 8px;
    margin: 0 1.5px;
  }
  .course-row {
    margin-bottom: 3px;
  }
}
</style>