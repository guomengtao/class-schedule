  .page {
    padding: 44px 8px 12px 8px;
  }
  .header {
    height: 40px;
    margin-bottom: 8px;
  }
  .back-btn {
    width: 36px;
    height: 32px;
    font-size: 24px;
  }
  .title {
    font-size: 28px;
    margin-right: 44px;
  }
  .input-section {
    padding: 12px;
    margin-bottom: 8px;
  }
  .input-text {
    font-size: 28px;
  }
  .input-hint {
    font-size: 24px;
  }
  .qr-hint {
    font-size: 20px;
  }
  .empty-text {
    font-size: 24px;
  }
  .preset-btn {
    height: 36px;
    font-size: 24px;
  }
  .pin-link {
    font-size: 20px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
  .header {
    height: 36px;
    margin-bottom: 8px;
  }
  .back-btn {
    width: 36px;
