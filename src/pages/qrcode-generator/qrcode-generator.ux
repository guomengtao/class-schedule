  font-size: 28px;
}

.qr-container {
  flex-direction: column;
  align-items: center;
}

.qr-wrapper {
  padding: 12px;
  border-radius: 12px;
  margin-top: 12px;
  align-items: center;
  justify-content: center;
}

.qr-hint {
  font-size: 24px;
  margin-top: 12px;
  text-align: center;
}

.empty-state {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 24px 0;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 28px;
  text-align: center;
}

.presets-section {
  flex: 1;
  flex-direction: column;
  padding-top: 16px;
}

.presets-label {
  font-size: 24px;
  margin-bottom: 10px;
}

.presets-grid {
  flex-direction: column;
}

.preset-row {
  flex-direction: row;
  margin-bottom: 8px;
}

.preset-btn {
  flex: 1;
  height: 44px;
  border-radius: 10px;
  font-size: 28px;
  text-align: center;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 20px 0 8px 0;
}

.pin-link {
  font-size: 24px;
  text-align: center;
}

