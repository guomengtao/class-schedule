<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">二维码</text>
    </div>

    <div class="input-section" onclick="openInput" style="background-color: {{ theme.card }}">
      <text class="input-text" if="{{ inputText }}" style="color: {{ theme.text }}">{{ inputText }}</text>
      <text class="input-hint" if="{{ !inputText }}" style="color: {{ theme.textMuted }}">输入文字</text>
    </div>

    <div class="qr-container" if="{{ inputText }}">
      <div class="qr-wrapper" style="background-color: #ffffff">
        <qrcode value="{{ inputText }}" style="color: #000000; background-color: #ffffff; width: 180px; height: 180px;"></qrcode>
      </div>
      <text class="qr-hint" style="color: {{ theme.textSecondary }}">扫描查看</text>
    </div>

    <div class="empty-state" if="{{ !inputText }}">
      <text class="empty-icon">📱</text>
      <text class="empty-text" style="color: {{ theme.textMuted }}">输入或选择内容</text>
    </div>

    <div class="presets-section">
      <text class="presets-label" style="color: {{ theme.textSecondary }}">快捷内容</text>
      <div class="presets-grid">
        <div class="preset-row">
          <input class="preset-btn" type="button" value="Hello World" onclick="usePreset(0)" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />
          <input class="preset-btn" type="button" value="网址示例" onclick="usePreset(1)" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />
        </div>
        <div class="preset-row">
          <input class="preset-btn" type="button" value="手机号码" onclick="usePreset(2)" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />
          <input class="preset-btn" type="button" value="WiFi信息" onclick="usePreset(3)" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />
        </div>
        <div class="preset-row">
          <input class="preset-btn" type="button" value="邮箱地址" onclick="usePreset(4)" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />
          <input class="preset-btn" type="button" value="纯数字" onclick="usePreset(5)" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />
        </div>
      </div>
    </div>

    <unlock-dialog id="unlockDialog"></unlock-dialog>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}">📌钉首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")

var PRESETS = [
  "Hello World",
  "https://www.example.com",
  "13800138000",
  "WIFI:S:MyWiFi;T:WPA;P:12345678;;",
  "user@example.com",
  "1234567890"
]

export default {
  private: {
    isPro: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    inputText: ""
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.checkProStatus()
  },

  onShow() {
    this.loadInputText()
    this.checkProStatus()
  },

  checkProStatus() {
    var self = this
    authStore.checkStatus(function(status) {
      self.isPro = status.isActivated
    })
  },

  loadInputText() {
    var self = this
    if (!self.isPro) return
    store.getQrcodeText(function(text) {
      if (text) {
        self.inputText = text
      }
    })
  },

  openInput() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_return_key", value: "qrcode_text" })
    router.push({ uri: "/pages/chinese-input" })
  },

  usePreset(index) {
    var self = this
    if (!self.isPro) {
      store.showUnlockDialog({
        title: "解锁二维码生成",
        description: "一次性解锁，永久使用全部高级功能",
        benefits: ["文字转二维码", "快捷内容模板", "多课表管理", "首页自定义"],
        cancelText: "暂不需要"
      })
      return
    }
    var text = PRESETS[index]
    if (text) {
      this.inputText = text
      store.setQrcodeText(text)
    }
  },

  goBack() {
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("二维码生成", "/pages/qrcode-generator")
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 44px 8px 8px 8px;
}

.header {
  flex-direction: row;
  align-items: center;
  height: 48px;
  margin-bottom: 12px;
}

.back-btn {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  font-size: 28px;
  text-align: center;
  margin-right: 8px;
}

.title {
  font-size: 36px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  margin-right: 56px;
}

.input-section {
  padding: 16px 14px;
  border-radius: 12px;
  margin-bottom: 12px;
}

