<template>
  <!-- 金属字针表 ③ · 上下滑动切表盘：上滑→②课程表盘，下滑→④EV指针 -->
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <text class="clock">{{timeText}}</text>
    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  data: {
    timeText: "--:--:--",
    touchStartY: 0
  },
  onInit() {
    this.tick()
  },
  onReady() {
    this.timer = setInterval(() => this.tick(), 1000)
  },
  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },
  tick() {
    const now = new Date()
    this.timeText = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes()) + ":" + this.pad(now.getSeconds())
  },
  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* 上下滑动切表盘（Vela 无 onswipe，靠 touchstart/touchend 手算 Y 位移） */
  onTouchStart(e) {
    const t = (e && e.touches && e.touches[0]) || e || {}
    this.touchStartY = t.clientY || t.offsetY || t.pageY || 0
  },
  onTouchEnd(e) {
    const t = (e && e.touches && e.touches[0]) || (e && e.changedTouches && e.changedTouches[0]) || e || {}
    const endY = t.clientY || t.offsetY || t.pageY || 0
    const d = this.touchStartY ? (this.touchStartY - endY) : 0
    if (d >= 40) {
      router.replace({ uri: "/pages/watch-face-class" })
    } else if (d <= -40) {
      router.replace({ uri: "/pages/watch-face-evpointer" })
    }
    this.touchStartY = 0
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .clock {
    font-size: 48px;
    color: #e8e4da;
    font-weight: bold;
    letter-spacing: 4px;
  }
  .back {
    font-size: 20px;
    color: #888899;
    margin-top: 40px;
  }
</style>
