      <div class="hub-dot"></div>
    </div>

    <!-- 底部信息 -->
    <text class="date-line">{{dateText}}</text>
    <text class="time-line">{{timeText}}</text>
    <text class="back">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const FULL_DAY = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

function pad2(n) {
  return (n < 10 ? "0" : "") + n
}

// 角度 → 120 档类名（3°/档）。引擎轴在顶部中点，故 .rN 内部为 rotate(180 + 3N)
function stepClass(deg) {
  let step = Math.round(deg / 3) % 120
  if (step < 0) step += 120
  return "r" + step
}

export default {
  data: {
    hourCls: "r0",
    minuteCls: "r0",
    secondCls: "r0",
    timeText: "--:--",
    dateText: "",
    dayText: "1",
    touchStartY: 0,
    suppressTap: false,
    timer: null
  },

  onInit() {
    this.syncHands()
    this.tick()
  },

  onReady() {
    this.startTimer()
  },

  onShow() {
    this.syncHands()
    this.tick()
    this.startTimer()
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  /* ── 走针：当前时刻 → 三针角度 → 120 档 class ── */
  syncHands() {
    const now = new Date()
    const h = now.getHours() % 12
    const m = now.getMinutes()
    const s = now.getSeconds()

    this.hourCls = stepClass((h + m / 60 + s / 3600) * 30)
    this.minuteCls = stepClass((m + s / 60) * 6)
    this.secondCls = stepClass(s * 6)
  },

  startTimer() {
    this.stopTimer()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tick() {
    const now = new Date()
    this.timeText = pad2(now.getHours()) + ":" + pad2(now.getMinutes())
    this.dateText = pad2(now.getMonth() + 1) + "-" + pad2(now.getDate()) + " " + FULL_DAY[now.getDay()]
    this.dayText = pad2(now.getDate())
    this.syncHands()
  },

  /* ── 上下滑动切表盘（Vela 无 onswipe，靠 Y 位移手算；阈值 40px）──
     目录环：机械表盘 ← 上滑→课程表盘 ｜ 下滑→EV指针 */
  onTouchStart(e) {
    const t = (e && e.touches && e.touches[0]) || e || {}
    this.touchStartY = t.clientY || t.offsetY || t.pageY || 0
  },

  onTouchEnd(e) {
    const t = (e && e.touches && e.touches[0]) || (e && e.changedTouches && e.changedTouches[0]) || e || {}
    const endY = t.clientY || t.offsetY || t.pageY || 0
    const d = this.touchStartY ? (this.touchStartY - endY) : 0
    if (d >= 40) {
      this.suppressTap = true
      router.replace({ uri: "/pages/watch-face-class" })
    } else if (d <= -40) {
      this.suppressTap = true
      router.replace({ uri: "/pages/watch-face-evpointer" })
    }
    this.touchStartY = 0
  },

  /* ── 退出：单击任意位置返回目录 ── */
  onTap() {
    if (this.suppressTap) return
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

