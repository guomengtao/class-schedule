      <div class="mtick" style="left:20.9px;top:97.3px;transform:rotate(258deg)"></div>
      <div class="mtick" style="left:19.9px;top:90.7px;transform:rotate(264deg)"></div>
      <div class="mtick" style="left:19.9px;top:77.3px;transform:rotate(276deg)"></div>
      <div class="mtick" style="left:20.9px;top:70.7px;transform:rotate(282deg)"></div>
      <div class="mtick" style="left:22.6px;top:64.2px;transform:rotate(288deg)"></div>
      <div class="mtick" style="left:25.0px;top:58.0px;transform:rotate(294deg)"></div>
      <div class="mtick" style="left:31.7px;top:46.4px;transform:rotate(306deg)"></div>
      <div class="mtick" style="left:35.9px;top:41.2px;transform:rotate(312deg)"></div>
      <div class="mtick" style="left:40.7px;top:36.4px;transform:rotate(318deg)"></div>
      <div class="mtick" style="left:45.9px;top:32.2px;transform:rotate(324deg)"></div>
      <div class="mtick" style="left:57.5px;top:25.5px;transform:rotate(336deg)"></div>
