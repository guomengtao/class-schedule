      <div class="tick" style="left:50px;top:26.8px;transform:rotate(330deg)"></div>

      <!-- 阿拉伯时标（半径 44）。3 点位置让给日期窗，不写 3 -->
      <text class="num num-lg" style="left:73.0px;top:40.0px">12</text>
