      <div class="tick" style="left:83px;top:150px;transform:rotate(180deg)"></div>
      <div class="tick" style="left:50px;top:141.2px;transform:rotate(210deg)"></div>
      <div class="tick" style="left:25.8px;top:117px;transform:rotate(240deg)"></div>
      <div class="tick" style="left:17px;top:84px;transform:rotate(270deg)"></div>
