      <div class="mtick" style="left:76.8px;top:20.4px;transform:rotate(354deg)"></div>

      <!-- 12 整点刻度：外端半径 66、内端 57，rotate(θ) 使针指向盘心 -->
      <div class="tick" style="left:83px;top:18px;transform:rotate(0deg)"></div>
      <div class="tick" style="left:116px;top:26.8px;transform:rotate(30deg)"></div>
      <div class="tick" style="left:140.2px;top:51px;transform:rotate(60deg)"></div>
      <div class="tick" style="left:149px;top:84px;transform:rotate(90deg)"></div>
