}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 16px 0 8px 0;
}

.pin-link {
  text-align: center;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    padding: 0 20px;
    justify-content: center;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
