  font-size: 14px;
  text-align: center;
}

.pinned-row {
  flex-direction: row;
  flex-wrap: wrap;
  padding: 6px 0;
  margin-bottom: 8px;
}

.pinned-chip {
  padding: 6px 12px;
  border-radius: 8px;
  margin-right: 8px;
  margin-bottom: 6px;
}

