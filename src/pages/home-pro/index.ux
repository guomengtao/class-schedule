  padding: 2px 10px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: bold;
  margin-right: 8px;
  flex-shrink: 0;
}

.status-main {
  font-size: 14px;
  flex: 1;
}

.status-time {
  font-size: 13px;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 8px;
}

.custom-row {
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
}

