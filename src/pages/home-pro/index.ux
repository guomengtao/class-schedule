  width: 38px;
  height: 32px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: bold;
  text-align: center;
  margin-left: 8px;
}

.status-row {
  flex-direction: row;
  align-items: center;
  padding: 10px 14px;
  margin-bottom: 8px;
  border-radius: 10px;
}

