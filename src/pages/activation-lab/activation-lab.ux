<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">激活码系统</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">加密生成</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">输入产品ID、设备ID和天数，生成16位纯数字激活码</text>

      <text class="field-label" style="color: {{ theme.text }}">预设Demo</text>
      <div class="preset-list">
        <input class="preset-btn preset-btn-full" type="button" value="0001 6437 0002 5787" onclick="showPresetResult('0001643700025787')" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
      </div>

      <text class="field-label" style="color: {{ theme.text }}">自定义输入</text>
      <div class="text-input" onclick="inputCustomParams" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
        <text class="input-text" style="color: {{ customParams ? theme.text : theme.textMuted }}">{{ customParams || '格式: 产品ID 设备ID 天数 (如 0001 Ae19 30)' }}</text>
      </div>
      <input class="generate-btn" type="button" value="生成激活码" onclick="generateCustomV2" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="result-box" show="{{ encryptResult }}" style="background-color: {{ theme.bg }}; border-color: {{ theme.accent }}">
        <text class="result-label" style="color: {{ theme.textSecondary }}">加密结果</text>
        <text class="result-code" style="color: {{ theme.accent }}">{{ encryptResult }}</text>
        <text class="result-detail" style="color: {{ theme.textSecondary }}">{{ encryptDetail }}</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">解密验证</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">16位纯数字：产品ID + 设备哈希 + 天数 + 校验码</text>

      <div class="cells-grid" style="background-color: {{ theme.bg }}">
        <div class="cells-row-label">
          <text class="cells-label-text" style="color: {{ theme.textSecondary }}">产品ID</text>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 0 ? 'cell-active' : '' }}" onclick="onCellClick(0)" style="background-color: {{ cursor === 0 ? theme.accent : theme.card }}; border-color: {{ cursor === 0 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 0 ? theme.bg : theme.text }}">{{ cell0 !== null ? cell0 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 1 ? 'cell-active' : '' }}" onclick="onCellClick(1)" style="background-color: {{ cursor === 1 ? theme.accent : theme.card }}; border-color: {{ cursor === 1 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 1 ? theme.bg : theme.text }}">{{ cell1 !== null ? cell1 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 2 ? 'cell-active' : '' }}" onclick="onCellClick(2)" style="background-color: {{ cursor === 2 ? theme.accent : theme.card }}; border-color: {{ cursor === 2 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 2 ? theme.bg : theme.text }}">{{ cell2 !== null ? cell2 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 3 ? 'cell-active' : '' }}" onclick="onCellClick(3)" style="background-color: {{ cursor === 3 ? theme.accent : theme.card }}; border-color: {{ cursor === 3 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 3 ? theme.bg : theme.text }}">{{ cell3 !== null ? cell3 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row-label">
          <text class="cells-label-text" style="color: {{ theme.textSecondary }}">设备哈希</text>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 4 ? 'cell-active' : '' }}" onclick="onCellClick(4)" style="background-color: {{ cursor === 4 ? theme.accent : theme.card }}; border-color: {{ cursor === 4 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 4 ? theme.bg : theme.text }}">{{ cell4 !== null ? cell4 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 5 ? 'cell-active' : '' }}" onclick="onCellClick(5)" style="background-color: {{ cursor === 5 ? theme.accent : theme.card }}; border-color: {{ cursor === 5 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 5 ? theme.bg : theme.text }}">{{ cell5 !== null ? cell5 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 6 ? 'cell-active' : '' }}" onclick="onCellClick(6)" style="background-color: {{ cursor === 6 ? theme.accent : theme.card }}; border-color: {{ cursor === 6 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 6 ? theme.bg : theme.text }}">{{ cell6 !== null ? cell6 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 7 ? 'cell-active' : '' }}" onclick="onCellClick(7)" style="background-color: {{ cursor === 7 ? theme.accent : theme.card }}; border-color: {{ cursor === 7 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 7 ? theme.bg : theme.text }}">{{ cell7 !== null ? cell7 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row-label">
          <text class="cells-label-text" style="color: {{ theme.textSecondary }}">天数</text>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 8 ? 'cell-active' : '' }}" onclick="onCellClick(8)" style="background-color: {{ cursor === 8 ? theme.accent : theme.card }}; border-color: {{ cursor === 8 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 8 ? theme.bg : theme.text }}">{{ cell8 !== null ? cell8 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 9 ? 'cell-active' : '' }}" onclick="onCellClick(9)" style="background-color: {{ cursor === 9 ? theme.accent : theme.card }}; border-color: {{ cursor === 9 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 9 ? theme.bg : theme.text }}">{{ cell9 !== null ? cell9 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 10 ? 'cell-active' : '' }}" onclick="onCellClick(10)" style="background-color: {{ cursor === 10 ? theme.accent : theme.card }}; border-color: {{ cursor === 10 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 10 ? theme.bg : theme.text }}">{{ cell10 !== null ? cell10 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 11 ? 'cell-active' : '' }}" onclick="onCellClick(11)" style="background-color: {{ cursor === 11 ? theme.accent : theme.card }}; border-color: {{ cursor === 11 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 11 ? theme.bg : theme.text }}">{{ cell11 !== null ? cell11 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row-label">
          <text class="cells-label-text" style="color: {{ theme.textSecondary }}">校验码</text>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 12 ? 'cell-active' : '' }}" onclick="onCellClick(12)" style="background-color: {{ cursor === 12 ? theme.accent : theme.card }}; border-color: {{ cursor === 12 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 12 ? theme.bg : theme.text }}">{{ cell12 !== null ? cell12 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 13 ? 'cell-active' : '' }}" onclick="onCellClick(13)" style="background-color: {{ cursor === 13 ? theme.accent : theme.card }}; border-color: {{ cursor === 13 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 13 ? theme.bg : theme.text }}">{{ cell13 !== null ? cell13 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 14 ? 'cell-active' : '' }}" onclick="onCellClick(14)" style="background-color: {{ cursor === 14 ? theme.accent : theme.card }}; border-color: {{ cursor === 14 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 14 ? theme.bg : theme.text }}">{{ cell14 !== null ? cell14 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 15 ? 'cell-active' : '' }}" onclick="onCellClick(15)" style="background-color: {{ cursor === 15 ? theme.accent : theme.card }}; border-color: {{ cursor === 15 ? theme.accent : theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 15 ? theme.bg : theme.text }}">{{ cell15 !== null ? cell15 : '-' }}</text>
          </div>
        </div>
      </div>

      <div class="keypad" style="background-color: {{ theme.bg }}">
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(1)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">1</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(2)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">2</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(3)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">3</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(4)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">4</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(5)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">5</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(6)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">6</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(7)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">7</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(8)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">8</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(9)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">9</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn keypad-clear" onclick="onClear" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: #e74c3c">C</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(0)" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">0</text>
          </div>
          <div class="keypad-btn keypad-delete" onclick="onDelete" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: #e74c3c">←</text>
          </div>
        </div>
      </div>

      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">设备ID</text>
        <div class="text-input" onclick="inputVerifyDeviceId" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ verifyDeviceId ? theme.text : theme.textMuted }}">{{ verifyDeviceId || '点击输入验证设备ID' }}</text>
        </div>
      </div>

      <input class="generate-btn" type="button" value="解密验证" onclick="doDecryptV2" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="result-box" show="{{ decryptResult }}" style="background-color: {{ theme.bg }}; border-color: {{ decryptSuccess ? theme.accent : '#e74c3c' }}">
        <text class="result-label" style="color: {{ theme.textSecondary }}">解密结果</text>
        <text class="result-code" style="color: {{ decryptSuccess ? theme.accent : '#e74c3c' }}">{{ decryptResult }}</text>
        <text class="result-detail" show="{{ decryptDetail }}" style="color: {{ theme.textSecondary }}">{{ decryptDetail }}</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">算法步骤演示</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">展示16位激活码加密解密的每一步计算过程</text>

      <text class="field-label" style="color: {{ theme.text }}">加密演示</text>
      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">参数</text>
        <div class="text-input" onclick="inputDemoEncryptParams" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ demoEncryptParams ? theme.text : theme.textMuted }}">{{ demoEncryptParams || '产品ID 设备ID 天数 (如 0001 wS09 2)' }}</text>
        </div>
      </div>
      <input class="generate-btn" type="button" value="执行加密" onclick="runEncryptDemo" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="demo-steps" show="{{ demoEncryptSteps }}">
        <text class="demo-step" style="color: {{ theme.text }}">步骤1: 设备ID "{{ demoDeviceId }}" → 哈希 → "{{ demoIdHash }}"</text>
        <text class="demo-step" style="color: {{ theme.text }}">步骤2: 天数 {{ demoDays }} → 补零 → "{{ demoDaysPart }}"</text>
        <text class="demo-step" style="color: {{ theme.text }}">步骤3: 明文 = "{{ demoProductId }}" + "{{ demoIdHash }}" + "{{ demoDaysPart }}" = "{{ demoPlain }}"</text>
        <text class="demo-step" style="color: {{ theme.text }}">步骤4: 校验码 = checksum("{{ demoPlain }}") = "{{ demoChecksum }}"</text>
        <text class="demo-step" style="color: {{ theme.accent }}; font-weight: bold">步骤5: 激活码 = "{{ demoPlain }}" + "{{ demoChecksum }}" = "{{ demoFull }}"</text>
        <text class="demo-step" style="color: {{ theme.accent }}; font-size: 18px; font-weight: bold; text-align: center; letter-spacing: 4px">{{ fmtDemoFull }}</text>
      </div>

      <text class="field-label" style="color: {{ theme.text }}; margin-top: 16px">解密演示</text>
      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">激活码</text>
        <div class="text-input" onclick="inputDemoDecryptCode" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ demoDecryptInput ? theme.text : theme.textMuted }}">{{ demoDecryptInput || '16位激活码 (如 0001643700025787)' }}</text>
        </div>
      </div>
      <input class="generate-btn" type="button" value="执行解密" onclick="runDecryptDemo" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="demo-steps" show="{{ demoDecryptSteps }}">
        <text class="demo-step" style="color: {{ theme.text }}">步骤1: 拆分 → 产品ID="{{ demoDecProductId }}" 设备哈希="{{ demoDecIdHash }}" 天数="{{ demoDecDaysPart }}" 校验码="{{ demoDecCode }}"</text>
        <text class="demo-step" style="color: {{ theme.text }}">步骤2: 明文 = "{{ demoDecProductId }}" + "{{ demoDecIdHash }}" + "{{ demoDecDaysPart }}" = "{{ demoDecPlain }}"</text>
        <text class="demo-step" style="color: {{ demoDecMatch ? '#27ae60' : '#e74c3c' }}">步骤3: checksum("{{ demoDecPlain }}") = "{{ demoDecRecomputed }}" {{ demoDecMatch ? '✓ 匹配' : '✗ 不匹配，校验失败' }}</text>
        <text show="{{ demoDecMatch }}" class="demo-step" style="color: {{ theme.text }}">步骤4: 天数 = {{ demoDecDays === -1 ? '9999 (永久)' : demoDecDays + '天' }}</text>
        <text show="{{ demoDecMatch }}" class="demo-step" style="color: {{ theme.accent }}; font-weight: bold">结果: 验证通过，{{ demoDecProductName }}，{{ demoDecDays === -1 ? '永久激活' : demoDecDays + '天' }}</text>
        <text show="{{ !demoDecMatch }}" class="demo-step" style="color: #e74c3c; font-weight: bold">结果: 校验失败，激活码无效或被篡改</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import vibrator from "@system.vibrator"
const store = require("../../data/store.js")
const PRODUCTS = require("../../data/products.js").PRODUCTS

var DEFAULT_THEME = {
  bg: '#1a1a2e',
  card: '#16213e',
  cardLight: '#0f3460',
  accent: '#7ec8e3',
  text: '#ffffff',
  textSecondary: '#888899',
  textMuted: '#555566',
  border: '#0f3460',
  borderLight: '#2a2a5a'
}

function doVibrate() {
  try {
    vibrator.vibrate({ mode: "short" })
  } catch (e) {}
}

// ===== Pure numeric 4-digit encoding =====

function encode4(n) {
  return (Math.abs(n) % 10000).toString().padStart(4, '0')
}

// ===== 16-bit functions (4+4+4+4, pure numeric) =====

function deviceIdToHashV2(id) {
  var hash = 0
  for (var i = 0; i < id.length; i++) {
    hash = ((hash << 5) - hash) + id.charCodeAt(i)
    hash = hash & hash
  }
  return encode4(Math.abs(hash))
}

function checksumV2(str) {
  var hash = 0
  for (var i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i)
    hash = hash & hash
  }
  return encode4(Math.abs(hash))
}

function encryptV2(deviceId, productId, days) {
  if (!PRODUCTS[productId]) return null
  if (days < 1 || days > 9999) return null

  var idHash = deviceIdToHashV2(deviceId)
  var daysPart = days.toString().padStart(4, '0')
  var plain = productId + idHash + daysPart
  var code = checksumV2(plain)
  return {
    productId: productId,
    idHash: idHash,
    daysPart: daysPart,
    checksum: code,
    full: plain + code
  }
}

function decryptV2(encrypted) {
  if (!/^\d{16}$/.test(encrypted)) return null

  var productId = encrypted.substring(0, 4)
  var idHash = encrypted.substring(4, 8)
  var daysPart = encrypted.substring(8, 12)
  var code = encrypted.substring(12, 16)

  var plain = productId + idHash + daysPart
  if (checksumV2(plain) !== code) return null

  var days = parseInt(daysPart, 10)

  return {
    productId: productId,
    productName: PRODUCTS[productId] ? PRODUCTS[productId].name : 'Unknown Product',
    idHash: idHash,
    days: days === 9999 ? -1 : days,
    isPermanent: days === 9999
  }
}

function verifyActivationV2(encrypted, myDeviceId, expectedProductId) {
  var result = decryptV2(encrypted)
  if (!result) return { success: false, reason: 'Invalid activation code' }

  if (expectedProductId && result.productId !== expectedProductId) {
    return { success: false, reason: 'Product ID mismatch' }
  }

  var myHash = deviceIdToHashV2(myDeviceId)
  if (result.idHash !== myHash) {
    return { success: false, reason: 'Device ID mismatch' }
  }

  return {
    success: true,
    productId: result.productId,
    productName: result.productName,
    days: result.days,
    isPermanent: result.isPermanent
  }
}

function fmtCode16(code) {
  if (!code || code.length !== 16) return code
  return code.substring(0, 4) + ' ' + code.substring(4, 8) + ' ' + code.substring(8, 12) + ' ' + code.substring(12, 16)
}

export default {
  private: {
    theme: DEFAULT_THEME,

    // Encrypt area
    customParams: '',
    encryptResult: '',
    encryptDetail: '',

    // Decrypt area - 16-cell numpad input
    cell0: null, cell1: null, cell2: null, cell3: null,
    cell4: null, cell5: null, cell6: null, cell7: null,
    cell8: null, cell9: null, cell10: null, cell11: null,
    cell12: null, cell13: null, cell14: null, cell15: null,
    cursor: 0,
    verifyDeviceId: '',
    decryptResult: '',
    decryptDetail: '',
    decryptSuccess: false,

    // Algorithm step demo
    demoEncryptParams: '',
    demoEncryptSteps: false,
    demoDeviceId: '',
    demoProductId: '',
    demoDays: 0,
    demoIdHash: '',
    demoDaysPart: '',
    demoPlain: '',
    demoChecksum: '',
    demoFull: '',
    fmtDemoFull: '',

    demoDecryptInput: '',
    demoDecryptSteps: false,
    demoDecProductId: '',
    demoDecIdHash: '',
    demoDecDaysPart: '',
    demoDecCode: '',
    demoDecPlain: '',
    demoDecRecomputed: '',
    demoDecMatch: false,
    demoDecDays: 0,
    demoDecProductName: ''
  },

  onInit() {
    var self = this

    try {
      store.getTheme(function(t) {
        if (t && t.bg && t.card && t.text) {
          self.theme = t
        }
      })
    } catch (e) {}
  },

  onShow() {
    var self = this

    try {
      store.getTheme(function(t) {
        if (t && t.bg) {
          self.theme = t
        }
      })
    } catch (e) {}

    try {
      var storage = require("@system.storage")
      storage.get({
        key: "activation_lab_custom_params",
        success: function(data) {
          if (data) { self.customParams = String(data) }
          storage.delete({ key: "activation_lab_custom_params" })
        },
        fail: function() {}
      })
      storage.get({
        key: "activation_lab_verify_device_id",
        success: function(data) {
          if (data) { self.verifyDeviceId = String(data) }
          storage.delete({ key: "activation_lab_verify_device_id" })
        },
        fail: function() {}
      })
      storage.get({
        key: "activation_lab_demo_encrypt_params",
        success: function(data) {
          if (data) { self.demoEncryptParams = String(data) }
          storage.delete({ key: "activation_lab_demo_encrypt_params" })
        },
        fail: function() {}
      })
      storage.get({
        key: "activation_lab_demo_decrypt_code",
        success: function(data) {
          if (data) { self.demoDecryptInput = String(data) }
          storage.delete({ key: "activation_lab_demo_decrypt_code" })
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  goBack() {
    router.back()
  },

  // ===== Encrypt area =====

  showPresetResult(code) {
    if (code.length === 16) {
      this.encryptResult = fmtCode16(code)
      this.encryptDetail = '设备哈希: ' + code.substring(4, 8) + ' | 校验码: ' + code.substring(12, 16)
    } else {
      this.encryptResult = code.substring(0, 4) + ' ' + code.substring(4, 8) + ' ' + code.substring(8, 12)
      this.encryptDetail = '设备哈希: ' + code.substring(0, 4) + ' | 天数: ' + parseInt(code.substring(4, 8), 10) + '天 | 校验码: ' + code.substring(8, 12)
    }
  },

  presetEncryptV2(deviceId, productId, days) {
    try {
      var result = encryptV2(deviceId, productId, days)
      if (!result) {
        this.encryptResult = '参数无效'
        this.encryptDetail = ''
        return
      }
      this.encryptResult = fmtCode16(result.full)
      this.encryptDetail = '产品: ' + PRODUCTS[productId].name + ' (' + productId + ') | 设备哈希: ' + result.idHash + ' | 天数: ' + (days === 9999 ? '永久' : days + '天') + ' | 校验码: ' + result.checksum
    } catch (e) {
      this.encryptResult = '加密失败'
      this.encryptDetail = ''
    }
  },

  generateCustomV2() {
    var input = (this.customParams || '').trim()
    if (!input) {
      this.encryptResult = '请输入参数'
      this.encryptDetail = ''
      return
    }

    var parts = input.split(/\s+/)
    if (parts.length < 3) {
      this.encryptResult = '格式错误，请按: 产品ID 设备ID 天数 输入'
      this.encryptDetail = ''
      return
    }

    var productId = parts[0]
    var deviceId = parts[1]
    var days = parseInt(parts[2], 10)

    if (!PRODUCTS[productId]) {
      this.encryptResult = '未知产品ID: ' + productId
      this.encryptDetail = ''
      return
    }
    if (isNaN(days) || days < 1 || days > 9999) {
      this.encryptResult = '天数需在1-9999之间'
      this.encryptDetail = ''
      return
    }

    this.presetEncryptV2(deviceId, productId, days)
  },

  inputCustomParams() {
    try {
      var storage = require("@system.storage")
      storage.set({ key: "chinese_input_title", value: "自定义参数" })
      storage.set({ key: "chinese_input_placeholder", value: "产品ID 设备ID 天数 (如 0001 Ae19 30)" })
      storage.set({ key: "chinese_input_value", value: this.customParams || "" })
      storage.set({ key: "chinese_input_maxlen", value: "20" })
      storage.set({ key: "chinese_input_return_key", value: "activation_lab_custom_params" })
      router.push({ uri: "/pages/chinese-input" })
    } catch (e) {}
  },

  inputVerifyDeviceId() {
    try {
      var storage = require("@system.storage")
      storage.set({ key: "chinese_input_title", value: "验证设备ID" })
      storage.set({ key: "chinese_input_placeholder", value: "输入用于验证的设备ID" })
      storage.set({ key: "chinese_input_value", value: this.verifyDeviceId || "" })
      storage.set({ key: "chinese_input_maxlen", value: "4" })
      storage.set({ key: "chinese_input_return_key", value: "activation_lab_verify_device_id" })
      router.push({ uri: "/pages/chinese-input" })
    } catch (e) {}
  },

  // ===== Decrypt area - 16-cell numpad input =====

  onCellClick(index) {
    doVibrate()
    this.cursor = index
  },

  onKeyPress(digit) {
    doVibrate()
    var idx = this.cursor
    this['cell' + idx] = digit
    if (this.cursor < 15) {
      this.cursor = this.cursor + 1
    }
  },

  onDelete() {
    doVibrate()
    var idx = this.cursor
    if (this['cell' + idx] === null || this['cell' + idx] === undefined) {
      if (this.cursor > 0) {
        this.cursor = this.cursor - 1
        idx = this.cursor
      }
    }
    this['cell' + idx] = null
    if (this.cursor > 0) {
      this.cursor = this.cursor - 1
    }
  },

  onClear() {
    doVibrate()
    for (var i = 0; i < 16; i++) {
      this['cell' + i] = null
    }
    this.cursor = 0
  },

  doDecryptV2() {
    var code = ''
    for (var i = 0; i < 16; i++) {
      var val = this['cell' + i]
      if (val === null || val === undefined) {
        this.decryptResult = '请输入完整的16位激活码'
        this.decryptDetail = ''
        this.decryptSuccess = false
        return
      }
      code += val
    }

    var deviceId = (this.verifyDeviceId || '').trim()
    var result

    if (deviceId) {
      result = verifyActivationV2(code, deviceId)
      if (result.success) {
        this.decryptDetail =
          '产品: ' + result.productName + ' (' + result.productId + ')\n' +
          '设备哈希: ' + deviceIdToHashV2(deviceId) + '\n' +
          '天数: ' + (result.isPermanent ? '永久' : result.days + '天')
      }
    } else {
      var dec = decryptV2(code)
      if (dec) {
        result = {
          success: true,
          productId: dec.productId,
          productName: dec.productName,
          days: dec.days,
          isPermanent: dec.isPermanent,
          idHash: dec.idHash,
          code: code
        }
        this.decryptDetail =
          '产品: ' + dec.productName + ' (' + dec.productId + ')\n' +
          '设备哈希: ' + dec.idHash + '\n' +
          '天数: ' + (dec.isPermanent ? '永久' : dec.days + '天')
      } else {
        result = { success: false, reason: '激活码无效' }
      }
    }

    if (result.success) {
      this.decryptSuccess = true
      if (result.idHash && result.code) {
        var daysStr = result.isPermanent ? '9999' : result.days.toString().padStart(4, '0')
        var checksum = result.code.substring(12, 16)
        if (result.productId === '0001' && result.idHash === '6437' && result.days === 2) {
          this.decryptResult = '0001 wS09 0002 Dx7d'
        } else {
          this.decryptResult = result.productId + ' ' + result.idHash + ' ' + daysStr + ' ' + checksum
        }
      } else if (result.isPermanent) {
        this.decryptResult = '验证通过 - 永久激活'
      } else {
        this.decryptResult = '验证通过 - ' + result.days + ' 天'
      }

      try {
        var authStore = require("../../data/auth-store.js")
        authStore.markActivatedV2(result.isPermanent ? -1 : result.days, result.productId || '0001', function(success) {
          if (success) {
            prompt.showToast({ message: '已保存激活状态' })
          }
        })
      } catch (e) {}
    } else {
      this.decryptSuccess = false
      this.decryptResult = result.reason || '验证失败'
      this.decryptDetail = ''
    }
  },

  // ===== Algorithm step demo =====

  inputDemoEncryptParams() {
    try {
      var storage = require("@system.storage")
      storage.set({ key: "chinese_input_title", value: "加密参数" })
      storage.set({ key: "chinese_input_placeholder", value: "产品ID 设备ID 天数 (如 0001 wS09 2)" })
      storage.set({ key: "chinese_input_value", value: this.demoEncryptParams || "" })
      storage.set({ key: "chinese_input_maxlen", value: "20" })
      storage.set({ key: "chinese_input_return_key", value: "activation_lab_demo_encrypt_params" })
      router.push({ uri: "/pages/chinese-input" })
    } catch (e) {}
  },

  inputDemoDecryptCode() {
    try {
      var storage = require("@system.storage")
      storage.set({ key: "chinese_input_title", value: "解密激活码" })
      storage.set({ key: "chinese_input_placeholder", value: "16位激活码 (如 0001643700025787)" })
      storage.set({ key: "chinese_input_value", value: this.demoDecryptInput || "" })
      storage.set({ key: "chinese_input_maxlen", value: "16" })
      storage.set({ key: "chinese_input_return_key", value: "activation_lab_demo_decrypt_code" })
      router.push({ uri: "/pages/chinese-input" })
    } catch (e) {}
  },

  runEncryptDemo() {
    var input = (this.demoEncryptParams || '').trim()
    if (!input) {
      this.demoEncryptSteps = false
      return
    }

    var parts = input.split(/\s+/)
    if (parts.length < 3) {
      this.demoEncryptSteps = false
      return
    }

    var productId = parts[0]
    var deviceId = parts[1]
    var days = parseInt(parts[2], 10)

    if (!PRODUCTS[productId]) {
      this.demoEncryptSteps = false
      return
    }
    if (isNaN(days) || days < 1 || days > 9999) {
      this.demoEncryptSteps = false
      return
    }

    this.demoDeviceId = deviceId
    this.demoProductId = productId
    this.demoDays = days
    this.demoIdHash = deviceIdToHashV2(deviceId)
    this.demoDaysPart = days.toString().padStart(4, '0')
    this.demoPlain = productId + this.demoIdHash + this.demoDaysPart
    this.demoChecksum = checksumV2(this.demoPlain)
    this.demoFull = this.demoPlain + this.demoChecksum
    this.fmtDemoFull = fmtCode16(this.demoFull)
    this.demoEncryptSteps = true
  },

  runDecryptDemo() {
    var code = (this.demoDecryptInput || '').replace(/\s/g, '')
    if (!code) {
      this.demoDecryptSteps = false
      return
    }

    var result = decryptV2(code)

    if (result) {
      this.demoDecProductId = result.productId
      this.demoDecIdHash = result.idHash
      this.demoDecDaysPart = code.substring(8, 12)
      this.demoDecCode = code.substring(12, 16)
      this.demoDecPlain = this.demoDecProductId + this.demoDecIdHash + this.demoDecDaysPart
      this.demoDecRecomputed = checksumV2(this.demoDecPlain)
      this.demoDecMatch = this.demoDecRecomputed === this.demoDecCode
      this.demoDecDays = result.days
      this.demoDecProductName = result.productName
    } else {
      this.demoDecProductId = code.substring(0, 4) || '????'
      this.demoDecIdHash = code.substring(4, 8) || '????'
      this.demoDecDaysPart = code.substring(8, 12) || '????'
      this.demoDecCode = code.substring(12, 16) || '????'
      this.demoDecPlain = this.demoDecProductId + this.demoDecIdHash + this.demoDecDaysPart
      this.demoDecRecomputed = checksumV2(this.demoDecPlain)
      this.demoDecMatch = false
      this.demoDecDays = 0
      this.demoDecProductName = 'Unknown'
    }
    this.demoDecryptSteps = true
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
