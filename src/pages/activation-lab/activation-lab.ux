<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">激活码系统</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">加密生成</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">选择设备ID并设置天数，生成12位激活码</text>

      <text class="field-label" style="color: {{ theme.text }}">预设设备ID</text>
      <div class="preset-grid">
        <input class="preset-btn" type="button" value="{{ presetBtn0 }}" onclick="presetEncrypt('Aa09', 30)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        <input class="preset-btn" type="button" value="{{ presetBtn1 }}" onclick="presetEncrypt('Bb19', 90)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        <input class="preset-btn" type="button" value="{{ presetBtn2 }}" onclick="presetEncrypt('Xy99', 365)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        <input class="preset-btn" type="button" value="{{ presetBtn3 }}" onclick="presetEncrypt('AbCd', 9999)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        <input class="preset-btn" type="button" value="{{ presetBtn4 }}" onclick="presetEncrypt('TeSt', 7)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        <input class="preset-btn" type="button" value="{{ presetBtn5 }}" onclick="presetEncrypt('DeMo', 180)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
      </div>

      <text class="field-label" style="color: {{ theme.text }}">自定义输入</text>
      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">设备ID</text>
        <div class="text-input" onclick="inputDeviceId" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ customDeviceId ? theme.text : theme.textMuted }}">{{ customDeviceId || '点击输入设备ID' }}</text>
        </div>
      </div>
      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">天数</text>
        <div class="text-input" onclick="inputDays" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ customDays ? theme.text : theme.textMuted }}">{{ customDays || '点击输入天数（9999=永久）' }}</text>
        </div>
      </div>
      <input class="generate-btn" type="button" value="生成激活码" onclick="generateCustom" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="result-box" show="{{ encryptResult }}" style="background-color: {{ theme.bg }}; border-color: {{ theme.accent }}">
        <text class="result-label" style="color: {{ theme.textSecondary }}">加密结果</text>
        <text class="result-code" style="color: {{ theme.accent }}">{{ encryptResult }}</text>
        <text class="result-detail" style="color: {{ theme.textSecondary }}">{{ encryptDetail }}</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">解密验证</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">前4位+后4位含字母，中间4位纯数字</text>

      <div class="stepper-panel" style="background-color: {{ theme.bg }}">
        <div class="stepper-row">
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(0)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d0 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(0)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(1)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d1 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(1)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(2)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d2 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(2)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(3)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d3 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(3)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        </div>
        <div class="stepper-row">
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(4)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d4 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(4)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(5)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d5 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(5)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(6)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d6 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(6)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(7)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d7 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(7)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        </div>
        <div class="stepper-row">
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(8)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d8 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(8)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(9)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d9 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(9)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(10)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d10 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(10)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-gap"></text>
          <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(11)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          <text class="stepper-val" style="color: {{ theme.text }}">{{ d11 }}</text>
          <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(11)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
        </div>
      </div>

      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">设备ID</text>
        <div class="text-input" onclick="inputVerifyDeviceId" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ verifyDeviceId ? theme.text : theme.textMuted }}">{{ verifyDeviceId || '点击输入验证设备ID' }}</text>
        </div>
      </div>

      <input class="generate-btn" type="button" value="解密验证" onclick="doDecrypt" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

      <div class="result-box" show="{{ decryptResult }}" style="background-color: {{ theme.bg }}; border-color: {{ decryptSuccess ? theme.accent : '#e74c3c' }}">
        <text class="result-label" style="color: {{ theme.textSecondary }}">解密结果</text>
        <text class="result-code" style="color: {{ decryptSuccess ? theme.accent : '#e74c3c' }}">{{ decryptResult }}</text>
        <text class="result-detail" show="{{ decryptDetail }}" style="color: {{ theme.textSecondary }}">{{ decryptDetail }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")

var CHARSET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
var DIGITS = "0123456789"
var BASE = 62

function encode4(n) {
  var result = ''
  var v = n
  for (var i = 0; i < 4; i++) {
    result = CHARSET[v % BASE] + result
    v = Math.floor(v / BASE)
  }
  return result
}

function decode4(s) {
  var n = 0
  for (var i = 0; i < 4; i++) {
    n = n * BASE + CHARSET.indexOf(s[i])
  }
  return n
}

function deviceIdToHash(id) {
  var hash = 0
  for (var i = 0; i < id.length; i++) {
    hash = ((hash << 5) - hash) + id.charCodeAt(i)
    hash = hash & hash
  }
  return encode4(Math.abs(hash) % 10000)
}

function checksum(str) {
  var hash = 0
  for (var i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i)
    hash = hash & hash
  }
  return encode4(Math.abs(hash) % 10000)
}

function encrypt(deviceId, days) {
  if (days < 1 || days > 9999) return null
  var idPart = deviceIdToHash(deviceId)
  var daysPart = days.toString().padStart(4, '0')
  var plain = idPart + daysPart
  var code = checksum(plain)
  return {
    idPart: idPart,
    daysPart: daysPart,
    code: code,
    full: plain + code
  }
}

function decrypt(encrypted) {
  if (encrypted.length !== 12) return null
  var idPart = encrypted.substring(0, 4)
  var daysPart = encrypted.substring(4, 8)
  var code = encrypted.substring(8, 12)
  if (!/^\d{4}$/.test(daysPart)) return null
  var plain = idPart + daysPart
  if (checksum(plain) !== code) return null
  var days = parseInt(daysPart, 10)
  return {
    idHash: idPart,
    days: days === 9999 ? -1 : days,
    isPermanent: days === 9999
  }
}

function verifyActivation(encrypted, myDeviceId) {
  var result = decrypt(encrypted)
  if (!result) return { success: false, reason: '激活码无效' }
  var myHash = deviceIdToHash(myDeviceId)
  if (result.idHash !== myHash) {
    return { success: false, reason: '设备ID不匹配' }
  }
  return {
    success: true,
    days: result.days,
    isPermanent: result.isPermanent
  }
}

function fmtCode12(code) {
  if (!code || code.length !== 12) return code
  return code.substring(0, 4) + ' ' + code.substring(4, 8) + ' ' + code.substring(8, 12)
}

export default {
  private: {
    theme: {},
    customDeviceId: '',
    customDays: '',
    encryptResult: '',
    encryptDetail: '',
    verifyDeviceId: '',
    d0: '0', d1: '0', d2: '0', d3: '0',
    d4: '0', d5: '0', d6: '0', d7: '0',
    d8: '0', d9: '0', d10: '0', d11: '0',
    decryptResult: '',
    decryptDetail: '',
    decryptSuccess: false,
    presetBtn0: 'Aa09 / 30天',
    presetBtn1: 'Bb19 / 90天',
    presetBtn2: 'Xy99 / 365天',
    presetBtn3: 'AbCd / 永久',
    presetBtn4: 'TeSt / 7天',
    presetBtn5: 'DeMo / 180天'
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.loadDemoCode()
    self.buildPresetLabels()
  },

  buildPresetLabels() {
    var presets = [
      { id: 'Aa09', days: 30, key: 'presetBtn0' },
      { id: 'Bb19', days: 90, key: 'presetBtn1' },
      { id: 'Xy99', days: 365, key: 'presetBtn2' },
      { id: 'AbCd', days: 9999, key: 'presetBtn3' },
      { id: 'TeSt', days: 7, key: 'presetBtn4' },
      { id: 'DeMo', days: 180, key: 'presetBtn5' }
    ]
    for (var i = 0; i < presets.length; i++) {
      var p = presets[i]
      var r = encrypt(p.id, p.days)
      if (r) {
        this[p.key] = fmtCode12(r.full)
      }
    }
  },

  loadDemoCode() {
    var demo = encrypt("Aa09", 30)
    if (demo && demo.full) {
      var code = demo.full
      for (var i = 0; i < 12; i++) {
        this['d' + i] = code[i]
      }
    }
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })

    var storage = require("@system.storage")
    storage.get({
      key: "activation_lab_device_id",
      success: function(data) {
        if (data !== undefined && data !== null) {
          self.customDeviceId = data
          storage.delete({ key: "activation_lab_device_id" })
        }
      }
    })
    storage.get({
      key: "activation_lab_days",
      success: function(data) {
        if (data !== undefined && data !== null) {
          self.customDays = data
          storage.delete({ key: "activation_lab_days" })
        }
      }
    })
    storage.get({
      key: "activation_lab_verify_device_id",
      success: function(data) {
        if (data !== undefined && data !== null) {
          self.verifyDeviceId = data
          storage.delete({ key: "activation_lab_verify_device_id" })
        }
      }
    })
  },

  goBack() {
    router.back()
  },

  increaseDigit(index) {
    var charset = (index >= 4 && index <= 7) ? DIGITS : CHARSET
    var current = this['d' + index]
    var pos = charset.indexOf(current)
    if (pos < 0) pos = 0
    if (pos < charset.length - 1) {
      pos++
    } else {
      pos = 0
    }
    this['d' + index] = charset[pos]
  },

  decreaseDigit(index) {
    var charset = (index >= 4 && index <= 7) ? DIGITS : CHARSET
    var current = this['d' + index]
    var pos = charset.indexOf(current)
    if (pos < 0) pos = 0
    if (pos > 0) {
      pos--
    } else {
      pos = charset.length - 1
    }
    this['d' + index] = charset[pos]
  },

  inputDeviceId() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "设备ID" })
    storage.set({ key: "chinese_input_placeholder", value: "输入设备ID（如 Aa09）" })
    storage.set({ key: "chinese_input_value", value: this.customDeviceId || "" })
    storage.set({ key: "chinese_input_maxlen", value: "4" })
    storage.set({ key: "chinese_input_return_key", value: "activation_lab_device_id" })
    router.push({ uri: "/pages/chinese-input" })
  },

  inputDays() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "天数" })
    storage.set({ key: "chinese_input_placeholder", value: "输入天数（9999=永久）" })
    storage.set({ key: "chinese_input_value", value: this.customDays || "" })
    storage.set({ key: "chinese_input_maxlen", value: "4" })
    storage.set({ key: "chinese_input_return_key", value: "activation_lab_days" })
    router.push({ uri: "/pages/chinese-input" })
  },

  inputVerifyDeviceId() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "验证设备ID" })
    storage.set({ key: "chinese_input_placeholder", value: "输入用于验证的设备ID" })
    storage.set({ key: "chinese_input_value", value: this.verifyDeviceId || "" })
    storage.set({ key: "chinese_input_maxlen", value: "4" })
    storage.set({ key: "chinese_input_return_key", value: "activation_lab_verify_device_id" })
    router.push({ uri: "/pages/chinese-input" })
  },

  presetEncrypt(deviceId, days) {
    var result = encrypt(deviceId, days)
    if (!result) {
      this.encryptResult = '天数无效'
      this.encryptDetail = ''
      return
    }
    this.encryptResult = fmtCode12(result.full)
    this.encryptDetail = '设备ID: ' + deviceId + ' | 哈希: ' + result.idPart + ' | 天数: ' + days + '天 | 校验码: ' + result.code
  },

  generateCustom() {
    var deviceId = this.customDeviceId.trim()
    var days = parseInt(this.customDays.trim(), 10)
    if (!deviceId) {
      this.encryptResult = '请输入设备ID'
      this.encryptDetail = ''
      return
    }
    if (isNaN(days) || days < 1 || days > 9999) {
      this.encryptResult = '天数需在1-9999之间'
      this.encryptDetail = ''
      return
    }
    this.presetEncrypt(deviceId, days)
  },

  doDecrypt() {
    var code = ''
    for (var i = 0; i < 12; i++) {
      code += this['d' + i] || '0'
    }

    var deviceId = this.verifyDeviceId.trim()
    var result
    var codeChecksum = code.substring(8, 12)

    if (deviceId) {
      result = verifyActivation(code, deviceId)
      if (result.success) {
        var myHash = deviceIdToHash(deviceId)
        this.decryptDetail = '设备ID哈希: ' + myHash + ' | 天数: ' + (result.isPermanent ? '永久' : result.days + '天') + ' | 校验码: ' + codeChecksum
      }
    } else {
      var dec = decrypt(code)
      if (dec) {
        result = {
          success: true,
          days: dec.days,
          isPermanent: dec.isPermanent
        }
        this.decryptDetail = '设备ID哈希: ' + dec.idHash + ' | 天数: ' + (dec.isPermanent ? '永久' : dec.days + '天') + ' | 校验码: ' + codeChecksum
      } else {
        result = { success: false, reason: '激活码无效' }
      }
    }

    if (result.success) {
      this.decryptSuccess = true
      if (result.isPermanent) {
        this.decryptResult = '验证通过 - 永久激活'
      } else {
        this.decryptResult = '验证通过 - ' + result.days + ' 天'
      }

      var authStore = require("../../data/auth-store.js")
      authStore.markActivated(result.isPermanent ? -1 : result.days, function(success) {
        if (success) {
          prompt.showToast({ message: '已保存激活状态' })
        }
      })
    } else {
      this.decryptSuccess = false
      this.decryptResult = result.reason || '验证失败'
      this.decryptDetail = ''
    }
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  margin-left: 8px;
}

.section {
  flex-direction: column;
  border-radius: 10px;
  padding: 14px 12px;
  margin-bottom: 10px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 4px;
}

.section-desc {
  font-size: 12px;
  margin-bottom: 10px;
}

.field-label {
  font-size: 13px;
  margin-top: 8px;
  margin-bottom: 6px;
}

.preset-grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.preset-btn {
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 12px;
  margin-right: 6px;
  margin-bottom: 6px;
  border-width: 1px;
}

.input-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.input-prefix {
  font-size: 13px;
  width: 50px;
}

.text-input {
  flex: 1;
  height: 36px;
  border-radius: 6px;
  padding: 0 8px;
  border-width: 1px;
  justify-content: center;
}

.input-text {
  font-size: 14px;
}

.generate-btn {
  height: 40px;
  border-radius: 8px;
  font-size: 15px;
  margin-top: 8px;
  text-align: center;
}

.result-box {
  flex-direction: column;
  border-radius: 8px;
  padding: 10px;
  margin-top: 10px;
  border-width: 1px;
}

.result-label {
  font-size: 11px;
  margin-bottom: 4px;
}

.result-code {
  font-size: 22px;
  font-weight: bold;
  letter-spacing: 4px;
  text-align: center;
}

.result-detail {
  font-size: 11px;
  margin-top: 4px;
}

.stepper-panel {
  flex-direction: column;
  border-radius: 8px;
  padding: 8px;
  margin-bottom: 8px;
}

.stepper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 4px;
}

.stepper-btn {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
}

.stepper-val {
  width: 32px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
}

.stepper-gap {
  width: 10px;
}
</style>