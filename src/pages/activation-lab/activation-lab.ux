  font-size: 13px;
  margin-top: 8px;
  margin-bottom: 6px;
}

.preset-list {
  flex-direction: column;
}

.preset-btn {
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 12px;
  margin-right: 6px;
  margin-bottom: 6px;
  border-width: 1px;
}

.preset-btn-full {
  margin-right: 0;
  margin-bottom: 5px;
  width: 100%;
}

.input-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.input-prefix {
  font-size: 13px;
  width: 50px;
}

.text-input {
  flex: 1;
  height: 36px;
  border-radius: 6px;
  padding: 0 8px;
  border-width: 1px;
  justify-content: center;
}

.input-text {
  font-size: 14px;
}

.generate-btn {
  height: 40px;
  border-radius: 8px;
  font-size: 15px;
  margin-top: 8px;
  text-align: center;
}

.result-box {
  flex-direction: column;
  border-radius: 8px;
  padding: 10px;
  margin-top: 10px;
  border-width: 1px;
}

.result-label {
  font-size: 11px;
  margin-bottom: 4px;
}

.result-code {
  font-size: 22px;
  font-weight: bold;
  letter-spacing: 4px;
  text-align: center;
}

.result-detail {
  font-size: 11px;
  margin-top: 4px;
}

/* Numpad cells grid */
.cells-grid {
  flex-direction: column;
  border-radius: 10px;
  padding: 8px;
  margin-bottom: 10px;
}

.cells-row-label {
  flex-direction: row;
  margin-top: 4px;
  margin-bottom: 2px;
}

.cells-label-text {
  font-size: 11px;
}

.cells-row {
  flex-direction: row;
  justify-content: center;
}

.cell {
  width: 36px;
  height: 26px;
  border-radius: 6px;
  border-width: 1px;
  margin: 2px;
  justify-content: center;
  align-items: center;
}

.cell-active {
  border-width: 2px;
  border-color: #ff8c00;
}

.cell-text {
  font-size: 14px;
  font-weight: bold;
}

/* Numpad keypad */
.keypad {
  flex-direction: column;
  border-radius: 10px;
  padding: 8px;
  margin-bottom: 10px;
}

.keypad-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 4px;
}

.keypad-btn {
  width: 48px;
  height: 34px;
  border-radius: 8px;
  border-width: 1px;
  border-style: solid;
  justify-content: center;
  align-items: center;
  margin-left: 10px;
  margin-right: 10px;
}

.keypad-text {
  font-size: 18px;
  font-weight: bold;
}

/* Algorithm step demo */
.demo-steps {
  flex-direction: column;
  background-color: #1a1a2e;
  border-radius: 8px;
  padding: 10px;
  margin-top: 10px;
}

.demo-step {
  font-size: 13px;
  margin-bottom: 6px;
  line-height: 20px;
}

@media (shape: circle) {
  .lab-page {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    padding: 0 20px;
    justify-content: center;
  }
}

@media (shape: capsule) {
  .lab-page {
    padding: 44px 8px 12px 8px;
  }
}

