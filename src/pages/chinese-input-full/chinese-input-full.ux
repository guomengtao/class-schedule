<template>
  <div class="input-page" style="background-color: {{ theme.bg }}">
    <div class="content-body">
      <div class="header">
        <input class="back-btn" type="button" value="back" onclick="onCancel" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
        <text class="title" style="color: {{ theme.text }}">{{ title }}</text>
        <input class="confirm-btn" type="button" value="OK" onclick="onConfirm" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="display-area" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="display-text" style="font-size: {{ fontSize }}px; color: {{ theme.text }}">{{ inputValue || placeholder }}</text>
        <text class="cursor" show="{{ showCursor }}" style="font-size: {{ fontSize }}px; color: {{ theme.accent }}">_</text>
      </div>

      <div class="keyboard-container">
        <component-inputmethod
          hide="{{hideKeyboard}}"
          maxlength="{{maxlen}}"
          screentype="{{ screenType }}"
          oncomplete="onCharacter"
          ondelete="onDeleteChar"
        ></component-inputmethod>
      </div>

      <div class="font-bar">
        <text class="font-label" style="color: {{ theme.textSecondary }}">Font:</text>
        <text class="font-btn" onclick="setFontSize(20)" style="background-color: {{ baseFontSize === 20 ? theme.accent : theme.card }}; color: {{ baseFontSize === 20 ? theme.bg : theme.text }}">20</text>
        <text class="font-btn" onclick="setFontSize(24)" style="background-color: {{ baseFontSize === 24 ? theme.accent : theme.card }}; color: {{ baseFontSize === 24 ? theme.bg : theme.text }}">24</text>
        <text class="font-btn" onclick="setFontSize(28)" style="background-color: {{ baseFontSize === 28 ? theme.accent : theme.card }}; color: {{ baseFontSize === 28 ? theme.bg : theme.text }}">28</text>
        <text class="font-btn" onclick="setFontSize(36)" style="background-color: {{ baseFontSize === 36 ? theme.accent : theme.card }}; color: {{ baseFontSize === 36 ? theme.bg : theme.text }}">36</text>
        <text class="font-btn" onclick="setFontSize(48)" style="background-color: {{ baseFontSize === 48 ? theme.accent : theme.card }}; color: {{ baseFontSize === 48 ? theme.bg : theme.text }}">48</text>
        <text class="font-btn" onclick="setFontSize(60)" style="background-color: {{ baseFontSize === 60 ? theme.accent : theme.card }}; color: {{ baseFontSize === 60 ? theme.bg : theme.text }}">60</text>
      </div>
    </div>

    <text class="footer-text" style="color: {{ theme.textSecondary }}">输入法 - 02 - 完整输入 - chinese-input-full</text>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import device from "@system.device"
const store = require("../../data/store.js")

var FONT_KEY = "inputFontSize"
var FONT_DEFAULT = 36

function getFontSize(callback) {
  storage.get({
    key: FONT_KEY,
    success: function(data) {
      var size = parseInt(data) || FONT_DEFAULT
      if (size < 20) size = 20
      if (size > 60) size = 60
      callback(size)
    },
    fail: function() { callback(FONT_DEFAULT) }
  })
}

function setFontSizeStore(size, callback) {
  storage.set({
    key: FONT_KEY,
    value: String(size),
    success: function() { if (callback) callback() },
    fail: function() { if (callback) callback() }
  })
}

export default {
  components: {
    InputMethod: "../../components/InputMethod/InputMethod.ux"
  },

  private: {
    title: "Input",
    placeholder: "tap to input",
    inputValue: "",
    maxlen: 5,
    screenType: "circle",
    theme: store.DEFAULT_THEME,
    hideKeyboard: true,
    showCursor: false,
    returnKey: "chinese_input_result",
    fontSize: 0,
    baseFontSize: 0
  },

  onInit() {
    var self = this
    device.getInfo({
      success: function(data) {
        self.screenType = data.screenShape || "circle"
      },
      fail: function() {
        self.screenType = "circle"
      }
    })
  },

  onShow() {
    var self = this

    self.hideKeyboard = true

    getFontSize(function(size) {
      self.baseFontSize = size
      self.applyFontSize(size)
      self.showKeyboard()
    })

    storage.get({
      key: "chinese_input_title",
      success: function(data) { if (data) self.title = data },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_placeholder",
      success: function(data) { if (data) self.placeholder = data },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_value",
      success: function(data) {
        if (data !== undefined && data !== null) self.inputValue = data
      },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_maxlen",
      success: function(data) { if (data) self.maxlen = parseInt(data) || 5 },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_return_key",
      success: function(data) { if (data) self.returnKey = data },
      fail: function() {}
    })
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.showCursor = true
  },

  onCharacter(ev) {
    var text = ev.detail.content
    if (!text) return
    if (this.inputValue.length >= this.maxlen) return
    this.inputValue += text
  },

  onDeleteChar() {
    this.inputValue = this.inputValue.slice(0, -1)
  },

  setFontSize(size) {
    var self = this
    self.baseFontSize = size
    setFontSizeStore(size, function() {
      self.applyFontSize(size)
    })
  },

  applyFontSize(size) {
    if (!size || size < 20) size = FONT_DEFAULT
    this.fontSize = size
  },

  onConfirm() {
    var self = this
    var result = self.inputValue || ""
    storage.set({
      key: self.returnKey,
      value: result,
      success: function() {
        router.back()
      },
      fail: function() {
        router.back()
      }
    })
  },

  onCancel() {
    router.back()
  }
}
</script>

<style>
.input-page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.content-body {
  flex-direction: column;
  flex: 1;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
  padding: 4px 0;
}

.back-btn {
  width: 54px;
  height: 40px;
  border-radius: 10px;
  font-size: 14px;
  text-align: center;
}

.title {
  flex: 1;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-left: 12px;
  margin-right: 12px;
}

.confirm-btn {
  width: 54px;
  height: 40px;
  border-radius: 10px;
  font-size: 14px;
  text-align: center;
}

.display-area {
  width: 100%;
  height: 48px;
  border-radius: 10px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  margin-bottom: 8px;
}

.display-text {
  font-size: 20px;
  lines: 1;
  text-overflow: ellipsis;
  max-width: 90%;
}

.cursor {
  font-size: 20px;
  margin-left: 2px;
}

.keyboard-container {
  flex: 1;
  min-height: 320px;
}

.font-bar {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 8px 0 12px 0;
  margin-top: 8px;
  flex-shrink: 0;
}

.font-label {
  font-size: 13px;
  margin-right: 6px;
}

.font-btn {
  width: 34px;
  height: 30px;
  border-radius: 6px;
  margin: 2px;
  font-size: 13px;
  text-align: center;
  font-weight: bold;
}

.footer-text {
  font-size: 12px;
  text-align: center;
  padding-bottom: 4px;
  flex-shrink: 0;
}

@media (shape: circle) {
  .input-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    margin-bottom: 8px;
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 44px;
    height: 32px;
    font-size: 14px;
  }
  .title {
    font-size: 18px;
    margin-left: 8px;
    margin-right: 8px;
  }
  .confirm-btn {
    width: 44px;
    height: 32px;
    font-size: 14px;
  }
  .display-area {
    height: 40px;
    font-size: 17px;
  }
  .display-text {
    font-size: 17px;
  }
  .cursor {
    font-size: 17px;
  }
  .font-bar {
    padding: 4px 0 8px 0;
  }
  .font-btn {
    width: 30px;
    height: 26px;
    font-size: 12px;
  }
}

@media (shape: capsule) {
  .input-page {
    padding: 44px 8px 12px 8px;
  }
}
</style>