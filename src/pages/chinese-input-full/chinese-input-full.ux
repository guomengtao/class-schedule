<template>
  <div class="input-page" style="background-color: {{ theme.bg }}">
    <div class="content-body">
      <div class="header">
        <input class="back-btn" type="button" value="返回" onclick="onCancel" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
        <text class="title" style="color: {{ theme.text }}">{{ title }}</text>
        <input class="confirm-btn" type="button" value="确认" onclick="onConfirm" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="display-area" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="display-text" style="font-size: {{ fontSize }}px; color: {{ theme.text }}">{{ inputValue || placeholder }}</text>
        <text class="cursor" show="{{ showCursor }}" style="font-size: {{ fontSize }}px; color: {{ theme.accent }}">_</text>
      </div>

      <div class="keyboard-area" show="{{ !hideKeyboard }}">
        <text class="pinyin-row" show="{{ pinyinDisplay }}" style="color: {{ theme.accent }}">{{ pinyinDisplay }}</text>

        <scroll class="candidate-row" show="{{ candidateRow.length > 0 }}" scroll-x="{{true}}">
          <text for="{{ item in candidateRow }}" class="candidate-item" onclick="onSelectCandidate(item)" style="background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
        </scroll>

        <div class="keyboard">
          <div class="key-row" show="{{ !numFlag }}">
            <text for="{{ item in keys.full[0] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          </div>
          <div class="key-row" show="{{ !numFlag }}">
            <text for="{{ item in keys.full[1] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          </div>
          <div class="key-row" show="{{ !numFlag }}">
            <text for="{{ item in keys.full[2] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
            <text class="key-btn key-del" onclick="onDeleteKey" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
          </div>

          <div class="key-row" show="{{ numFlag }}">
            <text for="{{ item in keys.sign[0] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          </div>
          <div class="key-row" show="{{ numFlag }}">
            <text for="{{ item in keys.sign[1] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
          </div>
          <div class="key-row" show="{{ numFlag }}">
            <text for="{{ item in keys.sign[2] }}" class="key-btn" onclick="onKeyPress(item)" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.text }}">{{ item }}</text>
            <text class="key-btn key-del" onclick="onDeleteKey" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}">Del</text>
          </div>

          <div class="key-row key-bottom">
            <text class="key-btn key-func" onclick="toggleNumMode" show="{{ lang === 'cn' || numFlag }}" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ numFlag ? 'ABC' : '123' }}</text>
            <text class="key-btn key-func" onclick="toggleShift" show="{{ lang === 'en' && !numFlag }}" style="font-size: {{ keyFontSize }}px; background-color: {{ shiftFlag ? theme.accent : theme.card }}; color: {{ shiftFlag ? theme.bg : theme.accent }}">Shift</text>
            <text class="key-btn key-func" onclick="toggleLang" style="font-size: {{ keyFontSize }}px; background-color: {{ theme.card }}; color: {{ theme.accent }}">{{ lang === 'cn' ? 'EN' : '中' }}</text>
          </div>
        </div>

        <div class="font-bar">
          <text class="font-label" style="color: {{ theme.textSecondary }}">字体:</text>
          <text class="font-btn" onclick="setFontSize(20)" style="background-color: {{ baseFontSize === 20 ? theme.accent : theme.card }}; color: {{ baseFontSize === 20 ? theme.bg : theme.text }}">20</text>
          <text class="font-btn" onclick="setFontSize(24)" style="background-color: {{ baseFontSize === 24 ? theme.accent : theme.card }}; color: {{ baseFontSize === 24 ? theme.bg : theme.text }}">24</text>
          <text class="font-btn" onclick="setFontSize(28)" style="background-color: {{ baseFontSize === 28 ? theme.accent : theme.card }}; color: {{ baseFontSize === 28 ? theme.bg : theme.text }}">28</text>
          <text class="font-btn" onclick="setFontSize(36)" style="background-color: {{ baseFontSize === 36 ? theme.accent : theme.card }}; color: {{ baseFontSize === 36 ? theme.bg : theme.text }}">36</text>
          <text class="font-btn" onclick="setFontSize(48)" style="background-color: {{ baseFontSize === 48 ? theme.accent : theme.card }}; color: {{ baseFontSize === 48 ? theme.bg : theme.text }}">48</text>
          <text class="font-btn" onclick="setFontSize(60)" style="background-color: {{ baseFontSize === 60 ? theme.accent : theme.card }}; color: {{ baseFontSize === 60 ? theme.bg : theme.text }}">60</text>
        </div>
      </div>
    </div>

    <text class="footer-text" style="color: {{ theme.textSecondary }}">中文输入法 · 完整版</text>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import storage from "@system.storage"
const store = require("../../data/store.js")
import { SimpleInputMethod } from "../../components/InputMethod/assets/dicUtil.js"

var dictReady = false
var FONT_KEY = "inputFontSize"
var FONT_DEFAULT = 36

function ensureDict() {
  if (!dictReady) {
    dictReady = true
    SimpleInputMethod.initDict()
  }
}

function getFontSize(callback) {
  storage.get({
    key: FONT_KEY,
    success: function(data) {
      var size = parseInt(data) || FONT_DEFAULT
      if (size < 20) size = 20
      if (size > 60) size = 60
      callback(size)
    },
    fail: function() { callback(FONT_DEFAULT) }
  })
}

function setFontSizeStore(size, callback) {
  storage.set({
    key: FONT_KEY,
    value: String(size),
    success: function() { if (callback) callback() },
    fail: function() { if (callback) callback() }
  })
}

export default {
  private: {
    title: "输入",
    placeholder: "点击输入",
    inputValue: "",
    maxlen: 5,
    theme: store.DEFAULT_THEME,
    hideKeyboard: true,
    showCursor: false,
    returnKey: "chinese_input_result",
    fontSize: 0,
    keyFontSize: 0,
    baseFontSize: 0,
    cval: "",
    pinyinDisplay: "",
    lang: "cn",
    numFlag: false,
    shiftFlag: false,
    candidateRow: [],
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"]
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["-", "/", ":", ";", "(", ")", "$", "&", "@", "\""],
        [".", ",", "?", "!", "'"]
      ]
    }
  },

  onInit() {
  },

  onShow() {
    var self = this

    self.hideKeyboard = true

    getFontSize(function(size) {
      self.baseFontSize = size
      self.applyFontSize(size)
      self.showKeyboard()
    })

    storage.get({
      key: "chinese_input_title",
      success: function(data) { if (data) self.title = data },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_placeholder",
      success: function(data) { if (data) self.placeholder = data },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_value",
      success: function(data) {
        if (data !== undefined && data !== null) self.inputValue = data
      },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_maxlen",
      success: function(data) { if (data) self.maxlen = parseInt(data) || 5 },
      fail: function() {}
    })
    storage.get({
      key: "chinese_input_return_key",
      success: function(data) { if (data) self.returnKey = data },
      fail: function() {}
    })
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.showCursor = true
    ensureDict()
  },

  doVibrate() {
    vibrator.vibrate({ mode: "short" })
  },

  setFontSize(size) {
    var self = this
    self.baseFontSize = size
    setFontSizeStore(size, function() {
      self.applyFontSize(size)
    })
  },

  applyFontSize(size) {
    if (!size || size < 20) size = FONT_DEFAULT
    this.fontSize = size
    this.keyFontSize = Math.round(size * 0.6)
  },

  onKeyPress(item) {
    if (!item) return
    this.doVibrate()

    if (this.lang === "cn" && !this.numFlag) {
      this.cval += item.toLowerCase()
      this.updateCandidates()
    } else {
      if (this.inputValue.length >= this.maxlen) return
      var char = item
      if (this.lang === "en" && !this.numFlag && !this.shiftFlag) {
        char = item.toLowerCase()
      }
      this.inputValue += char
    }
  },

  onDeleteKey() {
    this.doVibrate()
    if (this.cval.length > 0) {
      this.cval = this.cval.slice(0, -1)
      this.updateCandidates()
    } else {
      this.inputValue = this.inputValue.slice(0, -1)
    }
  },

  onSelectCandidate(item) {
    if (!item) return
    this.doVibrate()

    if (this.inputValue.length >= this.maxlen) return

    var consumed = false
    if (item.length === 1 && this._sylTopChars && this._sylTopChars.length > 0 && this.cval.length > 0) {
      for (var si = 0; si < this._sylTopChars.length; si++) {
        var sc = this._sylTopChars[si]
        if (sc.char === item && sc.offset > 0 && sc.offset <= this.cval.length) {
          this.inputValue += item
          this.cval = this.cval.slice(sc.offset)
          consumed = true
          break
        }
      }
    }
    if (consumed) {
      this.updateCandidates()
      return
    }

    if (item.length === 1 && this._matchedLen > 0 && this.cval.length > this._matchedLen) {
      this.inputValue += item
      this.cval = this.cval.slice(this._matchedLen)
      this.updateCandidates()
      return
    }

    this.inputValue += item
    this.cval = ""
    this.updateCandidates()
  },

  updateCandidates() {
    var self = this
    this.pinyinDisplay = this.cval ? SimpleInputMethod.getSegmentedDisplay(this.cval) : ""

    if (!this.cval || this.lang !== "cn") {
      self.candidateRow = []
      return
    }

    var result = SimpleInputMethod.getHanzi(this.cval, "cn")
    var chars = result.chars || []
    self._matchedLen = result.matched ? result.matched.length : 0
    var multi = result.multi || { words: [], composed: "", sylTopChars: [] }
    self._sylTopChars = (multi.sylTopChars || []).filter(function(sc) { return sc.char && sc.offset > 0 })

    var row0 = []
    var words = (multi.words || []).slice()
    if (words.length === 0 && multi.composed && multi.composed.length >= 2) {
      words = [multi.composed]
    } else if (multi.composed && multi.composed.length >= 2 && words.indexOf(multi.composed) === -1) {
      words.push(multi.composed)
    }

    var sylChars = self._sylTopChars.map(function(sc) { return sc.char })
    var seen = {}
    var uniqueSyl = []
    for (var si = 0; si < sylChars.length; si++) {
      if (!seen[sylChars[si]]) { seen[sylChars[si]] = 1; uniqueSyl.push(sylChars[si]) }
    }
    for (var si2 = 0; si2 < uniqueSyl.length; si2++) {
      if (words.indexOf(uniqueSyl[si2]) === -1) words.push(uniqueSyl[si2])
    }

    for (var i = 0; i < words.length && row0.length < self.maxlen; i++) {
      row0.push(words[i])
    }
    for (var j = 0; j < chars.length && row0.length < self.maxlen; j++) {
      if (words.indexOf(chars[j]) === -1) row0.push(chars[j])
    }

    self.candidateRow = row0
  },

  toggleNumMode() {
    this.doVibrate()
    this.numFlag = !this.numFlag
    this.cval = ""
    this.candidateRow = []
  },

  toggleShift() {
    this.doVibrate()
    this.shiftFlag = !this.shiftFlag
  },

  toggleLang() {
    this.doVibrate()
    this.lang = this.lang === "cn" ? "en" : "cn"
    this.cval = ""
    this.candidateRow = []
  },

  onConfirm() {
    var self = this
    var result = self.inputValue || ""
    storage.set({
      key: self.returnKey,
      value: result,
      success: function() {
        router.back()
      },
      fail: function() {
        router.back()
      }
    })
  },

  onCancel() {
    router.back()
  }
}
</script>

<style>
.input-page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.content-body {
  flex-direction: column;
  flex: 1;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
  padding: 4px 0;
}

.back-btn {
  width: 54px;
  height: 40px;
  border-radius: 10px;
  font-size: 14px;
  text-align: center;
}

.title {
  flex: 1;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-left: 12px;
  margin-right: 12px;
}

.confirm-btn {
  width: 54px;
  height: 40px;
  border-radius: 10px;
  font-size: 14px;
  text-align: center;
}

.display-area {
  width: 100%;
  height: 48px;
  border-radius: 10px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  margin-bottom: 8px;
}

.display-text {
  font-size: 20px;
  lines: 1;
  text-overflow: ellipsis;
  max-width: 90%;
}

.cursor {
  font-size: 20px;
  margin-left: 2px;
}

.keyboard-area {
  flex-direction: column;
  flex: 1;
}

.pinyin-row {
  font-size: 16px;
  padding: 4px 8px;
  lines: 1;
  text-overflow: ellipsis;
  min-height: 24px;
}

.candidate-row {
  height: 42px;
  margin-bottom: 4px;
}

.candidate-item {
  font-size: 20px;
  padding: 6px 12px;
  border-radius: 8px;
  margin-right: 6px;
  height: 36px;
  text-align: center;
}

.keyboard {
  flex-direction: column;
  flex: 1;
}

.key-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.key-btn {
  width: 34px;
  height: 40px;
  border-radius: 8px;
  margin: 2px;
  text-align: center;
  font-weight: bold;
}

.key-del {
  width: 46px;
  font-weight: bold;
}

.key-bottom {
  flex-direction: row;
  justify-content: center;
  margin-top: 4px;
}

.key-func {
  flex: 1;
  max-width: 60px;
  min-height: 28px;
  font-weight: bold;
  text-align: center;
  border-radius: 6px;
  margin-left: 2px;
  margin-right: 2px;
  lines: 1;
  text-overflow: ellipsis;
}

.font-bar {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 8px 0 12px 0;
  margin-top: 8px;
  flex-shrink: 0;
}

.font-label {
  font-size: 14px;
  margin-right: 6px;
}

.font-btn {
  width: 36px;
  height: 30px;
  border-radius: 6px;
  margin: 0 3px;
  text-align: center;
  font-size: 14px;
}

.footer-text {
  font-size: 12px;
  text-align: center;
  padding: 8px 0;
  flex-shrink: 0;
}

@media (shape: circle) {
  .input-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    margin-bottom: 8px;
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 44px;
    height: 32px;
    font-size: 14px;
  }
  .title {
    font-size: 18px;
    margin-left: 8px;
    margin-right: 8px;
  }
  .confirm-btn {
    width: 44px;
    height: 32px;
    font-size: 14px;
  }
  .display-area {
    height: 40px;
    font-size: 17px;
  }
  .display-text {
    font-size: 17px;
  }
  .cursor {
    font-size: 17px;
  }
  .key-btn {
    width: 28px;
    height: 34px;
    font-size: 13px;
  }
  .key-del {
    width: 40px;
  }
  .candidate-item {
    font-size: 17px;
    padding: 4px 10px;
    height: 30px;
  }
}

@media (shape: capsule) {
  .input-page {
    padding: 44px 8px 12px 8px;
  }
  .header {
    margin-bottom: 8px;
    justify-content: center;
  }
  .back-btn {
    width: 48px;
    height: 36px;
    font-size: 14px;
  }
  .title {
    font-size: 18px;
    margin-left: 8px;
    margin-right: 8px;
  }
  .confirm-btn {
    width: 48px;
    height: 36px;
    font-size: 14px;
  }
  .display-area {
    height: 44px;
  }
}
</style>