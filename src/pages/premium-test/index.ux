  font-size: 12px;
  flex-shrink: 0;
}

.upgrade-section {
  border-radius: 12px;
  padding: 14px;
  margin-top: 10px;
  margin-bottom: 10px;
  flex-direction: column;
  align-items: center;
}

.upgrade-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 6px;
}

.upgrade-desc {
  font-size: 13px;
  text-align: center;
  margin-bottom: 10px;
  line-height: 18px;
}

.upgrade-btn {
  width: 80%;
  height: 36px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: bold;
  text-align: center;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 10px 0 4px 0;
}

.pin-link {
  font-size: 13px;
  text-align: center;
}
</style>