        <text class="feature-desc" style="color: {{ theme.textSecondary }}">上课前自动提醒，不错过每一节课</text>
      </div>
    </div>

    <div class="overlay" if="{{ showOverlay }}" style="background-color: rgba(0,0,0,0.7)">
      <div class="overlay-card" style="background-color: {{ theme.card }}">
        <text class="overlay-icon">⭐</text>
        <text class="overlay-title" style="color: {{ theme.text }}">高级版功能</text>
        <text class="overlay-desc" style="color: {{ theme.textSecondary }}">此页面展示了高级版的全部功能。标准版用户可使用部分功能，激活高级版即可解锁全部。</text>
        <input class="overlay-btn primary" type="button" value="去激活" onclick="goActivation"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="overlay-btn" type="button" value="取消" onclick="dismissOverlay"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: store.DEFAULT_THEME,
    showOverlay: true
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  goBack() {
    router.back()
  },

  goActivation() {
    router.push({ uri: "/pages/activation" })
  },

  dismissOverlay() {
    this.showOverlay = false
  }
}
</script>

