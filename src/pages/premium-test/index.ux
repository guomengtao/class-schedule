<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">高级版预览</text>
    </div>

    <div class="content">
      <div class="feature-card" style="background-color: {{ theme.card }}">
        <text class="feature-icon">🎨</text>
        <text class="feature-title" style="color: {{ theme.text }}">10套精美主题</text>
        <text class="feature-desc" style="color: {{ theme.textSecondary }}">深色/浅色/多彩主题随心切换</text>
      </div>

      <div class="feature-card" style="background-color: {{ theme.card }}">
        <text class="feature-icon">📅</text>
        <text class="feature-title" style="color: {{ theme.text }}">多课程表管理</text>
        <text class="feature-desc" style="color: {{ theme.textSecondary }}">支持最多10个独立课程表</text>
      </div>

      <div class="feature-card" style="background-color: {{ theme.card }}">
        <text class="feature-icon">💾</text>
        <text class="feature-title" style="color: {{ theme.text }}">数据备份与恢复</text>
        <text class="feature-desc" style="color: {{ theme.textSecondary }}">随时备份，安全恢复</text>
      </div>

      <div class="feature-card" style="background-color: {{ theme.card }}">
        <text class="feature-icon">🏠</text>
        <text class="feature-title" style="color: {{ theme.text }}">首页自定义</text>
        <text class="feature-desc" style="color: {{ theme.textSecondary }}">个性化首页布局与内容</text>
      </div>

      <div class="feature-card" style="background-color: {{ theme.card }}">
