<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">高级版预览</text>
    </div>

    <text class="badge" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">🔒 高级版功能一览</text>

    <scroll class="scroll" scroll-y="{{true}}">
      <div class="feature" for="{{ features }}" style="background-color: {{ theme.card }}">
        <text class="feature-icon" style="color: {{ theme.accent }}">{{ $item.icon }}</text>
        <div class="feature-info">
          <text class="feature-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="feature-desc" style="color: {{ theme.textSecondary }}">{{ $item.desc }}</text>
        </div>
        <text class="feature-status" style="color: {{ $item.unlocked ? theme.accent : theme.textMuted }}">{{ $item.unlocked ? '已解锁' : '🔒' }}</text>
      </div>

      <div class="upgrade-section" style="background-color: {{ theme.card }}">
        <text class="upgrade-title" style="color: {{ theme.accent }}">升级到高级版</text>
        <text class="upgrade-desc" style="color: {{ theme.textSecondary }}">解锁全部高级功能，享受更强大的课程管理体验</text>
        <input class="upgrade-btn" type="button" value="立即升级" onclick="goToActivation" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </scroll>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}">📌 固定到首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var pinHelper = require("../../data/pin-helper.js")

export default {
  private: {
    theme: store.DEFAULT_THEME,
    features: [
      { icon: "📅", name: "多课表管理", desc: "创建和管理多个课程表", unlocked: false },
      { icon: "💾", name: "数据备份恢复", desc: "备份和恢复课程数据", unlocked: false },
      { icon: "🎨", name: "10套主题", desc: "丰富的主题配色方案", unlocked: false },
      { icon: "🏠", name: "首页自定义", desc: "自定义首页显示内容", unlocked: false },
      { icon: "📊", name: "课程统计", desc: "查看课程数据统计", unlocked: false },
      { icon: "📱", name: "二维码分享", desc: "生成课表二维码分享", unlocked: false },
      { icon: "⏰", name: "课程提醒", desc: "上课前震动提醒", unlocked: false },
      { icon: "📌", name: "页面固定", desc: "将页面固定到首页", unlocked: false }
    ]
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    store.isPremiumUnlocked(function(unlocked) {
      for (var i = 0; i < self.features.length; i++) {
        self.features[i].unlocked = unlocked
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    store.isPremiumUnlocked(function(unlocked) {
      for (var i = 0; i < self.features.length; i++) {
        self.features[i].unlocked = unlocked
      }
    })
  },

  goBack() {
    router.back()
  },

  goToActivation() {
    router.push({ uri: "/pages/activation" })
  },

  pinToHome() {
    pinHelper.pinPage("高级版预览", "/pages/premium-test")
  }
}
</script>

