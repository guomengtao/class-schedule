  font-size: 14px;
  font-weight: bold;
  text-align: center;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 10px;
}

.scroll {
  flex: 1;
  flex-direction: column;
}

.feature {
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
  padding: 10px 12px;
  margin-bottom: 6px;
}

.feature-icon {
  font-size: 18px;
  margin-right: 10px;
  flex-shrink: 0;
}

.feature-info {
  flex-direction: column;
  flex: 1;
}

