  height: 48px;
}

.quick-add-list {
  flex-direction: row;
}

.quick-add-item {
  padding: 6px 16px;
  margin-right: 8px;
  border-radius: 8px;
  background-color: #0f3460;
}

.quick-add-name {
  font-size: 24px;
  color: #ffffff;
}

.quick-add-empty {
  font-size: 20px;
  color: #555566;
  text-align: center;
  padding: 8px;
}

.bottom-buttons {
  flex-direction: row;
  justify-content: space-between;
}

.add-btn {
  width: 100px;
  height: 36px;
  border-radius: 8px;
  background-color: #7ec8e3;
  font-size: 14px;
  font-weight: bold;
  color: #1a1a2e;
  text-align: center;
}

.style-btn {
  width: 100px;
  height: 36px;
  border-radius: 8px;
  background-color: #0f3460;
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.week-indicator {
  align-items: center;
  justify-content: center;
  padding: 8px 0;
}

.week-text {
  font-size: 20px;
  color: #7ec8e3;
  text-align: center;
}

@media (shape: circle) {
  .schedule-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    padding: 6px 12px;
    justify-content: center;
  }
  .nav-btn {
    width: 44px;
    height: 36px;
    border-radius: 18px;
    font-size: 16px;
  }
  .clock-text {
    font-size: 14px;
  }
  .day-title {
    font-size: 16px;
  }
  .status-bar {
    padding: 4px 12px;
    margin-bottom: 4px;
    height: 38px;
  }
  .status-tag {
    font-size: 12px;
    padding: 1px 10px;
    margin-right: 8px;
  }
  .status-middle {
    font-size: 16px;
  }
  .status-right {
    font-size: 14px;
    min-width: 40px;
  }
  .status-time {
    font-size: 22px;
  }
  .class-card-wrapper {
    margin-bottom: 4px;
  }
  .class-content {
    padding: 8px 12px;
  }
  .class-name {
    font-size: 20px;
    flex: 1;
  }
  .class-time-text {
    font-size: 20px;
  }
  .class-location {
    font-size: 20px;
  }
  .class-progress {
    font-size: 18px;
  }
  .quick-add {
    padding: 6px;
  }
  .quick-add-item {
    padding: 4px 10px;
    margin-right: 4px;
  }
  .quick-add-name {
    font-size: 18px;
  }
}

@media (shape: capsule) {
  .schedule-page {
    padding: 44px 4px 10px 4px;
  }

  .header {
    padding: 2px 0;
    margin-bottom: 2px;
    justify-content: center;
  }
  .nav-btn {
    width: 28px;
    height: 24px;
    border-radius: 12px;
    font-size: 12px;
  }
  .day-title {
    font-size: 15px;
    font-weight: bold;
    margin: 0 2px;
  }

  .status-bar {
    padding: 2px 6px;
    height: 26px;
    margin-bottom: 3px;
    border-left-width: 3px;
    border-radius: 8px;
  }
  .status-tag {
    font-size: 10px;
