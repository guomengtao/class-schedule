    margin-right: 4px;
    border-radius: 6px;
  }
  .status-middle {
    font-size: 12px;
    max-lines: 1;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .class-card-wrapper {
    margin-bottom: 2px;
  }
  .class-content {
    padding: 3px 5px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .class-time {
    flex-direction: row;
    align-items: center;
    margin-bottom: 0;
  }
  .class-name {
    font-size: 15px;
    font-weight: bold;
    max-width: 80px;
    text-overflow: ellipsis;
    max-lines: 1;
    overflow: hidden;
  }
  .class-time-text {
    font-size: 11px;
    max-width: 45px;
    text-overflow: ellipsis;
    max-lines: 1;
    overflow: hidden;
    margin-left: 3px;
    color: #a0a0b0;
  }
  .class-info {
    flex-direction: row;
    align-items: center;
  }
  .class-progress {
    font-size: 10px;
    min-width: 24px;
    text-align: right;
  }

  .quick-add {
    padding: 2px 4px;
    margin-bottom: 2px;
  }
  .quick-add-title {
    font-size: 10px;
    margin-bottom: 2px;
  }
  .quick-add-item {
    padding: 2px 6px;
    margin-right: 2px;
  }
  .quick-add-name {
    font-size: 11px;
  }

  .bottom-buttons {
    justify-content: space-around;
  }
  .add-btn, .style-btn {
    width: 48px;
    height: 22px;
    font-size: 9px;
    border-radius: 6px;
  }
  .week-indicator {
    padding: 2px 0;
  }
  .week-text {
    font-size: 12px;
  }
}

@media (shape: capsule) and (max-width: 240px) {
  .class-name {
    font-size: 16px;
    max-width: 100px;
  }
  .add-btn, .style-btn {
    width: 40px;
    height: 20px;
    font-size: 8px;
  }
}

@media (shape: rect) {
  .schedule-page {
    padding: 44px 6px 6px 6px;
  }
  .header {
    padding: 4px 2px;
    margin-bottom: 2px;
  }
  .nav-btn {
    width: 36px;
    height: 36px;
    border-radius: 18px;
