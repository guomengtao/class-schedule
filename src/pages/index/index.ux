<template>
  <div class="page">
    <text class="title">模块加载测试</text>
    <text class="msg" for="{{ messages }}">{{ $item }}</text>
    <text class="count">共加载 {{ count }} 个模块</text>
  </div>
</template>

<script>
import router from "@system.router"

var modules = {}
var moduleNames = [
  { key: "js1" },
  { key: "js2" },
  { key: "js3" },
  { key: "js4" },
  { key: "js5" },
  { key: "js6" },
  { key: "js7" }
]

function loadModule(key, mod) {
  if (mod && mod.msg) {
    modules[key] = mod
  } else {
    modules[key] = null
  }
}

loadModule("js1", require("./modules/js1.js"))
loadModule("js2", require("./modules/js2.js"))
loadModule("js3", require("./modules/js3.js"))
loadModule("js4", require("./modules/js4.js"))
loadModule("js5", require("./modules/js5.js"))
loadModule("js6", require("./modules/js6.js"))
loadModule("js7", require("./modules/js7.js"))

export default {
  private: {
    messages: [],
    count: 0
  },

  onInit() {
    var self = this
    console.log("[test] onInit start, " + moduleNames.length + " modules")

    var msgs = []
    var okCount = 0
    for (var i = 0; i < moduleNames.length; i++) {
      var m = moduleNames[i]
      var mod = modules[m.key]
      if (mod && mod.msg) {
        msgs.push(mod.msg)
        okCount++
        console.log("[test] " + m.key + " OK: " + mod.msg)
      } else {
        msgs.push(m.key + " 加载失败")
        console.log("[test] " + m.key + " FAIL")
      }
    }

    self.messages = msgs
    self.count = okCount
    console.log("[test] onInit done, " + okCount + "/" + moduleNames.length + " loaded")
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
  background-color: #1a1a2e;
  min-height: 100%;
}

.title {
  font-size: 32px;
  color: #7ec8e3;
  margin-bottom: 30px;
  font-weight: bold;
}

.msg {
  font-size: 24px;
  color: #ffffff;
  margin: 10px 0;
  padding: 12px 30px;
  background-color: #16213e;
  border-radius: 8px;
  width: 80%;
  text-align: center;
}

.count {
  font-size: 20px;
  color: #888899;
  margin-top: 30px;
}
</style>