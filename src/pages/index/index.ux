<template>
  <div class="schedule-page">

    <div class="status-bar" onclick="goToCurrentClass">
      <div class="status-current" if="{{ currentClass }}">
        <text class="status-icon">&#128218;</text>
        <text class="status-text">
          Now: {{ currentClass.name }}
          <text class="status-time" if="{{ currentClass.remaining > 0 }}">
            {{ currentClass.remaining }}min left
          </text>
          <text class="status-time" if="{{ currentClass.remaining <= 0 }}">ending</text>
        </text>
      </div>
      <div class="status-next" if="{{ nextClass }}">
        <text class="status-icon">&#9654;</text>
        <text class="status-text">Next: {{ nextClass.name }} {{ nextClass.startTime }}</text>
      </div>
      <div class="status-break" if="{{ !currentClass && nextClass }}">
        <text class="status-icon">&#9200;</text>
        <text class="status-text">{{ nextClass.waitMin }}min to next class</text>
      </div>
      <div class="status-free" if="{{ !currentClass && !nextClass && currentClasses.length > 0 }}">
        <text class="status-icon">&#9989;</text>
        <text class="status-text">All done for today</text>
      </div>
      <div class="status-free" if="{{ !currentClass && !nextClass && currentClasses.length === 0 }}">
        <text class="status-icon">&#127881;</text>
        <text class="status-text">No classes today</text>
      </div>
    </div>

    <div class="header">
      <input class="nav-btn" type="button" value="&#9664;" onclick="prevDay" />
      <text class="day-title" style="{{ dayTitleStyle }}">{{ currentDay }}</text>
      <input class="nav-btn" type="button" value="&#9654;" onclick="nextDay" />
    </div>

    <div class="quick-add">
      <text class="quick-add-title" style="{{ weekTextStyle }}">快速添加</text>
      <div class="quick-add-buttons">
        <input class="quick-btn" type="button" value="数学" onclick="quickAddMath" style="{{ btnTextStyle }}" />
        <input class="quick-btn" type="button" value="英语" onclick="quickAddEnglish" style="{{ btnTextStyle }}" />
        <input class="quick-btn" type="button" value="科学" onclick="quickAddScience" style="{{ btnTextStyle }}" />
      </div>
    </div>

    <div class="class-list">
      <div for="{{ currentClasses }}" class="class-card-wrapper">
        <div class="class-card" ontouchstart="handleTouchStart($event, $item.id)" ontouchend="handleTouchEnd($event, $item.id)" onclick="openDetail($item.id)">
          <div class="class-time">
            <text class="class-name" style="{{ nameStyle }}">{{ $item.name }}</text>
            <text class="class-time-text" style="{{ nameStyle }}">{{ $item.time }}</text>
          </div>
          <div class="class-info">
            <text class="class-location" style="{{ nameStyle }}">{{ $item.location }}</text>
          </div>
        </div>
        <div if="{{ swipedId === $item.id }}" class="delete-btn" onclick="deleteCourse($item.id)">
          <text class="delete-btn-text">删除</text>
        </div>
      </div>

      <div if="{{ currentClasses.length === 0 }}" class="empty-card">
        <text class="empty-text" style="{{ nameStyle }}">今天没有课</text>
      </div>
    </div>

    <div class="bottom-buttons">
      <input class="add-btn" type="button" value="+ 添加课程" onclick="openAddCoursePage" />
      <input class="style-btn" type="button" value="设置" onclick="openSettings" />
    </div>

    <div class="week-indicator" onclick="openScheduleManager">
      <text class="week-text" style="{{ weekTextStyle }}">课程表{{ currentWeek }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

const dayNames = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]

function parseTime(timeStr) {
  var parts = timeStr.split(":")
  var hours = parseInt(parts[0]) || 0
  var minutes = parseInt(parts[1]) || 0
  return hours * 60 + minutes
}

export default {
  private: {
    currentDay: "星期一",
    currentWeek: 1,
    currentDayIndex: 0,
    currentClasses: [],
    schedule: [],
    nextId: 50,
    fontScale: 1.0,
    dayTitleStyle: "",
    weekTextStyle: "",
    nameStyle: "",
    btnTextStyle: "",
    swipedId: "",
    touchStartX: 0,
    touchStartY: 0,
    isActive: true,
    currentClass: null,
    nextClass: null,
    statusTimer: null
  },

  onInit() {
    console.log("[INDEX] onInit, currentDay=" + this.currentDay)
    var self = this
    database.init(function() {
      console.log("[INDEX] onInit database ready")
      database.getAllCourses(function(schedule) {
        console.log("[INDEX] onInit getAllCourses: " + schedule.length + " days")
        self.schedule = schedule
        self.loadDayClasses()
        self.updateStatus()
        self.startStatusTimer()
      })
    })
    var dayIndex = new Date().getDay()
    if (dayIndex >= 1 && dayIndex <= 5) {
      this.currentDayIndex = dayIndex - 1
      this.currentDay = dayNames[dayIndex - 1]
    } else {
      this.currentDayIndex = 0
      this.currentDay = dayNames[0]
    }
    store.getFontScale(function(scale) {
      self.fontScale = scale
      self.applyFontScale()
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentWeek = idx + 1
    })
    this.applyFontScale()
  },

  onShow() {
    console.log("[INDEX] onShow triggered")
    this.isActive = true
    var self = this
    store.getFontScale(function(scale) {
      self.fontScale = scale
      self.applyFontScale()
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentWeek = idx + 1
    })
    this.applyFontScale()
    database.getAllCourses(function(schedule) {
      console.log("[INDEX] onShow getAllCourses: " + schedule.length + " days")
      self.schedule = schedule
      self.loadDayClasses()
      self.updateStatus()
      self.startStatusTimer()
    })
  },

  onHide() {
    console.log("[INDEX] onHide: page hidden, disabling touch events")
    this.isActive = false
    this.stopStatusTimer()
  },

  onDestroy() {
    console.log("[INDEX] onDestroy: page destroyed")
    this.stopStatusTimer()
  },

  applyFontScale() {
    var s = this.fontScale
    if (!s || s < 0.5) { s = 1.0 }
    this.dayTitleStyle = "font-size: " + Math.round(20 * s) + "px"
    this.weekTextStyle = "font-size: " + Math.round(14 * s) + "px"
    this.nameStyle = "font-size: " + Math.round(28 * s) + "px"
    this.btnTextStyle = "font-size: " + Math.round(14 * s) + "px"
  },

  loadDayClasses() {
    console.log("[INDEX] loadDayClasses START: day=" + this.currentDay + ", scheduleDays=" + this.schedule.length)
    var dayData = null
    for (var i = 0; i < this.schedule.length; i++) {
      if (this.schedule[i].day === this.currentDay) {
        dayData = this.schedule[i]
        break
      }
    }
    this.currentClasses = []
    var newClasses = dayData ? dayData.classes : []
    this.currentClasses = newClasses
    console.log("[INDEX] loadDayClasses: day=" + this.currentDay + ", scheduleDays=" + this.schedule.length + ", matched=" + (dayData ? "yes(" + dayData.classes.length + ")" : "no") + ", currentClasses=" + this.currentClasses.length)
    for (var i = 0; i < this.currentClasses.length; i++) {
      console.log("[INDEX]   class[" + i + "]: " + this.currentClasses[i].id + " " + this.currentClasses[i].name)
    }
    console.log("[INDEX] loadDayClasses END")
    this.updateStatus()
  },

  prevDay() {
    if (this.currentDayIndex > 0) {
      this.currentDayIndex--
    } else {
      this.currentDayIndex = dayNames.length - 1
    }
    this.currentDay = dayNames[this.currentDayIndex]
    this.loadDayClasses()
  },

  nextDay() {
    if (this.currentDayIndex < dayNames.length - 1) {
      this.currentDayIndex++
    } else {
      this.currentDayIndex = 0
    }
    this.currentDay = dayNames[this.currentDayIndex]
    this.loadDayClasses()
  },

  openDetail(classId) {
    console.log("[INDEX] openDetail: classId=" + classId + ", day=" + this.currentDay)
    var storage = require("@system.storage")
    storage.set({
      key: "detail_classId",
      value: String(classId)
    })
    storage.set({
      key: "detail_day",
      value: this.currentDay
    })
    router.push({
      uri: "/pages/detail"
    })
  },

  openAddCoursePage() {
    router.push({
      uri: "/pages/add-course",
      params: {
        day: this.currentDay,
        nextId: this.nextId
      }
    })
  },

  openSettings() {
    router.push({
      uri: "/pages/settings"
    })
  },

  openScheduleManager() {
    router.push({
      uri: "/pages/schedule-manager"
    })
  },

  makeCourse(name, time, teacher, location) {
    var self = this
    var newCourse = {
      id: String(this.nextId),
      day: this.currentDay,
      name: name,
      time: time,
      teacher: teacher,
      location: location,
      notes: ""
    }
    console.log("[INDEX] makeCourse: " + JSON.stringify(newCourse))
    this.nextId++
    database.insertCourse(newCourse, function(success) {
      console.log("[INDEX] insertCourse callback success=" + success)
      database.getAllCourses(function(schedule) {
        console.log("[INDEX] getAllCourses after insert: " + schedule.length + " days")
        self.schedule = schedule
        self.loadDayClasses()
      })
    })
  },

  quickAddMath() {
    console.log("[INDEX] quickAddMath")
    this.makeCourse("数学", "08:00 - 08:45", "王老师", "301教室")
  },

  quickAddEnglish() {
    console.log("[INDEX] quickAddEnglish")
    this.makeCourse("英语", "08:55 - 09:40", "李老师", "205教室")
  },

  quickAddScience() {
    this.makeCourse("科学", "10:00 - 10:45", "吴老师", "实验室B")
  },

  handleTouchStart(e) {
    if (!this.isActive || !e || !e.touches || e.touches.length === 0) {
      return
    }
    this.touchStartX = e.touches[0].clientX
    this.touchStartY = e.touches[0].clientY
  },

  handleTouchEnd(e, id) {
    if (!this.isActive || !e || !e.changedTouches || e.changedTouches.length === 0) {
      return
    }
    var endX = e.changedTouches[0].clientX
    var endY = e.changedTouches[0].clientY
    var dx = endX - this.touchStartX
    var dy = endY - this.touchStartY
    var absDx = dx < 0 ? -dx : dx
    var absDy = dy < 0 ? -dy : dy
    if (absDx > 30 && absDx > absDy) {
      if (dx < 0) {
        this.swipedId = id
      } else {
        this.swipedId = ""
      }
    } else {
      this.swipedId = ""
    }
  },

  deleteCourse(id) {
    console.log("[INDEX] deleteCourse: " + id)
    var self = this
    var day = this.currentDay
    database.deleteCourse(id, day, function(success) {
      console.log("[INDEX] deleteCourse callback success=" + success)
      self.swipedId = ""
      database.getAllCourses(function(schedule) {
        console.log("[INDEX] getAllCourses after delete: " + schedule.length + " days")
        self.schedule = schedule
        self.loadDayClasses()
      })
    })
  },

  startStatusTimer() {
    this.stopStatusTimer()
    var self = this
    this.statusTimer = setInterval(function() {
      self.updateStatus()
    }, 60000)
  },

  stopStatusTimer() {
    if (this.statusTimer) {
      clearInterval(this.statusTimer)
      this.statusTimer = null
    }
  },

  updateStatus() {
    var todayClasses = this.currentClasses
    if (!todayClasses || todayClasses.length === 0) {
      this.currentClass = null
      this.nextClass = null
      return
    }

    var now = new Date()
    var nowMinutes = now.getHours() * 60 + now.getMinutes()

    var parsed = []
    for (var i = 0; i < todayClasses.length; i++) {
      var cls = todayClasses[i]
      var timeParts = cls.time.split("-")
      if (timeParts.length < 2) continue
      var startMin = parseTime(timeParts[0].trim())
      var endMin = parseTime(timeParts[1].trim())
      parsed.push({
        id: cls.id,
        name: cls.name,
        time: cls.time,
        startMin: startMin,
        endMin: endMin,
        startTime: timeParts[0].trim()
      })
    }

    parsed.sort(function(a, b) {
      return a.startMin - b.startMin
    })

    var current = null
    var next = null

    for (var i = 0; i < parsed.length; i++) {
      var cls = parsed[i]
      if (nowMinutes >= cls.startMin && nowMinutes <= cls.endMin) {
        current = {
          name: cls.name,
          remaining: Math.round((cls.endMin - nowMinutes) / 60 * 10) / 10,
          id: cls.id
        }
        if (i + 1 < parsed.length) {
          var nextCls = parsed[i + 1]
          next = {
            name: nextCls.name,
            startTime: nextCls.startTime,
            waitMin: Math.round((nextCls.startMin - nowMinutes) / 60 * 10) / 10,
            id: nextCls.id
          }
        }
        break
      }
      if (nowMinutes < cls.startMin) {
        if (!next || cls.startMin < next.startMin) {
          next = {
            name: cls.name,
            startTime: cls.startTime,
            waitMin: Math.round((cls.startMin - nowMinutes) / 60 * 10) / 10,
            id: cls.id
          }
        }
      }
    }

    this.currentClass = current
    this.nextClass = next
  },

  goToCurrentClass() {
    var target = this.currentClass || this.nextClass
    if (!target) {
      console.log("[INDEX] goToCurrentClass: no class to jump to")
      return
    }
    console.log("[INDEX] goToCurrentClass: " + target.name + " (id=" + target.id + ")")
    var storage = require("@system.storage")
    storage.set({
      key: "detail_classId",
      value: String(target.id)
    })
    storage.set({
      key: "detail_day",
      value: this.currentDay
    })
    router.push({
      uri: "/pages/detail"
    })
  }
}
</script>

<style>
.schedule-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 8px;
  height: 100%;
}

.status-bar {
  flex-direction: column;
  background-color: #0f3460;
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 8px;
  border-left-width: 4px;
  border-left-color: #7ec8e3;
  border-left-style: solid;
}

.status-current {
  flex-direction: row;
  align-items: center;
}

.status-next {
  flex-direction: row;
  align-items: center;
  margin-top: 4px;
  border-top-width: 1px;
  border-top-color: #1a2a4e;
  border-top-style: solid;
  padding-top: 4px;
}

.status-break {
  flex-direction: row;
  align-items: center;
}

.status-free {
  flex-direction: row;
  align-items: center;
}

.status-icon {
  font-size: 16px;
  margin-right: 6px;
}

.status-text {
  font-size: 14px;
  color: #ffffff;
  flex: 1;
}

.status-time {
  font-size: 13px;
  color: #7ec8e3;
  font-weight: bold;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8px 4px;
  margin-bottom: 4px;
}

.day-title {
  font-size: 20px;
  font-weight: bold;
  color: #e0e0e0;
  text-align: center;
  flex: 1;
}

.nav-btn {
  width: 44px;
  height: 32px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 14px;
  color: #7ec8e3;
  text-align: center;
}

.week-indicator {
  align-items: center;
  margin-bottom: 8px;
}

.week-text {
  font-size: 14px;
  color: #7ec8e3;
}

.quick-add {
  flex-direction: column;
  background-color: #16213e;
  border-radius: 10px;
  padding: 10px;
  margin-bottom: 8px;
}

.quick-add-title {
  font-size: 14px;
  font-weight: bold;
  color: #7ec8e3;
  margin-bottom: 6px;
  text-align: center;
}

.quick-add-buttons {
  flex-direction: row;
  justify-content: space-around;
}

.quick-btn {
  width: 65px;
  height: 32px;
  border-radius: 6px;
  background-color: #0f3460;
  font-size: 14px;
  color: #ffffff;
  text-align: center;
}

.class-list {
  flex: 1;
  flex-direction: column;
  overflow: auto;
}

.class-card-wrapper {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
}

.class-card {
  flex-direction: column;
  background-color: #16213e;
  border-radius: 10px;
  padding: 14px;
  flex: 1;
  border-left-width: 4px;
  border-left-color: #7ec8e3;
  border-left-style: solid;
}

.class-time {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.class-name {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  max-width: 140px;
}

.class-time-text {
  font-size: 28px;
  color: #a0a0b0;
}

.class-info {
  flex-direction: row;
  align-items: center;
}

.class-location {
  font-size: 28px;
  color: #7ec8e3;
}

.empty-card {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.empty-text {
  font-size: 28px;
  color: #555566;
}

.delete-btn {
  width: 60px;
  height: 50px;
  background-color: #e74c3c;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  margin-left: 6px;
}

.delete-btn-text {
  font-size: 14px;
  color: #ffffff;
  font-weight: bold;
}

.bottom-buttons {
  flex-direction: row;
  justify-content: space-between;
}

.add-btn {
  width: 100px;
  height: 36px;
  border-radius: 8px;
  background-color: #7ec8e3;
  font-size: 14px;
  font-weight: bold;
  color: #1a1a2e;
  text-align: center;
}

.style-btn {
  width: 100px;
  height: 36px;
  border-radius: 8px;
  background-color: #0f3460;
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}
</style>