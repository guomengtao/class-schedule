<template>
  <div id="schedule-page" class="schedule-page" style="background-color: {{ theme.bg }}">
    <div class="clock-row" if="{{ showTime }}">
      <text class="clock-text" style="color: {{ theme.textSecondary }}">{{ currentTime }}</text>
    </div>

    <div class="header">
      <input class="nav-btn" type="button" value="&#9664;" onclick="prevDay" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="day-title" style="font-size: {{ dayTitleSize }}px; color: {{ theme.text }}">{{ dayDisplayText }}</text>
      <div class="day-nav-btns">
        <div class="day-nav-circle" onclick="goToWeekView" if="{{ showDayNavZong }}" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">总</text>
        </div>
        <div class="day-nav-circle" onclick="goToToday" if="{{ !isCapsule && showDayNavJin }}" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">今</text>
        </div>
        <div class="day-nav-circle" onclick="goToTomorrow" if="{{ !isCapsule && showDayNavMing }}" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">明</text>
        </div>
      </div>
      <input class="nav-btn" type="button" value="&#9654;" onclick="nextDay" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
    </div>

    <div class="custom-content-bar" if="{{ showCustomContent && customContent }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-4" style="background-color: {{ theme.accent }}"></div>
      <text class="custom-content-text" style="color: {{ theme.text }}">{{ customContent }}</text>
    </div>

    <div class="status-bar" if="{{ showStatusBar }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-6" if="{{ !isCapsule }}" style="background-color: {{ theme.accent }}"></div>
      <div if="{{ isCapsule }}" style="flex:1; flex-direction:column;">
        <div style="flex-direction:row; align-items:center; margin-bottom:2px;">
          <text class="status-tag status-tag-compact" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">{{ statusTag }}</text>
          <text class="status-right status-right-compact" if="{{ statusTimeText }}" style="color: {{ theme.accent }}">{{ statusTimeText }}</text>
        </div>
        <text class="status-middle status-middle-compact" style="color: {{ theme.text }}">{{ statusMainText }}</text>
      </div>
      <block if="{{ !isCapsule }}">
        <text class="status-tag" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">{{ statusTag }}</text>
        <text class="status-middle" style="color: {{ theme.text }}">{{ statusMainText }}</text>
        <text class="status-right" if="{{ statusTimeText }}" style="color: {{ theme.accent }}">{{ statusTimeText }}</text>
      </block>
    </div>

    <div class="pinned-bar" if="{{ showPinnedBar && hasPinned }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-4" style="background-color: {{ theme.accent }}"></div>
      <div class="pinned-content">
        <div class="pinned-row">
          <div for="{{ pinnedPages }}" class="pinned-tag" onclick="openPinnedPage($item.uri)" style="background-color: {{ theme.card }}; border-color: {{ theme.borderLight }}">
            <text class="pinned-tag-text" style="color: {{ theme.accent }}">{{ $item.name }}</text>
          </div>
        </div>
      </div>
    </div>

    <scroll class="class-list" scroll-y="true">
      <div if="{{ isLoading }}" class="skeleton-list">
        <div for="{{ skeletonCards }}" class="skeleton-card" style="background-color: {{ theme.card }}">
          <div class="skeleton-accent" style="background-color: {{ theme.borderLight }}"></div>
          <div class="skeleton-body">
            <div class="skeleton-bar" style="width: {{ ($idx % 2 === 0 ? 50 : 35) }}%; height: 26px; background-color: {{ theme.borderLight }}; border-radius: 4px; margin-bottom: 8px;"></div>
            <div class="skeleton-bar" style="width: {{ ($idx % 3 === 0 ? 30 : 40) }}%; height: 16px; background-color: {{ theme.borderLight }}; border-radius: 4px;"></div>
          </div>
        </div>
      </div>
      <div if="{{ !isLoading && loadError }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">数据加载失败</text>
        <input class="retry-btn" type="button" value="点击重试" onclick="retryLoad" style="margin-top: 12px; height: 44px; background-color: {{ theme.accent }}; color: {{ theme.bg }}; border-radius: 22px; font-size: 20px; line-height: 44px; padding: 0 20px;" />
      </div>
      <div if="{{ !isLoading && !loadError && currentClasses.length === 0 }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">今天没有课</text>
      </div>
      <div for="{{ currentClasses }}" class="class-grid-item" onclick="goToClassDetail($item)" style="background-color: {{ theme.card }}">
        <div class="progress-bg" if="{{ isToday }}" style="width: {{ $item.progress }}%; background-color: {{ $item.progressColor }}"></div>
        <div class="class-card-accent" style="background-color: {{ theme.accent }}"></div>
        <div class="class-card-body">
          <text class="grid-item-name" style="color: {{ theme.text }}; font-size: {{ $item.fontSize }}px">{{ $item.name }}</text>
          <div class="class-card-meta">
            <text class="grid-item-time" style="color: {{ theme.accent }}; font-size: {{ $item.metaFontSize }}px">{{ $item.time }}</text>
            <text class="grid-item-location" if="{{ $item.location }}" style="color: {{ theme.textMuted }}; font-size: {{ $item.metaFontSize }}px">{{ $item.location }}</text>
          </div>
        </div>
      </div>
    </scroll>

    <div class="quick-add" if="{{ showQuickAdd }}" style="background-color: {{ theme.card }}">
      <div class="quick-add-header" onclick="quickAdd.toggle">
        <text class="quick-add-title" style="color: {{ theme.accent }}">快速添加</text>
        <div class="quick-add-info">
          <text class="quick-add-time" if="{{ quickAdd.expanded }}" style="color: {{ theme.textSecondary }}">{{ quickAdd.time }}</text>
          <text class="quick-add-arrow" style="color: {{ theme.accent }}">{{ quickAdd.expanded ? '▲' : '▼' }}</text>
        </div>
      </div>
      <div class="quick-add-row-scroll" if="{{ quickAdd.expanded }}">
        <text class="quick-add-empty" if="{{ quickAdd.disabled }}" style="color: {{ theme.textMuted }}">今天课程已排满</text>
        <text class="quick-add-empty" if="{{ !quickAdd.disabled && quickAdd.courseNames.length === 0 }}" style="color: {{ theme.textMuted }}">暂无已添加课程，请先添加课程</text>
        <scroll class="quick-add-scroll" scroll-x="{{true}}" if="{{ !quickAdd.disabled && quickAdd.courseNames.length > 0 }}">
          <div class="quick-add-tags">
            <div for="{{ quickAdd.courseNames }}" class="quick-add-tag" onclick="quickAdd.addCourse($item)" style="background-color: {{ theme.cardLight }}">
              <text class="quick-add-tag-text" style="color: {{ theme.text }}">{{ $item }}</text>
            </div>
          </div>
        </scroll>
      </div>
    </div>

    

    <div class="bottom-buttons">
      <input class="add-btn" type="button" value="{{ isCapsule ? '+' : '+ 添加课程' }}" onclick="openAddCoursePage" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="style-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
    </div>

    <div class="week-indicator" onclick="openScheduleManager">
      <text class="week-text" style="color: {{ theme.accent }}">⇄ {{ currentScheduleName }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const device = require("@system.device")

var isCapsuleScreen = false

device.getInfo({
  success: function(data) {
    var shape = data.screenShape || ""
    isCapsuleScreen = (shape === "capsule" || shape === "pill-shaped")
  },
  fail: function() {}
})

var modules = {}
var moduleNames = [
  { key: "clock" },
  { key: "quickAdd" },
  { key: "dayNav" },
  { key: "statusBar" },
  { key: "customContent" },
  { key: "pinnedPages" },
  { key: "bottomButtons" },
  { key: "classList" }
]

function loadModule(key, mod) {
  if (mod && mod.init) {
    modules[key] = mod
  } else {
    modules[key] = null
  }
}

loadModule("clock", require("./modules/clock.js"))
loadModule("quickAdd", require("./modules/quick-add.js"))
loadModule("dayNav", require("./modules/day-nav.js"))
loadModule("statusBar", require("./modules/status-bar.js"))
loadModule("customContent", require("./modules/custom-content.js"))
loadModule("pinnedPages", require("./modules/pinned-pages.js"))
loadModule("bottomButtons", require("./modules/bottom-buttons.js"))
loadModule("classList", require("./modules/class-list.js"))

console.log("[index] SCRIPT loaded, modules:", Object.keys(modules))

export default {
  private: {
    isCapsule: false,
    isLoading: true,
    loadError: false,
    skeletonCards: [1, 2, 3],
    currentTime: "",
    currentDay: "",
    currentDayIndex: -1,
    dayDisplayText: "",
    statusTag: "",
    statusMainText: "",
    statusTimeText: "",
    showCustomContent: false,
    customContent: "",
    showTime: true,
    showQuickAdd: true,
    showStatusBar: true,
    statusBarSetting: true,
    showPinnedBar: true,
    showDayNavZong: true,
    showDayNavJin: true,
    showDayNavMing: true,
    timeFormat: { hour: true, minute: true, second: false },
    pinnedPages: [],
    hasPinned: false,
    currentClasses: [],
    schedule: [],
    isToday: true,
    displaySize: 48,
    metaFontSize: 34,
    dayTitleSize: 48,
    quickAdd: {
      expanded: false,
      courseNames: [],
      disabled: false,
      time: "",
      toggle: function() {},
      addCourse: function() {}
    },
    currentScheduleName: "课程表1",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    }
  },

  onInit() {
    var self = this
    console.log("[index] onInit START, isCapsuleScreen=", isCapsuleScreen)
    self.isCapsule = isCapsuleScreen
    self.initialized = false
    self.isLoading = true
    self.loadError = false
    store.getTheme(function(t) { self.theme = t })
    self.loadHomepageSettings()
    console.log("[index] onInit: loadHomepageSettings called, _loadTimeout setting...")

    self._loadTimeout = setTimeout(function() {
      console.error("[index] TIMEOUT 8s! isLoading=", self.isLoading)
      if (self.isLoading) {
        self.loadError = true
        self.isLoading = false
        try { self.$forceUpdate() } catch (e) {}
      }
    }, 8000)

    console.log("[index] onInit: calling database.init...")
    database.init(function() {
      console.log("[index] database.init callback OK")
      database.getAllCourses(function(schedule) {
        console.log("[index] getAllCourses callback, schedule length=", schedule ? schedule.length : 0)
        if (self._loadTimeout) clearTimeout(self._loadTimeout)
        self.schedule = schedule
        store.getBaseFontSize(function(size) {
          console.log("[index] getBaseFontSize callback, size=", size)
          self.displaySize = size
          self.metaFontSize = Math.round(size * 0.71)
          self.dayTitleSize = size
          self.initAllModules()
          self.initialized = true
          self.isLoading = false
          self.loadError = false
          console.log("[index] onInit DONE, isLoading=false, initialized=true")
        })
      })
    })
    console.log("[index] onInit: after database.init call (async)")
  },

  onShow() {
    var self = this
    console.log("[index] onShow START, initialized=", self.initialized)
    if (!self.initialized) {
      console.log("[index] onShow: not initialized, return early")
      return
    }
    self.isCapsule = isCapsuleScreen
    store.getTheme(function(t) { self.theme = t })
    self.loadHomepageSettings()

    if (modules.customContent && modules.customContent.refresh) {
      modules.customContent.refresh(self)
    }
    if (self.loadPinnedPages && typeof self.loadPinnedPages === 'function') {
      self.loadPinnedPages()
    }
    if (self.quickAdd && self.quickAdd.loadPreset) {
      self.quickAdd.loadPreset()
    }

    // Chain: schedule index → font size → schedule data → refresh UI
    store.getCurrentScheduleIndex(function(idx) {
      database.setScheduleIndex(idx, function() {
        store.getScheduleNames(function(names) {
          if (names && idx < names.length) {
            self.currentScheduleName = names[idx]
          } else {
            self.currentScheduleName = '课程表' + (idx + 1)
          }
        })
        store.getBaseFontSize(function(size) {
          self.displaySize = size
          self.metaFontSize = Math.round(size * 0.71)
          self.dayTitleSize = size
          // After font size is loaded, fetch fresh schedule data
          database.getAllCoursesWithIndex(idx, function(schedule) {
            if (!schedule || schedule.length === 0) {
              database.getAllCourses(function(fallback) {
                self.schedule = fallback
                if (self.refreshClasses && typeof self.refreshClasses === 'function') {
                  self.refreshClasses()
                }
                try { self.$forceUpdate() } catch (e) {}
              })
              return
            }
            self.schedule = schedule
            if (self.refreshClasses && typeof self.refreshClasses === 'function') {
              self.refreshClasses()
            }
            try { self.$forceUpdate() } catch (e) {}
          }, true)
        }, true)
      })
    })

    try { this.$forceUpdate() } catch (e) {}
  },

  onDestroy() {
    if (this._loadTimeout) clearTimeout(this._loadTimeout)
    if (this.stopClockTimer && typeof this.stopClockTimer === 'function') this.stopClockTimer()
    if (this.stopStatusTimer && typeof this.stopStatusTimer === 'function') this.stopStatusTimer()
    if (this.stopProgressTimer && typeof this.stopProgressTimer === 'function') this.stopProgressTimer()
    if (modules.customContent && modules.customContent.destroy) {
      modules.customContent.destroy()
    }
  },

  loadFontScale() {
    var self = this
    store.getBaseFontSize(function(size) {
      self.displaySize = size
      self.metaFontSize = Math.round(size * 0.71)
      self.dayTitleSize = size
      if (self.refreshClasses && typeof self.refreshClasses === 'function') {
        self.refreshClasses()
      }
      try { self.$forceUpdate() } catch (e) {}
    }, true)
  },

  loadHomepageSettings() {
    var self = this
    store.getHomepageSettings(function(settings) {
      self.showTime = settings.showTime !== false
      self.showQuickAdd = settings.showQuickAdd !== false
      self.statusBarSetting = settings.showStatusBar !== false
      self.showPinnedBar = settings.showPinnedBar !== false
      self.showDayNavZong = settings.showDayNavZong !== false
      self.showDayNavJin = settings.showDayNavJin !== false
      self.showDayNavMing = settings.showDayNavMing !== false
      self.showCustomContent = settings.showCustomContent || false
      self.customContent = settings.customContent || ""
      self.timeFormat = settings.timeFormat || { hour: true, minute: true, second: false }
      if (isCapsuleScreen) {
        self.timeFormat.second = false
      }
      if (typeof self.updateClock === 'function') {
        self.updateClock()
      }
    }, true)
  },

  initAllModules() {
    var self = this
    console.log("[index] initAllModules START")

    for (var i = 0; i < moduleNames.length; i++) {
      var m = moduleNames[i]
      var mod = modules[m.key]
      if (mod && mod.init) {
        try {
          console.log("[index] initAllModules: [" + (i + 1) + "/" + moduleNames.length + "] " + m.key + "...")
          mod.init(self)
          console.log("[index] initAllModules: [" + (i + 1) + "/" + moduleNames.length + "] " + m.key + " OK")
        } catch (e) {
          console.error("[index] [" + (i + 1) + "/" + moduleNames.length + "] " + m.key + " FAIL: " + (e.message || e))
        }
      } else {
        console.log("[index] initAllModules: [" + (i + 1) + "/" + moduleNames.length + "] " + m.key + " SKIP (no init)")
      }
    }

    console.log("[index] initAllModules: all inited, calling post-init...")
    if (self.loadDayClasses && typeof self.loadDayClasses === 'function') {
      console.log("[index] initAllModules: loadDayClasses...")
      try { self.loadDayClasses() } catch (e) { console.error("[index] loadDayClasses: " + (e.message || e)) }
    }
    if (self.startProgressTimer && typeof self.startProgressTimer === 'function') {
      console.log("[index] initAllModules: startProgressTimer...")
      try { self.startProgressTimer() } catch (e) { console.error("[index] startProgressTimer: " + (e.message || e)) }
    }
    if (self.updateStatus && typeof self.updateStatus === 'function') {
      console.log("[index] initAllModules: updateStatus + startStatusTimer...")
      try { self.updateStatus() } catch (e) { console.error("[index] updateStatus: " + (e.message || e)) }
      if (self.startStatusTimer && typeof self.startStatusTimer === 'function') {
        try { self.startStatusTimer() } catch (e) { console.error("[index] startStatusTimer: " + (e.message || e)) }
      }
    }
    if (self.updateHideWeekend && typeof self.updateHideWeekend === 'function') {
      console.log("[index] initAllModules: updateHideWeekend...")
      try { self.updateHideWeekend() } catch (e) { console.error("[index] updateHideWeekend: " + (e.message || e)) }
    }
    console.log("[index] initAllModules DONE")
  },

  goBack() {
    router.back()
  },

  onBackPress() {
    var app = require("@system.app")
    app.exit()
    return true
  },

  retryLoad() {
    var self = this
    self.isLoading = true
    self.loadError = false
    try { self.$forceUpdate() } catch (e) {}

    self._loadTimeout = setTimeout(function() {
      if (self.isLoading) {
        self.loadError = true
        self.isLoading = false
        try { self.$forceUpdate() } catch (e) {}
      }
    }, 8000)

    database.init(function() {
      database.getAllCourses(function(schedule) {
        if (self._loadTimeout) clearTimeout(self._loadTimeout)
        self.schedule = schedule
        store.getBaseFontSize(function(size) {
          self.displaySize = size
          self.metaFontSize = Math.round(size * 0.71)
          self.dayTitleSize = size
          self.initAllModules()
          self.initialized = true
          self.isLoading = false
          self.loadError = false
        })
      })
    })
  },

  goToWeekView() {
    var storage = require("@system.storage")
    store.getCurrentScheduleIndex(function(idx) {
      storage.set({
        key: "weekview_index",
        value: String(idx),
        success: function() { router.push({ uri: "/pages/week-view" }) },
        fail: function() { router.push({ uri: "/pages/week-view" }) }
      })
    })
  },

  goToTomorrow() {
    var self = this
    store.getHideWeekend(function(hide) {
      var dayNamesFull = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
      var dayNames = hide ? ["星期一", "星期二", "星期三", "星期四", "星期五"] : dayNamesFull
      var todayIdx = new Date().getDay()
      if (hide && (todayIdx === 0 || todayIdx === 6)) {
        todayIdx = 0
      } else if (hide) {
        todayIdx = todayIdx - 1
      }
      var tomorrowIdx = todayIdx + 1
      if (tomorrowIdx >= dayNames.length) tomorrowIdx = 0
      if (self.currentDayIndex === tomorrowIdx) return
      self.currentDayIndex = tomorrowIdx
      self.currentDay = dayNames[tomorrowIdx]
      self.dayDisplayText = isCapsuleScreen
        ? ({ "星期日": "日", "星期一": "一", "星期二": "二", "星期三": "三", "星期四": "四", "星期五": "五", "星期六": "六" })[self.currentDay] || self.currentDay
        : self.currentDay
      if (self.loadDayClasses && typeof self.loadDayClasses === 'function') self.loadDayClasses()
      if (self.updateStatus && typeof self.updateStatus === 'function') self.updateStatus()
    })
  }
}
</script>

<style>
.schedule-page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 8px 8px 8px;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8px 4px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.clock-row {
  padding: 2px 0;
  margin-bottom: 2px;
  flex-shrink: 0;
}

.clock-text {
  font-size: 20px;
  text-align: center;
  width: 100%;
  line-height: 28px;
}

.day-title {
  font-weight: bold;
  text-align: center;
  lines: 1;
  flex: 1;
  }

.nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  font-size: 24px;
  line-height: 44px;
  text-align: center;
  border-width: 0;
}

.day-nav-btns {
  flex-direction: row;
}

.day-nav-circle {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin-left: 4px;
}

.day-nav-text {
  font-size: 20px;
  line-height: 28px;
  font-weight: bold;
  text-align: center;
}

.custom-content-bar {
  flex-direction: row;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.custom-content-text {
  font-size: 20px;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
  line-height: 28px;
}

.status-bar {
  flex-direction: row;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.status-tag {
  font-size: 20px;
  padding: 2px 8px;
  border-radius: 4px;
  margin-right: 8px;
  line-height: 28px;
}

.status-middle {
  font-size: 20px;
  flex: 1;
  lines: 1;
  line-height: 28px;
}

.status-right {
  font-size: 20px;
  line-height: 28px;
}

.pinned-bar {
  flex-direction: row;
  align-items: center;
  padding: 4px 8px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.pinned-content {
  flex: 1;
}

.pinned-row {
  flex-direction: row;
  flex-wrap: wrap;
}

.pinned-tag {
  padding: 6px 16px;
  border-radius: 18px;
  margin-right: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
  border-width: 1px;
}

.pinned-tag-text {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
}

.class-list {
  flex: 1;
  flex-direction: column;
  margin-bottom: 4px;
}

.class-grid {
  flex-direction: column;
}

.class-grid-item {
  position: relative;
  width: 100%;
  min-height: 60px;
  border-radius: 12px;
  padding: 0;
  margin-bottom: 10px;
  flex-direction: row;
  overflow: hidden;
}

.class-card-accent {
  width: 5px;
  flex-shrink: 0;
  border-radius: 3px 0 0 3px;
}

.class-card-body {
  flex: 1;
  flex-direction: column;
  padding: 14px 16px 14px 14px;
}

.progress-bg {
  position: absolute;
