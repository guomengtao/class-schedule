  .day-nav-circle {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin-left: 4px;
  }
  .day-nav-text {
    font-size: 16px;
  }
  .status-bar {
    padding: 4px 8px;
    margin-bottom: 4px;
    height: 34px;
  }
  .status-tag {
    font-size: 10px;
    padding: 1px 6px;
    margin-right: 4px;
  }
  .status-middle {
    font-size: 13px;
    min-width: 24px;
  }
  .status-right {
    font-size: 12px;
    min-width: 32px;
    margin-left: 4px;
  }
  .status-time {
    font-size: 22px;
  }
  .class-card-wrapper {
    margin-bottom: 4px;
    overflow: visible;
  }
  .class-card {
    overflow: visible;
  }
  .class-content {
    padding: 8px;
  }
  .class-name {
    font-size: 20px;
    flex: 1;
    max-width: none;
  }
  .class-time-text {
    font-size: 20px;
  }
  .class-location {
    font-size: 20px;
  }
  .class-progress {
    font-size: 18px;
  }
  .empty-text {
    font-size: 20px;
  }
  .quick-add {
    padding: 6px;
  }
  .quick-add-title {
    font-size: 12px;
  }
}
</style>