<template>
  <!-- 手势（2026-11-02）：根节点接管触摸，只认两个与纵向滚动正交的方向。
       左滑 → 总课程；下拉（列表在顶部时）→ 回到今天。
       上滑/下滑刻意不做 —— 中间课程列表占屏高 78%，纵向手势与「看更多课程」
       抢同一块语义区，不是偶尔误触，是每一次滚动都必然先触发。
       ⚠️ 根节点一旦挂 touch，系统右划退出会失效，所以首页必须保留可见出口
       （底部按钮 / 各页面顶栏返回），这条别删。
       实现与红线见 modules/gesture.js 文件头。 -->
  <div id="schedule-page" class="schedule-page" style="background-color: {{ theme.bg }}"
       ontouchstart="onPageTouchStart"
       ontouchmove="onPageTouchMove"
       ontouchend="onPageTouchEnd"
       ontouchcancel="onPageTouchEnd">
    <!-- 第一行兼作「回今天」：点击无论当前在哪天都回到今天（已在今天则无操作）。
         2026-11-01 紧凑化：整行 44→28px（胶囊屏 24→20px），文字与行高等高、垂直占满，
         不再留顶对齐产生的底部死白；省下的高度由 class-list 的 flex:1 全部吸收。
         热区宽度仍是整行 160~176px，命中面积远大于手环最小可点尺寸。
         2026-11-02：下拉回今天时，本行临时切换成「已是今天」——
         手势收到但无动作时必须给可见确认，否则会被当成功能坏了。 -->
    <div class="date-row" if="{{ !isLoading }}" onclick="goToToday" onswipe="onCardSwipe">
      <text class="date-text" if="{{ !showPullTip }}" style="color: {{ theme.textSecondary }}">{{ topLabel }}</text>
      <text class="date-text" if="{{ showPullTip }}" style="color: {{ theme.accent }}">已是今天</text>
    </div>

    <div class="header" onswipe="onCardSwipe">
      <div class="nav-btn-circle" onclick="prevDay" style="background-color: {{ theme.cardLight }}">
        <image class="nav-btn-img" src="/common/icons/{{ iconTheme }}/icon_arrow_left.png"></image>
      </div>
      <!-- 2026-11-01：周几同样做成「回今天」热区（与顶部日期行同一动作），
           两个入口都落在屏幕上半部，拇指够得到的同一个区域。 -->
      <text class="day-title" onclick="goToToday" style="font-size: {{ dayTitleSize }}px; color: {{ dayTitleColor || theme.text }}">{{ dayDisplayText }}</text>
      <!-- 方屏：总/今/明 三枚汉字圆钮保留在 header 内（方屏横向放得下，只留图标界面太空）。
           三枚按钮的显隐开关已随胶囊屏三圆化一并移除，此处固定常显。 -->
      <div class="day-nav-btns" if="{{ !isCapsule }}">
        <div class="day-nav-circle" onclick="goToWeekView" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">总</text>
        </div>
        <div class="day-nav-circle" onclick="goToToday" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">今</text>
        </div>
        <div class="day-nav-circle" onclick="goToTomorrow" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">明</text>
        </div>
      </div>
      <div class="nav-btn-circle" onclick="nextDay" style="background-color: {{ theme.cardLight }}">
        <image class="nav-btn-img" src="/common/icons/{{ iconTheme }}/icon_arrow_right.png"></image>
      </div>
    </div>

    <!-- 胶囊屏原先在 header 下方单独占一行放「总/今/明」的 nav-toolbar 已删除（整行 52px）：
         「总」下沉到底部三圆中间位，「今」由顶部 date-row 热区取代，「明」等价于右箭头。
         省下的 52px 全部还给课程列表。 -->

    <!-- 方案 D2：独立自定义内容条删除（省 39px 垂直预算），
         该能力保留在数据层，后续并入课程列表末尾或周视图 -->

    <div class="status-bar" if="{{ showStatusBar }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-6" if="{{ !isCapsule }}" style="background-color: {{ theme.accent }}"></div>
      <!-- Capsule: 单行紧凑布局（剩余时间 + 课程名，2026-11-03 起无图标） -->
      <div if="{{ isCapsule }}" class="status-capsule-row">
        <!-- 单行版（2026-11-03 去图标）：剩余时间 + 课程名，一行只有两个元素。
             宽度账：192 − 12×2 页边 = 168，条内距 6×2 = 156；
             「36m」38 + 间 4 = 42 → 课名实得 114px。
             18px 字号：4 字需 4×18+18 = 90（稳定完整）；
             时间短（如 36m）时 5 字需 108 ≤ 114，也能完整显示。
             课名过长仍由 ellipsis 兜底，其余字段永远不会溢出。
             ⚠️ 2026-11-03 去掉了原来的 16px 状态灯 + 4px 间距（statusIconName 的 png）。
                理由：那 20px 占掉提醒条 13% 宽度，只为表达 now/soon/holiday 三种状态，
                而这层语义已由倒计时文案（「36m」/「即将」）与课程卡底色表达；
                移走后课名从「必保 4 字」变成「必保 4 字 + 多数情况 5 字」。
                方屏不走这条分支（用下面的文字 tag），状态语义更强，故不动。 -->
        <div class="status-capsule-body">
          <text class="status-capsule-time" if="{{ statusTimeText }}" style="color: {{ theme.accent }}">{{ statusTimeText }}</text>
          <text class="status-capsule-name" style="color: {{ theme.text }}">{{ statusMainText }}</text>
        </div>
      </div>
      <block if="{{ !isCapsule }}">
        <text class="status-tag" style="background-color: {{ theme.accent }}; color: {{ onAccentColor }}">{{ statusTag }}</text>
        <text class="status-middle" style="color: {{ theme.text }}">{{ statusMainText }}</text>
        <text class="status-right" if="{{ statusTimeText }}" style="color: {{ theme.accent }}">{{ statusTimeText }}</text>
      </block>
    </div>

    <!-- 整条可点（2026-10-21 规则 §8.2 宁大勿小）：原来条右侧是一个 28×28 的「?」小圆钮，
         手指根本按不准；改成整条 168×48 都是热区，右侧只留箭头作「可进」提示。
         顺带文案可用宽度从 168−28−6 变成 168−28，不再挤。 -->
    <div class="workday-tip-bar" if="{{ isWorkday && holidayReminderOn && !isLoading }}"
         style="background-color: {{ theme.cardLight }}" onclick="goToWorkdayInfo">
      <!-- 方案 D4：「今天」不再硬编码（翻到未来调休日时随日期变化）；
           文案压到 ≤9 字不折行（原「今天调休，按周三课表」11 字爆宽折 3 行） -->
      <text class="workday-tip-text" style="color: {{ theme.accent }}">{{ isTodayDate ? '调休 · 按' + overrideDayName + '课表' : currentDateStr + ' 调休' }}</text>
    </div>

    <div class="pinned-bar" if="{{ showPinnedBar && hasPinned }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-4" style="background-color: {{ theme.accent }}"></div>
      <div class="pinned-content">
        <div class="pinned-row">
          <div for="{{ pinnedPages }}" class="pinned-tag" onclick="openPinnedPage($item.uri)" style="background-color: {{ theme.card }}; border-color: {{ theme.borderLight }}">
            <text class="pinned-tag-text" style="color: {{ theme.accent }}">{{ $item.name }}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- onswipe 是第二条左滑通道：系统级快速滑动识别，不依赖触摸冒泡。
         卡片可点击，会吃掉触摸流，只靠根节点 touch 会出现「只有某一块能滑进去」。 -->
    <scroll class="class-list" scroll-y="true" id="classList" onscroll="onListScroll" onswipe="onCardSwipe">
      <div if="{{ isLoading }}" class="skeleton-list">
        <div for="{{ skeletonCards }}" class="skeleton-card" style="background-color: {{ theme.card }}">
          <div class="skeleton-accent" style="background-color: {{ theme.borderLight }}"></div>
          <div class="skeleton-body">
            <div class="skeleton-bar" style="width: {{ ($idx % 2 === 0 ? 50 : 35) }}%; height: 26px; background-color: {{ theme.borderLight }}; border-radius: 4px; margin-bottom: 8px;"></div>
            <div class="skeleton-bar" style="width: {{ ($idx % 3 === 0 ? 30 : 40) }}%; height: 16px; background-color: {{ theme.borderLight }}; border-radius: 4px;"></div>
          </div>
        </div>
      </div>
      <div if="{{ !isLoading && loadError }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">数据加载失败</text>
        <input class="retry-btn" type="button" value="点击重试" onclick="retryLoad" style="margin-top: 12px; height: 44px; background-color: {{ theme.accent }}; color: {{ onAccentColor }}; border-radius: 22px; font-size: 20px; line-height: 44px; padding: 0 20px;" />
      </div>
      <div if="{{ !isLoading && !loadError && isHoliday && holidayReminderOn }}" class="holiday-greeting-card" style="background-color: {{ theme.card }}">
        <text class="holiday-greeting-name" style="color: {{ theme.accent }}">{{ holidayName }}</text>
        <text class="holiday-greeting-text" style="color: {{ theme.text }}">{{ holidayGreeting }}</text>
      </div>
      <div if="{{ !isLoading && !loadError && currentClasses.length === 0 && !(isHoliday && holidayReminderOn) }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">今天没有课</text>
      </div>
      <div for="{{ currentClasses }}" class="class-grid-item" onclick="goToClassDetail($item)" onswipe="onCardSwipe" style="background-color: {{ theme.card }}">
        <div class="progress-bg" if="{{ isToday }}" style="width: {{ $item.progress }}%; background-color: {{ $item.progressColor }}"></div>
        <div class="class-card-accent" style="background-color: {{ theme.accent }}"></div>
        <div class="class-card-body">
          <div class="card-name-row">
            <text class="grid-item-name" style="color: {{ theme.text }}; font-size: {{ $item.fontSize }}px; line-height: {{ $item.lineHeight }}px">{{ $item.name }}</text>
            <text class="grid-item-location-inline" if="{{ $item.location && !$item.locationWrap }}" style="color: {{ theme.textMuted }}; font-size: {{ $item.metaFontSize }}px; line-height: {{ $item.metaLineHeight }}px">{{ $item.location }}</text>
          </div>
          <text class="grid-item-location" if="{{ $item.location && $item.locationWrap }}" style="color: {{ theme.textMuted }}; font-size: {{ $item.metaFontSize }}px; line-height: {{ $item.metaLineHeight }}px">{{ $item.location }}</text>
          <text class="grid-item-time" style="color: {{ theme.accent }}; font-size: {{ $item.metaFontSize }}px; line-height: {{ $item.metaLineHeight }}px">{{ $item.timeDisplay }}</text>
        </div>
      </div>
    </scroll>

    <div class="quick-add" if="{{ showQuickAdd }}" style="background-color: {{ theme.card }}">
      <!-- 2026-11-02 收起/展开拆成两块（不用复合选择器：本项目实测复合选择器会把进页搞黑屏）。
           收起态弱化理由：accent #7ec8e3 是行动色，课程时间、标签「+」都在用它，
           一个纯折叠标题占着这个位置，等于把强调位从课程内容手里抢走 —— 页面重点就散了。
           收起态改 textSecondary #888899（对比约 3.4:1，看得清但不抢），展开态才回 accent。
           留白分两档：收起 6px、展开 10px，收起态整条 48→40，字号仍 20px 不缩。 -->
      <div class="quick-add-header" if="{{ quickAdd.expanded }}" onclick="quickAdd.toggle">
        <text class="quick-add-title" style="color: {{ theme.accent }}">快速添加</text>
        <div class="quick-add-info">
          <text class="quick-add-time" if="{{ !isCapsule }}" style="color: {{ theme.textSecondary }}">{{ quickAdd.time }}</text>
          <image class="quick-add-arrow-img" src="/common/icons/{{ iconTheme }}/icon_chevron_up.png"></image>
        </div>
      </div>
      <div class="quick-add-header quick-add-header-collapsed" if="{{ !quickAdd.expanded }}" onclick="quickAdd.toggle">
        <text class="quick-add-title" style="color: {{ theme.textSecondary }}">快速添加</text>
        <div class="quick-add-info">
          <image class="quick-add-arrow-img quick-add-arrow-dim" src="/common/icons/{{ iconTheme }}/icon_chevron_down.png"></image>
        </div>
      </div>
      <!-- 快速添加：这一行是 scroll-x 横向滚动条，横向滑动要留给自己。
           在这里标记 inH，页面级手势据此放弃判定，避免「想滚标签、结果跳进总课程」。
           与系统「右滑退出」在该区域自动让位是同一套道理，只是系统有仲裁，我们得手动让。 -->
      <div class="quick-add-row-scroll" if="{{ quickAdd.expanded }}"
           ontouchstart="onHScrollStart" ontouchend="onHScrollEnd" ontouchcancel="onHScrollEnd">
        <text class="quick-add-empty" if="{{ quickAdd.disabled }}" style="color: {{ theme.textMuted }}">今天课程已排满</text>
        <div if="{{ !quickAdd.disabled && quickAdd.courseNames.length === 0 }}" style="flex-direction: row; align-items: center; padding: 0 8px;">
          <text class="quick-add-empty" style="color: {{ theme.textMuted }}">暂无课程，点击添加</text>
          <div class="quick-add-tag quick-add-plus" onclick="openCourseManager" style="background-color: {{ theme.cardLight }}">
            <text class="quick-add-tag-text quick-add-plus-text" style="color: {{ theme.accent }}">{{ isCapsule ? '管理' : '+' }}</text>
          </div>
        </div>
        <scroll class="quick-add-scroll" scroll-x="{{true}}" if="{{ !quickAdd.disabled && quickAdd.courseNames.length > 0 }}">
          <div class="quick-add-tags">
            <div for="{{ quickAdd.courseNames }}" class="quick-add-tag" onclick="quickAdd.addCourse($item)" style="background-color: {{ theme.cardLight }}">
              <text class="quick-add-tag-text" style="color: {{ theme.text }}">{{ $item }}</text>
            </div>
            <div class="quick-add-tag quick-add-plus" onclick="openCourseManager" style="background-color: {{ theme.cardLight }}">
              <text class="quick-add-tag-text quick-add-plus-text" style="color: {{ theme.accent }}">{{ isCapsule ? '管理' : '+' }}</text>
            </div>
          </div>
        </scroll>
      </div>
    </div>

    

    <!-- 方案 D8：切换课表独立行移到最末（在 添加/设置 两钮之下），
         仍保持独立一行，避免 192px 屏把切换钮压成孤立图标 -->
    <!-- 底部按钮区（方案 D9）：
         胶囊屏＝三个同形圆钮 [添加][总][设置]，左操作/中视图/右设置，直径 48、间距 8；
         方屏保持原样＝[添加课程][设置] 两条长条（横向放得下，只留图标界面太空）。
         2026-11-03：挂 onswipe 作为上划进设置的通道（圆钮是可点元素，会吃掉触摸流，
         只靠根节点 touch 起手在本区会漏）；这条通道同时接管 right → 退出，
         否则底部右划会像 11-02 的列表区一样变成死手势（见 gesture.js 文件头 ⑤）。 -->
    <div class="bottom-buttons" onswipe="onBottomSwipe">
      <!-- 胶囊屏三钮同径同底（真机反馈 2026-10-24：加号原来带 2px accent 描边、
           底色透明，视觉上比左右两枚「大一号」）。现在三枚都是 48 圆 + cardLight 底，
           只有图标不同：＋ / 周视图 / 齿轮。 -->
      <div class="add-btn-wrapper add-btn-wrapper-circle" if="{{ isCapsule }}" onclick="openAddCoursePage"
           style="background-color: {{ theme.cardLight }}">
        <image class="add-btn-icon" src="/common/icons/{{ iconTheme }}/icon_plus.png"></image>
      </div>
      <!-- 方屏保留描边长条：横向放得下「+ 添加课程」文字，描边是唯一的轮廓来源 -->
      <div class="add-btn-wrapper" if="{{ !isCapsule }}" onclick="openAddCoursePage"
           style="background-color: transparent; border-width: 2px; border-color: {{ theme.accent }}">
        <image class="add-btn-icon" src="/common/icons/{{ iconTheme }}/icon_plus.png"></image>
        <text class="add-btn-label" style="color: {{ theme.accent }}">添加课程</text>
      </div>
      <div class="set-btn-circle" if="{{ isCapsule }}" onclick="goToWeekView" style="background-color: {{ theme.cardLight }}">
        <image class="bottom-mid-icon" src="/common/icons/{{ iconTheme }}/icon_week.png"></image>
      </div>
      <div class="set-btn-circle" if="{{ isCapsule }}" onclick="openSettings" style="background-color: {{ theme.cardLight }}">
        <image class="bottom-mid-icon" src="/common/icons/{{ iconTheme }}/icon_gear.png"></image>
      </div>
      <input class="style-btn" type="button" value="设置" if="{{ !isCapsule }}" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }};" />
    </div>
    <!-- 2026-11-01：课表切换条改为「按内容宽度居中」。
         原来它是 .schedule-page（flex column）的直接子项，默认 stretch 拉满整行，
         cardLight 底色铺成 100% 通栏。Vela 不支持 align-self（运行时告警
         Unknown style - alignSelf），故用一层 row 容器 + justify-content:center
         来收敛宽度，宽度由文字自然决定。 -->
    <div class="schedule-indicator-row" onclick="openScheduleManager" onswipe="onBottomSwipe">
      <div class="schedule-indicator" style="background-color: {{ theme.cardLight }}">
        <image class="schedule-swap-icon" src="/common/icons/{{ iconTheme }}/icon_swap.png"></image>
        <text class="schedule-name" style="color: {{ theme.text }}">{{ currentScheduleName }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const device = require("@system.device")

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = true
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}

// Homepage template configs: control day title color and other display properties
var HOMEPAGE_TEMPLATES = {
  "default": {
    name: "Default",
    dayTitleColor: "text"         // uses theme.text (default)
  },
  "accent-title": {
    name: "Accent Title",
    dayTitleColor: "accent"       // uses theme.accent (accent color)
  },
  "soft-title": {
    name: "Soft Title",
    dayTitleColor: "textSecondary" // uses theme.textSecondary (secondary text)
  }
}

var isCapsuleScreen = false

var fullDayNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

var dayShortMap = {
  "星期日": "周日", "星期一": "周一", "星期二": "周二", "星期三": "周三",
  "星期四": "周四", "星期五": "周五", "星期六": "周六"
}

function pad(n) {
  return n < 10 ? "0" + n : "" + n
}

// 方案 D6（对比度修复）：状态胶囊/标签的反白色不再用 theme.bg ——
// 浅色主题下 accent 亮、bg 更亮，bg 当反白会塌到 2.0–2.9:1。
// 按 accent 的相对亮度动态取深字或白字，四主题全部 ≥4.5:1。
function idealOnColor(hex) {
  var h = (hex || "#000000").replace("#", "")
  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2]
  var r = parseInt(h.slice(0, 2), 16) / 255
  var g = parseInt(h.slice(2, 4), 16) / 255
  var b = parseInt(h.slice(4, 6), 16) / 255
  function lin(c) { return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4) }
  var L = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
  return L > 0.35 ? "#1a1a1a" : "#ffffff"
}

function sameDate(a, b) {
  return a.getFullYear() === b.getFullYear() &&
         a.getMonth() === b.getMonth() &&
         a.getDate() === b.getDate()
}

function dateToDateStr(d) {
  return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate())
}

function formatDateShort(d) {
  return pad(d.getMonth() + 1) + "-" + pad(d.getDate())
}

var indexInstance = null

// 屏型是异步返回的。这里拿到真实形状后回填给实例并重算字号，
// 否则首帧会用默认值（非胶囊）导致适配不生效。
device.getInfo({
  success: function(data) {
    var shape = data.screenShape || ""
    var capsule = (shape === "capsule" || shape === "pill-shaped")
    isCapsuleScreen = capsule
    if (indexInstance && indexInstance.isCapsule !== capsule) {
      indexInstance.isCapsule = capsule
      indexInstance.applyFontSizes()
      // 星期标题是否缩写取决于屏型，回填后需重新计算
      if (typeof indexInstance.updateDayDisplay === 'function') {
        try { indexInstance.updateDayDisplay() } catch (e) {}
      }
      if (indexInstance.initialized && typeof indexInstance.loadDayClasses === 'function') {
        try { indexInstance.loadDayClasses() } catch (e) {}
      }
      try { indexInstance.$forceUpdate() } catch (e) {}
    }
  },
  fail: function() {}
})

var modules = {}
// 关键模块先初始化保证首屏出内容，defer 的模块延后到首帧之后
var moduleNames = [
  { key: "dayNav" },
  { key: "gesture" },
  { key: "holiday" },
  { key: "classList" },
  { key: "bottomButtons" },
  { key: "statusBar" },
  { key: "quickAdd", defer: true },
  { key: "customContent", defer: true },
  { key: "pinnedPages", defer: true }
]

function loadModule(key, mod) {
  if (mod && mod.init) {
    modules[key] = mod
  } else {
    modules[key] = null
  }
}

loadModule("quickAdd", require("./modules/quick-add.js"))
loadModule("dayNav", require("./modules/day-nav.js"))
loadModule("gesture", require("./modules/gesture.js"))
loadModule("statusBar", require("./modules/status-bar.js"))
loadModule("customContent", require("./modules/custom-content.js"))
loadModule("pinnedPages", require("./modules/pinned-pages.js"))
loadModule("bottomButtons", require("./modules/bottom-buttons.js"))
loadModule("classList", require("./modules/class-list.js"))
loadModule("holiday", require("./modules/holiday.js"))

dlog("[index] SCRIPT loaded, modules:", Object.keys(modules))

export default {
  private: {
    isCapsule: false,
    iconTheme: "dark",
    lastDirty: "",
    isLoading: true,
    loadError: false,
    // 下拉回今天时，若本来就在今天 → 顶行临时切成「已是今天」1.2 秒
    showPullTip: false,
    skeletonCards: [1, 2, 3],
    currentDay: "",
    currentDayIndex: -1,
    dayDisplayText: "",
    statusTag: "",
    statusMainText: "",
    statusTimeText: "",
    statusIconName: "",
    showCustomContent: false,
    customContent: "",
    showQuickAdd: true,
    showStatusBar: true,
    statusBarSetting: true,
    showPinnedBar: true,
    pinnedPages: [],
    hasPinned: false,
    currentClasses: [],
    schedule: [],
    isToday: true,
    displaySize: 48,
    metaFontSize: 34,
    dayTitleSize: 48,
    dayTitleColor: "",
    homepageTplId: "default",
    quickAdd: {
      expanded: false,
      courseNames: [],
      disabled: false,
      time: "",
      toggle: function() {},
      addCourse: function() {}
    },
    currentScheduleName: "课程表1",
    isHoliday: false,
    isWorkday: false,
    holidayGreeting: "",
    holidayName: "",
    overrideDayName: "",
    holidayReminderOn: false,
    currentDateStr: "",
    // 顶部第一行：看今天显示时分（12:16），其他日期显示中文月日（10月25日）
    topLabel: "",
    isTodayDate: true,
    onAccentColor: "#ffffff",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    }
  },

  onInit() {
    var self = this
    indexInstance = self
    self.isCapsule = isCapsuleScreen
    self.initialized = false
    self.isLoading = true
    self.loadError = false
    self.skipNextShow = true
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.onAccentColor = idealOnColor(t.accent)
      self.updateIconSrc(themeName)
      // Re-apply template after theme is set to ensure correct color resolution
      self.applyHomepageTemplate()
    })
    self.loadHomepageSettings()

    self.loadTimeout = setTimeout(function() {
      if (self.isLoading) {
        self.loadError = true
        self.isLoading = false
        try { self.$forceUpdate() } catch (e) {}
      }
    }, 8000)

    // 记录当前写盘版本号作为基准，避免首次进入被误判成"数据被改过"而重复刷一次
    var bootStorage = require("@system.storage")
    bootStorage.get({
      key: "allCourses_dirty",
      success: function(val) {
        self.lastDirty = val || ""
      },
      fail: function() {
        self.lastDirty = ""
      }
    })

    database.init(function() {
      database.getAllCourses(function(schedule) {
        if (self.loadTimeout) clearTimeout(self.loadTimeout)
        self.schedule = schedule
        self.applyFontSizes()
        self.initAllModules()
        // 方案 H11：数据就绪后立即算一次状态条，不等 60s 定时器（首屏完整）
        if (self.startStatusTimer && typeof self.startStatusTimer === 'function') {
          try { self.startStatusTimer() } catch (e) {}
        }
        self.initialized = true
        self.skipNextShow = false
        self.isLoading = false
        self.loadError = false
        try { self.$forceUpdate() } catch (e) {}
      })
    })
  },

  onShow() {
    var self = this
    if (!self.initialized) return

    self.isCapsule = isCapsuleScreen
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.onAccentColor = idealOnColor(t.accent)
      self.updateIconSrc(themeName)
      // Re-apply template color after theme update
      self.applyHomepageTemplate()
    }, true) // forceRefresh=true: ensure theme change from settings always takes effect
    self.loadHomepageSettings()

    if (modules.customContent && modules.customContent.refresh) {
      modules.customContent.refresh(self)
    }
    if (self.loadPinnedPages && typeof self.loadPinnedPages === 'function') {
      self.loadPinnedPages()
    }
    if (self.quickAdd && self.quickAdd.loadPreset) {
      self.quickAdd.loadPreset()
    }

    // 从设置页返回时强制重读字号存储并重建课程卡片，确保设置的字号即时生效
    self.loadFontScale()

    // 关键：先比对写盘版本号（由 database 在每次写盘成功后累加），
    // 只要别的页面改动过课程（增删改），就必须重新读盘，即使 skipNextShow 还没消耗。
    var storage = require("@system.storage")
    storage.get({
      key: "allCourses_dirty",
      success: function(val) {
        self.resumeRefresh(val)
      },
      fail: function() {
        self.resumeRefresh(null)
      }
    })

    // restore timers stopped by onHide
    if (modules.dayNav && modules.dayNav.startClock) {
      // 顶部时分跟着真实分钟走：只在页面可见时计时，onHide 停掉
      modules.dayNav.startClock(self)
    }
    if (self._hadStatusTimer && self.startStatusTimer) {
      self._hadStatusTimer = false
      self.startStatusTimer()
    }
    if (self._hadProgressTimer && self.startProgressTimer) {
      self._hadProgressTimer = false
      self.startProgressTimer()
    }
    if (self._hadCustomContent && modules.customContent && modules.customContent.refresh) {
      self._hadCustomContent = false
      modules.customContent.refresh(self)
    }
    if (self._hadHoliday && modules.holiday && modules.holiday.init) {
      self._hadHoliday = false
      modules.holiday.init(self)
    }
    self._hadLoadTimeout = false
    self._hadDeferTimer = false

    try { this.$forceUpdate() } catch (e) {}
  },

  // dirtyVal: 存储中的写盘版本号，null 表示取不到（按未变更处理）
  resumeRefresh(dirtyVal) {
    var self = this
    var dataChanged = false
    if (dirtyVal !== undefined && dirtyVal !== null && dirtyVal !== "") {
      dataChanged = (String(dirtyVal) !== String(self.lastDirty))
    }
    self.lastDirty = dirtyVal || ""

    dlog("[resumeRefresh] skipNextShow=", self.skipNextShow, "dataChanged=", dataChanged, "dirtyVal=", dirtyVal)

    // onInit 刚完成首次加载，且数据没被别的页面改过 —— 不重复整条读取链
    if (self.skipNextShow && !dataChanged) {
      dlog("[resumeRefresh] ⚠ EARLY RETURN — skipping data reload")
      self.skipNextShow = false
      try { self.$forceUpdate() } catch (e) {}
      return
    }
    self.skipNextShow = false

    store.getCurrentScheduleIndex(function(idx) {
      dlog("[resumeRefresh] store idx=", idx, "database idx=", database.getScheduleIndex())
      var doLoad = function() {
        // 课表没有切换时不必再次写盘，直接刷新数据
        if (database.getScheduleIndex() === idx) {
          self.loadScheduleData(idx, true)
        } else {
          dlog("[resumeRefresh] schedule index mismatch, syncing...")
          database.setScheduleIndex(idx, function() {
            self.loadScheduleData(idx, true)
          })
        }
      }
      // 数据变更时立即读，不等 50ms：删除/新增后回首页要第一时间反映
      setTimeout(doLoad, dataChanged ? 0 : 50)
      // 二次兜底：写盘回调与跨页返回存在竞态，稍后再刷一次确保最终一致
      if (dataChanged) {
        setTimeout(doLoad, 400)
      }
    }, true)
  },

  // 读取指定课表的数据并刷新界面
  loadScheduleData(idx, forceRefresh) {
    var self = this
    dlog("[loadScheduleData] idx=", idx, "forceRefresh=", forceRefresh)
    store.getScheduleNames(function(names) {
      if (names && idx < names.length) {
        self.currentScheduleName = names[idx]
      } else {
        self.currentScheduleName = '课程表' + (idx + 1)
      }
      dlog("[loadScheduleData] currentScheduleName=", self.currentScheduleName)
      try { self.$forceUpdate() } catch (e) {}
    })
    self.applyFontSizes()
    database.getAllCoursesWithIndex(idx, function(schedule) {
      dlog("[loadScheduleData] schedule loaded, courses=", schedule ? schedule.length : 0)
      if (!schedule || schedule.length === 0) {
        database.getAllCourses(function(fallback) {
          self.schedule = fallback
          if (self.refreshClasses && typeof self.refreshClasses === 'function') {
            self.refreshClasses()
          }
          try { self.$forceUpdate() } catch (e) {}
        })
        return
      }
      self.schedule = schedule
      if (self.refreshClasses && typeof self.refreshClasses === 'function') {
        dlog("[loadScheduleData] calling refreshClasses")
        self.refreshClasses()
      }
      try { self.$forceUpdate() } catch (e) {}
    }, forceRefresh)
  },

  onHide() {
    if (modules.dayNav && modules.dayNav.stopClock) {
      modules.dayNav.stopClock(this)
    }
    if (this.loadTimeout) {
      clearTimeout(this.loadTimeout)
      this._hadLoadTimeout = true
    }
    if (this.deferTimer) {
      clearTimeout(this.deferTimer)
      this._hadDeferTimer = true
    }
    if (this.stopStatusTimer && typeof this.stopStatusTimer === 'function') {
      this.stopStatusTimer()
      this._hadStatusTimer = true
    }
    if (this.stopProgressTimer && typeof this.stopProgressTimer === 'function') {
      this.stopProgressTimer()
      this._hadProgressTimer = true
    }
    if (modules.customContent && modules.customContent.destroy) {
      modules.customContent.destroy(this)
      this._hadCustomContent = true
    }
    if (modules.holiday && modules.holiday.destroy) {
      modules.holiday.destroy()
      this._hadHoliday = true
    }
  },

  onDestroy() {
    if (modules.dayNav && modules.dayNav.stopClock) {
      modules.dayNav.stopClock(this)
    }
    if (this.loadTimeout) clearTimeout(this.loadTimeout)
    if (this.deferTimer) clearTimeout(this.deferTimer)
    if (this.stopStatusTimer && typeof this.stopStatusTimer === 'function') this.stopStatusTimer()
    if (this.stopProgressTimer && typeof this.stopProgressTimer === 'function') this.stopProgressTimer()
    if (modules.customContent && modules.customContent.destroy) {
      modules.customContent.destroy(this)
    }
    if (modules.holiday && modules.holiday.destroy) {
      modules.holiday.destroy()
    }
  },

  // 把用户设置的字号映射到字号规范的档位，并做屏型收敛：
  // 默认 48 → 正文 32 / 次要 26 / 星期标题 36；最大只到规范上限 40。
  // 胶囊屏上线严格对齐 CSS 媒体查询值：dayTitle ≤ 26px, meta ≤ 20px
  // 避免内联 font-size 覆盖 CSS 导致标题截断/时间溢出（QA P0-2）
  computeFontSizes(size) {
    var norm = Math.round(size * 32 / 48)
    if (norm < 20) norm = 20
    if (norm > 40) norm = 40
    norm = Math.round(norm / 4) * 4
    if (this.isCapsule) {
      return {
        display: Math.min(norm, 32),
        meta: Math.min(Math.max(norm - 8, 20), 20),
        dayTitle: Math.min(norm + 4, 26)
      }
    }
    return {
      display: Math.min(norm, 40),
      meta: Math.max(norm - 6, 20),
      dayTitle: Math.min(norm + 4, 40)
    }
  },

  applyFontSizes() {
    var f = this.computeFontSizes(store.getBaseFontSizeSync())
    this.displaySize = f.display
    this.metaFontSize = f.meta
    this.dayTitleSize = f.dayTitle
  },

  loadFontScale() {
    var self = this
    store.getBaseFontSize(function(size) {
      var f = self.computeFontSizes(size)
      self.displaySize = f.display
      self.metaFontSize = f.meta
      self.dayTitleSize = f.dayTitle
      if (self.refreshClasses && typeof self.refreshClasses === 'function') {
        self.refreshClasses()
      }
      try { self.$forceUpdate() } catch (e) {}
    }, true)
  },

  loadHomepageSettings() {
    var self = this
    store.getHomepageSettings(function(settings) {
      self.showQuickAdd = settings.showQuickAdd !== false
      self.statusBarSetting = settings.showStatusBar !== false
      self.showPinnedBar = settings.showPinnedBar !== false
      self.showCustomContent = settings.showCustomContent || false
      self.customContent = settings.customContent || ""
    }, true)
  },

  applyHomepageTemplate() {
    var self = this
    store.getHomepageTemplate(function(tplId) {
      self.homepageTplId = tplId
      var tpl = HOMEPAGE_TEMPLATES[tplId] || HOMEPAGE_TEMPLATES["default"]
      var colorKey = tpl.dayTitleColor || "text"
      self.dayTitleColor = self.theme[colorKey] || self.theme.text
      try { self.$forceUpdate() } catch (e) {}
    })
  },

  initAllModules() {
    var self = this
    var deferred = []

    for (var i = 0; i < moduleNames.length; i++) {
      var m = moduleNames[i]
      if (m.defer) {
        deferred.push(m.key)
        continue
      }
      self.initOneModule(m.key)
    }

    if (self.loadDayClasses && typeof self.loadDayClasses === 'function') {
      if (self.reloadHolidayState && typeof self.reloadHolidayState === 'function') {
        var d = self.currentDate
        var dateStr = d ? (d.getFullYear() + "-" + (d.getMonth() + 1 < 10 ? "0" : "") + (d.getMonth() + 1) + "-" + (d.getDate() < 10 ? "0" : "") + d.getDate()) : ""
        self.reloadHolidayState(dateStr, function(overrideWeekDay) {
          if (overrideWeekDay === -2) {
            self.currentClasses = []
            self.isToday = true
          } else {
            try { self.loadDayClasses(overrideWeekDay) } catch (e) { console.error("[index] loadDayClasses: " + (e.message || e)) }
          }
          if (self.startProgressTimer && typeof self.startProgressTimer === 'function') {
            try { self.startProgressTimer() } catch (e) {}
          }
          if (self.updateHideWeekend && typeof self.updateHideWeekend === 'function') {
            try { self.updateHideWeekend() } catch (e) {}
          }
          // 假期状态此刻才就绪，状态条需重算（否则首帧仍显示默认「暂无」）
          if (self.updateStatus && typeof self.updateStatus === 'function') {
            try { self.updateStatus() } catch (e) {}
          }
          try { self.$forceUpdate() } catch (e) {}
        })
      } else {
        try { self.loadDayClasses() } catch (e) { console.error("[index] loadDayClasses: " + (e.message || e)) }
      }
    }

    // 次要模块延后到首帧之后初始化，先把课程列表渲染出来
    if (deferred.length > 0) {
      self.deferTimer = setTimeout(function() {
        self.deferTimer = null
        for (var j = 0; j < deferred.length; j++) {
          self.initOneModule(deferred[j])
        }
        if (self.updateStatus && typeof self.updateStatus === 'function') {
          try { self.updateStatus() } catch (e) {}
        }
        if (self.startStatusTimer && typeof self.startStatusTimer === 'function') {
          try { self.startStatusTimer() } catch (e) {}
        }
      }, 50)
    }
  },

  initOneModule(key) {
    var mod = modules[key]
    if (mod && mod.init) {
      try {
        mod.init(this)
      } catch (e) {
        console.error("[index] module " + key + " init failed: " + (e.message || e))
      }
    }
  },

  goBack() {
    router.back()
  },

  onBackPress() {
    // 同上：退出成功才消费返回键；失败要 return false 交还系统默认行为，
    // 否则会出现"按返回键无反应、应用退不出去"。
    var utils = require("../../data/utils.js")
    return utils.exitApp() === true
  },

  retryLoad() {
    var self = this
    self.isLoading = true
    self.loadError = false
    try { self.$forceUpdate() } catch (e) {}

    self.loadTimeout = setTimeout(function() {
      if (self.isLoading) {
        self.loadError = true
        self.isLoading = false
        try { self.$forceUpdate() } catch (e) {}
      }
    }, 8000)

    database.init(function() {
      database.getAllCourses(function(schedule) {
        if (self.loadTimeout) clearTimeout(self.loadTimeout)
        self.schedule = schedule
        self.applyFontSizes()
        self.initAllModules()
        self.initialized = true
        self.skipNextShow = false
        self.isLoading = false
        self.loadError = false
      })
    })
  },

  goToWeekView() {
    var storage = require("@system.storage")
    store.getCurrentScheduleIndex(function(idx) {
      storage.set({
        key: "weekview_index",
        value: String(idx),
        success: function() { router.push({ uri: "/pages/week-view" }) },
        fail: function() { router.push({ uri: "/pages/week-view" }) }
      })
    })
  },

  goToWorkdayInfo() {
    router.push({ uri: "/pages/workday-info", params: { showRules: "1" } })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  goToTomorrow() {
    var self = this
    var tomorrow = new Date()
    tomorrow.setDate(tomorrow.getDate() + 1)
    tomorrow = new Date(tomorrow.getFullYear(), tomorrow.getMonth(), tomorrow.getDate())
    if (self.currentDate) {
      if (sameDate(self.currentDate, tomorrow)) return
    }
    self.currentDate = tomorrow
    self.currentDayIndex = tomorrow.getDay()
    self.currentDay = fullDayNames[tomorrow.getDay()]
    self.dayDisplayText = isCapsuleScreen
      ? dayShortMap[self.currentDay] || self.currentDay
      : self.currentDay
    self.currentDateStr = formatDateShort(tomorrow)
    self.isTodayDate = false
    if (self.updateTopLabel) self.updateTopLabel()
    self.skipNextShow = true
    if (self.reloadHolidayState && typeof self.reloadHolidayState === 'function') {
      self.reloadHolidayState(dateToDateStr(tomorrow), function(overrideWeekDay) {
        if (overrideWeekDay === -2) {
          self.currentClasses = []
          self.isToday = true
        } else if (self.loadDayClasses && typeof self.loadDayClasses === 'function') {
          self.loadDayClasses(overrideWeekDay)
        }
        if (self.updateStatus && typeof self.updateStatus === 'function') self.updateStatus()
        try { self.$forceUpdate() } catch (e) {}
      })
    } else if (self.loadDayClasses && typeof self.loadDayClasses === 'function') {
      self.loadDayClasses()
      if (self.updateStatus && typeof self.updateStatus === 'function') self.updateStatus()
      try { self.$forceUpdate() } catch (e) {}
    }
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  }
}
</script>

<style>
.schedule-page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  /* 2026-11-01 兜底改造：基础样式直接取胶囊屏（手环）数值。
     原因见 docs/首页-真机与截图不一致-根因分析.md：真机上
     shape: pill-shaped 那条媒体查询可能整条不生效，此前基础值 44px 顶部内距
     会让真机首页顶部白白空出 39px。现基础值即手环正确值，
     圆屏/方屏由各自 media 块显式覆盖（circle 44/36、rect 6），行为不变。 */
  padding: 5px 16px 14px 16px;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  /* 2026-11-01 紧凑化：上下 padding 8→5、下边距 4→2（省 8px），
     圆钮本身直径未变，点按手感不受影响 */
  /* 2026-11-01 兜底改造：基础值取胶囊态 0（手环 header 无需额外内距）；
     圆屏在 circle 块补回 5px 4px，方屏在 rect 块本就是 3px 0 */
  padding: 0;
  margin-bottom: 2px;
  flex-shrink: 0;
}

.date-row {
  padding: 0;
  /* 2026-11-01 紧凑化：原 44px 高 + 文字 30px 顶对齐，底部留 14px 死白，
     下方 header 又各带 8px padding，顶部合计约 26px 空白全被浪费。
     现收到 34px（文字上下各留 2px），header 上下 padding 8→5，
     整页顶部省 18px 全部让给课程列表。
     热区代价：34px 仍大于手环最小可点 32px，且日期行左侧 8px 边距外的整行宽度都可点，
     命中面积 176×34 远大于规范下限，不影响「回今天」。 */
  /* 2026-11-01 紧凑化二次收敛（方屏/圆屏）：时间行再收 34→28、字号 22→20，
     与胶囊屏一致，顶部时间只作提示不再抢视觉重心。 */
  /* 2026-11-01 兜底改造：基础值取胶囊态；圆屏/方屏在各自块补回更大值。
     2026-11-01 二次：字号 18→22、行高 20→26（+6px），顶部时间从「灰提示」提到
     可读的正文层级。宽度账：最长文案「10月25日」6 字 × 0.958 × 22 = 126px，
     小于该行可用宽（192 屏顶部弧下约 150px），不会与弧边打架。 */
  height: 26px;
  align-items: flex-start;
  flex-shrink: 0;
}

.date-text {
  /* 2026-11-01 兜底改造：基础值取胶囊态；圆屏/方屏补回更大值 */
  font-size: 22px;
  /* line-height 与 .date-row 等高，文字在行内正好垂直占满，不再顶对齐留白 */
  line-height: 26px;
  text-align: center;
  width: 100%;
}

.day-title {
  font-weight: bold;
  text-align: center;
  lines: 1;
  flex: 1;
  }

.nav-btn-circle {
  /* 2026-11-01 兜底改造：基础值取胶囊态 40；圆屏在 circle 块补回 48，方屏在 rect 块补回 48 */
  width: 40px;
  height: 40px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.nav-btn-img {
  /* 基础值取胶囊态 20；圆屏 22、方屏 24 各自覆盖 */
  width: 20px;
  height: 20px;
}

.day-nav-btns {
  flex-direction: row;
}

.nav-toolbar {
  /* 已废弃：胶囊屏「总/今/明」整行下沉到底部三圆，此规则仅保留占位说明，
     新代码不要再引用 .nav-toolbar。 */
  flex-direction: row;
}

.day-nav-circle {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin-left: 4px;
}

.day-nav-text {
  font-size: 20px;
  line-height: 28px;
  font-weight: bold;
  text-align: center;
}

.custom-content-bar {
  flex-direction: row;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.custom-content-text {
  font-size: 20px;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
  line-height: 28px;
}

.status-bar {
  flex-direction: row;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.status-tag {
  font-size: 20px;
  padding: 2px 8px;
  border-radius: 4px;
  margin-right: 8px;
  line-height: 28px;
}

.status-middle {
  font-size: 20px;
  flex: 1;
  lines: 1;
  line-height: 28px;
}

.status-right {
  font-size: 20px;
  line-height: 28px;
}

.pinned-bar {
  flex-direction: row;
  align-items: center;
  padding: 4px 8px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.pinned-content {
  flex: 1;
}

.pinned-row {
  flex-direction: row;
  flex-wrap: wrap;
}

.pinned-tag {
  padding: 6px 16px;
  border-radius: 18px;
  margin-right: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
  border-width: 1px;
}

.pinned-tag-text {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
}

.class-list {
  flex: 1;
  flex-direction: column;
  margin-bottom: 4px;
}

.class-grid {
  flex-direction: column;
}

.class-grid-item {
  position: relative;
  width: 100%;
  min-height: 60px;
  border-radius: 12px;
  padding: 0;
  margin-bottom: 10px;
  flex-direction: row;
  overflow: hidden;
}

.class-card-accent {
  width: 5px;
  flex-shrink: 0;
  border-radius: 3px 0 0 3px;
}

.class-card-body {
  flex: 1;
  flex-direction: column;
  padding: 14px 16px 14px 14px;
}

.progress-bg {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  opacity: 0.12;
}

.grid-item-name {
  font-weight: bold;
  text-overflow: ellipsis;
  lines: 1;
  flex-shrink: 1;
}

.card-name-row {
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 6px;
}

.grid-item-location-inline {
  margin-left: 6px;
  lines: 1;
  flex-shrink: 0;
}

.grid-item-location {
  lines: 1;
  text-overflow: ellipsis;
  margin-bottom: 4px;
}

.grid-item-time {
  lines: 1;
  text-overflow: ellipsis;
  flex-shrink: 0;
}

.empty-card {
  padding: 20px;
  align-items: center;
}

.empty-text {
  font-size: 20px;
  line-height: 28px;
}

/* ── skeleton ── */
.skeleton-list {
  flex-direction: column;
  padding: 6px 0;
}

.skeleton-card {
  flex-direction: row;
  border-radius: 12px;
  margin-bottom: 10px;
  overflow: hidden;
  height: 72px;
  opacity: 0.7;
}

.skeleton-accent {
  width: 4px;
  height: 100%;
  flex-shrink: 0;
}

.skeleton-body {
  flex: 1;
  padding: 12px 14px;
  flex-direction: column;
  justify-content: center;
}

.skeleton-bar {
  flex-shrink: 0;
}

.quick-add {
  border-radius: 10px;
  margin-bottom: 4px;
  flex-direction: column;
  flex-shrink: 0;
}

.quick-add-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  border-radius: 10px;
}

.quick-add-title {
  font-size: 20px;
  font-weight: bold;
  line-height: 28px;
}

.quick-add-info {
  flex-direction: row;
  align-items: center;
}

.quick-add-time {
  font-size: 20px;
  margin-right: 6px;
  line-height: 28px;
}

.quick-add-arrow-img {
  width: 20px;
  height: 20px;
  margin-left: 4px;
}

/* 收起态：上下留白 10 → 6，整条 48 → 40px（字号不动，只收留白）。
   单独一个类而不是改 .quick-add-header —— 展开时那一行是操作区，需要原来的呼吸感。 */
.quick-add-header-collapsed {
  padding: 6px 12px;
}

/* 收起态箭头压暗一半：图标是固定色 png，没法跟主题走，只能靠透明度退后 */
.quick-add-arrow-dim {
  opacity: 0.5;
}

.quick-add-row-scroll {
  flex-direction: column;
  padding: 0 0 8px 0;
}

.quick-add-scroll {
  height: 44px;
}

.quick-add-tags {
  flex-direction: row;
  padding: 0 8px;
}

.quick-add-tag {
  border-radius: 20px;
  padding: 8px 16px;
  margin-right: 8px;
  flex-shrink: 0;
}

.quick-add-tag-text {
  font-size: 20px;
  line-height: 28px;
}

.quick-add-plus-text {
  font-size: 24px;
  font-weight: bold;
}

.quick-add-empty {
  font-size: 20px;
  line-height: 28px;
  padding: 6px 12px;
  text-align: center;
}

.bottom-buttons {
  flex-direction: row;
  justify-content: space-between;
  /* 四个 media 块里只有 circle 声明了 8px、rect 声明了 3px，胶囊块未声明
     → 手环当前实际就用这条基础值 4px，故保持不动，避免引入意外位移 */
  margin-bottom: 4px;
  flex-shrink: 0;
}

.add-btn-wrapper {
  /* 2026-11-01 兜底改造：高度/圆角取胶囊态 48/24（手环三圆同径）。
     flex 与 margin 仍保持长条语义（flex:1 + 4px），因为非胶囊屏渲染的
     是「图标＋添加课程」长条，两套 DOM 结构不同，不能一并改成圆钮。
     圆屏在 circle 块覆盖 44/20，方屏在 rect 块覆盖 44/21。 */
  flex: 1;
  height: 48px;
  border-radius: 24px;
  margin-right: 4px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

/* 2026-11-01 兜底改造：胶囊屏那一份「＋」的圆钮形态不再靠媒体查询区分，
   改用模板里 isCapsule 分支专属的 class 直接给定。
   原因：add-btn-wrapper 有两套互斥形态（圆钮 48 / 长条 flex:1），
   一旦真机媒体查询失效，仅靠 media 覆盖会让加号退化成 64px 宽块、
   三圆被挤紧。现在圆钮形态与 isCapsule 同源，不依赖设备端媒体查询解析。 */
.add-btn-wrapper-circle {
  flex: 0 0 48px;
  width: 48px;
  height: 48px;
  border-radius: 24px;
  margin-right: 0;
}

.add-btn-icon {
  width: 24px;
  height: 24px;
}

.add-btn-label {
  font-size: 20px;
  font-weight: bold;
  margin-left: 4px;
}

.style-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  line-height: 44px;
}

/* 方案 D6：底部三件套中间位（切换课表）＝纯 ⇄ 图标钮；
   160px 内容区：48(＋) + 48(⇄) + flex(设置) —— 课表名放下边会裁字，故只留图标 */
.bottom-mid-btn {
  flex: 0 0 48px;
  width: 48px;
  height: 44px;
  border-radius: 22px;
  margin-right: 4px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.bottom-mid-btn .week-swap-icon {
  width: 22px;
  height: 22px;
  margin-right: 0;
}

/* 底部三圆（胶囊屏专用）：中位「总」与右侧「设置」与左位「添加」同径 48，
   图标统一 24px，视觉重量与 ＋ 对齐；方屏不渲染这两枚。 */
.bottom-mid-icon {
  width: 24px;
  height: 24px;
}

.set-btn-circle {
  flex: 0 0 48px;
  width: 48px;
  height: 48px;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}

.week-indicator {
  padding: 12px 8px;
  align-items: center;
  justify-content: center;
  flex-direction: row;
}

.week-swap-icon {
  width: 16px;
  height: 16px;
  margin-right: 4px;
}

.week-text {
  flex-shrink: 0;
  font-size: 20px;
  line-height: 28px;
  text-align: center;
}

/* 方案 D7：课表切换指示条（单独一行，可点击进入课表管理）
   2026-11-01：外层 row 容器负责「居中」，内层条宽度＝内容宽度，不再拉满整行 */
.schedule-indicator-row {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-bottom: 4px;
}

.schedule-indicator {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 6px 16px;
  border-radius: 18px;
  flex-shrink: 0;
}

.schedule-swap-icon {
  width: 16px;
  height: 16px;
  margin-right: 4px;
}

.schedule-name {
  font-size: 18px;
  line-height: 26px;
  text-align: center;
  flex-shrink: 0;
}

.left-accent {
  width: 4px;
  border-radius: 2px;
  margin-right: 8px;
}

.left-accent-4 {
  height: 24px;
}

.left-accent-6 {
  height: 28px;
}

/* 调休提示条：整条是热区（规则 §8.2），故 min-height 48 兜住点击高度，
   space-between 让箭头贴右。原来条尾那个 28×28 的「?」圆钮已废弃
   （.workday-info-btn 保留为历史样式，模板不再引用）。 */
.workday-tip-bar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.workday-tip-arrow {
  font-size: 22px;
  line-height: 26px;
  margin-left: 6px;
  flex-shrink: 0;
}

.workday-tip-text {
  font-size: 18px;
  line-height: 26px;
  flex: 1;
}

.workday-info-btn {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  font-size: 18px;
  font-weight: bold;
  line-height: 28px;
  text-align: center;
  flex-shrink: 0;
  margin-left: 6px;
}

.holiday-greeting-card {
  flex-direction: column;
  padding: 14px;
  border-radius: 8px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.holiday-greeting-name {
  font-size: 20px;
  font-weight: bold;
  line-height: 28px;
  margin-bottom: 2px;
}

.holiday-greeting-text {
  font-size: 22px;
  line-height: 30px;
}

@media (shape: circle) {
  .schedule-page {
    padding: 44px 36px 44px 36px;
  }
  /* 2026-11-01 兜底改造的配套：基础样式已改为胶囊态，圆屏必须在此显式
     收回自己的值，否则会跟着变矮变小（视觉回归）。*/
  .header {
    padding: 5px 4px;
  }
  .date-row {
    height: 30px;
  }
  .date-text {
    font-size: 24px;
    line-height: 30px;
  }
  /* 圆屏横向空间同样紧张，取 44px 而非规范 48px */
  /* 胶囊屏 header 实际只有 ◀ + 标题 + ▶（总/今/明已移到 nav-toolbar），
     48×2 = 96px，标题仍有 64px（单字 26px 绰绰有余），可提到 48px */
  .nav-btn-circle {
    width: 48px;
    height: 48px;
    border-radius: 24px;
  }
  .nav-btn-img {
    width: 22px;
    height: 22px;
  }
  .day-nav-circle {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    margin-left: 2px;
  }
  .add-btn-wrapper,
  .style-btn {
    height: 44px;
    border-radius: 20px;
  }
  .add-btn-icon {
    width: 22px;
    height: 22px;
  }
  .add-btn-label {
    font-size: 18px;
  }
  .bottom-buttons {
    margin-bottom: 8px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  /* 顶部留白按真机反馈收紧（2026-10-24）：原 30px 顶部 + 44px 日期行 + 48px 头部
     = 122px 才见到第一张课卡，屏高 490 下白扔掉 1/4。现 18 + 26 + 40 = 84px。
     日期行热区跟着收到 26px（用户口径：热区够用就行，不要多）。 */
  /* 2026-11-01 紧凑化二次收敛：时间行原先 24px 高 + 22px 字号独占一整行，
     上下各留白，是首页顶部最明显的一块空。现字号 22→18、行高 20、
     顶部内距 10→5，时间行由 24px 收到 20px，整页顶部再省 9px。 */
  /* 2026-11-02 横向 16→12：ev-six 内容宽口径是 192−2×12 = 168px。
     原来按 16 收边只剩 160，提醒条再扣内距后真正可用只有 144px，
     正是课名被切成「机械…」的直接原因（宽度账见 .status-capsule-name 注释）。 */
  .schedule-page {
    padding: 5px 12px 14px 12px;
  }
  /* 提醒条与上方圆钮原来只隔 2px，视觉上像贴在按钮下沿；
     放到 6px，与提醒条到下方课卡的间距（6px）对称。 */
  .header {
    padding: 0;
    margin-bottom: 6px;
  }
  .date-row {
    height: 26px;
  }
  .date-text {
    font-size: 22px;
    line-height: 26px;
  }
  .nav-btn-circle {
    width: 40px;
    height: 40px;
    border-radius: 20px;
  }
  .nav-btn-img {
    width: 20px;
    height: 20px;
  }
  .day-title {
    font-size: 28px;
    font-weight: bold;
    text-align: center;
    flex: 1;
    line-height: 36px;
    lines: 1;
  }
  /* 胶囊屏 header 里不放「总/今/明」（day-nav-btns 由 !isCapsule 关闭），
     三枚已下沉到底部三圆，故此处不再给 .day-nav-circle / .day-nav-text 做胶囊覆盖。 */
  .custom-content-text {
    font-size: 20px;
    line-height: 28px;
  }
  /* 2026-11-02 内距 8→6、下边距 4→6：上下各 6px 与 header 下边距对称，
     条高 26+12=38（原 42），省下的 4px 还给课卡列表。 */
  .status-bar {
    padding: 6px;
    margin-bottom: 6px;
  }
  /* Capsule status bar: 单行布局（剩余时间 + 课程名），见模板注释 */
  .status-capsule-row {
    flex-direction: row;
    align-items: center;
    flex: 1;
  }
  /* 2026-11-03：状态灯样式删除。模板节点已移除，这里若留 16px 定义会让人以为
     图标还在（当年就是为了给课名腾宽度才从 18 收到 16，索性整块去掉）。 */
  .status-capsule-body {
    flex: 1;
    flex-direction: row;
    align-items: center;
  }
  .status-capsule-time {
    font-size: 18px;
    line-height: 26px;
    margin-right: 4px;
    flex-shrink: 0;
  }
  /* 宽度账（192 − 12×2 页边 = 168，条内距 6×2 = 156）：
       去图标后只剩「36m」38 + 间 4 = 42 → 课名实得 114px。
       Vela 的 text-overflow: ellipsis 会预留一个字宽再决定截断
       （实测：盒宽 76px 时只放 2 字就出省略号），判据是 (盒宽 − 1字)/1字：
         18px 字号 → 4 字需 4×18+18 = 90 ≤ 114 稳定；
                      5 字需 108 ≤ 114，仅当倒计时是「36m」这类 3 字符时成立
                      （倒计时若长到「1h36m」约 57px，课名只剩 95px，退化为 4 字）。
       这是「课名被切成机械…」的根治点，别再把字号调回 20（20px 下 4 字需 100，
       倒计时一变长就截）。 */
  .status-capsule-name {
    flex: 1;
    font-size: 18px;
    font-weight: bold;
    line-height: 26px;
    lines: 1;
    text-overflow: ellipsis;
  }
  .section-label {
    font-size: 20px;
    line-height: 28px;
    padding: 6px 4px;
  }
  .quick-add-header {
    padding: 8px 12px;
  }
  .quick-add-title {
    font-size: 20px;
  }
  .quick-add-scroll {
    height: 48px;
  }
  .quick-add-tag {
    border-radius: 20px;
    padding: 4px 10px;
  }
  .quick-add-tag-text {
    font-size: 20px;
  }
  /* 胶囊屏底部三圆：48+48+48 = 144，内容区 160 → 两处各留 8px 由 space-between 分配，
     因此三枚都不带 margin-right，保证左右对称。 */
  .add-btn-wrapper {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 0;
    justify-content: center;
    align-items: center;
  }
  .add-btn-icon {
    width: 24px;
    height: 24px;
  }
  .add-btn-label {
    display: none;
  }
  .bottom-mid-btn {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 0;
  }
  .bottom-mid-btn .week-swap-icon {
    width: 24px;
    height: 24px;
  }
  /* 胶囊屏：课程名独占一行（或与短教室名同行），时间独占一行，教室长时另起一行 */
  .class-card-body {
    padding: 6px 10px 6px 10px;
    flex-direction: column;
    align-items: flex-start;
  }
  .card-name-row {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 2px;
  }
  .grid-item-name {
    margin-bottom: 0;
    flex-shrink: 1;
    lines: 1;
    text-overflow: ellipsis;
  }
  .grid-item-location-inline {
    margin-left: 4px;
    lines: 1;
    flex-shrink: 0;
  }
  .grid-item-time {
    font-size: 20px;
    margin-bottom: 0;
    lines: 1;
  }
  .grid-item-location {
    font-size: 20px;
    lines: 1;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .week-text {
    font-size: 20px;
  }
  .left-accent-4 {
    height: 24px;
  }
  .left-accent-6 {
    height: 28px;
  }
}

@media (shape: rect) {
  .schedule-page {
    padding: 6px 6px 6px 6px;
  }
  .header {
    padding: 3px 0;
    margin-bottom: 3px;
  }
  /* 2026-11-01 兜底改造的配套：基础样式已改为胶囊态，方屏在此显式收回
     自己的日期行与导航圆钮尺寸；二次加号时同步放大到 30/24。*/
  .date-row {
    height: 30px;
  }
  .date-text {
    font-size: 24px;
    line-height: 30px;
  }
  /* 方屏: 圆圈容器保持48px, 箭头三角缩小到24px与胶囊屏一致 */
  .nav-btn-circle {
    width: 48px;    height: 48px;
    border-radius: 24px;
  }
  .nav-btn-img {
    width: 24px;
    height: 24px;
  }
  .day-title {
    font-size: 26px;
    font-weight: bold;
    text-align: center;
    flex: 1;
    lines: 1;
  }
  .day-nav-circle {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    margin-left: 2px;
  }
  .day-nav-text {
    font-size: 20px;
    line-height: 28px;
  }
  .custom-content-bar {
    padding: 6px 8px;
    border-radius: 6px;
    margin-bottom: 3px;
  }
  .custom-content-text {
    font-size: 20px;
