<template>
  <div id="root" class="root" style="background-color: {{ theme.bg }}">
    <div class="debug-bar">
      <text class="debug-text">{{ screenShape }} {{ screenWidth }}x{{ screenHeight }} | {{ errorMsg || 'OK' }}</text>
    </div>
    <text class="title">V5.4 StatusBar</text>

    <div class="status-bar" if="{{ showStatusBar }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent" style="background-color: {{ theme.accent }}"></div>
      <text class="status-tag" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">{{ statusTag }}</text>
      <text class="status-middle" style="color: {{ theme.text }}">{{ statusMainText }}</text>
      <text class="status-right" if="{{ statusTimeText }}" style="color: {{ theme.accent }}">{{ statusTimeText }}</text>
    </div>

    <div class="class-list">
      <div if="{{ isLoading }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">加载中...</text>
      </div>
      <div if="{{ !isLoading && currentClasses.length === 0 }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">今天没有课</text>
      </div>
      <div for="{{ currentClasses }}" class="class-grid-item" style="background-color: {{ theme.card }}">
        <div class="class-card-accent" style="background-color: {{ theme.accent }}"></div>
        <div class="class-card-body">
          <text class="grid-item-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <div class="class-card-meta">
            <text class="grid-item-time" style="color: {{ theme.accent }}">{{ $item.time }}</text>
            <text class="grid-item-location" if="{{ $item.location }}" style="color: {{ theme.textMuted }}">{{ $item.location }}</text>
          </div>
        </div>
      </div>
    </div>

    <div class="quick-add" style="background-color: {{ theme.card }}">
      <div class="quick-add-header" onclick="quickAdd.toggle">
        <text class="quick-add-title" style="color: {{ theme.accent }}">快速添加</text>
        <div class="quick-add-info">
          <text class="quick-add-arrow" style="color: {{ theme.accent }}">{{ quickAdd.expanded ? '▲' : '▼' }}</text>
        </div>
      </div>
      <div class="quick-add-row-scroll" if="{{ quickAdd.expanded }}">
        <text class="quick-add-empty" if="{{ quickAdd.courseNames.length === 0 }}" style="color: {{ theme.textMuted }}">暂无已添加课程</text>
        <div class="quick-add-tags" if="{{ quickAdd.courseNames.length > 0 }}">
          <div for="{{ quickAdd.courseNames }}" class="quick-add-tag" onclick="quickAdd.addCourse($item)" style="background-color: {{ theme.cardLight }}">
            <text class="quick-add-tag-text" style="color: {{ theme.text }}">{{ $item }}</text>
          </div>
        </div>
      </div>
    </div>

    <input class="btn" type="button" value="打开设置" onclick="openSettings" />
    <text class="hint">如果页面只显示左上角，请截图反馈</text>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const classList = require("./modules/class-list.js")
const quickAdd = require("./modules/quick-add.js")
const statusBar = require("./modules/status-bar.js")

export default {
  private: {
    deviceInfo: { brand: "?", model: "?" },
    screenWidth: "?",
    screenHeight: "?",
    screenShape: "?",
    devicePixelRatio: "?",
    platformVersion: "?",
    errorMsg: "",
    isLoading: true,
    currentClasses: [],
    schedule: [],
    statusTag: "",
    statusMainText: "",
    statusTimeText: "",
    showStatusBar: true,
    quickAdd: {
      expanded: false,
      courseNames: [],
      toggle: function() {},
      addCourse: function() {}
    },
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a"
    }
  },

  onInit() {
    var self = this
    try {
      device.getInfo({
        success: function(info) {
          self.deviceInfo = { brand: info.brand || "?", model: info.model || "?" }
          self.screenWidth = info.screenWidth || "?"
          self.screenHeight = info.screenHeight || "?"
          self.screenShape = info.screenShape || "?"
          self.devicePixelRatio = info.devicePixelRatio || "?"
          self.platformVersion = info.platformVersion || "?"
        },
        fail: function(err) {
          self.errorMsg = "device.getInfo: " + (err || "unknown")
        }
      })
      store.getTheme(function(t) {
        self.theme = t
      })
      database.init(function() {
        database.getAllCourses(function(schedule) {
          self.schedule = schedule
          try {
            classList.init(self)
            quickAdd.init(self)
            statusBar.init(self)
            if (self.loadDayClasses && typeof self.loadDayClasses === 'function') {
              self.loadDayClasses()
            }
          } catch (e) {
            self.errorMsg = "module: " + (e.message || e)
          }
          self.isLoading = false
        })
      })
    } catch (e) {
      self.errorMsg = "exception: " + (e.message || e)
      self.isLoading = false
    }
  },

  onShow() {
    this.$forceUpdate()
  },

  openSettings() {
    router.push({ uri: "/pages/settings" })
  }
}
</script>

<style>
.root {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #1a1a2e;
  padding: 12px 12px;
}

.debug-bar {
  width: 100%;
  padding: 2px 6px;
  background-color: #333333;
  margin-bottom: 8px;
}
.debug-text {
  font-size: 12px;
  color: #00ff00;
  lines: 1;
}

.title {
  font-size: 24px;
  color: #7ec8e3;
  font-weight: bold;
  margin-bottom: 12px;
  text-align: center;
}

.status-bar {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding: 8px 10px;
  border-radius: 10px;
  margin-bottom: 8px;
}

.left-accent {
  width: 4px;
  height: 100%;
  border-radius: 2px;
  margin-right: 8px;
}

.status-tag {
  font-size: 14px;
  padding: 2px 8px;
  border-radius: 6px;
  margin-right: 8px;
}

.status-middle {
  font-size: 16px;
  flex: 1;
}

.status-right {
  font-size: 14px;
}

.class-list {
  width: 100%;
  flex: 1;
  margin-bottom: 8px;
}

.empty-card {
  width: 100%;
  padding: 20px;
  align-items: center;
}

.empty-text {
  font-size: 18px;
  text-align: center;
}

.class-grid-item {
  width: 100%;
  min-height: 60px;
  border-radius: 12px;
  padding: 0;
  margin-bottom: 10px;
  flex-direction: row;
  overflow: hidden;
  position: relative;
}

.class-card-accent {
  width: 6px;
  border-radius: 3px 0 0 3px;
}

.class-card-body {
  flex: 1;
  flex-direction: column;
  padding: 12px;
}

.grid-item-name {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 4px;
}

.class-card-meta {
  flex-direction: row;
}

.grid-item-time {
  font-size: 16px;
  margin-right: 12px;
}

.grid-item-location {
  font-size: 16px;
}

.quick-add {
  width: 100%;
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 8px;
}

.quick-add-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.quick-add-title {
  font-size: 18px;
  font-weight: bold;
}

.quick-add-info {
  flex-direction: row;
  align-items: center;
}

.quick-add-arrow {
  font-size: 14px;
}

.quick-add-row-scroll {
  margin-top: 8px;
}

.quick-add-empty {
  font-size: 14px;
  padding: 8px 0;
}

.quick-add-tags {
  flex-direction: row;
  flex-wrap: wrap;
}

.quick-add-tag {
  padding: 6px 12px;
  border-radius: 8px;
  margin-right: 8px;
  margin-bottom: 8px;
}

.quick-add-tag-text {
  font-size: 14px;
}

.btn {
  width: 180px;
  height: 44px;
  font-size: 20px;
  text-align: center;
  border-radius: 10px;
  background-color: #7ec8e3;
  color: #1a1a2e;
  margin-bottom: 8px;
}

.hint {
  font-size: 14px;
  color: #ffaa00;
  text-align: center;
  margin-bottom: 8px;
}
</style>