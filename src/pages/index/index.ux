<template>
  <div id="schedule-page" class="schedule-page" style="background-color: {{ theme.bg }}">
    <div class="debug-bar">
      <text class="debug-text">{{ screenShape }} {{ screenWidth }}x{{ screenHeight }} | {{ errorMsg || 'V6.1 OK' }}</text>
    </div>

    <div class="clock-row" if="{{ showTime }}">
      <text class="clock-text" style="color: {{ theme.textSecondary }}">{{ currentTime }}</text>
    </div>

    <div class="header" if="{{ showDayNav }}">
      <input class="nav-btn" type="button" value="&#9664;" onclick="prevDay" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="day-title" style="font-size: {{ dayTitleSize }}px; color: {{ theme.text }}">{{ currentDay }}</text>
      <div class="day-nav-btns">
        <div class="day-nav-circle" onclick="goToWeekView" if="{{ showDayNavZong }}" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">总</text>
        </div>
        <div class="day-nav-circle" onclick="goToToday" if="{{ showDayNavJin }}" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">今</text>
        </div>
        <div class="day-nav-circle" onclick="goToTomorrow" if="{{ showDayNavMing }}" style="background-color: {{ theme.cardLight }}">
          <text class="day-nav-text" style="color: {{ theme.accent }}">明</text>
        </div>
      </div>
      <input class="nav-btn" type="button" value="&#9654;" onclick="nextDay" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
    </div>

    <div class="custom-content-bar" if="{{ showCustomContent && customContent }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-4" style="background-color: {{ theme.accent }}"></div>
      <text class="custom-content-text" style="color: {{ theme.text }}">{{ customContent }}</text>
    </div>

    <div class="status-bar" if="{{ showStatusBar }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-6" style="background-color: {{ theme.accent }}"></div>
      <text class="status-tag" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">{{ statusTag }}</text>
      <text class="status-middle" style="color: {{ theme.text }}">{{ statusMainText }}</text>
      <text class="status-right" if="{{ statusTimeText }}" style="color: {{ theme.accent }}">{{ statusTimeText }}</text>
    </div>

    <div class="pinned-bar" if="{{ showPinnedBar && hasPinned }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-4" style="background-color: {{ theme.accent }}"></div>
      <div class="pinned-content">
        <div class="pinned-row">
          <div for="{{ pinnedPages }}" class="pinned-item" onclick="openPinnedPage($item.uri)" style="background-color: {{ theme.card }}">
            <text class="pinned-text" style="color: {{ theme.accent }}">{{ $item.name }}</text>
          </div>
        </div>
      </div>
    </div>

    <div class="class-list">
      <div if="{{ isLoading }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">加载中...</text>
      </div>
      <div if="{{ !isLoading && currentClasses.length === 0 }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">今天没有课</text>
      </div>
      <div for="{{ currentClasses }}" class="class-grid-item" onclick="goToClassDetail($item)" style="background-color: {{ theme.card }}">
        <div class="progress-bg" if="{{ isToday }}" style="width: {{ $item.progress }}%; background-color: {{ $item.progressColor }}"></div>
        <div class="class-card-accent" style="background-color: {{ theme.accent }}"></div>
        <div class="class-card-body">
          <text class="grid-item-name" style="color: {{ theme.text }}; font-size: {{ displaySize }}px">{{ $item.name }}</text>
          <div class="class-card-meta">
            <text class="grid-item-time" style="color: {{ theme.accent }}; font-size: {{ metaFontSize }}px">{{ $item.time }}</text>
            <text class="grid-item-location" if="{{ $item.location }}" style="color: {{ theme.textMuted }}; font-size: {{ metaFontSize }}px">{{ $item.location }}</text>
          </div>
        </div>
      </div>
    </div>

    <div class="quick-add" if="{{ showQuickAdd }}" style="background-color: {{ theme.card }}">
      <div class="quick-add-header" onclick="quickAdd.toggle">
        <text class="quick-add-title" style="color: {{ theme.accent }}">快速添加</text>
        <div class="quick-add-info">
          <text class="quick-add-time" if="{{ quickAdd.expanded }}" style="color: {{ theme.textSecondary }}">{{ quickAdd.time }}</text>
          <text class="quick-add-arrow" style="color: {{ theme.accent }}">{{ quickAdd.expanded ? '▲' : '▼' }}</text>
        </div>
      </div>
      <div class="quick-add-row-scroll" if="{{ quickAdd.expanded }}">
        <text class="quick-add-empty" if="{{ quickAdd.disabled }}" style="color: {{ theme.textMuted }}">今天课程已排满</text>
        <text class="quick-add-empty" if="{{ !quickAdd.disabled && quickAdd.courseNames.length === 0 }}" style="color: {{ theme.textMuted }}">暂无已添加课程，请先添加课程</text>
        <scroll class="quick-add-scroll" scroll-x="{{true}}" if="{{ !quickAdd.disabled && quickAdd.courseNames.length > 0 }}">
          <div class="quick-add-tags">
            <div for="{{ quickAdd.courseNames }}" class="quick-add-tag" onclick="quickAdd.addCourse($item)" style="background-color: {{ theme.cardLight }}">
              <text class="quick-add-tag-text" style="color: {{ theme.text }}">{{ $item }}</text>
            </div>
          </div>
        </scroll>
      </div>
    </div>

    <div class="bottom-buttons" if="{{ showBottomButtons }}">
      <input class="add-btn" type="button" value="+ 添加课程" onclick="openAddCoursePage" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="style-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
    </div>

    <div class="week-indicator" onclick="openScheduleManager" if="{{ showWeekIndicator }}">
      <text class="week-text" style="color: {{ theme.accent }}">⇄ {{ currentScheduleName }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const classList = require("./modules/class-list.js")
const quickAdd = require("./modules/quick-add.js")
const statusBar = require("./modules/status-bar.js")
const customContent = require("./modules/custom-content.js")
const pinnedPages = require("./modules/pinned-pages.js")
const clock = require("./modules/clock.js")
const dayNav = require("./modules/day-nav.js")
const bottomButtons = require("./modules/bottom-buttons.js")
const weekIndicator = require("./modules/week-indicator.js")

export default {
  private: {
    deviceInfo: { brand: "?", model: "?" },
    screenWidth: "?",
    screenHeight: "?",
    screenShape: "?",
    devicePixelRatio: "?",
    platformVersion: "?",
    errorMsg: "",
    isLoading: true,
    currentClasses: [],
    schedule: [],
    currentTime: "",
    currentDay: "",
    currentDayIndex: -1,
    statusTag: "",
    statusMainText: "",
    statusTimeText: "",
    showStatusBar: true,
    showCustomContent: false,
    customContent: "",
    showPinnedBar: true,
    pinnedPages: [],
    hasPinned: false,
    showTime: true,
    showDayNav: true,
    showDayNavZong: true,
    showDayNavJin: true,
    showDayNavMing: true,
    showBottomButtons: true,
    showQuickAdd: true,
    showWeekIndicator: true,
    isToday: true,
    displaySize: 28,
    metaFontSize: 24,
    dayTitleSize: 28,
    currentScheduleName: "课程表1",
    quickAdd: {
      expanded: false,
      courseNames: [],
      disabled: false,
      time: "",
      toggle: function() {},
      addCourse: function() {}
    },
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a"
    }
  },

  onInit() {
    var self = this
    try {
      device.getInfo({
        success: function(info) {
          self.deviceInfo = { brand: info.brand || "?", model: info.model || "?" }
          self.screenWidth = info.screenWidth || "?"
          self.screenHeight = info.screenHeight || "?"
          self.screenShape = info.screenShape || "?"
          self.devicePixelRatio = info.devicePixelRatio || "?"
          self.platformVersion = info.platformVersion || "?"
        },
        fail: function(err) {
          self.errorMsg = "device: " + (err || "unknown")
        }
      })
    } catch (e) {
      self.errorMsg = "device error: " + (e.message || e)
    }

    try {
      store.getTheme(function(t) { self.theme = t })
    } catch (e) {
      self.errorMsg = "theme: " + (e.message || e)
    }

    try {
      self.loadHomepageSettings()
    } catch (e) {
      self.errorMsg = "homepage: " + (e.message || e)
    }

    try {
      self.loadFontScale()
    } catch (e) {
      self.errorMsg = "fontScale: " + (e.message || e)
    }

    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.schedule = schedule
        try {
          classList.init(self)
          quickAdd.init(self)
          statusBar.init(self)
          customContent.init(self)
          pinnedPages.init(self)
          clock.init(self)
          dayNav.init(self)
          bottomButtons.init(self)
          weekIndicator.init(self)
          if (self.loadDayClasses && typeof self.loadDayClasses === 'function') {
            self.loadDayClasses()
          }
        } catch (e) {
          self.errorMsg = "module: " + (e.message || e)
        }
        self.isLoading = false
      })
    })
  },

  onShow() {
    var self = this
    try {
      store.getTheme(function(t) { self.theme = t })
      self.loadHomepageSettings()
      self.loadFontScale()
      if (self.loadPinnedPages && typeof self.loadPinnedPages === 'function') {
        self.loadPinnedPages()
      }
      if (self.quickAdd && self.quickAdd.loadPreset) {
        self.quickAdd.loadPreset()
      }
    } catch (e) {
      self.errorMsg = "onShow: " + (e.message || e)
    }
    this.$forceUpdate()
  },

  onDestroy() {
    try {
      if (this.stopClockTimer && typeof this.stopClockTimer === 'function') this.stopClockTimer()
      if (this.stopStatusTimer && typeof this.stopStatusTimer === 'function') this.stopStatusTimer()
      if (this.stopProgressTimer && typeof this.stopProgressTimer === 'function') this.stopProgressTimer()
    } catch (e) {}
  },

  loadFontScale() {
    var self = this
    try {
      store.getFontSizes(function(sizes) {
        if (sizes) {
          self.displaySize = sizes.courseName || 28
          self.metaFontSize = sizes.courseTime || 24
          self.dayTitleSize = sizes.courseName || 28
        }
      })
    } catch (e) {}
  },

  loadHomepageSettings() {
    var self = this
    try {
      store.getHomepageSettings(function(settings) {
        if (settings) {
          self.showTime = settings.showTime !== false
          self.showQuickAdd = settings.showQuickAdd !== false
          self.showStatusBar = settings.showStatusBar !== false
          self.showPinnedBar = settings.showPinnedBar !== false
          self.showDayNavZong = settings.showDayNavZong !== false
          self.showDayNavJin = settings.showDayNavJin !== false
          self.showDayNavMing = settings.showDayNavMing !== false
          self.showCustomContent = settings.showCustomContent || false
          self.customContent = settings.customContent || ""
        }
      })
    } catch (e) {}
  }
}
</script>

<style>
.schedule-page {
  flex-direction: column;
  background-color: #1a1a2e;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 8px 8px 8px 8px;
}

.debug-bar {
  width: 100%;
  padding: 2px 4px;
  margin-bottom: 2px;
}

.debug-text {
  font-size: 12px;
  text-align: center;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8px 4px;
  margin-bottom: 4px;
}

.clock-row {
  padding: 2px 0;
  margin-bottom: 2px;
}

.clock-text {
  font-size: 20px;
  text-align: center;
  width: 100%;
}

.day-title {
  font-weight: bold;
  text-align: center;
  lines: 1;
  flex: 1;
}

.nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  font-size: 22px;
  text-align: center;
  border-width: 0;
}

.day-nav-btns {
  flex-direction: row;
}

.day-nav-circle {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin-left: 4px;
}

.day-nav-text {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
}

.custom-content-bar {
  flex-direction: row;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 4px;
}

.custom-content-text {
  font-size: 18px;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.status-bar {
  flex-direction: row;
  align-items: center;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 4px;
}

.status-tag {
  font-size: 16px;
  padding: 2px 8px;
  border-radius: 4px;
  margin-right: 8px;
}

.status-middle {
  font-size: 18px;
  flex: 1;
  lines: 1;
}

.status-right {
  font-size: 16px;
}

.pinned-bar {
  flex-direction: row;
  align-items: center;
  padding: 4px 8px;
  border-radius: 8px;
  margin-bottom: 4px;
}

.pinned-content {
  flex: 1;
}

.pinned-row {
  flex-direction: row;
  flex-wrap: wrap;
}

.pinned-item {
  padding: 4px 12px;
  border-radius: 16px;
  margin-right: 6px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.pinned-text {
  font-size: 16px;
}

.class-list {
  flex-direction: column;
  margin-bottom: 4px;
}

.class-grid {
  flex-direction: column;
}

.class-grid-item {
  position: relative;
  width: 100%;
  min-height: 60px;
  border-radius: 12px;
  padding: 0;
  margin-bottom: 10px;
  flex-direction: row;
  overflow: hidden;
}

.class-card-accent {
  width: 5px;
  flex-shrink: 0;
  border-radius: 3px 0 0 3px;
}

.class-card-body {
  flex: 1;
  flex-direction: column;
  padding: 14px 16px 14px 14px;
}

.progress-bg {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  opacity: 0.12;
}

.grid-item-name {
  font-weight: bold;
  margin-bottom: 6px;
  max-lines: 2;
  text-overflow: ellipsis;
  lines: 1;
}

.class-card-meta {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.grid-item-time {
  margin-right: 14px;
  lines: 1;
  flex-shrink: 0;
}

.grid-item-location {
  lines: 1;
  flex-shrink: 0;
}

.empty-card {
  padding: 20px;
  align-items: center;
}

.empty-text {
  font-size: 18px;
}

.quick-add {
  border-radius: 10px;
  margin-bottom: 4px;
  flex-direction: column;
}

.quick-add-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  border-radius: 10px;
}

.quick-add-title {
  font-size: 16px;
  font-weight: bold;
}

.quick-add-info {
  flex-direction: row;
  align-items: center;
}

.quick-add-time {
  font-size: 12px;
  margin-right: 6px;
}

.quick-add-arrow {
  font-size: 12px;
}

.quick-add-row-scroll {
  flex-direction: column;
  padding: 0 0 8px 0;
}

.quick-add-scroll {
  height: 44px;
}

.quick-add-tags {
  flex-direction: row;
  padding: 0 8px;
}

.quick-add-tag {
  border-radius: 20px;
  padding: 8px 16px;
  margin-right: 8px;
  flex-shrink: 0;
}

.quick-add-tag-text {
  font-size: 15px;
}

.quick-add-empty {
  font-size: 13px;
  padding: 6px 12px;
  text-align: center;
}

.bottom-buttons {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 4px;
}

.add-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin-right: 4px;
}

.style-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
}

.week-indicator {
  padding: 12px 8px;
  align-items: center;
  justify-content: center;
}

.week-text {
  font-size: 16px;
  text-align: center;
}

.left-accent {
  width: 4px;
  border-radius: 2px;
  margin-right: 8px;
}

.left-accent-4 {
  height: 24px;
}

.left-accent-6 {
  height: 28px;
}

@media (shape: rect) {
  .schedule-page {
    padding: 6px 10px 6px 10px;
  }

  .header {
    padding: 6px 4px;
  }

  .class-grid-item {
    min-height: 50px;
    border-radius: 10px;
    margin-bottom: 6px;
  }

  .class-card-body {
    padding: 10px 12px 10px 10px;
  }

  .clock-text {
    font-size: 16px;
  }

  .empty-card {
    padding: 14px;
  }

  .empty-text {
    font-size: 15px;
  }

  .add-btn {
    height: 40px;
    border-radius: 20px;
    font-size: 16px;
  }

  .style-btn {
    height: 40px;
    border-radius: 20px;
    font-size: 16px;
  }

  .nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    font-size: 20px;
  }

  .day-nav-circle {
    width: 40px;
    height: 40px;
    border-radius: 20px;
  }

  .day-nav-text {
    font-size: 16px;
  }

  .pinned-item {
    padding: 3px 10px;
    border-radius: 14px;
  }

  .pinned-text {
    font-size: 14px;
  }
}
</style>