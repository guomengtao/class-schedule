<template>
  <div class="schedule-page" style="background-color: {{ theme.bg }}">
    <div class="upper-half" ontouchstart="handleUpperTouchStart" ontouchend="handleUpperTouchEnd">
      <div class="header">
        <input class="nav-btn" type="button" value="&#9664;" onclick="prevDay" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
        <text class="day-title" style="{{ dayTitleStyle }}; color: {{ theme.text }}">{{ currentDay }}</text>
        <div class="day-nav-btns">
          <div class="day-nav-circle" onclick="goToToday" style="background-color: {{ theme.cardLight }}">
            <text class="day-nav-text" style="font-size: 20px; color: {{ theme.accent }}">今</text>
          </div>
          <div class="day-nav-circle" onclick="goToTomorrow" style="background-color: {{ theme.cardLight }}">
            <text class="day-nav-text" style="font-size: 20px; color: {{ theme.accent }}">明</text>
          </div>
        </div>
        <input class="nav-btn" type="button" value="&#9654;" onclick="nextDay" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      </div>

      <div class="status-bar" if="{{ isToday }}" onclick="goToStatusDay" style="background-color: {{ theme.cardLight }}; border-left-color: {{ theme.accent }}">
        <div class="status-current" if="{{ currentClass }}">
          <text class="status-text" style="color: {{ theme.text }}" if="{{ currentClass.remaining > 0 }}">
            正在上课: {{ currentClass.name }} 还剩{{ currentClass.remaining }}分钟
          </text>
          <text class="status-text" style="color: {{ theme.text }}" if="{{ currentClass.remaining <= 0 }}">
            正在上课: {{ currentClass.name }} 即将结束
          </text>
        </div>
        <div class="status-next" if="{{ nextClass }}">
          <text class="status-text" style="color: {{ theme.text }}">下一节: {{ nextClass.waitMin }}分钟后 {{ nextClass.name }}</text>
        </div>
        <div class="status-free" if="{{ !currentClass && !nextClass && upcomingClass }}">
          <text class="status-text" style="color: {{ theme.text }}">即将: {{ upcomingClass.day }} {{ upcomingClass.name }} {{ upcomingClass.time }}</text>
        </div>
        <div class="status-free" if="{{ !currentClass && !nextClass && !upcomingClass }}">
          <text class="status-text" style="color: {{ theme.text }}">暂无课程</text>
        </div>
      </div>

      <div class="class-list">
        <div for="{{ currentClasses }}" class="class-card-wrapper">
          <div class="class-card" ontouchstart="handleCardTouchStart($event, $item.id)" ontouchend="handleCardTouchEnd($event, $item.id)" onclick="openDetail($item.id)" style="background-color: {{ theme.card }}; border-left-color: {{ theme.accent }}">
            <div class="progress-bg" style="width: {{ $item.progress }}%; background-color: {{ $item.progressColor }}"></div>
            <div class="class-content">
              <div class="class-time">
                <text class="class-name" style="{{ nameStyle }}; color: {{ theme.text }}">{{ $item.name }}</text>
                <text class="class-time-text" style="{{ nameStyle }}; color: {{ theme.textSecondary }}">{{ $item.time }}</text>
              </div>
              <div class="class-info">
                <text class="class-location" style="{{ nameStyle }}; color: {{ theme.accent }}">{{ $item.location }}</text>
                <text class="class-progress" if="{{ $item.progress >= 100 }}" style="font-size: 24px; color: {{ theme.textMuted }}">已结束</text>
                <text class="class-progress" if="{{ $item.progress > 0 && $item.progress < 100 }}" style="font-size: 24px; color: {{ theme.textMuted }}">{{ $item.progress }}%</text>
              </div>
            </div>
          </div>
          <div if="{{ swipedId === $item.id }}" class="delete-btn" onclick="deleteCourse($item.id)" style="background-color: {{ theme.deleteText }}">
            <text class="delete-btn-text">删除</text>
          </div>
        </div>

        <div if="{{ currentClasses.length === 0 }}" class="empty-card">
          <text class="empty-text" style="{{ nameStyle }}; color: {{ theme.textMuted }}">今天没有课</text>
        </div>
      </div>
    </div>

    <div class="lower-half">
      <div class="quick-add" style="background-color: {{ theme.card }}">
        <text class="quick-add-title" onclick="toggleQuickAdd" style="{{ weekTextStyle }}; color: {{ theme.accent }}">快速添加 {{ quickAddExpanded ? '▲' : '▼' }}</text>
        <scroll class="quick-add-scroll" scroll-x="{{true}}" if="{{ quickAddExpanded && quickCourseNames.length > 0 }}">
          <div class="quick-add-list">
            <div for="{{ quickCourseNames }}" class="quick-add-item" onclick="quickAddCourse($item)" style="background-color: {{ theme.cardLight }}">
              <text class="quick-add-name" style="font-size: 24px; color: {{ theme.text }}">{{ $item }}</text>
            </div>
          </div>
        </scroll>
        <text class="quick-add-empty" if="{{ quickAddExpanded && quickCourseNames.length === 0 }}" style="font-size: 20px; color: {{ theme.textMuted }}">暂无已添加课程，请先添加课程</text>
      </div>

      <div class="bottom-buttons">
        <input class="add-btn" type="button" value="+ 添加课程" onclick="openAddCoursePage" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="style-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      </div>

      <div class="week-indicator" onclick="openScheduleManager">
        <text class="week-text" style="{{ weekTextStyle }}; color: {{ theme.accent }}">⇄ {{ currentScheduleName }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

const dayNames = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]

function parseTime(timeStr) {
  var parts = timeStr.split(":")
  var hours = parseInt(parts[0]) || 0
  var minutes = parseInt(parts[1]) || 0
  return hours * 60 + minutes
}

function getRealTodayIndex() {
  var d = new Date().getDay()
  if (d >= 1 && d <= 5) return d - 1
  return 0
}

export default {
  private: {
    currentDay: "Mon",
    currentWeek: 1,
    currentScheduleName: "课程表1",
    currentDayIndex: 0,
    currentClasses: [],
    schedule: [],
    nextId: 50,
    fontScale: 1.0,
    dayTitleStyle: "",
    weekTextStyle: "",
    nameStyle: "",
    btnTextStyle: "",
    swipedId: "",
    cardTouchStartX: 0,
    cardTouchStartY: 0,
    upperTouchStartX: 0,
    upperTouchStartY: 0,
    isActive: true,
    currentClass: null,
    nextClass: null,
    upcomingClass: null,
    upcomingClassDay: "",
    statusTimer: null,
    progressTimer: null,
    _lastRemindedId: null,
    remindSettings: { enabled: true, minutes: 5 },
    theme: {},
    quickCourseNames: [],
    quickAddTime: "",
    quickAddExpanded: false,
    isToday: true,
    presetCourses: []
  },

  onInit() {
    console.log("[INDEX] onInit, currentDay=" + this.currentDay)
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.schedule = schedule
        self.loadDayClasses()
        self.updateStatus()
        self.startStatusTimer()
      })
    })
    this.currentDayIndex = getRealTodayIndex()
    this.currentDay = dayNames[this.currentDayIndex]
    store.getFontScale(function(scale) {
      self.fontScale = scale
      self.applyFontScale()
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentWeek = idx + 1
    })
    store.getRemindSettings(function(settings) {
      self.remindSettings = settings
    })
    this.applyFontScale()
  },

  onShow() {
    this.isActive = true
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getFontScale(function(scale) {
      self.fontScale = scale
      self.applyFontScale()
    })
    store.getCurrentScheduleIndex(function(idx) {
      self.currentWeek = idx + 1
      store.getScheduleNames(function(names) {
        if (names && idx < names.length) {
          self.currentScheduleName = names[idx]
        }
      })
    })
    store.getRemindSettings(function(settings) {
      self.remindSettings = settings
    })
    this.applyFontScale()
    database.getAllCourses(function(schedule) {
      self.schedule = schedule
      self.loadDayClasses()
      self.updateStatus()
      self.startStatusTimer()
    })
  },

  onHide() {
    this.isActive = false
    this.stopStatusTimer()
  },

  onDestroy() {
    this.stopStatusTimer()
  },

  applyFontScale() {
    var s = this.fontScale
    if (!s || s < 0.5) { s = 1.0 }
    this.dayTitleStyle = "font-size: " + Math.round(20 * s) + "px"
    this.weekTextStyle = "font-size: " + Math.round(20 * s) + "px"
    this.nameStyle = "font-size: " + Math.round(28 * s) + "px"
    this.btnTextStyle = "font-size: " + Math.round(14 * s) + "px"
  },

  loadDayClasses() {
    var dayData = null
    for (var i = 0; i < this.schedule.length; i++) {
      if (this.schedule[i].day === this.currentDay) {
        dayData = this.schedule[i]
        break
      }
    }
    var rawClasses = dayData ? dayData.classes : []
    var classes = []
    for (var j = 0; j < rawClasses.length; j++) {
      var src = rawClasses[j]
      classes.push({
        id: src.id,
        name: src.name,
        time: src.time,
        location: src.location,
        progress: 0,
        progressColor: "transparent"
      })
    }
    this.currentClasses = classes
    this.isToday = (this.currentDayIndex === getRealTodayIndex())
    this.updateClassProgress()
    this.updateStatus()
    this.refreshQuickAdd()
  },

  updateClassProgress() {
    var classes = this.currentClasses
    var realTodayIdx = getRealTodayIndex()
    if (this.currentDayIndex !== realTodayIdx) {
      for (var i = 0; i < classes.length; i++) {
        classes[i].progress = 0
        classes[i].progressColor = "transparent"
      }
      return
    }
    var now = new Date()
    var nowMinutes = now.getHours() * 60 + now.getMinutes()
    var theme = this.theme
    var ongoing = theme.progressOngoing || "rgba(126,200,227,0.2)"
    var done = theme.progressDone || "rgba(74,138,154,0.25)"
    for (var i = 0; i < classes.length; i++) {
      var course = classes[i]
      var parts = course.time.split("-")
      if (parts.length < 2) {
        course.progress = 0
        course.progressColor = "transparent"
        continue
      }
      var startMin = parseTime(parts[0].trim())
      var endMin = parseTime(parts[1].trim())
      if (nowMinutes < startMin) {
        course.progress = 0
        course.progressColor = "transparent"
      } else if (nowMinutes >= endMin) {
        course.progress = 100
        course.progressColor = done
      } else {
        var total = endMin - startMin
        var elapsed = nowMinutes - startMin
        course.progress = Math.round((elapsed / total) * 100)
        course.progressColor = ongoing
      }
    }
  },

  prevDay() {
    if (this.currentDayIndex > 0) {
      this.currentDayIndex--
    } else {
      this.currentDayIndex = dayNames.length - 1
    }
    this.currentDay = dayNames[this.currentDayIndex]
    this.loadDayClasses()
  },

  nextDay() {
    if (this.currentDayIndex < dayNames.length - 1) {
      this.currentDayIndex++
    } else {
      this.currentDayIndex = 0
    }
    this.currentDay = dayNames[this.currentDayIndex]
    this.loadDayClasses()
  },

  goToToday() {
    var todayIdx = getRealTodayIndex()
    if (this.currentDayIndex === todayIdx) return
    this.currentDayIndex = todayIdx
    this.currentDay = dayNames[todayIdx]
    this.loadDayClasses()
  },

  goToTomorrow() {
    var todayIdx = getRealTodayIndex()
    var tomorrowIdx = todayIdx + 1
    if (tomorrowIdx >= dayNames.length) tomorrowIdx = 0
    if (this.currentDayIndex === tomorrowIdx) return
    this.currentDayIndex = tomorrowIdx
    this.currentDay = dayNames[tomorrowIdx]
    this.loadDayClasses()
  },

  handleUpperTouchStart(e) {
    if (!this.isActive || !e || !e.touches || e.touches.length === 0) return
    this.upperTouchStartX = e.touches[0].clientX
    this.upperTouchStartY = e.touches[0].clientY
  },

  handleUpperTouchEnd(e) {
    if (!this.isActive || !e || !e.changedTouches || e.changedTouches.length === 0) return
    var endX = e.changedTouches[0].clientX
    var endY = e.changedTouches[0].clientY
    var dx = endX - this.upperTouchStartX
    var dy = endY - this.upperTouchStartY
    var absDx = dx < 0 ? -dx : dx
    var absDy = dy < 0 ? -dy : dy
    if (absDx > 60 && absDx > absDy * 1.5) {
      if (dx > 0) {
        this.prevDay()
      } else {
        this.nextDay()
      }
    }
  },

  goToStatusDay() {
    if (this.upcomingClass && this.upcomingClassDay) {
      this.currentDay = this.upcomingClassDay
      for (var i = 0; i < dayNames.length; i++) {
        if (dayNames[i] === this.upcomingClassDay) {
          this.currentDayIndex = i
          break
        }
      }
      this.loadDayClasses()
      return
    }
    var todayIdx = getRealTodayIndex()
    this.currentDayIndex = todayIdx
    this.currentDay = dayNames[todayIdx]
    this.loadDayClasses()
  },

  playVibration(style) {
    try {
      switch (style) {
        case "single_short":
          vibrator.vibrate({ mode: "short" })
          break
        case "single_long":
          vibrator.vibrate({ mode: "long" })
          break
        case "double_short":
          vibrator.vibrate({ mode: "short" })
          setTimeout(function() { vibrator.vibrate({ mode: "short" }) }, 250)
          break
        case "short_long":
          vibrator.vibrate({ mode: "short" })
          setTimeout(function() { vibrator.vibrate({ mode: "long" }) }, 300)
          break
        case "long_short_long":
          vibrator.vibrate({ mode: "long" })
          setTimeout(function() { vibrator.vibrate({ mode: "short" }) }, 350)
          setTimeout(function() { vibrator.vibrate({ mode: "long" }) }, 600)
          break
        case "triple_short":
          vibrator.vibrate({ mode: "short" })
          setTimeout(function() { vibrator.vibrate({ mode: "short" }) }, 200)
          setTimeout(function() { vibrator.vibrate({ mode: "short" }) }, 400)
          break
        default:
          vibrator.vibrate({ mode: "short" })
      }
    } catch (e) {
      console.log("[INDEX] vibration error: " + e)
    }
  },

  openDetail(classId) {
    var storage = require("@system.storage")
    storage.set({ key: "detail_classId", value: String(classId) })
    storage.set({ key: "detail_day", value: this.currentDay })
    router.push({ uri: "/pages/detail" })
  },

  openAddCoursePage() {
    var storage = require("@system.storage")
    storage.set({ key: "add_course_day", value: this.currentDay })
    storage.set({ key: "add_course_nextId", value: String(this.nextId) })
    router.push({ uri: "/pages/add-course" })
  },

  openSettings() {
    router.push({ uri: "/pages/settings" })
  },

  openScheduleManager() {
    router.push({ uri: "/pages/schedule-manager" })
  },

  makeCourse(name, time, teacher, location) {
    var self = this
    var newCourse = {
      id: String(this.nextId),
      day: this.currentDay,
      name: name,
      time: time,
      teacher: teacher,
      location: location,
      notes: ""
    }
    this.nextId++
    database.insertCourse(newCourse, function() {
      database.getAllCourses(function(schedule) {
        self.schedule = schedule
        self.loadDayClasses()
      })
    })
  },

  quickAddCourse(name) {
    var teacher = ""
    var location = ""
    for (var i = 0; i < this.presetCourses.length; i++) {
      if (this.presetCourses[i].name === name) {
        teacher = this.presetCourses[i].teacher || ""
        location = this.presetCourses[i].location || ""
        break
      }
    }
    this.makeCourse(name, this.quickAddTime, teacher, location)
  },

  toggleQuickAdd() {
    this.quickAddExpanded = !this.quickAddExpanded
    if (this.quickAddExpanded) {
      this.refreshQuickAdd()
    }
  },

  refreshQuickAdd() {
    this.loadPresetCourses()
    this.quickAddTime = this.calcNextTimeSlot()
  },

  loadPresetCourses() {
    var self = this
    var storage = require("@system.storage")
    var COURSE_KEY = "course_preset_list"
    try {
      storage.get({
        key: COURSE_KEY,
        success: function(data) {
          if (data) {
            try {
              var list = JSON.parse(data)
              if (list && list.length > 0) {
                self.presetCourses = list
              } else {
                self.presetCourses = []
              }
            } catch (e) {
              self.presetCourses = []
            }
          } else {
            self.presetCourses = []
          }
          var names = []
          for (var i = 0; i < self.presetCourses.length; i++) {
            names.push(self.presetCourses[i].name)
          }
          self.quickCourseNames = names
        },
        fail: function() {
          self.presetCourses = []
          self.quickCourseNames = []
        }
      })
    } catch (e) {
      self.presetCourses = []
      self.quickCourseNames = []
    }
  },

  calcNextTimeSlot() {
    var now = new Date()
    var nowMinutes = now.getHours() * 60 + now.getMinutes()
    var dayClasses = this.currentClasses
    var lastEndMin = 0
    for (var i = 0; i < dayClasses.length; i++) {
      var parts = dayClasses[i].time.split("-")
      if (parts.length < 2) continue
      var endMin = parseTime(parts[1].trim())
      if (endMin > lastEndMin) {
        lastEndMin = endMin
      }
    }
    var startMin
    if (lastEndMin > 0) {
      startMin = lastEndMin + 10
    } else {
      startMin = 8 * 60
    }
    if (startMin < nowMinutes) {
      startMin = nowMinutes + 5
    }
    var endMin = startMin + 45
    return this.formatTime(startMin) + " - " + this.formatTime(endMin)
  },

  formatTime(minutes) {
    var h = Math.floor(minutes / 60)
    var m = minutes % 60
    return (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m
  },

  handleCardTouchStart(e) {
    if (!this.isActive || !e || !e.touches || e.touches.length === 0) return
    this.cardTouchStartX = e.touches[0].clientX
    this.cardTouchStartY = e.touches[0].clientY
  },

  handleCardTouchEnd(e, id) {
    if (!this.isActive || !e || !e.changedTouches || e.changedTouches.length === 0) return
    var endX = e.changedTouches[0].clientX
    var endY = e.changedTouches[0].clientY
    var dx = endX - this.cardTouchStartX
    var dy = endY - this.cardTouchStartY
    var absDx = dx < 0 ? -dx : dx
    var absDy = dy < 0 ? -dy : dy
    if (absDx > 30 && absDx > absDy) {
      if (dx < 0) {
        this.swipedId = id
      } else {
        this.swipedId = ""
      }
    } else {
      this.swipedId = ""
    }
  },

  deleteCourse(id) {
    var self = this
    var day = this.currentDay
    database.deleteCourse(id, day, function() {
      self.swipedId = ""
      database.getAllCourses(function(schedule) {
        self.schedule = schedule
        self.loadDayClasses()
      })
    })
  },

  startStatusTimer() {
    this.stopStatusTimer()
    var self = this
    this.statusTimer = setInterval(function() {
      self.updateStatus()
    }, 60000)
    this.progressTimer = setInterval(function() {
      self.updateClassProgress()
    }, 30000)
  },

  stopStatusTimer() {
    if (this.statusTimer) {
      clearInterval(this.statusTimer)
      this.statusTimer = null
    }
    if (this.progressTimer) {
      clearInterval(this.progressTimer)
      this.progressTimer = null
    }
  },

  updateStatus() {
    this.currentClass = null
    this.nextClass = null
    this.upcomingClass = null
    this.upcomingClassDay = ""

    var now = new Date()
    var nowMinutes = now.getHours() * 60 + now.getMinutes()
    var realTodayIdx = getRealTodayIndex()

    if (this.currentDayIndex === realTodayIdx) {
      this.computeTodayStatus(nowMinutes)
    }

    if (!this.currentClass && !this.nextClass) {
      this.findUpcomingClass(realTodayIdx)
    }
  },

  computeTodayStatus(nowMinutes) {
    var todayClasses = this.currentClasses
    if (!todayClasses || todayClasses.length === 0) return

    var parsed = []
    for (var i = 0; i < todayClasses.length; i++) {
      var cls = todayClasses[i]
      var timeParts = cls.time.split("-")
      if (timeParts.length < 2) continue
      var startMin = parseTime(timeParts[0].trim())
      var endMin = parseTime(timeParts[1].trim())
      parsed.push({
        id: cls.id,
        name: cls.name,
        startMin: startMin,
        endMin: endMin,
        startTime: timeParts[0].trim()
      })
    }

    parsed.sort(function(a, b) { return a.startMin - b.startMin })

    var current = null
    var next = null

    for (var i = 0; i < parsed.length; i++) {
      var cls = parsed[i]
      if (nowMinutes >= cls.startMin && nowMinutes <= cls.endMin) {
        current = {
          name: cls.name,
          remaining: Math.round((cls.endMin - nowMinutes) * 10) / 10,
          id: cls.id
        }
        if (i + 1 < parsed.length) {
          var nxt = parsed[i + 1]
          next = {
            name: nxt.name,
            startTime: nxt.startTime,
            waitMin: Math.round((nxt.startMin - nowMinutes) * 10) / 10,
            id: nxt.id
          }
        }
        break
      }
      if (nowMinutes < cls.startMin && (!next || cls.startMin < next.startMin)) {
        next = {
          name: cls.name,
          startTime: cls.startTime,
          waitMin: Math.round((cls.startMin - nowMinutes) * 10) / 10,
          id: cls.id
        }
      }
    }

    this.currentClass = current
    this.nextClass = next

    if (next && this.remindSettings.enabled) {
      var remindMinutes = this.remindSettings.minutes || 5
      if (next.waitMin <= remindMinutes && next.waitMin > 0) {
        var remindKey = next.id + "_" + this.currentDay
        if (this._lastRemindedId !== remindKey) {
          this._lastRemindedId = remindKey
          var self = this
          store.getVibrationStyle(function(style) {
            self.playVibration(style)
          })
        }
      }
    }
  },

  findUpcomingClass(realTodayIdx) {
    if (!this.schedule || this.schedule.length === 0) return

    var now = new Date()
    var nowMinutes = now.getHours() * 60 + now.getMinutes()

    for (var offset = 0; offset < 7; offset++) {
      var checkIdx = (realTodayIdx + offset) % 7
      var checkDay = dayNames[checkIdx]

      var dayData = null
      for (var d = 0; d < this.schedule.length; d++) {
        if (this.schedule[d].day === checkDay) { dayData = this.schedule[d]; break }
      }
      if (!dayData || !dayData.classes || dayData.classes.length === 0) continue

      var parsed = []
      for (var i = 0; i < dayData.classes.length; i++) {
        var cls = dayData.classes[i]
        var timeParts = cls.time.split("-")
        if (timeParts.length < 2) continue
        var startTimeStr = timeParts[0].trim()
        var endTimeStr = timeParts[1].trim()
        parsed.push({
          name: cls.name,
          time: cls.time,
          startTime: startTimeStr,
          endTime: endTimeStr,
          startMin: parseTime(startTimeStr),
          endMin: parseTime(endTimeStr),
          id: cls.id
        })
      }
      parsed.sort(function(a, b) { return a.startMin - b.startMin })

      if (offset === 0) {
        for (var j = 0; j < parsed.length; j++) {
          if (parsed[j].endMin > nowMinutes) {
            if (nowMinutes >= parsed[j].startMin) {
              this.currentClass = {
                name: parsed[j].name,
                remaining: Math.round((parsed[j].endMin - nowMinutes) * 10) / 10,
                id: parsed[j].id
              }
              if (j + 1 < parsed.length) {
                this.nextClass = {
                  name: parsed[j + 1].name,
                  startTime: parsed[j + 1].startTime,
                  waitMin: Math.round((parsed[j + 1].startMin - nowMinutes) * 10) / 10,
                  id: parsed[j + 1].id
                }
              }
              return
            }
            this.nextClass = {
              name: parsed[j].name,
              startTime: parsed[j].startTime,
              waitMin: Math.round((parsed[j].startMin - nowMinutes) * 10) / 10,
              id: parsed[j].id
            }
            return
          }
        }
        continue
      }

      if (parsed.length > 0) {
        this.upcomingClass = {
          day: checkDay,
          name: parsed[0].name,
          time: parsed[0].time,
          startTime: parsed[0].startTime
        }
        this.upcomingClassDay = checkDay
        return
      }
    }
  }
}
</script>

