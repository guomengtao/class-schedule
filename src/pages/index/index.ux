<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  goToWeekView() {
    router.push({ uri: "/pages/week-view" })
  },

  openAddCoursePage() {
    router.push({ uri: "/pages/add-course" })
  },

  openSettings() {
    router.push({ uri: "/pages/settings" })
  },

  openScheduleManager() {
    router.push({ uri: "/pages/schedule-manager" })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  openHomepageSettings() {
    router.push({ uri: "/pages/homepage-settings" })
  },

  goToStatistics() {
    router.push({ uri: "/pages/statistics" })
  },

  goToBackupRestore() {
    router.push({ uri: "/pages/backup-restore" })
  },

  goToScheduleQrcode() {
    router.push({ uri: "/pages/schedule-qrcode" })
  },

  goToActivation() {
    router.push({ uri: "/pages/activation" })
  }
}
</script>

