<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">Anim Test</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="body">
      <text class="tip" style="color: {{ theme.textMuted }}">only one simplest spinner</text>
      <div class="spinner" style="border-color: {{ theme.borderLight }}; border-top-color: {{ theme.accent }}"></div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
const store = require('../../data/store.js')

export default {
  private: {
    iconTheme: 'dark',
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textMuted: '#555566',
      borderLight: '#2a2a5a'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 8px 4px 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  lines: 1;
  text-overflow: ellipsis;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.body {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.tip {
  font-size: 26px;
  margin-bottom: 30px;
}

.spinner {
  width: 64px;
  height: 64px;
  border-width: 4px;
  border-radius: 8px;
  animation-name: kf-spin;
  animation-duration: 1s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes kf-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
