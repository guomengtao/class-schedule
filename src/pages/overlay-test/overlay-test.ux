<import name="premium-overlay" src="../../components/premium-overlay"></import>
<template>
  <stack class="page-root">
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">遮罩弹窗测试</text>
    </div>

    <text class="desc" style="color: {{ theme.textSecondary }}">点击按钮直接弹出遮罩，不验证账号身份</text>

    <input class="show-btn" type="button" value="弹出遮罩" onclick="doShow"
           style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

    <premium-overlay></premium-overlay>
  </div>
  </stack>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var premiumOverlay = require("../../data/premium-overlay.js")

export default {
  private: {
    theme: store.DEFAULT_THEME
  },

  onInit() {
    console.log("[OVERLAY-TEST] onInit: page created")
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onReady() {
    console.log("[OVERLAY-TEST] onReady: all components ready")
    console.log("[OVERLAY-TEST] overlay module loaded, call premiumOverlay.show() to test")
  },

  doShow() {
    console.log("[OVERLAY-TEST] ===== doShow: directly calling premiumOverlay.show() =====")
    premiumOverlay.show()
    console.log("[OVERLAY-TEST] show() called, check console for [PREMIUM] and [PREMIUM-UI] logs")
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page-root {
  width: 100%;
  height: 100%;
}

.page {
  flex: 1;
  flex-direction: column;
  padding: 44px 12px 12px 12px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
}

.back-btn {
  width: 64px;
  height: 30px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
}

.desc {
  text-align: center;
  font-size: 12px;
  margin-bottom: 16px;
}

.show-btn {
  width: 100%;
  height: 44px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}

@media (shape: circle) {
  .page {
    padding: 44px 24px 24px 24px;
  }
}
</style>