<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: store.DEFAULT_THEME,
    showDialog: false
  },

  onInit() {
    console.log("[OVERLAY-TEST] onInit: page created")
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onReady() {
    console.log("[OVERLAY-TEST] onReady: all components ready, inline overlay from overlay-demo scheme 1")
  },

  doShow() {
    console.log("[OVERLAY-TEST] showDialog = true")
    this.showDialog = true
  },

  hideOverlay() {
    console.log("[OVERLAY-TEST] showDialog = false")
    this.showDialog = false
  },

  stopBubble() {
  },

  goBack() {
    router.back()
  }
}
</script>

