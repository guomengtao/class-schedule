function buildIconList(rawIcons) {
  var result = []
  for (var i = 0; i < rawIcons.length; i++) {
    result.push([rawIcons[i][0], rawIcons[i][1], rawIcons[i][2], false])
  }
  return result
}

export default {
  private: {
    theme: {},
    checkedBg: "#2a3a2a",
    checkedBorder: "#4caf50",
    allIcons: [],
    checkedIcons: [],
    uncheckedIcons: [],
    checkedCount: 0,
    totalCount: 0
  },

  onInit() {
    var icons = buildIconList(ALL_ICONS)
    this.allIcons = icons
    this.uncheckedIcons = icons
    this.totalCount = icons.length
    this.checkedCount = 0
  },

  toggleIcon(code) {
    var allIcons = this.allIcons
    for (var i = 0; i < allIcons.length; i++) {
      if (allIcons[i][2] === code) {
        allIcons[i][3] = !allIcons[i][3]
        break
      }
    }
    this.allIcons = allIcons
    this.rebuildLists()
  },

  rebuildLists() {
    var checked = []
    var unchecked = []
    var allIcons = this.allIcons
    for (var i = 0; i < allIcons.length; i++) {
      if (allIcons[i][3]) {
        checked.push(allIcons[i])
      } else {
        unchecked.push(allIcons[i])
      }
    }
    this.checkedIcons = checked
    this.uncheckedIcons = unchecked
    this.checkedCount = checked.length
  },

  confirmSelection() {
    var checked = this.checkedIcons
    var msg = ""
    for (var i = 0; i < checked.length; i++) {
      msg += checked[i][1] + " (U+" + checked[i][2] + ")"
      if (i < checked.length - 1) {
        msg += ", "
      }
    }
    console.log("[icon-collection] confirmed: " + msg)
  },

  goBack() {
    router.back()
  }
}
</script>

