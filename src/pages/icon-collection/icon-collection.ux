<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">Icon 收集</text>
    </div>

    <text class="hint" style="color: {{ theme.textSecondary }}">点击图标标记为可访问，真机实测后勾选</text>

    <div class="tabs" style="background-color: {{ theme.card }}">
      <div for="cat in catNames" class="tab {{ activeIdx === $idx ? 'tab-active' : '' }}"
           onclick="switchCat($idx)"
           style="background-color: {{ activeIdx === $idx ? theme.accent : theme.cardLight }}">
        <text class="tab-text" style="color: {{ activeIdx === $idx ? theme.bg : theme.textSecondary }}; font-size: 10px;">{{ cat }}</text>
      </div>
    </div>

    <div class="icon-grid">
      <div for="icon in currentIcons" class="icon-card {{ icon[3] ? 'checked' : '' }}"
           onclick="toggleIcon(icon[2])"
           style="background-color: {{ icon[3] ? checkedBg : theme.card }}; border-color: {{ icon[3] ? checkedBorder : 'transparent' }}">
        <text class="icon-glyph" style="color: {{ theme.accent }}; font-size: 28px;">{{ icon[0] }}</text>
        <text class="icon-name" style="color: {{ theme.text }}; font-size: 9px;">{{ icon[1] }}</text>
        <text class="icon-code" style="color: {{ theme.textMuted }}; font-size: 8px;">U+{{ icon[2] }}</text>
        <text class="icon-check" style="color: {{ theme.accent }}; font-size: 10px;">{{ icon[3] ? '✓' : '' }}</text>
      </div>
    </div>

    <div class="bottom-bar" style="background-color: {{ theme.card }}">
      <text class="info-text" style="color: {{ theme.textSecondary }}; font-size: 10px;">
        已确认 {{ checkedCount }} / {{ totalCount }}
      </text>
      <input class="confirm-btn" type="button" value="全部确认" onclick="checkAll"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}; font-size: 12px;" />
      <input class="confirm-btn" type="button" value="全部取消" onclick="uncheckAll"
             style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}; font-size: 12px;" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var catNames = ["三角形", "箭头", "几何形状", "常用符号", "数学符号", "标点杂项", "方块元素", "数字圈"]

var allIcons = [
  [
    ["▲","上三角实心","25B2"],["△","上三角空心","25B3"],["▴","上小三角实心","25B4"],["▵","上小三角空心","25B5"],
    ["▼","下三角实心","25BC"],["▽","下三角空心","25BD"],["▾","下小三角实心","25BE"],["▿","下小三角空心","25BF"],
    ["◀","左三角实心","25C0"],["◁","左三角空心","25C1"],["◂","左小三角实心","25C2"],["◃","左小三角空心","25C3"],
    ["▶","右三角实心","25B6"],["▷","右三角空心","25B7"],["▸","右小三角实心","25B8"],["▹","右小三角空心","25B9"],
    ["◢","左下三角","25E2"],["◣","右下三角","25E3"],["◤","左上三角","25E4"],["◥","右上三角","25E5"]
  ],
  [
    ["←","左箭头","2190"],["→","右箭头","2192"],["↑","上箭头","2191"],["↓","下箭头","2193"],
    ["↔","左右箭头","2194"],["↕","上下箭头","2195"],["↖","左上箭头","2196"],["↗","右上箭头","2197"],
    ["↘","右下箭头","2198"],["↙","左下箭头","2199"],["⇐","双左箭头","21D0"],["⇒","双右箭头","21D2"],
    ["⇑","双上箭头","21D1"],["⇓","双下箭头","21D3"],["↩","左弯箭头","21A9"],["↪","右弯箭头","21AA"],
    ["↶","逆时针半圆","21B6"],["↷","顺时针半圆","21B7"],["↵","回车箭头","21B5"],["⇄","左右双箭","21C4"]
  ],
  [
    ["■","方框实心","25A0"],["□","方框空心","25A1"],["▪","小方框实心","25AA"],["▫","小方框空心","25AB"],
    ["▬","横矩形","25AC"],["▭","横矩形空心","25AD"],["▮","竖矩形","25AE"],["▯","竖矩形空心","25AF"],
    ["●","圆实心","25CF"],["○","圆空心","25CB"],["◉","靶心圆","25C9"],["◎","双圆","25CE"],
    ["◐","左半圆","25D0"],["◑","右半圆","25D1"],["◒","下半圆","25D2"],["◓","上半圆","25D3"],
    ["◆","菱形实心","25C6"],["◇","菱形空心","25C7"],["◈","菱形内嵌","25C8"],["⬟","五边形","2B1F"]
  ],
  [
    ["✓","对勾","2713"],["✔","粗对勾","2714"],["✗","叉号","2717"],["✘","粗叉号","2718"],
    ["★","星实心","2605"],["☆","星空心","2606"],["♥","红心","2665"],["♦","方块","2666"],
    ["♣","梅花","2663"],["♠","黑桃","2660"],["♂","男性符号","2642"],["♀","女性符号","2640"],
    ["♪","八分音符","266A"],["♫","双八分音符","266B"],["☀","太阳","2600"],["☁","云","2601"],
    ["☂","伞","2602"],["☃","雪人","2603"],["☎","电话","260E"],["☏","电话空心","260F"]
  ],
  [
    ["∞","无穷","221E"],["≈","约等于","2248"],["≠","不等于","2260"],["≤","小于等于","2264"],
    ["≥","大于等于","2265"],["±","正负号","00B1"],["×","乘号","00D7"],["÷","除号","00F7"],
    ["°","度","00B0"],["√","根号","221A"],["∑","求和","2211"],["∏","求积","220F"],
    ["∫","积分","222B"],["∂","偏微分","2202"],["∆","增量","2206"],["∝","正比于","221D"],
    ["∠","角","2220"],["⊥","垂直","22A5"],["∥","平行","2225"],["‰","千分号","2030"]
  ],
  [
    ["•","圆点","2022"],["‣","三角点","2023"],["…","省略号","2026"],["†","剑号","2020"],
    ["‡","双剑号","2021"],["‽","疑问感叹号","203D"],["※","米字参考","203B"],["§","章节号","00A7"],
    ["¶","段落号","00B6"],["©","版权","00A9"],["®","注册商标","00AE"],["™","商标","2122"],
    ["№","编号","2116"],["℡","电话符号","2121"],["℗","录音版权","2117"],["←","左箭","2190"],
    ["↑","上箭","2191"],["→","右箭","2192"],["↓","下箭","2193"],["↲","下左弯箭","21B2"]
  ],
  [
    ["▁","下八分块","2581"],["▂","下四分块","2582"],["▃","下三八分块","2583"],["▄","下半块","2584"],
    ["▅","下五八分块","2585"],["▆","下六八分块","2586"],["▇","下七八分块","2587"],["█","全块","2588"],
    ["▉","左七八块","2589"],["▊","左六八块","258A"],["▋","左五八块","258B"],["▌","左半块","258C"],
    ["▍","左三八块","258D"],["▎","左四分块","258E"],["▏","左八分块","258F"],["▐","右半块","2590"],
    ["░","浅色","2591"],["▒","中色","2592"],["▓","深色","2593"],["▔","上八分块","2594"]
  ],
  [
    ["①","圈1","2460"],["②","圈2","2461"],["③","圈3","2462"],["④","圈4","2463"],
    ["⑤","圈5","2464"],["⑥","圈6","2465"],["⑦","圈7","2466"],["⑧","圈8","2467"],
    ["⑨","圈9","2468"],["⑩","圈10","2469"],["❶","黑圈1","2776"],["❷","黑圈2","2777"],
    ["❸","黑圈3","2778"],["❹","黑圈4","2779"],["❺","黑圈5","277A"],["❻","黑圈6","277B"],
    ["❼","黑圈7","277C"],["❽","黑圈8","277D"],["❾","黑圈9","277E"],["❿","黑圈10","277F"]
  ]
]

function buildIconList(rawIcons) {
  var result = []
  for (var i = 0; i < rawIcons.length; i++) {
    result.push([rawIcons[i][0], rawIcons[i][1], rawIcons[i][2], false])
  }
  return result
}

export default {
  private: {
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460"
    },
    checkedBg: "#0d3320",
    checkedBorder: "#2ecc71",
    catNames: catNames,
    activeIdx: 0,
    currentIcons: [],
    totalCount: 0,
    checkedCount: 0
  },

  onInit() {
    var self = this
    var total = 0
    for (var i = 0; i < allIcons.length; i++) {
      total += allIcons[i].length
    }
    this.totalCount = total
    this.currentIcons = buildIconList(allIcons[0])
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  toggleIcon(code) {
    var icons = this.currentIcons
    for (var i = 0; i < icons.length; i++) {
      if (icons[i][2] === code) {
        icons[i][3] = !icons[i][3]
        break
      }
    }
    this.currentIcons = icons
    this.updateCheckedCount()
  },

  updateCheckedCount() {
    var icons = this.currentIcons
    var count = 0
    for (var i = 0; i < icons.length; i++) {
      if (icons[i][3]) {
        count++
      }
    }
    this.checkedCount = count
  },

  checkAll() {
    var icons = this.currentIcons
    for (var i = 0; i < icons.length; i++) {
      icons[i][3] = true
    }
    this.currentIcons = icons
    this.checkedCount = icons.length
  },

  uncheckAll() {
    var icons = this.currentIcons
    for (var i = 0; i < icons.length; i++) {
      icons[i][3] = false
    }
    this.currentIcons = icons
    this.checkedCount = 0
  },

  switchCat(idx) {
    this.activeIdx = idx
    this.currentIcons = buildIconList(allIcons[idx])
    this.checkedCount = 0
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.hint {
  font-size: 10px;
  margin-bottom: 6px;
  padding: 0 4px;
  text-align: center;
}

.tabs {
  flex-direction: row;
  flex-wrap: wrap;
  border-radius: 8px;
  padding: 4px;
  margin-bottom: 6px;
}

.tab {
  padding: 4px 8px;
  border-radius: 6px;
  margin: 2px;
}

.tab-text {
  font-weight: bold;
}

.icon-grid {
  flex: 1;
  flex-direction: row;
  flex-wrap: wrap;
  overflow: scroll;
}

.icon-card {
  width: 22%;
  flex-direction: column;
  align-items: center;
  border-radius: 8px;
  border-width: 2px;
  border-style: solid;
  padding: 6px 3px;
  margin: 1.5%;
}

.icon-card.checked {
  border-width: 2px;
}

.icon-glyph {
  text-align: center;
  margin-bottom: 2px;
}

.icon-name {
  text-align: center;
  margin-bottom: 1px;
}

.icon-code {
  text-align: center;
}

.icon-check {
  text-align: center;
  margin-top: 2px;
}

.bottom-bar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 8px;
  padding: 8px;
  margin-top: 4px;
}

.info-text {
  flex: 1;
  text-align: left;
}

.confirm-btn {
  width: 80px;
  height: 34px;
  border-radius: 8px;
  text-align: center;
  margin-left: 6px;
}
</style>