<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">Demo5: 条件渲染</text>
    </div>

    <text class="info" style="color: {{ theme.accent }}">测试: Vela固件条件渲染不重绘bug</text>
    <text class="desc" style="color: {{ theme.textSecondary }}">此页有 show 切换，但 onShow 不调用 $forceUpdate()</text>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.text }}">条件渲染测试</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">点击下方按钮切换内容区域显示</text>
      <text class="card-text" style="color: {{ theme.textMuted }}">如果切换后布局异常 → Vela条件渲染bug</text>
    </div>

    <div class="toggle-row">
      <text class="toggle-label" style="color: {{ theme.text }}">显示内容A</text>
      <input class="toggle-btn" type="button" value="{{ showContentA ? '开' : '关' }}" onclick="toggleA"
             style="background-color: {{ showContentA ? theme.accent : theme.border }}; color: {{ showContentA ? theme.bg : theme.textSecondary }}" />
    </div>

    <div class="toggle-row">
      <text class="toggle-label" style="color: {{ theme.text }}">显示内容B</text>
      <input class="toggle-btn" type="button" value="{{ showContentB ? '开' : '关' }}" onclick="toggleB"
             style="background-color: {{ showContentB ? theme.accent : theme.border }}; color: {{ showContentB ? theme.bg : theme.textSecondary }}" />
    </div>

    <div class="content-card" show="{{ showContentA }}" style="background-color: {{ theme.cardLight }}">
      <text class="card-title" style="color: {{ theme.text }}">内容区域 A</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">A区域已显示</text>
      <text class="card-text" style="color: {{ theme.textMuted }}">应该在B区域上方</text>
    </div>

    <div class="content-card" show="{{ showContentB }}" style="background-color: {{ theme.cardLight }}">
      <text class="card-title" style="color: {{ theme.text }}">内容区域 B</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">B区域已显示</text>
      <text class="card-text" style="color: {{ theme.textMuted }}">应该在A区域下方</text>
    </div>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.accent }}">底部标记</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">能看到这行 → 条件渲染正常</text>
      <text class="card-text" style="color: {{ theme.textMuted }}">onShow: 未调用 $forceUpdate()</text>
    </div>

    <div class="nav-bar" style="background-color: {{ theme.card }}">
      <input class="nav-btn" type="button" value="‹ 上一项" onclick="goPrev"
             style="background-color: {{ theme.border }}; color: {{ theme.textSecondary }}" />
      <text class="nav-page" style="color: {{ theme.textMuted }}">5 / 5</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    showContentA: true,
    showContentB: true,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  toggleA() {
    this.showContentA = !this.showContentA
  },

  toggleB() {
    this.showContentB = !this.showContentB
  },

  goBack() {
    router.back()
  },

  goPrev() {
    router.push({ uri: "/pages/bs-demo4" })
  }
}
</script>

