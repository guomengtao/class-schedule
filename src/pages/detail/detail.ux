<template>
  <div class="detail-page">
    <div class="back-header">
      <input class="back-btn" type="button" value="Back" onclick="goBack" />
      <text class="header-title" style="{{ titleStyle }}">Edit Course</text>
    </div>

    <div class="detail-content" if="{{ classDetail }}">
      <div class="delete-top-section">
        <input class="form-btn delete-btn" type="button" value="Delete This Course" onclick="deleteCourse" />
      </div>

      <div class="form-section">
        <text class="info-label" style="{{ labelStyle }}">Course Name</text>
        <input class="field-input" type="text" value="{{ editName }}" onchange="onNameChange" />

        <text class="info-label" style="{{ labelStyle }}">Time</text>
        <input class="field-input" type="text" value="{{ editTime }}" onchange="onTimeChange" />

        <text class="info-label" style="{{ labelStyle }}">Teacher</text>
        <input class="field-input" type="text" value="{{ editTeacher }}" onchange="onTeacherChange" />

        <text class="info-label" style="{{ labelStyle }}">Location</text>
        <input class="field-input" type="text" value="{{ editLocation }}" onchange="onLocationChange" />

        <text class="info-label" style="{{ labelStyle }}">Notes</text>
        <input class="field-input" type="text" value="{{ editNotes }}" onchange="onNotesChange" />
      </div>

      <div class="button-group">
        <input class="form-btn save-btn" type="button" value="Save" onclick="saveCourse" />
      </div>
    </div>

    <div class="not-found" if="{{ !classDetail }}">
      <text class="not-found-text" style="{{ labelStyle }}">Course not found</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")
const database = require("../../data/database.js")

export default {
  private: {
    classDetail: null,
    day: "",
    classId: "",
    editName: "",
    editTime: "",
    editTeacher: "",
    editLocation: "",
    editNotes: "",
    fontScale: 1.0,
    titleStyle: "",
    labelStyle: ""
  },

  onInit() {
    console.log("[DETAIL] onInit: page loaded")
    var self = this
    store.getFontScale(function(scale) {
      self.applyFontScale(scale)
    })
    this.applyFontScale(1.0)

    storage.get({
      key: "detail_classId",
      success: function(data) {
        self.classId = data || ""
        console.log("[DETAIL] onInit: classId from storage=" + self.classId)
        self.tryLoadCourse()
      },
      fail: function() {
        console.log("[DETAIL] onInit: failed to read classId from storage")
        self.classId = ""
        self.tryLoadCourse()
      }
    })
    storage.get({
      key: "detail_day",
      success: function(data) {
        self.day = data || ""
        console.log("[DETAIL] onInit: day from storage=" + self.day)
        self.tryLoadCourse()
      },
      fail: function() {
        console.log("[DETAIL] onInit: failed to read day from storage")
        self.day = ""
        self.tryLoadCourse()
      }
    })
  },

  tryLoadCourse() {
    if (!this.classId || !this.day) {
      return
    }
    if (this._loaded) {
      return
    }
    this._loaded = true
    console.log("[DETAIL] tryLoadCourse: classId=" + this.classId + ", day=" + this.day)
    var self = this
    database.getAllCourses(function(schedule) {
      console.log("[DETAIL] tryLoadCourse: schedule has " + schedule.length + " days")
      var dayData = null
      for (var d = 0; d < schedule.length; d++) {
        if (schedule[d].day === self.day) {
          dayData = schedule[d]
          break
        }
      }
      if (dayData) {
        console.log("[DETAIL] tryLoadCourse: found day=" + self.day + " with " + dayData.classes.length + " classes")
        var found = null
        for (var c = 0; c < dayData.classes.length; c++) {
          if (dayData.classes[c].id === self.classId) {
            found = dayData.classes[c]
            break
          }
        }
        self.classDetail = found
        if (self.classDetail) {
          console.log("[DETAIL] tryLoadCourse: course found: " + self.classDetail.name + " (" + self.classDetail.id + ")")
          self.editName = self.classDetail.name
          self.editTime = self.classDetail.time
          self.editTeacher = self.classDetail.teacher
          self.editLocation = self.classDetail.location
          self.editNotes = self.classDetail.notes || ""
        } else {
          console.log("[DETAIL] tryLoadCourse: course not found for id=" + self.classId)
        }
      } else {
        console.log("[DETAIL] tryLoadCourse: day " + self.day + " not found in schedule")
      }
    })
  },

  applyFontScale(s) {
    if (!s || s < 0.5) { s = 1.0 }
    this.fontScale = s
    this.titleStyle = "font-size: " + Math.round(18 * s) + "px"
    this.labelStyle = "font-size: " + Math.round(16 * s) + "px"
  },

  onNameChange(e) {
    this.editName = e.value || ""
  },

  onTimeChange(e) {
    this.editTime = e.value || ""
  },

  onTeacherChange(e) {
    this.editTeacher = e.value || ""
  },

  onLocationChange(e) {
    this.editLocation = e.value || ""
  },

  onNotesChange(e) {
    this.editNotes = e.value || ""
  },

  goBack() {
    console.log("[DETAIL] goBack: navigating back")
    router.back()
  },

  saveCourse() {
    console.log("[DETAIL] saveCourse: start, name=" + this.editName + ", time=" + this.editTime)
    if (!this.editName || !this.editTime) {
      console.log("[DETAIL] saveCourse: validation failed - name or time is empty")
      return
    }
    var updatedCourse = {
      id: this.classId,
      day: this.day,
      name: this.editName,
      time: this.editTime,
      teacher: this.editTeacher || "TBD",
      location: this.editLocation || "TBD",
      notes: this.editNotes || ""
    }
    console.log("[DETAIL] saveCourse: updating course: " + JSON.stringify(updatedCourse))
    database.updateCourse(updatedCourse, function(success) {
      if (success) {
        console.log("[DETAIL] saveCourse: update success, navigating back")
        router.back()
      } else {
        console.log("[DETAIL] saveCourse: update failed")
      }
    })
  },

  deleteCourse() {
    console.log("[DETAIL] deleteCourse: deleting course id=" + this.classId + ", day=" + this.day + ", name=" + this.editName)
    database.deleteCourse(this.classId, this.day, function(success) {
      if (success) {
        console.log("[DETAIL] deleteCourse: delete success, navigating back")
        router.back()
      } else {
        console.log("[DETAIL] deleteCourse: delete failed")
      }
    })
  }
}
</script>

<style>
.detail-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 8px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 0;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 14px;
  color: #7ec8e3;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  margin-left: 8px;
}

.detail-content {
  flex-direction: column;
}

.form-section {
  flex-direction: column;
  flex: 1;
}

.info-label {
  font-size: 16px;
  font-weight: bold;
  color: #7ec8e3;
  margin-bottom: 4px;
  margin-top: 10px;
}

.field-input {
  height: 42px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 16px;
  color: #ffffff;
  padding: 0 10px;
  placeholder-color: #555566;
}

.delete-top-section {
  margin-bottom: 12px;
}

.delete-btn {
  width: 100%;
  height: 42px;
  border-radius: 8px;
  background-color: #8b0000;
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.button-group {
  flex-direction: row;
  margin-top: 16px;
  padding-bottom: 8px;
}

.save-btn {
  width: 100%;
  height: 42px;
  border-radius: 8px;
  background-color: #7ec8e3;
  font-size: 16px;
  font-weight: bold;
  color: #1a1a2e;
  text-align: center;
}

.not-found {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.not-found-text {
  font-size: 16px;
  color: #555566;
}
</style>