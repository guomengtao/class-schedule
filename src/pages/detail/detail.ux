}

.manage-btn {
  width: 100px;
  border-radius: 12px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 44px;
  lines: 1;
}

.confirm-card {
  flex-direction: column;
  border-radius: 12px;
  padding: 18px;
