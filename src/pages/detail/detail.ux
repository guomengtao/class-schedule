@media (shape: capsule), (shape: pill-shaped) {
  .edit-course-page {
    padding: 38px 16px 50px 16px;
  }
  /* 顶部删除按钮移除后 header 只剩「返回 + 标题」，不再需要换行：
     48 + 标题(flex:1) 在 160px 内容区内放得下，恢复单行。 */
  .header {
    height: auto;
    margin-bottom: 8px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
  }
  .back-btn-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    flex-shrink: 0;
  }
  .title {
    font-size: 24px;
    line-height: 34px;
    text-align: center;
    flex: 1;
    min-width: 0;
