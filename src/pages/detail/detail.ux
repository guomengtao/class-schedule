  }
  .stepper-label {
    font-size: 24px;
    width: 48px;
  }
  .stepper-btn {
    width: 48px;
    height: 48px;
    font-size: 24px;
  }
  .stepper-val {
    font-size: 36px;
    width: 46px;
  }
  .location-text {
    font-size: 28px;
  }
  .location-cursor {
    font-size: 28px;
  }
  .confirm-label {
    font-size: 28px;
  }
  .confirm-value {
    font-size: 28px;
  }
  .prev-btn,
  .next-btn,
  .save-btn {
    flex: 1;
    height: 48px;
    font-size: 24px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .manage-btn {
    width: 80px;
    height: 48px;
    font-size: 24px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
}

.undo-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  align-items: center;
  background-color: #0f3460;
  padding: 14px 20px;
  height: 60px;
}
.undo-msg {
  font-size: 24px;
  flex: 1;
  lines: 1;
}
.undo-btn {
  font-size: 24px;
  font-weight: bold;
  line-height: 32px;
  text-align: center;
  flex-shrink: 0;
  padding: 0 10px;
}

@media (shape: capsule), (shape: pill-shaped) {
  .undo-bar {
    bottom: 56px;
  }
}
</style>