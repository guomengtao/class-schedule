<template>
  <div class="detail-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="{{ titleStyle }}; color: {{ theme.text }}">编辑课程</text>
    </div>

    <div class="detail-content" if="{{ classDetail }}">
      <div class="delete-top-section">
        <input class="form-btn delete-btn" type="button" value="删除课程" onclick="deleteCourse" style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}" />
      </div>

      <div class="form-section">
        <text class="info-label" style="{{ labelStyle }}; color: {{ theme.accent }}">课程名称</text>
        <input class="field-input" type="text" value="{{ editName }}" onchange="onNameChange" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />

        <text class="info-label" style="{{ labelStyle }}; color: {{ theme.accent }}">开始时间</text>
        <div class="time-picker">
          <div class="picker-column">
            <input class="picker-arrow" type="button" value="▲" onclick="startHourUp" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
            <text class="picker-value" style="color: {{ theme.text }}">{{ padZero(startHour) }}</text>
            <input class="picker-arrow" type="button" value="▼" onclick="startHourDown" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
          </div>
          <text class="picker-separator" style="color: {{ theme.accent }}">:</text>
          <div class="picker-column">
            <input class="picker-arrow" type="button" value="▲" onclick="startMinUp" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
            <text class="picker-value" style="color: {{ theme.text }}">{{ padZero(startMin) }}</text>
            <input class="picker-arrow" type="button" value="▼" onclick="startMinDown" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
          </div>
        </div>

        <text class="info-label" style="{{ labelStyle }}; color: {{ theme.accent }}">结束时间</text>
        <div class="time-picker">
          <div class="picker-column">
            <input class="picker-arrow" type="button" value="▲" onclick="endHourUp" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
            <text class="picker-value" style="color: {{ theme.text }}">{{ padZero(endHour) }}</text>
            <input class="picker-arrow" type="button" value="▼" onclick="endHourDown" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
          </div>
          <text class="picker-separator" style="color: {{ theme.accent }}">:</text>
          <div class="picker-column">
            <input class="picker-arrow" type="button" value="▲" onclick="endMinUp" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
            <text class="picker-value" style="color: {{ theme.text }}">{{ padZero(endMin) }}</text>
            <input class="picker-arrow" type="button" value="▼" onclick="endMinDown" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
          </div>
        </div>

        <text class="info-label" style="{{ labelStyle }}; color: {{ theme.accent }}">老师</text>
        <input class="field-input" type="text" value="{{ editTeacher }}" onchange="onTeacherChange" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />

        <text class="info-label" style="{{ labelStyle }}; color: {{ theme.accent }}">位置 (可选)</text>
        <input class="field-input" type="text" placeholder="可以为空" value="{{ editLocation }}" onchange="onLocationChange" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />

        <text class="info-label" style="{{ labelStyle }}; color: {{ theme.accent }}">备注</text>
        <input class="field-input" type="text" value="{{ editNotes }}" onchange="onNotesChange" style="background-color: {{ theme.card }}; color: {{ theme.text }}" />
      </div>

      <div class="button-group">
        <input class="form-btn save-btn" type="button" value="保存" onclick="saveCourse" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="not-found" if="{{ !classDetail }}">
      <text class="not-found-text" style="{{ labelStyle }}; color: {{ theme.textMuted }}">课程未找到</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")
const database = require("../../data/database.js")

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

export default {
  private: {
    classDetail: null,
    day: "",
    classId: "",
    editName: "",
    editTime: "",
    editTeacher: "",
    editLocation: "",
    editNotes: "",
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    fontScale: 1.0,
    titleStyle: "",
    labelStyle: "",
    theme: {}
  },

  onInit() {
    console.log("[DETAIL] onInit: page loaded")
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getFontScale(function(scale) {
      self.applyFontScale(scale)
    })
    this.applyFontScale(1.0)

    storage.get({
      key: "detail_classId",
      success: function(data) {
        self.classId = data || ""
        console.log("[DETAIL] onInit: classId from storage=" + self.classId)
        self.tryLoadCourse()
      },
      fail: function() {
        console.log("[DETAIL] onInit: failed to read classId from storage")
        self.classId = ""
        self.tryLoadCourse()
      }
    })
    storage.get({
      key: "detail_day",
      success: function(data) {
        self.day = data || ""
        console.log("[DETAIL] onInit: day from storage=" + self.day)
        self.tryLoadCourse()
      },
      fail: function() {
        console.log("[DETAIL] onInit: failed to read day from storage")
        self.day = ""
        self.tryLoadCourse()
      }
    })
  },

  tryLoadCourse() {
    if (!this.classId || !this.day) {
      return
    }
    if (this._loaded) {
      return
    }
    this._loaded = true
    console.log("[DETAIL] tryLoadCourse: classId=" + this.classId + ", day=" + this.day)
    var self = this
    database.getAllCourses(function(schedule) {
      console.log("[DETAIL] tryLoadCourse: schedule has " + schedule.length + " days")
      var dayData = null
      for (var d = 0; d < schedule.length; d++) {
        if (schedule[d].day === self.day) {
          dayData = schedule[d]
          break
        }
      }
      if (dayData) {
        console.log("[DETAIL] tryLoadCourse: found day=" + self.day + " with " + dayData.classes.length + " classes")
        var found = null
        for (var c = 0; c < dayData.classes.length; c++) {
          if (dayData.classes[c].id === self.classId) {
            found = dayData.classes[c]
            break
          }
        }
        self.classDetail = found
        if (self.classDetail) {
          console.log("[DETAIL] tryLoadCourse: course found: " + self.classDetail.name + " (" + self.classDetail.id + ")")
          self.editName = self.classDetail.name
          self.editTime = self.classDetail.time
          self.editTeacher = self.classDetail.teacher
          self.editLocation = self.classDetail.location
          self.editNotes = self.classDetail.notes || ""
          var tp = parseTimeParts(self.classDetail.time)
          self.startHour = tp.startH
          self.startMin = tp.startM
          self.endHour = tp.endH
          self.endMin = tp.endM
        } else {
          console.log("[DETAIL] tryLoadCourse: course not found for id=" + self.classId)
        }
      } else {
        console.log("[DETAIL] tryLoadCourse: day " + self.day + " not found in schedule")
      }
    })
  },

  applyFontScale(s) {
    if (!s || s < 0.5) { s = 1.0 }
    this.fontScale = s
    this.titleStyle = "font-size: " + Math.round(18 * s) + "px"
    this.labelStyle = "font-size: " + Math.round(16 * s) + "px"
  },

  padZero(n) {
    return padZero(n)
  },

  updateTimeString() {
    this.editTime = padZero(this.startHour) + ":" + padZero(this.startMin) + " - " + padZero(this.endHour) + ":" + padZero(this.endMin)
  },

  startHourUp() {
    this.startHour = (this.startHour + 1) % 24
    this.updateTimeString()
  },
  startHourDown() {
    this.startHour = (this.startHour - 1 + 24) % 24
    this.updateTimeString()
  },
  startMinUp() {
    this.startMin = (this.startMin + 5) % 60
    this.updateTimeString()
  },
  startMinDown() {
    this.startMin = (this.startMin - 5 + 60) % 60
    this.updateTimeString()
  },
  endHourUp() {
    this.endHour = (this.endHour + 1) % 24
    this.updateTimeString()
  },
  endHourDown() {
    this.endHour = (this.endHour - 1 + 24) % 24
    this.updateTimeString()
  },
  endMinUp() {
    this.endMin = (this.endMin + 5) % 60
    this.updateTimeString()
  },
  endMinDown() {
    this.endMin = (this.endMin - 5 + 60) % 60
    this.updateTimeString()
  },

  onNameChange(e) {
    this.editName = e.value || ""
  },

  onTeacherChange(e) {
    this.editTeacher = e.value || ""
  },

  onLocationChange(e) {
    this.editLocation = e.value || ""
  },

  onNotesChange(e) {
    this.editNotes = e.value || ""
  },

  goBack() {
    console.log("[DETAIL] goBack: navigating back")
    router.back()
  },

  saveCourse() {
    console.log("[DETAIL] saveCourse: start, name=" + this.editName + ", time=" + this.editTime)
    if (!this.editName || !this.editTime) {
      console.log("[DETAIL] saveCourse: validation failed - name or time is empty")
      return
    }
    var updatedCourse = {
      id: this.classId,
      day: this.day,
      name: this.editName,
      time: this.editTime,
      teacher: this.editTeacher || "TBD",
      location: this.editLocation || "",
      notes: this.editNotes || ""
    }
    console.log("[DETAIL] saveCourse: updating course: " + JSON.stringify(updatedCourse))
    database.updateCourse(updatedCourse, function(success) {
      if (success) {
        console.log("[DETAIL] saveCourse: update success, navigating back")
        router.back()
      } else {
        console.log("[DETAIL] saveCourse: update failed")
      }
    })
  },

  deleteCourse() {
    console.log("[DETAIL] deleteCourse: deleting course id=" + this.classId + ", day=" + this.day + ", name=" + this.editName)
    database.deleteCourse(this.classId, this.day, function(success) {
      if (success) {
        console.log("[DETAIL] deleteCourse: delete success, navigating back")
        router.back()
      } else {
        console.log("[DETAIL] deleteCourse: delete failed")
      }
    })
  }
}
</script>

<style>
.detail-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 8px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 0;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 14px;
  color: #7ec8e3;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  margin-left: 8px;
}

.detail-content {
  flex-direction: column;
}

.form-section {
  flex-direction: column;
  flex: 1;
}

.info-label {
  font-size: 16px;
  font-weight: bold;
  color: #7ec8e3;
  margin-bottom: 4px;
  margin-top: 10px;
}

.field-input {
  height: 42px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 16px;
  color: #ffffff;
  padding: 0 10px;
  placeholder-color: #555566;
}

.time-picker {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 4px;
  margin-bottom: 8px;
}

.picker-column {
  flex-direction: column;
  align-items: center;
}

.picker-arrow {
  width: 44px;
  height: 30px;
  border-radius: 6px;
  background-color: #0f3460;
  color: #ffffff;
  font-weight: bold;
  font-size: 14px;
  text-align: center;
}

.picker-value {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  width: 56px;
  margin: 2px 0;
}

.picker-separator {
  font-size: 28px;
  font-weight: bold;
  color: #7ec8e3;
  margin: 0 6px;
}

.delete-top-section {
  margin-bottom: 12px;
}

.delete-btn {
  width: 100%;
  height: 42px;
  border-radius: 8px;
  background-color: #8b0000;
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.button-group {
  flex-direction: row;
  margin-top: 16px;
  padding-bottom: 8px;
}

.save-btn {
  width: 100%;
  height: 42px;
  border-radius: 8px;
  background-color: #7ec8e3;
  font-size: 16px;
  font-weight: bold;
  color: #1a1a2e;
  text-align: center;
}

.not-found {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.not-found-text {
  font-size: 16px;
  color: #555566;
}
</style>