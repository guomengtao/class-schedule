  width: 40px;
  height: 4px;
  margin: 0 4px;
}

.form-section {
  width: 100%;
  flex-direction: column;
}

.step-title {
  font-size: 34px;
  font-weight: bold;
  margin-bottom: 8px;
  text-align: center;
  line-height: 42px;
  lines: 1;
}

.step-hint {
  font-size: 28px;
  margin-bottom: 14px;
  text-align: center;
  line-height: 36px;
  lines: 1;
}

.swiper-wrapper {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.swipe-arrow {
  width: 50px;
  height: 50px;
  border-radius: 25px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
}

.course-card {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  padding: 24px;
  margin: 0 12px;
  border: 3px solid #7ec8e3;
  width: 200px;
  min-height: 80px;
}

.card-course-name {
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  lines: 1;
  line-height: 44px;
  text-overflow: ellipsis;
}

.add-card {
  justify-content: center;
  align-items: center;
}

.add-card-icon {
  font-size: 56px;
  font-weight: bold;
  text-align: center;
  line-height: 68px;
}

.stepper-time {
  flex-direction: column;
  align-items: center;
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 10px;
}

.picker-label {
  font-size: 32px;
  font-weight: bold;
  margin-top: 10px;
  margin-bottom: 8px;
  text-align: center;
}

.stepper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.stepper-label {
  font-size: 28px;
  width: 60px;
}

.stepper-btn {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
}

.stepper-val {
  font-size: 40px;
  font-weight: bold;
  width: 60px;
  text-align: center;
}

.optional-hint {
  font-size: 24px;
  margin-bottom: 14px;
  text-align: center;
}

/* 上课日选择（编辑页新增，允许把课程改到别的星期） */
.weekday-label {
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 6px;
}

.weekday-scroll {
  width: 100%;
  height: 52px;
}

.weekday-row {
  flex-direction: row;
  justify-content: center;
}

.weekday-btn {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
  margin: 0 2px;
}

.weekday-btn-active {
  background-color: #7ec8e3;
}

