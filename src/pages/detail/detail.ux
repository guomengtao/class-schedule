<template>
  <scroll class="edit-course-page" scroll-y="true" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="title" style="color: {{ theme.text }}">编辑课程</text>
    </div>

    <div class="step-indicator">
      <text class="step-dot {{ step >= 1 ? 'active' : '' }}" style="background-color: {{ step >= 1 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 2 ? 'active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 2 ? 'active' : '' }}" style="background-color: {{ step >= 2 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 3 ? 'active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 3 ? 'active' : '' }}" style="background-color: {{ step >= 3 ? theme.accent : theme.border }}"></text>
      <text class="step-line {{ step >= 4 ? 'active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></text>
      <text class="step-dot {{ step >= 4 ? 'active' : '' }}" style="background-color: {{ step >= 4 ? theme.accent : theme.border }}"></text>
    </div>

    <div class="missing-state" if="{{ courseMissing }}" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
      <text class="missing-title" style="color: {{ theme.text }}">这门课已经不在了</text>
      <text class="missing-desc" style="color: {{ theme.textSecondary }}">它可能已被删除，或被移到了其他星期</text>
      <text class="missing-desc" style="color: {{ theme.textMuted }}">你可以返回首页，或重新添加一门课程</text>
      <input class="missing-btn" type="button" value="返回首页" onclick="goBack" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="missing-btn-ghost" type="button" value="去添加课程" onclick="openAddCourse" style="height: 48px; background-color: transparent; border-color: {{ theme.accent }}; color: {{ theme.accent }}" />
    </div>

    <div class="form-section" if="{{ !courseMissing && step === 1 }}">
      <text class="step-title" style="color: {{ theme.text }}">选择课程</text>
      <text class="step-hint" style="color: {{ theme.textSecondary }}">共 {{ displayCourseCount }} 门 · 左右滑动查看</text>

      <!-- 课程选择与「添加课程页」（add-course.ux）同一套交互：横向滚动课程条，
           左右滑动浏览、点一下即选中；末尾「+」进课程管理。 -->
      <scroll class="course-scroll" scroll-x="true" id="courseScroll" scroll-left="{{ courseScrollLeft }}">
        <div class="course-item" for="{{ (idx, c) in presetCourses }}"
             onclick="selectCourseByIdx(idx)"
             style="background-color: {{ theme.card }}; border-color: {{ courseIndex === idx ? theme.accent : 'transparent' }}">
          <text class="course-name" style="color: {{ theme.text }}">{{ c.name }}</text>
        </div>
        <div class="course-item course-add-item" onclick="openCourseManager"
             style="background-color: {{ theme.cardLight }}">
          <text class="course-add-icon" style="color: {{ theme.accent }}">+</text>
        </div>
      </scroll>

      <div class="step-nav">
        <input class="step-delete-btn" type="button" value="删除" onclick="deleteCourse" style="height: 48px; background-color: {{ deleteConfirm ? theme.deleteText : 'transparent' }}; border-color: {{ theme.deleteText }}; color: {{ deleteConfirm ? theme.text : theme.deleteText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep" style="height: 48px; background-color: {{ courseIndex < presetCourses.length ? theme.accent : theme.border }}; color: {{ courseIndex < presetCourses.length ? theme.bg : theme.textMuted }}" />
      </div>
      <text class="delete-hint" if="{{ deleteConfirm }}" style="color: {{ theme.deleteText }}">再次点击确认删除</text>
    </div>

    <div class="form-section" if="{{ !courseMissing && step === 2 }}">
      <text class="step-title" style="color: {{ theme.text }}">时间 · {{ courseName }}</text>

      <text class="picker-label" style="color: {{ theme.text }}">开始</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ startHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseStartMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ startMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseStartMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

        <text class="picker-label" style="color: {{ theme.text }}">结束</text>
        <div class="stepper-time" style="background-color: {{ theme.card }}">
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">小时</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ endHour }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndHour" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <text class="stepper-label" style="color: {{ theme.text }}">分钟</text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseEndMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ endMin }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseEndMin" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

      <div class="step-nav">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep" style="height: 48px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-section" if="{{ !courseMissing && step === 3 }}">
      <text class="step-title" style="color: {{ theme.text }}">位置与星期</text>
      <text class="step-hint" style="color: {{ theme.textSecondary }}">{{ courseName }} | {{ courseTime }}</text>
      <div class="location-display" onclick="showKeyboard" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
        <text class="location-text" style="color: {{ theme.text }}">{{ courseLocation || '如：301教室' }}</text>
        <text class="location-cursor" show="{{ showCursor }}">_</text>
      </div>
      <text class="optional-hint" style="color: {{ theme.textMuted }}">选填</text>

      <text class="weekday-label" style="color: {{ theme.accent }}">上课日</text>
      <scroll scroll-x="true" class="weekday-scroll" id="weekdayScroll" scroll-left="{{ weekdayScrollLeft }}">
        <div class="weekday-row">
          <div class="weekday-btn {{ dayIndex === 1 ? (dayConfirmed ? 'weekday-btn-active' : 'weekday-btn-pending') : '' }}" onclick="selectDay(1)" ontouchstart="onDayTouch" style="background-color: {{ dayIndex === 1 ? (dayConfirmed ? theme.accent : 'transparent') : theme.card }}; border-color: {{ dayIndex === 1 ? theme.accent : 'transparent' }}">
            <text class="weekday-text" style="color: {{ dayIndex === 1 ? (dayConfirmed ? theme.bg : theme.accent) : theme.text }}">一</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 2 ? (dayConfirmed ? 'weekday-btn-active' : 'weekday-btn-pending') : '' }}" onclick="selectDay(2)" ontouchstart="onDayTouch" style="background-color: {{ dayIndex === 2 ? (dayConfirmed ? theme.accent : 'transparent') : theme.card }}; border-color: {{ dayIndex === 2 ? theme.accent : 'transparent' }}">
            <text class="weekday-text" style="color: {{ dayIndex === 2 ? (dayConfirmed ? theme.bg : theme.accent) : theme.text }}">二</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 3 ? (dayConfirmed ? 'weekday-btn-active' : 'weekday-btn-pending') : '' }}" onclick="selectDay(3)" ontouchstart="onDayTouch" style="background-color: {{ dayIndex === 3 ? (dayConfirmed ? theme.accent : 'transparent') : theme.card }}; border-color: {{ dayIndex === 3 ? theme.accent : 'transparent' }}">
            <text class="weekday-text" style="color: {{ dayIndex === 3 ? (dayConfirmed ? theme.bg : theme.accent) : theme.text }}">三</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 4 ? (dayConfirmed ? 'weekday-btn-active' : 'weekday-btn-pending') : '' }}" onclick="selectDay(4)" ontouchstart="onDayTouch" style="background-color: {{ dayIndex === 4 ? (dayConfirmed ? theme.accent : 'transparent') : theme.card }}; border-color: {{ dayIndex === 4 ? theme.accent : 'transparent' }}">
            <text class="weekday-text" style="color: {{ dayIndex === 4 ? (dayConfirmed ? theme.bg : theme.accent) : theme.text }}">四</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 5 ? (dayConfirmed ? 'weekday-btn-active' : 'weekday-btn-pending') : '' }}" onclick="selectDay(5)" ontouchstart="onDayTouch" style="background-color: {{ dayIndex === 5 ? (dayConfirmed ? theme.accent : 'transparent') : theme.card }}; border-color: {{ dayIndex === 5 ? theme.accent : 'transparent' }}">
            <text class="weekday-text" style="color: {{ dayIndex === 5 ? (dayConfirmed ? theme.bg : theme.accent) : theme.text }}">五</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 6 ? (dayConfirmed ? 'weekday-btn-active' : 'weekday-btn-pending') : '' }}" onclick="selectDay(6)" ontouchstart="onDayTouch" style="background-color: {{ dayIndex === 6 ? (dayConfirmed ? theme.accent : 'transparent') : theme.card }}; border-color: {{ dayIndex === 6 ? theme.accent : 'transparent' }}">
            <text class="weekday-text" style="color: {{ dayIndex === 6 ? (dayConfirmed ? theme.bg : theme.accent) : theme.text }}">六</text>
          </div>
          <div class="weekday-btn {{ dayIndex === 0 ? (dayConfirmed ? 'weekday-btn-active' : 'weekday-btn-pending') : '' }}" onclick="selectDay(0)" ontouchstart="onDayTouch" style="background-color: {{ dayIndex === 0 ? (dayConfirmed ? theme.accent : 'transparent') : theme.card }}; border-color: {{ dayIndex === 0 ? theme.accent : 'transparent' }}">
            <text class="weekday-text" style="color: {{ dayIndex === 0 ? (dayConfirmed ? theme.bg : theme.accent) : theme.text }}">日</text>
          </div>
        </div>
      </scroll>
      <text class="day-confirm-hint" style="color: {{ dayConfirmed ? theme.textSecondary : theme.accent }}">{{ dayConfirmed ? ('已选 ' + day) : '点按高亮的日期确认' }}</text>

      <div class="step-nav">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep" style="height: 48px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="next-btn" type="button" value="下一步" onclick="nextStep" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <div class="form-section" if="{{ !courseMissing && step === 4 }}">
      <text class="step-title" style="color: {{ theme.text }}">确认</text>
      <div class="confirm-card" style="background-color: {{ theme.card }}">
        <text class="confirm-label" style="color: {{ theme.accent }}">课程</text>
        <text class="confirm-value" style="color: {{ theme.text }}">{{ courseName }}</text>
        <text class="confirm-label" style="color: {{ theme.accent }}">时间</text>
        <text class="confirm-value" style="color: {{ theme.text }}">{{ courseTime }}</text>
        <text class="confirm-label" style="color: {{ theme.accent }}">星期</text>
        <text class="confirm-value" style="color: {{ theme.text }}">{{ day }}</text>
        <text class="confirm-label" style="color: {{ theme.accent }}">位置</text>
        <text class="confirm-value" style="color: {{ theme.text }}">{{ courseLocation || '(无)' }}</text>
      </div>
      <div class="step-nav">
        <input class="prev-btn" type="button" value="后退" onclick="prevStep" style="height: 48px; background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="save-btn" type="button" value="更新" onclick="updateCourse" style="height: 48px; background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>
    </div>

    <!-- 删除后的撤销条：悬浮卡片样式，撤销做成独立按钮而不是裸文字 -->
    <div class="undo-bar" if="{{ undoVisible }}" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
      <text class="undo-msg" style="color: {{ theme.text }}">{{ undoMessage }}</text>
      <input class="undo-btn" type="button" value="撤销" onclick="undoDelete" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </scroll>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var COURSE_LIST_KEY = "course_preset_list"

var defaultCourses = [
  { name: "语文", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "数学", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "英语", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "物理", time: "10:55 - 11:40", teacher: "老师", location: "" },
  { name: "化学", time: "13:00 - 13:45", teacher: "老师", location: "" },
  { name: "政治", time: "13:55 - 14:40", teacher: "老师", location: "" },
  { name: "音乐", time: "15:00 - 15:45", teacher: "老师", location: "" },
  { name: "体育", time: "15:55 - 16:40", teacher: "老师", location: "" },
  { name: "美术", time: "08:00 - 08:45", teacher: "老师", location: "" },
  { name: "历史", time: "08:55 - 09:40", teacher: "老师", location: "" },
  { name: "地理", time: "10:00 - 10:45", teacher: "老师", location: "" },
  { name: "生物", time: "10:55 - 11:40", teacher: "老师", location: "" }
]

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

// 横向课程条每项步进 = 卡片宽 + 右边距，数值与样式表保持一致：
// 胶囊屏 120+6、圆屏 120+10、方屏 110+10、默认 100+10。
// 取胶囊屏实测值 126 作为统一步进：其余屏型误差 ≤4px/项，选中项始终能滚进可视区。
var COURSE_ITEM_STEP = 126

function padZero(n) {
  return n < 10 ? "0" + n : String(n)
}

function parseTimeParts(timeStr) {
  var parts = timeStr.split("-")
  if (parts.length < 2) return { startH: 8, startM: 0, endH: 8, endM: 45 }
  var start = parts[0].trim()
  var end = parts[1].trim()
  var sParts = start.split(":")
  var eParts = end.split(":")
  return {
    startH: parseInt(sParts[0]) || 8,
    startM: parseInt(sParts[1]) || 0,
    endH: parseInt(eParts[0]) || 8,
    endM: parseInt(eParts[1]) || 45
  }
}

function formatTime(h, m) {
  return padZero(h) + ":" + padZero(m)
}

export default {
  private: {
    courseName: "",
    courseTime: "",
    courseLocation: "",
    courseTeacher: "",
    courseNotes: "",
    day: "",
    dayIndex: 0,
    originalDay: "",
    classId: "",
    step: 1,
    courseIndex: 0,
    deleteConfirm: false,
    iconTheme: "dark",
    weekdayScrollLeft: 0,
    courseScrollLeft: 0,
    dayConfirmed: false,
    courseMissing: false,
    undoVisible: false,
    undoMessage: "",
    undoBackup: null,
    undoTimer: null,
    presetCourses: [],
    displayCourseCount: 0,
    startHour: 8,
    startMin: 0,
    endHour: 8,
    endMin: 45,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  sortByTime: function(list) {
    if (!list || list.length === 0) return list
    var sorted = list.slice()
    sorted.sort(function(a, b) {
      var ta = a.time ? a.time.split(' - ')[0] : '00:00'
      var tb = b.time ? b.time.split(' - ')[0] : '00:00'
      var taParts = ta.split(':')
      var tbParts = tb.split(':')
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    return sorted
  },

  onInit() {
    this.deleteConfirm = false
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    var storage = require("@system.storage")
    var classIdLoaded = false
    var dayLoaded = false

    function tryLoadCourses() {
      if (classIdLoaded && dayLoaded) {
        self.loadCoursesWithData()
      }
    }

    storage.get({
      key: "detail_classId",
      success: function(val) {
        self.classId = val || ""
        classIdLoaded = true
        tryLoadCourses()
      },
      fail: function() {
        self.classId = ""
        classIdLoaded = true
        tryLoadCourses()
      }
    })
    storage.get({
      key: "detail_day",
      success: function(val) {
        self.day = val || ""
        if (!self.day) { self.setDefaultDay() }
        dayLoaded = true
        tryLoadCourses()
      },
      fail: function() {
        self.day = ""
        self.setDefaultDay()
        dayLoaded = true
        tryLoadCourses()
      }
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadCoursesWithData()

    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.courseLocation = data
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  setDefaultDay() {
    var dayNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
    var now = new Date()
    this.day = dayNames[now.getDay()]
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  loadCoursesWithData() {
    var self = this
    var storage = require("@system.storage")

    storage.get({
      key: COURSE_LIST_KEY,
      success: function(data) {
        if (data) {
          try {
            var list = JSON.parse(data)
            if (list && list.length > 0) {
              self.presetCourses = self.sortByTime(list)
            } else {
              self.presetCourses = self.sortByTime(defaultCourses.slice())
            }
          } catch (e) {
            self.presetCourses = self.sortByTime(defaultCourses.slice())
          }
        } else {
          self.presetCourses = self.sortByTime(defaultCourses.slice())
        }
        self.displayCourseCount = self.presetCourses.length
        self.loadExistingCourseData()
      },
      fail: function() {
        self.presetCourses = self.sortByTime(defaultCourses.slice())
        self.displayCourseCount = self.presetCourses.length
        self.loadExistingCourseData()
      }
    })
  },

  loadExistingCourseData() {
    var self = this
    if (!self.classId || !self.day) {
      self.selectCourse(0)
      self.scrollToCurrentCourse()
      return
    }
    // 记录原始星期，用于判断用户是否把课程挪到了别的日子
    self.originalDay = self.day
    self.dayIndex = DAY_NAMES.indexOf(self.day)
    if (self.dayIndex < 0) self.dayIndex = 0

    database.getAllCourses(function(data) {
      var found = false
      var dayData = null
      for (var d = 0; d < data.length; d++) {
        if (data[d].day === self.day) {
          dayData = data[d]
          break
        }
      }
      if (dayData) {
        var classes = dayData.classes
        for (var i = 0; i < classes.length; i++) {
          if (String(classes[i].id) === String(self.classId)) {
            var c = classes[i]
            self.courseName = c.name || ""
            self.courseTime = c.time || ""
            self.courseLocation = c.location || ""
            self.courseTeacher = c.teacher || ""
            self.courseNotes = c.notes || ""

            var tp = parseTimeParts(c.time)
            self.startHour = tp.startH
            self.startMin = tp.startM
            self.endHour = tp.endH
            self.endMin = tp.endM

            var foundIndex = -1
            for (var j = 0; j < self.presetCourses.length; j++) {
              if (self.presetCourses[j].name === c.name) {
                foundIndex = j
                break
              }
            }
            if (foundIndex >= 0) {
              self.courseIndex = foundIndex
            } else {
              // 课程名不在预设库里（例如预设名被改过或删过）。
              // 把它临时加入列表并选中，保留原课程名，
              // 避免静默把课程改成预设库里的第一门课。
              self.presetCourses.push({
                name: c.name,
                teacher: c.teacher || "",
                time: c.time || ""
              })
              self.courseIndex = self.presetCourses.length - 1
              self.courseName = c.name
              self.courseTeacher = c.teacher || ""
            }
            // 选中项已确定：把课程条滚过去，用户进页就能看到自己那门课
            self.scrollToCurrentCourse()
            found = true
            break
          }
        }
      }
      if (!found) {
        // 课程已删除或 id 失效：不再用「toast + 自动返回」（那一秒多页面是空的，看起来像白屏），
        // 改为停留在页内显示友好说明 + 明确引导，由用户自己决定下一步。
        self.courseMissing = true
        try { self.$forceUpdate() } catch (e) {}
        return
      }
      self.courseMissing = false
    })
  },

  openCourseManager() {
    router.push({ uri: "/pages/course-manager" })
  },

  openAddCourse() {
    router.push({ uri: "/pages/add-course" })
  },

  padZero(n) {
    return padZero(n)
  },

  selectCourse(index, keepExistingTime) {
    if (index >= this.presetCourses.length) {
      this.courseIndex = index
      return
    }
    this.courseIndex = index
    var c = this.presetCourses[index]
    this.courseName = c.name
    this.courseTeacher = c.teacher
    this.courseLocation = c.location || this.courseLocation
    if (!keepExistingTime) {
      var tp = parseTimeParts(c.time)
      this.startHour = tp.startH
      this.startMin = tp.startM
      this.endHour = tp.endH
      this.endMin = tp.endM
      this.courseTime = c.time
    }
  },

  // 点选课程条（与添加课程页 add-course.ux 的 selectCourseByIdx 同名同职责）。
  // 编辑页多一层语义：换课要带出该课程自己的时间/老师/地点，故 keepExistingTime 不传
  // （走 selectCourse 默认分支 = 用新课程数据覆盖当前表单）。
  selectCourseByIdx(idx) {
    this.selectCourse(idx)
  },

  updateTimeString() {
    this.courseTime = formatTime(this.startHour, this.startMin) + " - " + formatTime(this.endHour, this.endMin)
  },

  adjustEndTime() {
    var startTotal = this.startHour * 60 + this.startMin
    var endTotal = this.endHour * 60 + this.endMin
    if (endTotal <= startTotal) {
      endTotal = startTotal + 45
      if (endTotal >= 1440) { endTotal = 1439 }
      this.endHour = Math.floor(endTotal / 60)
      this.endMin = endTotal % 60
    }
    this.updateTimeString()
  },

  increaseStartHour() {
    if (this.startHour < 23) {
      this.startHour++
    } else {
      this.startHour = 0
    }
    this.adjustEndTime()
  },
  decreaseStartHour() {
    if (this.startHour > 0) {
      this.startHour--
    } else {
      this.startHour = 23
    }
    this.adjustEndTime()
  },
  increaseStartMin() {
    if (this.startMin < 59) {
      this.startMin++
    } else {
      this.startMin = 0
    }
    this.adjustEndTime()
  },
  decreaseStartMin() {
    if (this.startMin > 0) {
      this.startMin--
    } else {
      this.startMin = 59
    }
    this.adjustEndTime()
  },
  increaseEndHour() {
    if (this.endHour < 23) {
      this.endHour++
    } else {
      this.endHour = 0
    }
    this.adjustEndTime()
  },
  decreaseEndHour() {
    if (this.endHour > 0) {
      this.endHour--
    } else {
      this.endHour = 23
    }
    this.adjustEndTime()
  },
  increaseEndMin() {
    if (this.endMin < 59) {
      this.endMin++
    } else {
      this.endMin = 0
    }
    this.adjustEndTime()
  },
  decreaseEndMin() {
    if (this.endMin > 0) {
      this.endMin--
    } else {
      this.endMin = 59
    }
    this.adjustEndTime()
  },

  showKeyboard() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "上课地点", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "如：301教室", success: function() {} })
    storage.set({ key: "chinese_input_value", value: this.courseLocation, success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "10", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  nextStep() {
    // 第 3 步必须先点按确认上课日：否则"自动滚过去但用户没看见"就进入了下一步
    if (this.step === 3 && !this.dayConfirmed) {
      prompt.showToast({ message: "请点按高亮的日期确认上课日" })
      this.scrollToCurrentDay()
      return
    }
    if (this.step < 4) {
      this.step = this.step + 1
      if (this.step === 3) {
        this.enterDayStep()
      }
    }
  },

  prevStep() {
    if (this.step > 1) {
      this.step = this.step - 1
      if (this.step === 3) {
        this.enterDayStep()
      } else if (this.step === 1) {
        // 回到「选择课程」步：课程条重新渲染，重新把选中项滚进可视区
        this.scrollToCurrentCourse()
      }
    }
  },

  // 进入「位置与星期」步骤：编辑时旧日期已加载，直接预确认，用户无需多点一次；如需改期仍可点选。
  enterDayStep() {
    this.dayConfirmed = true
    this.scrollToCurrentDay()
  },

  scrollToCurrentDay() {
    // 模板里的排列顺序：一 二 三 四 五 六 日，与 dayIndex(0=周日) 不一致，需换算
    var order = [1, 2, 3, 4, 5, 6, 0]
    var pos = order.indexOf(this.dayIndex)
    if (pos < 0) { pos = 0 }
    var left = pos * 52 // 每项 48px 宽 + 左右 margin
    this.weekdayScrollLeft = left
  },

  // 自动滚动到当前选中的课程：课程条是横向 scroll + 固定宽卡片，
  // 胶囊屏内容区仅 160px、约看得见 1.3 张卡，编辑靠后的课时选中项在屏外，
  // 用户得自己左右滑着找。这里在进入/回到第 1 步时把选中项滚到最左边。
  // 与 scrollToCurrentDay 同一套做法：通过 scroll-left 属性滚动到当前选中项。
  scrollToCurrentCourse() {
    var idx = this.courseIndex
    if (!(idx > 0)) { idx = 0 }
    var left = idx * COURSE_ITEM_STEP
    this.courseScrollLeft = left
  },

  // 切换上课星期：点按即为明确确认
  selectDay(index) {
    this.dayIndex = index
    this.day = DAY_NAMES[index]
    this.dayConfirmed = true
  },

  // 星期按钮的空触摸处理器：保证 ontouchstart 存在，避免点击被父级手势拦截
  onDayTouch() {},

  goBack() {
    router.back()
  },

  updateCourse() {
    if (!this.courseName) {
      prompt.showToast({ message: "请输入课程名称" })
      return
    }
    if (!this.courseTime) {
      prompt.showToast({ message: "请选择上课时间" })
      return
    }
    var updatedCourse = {
      id: String(this.classId),
      day: this.day,
      name: this.courseName,
      time: this.courseTime,
      teacher: this.courseTeacher || "TBD",
      location: this.courseLocation || "",
      notes: this.courseNotes || ""
    }
    // 时间冲突检测：同天已有课程时间重叠时，先提示，需再次确认才保存
    var self = this
    database.checkDayConflict(updatedCourse.day, updatedCourse, String(this.classId), function(conflict) {
      if (conflict && !self.conflictConfirmed) {
        prompt.showToast({ message: "时间冲突：与《" + conflict.name + "》" + conflict.time + " 重叠，再点确认保存" })
        self.conflictConfirmed = true
        return
      }
      self.conflictConfirmed = false
      // 星期被改过：更新是按 星期+id 定位的，必须先把原星期的记录删掉，
      // 再插入到新的星期，否则会提示"课程不存在"。
      if (self.originalDay && self.originalDay !== self.day) {
        // 跨星期更新：旧位置删除 + 新位置插入合并为一次原子写盘，
        // 避免"删成功插失败"导致课程永久丢失（数据稳定性维度 P1）。
        database.updateCourseAcrossDays(updatedCourse, self.originalDay, function(err) {
          if (!err) {
            prompt.showToast({ message: "课程已更新" })
            router.back()
          } else {
            prompt.showToast({ message: "更新失败: " + err })
          }
        })
        return
      }
      database.updateCourse(updatedCourse, function(err) {
        if (!err) {
          prompt.showToast({ message: "课程已更新" })
          router.back()
        } else {
          prompt.showToast({ message: "更新失败: " + err })
        }
      })
    })
  },

  deleteCourse() {
    if (!this.deleteConfirm) {
      this.deleteConfirm = true
      var self = this
      // 确认超时后必须给出显式反馈，否则用户再点会误以为"点了没反应"
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirm = false
        self.deleteTimer = null
        prompt.showToast({ message: "已取消删除" })
      }, 8000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    var self = this
    // 暂存被删课程的完整字段，用于撤销时原样恢复
    var backup = {
      id: String(self.classId),
      day: self.day,
      name: self.courseName,
      time: self.courseTime,
      location: self.courseLocation || "",
      teacher: self.courseTeacher || "TBD",
      notes: self.courseNotes || ""
    }
    database.deleteCourse(self.classId, self.day, function(err) {
      if (!err) {
        // 删除已生效：给 5 秒撤销窗口，期间停留本页，超时自动返回首页
        self.showUndo("课程已删除", backup)
      } else {
        var msg = String(err)
        if (msg.indexOf("课程不存在") !== -1 || msg.indexOf("not found") !== -1) {
          prompt.showToast({ message: "课程已被删除，请返回首页", duration: 2000 })
          setTimeout(function() { router.back() }, 2100)
        } else {
          prompt.showToast({ message: "删除失败: " + err })
        }
      }
    })
  },

  showUndo(message, backup) {
    this.undoBackup = backup
    this.undoVisible = true
    this.undoMessage = message
    var self = this
    if (this.undoTimer) clearTimeout(this.undoTimer)
    this.undoTimer = setTimeout(function() {
      self.finishDelete()
    }, 5000)
  },

  hideUndo() {
    if (this.undoTimer) {
      clearTimeout(this.undoTimer)
      this.undoTimer = null
    }
    this.undoVisible = false
  },

  undoDelete() {
    if (!this.undoBackup) {
      this.hideUndo()
      return
    }
    var self = this
    var b = this.undoBackup
    database.insertCourse(b, function(err) {
      if (!err) {
        prompt.showToast({ message: "已恢复", duration: 300 })
      } else {
        prompt.showToast({ message: "恢复失败: " + err })
      }
      self.hideUndo()
    })
  },

  finishDelete() {
    this.hideUndo()
    router.back()
  },

  onDestroy() {
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    if (this.undoTimer) {
      clearTimeout(this.undoTimer)
      this.undoTimer = null
    }
  }
}
</script>

<style>
/* ================================================================
   BASE CSS = 手环 9 基准（160px 内容区）
   手环 9 默认命中，无需任何 media query。
   弹性 flex + % 撑满。屏幕增大时，下方宽度断点「增量」调整。
   原则：base 属性一旦设定，大屏断点只改物理必须区分的值，不覆盖。
   手环 9 黑屏根因：独立 @media (shape: pill-shaped) 大块命中即崩，
   故 base 以 9 为基准，彻底移除独立 pill-shaped 分支。
   详见 docs/手环9黑屏根因定位*.md、docs/一套css自适应方案分析.md
   ================================================================ */

.edit-course-page {
  width: 100%;
  flex-direction: column;
  padding: 38px 12px 50px 12px;
}

.header {
  flex-direction: row;
  align-items: center;
  height: auto;
  margin-bottom: 8px;
}

.back-btn-wrapper {
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  flex: 1;
  min-width: 0;
  text-align: center;
  line-height: 34px;
}

.step-indicator {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}

.step-dot {
  width: 14px;
  height: 14px;
  border-radius: 7px;
}

.step-line {
  width: 24px;
  height: 3px;
  margin: 0 3px;
}

.form-section {
  width: 100%;
  flex-direction: column;
}

.missing-state {
  width: 100%;
  flex-direction: column;
  align-items: center;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  padding: 24px 18px;
  margin-top: 8px;
}

.missing-title {
  font-size: 24px;
  font-weight: bold;
  line-height: 32px;
  text-align: center;
  margin-bottom: 8px;
}

.missing-desc {
  font-size: 18px;
  line-height: 26px;
  text-align: center;
  margin-bottom: 4px;
}

.missing-btn {
  width: 100%;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
  margin-top: 10px;
}

.missing-btn-ghost {
  width: 100%;
  height: 48px;
  border-radius: 24px;
  border-width: 2px;
  border-style: solid;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
  margin-top: 8px;
}

.step-title {
  font-size: 26px;
  font-weight: bold;
  margin-bottom: 6px;
  text-align: center;
  line-height: 34px;
}

.step-hint {
  font-size: 20px;
  margin-bottom: 10px;
  text-align: center;
  line-height: 28px;
}

.course-scroll {
  flex-direction: row;
  width: 100%;
  flex-shrink: 0;
  margin-bottom: 12px;
}

.course-item {
  width: 120px;
  height: 56px;
  border-radius: 10px;
  margin-right: 6px;
  justify-content: center;
  align-items: center;
  border: 2px solid transparent;
  flex-shrink: 0;
}

.course-name {
  font-size: 24px;
  line-height: 32px;
  font-weight: bold;
  text-align: center;
}

.course-add-item {
  justify-content: center;
  align-items: center;
}

.course-add-icon {
  font-size: 34px;
  line-height: 44px;
  font-weight: bold;
  text-align: center;
}

.stepper-time {
  flex-direction: column;
  align-items: center;
  border-radius: 14px;
  padding: 6px;
  margin-bottom: 6px;
}

.picker-label {
  font-size: 24px;
  font-weight: bold;
  margin-top: 6px;
  margin-bottom: 6px;
  text-align: center;
  line-height: 32px;
}

.stepper-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  flex-wrap: wrap;
}

.stepper-label {
  font-size: 20px;
  width: 100%;
  line-height: 28px;
}

.stepper-btn {
  width: 44px;
  height: 48px;
  border-radius: 22px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
}

.stepper-val {
  font-size: 28px;
  font-weight: bold;
  width: 56px;
  text-align: center;
  line-height: 48px;
}

.optional-hint {
  font-size: 24px;
  margin-bottom: 14px;
  text-align: center;
}

.weekday-label {
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 4px;
  line-height: 30px;
}

.weekday-scroll {
  width: 100%;
  height: 48px;
}

.weekday-row {
  flex-direction: row;
  justify-content: center;
}

.weekday-btn {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  border-width: 2px;
  border-style: solid;
  justify-content: center;
  align-items: center;
  margin: 0 1px;
}

.weekday-btn-active {
  background-color: #7ec8e3;
}

.weekday-btn-pending {
  background-color: transparent;
}

.day-confirm-hint {
  font-size: 18px;
  line-height: 26px;
  text-align: center;
  margin-top: 4px;
  margin-bottom: 6px;
}

.undo-bar {
  position: fixed;
  left: 8px;
  right: 8px;
  bottom: 56px;
  height: auto;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  padding: 10px 12px;
}

.undo-msg {
  flex: none;
  width: 100%;
  font-size: 20px;
  line-height: 28px;
  text-align: center;
  margin-bottom: 8px;
}

.undo-btn {
  width: 100%;
  height: 48px;
  border-radius: 12px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
  flex-shrink: 0;
  margin-left: 0;
}

.weekday-text {
  font-size: 20px;
  line-height: 40px;
  font-weight: bold;
  text-align: center;
}

.location-display {
  width: 100%;
  height: 48px;
  border-radius: 12px;
  border-width: 2px;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  padding: 0 10px;
  margin-bottom: 8px;
}

.location-text {
  font-size: 24px;
  line-height: 32px;
}

.location-cursor {
  font-size: 24px;
  margin-left: 2px;
}

.step-nav {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 10px;
}

.prev-btn {
  flex: 1;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
}

.next-btn {
  flex: 1;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
}

.save-btn {
  flex: 1;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
}

.step-delete-btn {
  width: 64px;
  height: 48px;
  border-radius: 24px;
  border-width: 2px;
  border-style: solid;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  line-height: 48px;
}

.confirm-card {
  flex-direction: column;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 16px;
}

.confirm-label {
  font-size: 24px;
  font-weight: bold;
  margin-top: 8px;
  margin-bottom: 2px;
  line-height: 32px;
}

.confirm-value {
  font-size: 20px;
  line-height: 28px;
}

.delete-hint {
  font-size: 22px;
  line-height: 30px;
  text-align: center;
  margin-top: 8px;
}

.keyboard-area {
  flex-direction: column;
  margin-top: 10px;
}

.keyboard-close-row {
  flex-direction: row;
  justify-content: flex-end;
  margin-bottom: 4px;
}

.keyboard-done-btn {
  width: 56px;
  height: 44px;
  border-radius: 10px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 44px;
}


/* ================================================================
   宽度断点：手环 10 / 胶囊屏大号（width >= 200px，内容区 ~180px）
   在 base 基础上「增量」：字号略大、间距略松、按钮略宽。
   ================================================================ */
@media (width >= 200px) {
  .edit-course-page {
    padding: 44px 10px 50px 10px;
  }
  .header {
    margin-bottom: 14px;
  }
  .back-btn-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 10px;
  }
  .title {
    font-size: 28px;
    line-height: 40px;
  }
  .step-indicator {
    margin-bottom: 16px;
  }
  .step-dot {
    width: 20px;
    height: 20px;
    border-radius: 10px;
  }
  .step-line {
    width: 40px;
    height: 4px;
    margin: 0 4px;
  }
  .missing-title {
    font-size: 28px;
    line-height: 38px;
    margin-bottom: 10px;
  }
  .missing-desc {
    font-size: 22px;
    line-height: 30px;
    margin-bottom: 6px;
  }
  .missing-btn {
    font-size: 24px;
    margin-top: 16px;
  }
  .missing-btn-ghost {
    font-size: 24px;
    margin-top: 10px;
  }
  .step-title {
    font-size: 30px;
    line-height: 38px;
    margin-bottom: 8px;
  }
  .step-hint {
    font-size: 24px;
    line-height: 32px;
    margin-bottom: 14px;
  }
  .course-scroll {
    height: 72px;
  }
  .course-item {
    width: 120px;
    height: 64px;
    border-radius: 14px;
    margin-right: 10px;
  }
  .course-name {
    font-size: 26px;
    line-height: 34px;
  }
  .course-add-icon {
    font-size: 40px;
    line-height: 48px;
  }
  .stepper-time {
    padding: 12px;
    margin-bottom: 10px;
