    font-size: 28px;
    line-height: 48px;
  }
  .title {
    font-size: 36px;
  }
  .step-indicator {
    margin-bottom: 12px;
  }
  .step-title {
    font-size: 28px;
  }
  .step-hint {
    font-size: 24px;
  }
  .course-card {
    width: 160px;
    height: 100px;
    padding: 18px;
  }
  .card-course-name {
    font-size: 28px;
  }
  .add-card-icon {
    font-size: 48px;
    line-height: 58px;
  }
  .picker-label {
    font-size: 28px;
  }
  .stepper-btn {
    width: 48px;
    height: 48px;
