  }
  .stepper-val {
    font-size: 36px;
    width: 52px;
  }
  .stepper-label {
    font-size: 24px;
  }
  .location-text {
    font-size: 28px;
  }
  .location-cursor {
    font-size: 28px;
  }
  .confirm-label {
    font-size: 28px;
  }
  .confirm-value {
    font-size: 28px;
  }
  .prev-btn,
  .next-btn,
  .save-btn {
    width: 100px;
    font-size: 24px;
  }
  .manage-btn {
    width: 80px;
    font-size: 24px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .edit-course-page {
    padding: 38px 16px 50px 16px;
  }
  /* 胶囊屏 header 改两行：第一行放两个按钮（48px 达标），第二行标题独占整宽。
     此前 48×3 = 144px 会把 160px 内容区里的标题挤到只剩 16px，只能在
     「按钮 44px」和「标题看不见」之间二选一；换行后两者兼得。
     竖向 +34px，根容器是 scroll，可滚动消化。 */
  .header {
    height: auto;
    margin-bottom: 8px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }
  /* header 换行后按钮不再与标题抢宽度，可以提到规范的 48px */
  .back-btn {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    text-align: center;
    line-height: 48px;
    flex-shrink: 0;
  }
  .header-trash-btn {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }
  .title {
    font-size: 24px;
    line-height: 34px;
    text-align: center;
    /* order 让标题排到两个按钮之后，配合 width:100% 换到第二行独占整宽 */
    order: 1;
    width: 100%;
    flex: 0 0 100%;
    lines: 1;
    margin: 4px 0 0 0;
    text-overflow: ellipsis;
  }
  .step-indicator {
    margin-bottom: 10px;
  }
  .step-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
  }
  .step-line {
    width: 24px;
    height: 3px;
    margin: 0 3px;
  }
  .step-title {
    font-size: 26px;
    line-height: 34px;
    margin-bottom: 6px;
  }
  .step-hint {
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 10px;
  }
  /* 轮播区改纵向：卡片独占第一行（全宽 160px），两个箭头落到第二行两端。
     横向布局下箭头 48×2 = 96px 会把卡片压到 56px（课名只剩 2 字），等于
     牺牲已达标的可读性；改纵向后箭头 48px 达标，卡片反而由 80px 变全宽。 */
  .swiper-wrapper {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .swipe-arrow {
    order: 1;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    font-size: 22px;
    line-height: 46px;
    flex-shrink: 0;
    margin-top: 8px;
  }
  .course-card {
    order: 0;
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    height: 80px;
    padding: 12px;
    margin: 0;
  }
  .card-course-name {
    font-size: 24px;
    font-weight: bold;
    line-height: 32px;
    lines: 1;
    text-align: center;
  }
  .add-card-icon {
    font-size: 44px;
    line-height: 53px;
  }
  .course-index-hint {
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 8px;
  }
  /* 与模板内联的 height: 48px 对齐，消除"内联压制媒体查询"的不可预测性 */
  .manage-btn {
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .next-btn {
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .prev-btn {
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .save-btn {
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .step-nav {
    margin-top: 10px;
  }
  /* 胶囊屏一行放不下「小时 − 08 +」4 个元素（需 172px > 160px），
     改为标签独占一行、控件一行 */
  .stepper-row {
    flex-wrap: wrap;
  }
  .stepper-btn {
    width: 44px;
    height: 48px;
    font-size: 24px;
    line-height: 48px;
    border-radius: 22px;
  }
  .stepper-val {
    font-size: 28px;
    line-height: 48px;
    width: 56px;
  }
  .stepper-label {
    font-size: 20px;
    line-height: 28px;
    width: 100%;
  }
  .picker-label {
    font-size: 24px;
    line-height: 32px;
    margin-top: 6px;
    margin-bottom: 6px;
  }
  .stepper-time {
    padding: 6px;
    margin-bottom: 6px;
  }
  /* 地点框点击唤起键盘，属触控目标，提到规范的 48px */
  .location-display {
    height: 48px;
    padding: 0 10px;
  }
  .location-text {
    font-size: 24px;
    line-height: 32px;
  }
  .confirm-label {
    font-size: 24px;
    line-height: 32px;
    margin-top: 8px;
    margin-bottom: 2px;
  }
  .confirm-value {
    font-size: 26px;
    line-height: 34px;
  }
  .confirm-card {
    padding: 12px;
    margin-bottom: 16px;
  }
  .delete-btn {
    height: 48px;
    font-size: 22px;
    line-height: 48px;
    border-radius: 24px;
  }
  .delete-section {
    margin-top: 12px;
  }
  .delete-hint {
    font-size: 22px;
    line-height: 30px;
    margin-bottom: 8px;
  }
  /* 上课日选择：按钮放大到 44px，保证手指点得准 */
  .weekday-label {
    font-size: 22px;
    line-height: 30px;
    margin-bottom: 4px;
  }
  .weekday-scroll {
    height: 48px;
  }
  .weekday-btn {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin: 0 1px;
  }
  .weekday-text {
    font-size: 20px;
    line-height: 40px;
  }
}

@media (shape: rect) {
  .edit-course-page {
    padding: 44px 10px 50px 10px;
  }
  .header {
    margin-bottom: 10px;
  }
  .back-btn {
