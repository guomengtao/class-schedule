  line-height: 40px;
  lines: 1;
}

.confirm-value {
  font-size: 34px;
  line-height: 42px;
  lines: 1;
}

.delete-section {
  align-items: center;
  margin-top: 20px;
}

.delete-hint {
  font-size: 24px;
  line-height: 32px;
  text-align: center;
  margin-bottom: 8px;
}

.delete-btn {
  width: 100%;
  border-radius: 12px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 44px;
  lines: 1;
}

.keyboard-area {
  flex-direction: column;
  margin-top: 10px;
}

.keyboard-close-row {
  flex-direction: row;
  justify-content: flex-end;
  margin-bottom: 4px;
}

.keyboard-done-btn {
  width: 56px;
