    height: 3px;
    margin: 0 3px;
  }
  .step-title {
    font-size: 26px;
    line-height: 34px;
    margin-bottom: 6px;
  }
  .step-hint {
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 10px;
    lines: 1;
    text-overflow: ellipsis;
  }
  /* 三个元素强制一行：箭头宽度压到 36px（高度仍 48px 达标），
     卡片 flex:1 吃掉剩余约 80px，课名 22px + ellipsis 兜底。
     192px 物理宽度下这是唯一能同时满足「一行」与「触控高度 48px」的分配。 */
  .swiper-wrapper {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
  }
  .swipe-arrow-icon {
    width: 36px;
    height: 48px;
    border-radius: 18px;
    flex-shrink: 0;
  }
  .course-card {
    flex: 1;
    min-width: 0;
    width: auto;
    height: 80px;
    padding: 6px;
    margin: 0 4px;
  }
  .card-course-name {
    font-size: 22px;
    font-weight: bold;
    line-height: 30px;
    lines: 1;
    text-align: center;
    text-overflow: ellipsis;
  }
  .day-confirm-hint {
    font-size: 18px;
    line-height: 26px;
    margin-top: 4px;
    margin-bottom: 6px;
  }
  .missing-title {
    font-size: 24px;
    line-height: 32px;
    margin-bottom: 8px;
  }
  .missing-desc {
    font-size: 18px;
    line-height: 26px;
    margin-bottom: 4px;
  }
  .missing-btn,
  .missing-btn-ghost {
    font-size: 20px;
    line-height: 48px;
    margin-top: 10px;
  }
  .missing-btn-ghost {
    margin-top: 8px;
  }
  /* 胶囊屏 192px：内容区只有 160px，单行放「文案 + 64px 按钮」会把文案压到几十 px，
     改为两行：第一行整宽文案居中，第二行整宽撤销按钮（高度提到 48px 合规）。
     bottom 56px 用于避开底部系统 UI。 */
  .undo-bar {
    left: 8px;
    right: 8px;
    bottom: 56px;
    height: auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
  }
  .undo-msg {
    flex: none;
    width: 100%;
    font-size: 20px;
    line-height: 28px;
    text-align: center;
    margin-bottom: 8px;
  }
  .undo-btn {
    width: 100%;
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    margin-left: 0;
  }
  .add-card-icon {
    font-size: 44px;
    line-height: 53px;
  }
  .course-index-hint {
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 8px;
  }
  /* 与模板内联的 height: 48px 对齐，消除"内联压制媒体查询"的不可预测性 */
  .step-delete-btn {
    width: 64px;
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .next-btn {
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .prev-btn {
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .save-btn {
    height: 48px;
    font-size: 20px;
    line-height: 48px;
    border-radius: 24px;
    lines: 1;
  }
  .step-nav {
    margin-top: 10px;
  }
  /* 胶囊屏一行放不下「小时 − 08 +」4 个元素（需 172px > 160px），
     改为标签独占一行、控件一行 */
  .stepper-row {
    flex-wrap: wrap;
  }
  .stepper-btn {
    width: 44px;
    height: 48px;
    font-size: 24px;
    line-height: 48px;
    border-radius: 22px;
  }
  .stepper-val {
    font-size: 28px;
    line-height: 48px;
    width: 56px;
  }
  .stepper-label {
    font-size: 20px;
    line-height: 28px;
    width: 100%;
  }
  .picker-label {
    font-size: 24px;
    line-height: 32px;
    margin-top: 6px;
    margin-bottom: 6px;
  }
  .stepper-time {
    padding: 6px;
    margin-bottom: 6px;
  }
  /* 地点框点击唤起键盘，属触控目标，提到规范的 48px */
  .location-display {
    height: 48px;
    padding: 0 10px;
  }
  .location-text {
    font-size: 24px;
    line-height: 32px;
  }
  .confirm-label {
    font-size: 24px;
    line-height: 32px;
    margin-top: 8px;
    margin-bottom: 2px;
  }
  .confirm-value {
    font-size: 26px;
    line-height: 34px;
    lines: 2;
    text-overflow: ellipsis;
  }
  .confirm-card {
    padding: 12px;
    margin-bottom: 16px;
  }
  .delete-hint {
    font-size: 22px;
    line-height: 30px;
    margin-top: 8px;
  }
  /* 上课日选择：按钮放大到 44px，保证手指点得准 */
  .weekday-label {
