<template>
  <!--
    功能表盘 ⑥ · 保险版
    显示「确定支持、且本地可取」的信息：时间 / 日期 / 星期 / 设备型号 / 分辨率 / 电量。
    · 电量用 @system.battery：**手环 9/9Pro 官方不支持** → 调用失败即整卡隐藏（静默降级，不报错不黑屏）。
    · 空间 / 手电筒：Vela 无对应 API，本版**不做**。
    骨架照经典表盘 watch-face.ux（flex 居中，无 absolute 子元素），规避黑屏。
  -->
  <div class="page" onclick="onTap">
    <text class="clock" style="color: {{ fgColor }}">{{ timeText }}</text>
    <text class="date" style="color: {{ subColor }}">{{ dateText }}</text>

    <div class="rows">
      <div class="row">
        <text class="k" style="color: {{ subColor }}">设备</text>
        <text class="v" style="color: {{ fgColor }}">{{ modelText }}</text>
      </div>
      <div class="row">
        <text class="k" style="color: {{ subColor }}">屏幕</text>
        <text class="v" style="color: {{ fgColor }}">{{ screenText }}</text>
      </div>
      <div class="row" if="{{ batteryText }}">
        <text class="k" style="color: {{ subColor }}">电量</text>
        <text class="v" style="color: {{ fgColor }}">{{ batteryText }}</text>
      </div>
    </div>

    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const WEEK = ["日", "一", "二", "三", "四", "五", "六"]

/* 电量 API 用 require + try-catch 兜住：
   若模块不可用（或机型不支持），不该让整页加载失败 → 静默不可用。 */
let battery = null
try {
  battery = require("@system.battery")
} catch (e) {
  battery = null
}

export default {
  data: {
    timeText: "--:--",
    dateText: "--",
    modelText: "--",
    screenText: "--",
    batteryText: "",
    fgColor: "#e8e4da",
    subColor: "#8a8aa0"
  },

  onInit() {
    this.tick()
    this.loadDevice()
    this.loadBattery()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* 时间：1s 心跳；每 60 拍顺带刷新一次电量 */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.beat = 0
    this.timer = setInterval(function() {
      self.tick()
      self.beat++
      if (self.beat >= 60) {
        self.beat = 0
        self.loadBattery()
      }
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const t = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
    const d = (now.getMonth() + 1) + "月" + now.getDate() + "日 周" + WEEK[now.getDay()]
    if (d !== this.dateText) this.dateText = d
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* 设备信息（@system.device，项目已在用，安全） */
  loadDevice() {
    const self = this
    try {
      const device = require("@system.device")
      device.getInfo({
        success: function(info) {
          if (!info) return
          const brand = info.brand || ""
          const model = info.model || ""
          const name = (brand + " " + model).trim()
          if (name) self.modelText = name
          const w = info.screenWidth
          const h = info.screenHeight
          if (w && h) self.screenText = w + "×" + h
        },
        fail: function() {}
      })
    } catch (e) {
      /* 取不到就保持占位符，不影响其它信息 */
    }
  },

  /* 电量（@system.battery）：成功才显示，失败/不支持 → 整卡隐藏 */
  loadBattery() {
    if (!battery || typeof battery.getStatus !== "function") {
      return
    }
    const self = this
    try {
      battery.getStatus({
        success: function(res) {
          if (res && typeof res.level === "number") {
            const pct = Math.round(res.level * 100)
            self.batteryText = res.charging ? (pct + "% 充电中") : (pct + "%")
          } else {
            self.batteryText = ""
          }
        },
        fail: function() {
          self.batteryText = ""
        }
      })
    } catch (e) {
      this.batteryText = ""
    }
  },

  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #101820;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .clock {
    font-size: 60px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .date {
    margin-top: 8px;
    font-size: 24px;
  }

  .rows {
    margin-top: 26px;
    flex-direction: column;
    align-items: center;
  }

  .row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
  }

  .k {
    font-size: 22px;
    width: 76px;
    text-align: right;
    margin-right: 10px;
  }

  .v {
    font-size: 22px;
    width: 150px;
    text-align: left;
  }

  .back {
    margin-top: 26px;
    font-size: 22px;
    color: #888899;
  }
</style>
