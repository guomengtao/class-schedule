<template>
  <!--
    功能表盘 ⑥（v2）· 空间使用 / 剩余空间 + 电量（带图表与小图标）
    ── 数据来源（均官方支持）──
    · 空间：@system.device 的 device.getTotalStorage() / getAvailableStorage()（单位 Byte）
      已用 = 总 - 可用；配 <progress> 进度条呈现比例。
    · 电量：@system.battery（**手环9/9Pro 不支持 → 整项隐藏**，静默降级）；配自绘「电池小图标」+ 进度条。
    ── 说明 ──
    · 用官方 <progress percent color> 组件画简易图表（比自绘 div 更稳）。
    · 电池图标用 div 手绘（外壳 + 电芯 + 正极帽），零外部资源。
    · 骨架照经典表盘（flex 居中，无 absolute 子元素），规避黑屏。
  -->
  <div class="page">
    <text class="clock {{ clockCls }}" style="color: {{ fgColor }}">{{ timeText }}</text>
    <text class="date {{ dateCls }}" style="color: {{ subColor }}">{{ dateText }}</text>

    <div class="item {{ itemCls }}">
      <div class="head {{ headCls }}">
        <text class="k {{ kvCls }}" style="color: {{ subColor }}">空间使用</text>
        <text class="v {{ kvCls }}" style="color: {{ fgColor }}">{{usedStr}} / {{totalStr}}</text>
      </div>
      <progress class="bar {{ barCls }}" percent="{{usedPct}}" color="#ff9a3c"></progress>
    </div>

    <div class="item {{ itemCls }}">
      <div class="head {{ headCls }}">
        <text class="k {{ kvCls }}" style="color: {{ subColor }}">剩余空间</text>
        <text class="v {{ kvCls }}" style="color: {{ fgColor }}">{{availStr}}</text>
      </div>
      <progress class="bar {{ barCls }}" percent="{{availPct}}" color="#4ade80"></progress>
    </div>

    <div class="item {{ itemCls }}" if="{{ batteryText }}">
      <div class="head {{ headCls }}">
        <text class="k {{ kvCls }}" style="color: {{ subColor }}">电量</text>
        <div class="head-right">
          <!-- 电池小图标 -->
          <div class="batt {{ battCls }}">
            <div class="batt-shell {{ shellCls }}">
              <div class="batt-level {{ levelCls }}" style="width: {{battW}}px; background-color: {{battColor}}"></div>
            </div>
            <div class="batt-nub {{ nubCls }}" style="background-color: {{battColor}}"></div>
          </div>
          <text class="v {{ kvCls }}" style="color: {{ fgColor }}">{{batteryText}}</text>
        </div>
      </div>
      <progress class="bar {{ barCls }}" percent="{{battPct}}" color="{{battColor}}"></progress>
    </div>

    <text class="back {{ backCls }}" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const WEEK = ["日", "一", "二", "三", "四", "五", "六"]

/* 电量 API 用 require + try-catch 兜住：机型不支持也不该让整页加载失败 */
let battery = null
try {
  battery = require("@system.battery")
} catch (e) {
  battery = null
}

const KB = 1024
const MB = 1024 * 1024
const GB = 1024 * 1024 * 1024

export default {
  data: {
    timeText: "--:--",
    dateText: "--",
    fgColor: "#e8e4da",
    subColor: "#8a8aa0",
    usedStr: "--", totalStr: "--", availStr: "--",
    usedPct: 0, availPct: 0,
    batteryText: "", battPct: 0, battW: 0, battColor: "#4ade80",
    /* 宽屏适配：电量芯净宽（= 壳宽 − 2×2 边框），186/192 屏为 30，336 屏探针改成 52 */
    battLevel: 0, battInner: 30,
    /* 宽屏单类，`w >= 300` 才由 fitScreen 填值；192 屏保持空串 = 零回归 */
    clockCls: "", dateCls: "", itemCls: "", headCls: "", kvCls: "",
    barCls: "", battCls: "", shellCls: "", levelCls: "", nubCls: "", backCls: ""
  },

  onInit() {
    this.fitScreen()
    this.tick()
    this.loadStorage()
    this.loadBattery()
  },

  onReady() {
    this.fitScreen()
    this.refresh()
  },

  /* 宽屏探针：手环10Pro 336×480 专用。必须异步回调，同步取会拿到错值。
     192 屏 `w < 300` 直接 return，11 个类全空、battInner 保持 30 = 零回归。 */
  /* 宽屏探针：手环10Pro 336×480 专用。
     ① 必须用「页内 require」而非顶部 import —— 本页原本就在 loadStorage 里 require 同一个
        @system.device，两者并存时顶部 import 出来的绑定取不到，getInfo 调用静默抛错（被 catch 吞掉），
        表现是宽屏类全空、页面看着完全没适配。
     ② 必须从 onInit 调起 —— 本页 onReady 不触发（分层探针实测停在 onInit，之后再无进展）。
     192 屏 `w < 300` 直接 return，11 个类全空、battInner 保持 30 = 零回归。 */
  fitScreen() {
    const self = this
    try {
      const dev = require("@system.device")
      dev.getInfo({
        success: function(d) {
          const w = d && d.screenWidth ? d.screenWidth : 0
          if (w < 300) return
          self.clockCls = "w-clock"
          self.dateCls = "w-date"
          self.itemCls = "w-item"
          self.headCls = "w-head"
          self.kvCls = "w-kv"
          self.barCls = "w-bar"
          self.battCls = "w-batt"
          self.shellCls = "w-shell"
          self.levelCls = "w-level"
          self.nubCls = "w-nub"
          self.backCls = "w-back"
          self.battInner = 52
          /* 电量在 onInit 已按 30 算过一次 battW，这里用存下的 level 重算：
             漏掉这行，宽屏上 100% 电量只画 30/52 格（看着像半格电） */
          if (self.battLevel) self.battW = Math.round(self.battLevel * 52)
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.beat = 0
    this.timer = setInterval(function() {
      self.tick()
      self.beat++
      if (self.beat >= 60) {
        self.beat = 0
        self.loadBattery()
      }
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const t = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
    const d = (now.getMonth() + 1) + "月" + now.getDate() + "日 周" + WEEK[now.getDay()]
    if (d !== this.dateText) this.dateText = d
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  fmt(bytes) {
    if (!bytes && bytes !== 0) return "--"
    if (bytes >= GB) return (bytes / GB).toFixed(1) + "GB"
    if (bytes >= MB) return Math.round(bytes / MB) + "MB"
    return Math.round(bytes / KB) + "KB"
  },

  /* 空间：总容量 + 可用 → 已用/剩余 + 百分比 */
  loadStorage() {
    const self = this
    try {
      /* 改名 devApi：与 fitScreen 里的 dev 区分，避免同页两处同名局部 */
      const devApi = require("@system.device")
      devApi.getTotalStorage({
        success: function(t) {
          if (!t || !t.totalStorage) return
          const total = t.totalStorage
          self.totalStr = self.fmt(total)
          devApi.getAvailableStorage({
            success: function(a) {
              if (!a || typeof a.availableStorage !== "number") return
              const avail = a.availableStorage
              const used = total - avail
              self.availStr = self.fmt(avail)
              self.usedStr = self.fmt(used)
              self.usedPct = total > 0 ? Math.round((used / total) * 100) : 0
              self.availPct = total > 0 ? Math.round((avail / total) * 100) : 0
            },
            fail: function() {}
          })
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  /* 电量：成功才显示整项；失败/不支持 → batteryText 保持空 → 整项隐藏 */
  loadBattery() {
    if (!battery || typeof battery.getStatus !== "function") return
    const self = this
    try {
      battery.getStatus({
        success: function(res) {
          if (res && typeof res.level === "number") {
            const pct = Math.round(res.level * 100)
            self.battPct = pct
            self.batteryText = res.charging ? (pct + "% 充电中") : (pct + "%")
            self.battLevel = res.level
            self.battW = Math.round(res.level * self.battInner)
            self.battColor = pct <= 20 ? "#ff5f6d" : (pct <= 50 ? "#ffd166" : "#4ade80")
          }
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #101820;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .clock {
    font-size: 48px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .date {
    margin-top: 4px;
    font-size: 22px;
  }

  .item {
    width: 158px;
    flex-direction: column;
    margin-top: 16px;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 158px;
  }

  .head-right {
    flex-direction: row;
    align-items: center;
  }

  .k {
    font-size: 22px;
  }

  .v {
    font-size: 22px;
  }

  .bar {
    width: 158px;
    margin-top: 6px;
    stroke-width: 12px;
  }

  /* 电池小图标：外壳 + 电芯 + 正极帽 */
  .batt {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
  }

  .batt-shell {
    width: 34px;
    height: 16px;
    border: 2px solid #8899aa;
    border-radius: 4px;
    flex-direction: column;
    justify-content: center;
  }

  .batt-level {
    height: 8px;
    border-radius: 2px;
  }

  .batt-nub {
    width: 3px;
    height: 8px;
    border-radius: 2px;
  }

  .back {
    margin-top: 24px;
    font-size: 22px;
    color: #888899;
  }

  /* ── 宽屏（336×480 手环10Pro）· 全部单类选择器 ──
     Vela 不支持后代选择器（`.w-page .x` 会退化成 `.x` 套到所有屏），
     故每个宽屏样式独立成类，由 fitScreen 挂到元素上。 */
  .w-clock {
    font-size: 84px;
    letter-spacing: 3px;
  }

  .w-date {
    margin-top: 6px;
    font-size: 28px;
  }

  .w-item {
    width: 276px;
  }

  .w-head {
    width: 276px;
  }

  /* .k / .v 共用同一个宽屏类，避免两处字号不一致 */
  .w-kv {
    font-size: 28px;
  }

  .w-bar {
    width: 276px;
    stroke-width: 18px;
  }

  .w-batt {
    margin-right: 12px;
  }

  /* 壳 56×26（净宽 52 = JS battInner），芯与帽按同比例抬 */
  .w-shell {
    width: 56px;
    height: 26px;
  }

  .w-level {
    height: 13px;
  }

  .w-nub {
    width: 5px;
    height: 13px;
  }

  .w-back {
    margin-top: 20px;
    font-size: 28px;
  }
</style>
