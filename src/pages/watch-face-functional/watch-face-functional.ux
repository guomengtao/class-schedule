<template>
  <!--
    功能表盘 ⑥（v2）· 空间使用 / 剩余空间 + 电量（带图表与小图标）
    ── 数据来源（均官方支持）──
    · 空间：@system.device 的 device.getTotalStorage() / getAvailableStorage()（单位 Byte）
      已用 = 总 - 可用；配 <progress> 进度条呈现比例。
    · 电量：@system.battery（**手环9/9Pro 不支持 → 整项隐藏**，静默降级）；配自绘「电池小图标」+ 进度条。
    ── 说明 ──
    · 用官方 <progress percent color> 组件画简易图表（比自绘 div 更稳）。
    · 电池图标用 div 手绘（外壳 + 电芯 + 正极帽），零外部资源。
    · 骨架照经典表盘（flex 居中，无 absolute 子元素），规避黑屏。
  -->
  <div class="page" onclick="onTap">
    <text class="clock" style="color: {{ fgColor }}">{{ timeText }}</text>
    <text class="date" style="color: {{ subColor }}">{{ dateText }}</text>

    <div class="item">
      <div class="head">
        <text class="k" style="color: {{ subColor }}">空间使用</text>
        <text class="v" style="color: {{ fgColor }}">{{usedStr}} / {{totalStr}}</text>
      </div>
      <progress class="bar" percent="{{usedPct}}" color="#ff9a3c"></progress>
    </div>

    <div class="item">
      <div class="head">
        <text class="k" style="color: {{ subColor }}">剩余空间</text>
        <text class="v" style="color: {{ fgColor }}">{{availStr}}</text>
      </div>
      <progress class="bar" percent="{{availPct}}" color="#4ade80"></progress>
    </div>

    <div class="item" if="{{ batteryText }}">
      <div class="head">
        <text class="k" style="color: {{ subColor }}">电量</text>
        <div class="head-right">
          <!-- 电池小图标 -->
          <div class="batt">
            <div class="batt-shell">
              <div class="batt-level" style="width: {{battW}}px; background-color: {{battColor}}"></div>
            </div>
            <div class="batt-nub" style="background-color: {{battColor}}"></div>
          </div>
          <text class="v" style="color: {{ fgColor }}">{{batteryText}}</text>
        </div>
      </div>
      <progress class="bar" percent="{{battPct}}" color="{{battColor}}"></progress>
    </div>

    <text class="back" onclick="goBack">返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const WEEK = ["日", "一", "二", "三", "四", "五", "六"]

/* 电量 API 用 require + try-catch 兜住：机型不支持也不该让整页加载失败 */
let battery = null
try {
  battery = require("@system.battery")
} catch (e) {
  battery = null
}

const KB = 1024
const MB = 1024 * 1024
const GB = 1024 * 1024 * 1024

export default {
  data: {
    timeText: "--:--",
    dateText: "--",
    fgColor: "#e8e4da",
    subColor: "#8a8aa0",
    usedStr: "--", totalStr: "--", availStr: "--",
    usedPct: 0, availPct: 0,
    batteryText: "", battPct: 0, battW: 0, battColor: "#4ade80"
  },

  onInit() {
    this.tick()
    this.loadStorage()
    this.loadBattery()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
    this.loadStorage()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.beat = 0
    this.timer = setInterval(function() {
      self.tick()
      self.beat++
      if (self.beat >= 60) {
        self.beat = 0
        self.loadBattery()
      }
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const t = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
    const d = (now.getMonth() + 1) + "月" + now.getDate() + "日 周" + WEEK[now.getDay()]
    if (d !== this.dateText) this.dateText = d
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  fmt(bytes) {
    if (!bytes && bytes !== 0) return "--"
    if (bytes >= GB) return (bytes / GB).toFixed(1) + "GB"
    if (bytes >= MB) return Math.round(bytes / MB) + "MB"
    return Math.round(bytes / KB) + "KB"
  },

  /* 空间：总容量 + 可用 → 已用/剩余 + 百分比 */
  loadStorage() {
    const self = this
    try {
      const device = require("@system.device")
      device.getTotalStorage({
        success: function(t) {
          if (!t || !t.totalStorage) return
          const total = t.totalStorage
          self.totalStr = self.fmt(total)
          device.getAvailableStorage({
            success: function(a) {
              if (!a || typeof a.availableStorage !== "number") return
              const avail = a.availableStorage
              const used = total - avail
              self.availStr = self.fmt(avail)
              self.usedStr = self.fmt(used)
              self.usedPct = total > 0 ? Math.round((used / total) * 100) : 0
              self.availPct = total > 0 ? Math.round((avail / total) * 100) : 0
            },
            fail: function() {}
          })
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  /* 电量：成功才显示整项；失败/不支持 → batteryText 保持空 → 整项隐藏 */
  loadBattery() {
    if (!battery || typeof battery.getStatus !== "function") return
    const self = this
    try {
      battery.getStatus({
        success: function(res) {
          if (res && typeof res.level === "number") {
            const pct = Math.round(res.level * 100)
            self.battPct = pct
            self.batteryText = res.charging ? (pct + "% 充电中") : (pct + "%")
            self.battW = Math.round(res.level * 30)
            self.battColor = pct <= 20 ? "#ff5f6d" : (pct <= 50 ? "#ffd166" : "#4ade80")
          }
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #101820;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .clock {
    font-size: 48px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .date {
    margin-top: 4px;
    font-size: 22px;
  }

  .item {
    width: 158px;
    flex-direction: column;
    margin-top: 16px;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 158px;
  }

  .head-right {
    flex-direction: row;
    align-items: center;
  }

  .k {
    font-size: 22px;
  }

  .v {
    font-size: 22px;
  }

  .bar {
    width: 158px;
    margin-top: 6px;
    stroke-width: 12px;
  }

  /* 电池小图标：外壳 + 电芯 + 正极帽 */
  .batt {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
  }

  .batt-shell {
    width: 34px;
    height: 16px;
    border: 2px solid #8899aa;
    border-radius: 4px;
    flex-direction: column;
    justify-content: center;
  }

  .batt-level {
    height: 8px;
    border-radius: 2px;
  }

  .batt-nub {
    width: 3px;
    height: 8px;
    border-radius: 2px;
  }

  .back {
    margin-top: 24px;
    font-size: 22px;
    color: #888899;
  }
</style>
