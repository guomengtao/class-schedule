<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">测试区</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="clock-row">
      <text class="clock-text" style="color: {{ theme.accent }}">{{ currentTime }}</text>
    </div>

    <div class="list">
      <div class="card" for="{{ items }}" onclick="openPage($item.uri)" style="background-color: {{ theme.card }}">
        <div class="card-body">
          <text class="card-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="card-desc" style="color: {{ theme.textMuted }}">{{ $item.desc }}</text>
        </div>
        <image class="card-arrow-img" src="/common/icons/{{ iconTheme }}/icon_chevron_right.png"></image>
      </div>
    </div>

    <div class="empty-state" if="items.length === 0">
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无测试页面</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var GALLERY = [
  { name: "倒数日", desc: "事件倒计时管理", uri: "/pages/countdown-manage" },
  { name: "二维码生成", desc: "文字转二维码工具", uri: "/pages/qrcode-generator" },
  { name: "已钉页面", desc: "首页置顶入口管理", uri: "/pages/pinned-pages" },
  { name: "Header CSS Demo1", desc: "方案一测试页1 — CSS import 共享头部", uri: "/pages/header-demo1" },
  { name: "Header CSS Demo2", desc: "方案一测试页2 — 同CSS不同页面", uri: "/pages/header-demo2" }
]

export default {
  private: {
    iconTheme: "dark",
    items: GALLERY,
    currentTime: "",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.updateClock()
    self.clockTimer = setInterval(function() {
      self.updateClock()
    }, 30000)
  },

  onDestroy() {
    if (this.clockTimer) {
      clearInterval(this.clockTimer)
      this.clockTimer = null
    }
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  updateClock() {
    var now = new Date()
    var h = now.getHours()
    var m = now.getMinutes()
    this.currentTime = (h < 10 ? "0" + h : h) + ":" + (m < 10 ? "0" + m : m)
  },

  openPage(uri) {
    if (uri) {
      router.push({ uri: uri })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';

.page-root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 38px 8px 10px 8px;
  overflow: hidden;
}

.clock-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 8px;
}

.clock-text {
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  line-height: 44px;
}

.list {
  flex-direction: column;
  padding-bottom: 10px;
}

.card {
  flex-direction: row;
  align-items: center;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 8px;
}

.card-body {
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 26px;
  line-height: 34px;
  lines: 1;
  margin-bottom: 2px;
}

.card-desc {
  font-size: 20px;
  line-height: 26px;
  lines: 1;
}

.card-arrow-img {
  width: 16px;
  height: 16px;
  margin-left: 8px;
}

.empty-state {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 40px;
}

.empty-text {
  font-size: 22px;
  line-height: 30px;
  text-align: center;
}

@media (shape: rect) {
  .page-root {
    padding: 44px 12px 16px 12px;
  }
  
  .clock-row {
    margin-bottom: 12px;
  }
  .clock-text {
    font-size: 40px;
    line-height: 48px;
  }
  
  
  .card {
    padding: 18px 18px;
    margin-bottom: 12px;
    border-radius: 14px;
  }
  .card-name {
    font-size: 28px;
    line-height: 38px;
  }
  .card-desc {
    font-size: 22px;
    line-height: 30px;
  }
}

@media (shape: circle) {
  .page-root {
    padding: 44px 36px 44px 36px;
  }
  .clock-text {
    font-size: 36px;
    line-height: 44px;
  }
  
  
  .card-name {
    font-size: 26px;
  }
  .card-desc {
    font-size: 20px;
  }
}
</style>