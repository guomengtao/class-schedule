<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">功能实验室</text>
    </div>

    <text class="hint" style="color: {{ theme.textSecondary }}">新功能体验区，欢迎反馈建议</text>

    <div class="list-scroll">
      <div class="list-row" for="(idx, item) in labItems" style="background-color: {{ theme.card }}">
        <input class="pin-check" type="checkbox" checked="{{ item.pinned }}" onclick="onTogglePin(idx)"
               style="accent-color: {{ theme.accent }}" />
        <div class="row-main" onclick="onOpenItem(idx)">
          <text class="row-name" style="color: {{ theme.text }}">{{ item.name }}</text>
          <text class="row-desc" style="color: {{ theme.textMuted }}">{{ item.desc }}</text>
        </div>
        <div class="row-actions">
          <input class="action-btn sort-btn" type="button" value="▲" onclick="onMoveUp(idx)"
                 style="color: {{ theme.textMuted }}" />
          <input class="action-btn sort-btn" type="button" value="▼" onclick="onMoveDown(idx)"
                 style="color: {{ theme.textMuted }}" />
          <input class="action-btn del-btn" type="button" value="✕" onclick="onDelete(idx)"
                 style="color: {{ theme.deleteText }}" />
        </div>
      </div>
    </div>

    <div class="add-section">
      <div class="add-header" onclick="toggleAddPanel" style="background-color: {{ theme.card }}">
        <text class="add-label" style="color: {{ theme.accent }}">+ 添加页面</text>
        <text class="add-arrow" style="color: {{ theme.textMuted }}">{{ showAddPanel ? '▼' : '▶' }}</text>
      </div>
      <div class="add-list" if="{{ showAddPanel }}">
        <div class="add-row" for="item in availablePages" onclick="onAddItem(item.uri)"
             style="background-color: {{ theme.cardLight }}">
          <text class="add-name" style="color: {{ theme.text }}">{{ item.name }}</text>
          <text class="add-desc" style="color: {{ theme.textMuted }}">{{ item.desc }}</text>
        </div>
        <text class="no-more" if="{{ availablePages.length === 0 }}"
              style="color: {{ theme.textMuted }}">没有更多可添加的页面</text>
      </div>
    </div>

    <text class="dev-hint" onclick="onDevExpireClick" style="color: {{ theme.textSecondary }}">丰富欢迎用户提交意见建议</text>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")
var labList = require("../home-module-demo/modules/lab-list.js")

export default {
  private: {
    labItems: [],
    availablePages: [],
    showAddPanel: false,
    devClickCount: 0,
    labStatus: "loading",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      keyBg: "#1a1a3e",
      keyBorder: "#2a2a5a",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080",
      icon: "🔵",
      progressOngoing: "rgba(126,200,227,0.2)",
      progressDone: "rgba(74,138,154,0.25)"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadList()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadList()
  },

  loadList() {
    var self = this
    labList.init(self, function() {
      self.refreshAvailable()
    })
  },

  onOpenItem(idx) {
    var item = this.labItems[idx]
    if (item && item.uri) {
      router.push({ uri: item.uri })
    }
  },

  onTogglePin(idx) {
    var self = this
    labList.togglePin(self, idx, function() {})
  },

  onMoveUp(idx) {
    labList.moveUp(this, idx)
  },

  onMoveDown(idx) {
    labList.moveDown(this, idx)
  },

  onDelete(idx) {
    var self = this
    labList.deleteItem(self, idx, function() {
      self.refreshAvailable()
    })
  },

  toggleAddPanel() {
    var self = this
    if (!this.showAddPanel) {
      labList.getAvailablePages(this.labItems, function(pages) {
        self.availablePages = pages
        self.showAddPanel = true
      })
    } else {
      this.showAddPanel = false
    }
  },

  onAddItem(uri) {
    var self = this
    labList.addItem(self, uri, function() {
      self.showAddPanel = false
      self.refreshAvailable()
    })
  },

  refreshAvailable() {
    var self = this
    if (this.showAddPanel) {
      labList.getAvailablePages(this.labItems, function(pages) {
        self.availablePages = pages
      })
    }
  },

  onDevExpireClick() {
    this.devClickCount++
    if (this.devClickCount >= 5) {
      this.devClickCount = 0
      var self = this
      authStore.getAuthData(function(data) {
        if (!data) {
          data = {
            installTime: Date.now() - 8 * 24 * 60 * 60 * 1000,
            trialDays: 7,
            history: [],
            lastRemindDate: "",
            remindEnabled: true
          }
        }
        data.isActivated = true
        data.isPermanent = false
        data.expireAt = Date.now() - 1
        if (!data.activatedAt) {
          data.activatedAt = Date.now() - 8 * 24 * 60 * 60 * 1000
        }
        authStore.setAuthData(data, function() {
          prompt.showToast({ message: "已设置为过期状态，请返回首页查看效果" })
        })
      })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page-root {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 44px 8px 8px 8px;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.hint {
  font-size: 12px;
  margin-bottom: 8px;
  padding: 0 4px;
  line-height: 1.4;
}

.list-scroll {
  flex: 1;
  flex-direction: column;
  overflow: scroll;
}

.list-row {
  flex-direction: row;
  align-items: center;
  border-radius: 8px;
  padding: 10px 8px;
  margin-bottom: 4px;
}

.pin-check {
  width: 24px;
  height: 24px;
  margin-right: 6px;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.row-name {
  font-size: 14px;
  margin-bottom: 2px;
}

.row-desc {
  font-size: 10px;
}

.row-actions {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 4px;
}

.action-btn {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  font-size: 12px;
  text-align: center;
  margin-left: 2px;
  background-color: transparent;
  border: 1px solid transparent;
}

.sort-btn {
  border: none;
  width: 24px;
  height: 24px;
  font-size: 10px;
}

.del-btn {
  border: none;
  width: 24px;
  height: 24px;
  font-size: 14px;
  font-weight: bold;
}

.add-section {
  margin-top: 6px;
  flex-shrink: 0;
}

.add-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 8px;
  padding: 10px 12px;
}

.add-label {
  font-size: 14px;
  font-weight: bold;
}

.add-arrow {
  font-size: 12px;
}

.add-list {
  flex-direction: column;
  max-height: 200px;
  overflow: scroll;
  margin-top: 4px;
}

.add-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 6px;
  padding: 8px 12px;
  margin-bottom: 2px;
}

.add-name {
  font-size: 13px;
  flex: 1;
}

.add-desc {
  font-size: 10px;
  margin-left: 8px;
}

.no-more {
  text-align: center;
  font-size: 11px;
  padding: 8px;
}

.dev-hint {
  font-size: 13px;
  text-align: center;
  padding: 8px 12px;
  line-height: 1.5;
  flex-shrink: 0;
}

@media (shape: circle) {
  .page-root {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: capsule) {
  .page-root {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page-root {
    padding: 44px 6px 6px 6px;
  }
}
</style>