<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">测试区</text>
    </div>

    <div class="list">
      <div class="card" for="{{ items }}" onclick="openPage($item.uri)" style="background-color: {{ theme.card }}">
        <div class="card-body">
          <text class="card-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="card-desc" style="color: {{ theme.textMuted }}">{{ $item.desc }}</text>
        </div>
        <text class="card-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="empty-state" if="items.length === 0">
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无测试页面</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var GALLERY = [
  { name: "倒数日", desc: "事件倒计时管理", uri: "/pages/countdown-manage" },
  { name: "二维码生成", desc: "文字转二维码工具", uri: "/pages/qrcode-generator" },
  { name: "已钉页面", desc: "首页置顶入口管理", uri: "/pages/pinned-pages" },
  { name: "Header CSS Demo1", desc: "方案一测试页1 — CSS import 共享头部", uri: "/pages/header-demo1" },
  { name: "Header CSS Demo2", desc: "方案一测试页2 — 同CSS不同页面", uri: "/pages/header-demo2" }
]

export default {
  private: {
    items: GALLERY,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  openPage(uri) {
    if (uri) {
      router.push({ uri: uri })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

