        </div>
      </div>

      <div class="menu-item" onclick="openActivationLab" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">激活码实验室</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">激活码加密解密测试</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openMultiFileDemo" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">多文件组合 Demo</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">多 JS 模块组合页面测试</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openLabModuleTest" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">多模块加载测试</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">3 个独立 JS 模块组合加载</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <text class="dev-expire-hint" onclick="onDevExpireClick" style="color: {{ theme.textSecondary }}">丰富欢迎用户提交意见建议</text>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}; font-size: 13px;">📌 固定到首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")
var pinHelper = require("../../data/pin-helper.js")

export default {
  private: {
    devClickCount: 0,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  openQrcodeGenerator() {
    router.push({ uri: "/pages/qrcode-generator" })
  },

  openPinnedPages() {
    router.push({ uri: "/pages/pinned-pages" })
  },

  openStorageViewer() {
    router.push({ uri: "/pages/storage-viewer" })
  },

  openVibrationLab() {
    router.push({ uri: "/pages/vibration-lab" })
  },

  openScheduleManagerV2() {
    router.push({ uri: "/pages/schedule-manager" })
  },

  openCheckDemo() {
    router.push({ uri: "/pages/check-demo" })
  },

  openDeviceInfo() {
    router.push({ uri: "/pages/device-info" })
  },

  openAccordionDemo() {
    router.push({ uri: "/pages/accordion-demo" })
  },

  openAddCourseDemo() {
    router.push({ uri: "/pages/add-course-demo" })
  },

  openCompDemo() {
    router.push({ uri: "/pages/comp-demo" })
  },

  openActivationLab() {
    router.push({ uri: "/pages/activation-lab" })
  },

  openMultiFileDemo() {
    router.push({ uri: "/pages/multi-file-demo" })
  },

  openLabModuleTest() {
    router.push({ uri: "/pages/lab-module-test" })
  },

  pinToHome() {
    pinHelper.pinPage("功能实验室", "/pages/test-area")
  },

  onDevExpireClick() {
    this.devClickCount++
    if (this.devClickCount >= 5) {
      this.devClickCount = 0
      var self = this
      authStore.getAuthData(function(data) {
        if (!data) {
          data = {
            installTime: Date.now() - 8 * 24 * 60 * 60 * 1000,
            trialDays: 7,
            history: [],
            lastRemindDate: '',
            remindEnabled: true
          }
        }
        data.isActivated = true
        data.isPermanent = false
        data.expireAt = Date.now() - 1
        if (!data.activatedAt) {
          data.activatedAt = Date.now() - 8 * 24 * 60 * 60 * 1000
        }
        authStore.setAuthData(data, function() {
          prompt.showToast({ message: '已设置为过期状态，请返回首页查看效果' })
        })
      })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

