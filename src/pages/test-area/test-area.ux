<template>
  <div class="test-area-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">功能实验室</text>
    </div>

    <text class="section-desc" style="color: {{ theme.textSecondary }}">这里是正在开发中的新功能，欢迎体验并反馈建议，你的意见对我们很重要。</text>

    <div class="menu-section">
      <div class="menu-item" onclick="openPromptDemo" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">弹窗演示</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">Toast 弹窗效果体验</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openQrcodeTest" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">二维码容量检测</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">检测组件文字上限</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openQrcodeGenerator" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">文字转二维码</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">将文字生成二维码</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openBackgroundRunning" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">后台运行</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">测试后台保活功能</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openVibrationLab" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">震动自定义</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">自定义震动效果</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openDeviceInfo" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">设备信息</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">查看详情</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openActivation" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">软件授权</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">爱发电购买兑换码激活</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>

      <div class="menu-item" onclick="openNumpadInput" style="background-color: {{ theme.card }}">
        <text class="menu-label" style="color: {{ theme.text }}">数字输入</text>
        <div class="menu-right">
          <text class="menu-desc" style="color: {{ theme.textMuted }}">4x4 格子 + 数字键盘</text>
          <text class="menu-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <text class="secret-text" onclick="onSecretTap" style="color: {{ theme.textMuted }}">这里是正在开发中的新功能</text>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    secretTapCount: 0,
    secretTapTimer: null
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  openPromptDemo() {
    router.push({ uri: "/pages/prompt-demo" })
  },

  openQrcodeTest() {
    router.push({ uri: "/pages/qrcode-test" })
  },

  openQrcodeGenerator() {
    router.push({ uri: "/pages/qrcode-generator" })
  },

  openBackgroundRunning() {
    router.push({ uri: "/pages/background-running" })
  },

  openVibrationLab() {
    router.push({ uri: "/pages/vibration-lab" })
  },

  openDeviceInfo() {
    router.push({ uri: "/pages/device-info" })
  },

  openActivation() {
    router.push({ uri: "/pages/activation" })
  },

  openNumpadInput() {
    router.push({ uri: "/pages/numpad-input" })
  },

  onSecretTap() {
    var self = this
    self.secretTapCount = self.secretTapCount + 1
    if (self.secretTapTimer) {
      clearTimeout(self.secretTapTimer)
    }
    if (self.secretTapCount >= 3) {
      self.secretTapCount = 0
      router.push({ uri: "/pages/activation-lab-demo" })
      return
    }
    self.secretTapTimer = setTimeout(function() {
      self.secretTapCount = 0
    }, 2000)
  },

  goBack() {
    router.back()
  }
}
</script>

