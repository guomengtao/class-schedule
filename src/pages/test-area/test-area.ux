<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">测试区</text>
    </div>

    <text class="section-label" style="color: {{ theme.textSecondary }}">测试与实验功能</text>

    <div class="list">
      <div class="card" for="{{(idx, item) in items}}" onclick="openPage(item.uri)" style="background-color: {{ theme.card }}">
        <text class="card-name" style="color: {{ theme.text }}">{{ item.name }}</text>
        <text class="card-desc" style="color: {{ theme.textMuted }}">{{ item.desc }}</text>
        <text class="card-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div if="{{ items.length === 0 }}" class="empty-box" style="background-color: {{ theme.card }}">
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无测试页面</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var GALLERY = [
  { name: "倒数日", desc: "事件倒计时管理", uri: "/pages/countdown-manage" }
]

export default {
  private: {
    items: GALLERY,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  openPage(uri) {
    if (uri) {
      router.push({ uri: uri })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

