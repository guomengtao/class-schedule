<template>
  <!--
    背景表盘 ⑤ · 背景色多种多样可切换
    骨架完全照经典表盘 watch-face.ux（已验证不黑屏）：
      · .page flex 居中；文字/按钮正常流；面板用 absolute overlay
      · 「背景」按钮 → 弹出背景面板（6 套背景，每项用自身底色预览），storage 持久化
      · 「返回」按钮 + 点击空白处返回
    本表盘差异：整页背景色 + 文字色由所选背景决定。
  -->
  <div class="page" style="background-color: {{ bgColor }}" onclick="onTap">
    <text class="clock" style="color: {{ fgColor }}">{{ timeText }}</text>
    <text class="btn-color" onclick="openPanel">背景</text>
    <text class="back" onclick="goBack">返回</text>

    <!-- 背景选择面板 -->
    <div class="mask" if="{{ showPanel }}" onclick="closePanel">
      <div class="panel">
        <text class="p-title">背景</text>
        <div class="opt" style="background-color: {{ b0bg }}" onclick="pick(0)">
          <text class="opt-t" style="color: {{ b0fg }}">午夜蓝</text>
        </div>
        <div class="opt" style="background-color: {{ b1bg }}" onclick="pick(1)">
          <text class="opt-t" style="color: {{ b1fg }}">松林绿</text>
        </div>
        <div class="opt" style="background-color: {{ b2bg }}" onclick="pick(2)">
          <text class="opt-t" style="color: {{ b2fg }}">暖阳</text>
        </div>
        <div class="opt" style="background-color: {{ b3bg }}" onclick="pick(3)">
          <text class="opt-t" style="color: {{ b3fg }}">玫红</text>
        </div>
        <div class="opt" style="background-color: {{ b4bg }}" onclick="pick(4)">
          <text class="opt-t" style="color: {{ b4fg }}">静谧紫</text>
        </div>
        <div class="opt" style="background-color: {{ b5bg }}" onclick="pick(5)">
          <text class="opt-t" style="color: {{ b5fg }}">纯黑</text>
        </div>
        <text class="p-cancel" onclick="closePanel">取消</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

const storage = require("@system.storage")

const LIST_PAGE = "/pages/watch-face-list"
const BG_KEY = "wf_background_index"

/* 6 套背景：bg = 整页底色，fg = 文字色 */
const BGS = [
  { name: "午夜蓝", bg: "#1a1a2e", fg: "#e8e4da" },
  { name: "松林绿", bg: "#12341f", fg: "#d6f5e3" },
  { name: "暖阳", bg: "#3a2410", fg: "#ffe0b3" },
  { name: "玫红", bg: "#3a1030", fg: "#ffd6f0" },
  { name: "静谧紫", bg: "#241b3a", fg: "#e6d9ff" },
  { name: "纯黑", bg: "#000000", fg: "#ffffff" }
]

export default {
  data: {
    timeText: "--:--",
    bgColor: "#1a1a2e",
    fgColor: "#e8e4da",
    b0bg: "#1a1a2e", b0fg: "#e8e4da",
    b1bg: "#12341f", b1fg: "#d6f5e3",
    b2bg: "#3a2410", b2fg: "#ffe0b3",
    b3bg: "#3a1030", b3fg: "#ffd6f0",
    b4bg: "#241b3a", b4fg: "#e6d9ff",
    b5bg: "#000000", b5fg: "#ffffff",
    showPanel: false,
    suppressTap: false
  },

  onInit() {
    this.loadBg()
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* ── 时间：1s 心跳，只在分钟变化时写文本 ── */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const now = new Date()
    const t = this.pad(now.getHours()) + ":" + this.pad(now.getMinutes())
    if (t !== this.timeText) this.timeText = t
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* ── 背景持久化 ── */
  applyBg(i) {
    const b = BGS[i] || BGS[0]
    this.bgColor = b.bg
    this.fgColor = b.fg
  },

  loadBg() {
    const self = this
    try {
      storage.get({
        key: BG_KEY,
        success: function(res) {
          var i = 0
          if (res && res.value !== undefined && res.value !== null) {
            i = parseInt(res.value, 10)
            if (isNaN(i)) i = 0
          }
          self.applyBg(i)
        },
        fail: function() {
          self.applyBg(0)
        }
      })
    } catch (e) {
      this.applyBg(0)
    }
  },

  saveBg(i) {
    try {
      storage.set({ key: BG_KEY, value: String(i) })
    } catch (e) {}
  },

  /* ── 面板开关 ── */
  openPanel() {
    this.suppressTap = true
    this.showPanel = true
  },

  closePanel() {
    this.showPanel = false
    const self = this
    setTimeout(function() {
      self.suppressTap = false
    }, 300)
  },

  pick(i) {
    this.applyBg(i)
    this.saveBg(i)
    this.closePanel()
  },

  /* ── 返回 ── */
  onTap() {
    if (this.suppressTap) return
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .clock {
    font-size: 64px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .btn-color {
    margin-top: 36px;
    font-size: 22px;
    color: #7ec8e3;
  }

  .back {
    margin-top: 14px;
    font-size: 22px;
    color: #888899;
  }

  /* ── 背景面板 ── */
  .mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
  }

  .panel {
    width: 260px;
    flex-direction: column;
    align-items: center;
    background-color: #16213e;
    border-radius: 12px;
    padding: 16px 12px 12px 12px;
  }

  .p-title {
    font-size: 22px;
    color: #ffffff;
    margin-bottom: 8px;
  }

  /* 每个背景项：用自身底色做预览 */
  .opt {
    width: 100%;
    height: 44px;
    margin-bottom: 6px;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
  }

  .opt-t {
    font-size: 24px;
  }

  .p-cancel {
    margin-top: 4px;
    font-size: 22px;
    color: #888899;
  }
</style>
