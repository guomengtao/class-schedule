<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <text class="title" style="color: {{ theme.text }}">页面未找到</text>
    </div>

    <div class="content" style="background-color: {{ theme.card }}">
      <text class="error-code" style="color: {{ theme.accent }}">404</text>
      <text class="error-msg" style="color: {{ theme.textMuted }}">该页面不存在或已被移除</text>
      <text class="error-hint" style="color: {{ theme.textMuted }}">请检查链接是否正确</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {}
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  goBack() {
    router.back()
  }
}
</script>

