<template>
  <div class="week-view-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">课程总览</text>
      <input class="rotate-toggle" type="button" value="{{ isLandscape ? '竖' : '横' }}" onclick="toggleLandscape" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
    </div>

    <text class="schedule-name" style="color: {{ theme.accent }}">{{ scheduleName }}</text>

    <div class="grid-wrapper" if="{{ !isLandscape }}">
      <div class="week-header">
        <text class="week-day {{ $idx === todayIndex ? 'today-day' : '' }}" for="{{ weekDays }}" style="color: {{ $idx === todayIndex ? theme.accent : theme.textSecondary }}">{{ $item }}</text>
      </div>

      <div class="grid-scroll">
        <div class="grid-container">
          <div for="{{ timeSlots }}" class="time-row">
            <text class="time-label" style="color: {{ theme.textSecondary }}">{{ $item.time }}</text>
            <div class="course-row">
              <div for="{{ $item.cells }}" class="course-cell {{ $item.isCurrent ? 'current-course' : '' }}" onclick="showDetail($item.day, $item.course)" style="background-color: {{ $item.course ? theme.cardLight : 'transparent' }}">
                <text class="course-char" if="{{ $item.course }}" style="color: {{ theme.accent }}">{{ $item.course.char }}</text>
                <text class="course-empty" if="{{ !$item.course }}" style="color: {{ theme.textMuted }}">·</text>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid-wrapper landscape-mode" if="{{ isLandscape }}">
      <div class="landscape-header">
        <text class="landscape-time-header" for="{{ timeHeaders }}" style="color: {{ theme.textSecondary }}">{{ $item }}</text>
      </div>
      <div class="landscape-scroll">
        <div class="landscape-container">
          <div for="{{ landscapeDays }}" class="landscape-day-row">
            <text class="landscape-day-label {{ $item.isToday ? 'today-day' : '' }}" style="color: {{ $item.isToday ? theme.accent : theme.textSecondary }}">{{ $item.dayShort }}</text>
            <div class="landscape-course-row">
              <div for="{{ $item.cells }}" class="landscape-cell {{ $item.isCurrent ? 'current-course' : '' }}" onclick="showDetail($item.day, $item.course)" style="background-color: {{ $item.course ? theme.cardLight : 'transparent' }}">
                <text class="landscape-char" if="{{ $item.course }}" style="color: {{ theme.accent }}">{{ $item.course.char }}</text>
                <text class="landscape-empty" if="{{ !$item.course }}" style="color: {{ theme.textMuted }}">·</text>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer" style="background-color: {{ theme.card }}">
      <text class="footer-text" style="color: {{ theme.textSecondary }}">共 {{ totalCourses }} 门课程</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const scheduleSeed = require("../../data/schedule.js")

var fullDayNames = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]
var dayShortNames = ["一", "二", "三", "四", "五", "六", "日"]

export default {
  private: {
    weekDays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
    scheduleName: "",
    timeSlots: [],
    landscapeDays: [],
    timeHeaders: [],
    totalCourses: 0,
    viewIndex: 0,
    todayIndex: 0,
    currentCourseDay: "",
    currentCourseTime: "",
    isLandscape: false,
    _initDone: false,
    theme: {}
  },

  onInit() {
    var self = this
    var now = new Date()
    var dayIdx = now.getDay()
    self.todayIndex = dayIdx === 0 ? 6 : dayIdx - 1
    store.getTheme(function(t) {
      self.theme = t
    })
    var storage = require("@system.storage")
    storage.get({
      key: "weekview_landscape",
      success: function(data) {
        if (data === "true") {
          self.isLandscape = true
        }
      },
      fail: function() {}
    })
    storage.get({
      key: "weekview_index",
      success: function(data) {
        if (data) {
          self.viewIndex = parseInt(data) || 0
        }
        console.log("[WEEK-VIEW] onInit: viewIndex=" + self.viewIndex)
        self._initDone = true
        self.loadData()
      },
      fail: function() {
        self._initDone = true
        self.loadData()
      }
    })
    setTimeout(function() {
      if (!self._initDone) {
        console.log("[WEEK-VIEW] onInit fallback: storage.get did not fire, loading anyway")
        self._initDone = true
        self.loadData()
      }
    }, 800)
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.loadData()
  },

  loadData() {
    var self = this

    store.getScheduleNames(function(names) {
      store.getCurrentScheduleIndex(function(idx) {
        if (names && names.length > self.viewIndex) {
          self.scheduleName = names[self.viewIndex]
        }
      })
    })

    console.log("[WEEK-VIEW] loadData: viewIndex=" + this.viewIndex)
    var dataLoaded = false
    database.getAllCoursesWithIndex(this.viewIndex, function(schedule) {
      if (dataLoaded) return
      dataLoaded = true
      console.log("[WEEK-VIEW] schedule received: " + JSON.stringify(schedule ? schedule.length : "null") + " days")
      if (!schedule) {
        console.log("[WEEK-VIEW] schedule is null/undefined, returning")
        return
      }

      var allCourses = {}
      for (var d = 0; d < schedule.length; d++) {
        var dayData = schedule[d]
        if (dayData && dayData.day) {
          allCourses[dayData.day] = dayData.classes || []
        }
      }

      var totalCourses = 0
      for (var key in allCourses) {
        if (allCourses.hasOwnProperty(key)) {
          totalCourses += allCourses[key].length
        }
      }
      console.log("[WEEK-VIEW] totalCourses from schedule: " + totalCourses)

      if (totalCourses === 0) {
        console.log("[WEEK-VIEW] no courses found, loading default seed data")
        var seedData = scheduleSeed.schedule
        allCourses = {}
        for (var sd = 0; sd < seedData.length; sd++) {
          var sdd = seedData[sd]
          if (sdd && sdd.day) {
            allCourses[sdd.day] = sdd.classes || []
          }
        }
      }

      self.detectCurrentCourse(allCourses)
      self.buildTimeSlots(allCourses)

      var total = 0
      for (var key in allCourses) {
        if (allCourses.hasOwnProperty(key)) {
          total += allCourses[key].length
        }
      }
      self.totalCourses = total
      console.log("[WEEK-VIEW] buildTimeSlots done, totalCourses=" + self.totalCourses + ", timeSlots=" + self.timeSlots.length)
    })

    setTimeout(function() {
      if (!dataLoaded) {
        console.log("[WEEK-VIEW] loadData fallback: database callback did not fire, loading seed data")
        dataLoaded = true
        var seedData = scheduleSeed.schedule
        var allCourses = {}
        for (var sd = 0; sd < seedData.length; sd++) {
          var sdd = seedData[sd]
          if (sdd && sdd.day) {
            allCourses[sdd.day] = sdd.classes || []
          }
        }
        self.detectCurrentCourse(allCourses)
        self.buildTimeSlots(allCourses)
        var total = 0
        for (var key in allCourses) {
          if (allCourses.hasOwnProperty(key)) {
            total += allCourses[key].length
          }
        }
        self.totalCourses = total
        console.log("[WEEK-VIEW] loadData fallback done, totalCourses=" + self.totalCourses)
      }
    }, 1500)
  },

  buildTimeSlots(allCourses) {
    var self = this
    var timeSet = {}
    var dayList = fullDayNames

    for (var d = 0; d < dayList.length; d++) {
      var day = dayList[d]
      var courses = allCourses[day] || []
      for (var c = 0; c < courses.length; c++) {
        var time = courses[c].time
        if (time && !timeSet[time]) {
          timeSet[time] = true
        }
      }
    }

    var timeKeys = Object.keys(timeSet)
    timeKeys.sort(function(a, b) {
      var aStart = a.split("-")[0].trim()
      var bStart = b.split("-")[0].trim()
      if (aStart < bStart) return -1
      if (aStart > bStart) return 1
      return 0
    })

    var timeSlots = []
    for (var t = 0; t < timeKeys.length; t++) {
      var time = timeKeys[t]
      var cells = []
      for (var d = 0; d < dayList.length; d++) {
        var day = dayList[d]
        var courses = allCourses[day] || []
        var matched = null
        for (var c = 0; c < courses.length; c++) {
          if (courses[c].time === time) {
            matched = courses[c]
            break
          }
        }
        if (matched) {
          cells.push({
            day: day,
            isCurrent: day === self.currentCourseDay && time === self.currentCourseTime,
            course: {
              id: matched.id,
              name: matched.name,
              char: self.getFirstChar(matched.name),
              time: matched.time,
              teacher: matched.teacher,
              location: matched.location
            }
          })
        } else {
          cells.push({
            day: day,
            isCurrent: false,
            course: null
          })
        }
      }
      timeSlots.push({
        time: time,
        cells: cells
      })
    }

    this.timeSlots = timeSlots
    console.log("[WEEK-VIEW] built " + timeSlots.length + " time slots")
    this.buildLandscapeData(allCourses, timeKeys)
  },

  buildLandscapeData(allCourses, timeKeys) {
    var self = this
    var dayList = fullDayNames
    var todayName = dayList[self.todayIndex]

    this.timeHeaders = timeKeys

    var landscapeDays = []
    for (var d = 0; d < dayList.length; d++) {
      var day = dayList[d]
      var courses = allCourses[day] || []
      var cells = []
      for (var t = 0; t < timeKeys.length; t++) {
        var time = timeKeys[t]
        var matched = null
        for (var c = 0; c < courses.length; c++) {
          if (courses[c].time === time) {
            matched = courses[c]
            break
          }
        }
        if (matched) {
          cells.push({
            day: day,
            time: time,
            isCurrent: day === self.currentCourseDay && time === self.currentCourseTime,
            course: {
              id: matched.id,
              name: matched.name,
              char: self.getFirstChar(matched.name),
              time: matched.time,
              teacher: matched.teacher,
              location: matched.location
            }
          })
        } else {
          cells.push({
            day: day,
            time: time,
            isCurrent: false,
            course: null
          })
        }
      }
      landscapeDays.push({
        day: day,
        dayShort: dayShortNames[d],
        isToday: day === todayName,
        isCurrentDay: day === self.currentCourseDay,
        cells: cells
      })
    }
    this.landscapeDays = landscapeDays
    console.log("[WEEK-VIEW] built " + landscapeDays.length + " landscape day rows")
  },

  getFirstChar(name) {
    if (!name) return "?"
    return name.charAt(0)
  },

  detectCurrentCourse(allCourses) {
    var todayName = fullDayNames[this.todayIndex]
    var now = new Date()
    var currentTime = now.getHours() * 60 + now.getMinutes()

    this.currentCourseDay = ""
    this.currentCourseTime = ""

    var todayCourses = allCourses[todayName]
    if (!todayCourses) return

    for (var i = 0; i < todayCourses.length; i++) {
      var course = todayCourses[i]
      var timeRange = course.time
      if (!timeRange) continue
      var parts = timeRange.split("-")
      if (parts.length !== 2) continue
      var startParts = parts[0].trim().split(":")
      var endParts = parts[1].trim().split(":")
      var startTime = parseInt(startParts[0]) * 60 + parseInt(startParts[1])
      var endTime = parseInt(endParts[0]) * 60 + parseInt(endParts[1])
      if (currentTime >= startTime && currentTime <= endTime) {
        this.currentCourseDay = todayName
        this.currentCourseTime = course.time
        return
      }
    }
  },

  showDetail(day, course) {
    if (!course) return
    console.log("[WEEK-VIEW] showDetail: " + course.name + " (" + day + ")")
    var storage = require("@system.storage")
    storage.set({
      key: "detail_classId",
      value: String(course.id)
    })
    storage.set({
      key: "detail_day",
      value: day
    })
    router.push({
      uri: "/pages/detail"
    })
  },

  goBack() {
    router.back()
  },

  toggleLandscape() {
    console.log("[WEEK-VIEW] toggleLandscape: " + this.isLandscape + " -> " + !this.isLandscape)
    this.isLandscape = !this.isLandscape
    var storage = require("@system.storage")
    storage.set({
      key: "weekview_landscape",
      value: String(this.isLandscape),
      success: function() {},
      fail: function() {}
    })
  }
}
</script>

<style>
.week-view-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 8px;
  height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

