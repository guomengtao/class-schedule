  width: 60px;
  height: 36px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 14px;
  color: #7ec8e3;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  flex: 1;
  text-align: center;
}

.rotate-toggle {
  width: 40px;
  height: 32px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 14px;
  color: #7ec8e3;
  text-align: center;
}

.schedule-name {
  font-size: 13px;
  color: #7ec8e3;
  text-align: center;
  margin-bottom: 4px;
}

.week-header {
  flex-direction: row;
  background-color: #0f3460;
  border-radius: 6px;
  padding: 4px 0;
  margin-bottom: 4px;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 12px;
  font-weight: bold;
  color: #7ec8e3;
}

.week-day.today-day {
  font-size: 14px;
  text-decoration: underline;
}

.grid-wrapper {
  flex: 1;
  flex-direction: column;
}

.grid-wrapper.landscape-mode {
  flex-direction: column;
}

.landscape-header {
  flex-direction: row;
  background-color: #0f3460;
  border-radius: 6px;
  padding: 4px 0;
  margin-bottom: 4px;
}

.landscape-time-header {
  flex: 1;
  text-align: center;
  font-size: 10px;
  font-weight: bold;
  color: #7ec8e3;
}

.landscape-scroll {
  flex: 1;
  flex-direction: column;
  overflow: auto;
}

.landscape-container {
  flex-direction: column;
}

.landscape-day-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 2px;
  min-height: 32px;
}

.landscape-day-label {
  width: 20px;
  font-size: 12px;
  font-weight: bold;
  color: #7ec8e3;
  text-align: center;
  padding-right: 4px;
}

.landscape-day-label.today-day {
  font-size: 14px;
  text-decoration: underline;
}

.landscape-course-row {
  flex: 1;
  flex-direction: row;
}

.landscape-cell {
  flex: 1;
  height: 30px;
  margin: 1px;
  border-radius: 4px;
  justify-content: center;
  align-items: center;
  background-color: #16213e;
}

.landscape-cell.current-course {
  border: 2px solid #7ec8e3;
  margin: 0;
}

.landscape-char {
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.landscape-empty {
  font-size: 12px;
  color: #333355;
  text-align: center;
}

.grid-scroll {
  flex: 1;
  flex-direction: column;
  overflow: auto;
}

.grid-container {
  flex-direction: column;
}

.time-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 2px;
  min-height: 32px;
}

.time-label {
  width: 50px;
  font-size: 10px;
  color: #888899;
  text-align: right;
  padding-right: 6px;
}

.course-row {
  flex: 1;
  flex-direction: row;
}

.course-cell {
  flex: 1;
  height: 30px;
  margin: 1px;
  border-radius: 4px;
  justify-content: center;
  align-items: center;
  background-color: #16213e;
}

.course-cell.current-course {
  border: 2px solid #7ec8e3;
  margin: 0;
}

.course-char {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.course-empty {
  font-size: 14px;
  color: #333355;
  text-align: center;
}

.footer {
  padding: 6px 0;
  align-items: center;
}

.footer-text {
  font-size: 11px;
  color: #555566;
  text-align: center;
}
</style>