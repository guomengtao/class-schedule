<template>
  <div class="wv-page" style="background-color:{{ theme.bg }}">
    <!-- 页头（2026-11-03）：改用 common/header.css 的 .hdr 胶囊方案，与设置页一致 ——
         「‹ 总课表」一颗整体胶囊、整块可点返回，取代原来的
         「方块返回键 + 居中标题」两段式。
         旧类 .wv-header / .wv-back-wrapper / .wv-title 已从本页样式表删除，
         理由同 settings 页：公共文件与页面本地同名类在同特异性下「页面后加载」会
         静默赢，留着就是定时炸弹（quickapp 不支持 !important）。
         标题 3 字，28px 在 192 屏预算内（胶囊宽 ≈121px / 可用 168px）。 -->
    <div class="hdr">
      <div class="hdr-pill" onclick="goBack" style="background-color:{{ theme.card }}">
        <image class="hdr-pill-ic" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        <text class="hdr-pill-t" style="color:{{ theme.text }}">总课表</text>
      </div>
    </div>

    <!-- grid area -->
    <scroll class="wv-grid-scroll" scroll-x="true" scroll-y="true">
      <!-- skeleton loading -->
      <div if="{{ isLoading }}" class="wv-scroll-inner" style="min-width:{{ gridContentWidth }}px">
        <div class="wv-day-row">
          <text if="{{ showRowNum }}" class="wv-day-spacer" style="width:{{ rowNumWidth }}px"></text>
          <text if="{{ !showRowNum }}" class="wv-day-spacer" style="width:0px"></text>
          <text class="wv-day-cell {{ $idx === todayIndex ? 'wv-today' : '' }}" for="{{ weekDays }}" style="width:{{ cellWidth }}px;color:{{ $idx === todayIndex ? theme.accent : theme.textSecondary }}">{{ $item }}</text>
        </div>
        <div for="{{ skeletonRows }}" class="wv-row" style="min-height:{{ rowHeight }}px">
          <text if="{{ showRowNum }}" class="wv-time" style="width:{{ rowNumWidth }}px"></text>
          <text if="{{ !showRowNum }}" class="wv-time" style="width:0px;padding-right:0"></text>
          <div class="wv-cells">
            <div for="{{ weekDays }}" class="wv-skel-cell" style="width:{{ cellWidth }}px;height:{{ cellHeight }}px;border-radius:{{ cellRadius }};background-color:{{ theme.borderLight }};"></div>
          </div>
        </div>
      </div>

      <!-- real content -->
      <div if="{{ !isLoading }}" class="wv-scroll-inner" style="min-width:{{ gridContentWidth }}px">
        <!-- day header -->
        <div class="wv-day-row">
          <text if="{{ showRowNum }}" class="wv-day-spacer" style="width:{{ rowNumWidth }}px"></text>
          <text if="{{ !showRowNum }}" class="wv-day-spacer" style="width:0px"></text>
          <text class="wv-day-cell {{ $idx === todayIndex ? 'wv-today' : '' }}" for="{{ weekDays }}" style="width:{{ cellWidth }}px;color:{{ $idx === todayIndex ? theme.accent : theme.textSecondary }};font-size:{{ transparentCells ? '20px' : '' }}">{{ $item }}</text>
        </div>

        <!-- course rows -->
        <div for="{{ timeSlots }}" class="wv-row" style="min-height:{{ rowHeight }}px">
          <text if="{{ showRowNum }}" class="wv-time" style="width:{{ rowNumWidth }}px;color:{{ theme.textSecondary }}">{{ rowNumMode === 'index' ? ($idx + 1) : $item.time }}</text>
          <text if="{{ !showRowNum }}" class="wv-time" style="width:0px;padding-right:0"></text>
          <div class="wv-cells">
            <div for="{{ $item.cells }}" class="wv-cell {{ $item.isCurrent ? 'wv-now' : '' }} {{ !$item.course ? 'wv-cell-empty' : '' }} {{ transparentCells ? 'wv-cell-text' : '' }} {{ cellBordered ? 'wv-cell-bordered' : '' }}" onclick="showDetail($item.day, $item.course)" style="width:{{ cellWidth }}px;margin:{{ cellMargin }}px;background-color:{{ $item.bg }};border-radius:{{ cellRadius }};height:{{ cellHeight }}px;{{ cellBordered ? 'border-color:' + theme.borderLight : '' }}">
              <text if="{{ $item.course }}" class="wv-name {{ nameLines > 1 ? 'wv-name-2l' : '' }} {{ transparentCells ? 'wv-name-transparent' : '' }} {{ $item.isCurrent && transparentCells ? 'wv-name-now' : '' }}" style="color:{{ $item.fg }};font-size:{{ nameFontSize }}px;line-height:{{ nameLineHeight }}px;font-weight:{{ nameFontWeight }}">{{ $item.nameText }}</text>
              <text if="{{ $item.course && showRoom && $item.course.location }}" class="wv-info" style="color:{{ theme.textMuted }};font-size:{{ infoFontSize }}px">{{ $item.course.location }}</text>
              <text if="{{ $item.course && showTeacher && $item.course.teacher }}" class="wv-info" style="color:{{ theme.textMuted }};font-size:{{ infoFontSize }}px">{{ $item.course.teacher }}</text>
              <text if="{{ $item.course && $item.course.extraCount > 0 && showExtraBadge }}" class="wv-extra" style="color:{{ theme.textMuted }}">+{{ $item.course.extraCount }}</text>
              <text if="{{ !$item.course && paletteEmptyDot }}" class="wv-empty" style="color:{{ theme.textMuted }}">·</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>

    <!-- footer（2026-11-03 三次调整）：模板切换条保留，下面只留一枚「⇄ + 课程表名」胶囊 ——
         它是全页唯一的「链接」：点击进课程表管理页（/pages/schedule-manager），
         与首页 .schedule-indicator-row 同一目的地、同一形态（图标 + 名称）。
         命名：本页是「总课表」，底部要回答「我在看的是哪一张课表」，故必须带名称；
         首版只放一枚空 ⇄ 圆钮，信息量为零，用户当场要求补名称。
         样式仍取首页 .schedule-indicator 的度量（18px 字 / 圆角 16 / 图标 18），
         但类名一律 wv- 前缀，避免与首页同名类在同特异性下互相静默覆盖。 -->
    <div class="wv-footer" style="background-color:{{ theme.card }}">
      <scroll class="wv-tpl-row" scroll-x="true">
        <div for="{{ templateList }}" class="wv-tpl {{ $item.id === currentTplId ? 'wv-tpl-on' : '' }}" onclick="switchTemplate($item.id)" style="background-color:{{ $item.id === currentTplId ? $item.activeColor : theme.borderLight }};color:{{ $item.id === currentTplId ? '#fff' : theme.textSecondary }};border-color:{{ $item.id === currentTplId ? $item.activeColor : 'transparent' }}">
          <text class="wv-tpl-text">{{ $item.label }}</text>
        </div>
      </scroll>

      <div class="wv-bottom-buttons">
        <div class="wv-sched-pill" onclick="openScheduleManager" style="background-color:{{ theme.cardLight }}">
          <image class="wv-sched-icon" src="/common/icons/{{ iconTheme }}/icon_swap.png"></image>
          <text class="wv-sched-name" style="color:{{ theme.text }}">{{ scheduleName || '课程表' }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
const database = require("../../data/database.js")
const prompt = require("@system.prompt")
const device = require("@system.device")

// --- debug logger ---
var log = (function() {
  var seq = 0
  return function(msg, data) {
    seq++
    var line = "[WV:" + seq + "] " + msg
    if (data !== undefined) {
      try { line += " " + JSON.stringify(data) } catch(e) { line += " " + String(data) }
    }
    dlog(line)
  }
})()

// map Chinese day names (from DB) to English (used internally)
var DAY_NAME_MAP = {
  "星期一": "Monday", "星期二": "Tuesday", "星期三": "Wednesday",
  "星期四": "Thursday", "星期五": "Friday", "星期六": "Saturday", "星期日": "Sunday",
  "Monday": "Monday", "Tuesday": "Tuesday", "Wednesday": "Wednesday",
  "Thursday": "Thursday", "Friday": "Friday", "Saturday": "Saturday", "Sunday": "Sunday"
}

// English → Chinese：detail 只认"星期X"（DAY_NAMES），而 week-view 内部用英文键（Monday）。
// 缺这层转换会导致 周视图→编辑页 100% 显示"这门课已经被删除"（detail 兜底到星期日找不到课）。
var EN_TO_CN_DAY = {
  "Monday": "星期一", "Tuesday": "星期二", "Wednesday": "星期三",
  "Thursday": "星期四", "Friday": "星期五", "Saturday": "星期六", "Sunday": "星期日"
}
function toCnDay(day) {
  return EN_TO_CN_DAY[day] || day
}

// Week-view compute cache: avoids rebuilding timeSlots when data/template unchanged
var _renderCache = null

// Data-layer cache: stores raw allCourses to skip storage I/O across template switches
var _cachedAllCourses = null
var _cachedViewIndex = -1

function dataFingerprint(allCourses) {
  var parts = []
  var keys = Object.keys(allCourses).sort()
  for (var i = 0; i < keys.length; i++) {
    var day = keys[i]
    var courses = allCourses[day] || []
    for (var j = 0; j < courses.length; j++) {
      parts.push(day + "|" + courses[j].id + "|" + courses[j].time + "|" + courses[j].name)
    }
  }
  return parts.join(",")
}

function clearRenderCache() {
  _renderCache = null
}

function clearDataCache() {
  _cachedAllCourses = null
  _cachedViewIndex = -1
}

var SUBJECT_COLORS = {
  "math": "rgba(74,144,217,0.3)",
  "eng": "rgba(80,184,108,0.3)",
  "chn": "rgba(155,89,182,0.3)",
  "phy": "rgba(230,126,34,0.3)",
  "pe": "rgba(231,76,60,0.3)",
  "chem": "rgba(26,188,156,0.3)",
  "bio": "rgba(243,156,18,0.3)",
  "history": "rgba(52,152,219,0.3)",
  "geo": "rgba(233,30,99,0.3)",
  "default": "rgba(100,100,120,0.2)"
}

var SUBJECT_TEXT_COLORS = {
  "math": "#6aaaff",
  "eng": "#6ae6a0",
  "chn": "#c08ae0",
  "phy": "#f0a050",
  "pe": "#f06060",
  "chem": "#50d0b0",
  "bio": "#f0c040",
  "history": "#60b0f0",
  "geo": "#f060a0",
  "default": "#aaaac0"
}

function guessSubjectKey(name) {
  if (!name) return "default"
  var n = name.toLowerCase()
  if (n.indexOf("math") !== -1 || n.indexOf("数") !== -1) return "math"
  if (n.indexOf("eng") !== -1 || n.indexOf("英") !== -1) return "eng"
  if (n.indexOf("chn") !== -1 || n.indexOf("语") !== -1 || n.indexOf("文") !== -1) return "chn"
  if (n.indexOf("phy") !== -1 || n.indexOf("物") !== -1) return "phy"
  if (n.indexOf("pe") !== -1 || n.indexOf("体") !== -1 || n.indexOf("体育") !== -1) return "pe"
  if (n.indexOf("chem") !== -1 || n.indexOf("化") !== -1) return "chem"
  if (n.indexOf("bio") !== -1 || n.indexOf("生") !== -1) return "bio"
  if (n.indexOf("history") !== -1 || n.indexOf("史") !== -1 || n.indexOf("历史") !== -1) return "history"
  if (n.indexOf("geo") !== -1 || n.indexOf("地") !== -1) return "geo"
  return "default"
}

// ═══════════════════════════════════════════════════════════════════════
// T-09 / D-12：外观拆成两个正交维度 —— 布局 × 配色
//
// LAYOUT_CONFIGS  只管「几何与信息密度」：字号 / 行数 / 格尺寸 / 圆角 / 行号列 / 显示字段，
//                 **不含任何颜色字段**。
// PALETTE_CONFIGS 只管「颜色」，不碰任何尺寸。
//
// 旧单维 `TEMPLATE_CONFIGS` 已移除；老 id 由 LEGACY_TEMPLATE_MAP 一次性映射，
// 保证存量用户升级后外观逐像素不变（S1 验收标准）。
//
// 为什么不直接把「标准」和「跟随系统」合并成一个 full-name 布局：
// 二者除配色外还差「圆角 6 vs 10」与「行号列 time vs index」，合并会改变视觉，
// S1 的「截图字节零差异」验收将失效。收敛为 5 档属 T-10 / Q-06 的视觉决策，
// 故 S1 保留 `full-name-index` 作为第 6 个布局档，待视觉决策后再合并。
// ═══════════════════════════════════════════════════════════════════════
var LAYOUT_CONFIGS = {
  // 大字单字：36px 首字，格最小（D-01）
  "big-char": {
    showRowNum: false, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: false, showTotal: false,
    nameDisplay: "char",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "6px", rowHeight: 58, cellHeight: 52, rowNumWidth: 0,
    nameLines: 1, nameFontSize: 36, nameLineHeight: 42, nameFontWeight: "bold", infoFontSize: 0,
    denseMode: false, cellWidth: 42, cellMargin: 0,
    showExtraBadge: false, capsuleAutoWidth: true, hideTimeColumnOnRect: false
  },
  // 小字单字：24px 首字，圆角更圆（T-10 待评估是否与 big-char 合并）
  "small-char": {
    showRowNum: false, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: false, showTotal: false,
    nameDisplay: "char",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "10px", rowHeight: 66, cellHeight: 58, rowNumWidth: 0,
    nameLines: 1, nameFontSize: 24, nameLineHeight: 30, nameFontWeight: "normal", infoFontSize: 0,
    denseMode: false, cellWidth: 42, cellMargin: 0,
    showExtraBadge: false, capsuleAutoWidth: true, hideTimeColumnOnRect: false
  },
  // 全名两行 + 时间列：方屏隐藏时间列（B-06 方案 c）
  "full-name": {
    showRowNum: true, showRoom: false, showTeacher: false, showTime: true,
    showDayCount: false, showTotal: true,
    nameDisplay: "full",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "6px", rowHeight: 72, cellHeight: 64, rowNumWidth: 50,
    nameLines: 2, nameFontSize: 28, nameLineHeight: 34, nameFontWeight: "normal", infoFontSize: 0,
    denseMode: false, rowNumMode: "time", cellWidth: 70,
    showExtraBadge: true, capsuleAutoWidth: false, hideTimeColumnOnRect: true
  },
  // 全名两行 + 序号列：与 full-name 同尺寸，仅行号模式与圆角不同（原「跟随系统」的布局部分）
  "full-name-index": {
    showRowNum: true, showRoom: false, showTeacher: false, showTime: true,
    showDayCount: false, showTotal: true,
    nameDisplay: "full",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "10px", rowHeight: 72, cellHeight: 64, rowNumWidth: 50,
    nameLines: 2, nameFontSize: 28, nameLineHeight: 34, nameFontWeight: "normal", infoFontSize: 0,
    denseMode: false, rowNumMode: "index", cellWidth: 70,
    showExtraBadge: true, capsuleAutoWidth: false, hideTimeColumnOnRect: false
  },
  // 紧凑带序号 + 边框
  "dense-index": {
    showRowNum: true, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: true, showTotal: true,
    nameDisplay: "char",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "4px", rowHeight: 54, cellHeight: 48, rowNumWidth: 40,
    nameLines: 1, nameFontSize: 32, nameLineHeight: 38, nameFontWeight: "bold", infoFontSize: 0,
    denseMode: true, cellWidth: 40, rowNumMode: "index",
    cellBordered: true, cellMargin: 0,
    showExtraBadge: true, capsuleAutoWidth: true, hideTimeColumnOnRect: false
  },
  // 英文缩写
  "en-abbr": {
    showRowNum: false, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: false, showTotal: false,
    nameDisplay: "en-abbr",
    dayLabels: ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"],
    cellRadius: "8px", rowHeight: 54, cellHeight: 50, rowNumWidth: 0,
    nameLines: 1, nameFontSize: 28, nameLineHeight: 34, nameFontWeight: "bold", infoFontSize: 0,
    denseMode: false, cellWidth: 60,
    showExtraBadge: true, capsuleAutoWidth: false, hideTimeColumnOnRect: false
  }
}

// 配色维度：只描述颜色，不含任何尺寸字段。
// `cellBg` / `cellText` 非空 = 固定色（用于高对比档，与 theme.* 完全解耦）；
// 为空则回落到 `useColorScheme` 决定的分支（科目色 / 单色）。
// `pageBg` / `footerBg` 供高对比档整页转黑白用，为 null 表示跟随 theme（T-06 决策：整页转黑白）。
var PALETTE_CONFIGS = {
  // 科目色：现状默认
  "subject": {
    useColorScheme: true, transparentCells: false,
    cellBg: null, cellText: null, emptyDot: true, pageBg: null, footerBg: null
  },
  // 单色：theme.cardLight 底 + theme.accent 字（原「跟随系统」的配色部分）
  "mono": {
    useColorScheme: false, transparentCells: false,
    cellBg: null, cellText: null, emptyDot: true, pageBg: null, footerBg: null
  },
  // 黑白高对比（T-06，S4 启用）：底 #000 / 文字 #fff / 有课格 #fff 底 + #000 字 / 空课格仅描边
  "high-contrast": {
    useColorScheme: false, transparentCells: false,
    cellBg: "#ffffff", cellText: "#000000", emptyDot: false,
    pageBg: "#000000", footerBg: "#000000",
    text: "#ffffff", textSecondary: "#c8c8c8", textMuted: "#7a7a7a",
    borderLight: "#5a5a5a", accent: "#ffffff"
  },
  // 纯文字（T-07，S4 启用）：透明底 + 正文色，不画无课点
  "plain": {
    useColorScheme: false, transparentCells: true,
    cellBg: null, cellText: null, emptyDot: false, pageBg: null, footerBg: null
  }
}

// 旧 id → 布局 × 配色。S1 期间 `weekview_template` 仍是唯一持久化键，
// 读到旧 id 后经此表分流到两个维度；S2 引入 weekview_layout / weekview_palette 后本表仅用于一次性迁移。
var LEGACY_TEMPLATE_MAP = {
  "minimal-char":   { layout: "big-char",        palette: "subject" },
  "minimal-clean":  { layout: "small-char",      palette: "subject" },
  "standard-block": { layout: "full-name",       palette: "subject" },
  "compact-grid":   { layout: "dense-index",     palette: "subject" },
  "minimal-en":     { layout: "en-abbr",         palette: "subject" },
  "color-pastel":   { layout: "full-name-index", palette: "mono"    }
}

export default {
  private: {
    iconTheme: "dark",
    allWeekDays: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    allDayNames: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    weekDays: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    displayDayNames: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    scheduleName: "",
    timeSlots: [],
    totalCourses: 0,
    totalDays: 0,
    dayCounts: [0, 0, 0, 0, 0, 0, 0],
    isLoading: true,
    skeletonRows: [1, 2, 3, 4, 5],
    hideWeekend: true,
    viewIndex: 0,
    todayIndex: 0,
    isCapsule: false,
    screenWidth: 0,
    screenShape: "",
    currentCourseDay: "",
    currentCourseTime: "",
    initDone: false,
    firstLoad: true,
    currentTplId: "minimal-char",
    // T-09：外观双维度状态。currentTplId 仅为底部条选中态与渲染缓存键保留（S3 改双键后废弃）
    currentLayoutId: "big-char",
    currentPaletteId: "subject",
    paletteEmptyDot: true,
    templateList: [
      { id: "minimal-char", label: "极简", activeColor: "#e67e22" },
      { id: "minimal-clean", label: "清爽", activeColor: "#27ae60" },
      { id: "standard-block", label: "标准", activeColor: "#3498db" },
      { id: "compact-grid", label: "紧凑", activeColor: "#2ecc71" },
      { id: "minimal-en", label: "英文", activeColor: "#9b59b6" },
      { id: "color-pastel", label: "跟随系统", activeColor: "#e74c3c" }
    ],
    // template config
    showRowNum: false, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: false, showTotal: false,
    nameDisplay: "full",
    nameLines: 1,
    cellRadius: "12px",
    rowHeight: 60,
    cellHeight: 56,
    rowNumWidth: 0,
    nameFontSize: 28,
    nameLineHeight: 34,
    nameFontWeight: "bold",
    infoFontSize: 0,
    cellWidth: 60,
    gridContentWidth: 500,
    rowNumMode: "time",
    useColorScheme: true,
    transparentCells: false,
    templateDayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '\uD83D\uDD35',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    log("onInit start")
    // T-01：销毁标志。本页是长停留+高频重入页面，异步回调一律先判此标志，
    // 避免页面销毁后仍操作实例（手环11「打开一会儿重启」的根因之一）。
    self._destroyed = false
    self.firstLoad = true
    var now = new Date()
    var dayIdx = now.getDay()
    self.todayIndex = dayIdx === 0 ? 6 : dayIdx - 1
    log("todayIndex=" + self.todayIndex + " dayIdx=" + dayIdx)
    // 屏型异步返回：胶囊屏下要关闭行号列并收敛列宽，否则可视列数跌到 1.57
    device.getInfo({
      success: function(data) {
        if (self._destroyed) return
        var shape = data.screenShape || ""
        var capsule = (shape === "capsule" || shape === "pill-shaped")
        // 保存真实屏宽与屏型：列宽自适应需要（手环9=192 胶囊，手环10Pro=336 方屏）
        var newWidth = data.screenWidth || 0
        var widthChanged = (self.screenWidth !== newWidth)
        self.screenWidth = newWidth
        self.screenShape = shape
        if (self.isCapsule !== capsule || widthChanged) {
          self.isCapsule = capsule
          // 模板可能已按默认屏宽应用过，屏型/屏宽回填后必须重新应用，否则方屏仍按 336 兜底算宽
          if (self.currentTplId) {
            self.applyTemplate(self.currentTplId)
          }
        }
      },
      fail: function() {}
    })
    store.getTheme(function(t, themeName) {
      if (self._destroyed) return
      self.theme = t
      self.updateIconSrc(themeName)
    })
    store.getHideWeekend(function(hide) {
      if (self._destroyed) return
      self.hideWeekend = hide
      self.applyWeekendFilter()
      self.hideWeekendLoaded = true
      if (self.weekViewIndexLoaded) {
        self.initDone = true
        self.loadData()
      }
    })
    var storage = require("@system.storage")
    storage.get({
      key: "weekview_index",
      success: function(data) {
        if (self._destroyed) return
        self.viewIndex = parseInt(data) || 0
        log("onInit viewIndex loaded=" + self.viewIndex)
        self.weekViewIndexLoaded = true
        if (self.hideWeekendLoaded) {
          self.initDone = true
          self.loadData()
        }
      },
      fail: function() {
        if (self._destroyed) return
        log("onInit viewIndex not found, use 0")
        self.weekViewIndexLoaded = true
        if (self.hideWeekendLoaded) {
          self.initDone = true
          self.loadData()
        }
      }
    })
    store.getWeekViewTemplate(function(id) {
      if (self._destroyed) return
      self.applyTemplate(id || "minimal-char")
    })
    // T-01：句柄化，由 onDestroy 清除。原实现丢弃句柄，销毁后仍会触发 loadData
    self._initTimer = setTimeout(function() {
      if (self._destroyed) return
      if (!self.initDone) {
        log("onInit timeout fallback, forcing loadData")
        self.initDone = true
        self.loadData()
      }
    }, 800)
  },

  onShow() {
    var self = this
    log("onShow start")
    store.getTheme(function(t, themeName) {
      if (self._destroyed) return
      self.theme = t
      self.updateIconSrc(themeName)
    })
    store.getHideWeekend(function(hide) {
      if (self._destroyed) return
      self.hideWeekend = hide
      self.applyWeekendFilter()
      if (self.firstLoad) {
        log("onShow firstLoad=false, skip reload")
        self.firstLoad = false
        return
      }
      clearDataCache()
      var storage = require("@system.storage")
      storage.get({
        key: "weekview_index",
        success: function(data) {
          if (self._destroyed) return
          self.viewIndex = parseInt(data) || 0
          log("onShow viewIndex=" + self.viewIndex)
          self.loadTemplateAndReload()
        },
        fail: function() {
          if (self._destroyed) return
          self.loadTemplateAndReload()
        }
      })
    })
  },

  loadTemplateAndReload() {
    var self = this
    store.getWeekViewTemplate(function(id) {
      if (self._destroyed) return
      var targetId = id || "minimal-char"
      // 2026-11-01 性能：从别的页面返回本页时 onShow 必走这里，而模板通常没变。
      // 原实现无条件 applyTemplate —— 每次都重算六档配置 + recalcGridMetrics + 重建
      // gridContentWidth，是「返回本页总要卡一下」的直接来源。模板未变则跳过布局重算。
      if (targetId !== self.currentTplId || !self._layoutApplied) {
        self.applyTemplate(targetId)
      } else {
        // 模板未变：只补一次度量（周末显隐可能已切换导致列数变化），
        // 跳过 applyLayout/applyPalette 的配置解析与全字段赋值。
        self.recalcGridMetrics()
      }
      self.isLoading = true
      self.loadData()
    })
  },

  switchTemplate(id) {
    var self = this
    log("switchTemplate -> " + id)
    clearRenderCache()
    self.applyTemplate(id)
    store.setWeekViewTemplate(id)

    // Reuse data-layer cache if available, skip storage I/O
    if (_cachedAllCourses && _cachedViewIndex === self.viewIndex) {
      log("switchTemplate data cache hit, re-rendering")
      self.isLoading = true
      self.renderScheduleData(_cachedAllCourses)
      return
    }

    // Fallback: no cache yet, read from storage
    self.isLoading = true
    self.loadData()
  },

  // 兼容入口：调用方仍按旧模板 id 传入（onInit / onShow / loadTemplateAndReload / device 回调）。
  // T-09 后外观由「布局 + 配色」两个维度共同决定，本方法只负责把旧 id 解析成两个维度再分别应用。
  applyTemplate(id) {
    var legacyId = id || "minimal-char"
    var entry = LEGACY_TEMPLATE_MAP[legacyId]
    if (!entry) {
      log("applyTemplate unknown id=" + legacyId + ", fallback minimal-char")
      legacyId = "minimal-char"
      entry = LEGACY_TEMPLATE_MAP[legacyId]
    }
    this.currentTplId = legacyId
    this.applyLayout(entry.layout)
    this.applyPalette(entry.palette)
    // 列宽计算依赖 this.weekDays.length，必须先跑周末过滤再算度量
    this.applyWeekendFilter()
    this.recalcGridMetrics()
    // 供 loadTemplateAndReload 判断「同一模板是否已应用过」，避免返回本页时重复重算
    this._layoutApplied = true
  },

  // 布局维度：只应用几何与信息密度，不碰颜色
  applyLayout(layoutId) {
    var cfg = LAYOUT_CONFIGS[layoutId] || LAYOUT_CONFIGS["big-char"]
    log("applyLayout id=" + layoutId + " nameDisplay=" + cfg.nameDisplay)
    this.currentLayoutId = layoutId
    this.showRowNum = cfg.showRowNum
    this.showRoom = cfg.showRoom
    this.showTeacher = cfg.showTeacher
    this.showTime = cfg.showTime
    this.showDayCount = cfg.showDayCount !== false
    this.showTotal = cfg.showTotal !== false
    this.nameDisplay = cfg.nameDisplay
    this.nameLines = cfg.nameLines || 1
    this.cellRadius = cfg.cellRadius
    this.rowHeight = cfg.rowHeight
    this.cellHeight = cfg.cellHeight
    // 胶囊屏：行号列会吃掉 40~50px，160px 内容区下可视列数仅 1.57（规范下限 2.5）。
    // 窄屏关闭行号列，把宽度全部让给课程格。
    // 时间列（B-06）：在方屏只剩约 50px，"07:00 - 07:45" 被迫折成 4 行竖排，
    // 把行高从 72px 顶到约 120px。时间文本不可压缩，故该布局在非胶囊屏也隐藏时间列。
    // 序号列（dense-index / full-name-index）显示的是 1~N 单位数字，不会折行，保持原样。
    if (this.isCapsule === true || cfg.hideTimeColumnOnRect === true) {
      this.rowNumWidth = 0
      this.showRowNum = false
    } else {
      this.rowNumWidth = cfg.rowNumWidth
    }
    this.nameFontSize = cfg.nameFontSize
    this.nameLineHeight = cfg.nameLineHeight || (cfg.nameFontSize + 6)
    // 两行模式：2×34=68 会超出 64 的格高被裁，按格高收敛行高（留 4px 余量）
    if (this.nameLines > 1) {
      var maxLineH = Math.floor((cfg.cellHeight - 4) / this.nameLines)
      this.nameLineHeight = Math.min(this.nameLineHeight, maxLineH)
    }
    this.nameFontWeight = cfg.nameFontWeight
    var w = cfg.cellWidth || Math.max(100, this.nameFontSize * 5)
    // 胶囊屏把列宽收敛到 ≤60px：160px 内容区 ÷ 60 ≈ 2.67 列，落入规范 2.5~3.5 区间
    this.cellWidth = (this.isCapsule === true) ? Math.min(w, 60) : w
    this.rowNumMode = cfg.rowNumMode || "time"
    this.infoFontSize = cfg.infoFontSize
    this.cellBordered = cfg.cellBordered === true
    this.cellMargin = cfg.cellMargin !== undefined ? cfg.cellMargin : 1
    this.showExtraBadge = cfg.showExtraBadge === true
    this.templateDayLabels = cfg.dayLabels || ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"]
  },

  // 配色维度：只应用颜色，不碰任何尺寸。颜色取值见 getCellBg / getCellTextColor
  applyPalette(paletteId) {
    var pal = PALETTE_CONFIGS[paletteId] || PALETTE_CONFIGS["subject"]
    this.currentPaletteId = paletteId
    this.useColorScheme = pal.useColorScheme === true
    this.transparentCells = pal.transparentCells === true
    this.paletteEmptyDot = pal.emptyDot !== false
  },

  // 度量计算：列宽自适应与内容总宽。依赖 this.weekDays，须在 applyWeekendFilter 之后调用
  recalcGridMetrics() {
    var cfg = LAYOUT_CONFIGS[this.currentLayoutId] || LAYOUT_CONFIGS["big-char"]
    var cellExtra = 2 * this.cellMargin + (this.cellBordered ? 2 : 0)
    if (this.isCapsule === true) {
      // 胶囊屏：部分布局按真实屏宽自适应（.wv-page 左右 padding 为 0）。
      // 此前胶囊屏被整体排除、固定 42px：5×42=210 > 192，周五整列被屏幕右缘裁掉半个字（2026-09-28 用户反馈）。
      // 全名类布局保持固定 min(70,60) + 横向滑动，符合规范 5.3「显示 2.5~3.5 列」（D-02）。
      if (cfg.capsuleAutoWidth === true) {
        var availCells = (this.screenWidth || 192) - this.rowNumWidth
        this.cellWidth = Math.max(30, Math.floor(availCells / this.weekDays.length) - cellExtra)
      }
    } else {
      // 方屏/圆屏：所有模板一律按真实可用宽度均分。
      // 标准/清爽此前固定 70px：5×70+50=400 > 316，只显 4.09 列、周五整列不可见（B-02）。
      // 规范 5.2 要求方屏 5 列全显，故方屏不再保留固定列宽（D-02 的固定宽只在胶囊屏成立）。
      var pagePad = (this.screenShape === "circle") ? 72 : 20 // .wv-page 左右内距：方屏 10×2，圆屏 36×2
      var availRect = (this.screenWidth || 336) - pagePad - this.rowNumWidth
      this.cellWidth = Math.max(30, Math.floor(availRect / this.weekDays.length) - cellExtra)
    }
    this.gridContentWidth = this.rowNumWidth + this.weekDays.length * (this.cellWidth + 2 * this.cellMargin + (this.cellBordered ? 2 : 0))
  },

  applyWeekendFilter() {
    var fullLabels = this.templateDayLabels || ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"]
    if (this.hideWeekend) {
      this.weekDays = fullLabels.slice(0, 5)
      this.displayDayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
      if (this.todayIndex >= 5) {
        this.todayIndex = -1
      }
    } else {
      this.weekDays = fullLabels
      this.displayDayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
      var now = new Date()
      var dayIdx = now.getDay()
      this.todayIndex = dayIdx === 0 ? 6 : dayIdx - 1
    }
    log("applyWeekendFilter hide=" + this.hideWeekend + " days=" + this.weekDays.join(",") + " todayIdx=" + this.todayIndex)
  },

  loadData() {
    var self = this
    // T-01：页面已销毁时不再发起数据链路
    if (self._destroyed) return
    log("loadData start viewIndex=" + self.viewIndex)

    store.getScheduleNames(function(names) {
      if (self._destroyed) return
      store.getCurrentScheduleIndex(function() {
        if (self._destroyed) return
        // 名称只用于底部胶囊文案，越界/空值不清空旧值会显示上一张课表的名，
        // 故显式回落空串，由模板的 `|| '课程表'` 兜底。
        self.scheduleName = (names && names.length > self.viewIndex && names[self.viewIndex]) || ""
        log("loadData scheduleName=" + self.scheduleName)
      })
    })

    // Check data-layer cache: if we already loaded this viewIndex, skip I/O
    if (_cachedAllCourses && _cachedViewIndex === self.viewIndex) {
      log("loadData data cache hit, skipping storage I/O")
      self.renderScheduleData(_cachedAllCourses)
      return
    }

    var dataLoaded = false
    database.getAllCoursesWithIndex(this.viewIndex, function(schedule) {
      if (dataLoaded) return
      dataLoaded = true
      log("loadData getAllCoursesWithIndex returned, len=" + (schedule ? schedule.length : "null"))
      if (!schedule) {
        log("loadData schedule is null, fallback to getAllCourses")
        database.getAllCourses(function(fallback) {
          self.renderSchedule(fallback)
        })
        return
      }

      var allCourses = {}
      for (var d = 0; d < schedule.length; d++) {
        var dayData = schedule[d]
        if (dayData && dayData.day) {
          var enDay = DAY_NAME_MAP[dayData.day] || dayData.day
          allCourses[enDay] = dayData.classes || []
        }
      }
      log("loadData allCourses keys=" + Object.keys(allCourses).join(","))

      var totalCourses = 0
      for (var key in allCourses) {
        if (allCourses.hasOwnProperty(key)) {
          totalCourses += allCourses[key].length
        }
      }
      log("loadData totalCourses=" + totalCourses)

      if (totalCourses === 0) {
        log("loadData no courses found, fallback to getAllCourses")
        database.getAllCourses(function(fallback) {
          self.renderSchedule(fallback)
        })
        return
      }

      self.renderScheduleData(allCourses)

      // Save to data-layer cache for template switches
      _cachedAllCourses = allCourses
      _cachedViewIndex = self.viewIndex
      log("loadData saved to data cache viewIndex=" + self.viewIndex)
    })

    // T-01：句柄化，由 onDestroy 清除
    self._dataTimer = setTimeout(function() {
      if (self._destroyed) return
      if (!dataLoaded) {
        dataLoaded = true
        log("loadData timeout 1500ms fallback")
        database.getAllCourses(function(fallback) {
          if (self._destroyed) return
          self.renderSchedule(fallback)
        })
      }
    }, 1500)
  },

  renderSchedule(schedule) {
    if (this._destroyed) return
    log("renderSchedule len=" + (schedule ? schedule.length : "null"))
    var allCourses = {}
    if (schedule) {
      for (var d = 0; d < schedule.length; d++) {
        var dayData = schedule[d]
        if (dayData && dayData.day) {
          var enDay = DAY_NAME_MAP[dayData.day] || dayData.day
          allCourses[enDay] = dayData.classes || []
        }
      }
    }
    // 2026-11-01 性能：原实现逐课 JSON.stringify 打日志，dlog 已是空函数，
    // 字符串化纯属浪费（每门课一次，回退路径同样触发），删除。
    this.renderScheduleData(allCourses)
  },

  renderScheduleData(allCourses) {
    var self = this
    if (self._destroyed) return

    // Compute cache key: data fingerprint + template + weekend + capsule
    var fp = dataFingerprint(allCourses)
    var cacheKey = self.viewIndex + "|" + self.currentTplId + "|" + self.hideWeekend + "|" + self.isCapsule

    if (_renderCache && _renderCache.key === cacheKey && _renderCache.fp === fp) {
      self.timeSlots = _renderCache.timeSlots
      self.totalCourses = _renderCache.totalCourses
      self.totalDays = _renderCache.totalDays
      self.dayCounts = _renderCache.dayCounts
      self.detectCurrentCourse(allCourses)
      self.isLoading = false
      return
    }

    var dayNames = self.displayDayNames

    self.detectCurrentCourse(allCourses)
    self.buildTimeSlots(allCourses)

    var total = 0
    var totalDays = 0
    for (var key in allCourses) {
      if (allCourses.hasOwnProperty(key)) {
        total += allCourses[key].length
        if (allCourses[key].length > 0) totalDays++
      }
    }
    self.totalCourses = total
    self.totalDays = totalDays
    log("renderScheduleData total=" + total + " days=" + totalDays)

    var dayCounts = []
    for (var dn = 0; dn < dayNames.length; dn++) {
      var dayCourses = allCourses[dayNames[dn]]
      dayCounts.push(dayCourses ? dayCourses.length : 0)
    }
    self.dayCounts = dayCounts


    // Save to cache
    _renderCache = {
      key: cacheKey,
      fp: fp,
      timeSlots: self.timeSlots,
      totalCourses: total,
      totalDays: totalDays,
      dayCounts: dayCounts
    }

    self.isLoading = false
  },

  getDisplayName(course) {
    if (!course) return ""
    var name = course.name || "?"
    var result
    if (this.nameDisplay === "char") {
      result = name.charAt(0)
    } else if (this.nameDisplay === "en-abbr") {
      result = name.substring(0, 3)
    } else {
      result = name
    }
    // log("getDisplayName mode=" + this.nameDisplay + " in=" + name + " out=" + result)
    return result
  },

  // T-09：颜色全部由 palette 决定，本方法只读 PALETTE_CONFIGS，不再内联分支判断
  getCellBg(course) {
    if (!course) return "transparent"
    var pal = PALETTE_CONFIGS[this.currentPaletteId] || PALETTE_CONFIGS["subject"]
    if (pal.transparentCells) return "transparent"
    if (pal.cellBg) return pal.cellBg
    if (pal.useColorScheme !== true) {
      return this.theme.cardLight || "#0f3460"
    }
    var key = guessSubjectKey(course.name)
    return SUBJECT_COLORS[key] || SUBJECT_COLORS["default"]
  },

  getCellTextColor(course) {
    if (!course) return "transparent"
    var pal = PALETTE_CONFIGS[this.currentPaletteId] || PALETTE_CONFIGS["subject"]
    if (pal.transparentCells) return this.theme.text || "#ffffff"
    if (pal.cellText) return pal.cellText
    if (pal.useColorScheme !== true) {
      return this.theme.accent || "#7ec8e3"
    }
    var key = guessSubjectKey(course.name)
    return SUBJECT_TEXT_COLORS[key] || SUBJECT_TEXT_COLORS["default"]
  },

  buildTimeSlots(allCourses) {
    var self = this
    var timeSet = {}
    var dayList = self.displayDayNames

    for (var d = 0; d < dayList.length; d++) {
      var day = dayList[d]
      var courses = allCourses[day] || []
      for (var c = 0; c < courses.length; c++) {
        var time = courses[c].time
        if (time && !timeSet[time]) {
          timeSet[time] = true
        }
      }
    }

    var timeKeys = Object.keys(timeSet)
    timeKeys.sort(function(a, b) {
      var aStart = a.split("-")[0].trim()
      var bStart = b.split("-")[0].trim()
      if (aStart < bStart) return -1
      if (aStart > bStart) return 1
      return 0
    })

    var timeSlots = []
    for (var t = 0; t < timeKeys.length; t++) {
      var time = timeKeys[t]
      var cells = []
      for (var d = 0; d < dayList.length; d++) {
        var day = dayList[d]
        var courses = allCourses[day] || []
        var matched = []
        for (var c = 0; c < courses.length; c++) {
          if (courses[c].time === time) {
            matched.push(courses[c])
          }
        }
        if (matched.length > 0) {
          var firstCourse = matched[0]
          var cellCourse = {
            id: firstCourse.id,
            name: firstCourse.name,
            extraCount: matched.length > 1 ? matched.length - 1 : 0,
            time: firstCourse.time,
            teacher: firstCourse.teacher,
            location: firstCourse.location,
            allCourses: matched
          }
          // 2026-11-01 性能：配色与显示名在构建期算一次，模板只绑定结果。
          // 原实现模板里对每格调 getCellBg/getCellTextColor/getDisplayName，60 格 × 每次重绘
          // 都要重查 PALETTE_CONFIGS + guessSubjectKey + 字符串切片，是滑动卡顿的主要来源之一。
          // 另删除从未被模板引用的 displayChar（每格白算一次 getFirstChar）。
          cells.push({
            day: day,
            isCurrent: day === self.currentCourseDay && time === self.currentCourseTime,
            bg: self.getCellBg(cellCourse),
            fg: self.getCellTextColor(cellCourse),
            nameText: self.getDisplayName(cellCourse),
            course: cellCourse
          })
        } else {
          cells.push({
            day: day,
            isCurrent: false,
            bg: "transparent",
            fg: "transparent",
            nameText: "",
            course: null
          })
        }
      }
      timeSlots.push({
        time: time,
        cells: cells
      })
    }

    this.timeSlots = timeSlots

  },

  getFirstChar(name) {
    if (!name) return "?"
    return name.charAt(0)
  },

  detectCurrentCourse(allCourses) {
    var todayName = this.displayDayNames[this.todayIndex]
    if (!todayName) {
      this.currentCourseDay = ""
      this.currentCourseTime = ""
      return
    }
    var now = new Date()
    var currentTime = now.getHours() * 60 + now.getMinutes()

    this.currentCourseDay = ""
    this.currentCourseTime = ""

    var todayCourses = allCourses[todayName]
    if (!todayCourses) return

    for (var i = 0; i < todayCourses.length; i++) {
      var course = todayCourses[i]
      var timeRange = course.time
      if (!timeRange) continue
      var parts = timeRange.split("-")
      if (parts.length !== 2) continue
      var startParts = parts[0].trim().split(":")
      var endParts = parts[1].trim().split(":")
      var startTime = parseInt(startParts[0]) * 60 + parseInt(startParts[1])
      var endTime = parseInt(endParts[0]) * 60 + parseInt(endParts[1])
      if (currentTime >= startTime && currentTime <= endTime) {
        this.currentCourseDay = todayName
        this.currentCourseTime = course.time
        return
      }
    }
  },

  showDetail(day, course) {
    if (!course) return
    var storage = require("@system.storage")
    storage.set({
      key: "detail_classId",
      value: String(course.id),
      success: function() {
        storage.set({
          key: "detail_day",
          value: toCnDay(day),
          success: function() {
            router.push({ uri: "/pages/detail" })
          },
          fail: function() {
            prompt.showToast({ message: "请重试" })
          }
        })
      },
      fail: function() {
        prompt.showToast({ message: "请重试" })
      }
    })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  goBack() {
    router.back()
  },

  // 底部三圆（2026-11-03）：与首页底部同形同目的地，避免同一动作在本 app 里
  // 出现两条不同的进入路径。跳转前不做 storage 预写 —— 本页已在看某个 viewIndex，
  // 目标页各自读当前索引，不依赖本页状态。
  // 底部唯一入口：课程表管理（本页恒为只读视图，加课/设置不在此页开）
  openScheduleManager() {
    router.push({ uri: "/pages/schedule-manager" })
  },

  onDestroy() {
    // T-01 / B-01：本方法原先主动把 scheduleName / timeSlots / theme / templateList
    // 置 null，但 template 里 for="{{ templateList }}" 与 60+ 处内联样式仍绑定 theme，
    // 销毁瞬间若还有延迟回调或延迟帧求值，就会对 null 取属性抛异常导致进程崩溃。
    // 正确做法：不置 null（框架会回收），改为「置销毁标志 + 清定时器 + 清模块级缓存」。
    this._destroyed = true
    if (this._initTimer) {
      clearTimeout(this._initTimer)
      this._initTimer = null
    }
    if (this._dataTimer) {
      clearTimeout(this._dataTimer)
      this._dataTimer = null
    }
    // 模块级缓存跨实例共享，销毁时清理，避免下一次进入命中旧实例的数据
    clearRenderCache()
    clearDataCache()
  }
}
</script>

<style>
@import '../../common/header.css';

/* ── page ── */
/* 顶距 44 → 8（2026-11-03 二次调整）：44px 是旧页头的历史遗留 —— 那时是「方块返回键
 * + 居中标题」两段式，按圆形可视区预留了整条安全带，页头下方因此多出一条空行。
 * 换成 .hdr 居中胶囊后，192 屏上胶囊左右各留白 ≈35px，左上角 (35,8) 到弧心 (40,40)
 * 距离 ≈32 < 弧半径 40，整颗胶囊都在可视区内，故顶部只留 8px 呼吸；
 * 取值与 settings 页 .page-body 的 8px 一致，两页页头观感才对得上。
 * 省出的 36px 全部让给课表网格。
 *
 * 圆屏例外：见下方 @media (shape: circle) 的 44px —— 圆形可视区顶部收窄，
 * 那个值是几何推导出来的，不要为了「统一」跟着压成 8。 */
.wv-page {
  flex-direction: column;
  padding: 8px 10px 12px 10px;
  height: 100%;
}

/* ── header ── */
/* 页头样式一律由 common/header.css 的 .hdr 一节提供（2026-11-03 迁移）。
   本页不再定义 .wv-header / .wv-back / .wv-title —— 与公共文件同名类在同特异性下
   「页面后加载」会静默覆盖公共值，是 settings 页文档里记过的坑。 */

/* ── 底部课程表入口（2026-11-03 三次调整：圆钮 → 带名称胶囊）──
   形态对齐首页 .schedule-indicator（⇄ 图标 + 课表名，圆角胶囊），
   因为它回答的是同一个问题「现在是哪张课表」，同一个答案不该长两个样。
   垂直预算：34px（18 字 + 上下各 8），比原先 48px 圆钮省 14px 还给网格。
   宽度上限按胶囊屏 192 屏宽留边：168 = 192 − 2×12；方屏/圆屏在各自媒体查询里放宽。 */
.wv-bottom-buttons {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 6px;
  width: 100%;
  flex-shrink: 0;
}

.wv-sched-pill {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  max-width: 168px;
  padding: 5px 14px;
  border-radius: 16px;
  flex-shrink: 0;
}

.wv-sched-icon {
  width: 18px;
  height: 18px;
  margin-right: 5px;
  flex-shrink: 0;
}

/* 名称可能被用户改成任意长度（课程表管理页可改名），
   故 lines:1 + ellipsis 硬截断，绝不换行撑破 34px 高的胶囊。 */
.wv-sched-name {
  font-size: 18px;
  line-height: 24px;
  text-align: center;
  text-overflow: ellipsis;
  lines: 1;
  flex-shrink: 1;
}

/* ── grid ── */
.wv-grid-scroll {
  flex: 1;
  flex-direction: column;
}

.wv-scroll-inner {
  flex-direction: column;
}

.wv-day-row {
  flex-direction: row;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.wv-day-spacer {
  width: 50px;
  flex-shrink: 0;
}

.wv-day-cell {
  text-align: center;
  font-size: 20px;
  font-weight: bold;
  flex-shrink: 0;
  text-overflow: ellipsis;
  line-height: 28px;
  lines: 1;
}

.wv-day-cell.wv-today {
  font-size: 24px;
  text-decoration: underline;
  line-height: 32px;
}

.wv-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 2px;
  min-height: 34px;
  flex-shrink: 0;
}

.wv-time {
  width: 50px;
  font-size: 20px;
  text-align: right;
  padding-right: 6px;
  flex-shrink: 0;
  line-height: 28px;
}

.wv-cells {
  flex-direction: row;
}

.wv-cell {
  height: 44px;
  margin: 1px;
  border-radius: 6px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.wv-cell-empty {
  background-color: transparent;
  opacity: 0.3;
}

.wv-cell-bordered {
  border: 1px solid;
}

.wv-cell-text {
  background-color: transparent !important;
  margin: 2px 1px;
  opacity: 1;
}

.wv-cell-text.wv-cell-empty {
  opacity: 0;
}

.wv-name-transparent {
  text-align: center;
  font-weight: 400;
  letter-spacing: 0.3px;
}

.wv-cell.wv-now {
  background-color: rgba(126, 200, 227, 0.12);
  margin: 1px;
}

.wv-cell-text.wv-now {
  background-color: transparent !important;
}

.wv-name-now {
  color: #7ec8e3 !important;
  font-weight: 500;
}

.wv-name {
  font-size: 20px;
  line-height: 28px;
  font-weight: bold;
  text-align: center;
  text-overflow: ellipsis;
}

/* 两行模式（标准/清爽）：超过两行由 text-overflow 省略，不再换行撑高溢出 */
.wv-name-2l {
  lines: 2;
}

.wv-info {
  font-size: 20px;
  line-height: 28px;
  text-align: center;
  text-overflow: ellipsis;
}

.wv-extra {
  font-size: 20px;
  text-align: center;
  line-height: 28px;
}

.wv-empty {
  font-size: 20px;
  text-align: center;
  line-height: 28px;
}

/* ── skeleton ── */
.wv-skel-cell {
  margin: 1px;
  flex-shrink: 0;
  opacity: 0.4;
}

/* ── footer ── */
.wv-footer {
  flex-direction: column;
  padding: 8px 0 6px 0;
  align-items: center;
}

.wv-tpl-row {
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  width: 100%;
  height: 44px;
}

.wv-tpl {
  flex-direction: row;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  height: 44px;
  padding: 0 10px;
  margin: 0 3px;
  border-radius: 18px;
  border-width: 1.5px;
  border-style: solid;
  border-color: transparent;
}

.wv-tpl-on {
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  font-weight: bold;
}

.wv-tpl-text {
  font-size: 24px;
  letter-spacing: 0.5px;
  text-align: center;
  line-height: 32px;
}

/* ── circle shape ── */
@media (shape: circle) {
  .wv-page {
    padding: 44px 36px 44px 36px;
  }
  .wv-day-spacer {
    width: 42px;
  }
  .wv-day-cell {
    font-size: 20px;
  }
  .wv-day-cell.wv-today {
    font-size: 24px;
  }
  .wv-row {
    min-height: 28px;
  }
  .wv-time {
    width: 42px;
    font-size: 20px;
  }
  .wv-cell {
    height: 44px;
  }
  .wv-name {
    font-size: 20px;
  }
  .wv-empty {
    font-size: 20px;
  }
  .wv-footer {
    padding: 6px 0 4px 0;
  }
  /* 大屏放宽胶囊宽度（圆屏可视区更宽，168 会把长名字过早截断） */
  .wv-sched-pill {
    max-width: 200px;
    padding: 6px 18px;
  }
  .wv-sched-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
  }
  .wv-sched-name {
    font-size: 20px;
    line-height: 26px;
  }
  .wv-tpl-row {
    padding: 0 4px;
  }
  .wv-tpl {
    height: 44px;
    padding: 0 8px;
    margin: 0 2px;
  }
  .wv-tpl-text {
    font-size: 24px;
  }
}

@media (shape: pill-shaped) {
  .wv-page {
    /* 手环走这条：顶距与基准一致收到 8（原 44 会在页头下留一条空行） */
    padding: 8px 0 8px 0;
  }
  .wv-grid-scroll {
    padding: 0;
  }
  /* 胶囊屏左右是圆弧：R=96 时 y=48 处可视区左缘内收约 13px，内容贴边会被弧吃掉半列
     （2026-11-03 实测：顶距收到 8 后日行上移进弧区，「一」只剩右半条）。
     安全边加在滚动内容上而非 page 上 —— 这样横向滚到任何位置，左右缘都不压字，
     且 gridContentWidth 的滚动宽度语义不变。12 = 13px 弧内收向上取整的整数边。 */
  .wv-scroll-inner {
    padding: 0 12px;
  }
  .wv-tpl {
    height: 48px;
    padding: 0 8px;
    margin: 0 2px;
  }
  .wv-tpl-text {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: rect) {
  .wv-page {
    /* 方屏直角、无弧边裁切，顶距直接归零（与 settings 页方屏 padding-top: 0 对齐） */
    padding: 0px 10px 12px 10px;
  }
  /* 模板切换按钮提到规范的 48px */
  .wv-tpl {
    height: 48px;
    padding: 0 6px;
    margin: 0 2px;
  }
  .wv-tpl-text {
    font-size: 24px;
    line-height: 32px;
  }
  /* 方屏横向充裕（336px），胶囊放到 260 让长课表名基本能整段显示 */
  .wv-sched-pill {
    max-width: 260px;
  }
}
</style>