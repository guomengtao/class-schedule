<template>
  <div class="week-view-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">课程总览</text>
    </div>

    <text class="schedule-name" style="color: {{ theme.accent }}">{{ scheduleName }}</text>

    <div class="grid-wrapper">
      <div class="week-header">
        <text class="week-header-spacer"></text>
        <text class="week-day {{ $idx === todayIndex ? 'today-day' : '' }}" for="{{ weekDays }}" style="color: {{ $idx === todayIndex ? theme.accent : theme.textSecondary }}">{{ $item }}</text>
      </div>

      <div class="grid-scroll">
        <div class="grid-container">
          <div for="{{ timeSlots }}" class="time-row">
            <text class="time-label" style="color: {{ theme.textSecondary }}">{{ $item.time }}</text>
            <div class="course-row">
              <div for="{{ $item.cells }}" class="course-cell {{ $item.isCurrent ? 'current-course' : '' }}" onclick="showDetail($item.day, $item.course)" style="background-color: {{ $item.course ? theme.cardLight : 'transparent' }}">
                <text class="course-char" if="{{ $item.course }}" style="color: {{ theme.accent }}">{{ $item.course.displayChar }}</text>
                <text class="course-extra" if="{{ $item.course && $item.course.extraCount > 0 }}" style="color: {{ theme.textMuted }}">+{{ $item.course.extraCount }}</text>
                <text class="course-empty" if="{{ !$item.course }}" style="color: {{ theme.textMuted }}">·</text>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer" style="background-color: {{ theme.card }}">
      <text class="footer-text" style="color: {{ theme.textSecondary }}">共 {{ totalCourses }} 门课程</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
const scheduleSeed = require("../../data/schedule.js")

var fullDayNames = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]

export default {
  private: {
    weekDays: ["一", "二", "三", "四", "五", "六", "日"],
    scheduleName: "",
    timeSlots: [],
    totalCourses: 0,
    viewIndex: 0,
    todayIndex: 0,
    currentCourseDay: "",
    currentCourseTime: "",
    _initDone: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    self._firstLoad = true
    var now = new Date()
    var dayIdx = now.getDay()
    self.todayIndex = dayIdx === 0 ? 6 : dayIdx - 1
    store.getTheme(function(t) {
      self.theme = t
    })
    var storage = require("@system.storage")
    storage.get({
      key: "weekview_index",
      success: function(data) {
        if (data) {
          self.viewIndex = parseInt(data) || 0
        }
        self._initDone = true
        self.loadData()
      },
      fail: function() {
        self._initDone = true
        self.loadData()
      }
    })
    setTimeout(function() {
      if (!self._initDone) {
        self._initDone = true
        self.loadData()
      }
    }, 800)
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    if (self._firstLoad) {
      self._firstLoad = false
      return
    }
    var storage = require("@system.storage")
    storage.get({
      key: "weekview_index",
      success: function(data) {
        if (data) {
          self.viewIndex = parseInt(data) || 0
        }
        self.loadData()
      },
      fail: function() {
        self.loadData()
      }
    })
  },

  loadData() {
    var self = this

    store.getScheduleNames(function(names) {
      store.getCurrentScheduleIndex(function() {
        if (names && names.length > self.viewIndex) {
          self.scheduleName = names[self.viewIndex]
        }
      })
    })

    var dataLoaded = false
    database.getAllCoursesWithIndex(this.viewIndex, function(schedule) {
      if (dataLoaded) return
      dataLoaded = true
      if (!schedule) return

      var allCourses = {}
      for (var d = 0; d < schedule.length; d++) {
        var dayData = schedule[d]
        if (dayData && dayData.day) {
          allCourses[dayData.day] = dayData.classes || []
        }
      }

      var totalCourses = 0
      for (var key in allCourses) {
        if (allCourses.hasOwnProperty(key)) {
          totalCourses += allCourses[key].length
        }
      }

      if (totalCourses === 0) {
        var seedData = scheduleSeed.schedule
        allCourses = {}
        for (var sd = 0; sd < seedData.length; sd++) {
          var sdd = seedData[sd]
          if (sdd && sdd.day) {
            allCourses[sdd.day] = sdd.classes || []
          }
        }
      }

      self.detectCurrentCourse(allCourses)
      self.buildTimeSlots(allCourses)

      var total = 0
      for (var key in allCourses) {
        if (allCourses.hasOwnProperty(key)) {
          total += allCourses[key].length
        }
      }
      self.totalCourses = total
    })

    setTimeout(function() {
      if (!dataLoaded) {
        dataLoaded = true
        var seedData = scheduleSeed.schedule
        var allCourses = {}
        for (var sd = 0; sd < seedData.length; sd++) {
          var sdd = seedData[sd]
          if (sdd && sdd.day) {
            allCourses[sdd.day] = sdd.classes || []
          }
        }
        self.detectCurrentCourse(allCourses)
        self.buildTimeSlots(allCourses)
        var total = 0
        for (var key in allCourses) {
          if (allCourses.hasOwnProperty(key)) {
            total += allCourses[key].length
          }
        }
        self.totalCourses = total
      }
    }, 1500)
  },

  buildTimeSlots(allCourses) {
    var self = this
    var timeSet = {}
    var dayList = fullDayNames

    for (var d = 0; d < dayList.length; d++) {
      var day = dayList[d]
      var courses = allCourses[day] || []
      for (var c = 0; c < courses.length; c++) {
        var time = courses[c].time
        if (time && !timeSet[time]) {
          timeSet[time] = true
        }
      }
    }

    var timeKeys = Object.keys(timeSet)
    timeKeys.sort(function(a, b) {
      var aStart = a.split("-")[0].trim()
      var bStart = b.split("-")[0].trim()
      if (aStart < bStart) return -1
      if (aStart > bStart) return 1
      return 0
    })

    var timeSlots = []
    for (var t = 0; t < timeKeys.length; t++) {
      var time = timeKeys[t]
      var cells = []
      for (var d = 0; d < dayList.length; d++) {
        var day = dayList[d]
        var courses = allCourses[day] || []
        var matched = []
        for (var c = 0; c < courses.length; c++) {
          if (courses[c].time === time) {
            matched.push(courses[c])
          }
        }
        if (matched.length > 0) {
          var firstCourse = matched[0]
          cells.push({
            day: day,
            isCurrent: day === self.currentCourseDay && time === self.currentCourseTime,
            course: {
              id: firstCourse.id,
              name: firstCourse.name,
              char: self.getFirstChar(firstCourse.name),
              displayChar: self.getFirstChar(firstCourse.name),
              extraCount: matched.length > 1 ? matched.length - 1 : 0,
              time: firstCourse.time,
              teacher: firstCourse.teacher,
              location: firstCourse.location,
              allCourses: matched
            }
          })
        } else {
          cells.push({
            day: day,
            isCurrent: false,
            course: null
          })
        }
      }
      timeSlots.push({
        time: time,
        cells: cells
      })
    }

    this.timeSlots = timeSlots
  },

  getFirstChar(name) {
    if (!name) return "?"
    return name.charAt(0)
  },

  detectCurrentCourse(allCourses) {
    var todayName = fullDayNames[this.todayIndex]
    var now = new Date()
    var currentTime = now.getHours() * 60 + now.getMinutes()

    this.currentCourseDay = ""
    this.currentCourseTime = ""

    var todayCourses = allCourses[todayName]
    if (!todayCourses) return

    for (var i = 0; i < todayCourses.length; i++) {
      var course = todayCourses[i]
      var timeRange = course.time
      if (!timeRange) continue
      var parts = timeRange.split("-")
      if (parts.length !== 2) continue
      var startParts = parts[0].trim().split(":")
      var endParts = parts[1].trim().split(":")
      var startTime = parseInt(startParts[0]) * 60 + parseInt(startParts[1])
      var endTime = parseInt(endParts[0]) * 60 + parseInt(endParts[1])
      if (currentTime >= startTime && currentTime <= endTime) {
        this.currentCourseDay = todayName
        this.currentCourseTime = course.time
        return
      }
    }
  },

  showDetail(day, course) {
    if (!course) return
    var storage = require("@system.storage")
    storage.set({
      key: "detail_classId",
      value: String(course.id)
    })
    storage.set({
      key: "detail_day",
      value: day
    })
    router.push({
      uri: "/pages/detail"
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.week-view-page {
  flex-direction: column;
  background-color: #1a1a2e;
  padding: 44px 8px 8px 8px;
  height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
  position: relative;
}

.back-btn {
  width: 56px;
  height: 34px;
  border-radius: 8px;
  background-color: #16213e;
  font-size: 14px;
  color: #7ec8e3;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.schedule-name {
  font-size: 13px;
  color: #7ec8e3;
  text-align: center;
  margin-bottom: 6px;
}

.grid-wrapper {
  flex: 1;
  flex-direction: column;
}

.week-header {
  flex-direction: row;
  margin-bottom: 4px;
}

.week-header-spacer {
  width: 50px;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 12px;
  font-weight: bold;
  color: #5577aa;
}

.week-day.today-day {
  font-size: 14px;
  color: #7ec8e3;
  text-decoration: underline;
}

.grid-scroll {
  flex: 1;
  flex-direction: column;
  overflow: auto;
}

.grid-container {
  flex-direction: column;
}

.time-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 1px;
  min-height: 34px;
}

.time-label {
  width: 50px;
  font-size: 9px;
  color: #445566;
  text-align: right;
  padding-right: 6px;
}

.course-row {
  flex: 1;
  flex-direction: row;
}

.course-cell {
  flex: 1;
  height: 32px;
  margin: 1px;
  border-radius: 6px;
  justify-content: center;
  align-items: center;
  background-color: transparent;
}

.course-cell.current-course {
  background-color: rgba(126, 200, 227, 0.12);
  margin: 1px;
}

.course-char {
  font-size: 20px;
  font-weight: bold;
  color: #7ec8e3;
  text-align: center;
}

.course-extra {
  font-size: 9px;
  color: #555566;
  text-align: center;
}

.course-empty {
  font-size: 10px;
  color: #1a2030;
  text-align: center;
}

.footer {
  padding: 6px 0;
  align-items: center;
}

.footer-text {
  font-size: 11px;
  color: #555566;
  text-align: center;
}

@media (shape: circle) {
  .week-view-page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    margin-bottom: 4px;
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 44px;
    height: 28px;
    font-size: 12px;
  }
  .header-title {
    font-size: 16px;
  }
  .schedule-name {
    font-size: 12px;
  }
  .week-header-spacer {
    width: 42px;
  }
  .week-day {
    font-size: 11px;
  }
  .week-day.today-day {
    font-size: 12px;
  }
  .time-row {
    min-height: 28px;
  }
  .time-label {
    width: 42px;
    font-size: 8px;
  }
  .course-cell {
    height: 28px;
  }
  .course-char {
    font-size: 16px;
  }
  .course-empty {
    font-size: 9px;
  }
  .footer {
    padding: 4px 0;
  }
  .footer-text {
    font-size: 10px;
  }
}

@media (shape: capsule) {
  .week-view-page {
    padding: 44px 8px 12px 8px;
  }
  .header {
    margin-bottom: 6px;
    justify-content: center;
  }
  .back-btn {
    width: 44px;
    height: 30px;
    font-size: 13px;
  }
  .header-title {
    font-size: 15px;
  }
  .schedule-name {
    font-size: 11px;
  }
  .week-header-spacer {
    width: 40px;
  }
  .week-day {
    font-size: 10px;
  }
  .week-day.today-day {
    font-size: 11px;
  }
  .time-row {
    min-height: 28px;
  }
  .time-label {
    width: 40px;
    font-size: 9px;
  }
  .course-cell {
    height: 26px;
  }
  .course-char {
    font-size: 14px;
  }
  .course-empty {
    font-size: 9px;
  }
  .footer {
    padding: 4px 0;
  }
  .footer-text {
    font-size: 10px;
  }
}

@media (shape: rect) {
  .week-view-page {
    padding: 44px 6px 6px 6px;
  }
  .header {
    margin-bottom: 4px;
  }
  .back-btn {
    width: 40px;
    height: 28px;
    font-size: 12px;
  }
  .header-title {
    font-size: 15px;
  }
  .schedule-name {
    font-size: 11px;
  }
  .week-header-spacer {
    width: 36px;
  }
  .week-day {
    font-size: 10px;
  }
  .week-day.today-day {
    font-size: 11px;
  }
  .time-row {
    min-height: 26px;
  }
  .time-label {
    width: 36px;
    font-size: 8px;
  }
  .course-cell {
    height: 24px;
  }
  .course-char {
    font-size: 14px;
  }
  .course-empty {
    font-size: 8px;
  }
  .footer {
    padding: 4px 0;
  }
  .footer-text {
    font-size: 9px;
  }
}
</style>