<template>
  <div class="wv-page" style="background-color:{{ theme.bg }}">
    <!-- header -->
    <div class="wv-header">
      <input class="wv-back" type="button" value="返回" onclick="goBack" style="background-color:{{ theme.card }};color:{{ theme.accent }}" />
      <text class="wv-title" style="color:{{ theme.text }}">总课表</text>
    </div>

    <!-- schedule name + count -->
    <text class="wv-subtitle" style="color:{{ theme.accent }}">{{ scheduleName }}{{ showTotal ? '（'+totalCourses+'）' : '' }}</text>

    <!-- grid area -->
    <div class="wv-grid">
      <!-- day header -->
      <div class="wv-day-row">
        <text if="{{ showRowNum }}" class="wv-day-spacer" style="width:{{ rowNumWidth }}px"></text>
        <text if="{{ !showRowNum }}" class="wv-day-spacer" style="width:0px"></text>
        <text class="wv-day-cell {{ $idx === todayIndex ? 'wv-today' : '' }}" for="{{ weekDays }}" style="color:{{ $idx === todayIndex ? theme.accent : theme.textSecondary }}">{{ $item }}{{ showDayCount ? ' '+dayCounts[$idx] : '' }}</text>
      </div>

      <!-- scroll body -->
      <scroll class="wv-body" scroll-y="true">
        <div for="{{ timeSlots }}" class="wv-row" style="min-height:{{ rowHeight }}px">
          <text if="{{ showRowNum }}" class="wv-time" style="width:{{ rowNumWidth }}px;color:{{ theme.textSecondary }}">{{ $item.time }}</text>
          <div class="wv-cells">
            <div for="{{ $item.cells }}" class="wv-cell {{ $item.isCurrent ? 'wv-now' : '' }} {{ !$item.course ? 'wv-cell-empty' : '' }}" onclick="showDetail($item.day, $item.course)" style="background-color:{{ getCellBg($item.course) }};border-radius:{{ cellRadius }};height:{{ cellHeight }}px">
              <text if="{{ $item.course }}" class="wv-name" style="color:{{ getCellTextColor($item.course) }};font-size:{{ nameFontSize }}px;font-weight:{{ nameFontWeight }}">{{ getDisplayName($item.course) }}</text>
              <text if="{{ $item.course && showRoom && $item.course.location }}" class="wv-info" style="color:{{ theme.textMuted }};font-size:{{ infoFontSize }}px">{{ $item.course.location }}</text>
              <text if="{{ $item.course && showTeacher && $item.course.teacher }}" class="wv-info" style="color:{{ theme.textMuted }};font-size:{{ infoFontSize }}px">{{ $item.course.teacher }}</text>
              <text if="{{ $item.course && $item.course.extraCount > 0 }}" class="wv-extra" style="color:{{ theme.textMuted }}">+{{ $item.course.extraCount }}</text>
              <text if="{{ !$item.course }}" class="wv-empty" style="color:{{ theme.textMuted }}">·</text>
            </div>
          </div>
        </div>
      </scroll>
    </div>

    <!-- footer: template buttons -->
    <div class="wv-footer" style="background-color:{{ theme.card }}">
      <div class="wv-tpl-row">
        <div for="{{ templateList }}" class="wv-tpl {{ $item.id === currentTplId ? 'wv-tpl-on' : '' }}" onclick="switchTemplate($item.id)" style="background-color:{{ $item.id === currentTplId ? $item.activeColor : theme.borderLight }};color:{{ $item.id === currentTplId ? '#fff' : theme.textSecondary }};border-color:{{ $item.id === currentTplId ? $item.activeColor : 'transparent' }}">
          <text class="wv-tpl-text">{{ $item.label }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

// --- debug logger ---
var log = (function() {
  var seq = 0
  return function(msg, data) {
    seq++
    var line = "[WV:" + seq + "] " + msg
    if (data !== undefined) {
      try { line += " " + JSON.stringify(data) } catch(e) { line += " " + String(data) }
    }
    console.log(line)
  }
})()

// map Chinese day names (from DB) to English (used internally)
var DAY_NAME_MAP = {
  "星期一": "Monday", "星期二": "Tuesday", "星期三": "Wednesday",
  "星期四": "Thursday", "星期五": "Friday", "星期六": "Saturday", "星期日": "Sunday",
  "Monday": "Monday", "Tuesday": "Tuesday", "Wednesday": "Wednesday",
  "Thursday": "Thursday", "Friday": "Friday", "Saturday": "Saturday", "Sunday": "Sunday"
}

var SUBJECT_COLORS = {
  "math": "rgba(74,144,217,0.3)",
  "eng": "rgba(80,184,108,0.3)",
  "chn": "rgba(155,89,182,0.3)",
  "phy": "rgba(230,126,34,0.3)",
  "pe": "rgba(231,76,60,0.3)",
  "chem": "rgba(26,188,156,0.3)",
  "bio": "rgba(243,156,18,0.3)",
  "history": "rgba(52,152,219,0.3)",
  "geo": "rgba(233,30,99,0.3)",
  "default": "rgba(100,100,120,0.2)"
}

var SUBJECT_TEXT_COLORS = {
  "math": "#6aaaff",
  "eng": "#6ae6a0",
  "chn": "#c08ae0",
  "phy": "#f0a050",
  "pe": "#f06060",
  "chem": "#50d0b0",
  "bio": "#f0c040",
  "history": "#60b0f0",
  "geo": "#f060a0",
  "default": "#aaaac0"
}

function guessSubjectKey(name) {
  if (!name) return "default"
  var n = name.toLowerCase()
  if (n.indexOf("math") !== -1 || n.indexOf("数") !== -1) return "math"
  if (n.indexOf("eng") !== -1 || n.indexOf("英") !== -1) return "eng"
  if (n.indexOf("chn") !== -1 || n.indexOf("语") !== -1 || n.indexOf("文") !== -1) return "chn"
  if (n.indexOf("phy") !== -1 || n.indexOf("物") !== -1) return "phy"
  if (n.indexOf("pe") !== -1 || n.indexOf("体") !== -1 || n.indexOf("体育") !== -1) return "pe"
  if (n.indexOf("chem") !== -1 || n.indexOf("化") !== -1) return "chem"
  if (n.indexOf("bio") !== -1 || n.indexOf("生") !== -1) return "bio"
  if (n.indexOf("history") !== -1 || n.indexOf("史") !== -1 || n.indexOf("历史") !== -1) return "history"
  if (n.indexOf("geo") !== -1 || n.indexOf("地") !== -1) return "geo"
  return "default"
}

var TEMPLATE_CONFIGS = {
  "minimal-char": {
    showRowNum: false, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: false, showTotal: false,
    nameDisplay: "char",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "12px", rowHeight: 40, cellHeight: 36, rowNumWidth: 0,
    nameFontSize: 18, nameFontWeight: "bold", infoFontSize: 0,
    useColorScheme: true, denseMode: false
  },
  "minimal-en": {
    showRowNum: false, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: false, showTotal: false,
    nameDisplay: "en-abbr",
    dayLabels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
    cellRadius: "8px", rowHeight: 38, cellHeight: 34, rowNumWidth: 0,
    nameFontSize: 13, nameFontWeight: "bold", infoFontSize: 0,
    useColorScheme: true, denseMode: false
  },
  "standard-block": {
    showRowNum: true, showRoom: true, showTeacher: false, showTime: true,
    showDayCount: true, showTotal: true,
    nameDisplay: "full",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "6px", rowHeight: 48, cellHeight: 44, rowNumWidth: 50,
    nameFontSize: 12, nameFontWeight: "normal", infoFontSize: 9,
    useColorScheme: true, denseMode: false
  },
  "compact-grid": {
    showRowNum: true, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: true, showTotal: true,
    nameDisplay: "full",
    dayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    cellRadius: "3px", rowHeight: 30, cellHeight: 26, rowNumWidth: 40,
    nameFontSize: 10, nameFontWeight: "normal", infoFontSize: 0,
    useColorScheme: true, denseMode: true
  },
  "color-pastel": {
    showRowNum: true, showRoom: true, showTeacher: false, showTime: true,
    showDayCount: true, showTotal: true,
    nameDisplay: "full",
    dayLabels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
    cellRadius: "10px", rowHeight: 48, cellHeight: 44, rowNumWidth: 50,
    nameFontSize: 12, nameFontWeight: "normal", infoFontSize: 9,
    useColorScheme: false, denseMode: false
  }
}

export default {
  private: {
    allWeekDays: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    allDayNames: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    weekDays: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    displayDayNames: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    scheduleName: "",
    timeSlots: [],
    totalCourses: 0,
    totalDays: 0,
    dayCounts: [0, 0, 0, 0, 0, 0, 0],
    hideWeekend: true,
    viewIndex: 0,
    todayIndex: 0,
    currentCourseDay: "",
    currentCourseTime: "",
    initDone: false,
    firstLoad: true,
    currentTplId: "minimal-char",
    templateList: [
      { id: "minimal-char", label: "单字", activeColor: "#e67e22" },
      { id: "standard-block", label: "标准", activeColor: "#3498db" },
      { id: "compact-grid", label: "紧凑", activeColor: "#2ecc71" },
      { id: "minimal-en", label: "英文", activeColor: "#9b59b6" },
      { id: "color-pastel", label: "柔和", activeColor: "#e74c3c" }
    ],
    // template config
    showRowNum: false, showRoom: false, showTeacher: false, showTime: false,
    showDayCount: false, showTotal: false,
    nameDisplay: "char",
    cellRadius: "12px",
    rowHeight: 40,
    cellHeight: 36,
    rowNumWidth: 0,
    nameFontSize: 18,
    nameFontWeight: "bold",
    infoFontSize: 0,
    useColorScheme: true,
    templateDayLabels: ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"],
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '\uD83D\uDD35',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    log("onInit start")
    self.firstLoad = true
    var now = new Date()
    var dayIdx = now.getDay()
    self.todayIndex = dayIdx === 0 ? 6 : dayIdx - 1
    log("todayIndex=" + self.todayIndex + " dayIdx=" + dayIdx)
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getHideWeekend(function(hide) {
      self.hideWeekend = hide
      self.applyWeekendFilter()
      self.hideWeekendLoaded = true
      if (self.weekViewIndexLoaded) {
        self.initDone = true
        self.loadData()
      }
    })
    var storage = require("@system.storage")
    storage.get({
      key: "weekview_index",
      success: function(data) {
        self.viewIndex = parseInt(data) || 0
        log("onInit viewIndex loaded=" + self.viewIndex)
        self.weekViewIndexLoaded = true
        if (self.hideWeekendLoaded) {
          self.initDone = true
          self.loadData()
        }
      },
      fail: function() {
        log("onInit viewIndex not found, use 0")
        self.weekViewIndexLoaded = true
        if (self.hideWeekendLoaded) {
          self.initDone = true
          self.loadData()
        }
      }
    })
    store.getWeekViewTemplate(function(id) {
      self.applyTemplate(id || "minimal-char")
    })
    setTimeout(function() {
      if (!self.initDone) {
        log("onInit timeout fallback, forcing loadData")
        self.initDone = true
        self.loadData()
      }
    }, 800)
  },

  onShow() {
    var self = this
    log("onShow start")
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getHideWeekend(function(hide) {
      self.hideWeekend = hide
      self.applyWeekendFilter()
      if (self.firstLoad) {
        log("onShow firstLoad=false, skip reload")
        self.firstLoad = false
        return
      }
      var storage = require("@system.storage")
      storage.get({
        key: "weekview_index",
        success: function(data) {
          self.viewIndex = parseInt(data) || 0
          log("onShow viewIndex=" + self.viewIndex)
          self.loadTemplateAndReload()
        },
        fail: function() {
          self.loadTemplateAndReload()
        }
      })
    })
  },

  loadTemplateAndReload() {
    var self = this
    store.getWeekViewTemplate(function(id) {
      self.applyTemplate(id || "minimal-char")
      self.loadData()
    })
  },

  switchTemplate(id) {
    var self = this
    log("switchTemplate -> " + id)
    self.applyTemplate(id)
    store.setWeekViewTemplate(id)
    self.loadData()
  },

  applyTemplate(id) {
    var cfg = TEMPLATE_CONFIGS[id] || TEMPLATE_CONFIGS["minimal-char"]
    log("applyTemplate id=" + id + " nameDisplay=" + cfg.nameDisplay)
    this.currentTplId = id
    this.showRowNum = cfg.showRowNum
    this.showRoom = cfg.showRoom
    this.showTeacher = cfg.showTeacher
    this.showTime = cfg.showTime
    this.showDayCount = cfg.showDayCount !== false
    this.showTotal = cfg.showTotal !== false
    this.nameDisplay = cfg.nameDisplay
    this.cellRadius = cfg.cellRadius
    this.rowHeight = cfg.rowHeight
    this.cellHeight = cfg.cellHeight
    this.rowNumWidth = cfg.rowNumWidth
    this.nameFontSize = cfg.nameFontSize
    this.nameFontWeight = cfg.nameFontWeight
    this.infoFontSize = cfg.infoFontSize
    this.useColorScheme = cfg.useColorScheme
    this.templateDayLabels = cfg.dayLabels || ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"]
    this.applyWeekendFilter()
  },

  applyWeekendFilter() {
    var fullLabels = this.templateDayLabels || ["\u4e00", "\u4e8c", "\u4e09", "\u56db", "\u4e94", "\u516d", "\u65e5"]
    if (this.hideWeekend) {
      this.weekDays = fullLabels.slice(0, 5)
      this.displayDayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
      if (this.todayIndex >= 5) {
        this.todayIndex = -1
      }
    } else {
      this.weekDays = fullLabels
      this.displayDayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
      var now = new Date()
      var dayIdx = now.getDay()
      this.todayIndex = dayIdx === 0 ? 6 : dayIdx - 1
    }
    log("applyWeekendFilter hide=" + this.hideWeekend + " days=" + this.weekDays.join(",") + " todayIdx=" + this.todayIndex)
  },

  loadData() {
    var self = this
    log("loadData start viewIndex=" + self.viewIndex)

    store.getScheduleNames(function(names) {
      store.getCurrentScheduleIndex(function() {
        if (names && names.length > self.viewIndex) {
          self.scheduleName = names[self.viewIndex]
          log("loadData scheduleName=" + self.scheduleName)
        }
      })
    })

    var dataLoaded = false
    database.getAllCoursesWithIndex(this.viewIndex, function(schedule) {
      if (dataLoaded) return
      dataLoaded = true
      log("loadData getAllCoursesWithIndex returned, len=" + (schedule ? schedule.length : "null"))
      if (!schedule) {
        log("loadData schedule is null, fallback to getAllCourses")
        database.getAllCourses(function(fallback) {
          self.renderSchedule(fallback)
        })
        return
      }

      var allCourses = {}
      for (var d = 0; d < schedule.length; d++) {
        var dayData = schedule[d]
        if (dayData && dayData.day) {
          var enDay = DAY_NAME_MAP[dayData.day] || dayData.day
          allCourses[enDay] = dayData.classes || []
        }
      }
      log("loadData allCourses keys=" + Object.keys(allCourses).join(","))

      // dump every course
      for (var dk in allCourses) {
        if (allCourses.hasOwnProperty(dk)) {
          var cls = allCourses[dk]
          for (var ci = 0; ci < cls.length; ci++) {
            var c = cls[ci]
            log("loadData course " + dk + " #" + ci + " raw=" + JSON.stringify(c))
          }
        }
      }

      var totalCourses = 0
      for (var key in allCourses) {
        if (allCourses.hasOwnProperty(key)) {
          totalCourses += allCourses[key].length
        }
      }
      log("loadData totalCourses=" + totalCourses)

      if (totalCourses === 0) {
        log("loadData no courses found, fallback to getAllCourses")
        database.getAllCourses(function(fallback) {
          self.renderSchedule(fallback)
        })
        return
      }

      self.renderScheduleData(allCourses)
    })

    setTimeout(function() {
      if (!dataLoaded) {
        dataLoaded = true
        log("loadData timeout 1500ms fallback")
        database.getAllCourses(function(fallback) {
          self.renderSchedule(fallback)
        })
      }
    }, 1500)
  },

  renderSchedule(schedule) {
    log("renderSchedule len=" + (schedule ? schedule.length : "null"))
    var allCourses = {}
    if (schedule) {
      for (var d = 0; d < schedule.length; d++) {
        var dayData = schedule[d]
        if (dayData && dayData.day) {
          var enDay = DAY_NAME_MAP[dayData.day] || dayData.day
          allCourses[enDay] = dayData.classes || []
        }
      }
    }
    // dump fallback courses
    for (var dk in allCourses) {
      if (allCourses.hasOwnProperty(dk)) {
        var cls = allCourses[dk]
        for (var ci = 0; ci < cls.length; ci++) {
          log("renderSchedule course " + dk + " #" + ci + " raw=" + JSON.stringify(cls[ci]))
        }
      }
    }
    log("renderSchedule days=" + Object.keys(allCourses).join(","))
    this.renderScheduleData(allCourses)
  },

  renderScheduleData(allCourses) {
    var self = this
    log("renderScheduleData displayDayNames=" + JSON.stringify(self.displayDayNames) + " allCourses keys=" + Object.keys(allCourses).join(","))
    // log per-day course list
    var dayNames = self.displayDayNames
    for (var d = 0; d < dayNames.length; d++) {
      var day = dayNames[d]
      var courses = allCourses[day] || []
      if (courses.length > 0) {
        var names = courses.map(function(c) { return (c.name || "?") + "@" + (c.time || "?") }).join(", ")
        log("renderScheduleData day=" + day + " " + courses.length + " courses: " + names)
      }
    }

    self.detectCurrentCourse(allCourses)
    self.buildTimeSlots(allCourses)

    var total = 0
    var totalDays = 0
    for (var key in allCourses) {
      if (allCourses.hasOwnProperty(key)) {
        total += allCourses[key].length
        if (allCourses[key].length > 0) totalDays++
      }
    }
    self.totalCourses = total
    self.totalDays = totalDays
    log("renderScheduleData total=" + total + " days=" + totalDays)

    var dayCounts = []
    for (var dn = 0; dn < dayNames.length; dn++) {
      var dayCourses = allCourses[dayNames[dn]]
      dayCounts.push(dayCourses ? dayCourses.length : 0)
    }
    self.dayCounts = dayCounts
    log("renderScheduleData dayCounts=" + JSON.stringify(dayCounts))
  },

  getDisplayName(course) {
    if (!course) return ""
    var name = course.name || "?"
    var result
    if (this.nameDisplay === "char") {
      result = name.charAt(0)
    } else if (this.nameDisplay === "en-abbr") {
      result = name.substring(0, 3)
    } else {
      result = name
    }
    // log("getDisplayName mode=" + this.nameDisplay + " in=" + name + " out=" + result)
    return result
  },

  getCellBg(course) {
    if (!course) return "transparent"
    if (!this.useColorScheme) {
      return this.theme.cardLight || "#0f3460"
    }
    var key = guessSubjectKey(course.name)
    return SUBJECT_COLORS[key] || SUBJECT_COLORS["default"]
  },

  getCellTextColor(course) {
    if (!course) return "transparent"
    if (!this.useColorScheme) {
      return this.theme.accent || "#7ec8e3"
    }
    var key = guessSubjectKey(course.name)
    return SUBJECT_TEXT_COLORS[key] || SUBJECT_TEXT_COLORS["default"]
  },

  buildTimeSlots(allCourses) {
    var self = this
    var timeSet = {}
    var dayList = self.displayDayNames

    for (var d = 0; d < dayList.length; d++) {
      var day = dayList[d]
      var courses = allCourses[day] || []
      for (var c = 0; c < courses.length; c++) {
        var time = courses[c].time
        if (time && !timeSet[time]) {
          timeSet[time] = true
        }
      }
    }

    var timeKeys = Object.keys(timeSet)
    timeKeys.sort(function(a, b) {
      var aStart = a.split("-")[0].trim()
      var bStart = b.split("-")[0].trim()
      if (aStart < bStart) return -1
      if (aStart > bStart) return 1
      return 0
    })

    var timeSlots = []
    for (var t = 0; t < timeKeys.length; t++) {
      var time = timeKeys[t]
      var cells = []
      for (var d = 0; d < dayList.length; d++) {
        var day = dayList[d]
        var courses = allCourses[day] || []
        var matched = []
        for (var c = 0; c < courses.length; c++) {
          if (courses[c].time === time) {
            matched.push(courses[c])
          }
        }
        if (matched.length > 0) {
          var firstCourse = matched[0]
          cells.push({
            day: day,
            isCurrent: day === self.currentCourseDay && time === self.currentCourseTime,
            course: {
              id: firstCourse.id,
              name: firstCourse.name,
              displayChar: self.getFirstChar(firstCourse.name),
              extraCount: matched.length > 1 ? matched.length - 1 : 0,
              time: firstCourse.time,
              teacher: firstCourse.teacher,
              location: firstCourse.location,
              allCourses: matched
            }
          })
        } else {
          cells.push({
            day: day,
            isCurrent: false,
            course: null
          })
        }
      }
      timeSlots.push({
        time: time,
        cells: cells
      })
    }

    this.timeSlots = timeSlots
    log("buildTimeSlots slots=" + timeSlots.length + " times=" + timeKeys.join(","))
  },

  getFirstChar(name) {
    if (!name) return "?"
    return name.charAt(0)
  },

  detectCurrentCourse(allCourses) {
    var todayName = this.displayDayNames[this.todayIndex]
    if (!todayName) {
      this.currentCourseDay = ""
      this.currentCourseTime = ""
      return
    }
    var now = new Date()
    var currentTime = now.getHours() * 60 + now.getMinutes()

    this.currentCourseDay = ""
    this.currentCourseTime = ""

    var todayCourses = allCourses[todayName]
    if (!todayCourses) return

    for (var i = 0; i < todayCourses.length; i++) {
      var course = todayCourses[i]
      var timeRange = course.time
      if (!timeRange) continue
      var parts = timeRange.split("-")
      if (parts.length !== 2) continue
      var startParts = parts[0].trim().split(":")
      var endParts = parts[1].trim().split(":")
      var startTime = parseInt(startParts[0]) * 60 + parseInt(startParts[1])
      var endTime = parseInt(endParts[0]) * 60 + parseInt(endParts[1])
      if (currentTime >= startTime && currentTime <= endTime) {
        this.currentCourseDay = todayName
        this.currentCourseTime = course.time
        return
      }
    }
  },

  showDetail(day, course) {
    if (!course) return
    var storage = require("@system.storage")
    storage.set({
      key: "detail_classId",
      value: String(course.id)
    })
    storage.set({
      key: "detail_day",
      value: day
    })
    router.push({
      uri: "/pages/detail"
    })
  },

  goBack() {
    router.back()
  }
}
</script>

