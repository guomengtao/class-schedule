<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">自定义内容</text>
    </div>

    <scroll class="page-scroll" scroll-y="{{true}}">
      <div class="content">
        <div class="section" style="background-color: {{ theme.card }}">
          <text class="section-title" style="color: {{ theme.textSecondary }}">预览</text>
          <div class="preview-card" style="background-color: {{ theme.cardLight }}">
            <div class="preview-accent" style="background-color: {{ theme.accent }}"></div>
            <text class="preview-text" style="color: {{ theme.text }}">{{ previewText || '预览文字' }}</text>
          </div>
          <div class="preview-info" show="{{ hasSelection }}">
            <text class="preview-info-text" style="color: {{ theme.textSecondary }}">{{ previewIndex + 1 }}/{{ selectedCount }}</text>
          </div>
          <div class="preview-actions">
            <input class="edit-btn" type="button" value="编辑" onclick="editContent" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
            <input class="clear-btn" type="button" value="清空" onclick="clearAll" show="{{ hasSelection }}" style="background-color: {{ theme.cardLight }}; color: {{ theme.textSecondary }}" />
          </div>
        </div>

        <div class="section" style="background-color: {{ theme.card }}">
          <div class="section-head">
            <text class="section-title" style="color: {{ theme.textSecondary }}">文案库</text>
            <text class="section-count" style="color: {{ theme.textSecondary }}">已选 {{ selectedCount }}</text>
          </div>
          <div class="preset-row" for="item in presetItems" onclick="togglePreset(item)" style="background-color: {{ item.selected ? theme.cardLight : theme.card }}">
            <text class="preset-text" style="color: {{ item.selected ? theme.accent : theme.text }}">{{ item.text }}</text>
          </div>
        </div>

        <div class="section" style="background-color: {{ theme.card }}">
          <text class="section-title" style="color: {{ theme.textSecondary }}">切换间隔</text>
          <div class="interval-row">
            <div class="interval-item" onclick="selectSpeed(1)" style="background-color: {{ switchSpeed === 1 ? theme.accent : theme.cardLight }}">
              <text class="interval-text" style="color: {{ switchSpeed === 1 ? theme.bg : theme.text }}">1秒</text>
            </div>
            <div class="interval-item" onclick="selectSpeed(2)" style="background-color: {{ switchSpeed === 2 ? theme.accent : theme.cardLight }}">
              <text class="interval-text" style="color: {{ switchSpeed === 2 ? theme.bg : theme.text }}">2秒</text>
            </div>
            <div class="interval-item" onclick="selectSpeed(3)" style="background-color: {{ switchSpeed === 3 ? theme.accent : theme.cardLight }}">
              <text class="interval-text" style="color: {{ switchSpeed === 3 ? theme.bg : theme.text }}">3秒</text>
            </div>
            <div class="interval-item" onclick="selectSpeed(5)" style="background-color: {{ switchSpeed === 5 ? theme.accent : theme.cardLight }}">
              <text class="interval-text" style="color: {{ switchSpeed === 5 ? theme.bg : theme.text }}">5秒</text>
            </div>
            <div class="interval-item" onclick="selectSpeed(10)" style="background-color: {{ switchSpeed === 10 ? theme.accent : theme.cardLight }}">
              <text class="interval-text" style="color: {{ switchSpeed === 10 ? theme.bg : theme.text }}">10秒</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var DEFAULT_PRESETS = [
  "好好学习，天天向上",
  "今天也要加油鸭",
  "不忘初心，方得始终",
  "天道酬勤",
  "学海无涯苦作舟",
  "自律即自由",
  "今天的努力，明天的收获",
  "坚持就是胜利",
  "越努力越幸运",
  "知识改变命运",
  "一寸光阴一寸金",
  "书山有路勤为径",
  "相信自己，你可以的",
  "每天进步一点点",
  "星光不问赶路人",
  "未来可期",
  "努力是成功的基石",
  "心之所向，素履以往",
  "不负韶华",
  "加油，你是最棒的"
]

function buildPresetItems(selectedList) {
  var list = selectedList || []
  return DEFAULT_PRESETS.map(function(text) {
    return { text: text, selected: list.indexOf(text) >= 0 }
  })
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    presetItems: buildPresetItems([]),
    selectedPresets: [],
    selectedCount: 0,
    previewText: "",
    previewIndex: 0,
    hasSelection: false,
    switchSpeed: 3,
    intervalOptions: [
      { label: "1秒", value: 1 },
      { label: "2秒", value: 2 },
      { label: "3秒", value: 3 },
      { label: "5秒", value: 5 },
      { label: "10秒", value: 10 }
    ]
  },

  previewTimer: null,

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadContent()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadContent()
    self.startPreviewTimer()
    self.checkInputResult()
  },

  onHide() {
    this.stopPreviewTimer()
  },

  onDestroy() {
    this.stopPreviewTimer()
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadContent() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: "customContentList",
      success: function(data) {
        if (data) {
          try {
            var list = JSON.parse(data)
            if (list && list.length > 0) {
              self.selectedPresets = list
              self.selectedCount = list.length
              self.hasSelection = true
              self.presetItems = buildPresetItems(list)
              self.previewIndex = 0
              self.previewText = list[0]
              return
            }
          } catch (e) {}
        }
        self.loadLegacyContent()
      },
      fail: function() {
        self.loadLegacyContent()
      }
    })
    storage.get({
      key: "customContentInterval",
      success: function(data) {
        var val = parseInt(data)
        if (val >= 1 && val <= 10) {
          self.switchSpeed = val
        }
      },
      fail: function() {}
    })
  },

  loadLegacyContent() {
    var self = this
    store.getHomepageSettings(function(settings) {
      var content = settings.customContent || ""
      if (content) {
        self.selectedPresets = [content]
        self.selectedCount = 1
        self.hasSelection = true
        self.presetItems = buildPresetItems([content])
        self.previewIndex = 0
        self.previewText = content
      }
    })
  },

  editContent() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "自定义内容", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "输入自定义内容...", success: function() {} })
    storage.set({ key: "chinese_input_value", value: "", success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "20", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  checkInputResult() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          self.addCustomContent(data)
          storage.delete({ key: "chinese_input_result", fail: function() {} })
        }
      },
      fail: function() {}
    })
  },

  addCustomContent(text) {
    var self = this
    var list = self.selectedPresets.slice()
    if (list.indexOf(text) < 0) {
      list.push(text)
    }
    self.selectedPresets = list
    self.selectedCount = list.length
    self.hasSelection = list.length > 0
    self.presetItems = buildPresetItems(list)
    if (self.previewIndex >= list.length) {
      self.previewIndex = 0
    }
    if (list.length === 1) {
      self.previewText = list[0]
    }
    this.saveAll()
  },

  togglePreset(item) {
    var self = this
    var list = self.selectedPresets.slice()
    var idx = list.indexOf(item.text)
    if (idx >= 0) {
      list.splice(idx, 1)
    } else {
      list.push(item.text)
    }
    item.selected = !item.selected
    self.selectedPresets = list
    self.selectedCount = list.length
    self.hasSelection = list.length > 0
    if (self.previewIndex >= list.length) {
      self.previewIndex = 0
    }
    if (list.length === 0) {
      self.previewText = ""
      self.stopPreviewTimer()
    } else {
      self.previewText = list[self.previewIndex]
      if (!self.previewTimer) {
        self.startPreviewTimer()
      }
    }
    this.saveAll()
  },

  clearAll() {
    var self = this
    self.selectedPresets = []
    self.selectedCount = 0
    self.hasSelection = false
    self.previewText = ""
    self.previewIndex = 0
    self.presetItems = buildPresetItems([])
    self.stopPreviewTimer()
    this.saveAll()
  },

  selectSpeed(val) {
    var self = this
    self.switchSpeed = val
    var storage = require("@system.storage")
    storage.set({
      key: "customContentInterval",
      value: String(val),
      success: function() {},
      fail: function() {}
    })
    if (self.hasSelection && self.selectedCount > 1) {
      self.stopPreviewTimer()
      self.startPreviewTimer()
    }
  },

  startPreviewTimer() {
    var self = this
    if (!self.hasSelection || self.selectedCount <= 1) return
    if (self.previewTimer) return
    var interval = (self.switchSpeed || 3) * 1000
    self.previewTimer = setInterval(function() {
      var list = self.selectedPresets
      if (!list || list.length === 0) return
      self.previewIndex = (self.previewIndex + 1) % list.length
      self.previewText = list[self.previewIndex]
    }, interval)
  },

  stopPreviewTimer() {
    if (this.previewTimer) {
      clearInterval(this.previewTimer)
      this.previewTimer = null
    }
  },

  saveAll() {
    var self = this
    var list = self.selectedPresets
    var storage = require("@system.storage")
    storage.set({
      key: "customContentList",
      value: JSON.stringify(list),
      success: function() {},
      fail: function() {}
    })
    store.getHomepageSettings(function(settings) {
      settings.customContent = list.length > 0 ? list[0] : ""
      store.setHomepageSettings(settings)
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 10px 0 10px;
}

/* 标题 5 个字：去掉右侧 48px 等宽占位并降到 24px，
   否则 header.css 的 lines:1 + ellipsis 会把它切成「自定…」 */
.header-title {
  flex: 1;
  font-size: 24px;
  line-height: 32px;
  text-align: center;
}

.page-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.content {
  flex-direction: column;
  width: 100%;
  padding-bottom: 12px;
}

.section {
  flex-direction: column;
  width: 100%;
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 8px;
}

.section-title {
  font-size: 22px;
  margin-bottom: 8px;
  line-height: 30px;
}

/* 标题与右侧计数并排：单行标题里塞「文案库·已选N条」会折成两行 */
.section-head {
  flex-direction: row;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.section-count {
  font-size: 20px;
  line-height: 28px;
  flex-shrink: 0;
}

.preview-card {
  flex-direction: row;
  width: 100%;
  align-items: flex-start;
  padding: 10px 12px;
  border-radius: 10px;
  min-height: 44px;
}

.preview-accent {
  width: 4px;
  height: 26px;
  border-radius: 2px;
  margin-right: 8px;
  margin-top: 4px;
  flex-shrink: 0;
}

/* 关键：去掉 lines:1 + text-overflow，20 字自定义文案整段显示，卡片跟着长高 */
.preview-text {
  font-size: 24px;
  flex: 1;
  line-height: 34px;
}

.preview-info {
  flex-direction: row;
  width: 100%;
  justify-content: center;
  margin-top: 4px;
}

.preview-info-text {
  font-size: 20px;
  line-height: 28px;
}

.preview-actions {
  flex-direction: row;
  width: 100%;
  margin-top: 8px;
}

.edit-btn {
  flex: 1;
  height: 44px;
  border-radius: 8px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  line-height: 32px;
}

.clear-btn {
  width: 68px;
  height: 44px;
  border-radius: 8px;
  font-size: 22px;
  text-align: center;
  margin-left: 8px;
  border-width: 0;
  line-height: 30px;
}

/* 预设由「换行小胶囊」改成单列列表：胶囊宽度装不下 11 字文案，只能硬切 */
.preset-row {
  flex-direction: row;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  border-radius: 8px;
  margin-bottom: 6px;
  min-height: 42px;
}

.preset-text {
  font-size: 22px;
  line-height: 30px;
  flex: 1;
}

.preset-check {
  width: 24px;
  font-size: 22px;
  line-height: 30px;
  text-align: right;
  flex-shrink: 0;
}

.interval-row {
  flex-direction: row;
  width: 100%;
  flex-wrap: wrap;
}

.interval-item {
  /* 一行两枚：47% 会让 2×47% + 两个 6px 外边距超出容器而退化成一行一枚 */
  width: 45%;
  height: 38px;
  border-radius: 8px;
  margin: 0 4px 6px 0;
  align-items: center;
  justify-content: center;
}

.interval-text {
  font-size: 20px;
  line-height: 28px;
}

/* 圆形屏只收窄左右留白，其余沿用上面一套 */
@media (shape: circle) {
  .page { padding: 44px 24px 0 24px; }
}
</style>