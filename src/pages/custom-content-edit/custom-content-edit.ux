  font-size: 36px;
  font-weight: bold;
  flex: 1;
  text-align: center;
  margin-right: 64px;
}

.section {
  flex-direction: column;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 10px;
}

.section-title {
  font-size: 24px;
  margin-bottom: 10px;
}

.preview-card {
  flex-direction: row;
  align-items: center;
  padding: 14px 14px;
  border-radius: 10px;
  min-height: 50px;
}

.preview-accent {
  width: 4px;
  height: 28px;
  border-radius: 2px;
  margin-right: 10px;
  flex-shrink: 0;
}

.preview-text {
  font-size: 32px;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.preview-info {
  flex-direction: row;
  justify-content: center;
  margin-top: 6px;
}

.preview-info-text {
  font-size: 20px;
}

.preview-actions {
  flex-direction: row;
  margin-top: 10px;
}

.edit-btn {
  flex: 1;
  height: 48px;
  border-radius: 10px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
}

.clear-btn {
  width: 90px;
  height: 48px;
  border-radius: 10px;
  font-size: 24px;
  text-align: center;
  margin-left: 8px;
  border-width: 0;
}

.preset-grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.preset-item {
  height: 42px;
  border-radius: 10px;
  padding: 0 14px;
  margin: 0 6px 6px 0;
  align-items: center;
  justify-content: center;
}

.preset-text {
  font-size: 28px;
  lines: 1;
}

.interval-row {
  flex-direction: row;
}

.interval-item {
  height: 42px;
  border-radius: 10px;
  padding: 0 14px;
  margin: 0 6px 6px 0;
  align-items: center;
  justify-content: center;
}

.interval-text {
  font-size: 28px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .header {
    margin-bottom: 12px;
  }
  .back-btn {
    width: 44px;
    height: 40px;
    font-size: 28px;
  }
  .title {
    font-size: 36px;
    margin-right: 44px;
  }
  .section {
    padding: 12px;
    margin-bottom: 8px;
  }
  .section-title {
    font-size: 24px;
  }
  .preview-text {
    font-size: 28px;
  }
  .preview-info-text {
    font-size: 20px;
  }
  .edit-btn {
    height: 42px;
    font-size: 24px;
  }
  .clear-btn {
    width: 80px;
    height: 42px;
    font-size: 24px;
  }
  .preset-item {
    height: 38px;
    padding: 0 12px;
  }
  .preset-text {
    font-size: 24px;
  }
  .interval-item {
    height: 38px;
    padding: 0 12px;
  }
  .interval-text {
    font-size: 24px;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 10px 12px 10px;
  }
  .header {
    margin-bottom: 10px;
  }
  .back-btn {
    width: 36px;
    height: 32px;
    font-size: 24px;
  }
  .title {
    font-size: 36px;
    margin-right: 36px;
  }
  .section-title {
    font-size: 24px;
  }
  .preview-text {
    font-size: 28px;
  }
  .preview-info-text {
    font-size: 20px;
  }
  .edit-btn {
    height: 42px;
    font-size: 24px;
  }
  .clear-btn {
    width: 80px;
    height: 42px;
    font-size: 24px;
  }
  .preset-item {
    height: 36px;
  }
  .preset-text {
    font-size: 24px;
  }
  .interval-item {
    height: 36px;
  }
  .interval-text {
    font-size: 24px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 10px 12px 10px;
  }
  .header {
    margin-bottom: 10px;
  }
  .back-btn {
    width: 44px;
    height: 36px;
    font-size: 28px;
  }
  .title {
    font-size: 36px;
    margin-right: 44px;
  }
  .section-title {
    font-size: 24px;
  }
  .preview-text {
    font-size: 28px;
  }
  .preview-info-text {
    font-size: 20px;
  }
  .edit-btn {
    height: 42px;
    font-size: 24px;
  }
  .clear-btn {
    width: 80px;
    height: 42px;
    font-size: 24px;
  }
  .preset-item {
    height: 36px;
  }
  .preset-text {
    font-size: 24px;
  }
  .interval-item {
    height: 36px;
  }
  .interval-text {
    font-size: 24px;
  }
}
</style>