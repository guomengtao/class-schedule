  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 38px;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.section {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
}

.row-label {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 1;
  overflow: hidden;
}

.row-hint {
  font-size: 24px;
  margin-right: 6px;
  line-height: 38px;
}

.arrow {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.divider {
  height: 1px;
  margin: 6px 0;
}

@media (width >= 360) {
  .page-body { padding: 44px 20px 24px 20px; }
  .row { padding: 14px 0; }
}

@media (width >= 480) {
  .page-body { padding: 44px 48px 24px 48px; }
}
</style>