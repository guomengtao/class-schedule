<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">手机遥控</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="row" onclick="cmdFindPhone">
        <text class="row-label" style="color: {{ theme.text }}">找手机</text>
      </div>
      <div class="row" onclick="cmdPhoneStatus">
        <text class="row-label" style="color: {{ theme.text }}">手机状态</text>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="cmdMute">
        <text class="row-label" style="color: {{ theme.text }}">静音振动</text>
      </div>
      <div class="row" onclick="cmdCountdown">
        <text class="row-label" style="color: {{ theme.text }}">五分钟倒计</text>
      </div>
      <div class="row" onclick="cmdFlashlight">
        <text class="row-label" style="color: {{ theme.text }}">手电筒</text>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="cmdWeather">
        <text class="row-label" style="color: {{ theme.text }}">查天气</text>
      </div>
      <div class="row" onclick="cmdNavHome">
        <text class="row-label" style="color: {{ theme.text }}">导航回家</text>
      </div>
      <div class="row" onclick="cmdNavWork">
        <text class="row-label" style="color: {{ theme.text }}">去公司</text>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="cmdWord">
        <text class="row-label" style="color: {{ theme.text }}">问单词</text>
      </div>
      <div class="row" onclick="sendChatTest">
        <text class="row-label" style="color: {{ theme.text }}">发消息</text>
      </div>
      <div class="row" onclick="openMessageInbox">
        <text class="row-label" style="color: {{ theme.accent }}">留言板</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../../data/store.js")
const chatBridge = require("../../../data/chat-bridge.js")
const prompt = require("@system.prompt")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  cmdFindPhone() {
    chatBridge.sendCmd("find_phone", null)
  },

  cmdPhoneStatus() {
    chatBridge.sendCmd("phone_status", null)
  },

  cmdMute() {
    chatBridge.sendCmd("mute", null)
  },

  cmdCountdown() {
    chatBridge.sendCmd("countdown", { minutes: 5 })
  },

  cmdFlashlight() {
    chatBridge.sendCmd("flashlight", null)
  },

  cmdWeather() {
    chatBridge.sendCmd("weather", null)
  },

  cmdNavHome() {
    chatBridge.sendCmd("nav", { dest: "home" })
  },

  cmdNavWork() {
    chatBridge.sendCmd("nav", { dest: "work" })
  },

  cmdWord() {
    chatBridge.sendCmd("word", null)
  },

  sendChatTest() {
    var ok = chatBridge.send("来自手环 " + new Date().toLocaleTimeString())
    prompt.showToast({
      message: ok ? "已发送，看手机端有没有收到" : "connect 未就绪（先让手机发一条，或重启 EV）"
    })
  },

  openMessageInbox() {
    router.push({ uri: "/pages/message-inbox" })
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    this.theme = null
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
}

.back-btn-wrapper {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 22px;
  height: 22px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 36px;
}

.header-placeholder {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
}

.section {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.row {
  /* 单行制：只留命令名（ev-six「需要更小时说明内容该删，而不是字该缩」）。
     原「label 28px + hint 24px」两段文字挤在 140px 里，hint 被 overflow 切掉。 */
  flex-direction: row;
  align-items: center;
  padding: 12px 0;
}

.row-label {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.divider {
  height: 1px;
  margin: 6px 0;
}

@media (width >= 360) {
  .page-body { padding: 44px 20px 24px 20px; }
  .row { padding: 14px 0; }
}

@media (width >= 480) {
  .page-body { padding: 44px 48px 24px 48px; }
}
</style>