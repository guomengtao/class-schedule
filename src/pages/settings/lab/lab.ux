<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">实验室</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openChineseInput">
        <text class="row-label" style="color: {{ theme.text }}">中文输入演示</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openMediaTest">
        <text class="row-label" style="color: {{ theme.text }}">@media 语法测试</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openScheduleManagerV2">
        <text class="row-label" style="color: {{ theme.text }}">课程表管理 V2</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="row">
        <text class="row-label" style="color: {{ theme.text }}">后台常驻</text>
        <div class="switch-track" style="background-color: {{ bgRunning ? theme.accent : theme.border }}" onclick="toggleBgRunning">
          <div class="switch-thumb" style="left: {{ bgRunning ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <text class="row-hint" style="color: {{ theme.textMuted }}">退到后台继续接收手机同步消息，关闭后冷启动不再拉起</text>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    bgRunning: true,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    store.getBackgroundRunningConfig(function(config) {
      self.bgRunning = !(config && config.enabled === false)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
    store.getBackgroundRunningConfig(function(config) {
      self.bgRunning = !(config && config.enabled === false)
    })
  },

  // 后台常驻开关：写配置 + 通过 app.ux 暴露的全局控制即时 start/stop，
  // 不用等冷启动。模块多副本，globalThis 是唯一跨副本通道。
  toggleBgRunning() {
    var next = !this.bgRunning
    this.bgRunning = next
    store.setBackgroundRunningConfig({ enabled: next }, function() {
      var control = globalThis.__evResidentControl
      if (control) {
        if (next) {
          control.start()
        } else {
          control.stop()
        }
      }
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  openChineseInput() {
    router.push({ uri: "/pages/chinese-input" })
  },

  openMediaTest() {
    router.push({ uri: "/pages/media-test" })
  },

  openScheduleManagerV2() {
    router.push({ uri: "/pages/schedule-manager" })
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    this.theme = null
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 38px;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.section {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}

.row-label {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 1;
  overflow: hidden;
}

.row-hint {
  font-size: 24px;
  margin-right: 6px;
  line-height: 38px;
}

.arrow {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.divider {
  height: 1px;
  margin: 6px 0;
}

.switch-track {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  flex-shrink: 0;
  position: relative;
}

.switch-thumb {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  position: absolute;
  top: 2px;
}

@media (width >= 360) {
  .page-body { padding: 44px 20px 24px 20px; }
  .row { padding: 16px 0; }
}
</style>