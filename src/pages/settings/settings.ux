}
.nickname-value {
  line-height: 38px;
}
.nickname-arrow {
  margin-left: 4px;
}

.row-label {
  font-size: 30px;
  flex-shrink: 0;
  line-height: 40px;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 1;
  overflow: hidden;
}

.row-value {
  font-size: 28px;
  margin-right: 6px;
  line-height: 38px;
}

/* 小屏（base = 手环 9）默认隐藏每行辅助描述，只显示链接名称，避免内容过窄溢出 */
.row-hint {
  display: none;
  font-size: 28px;
  margin-right: 6px;
  line-height: 38px;
}

/* 小屏（base = 手环 9）默认隐藏字号数值，只显示"课程字号"四个字，避免内容过窄溢出 */
.size-indicator {
