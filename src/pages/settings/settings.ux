<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="settings-scroll" scroll-y="{{true}}">
    <div class="page-body">

    <!-- 统一 header（全项目同一骨架：36px 返回键 / 24px 居中标题 / 36px 占位）
         旧版这里是自造的双套 header（胶囊屏「返回键独占一行 + 标题在下方」），
         既与全项目不一致，又多吃掉 88px 垂直预算，已删除。 -->
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">设置</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 个人 -->
    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.textSecondary }}">个人</text>
      <div class="row info-row" onclick="openNicknameEdit">
        <text class="info-label" style="color: {{ theme.textSecondary }}">我的昵称</text>
        <text class="info-value" style="color: {{ nickname ? theme.text : theme.textMuted }}">{{ nickname ? nickname : '未设置' }}</text>
      </div>
      <div class="row" onclick="toggleTheme">
        <text class="row-label" style="color: {{ theme.text }}">主题配色</text>
      </div>
      <!-- 课程字号已迁至「首页设置」（pages/homepage-settings），本页不再持有字号入口，
           避免同一份 baseFontSize 出现两处可改（2026-10-23） -->
    </div>

    <!-- 课表 -->
    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.textSecondary }}">课表</text>
      <div class="row" onclick="openHomepageSettings">
        <text class="row-label" style="color: {{ theme.text }}">首页设置</text>
      </div>
      <div class="row" onclick="openSchedulePanel">
        <text class="row-label" style="color: {{ theme.text }}">更多首页</text>
      </div>
      <div class="row" onclick="toggleHideWeekend">
        <text class="row-label" style="color: {{ theme.text }}">周末</text>
        <!-- 开关亮 = 显示周末课程（hideWeekend 为 true 时开关灭） -->
        <div class="switch-track" style="background-color: {{ hideWeekend ? theme.border : theme.accent }}">
          <div class="switch-thumb" style="left: {{ hideWeekend ? '2px' : '20px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
    </div>

    <!-- 工具：旧版把「表盘 / 工具 / 手机遥控」塞进一张无标题的卡片，
         和上面的分组混在一起看不出归属，这里补上分组标题 -->
    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.textSecondary }}">工具</text>
      <div class="row" onclick="openWatchFaceList">
        <text class="row-label" style="color: {{ theme.text }}">表盘样式</text>
      </div>
      <div class="row" onclick="openTools">
        <text class="row-label" style="color: {{ theme.text }}">常用工具</text>
      </div>
      <div class="row" onclick="openPhoneRemote">
        <text class="row-label" style="color: {{ theme.text }}">手机遥控</text>
      </div>
    </div>

    <!-- 数据 -->
    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.textSecondary }}">数据</text>
      <div class="row" onclick="openBackupRestore">
        <text class="row-label" style="color: {{ theme.text }}">备份恢复</text>
      </div>
      <div class="row" onclick="openResetData">
        <text class="row-label" style="color: {{ theme.deleteText }}">重置数据</text>
      </div>
    </div>

    <!-- 关于 -->
    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.textSecondary }}">关于</text>
      <div class="row" onclick="openActivation">
        <text class="row-label" style="color: {{ theme.text }}">高级版本</text>
      </div>
      <div class="row" onclick="openFeedback">
        <text class="row-label" style="color: {{ theme.text }}">意见反馈</text>
      </div>
      <div class="row" onclick="openDonate">
        <text class="row-label" style="color: {{ theme.text }}">打赏支持</text>
      </div>
      <div class="row" onclick="goToWelcome">
        <text class="row-label" style="color: {{ theme.text }}">欢迎页面</text>
      </div>
    </div>

    <div class="settings-footer">
      <text class="version-text" style="color: {{ theme.textMuted }}">v{{ versionText }}</text>
      <input class="exit-app-btn" type="button"
             value="{{ exitConfirm ? '再点确认' : '退出应用' }}"
             onclick="handleExitApp"
             style="background-color: {{ theme.card }}; color: {{ exitConfirm ? theme.deleteText : theme.text }}" />
    </div>
    </div>
    </scroll>

    <unlock-dialog id="unlockDialog"></unlock-dialog>

    <!-- 显隐一律用 if（与重构前一致，真机验证过可用）。
         2026-10-23 那次重构把它改成 display:none→flex，手环上点「主题配色」就不弹了：
         Vela 真机对隐藏节点的 un-hide 不重绘。此处禁止改回 display / top 位移方案
         （top:100% 挪出屏幕在模拟器上直接失效，实测被当成 0 处理）。 -->
    <div class="overlay-modal" if="{{ showPremiumDialog }}" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%" onclick="dismissPremiumDialog">
      <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁功能</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">永久解锁</text>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="取消" onclick="dismissPremiumDialog"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>

    <div class="theme-drawer" if="{{ showTheme }}" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%" onclick="closeThemeDrawer">
      <div class="theme-drawer-panel" style="position: absolute; left: 0; bottom: 0; width: 100%; background-color: {{ theme.card }}" onclick="stopBubble">
        <div class="drawer-handle" style="background-color: {{ theme.border }}"></div>
        <text class="drawer-title" style="color: {{ theme.text }}">主题配色</text>
        <div class="theme-row">
          <div for="{{ themesRow1 }}" class="theme-item" onclick="selectTheme($item.key)" style="border-color: {{ currentThemeKey === $item.key ? theme.accent : 'transparent' }}">
            <div class="theme-dot" style="background-color: {{ $item.accent }}"></div>
            <text class="theme-name" style="color: {{ currentThemeKey === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.name }}</text>
          </div>
        </div>
        <div class="theme-row">
          <div for="{{ themesRow2 }}" class="theme-item" onclick="selectTheme($item.key)" style="border-color: {{ currentThemeKey === $item.key ? theme.accent : 'transparent' }}">
            <div class="theme-dot" style="background-color: {{ $item.accent }}"></div>
            <text class="theme-name" style="color: {{ currentThemeKey === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.name }}</text>
          </div>
        </div>
        <input class="drawer-done" type="button" value="完成" onclick="closeThemeDrawer"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const version = require("../../data/version.js")

var exitConfirmTimer = null

export default {
  private: {
    nickname: "",
    hideWeekend: true,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    currentThemeKey: "blue",
    iconTheme: "dark",
    themes: [],
    themesRow1: [],
    themesRow2: [],
    versionText: "",
    versionCode: 0,
    showPremiumDialog: false,
    showTheme: false,
    exitConfirm: false
  },

  onInit() {
    var self = this
    this.themes = store.getAvailableThemes ? store.getAvailableThemes() : []
    var mid = Math.ceil(this.themes.length / 2)
    this.themesRow1 = this.themes.slice(0, mid)
    this.themesRow2 = this.themes.slice(mid)

    store.getTheme(function(t, name) {
      self.theme = t
      self.currentThemeKey = name || "blue"
      self.updateIconSrc(name)
    })

    this.loadNickname()
    this.loadHideWeekend()
    this.versionText = version.versionName
    this.versionCode = version.versionCode
  },

  onShow() {
    this.loadNickname()
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  selectTheme(themeKey) {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      self.showTheme = false
      if (unlocked) {
        self.applyTheme(themeKey)
      } else {
        self.showPremiumDialog = true
      }
    })
  },

  applyTheme(themeKey) {
    var self = this
    this.currentThemeKey = themeKey
    store.setTheme(themeKey, function() {
      store.getTheme(function(t, themeName) {
        self.theme = t
        self.updateIconSrc(themeName)
      })
    })
  },

  loadNickname() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_nickname_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          var newName = data.trim()
          store.setNickname(newName, function() {
            self.nickname = newName
          })
          storage.delete({ key: "chinese_input_nickname_result", fail: function() {} })
          return
        }
        store.getNickname(function(name) {
          self.nickname = name || ""
        })
      },
      fail: function() {
        store.getNickname(function(name) {
          self.nickname = name || ""
        })
      }
    })
  },

  loadHideWeekend() {
    var self = this
    store.getHideWeekend(function(hide) {
      self.hideWeekend = hide
    })
  },

  toggleHideWeekend() {
    this.hideWeekend = !this.hideWeekend
    store.setHideWeekend(this.hideWeekend)
  },

  toggleTheme() {
    this.showTheme = true
  },

  closeThemeDrawer() {
    this.showTheme = false
  },

  openNicknameEdit() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "编辑昵称", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "输入昵称", success: function() {} })
    storage.set({ key: "chinese_input_value", value: this.nickname, success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "12", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_nickname_result", success: function() {} })
    // 2026-10-18：push 原来挂在最后一个 storage.set 的 success 回调里，
    // 实测该回调不触发 → 点昵称行完全没反应（模拟器连点3次页面无变化）。
    // storage.set 是即写即走的，同进程内 get 能读到刚写入的值，不必等回调再导航。
    router.push({ uri: "/pages/chinese-input" })
  },

  openFeedback() {
    router.push({ uri: "/pages/feedback" })
  },

  openTools() {
    router.push({ uri: "/pages/tools" })
  },

  openSchedulePanel() {
    router.push({ uri: "/pages/schedule-panel" })
  },

  openWatchFaceList() {
    router.push({ uri: "/pages/watch-face-list" })
  },

  openPhoneRemote() {
    router.push({ uri: "/pages/settings/phone-remote" })
  },

  openActivation() {
    router.push({ uri: "/pages/activation" })
  },

  openDonate() {
    router.push({ uri: "/pages/donate" })
  },

  goToPremium() {
    this.showPremiumDialog = false
    router.push({ uri: "/pages/activation" })
  },

  dismissPremiumDialog() {
    this.showPremiumDialog = false
  },

  stopBubble() {
  },

  openHomepageSettings() {
    router.push({ uri: "/pages/homepage-settings" })
  },

  openBackupRestore() {
    router.push({ uri: "/pages/backup-restore" })
  },

  openResetData() {
    router.push({ uri: "/pages/reset-data" })
  },

  goToWelcome() {
    router.push({ uri: "/pages/welcome" })
  },

  handleExitApp() {
    var self = this
    if (!this.exitConfirm) {
      this.exitConfirm = true
      this.clearExitConfirmTimer()
      exitConfirmTimer = setTimeout(function() {
        exitConfirmTimer = null
        self.exitConfirm = false
      }, 3000)
      return
    }
    this.clearExitConfirmTimer()
    this.exitConfirm = false
    var utils = require("../../data/utils.js")
    var ok = utils.exitApp()
    if (!ok) {
      var prompt = require("@system.prompt")
      prompt.showToast({ message: "请用系统手势退出应用" })
    }
  },

  clearExitConfirmTimer() {
    if (exitConfirmTimer) {
      clearTimeout(exitConfirmTimer)
      exitConfirmTimer = null
    }
  },

  goBack() {
    this.clearExitConfirmTimer()
    router.back()
  },

  onDestroy() {
    this.clearExitConfirmTimer()
  }
}
</script>

<style>
@import '../../common/header.css';

/* 192px 宽 · 内容宽 = 192 − 12×2 = 168；卡片内可用 = 168 − 8×2 = 152px
 * 实测汉字渲染宽 ≈ 1.33 × 字号：28px 的 4 字 = 149px（贴边单行），5 字 = 186px 必裁。
 * → 本页所有行标签一律 ≤4 字；不设导航箭头（手册红线 6），可点性靠卡片底色。
 * 旧版页面 padding 上下 8px、卡片 padding 18px、行 padding 12px，一屏只放得下 5 个条目。 */
.page {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
  box-sizing: border-box;
}

.settings-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 12px 12px 12px;
  box-sizing: border-box;
}

/* ---- header：与全项目同一骨架 ---- */
.back-header {
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-bottom: 10px;
}

.back-btn-wrapper {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 32px;
}

.header-placeholder {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
}

/* ---- 分组卡片 ---- */
.group {
  flex-direction: column;
  width: 100%;
  border-radius: 14px;
  padding: 10px 8px;
  margin-bottom: 10px;
  box-sizing: border-box;
}

.group-title {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  padding-left: 2px;
  margin-bottom: 2px;
  flex-shrink: 0;
}

/* 行高 46px：38(行高) + 4×2(padding) 已满足 44px 热区下限；
 * 行与行之间靠这 8px 纵向间距分隔，不写 border（border-bottom 会被渲染成四边框） */
.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 4px 0;
  min-height: 46px;
  box-sizing: border-box;
}

.row-label {
  font-size: 28px;
  line-height: 38px;
  flex-shrink: 0;
}

/* 信息行竖排（手册 #13）：标签 24px 灰在上 / 值 28px 亮在下
 * 横排不行：28px 的「我的昵称」就吃 149px，剩下的放不下任何昵称值 */
.info-row {
  flex-direction: column;
  align-items: flex-start;
}

.info-label {
  font-size: 24px;
  line-height: 34px;
  flex-shrink: 0;
}

.info-value {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  width: 100%;
  lines: 2;
}

.switch-track {
  width: 40px;
  height: 22px;
  border-radius: 11px;
  flex-shrink: 0;
  position: relative;
}

.switch-thumb {
  width: 18px;
  height: 18px;
  border-radius: 9px;
  position: absolute;
  top: 2px;
}

/* ---- 页脚 ---- */
.settings-footer {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.version-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  width: 100%;
  padding: 2px 0 10px 0;
}

.exit-app-btn {
  width: 100%;
  height: 46px;
  border-radius: 23px;
  font-size: 28px;
  text-align: center;
  border-width: 0;
  line-height: 46px;
}

/* ---- 高级版弹窗 ---- */
.overlay-modal {
  background-color: rgba(0, 0, 0, 0.6);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 1100;
}

.modal-card {
  width: 92%;
  border-radius: 16px;
  padding: 16px 10px;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.modal-title {
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 4px;
  text-align: center;
  line-height: 38px;
}

.modal-desc {
  font-size: 24px;
  text-align: center;
  margin-bottom: 12px;
  line-height: 34px;
}

.modal-btn-primary {
  width: 100%;
  height: 46px;
  border-radius: 23px;
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 8px;
  line-height: 46px;
}

.modal-btn-secondary {
  width: 100%;
  height: 46px;
  border-radius: 23px;
  font-size: 28px;
  line-height: 46px;
}

/* ---- 主题抽屉 ---- */
.theme-drawer {
  background-color: rgba(0, 0, 0, 0.55);
  z-index: 1200;
  flex-direction: column;
  justify-content: flex-end;
}

.theme-drawer-panel {
  border-radius: 20px 20px 0 0;
  padding: 10px 12px 16px 12px;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.drawer-handle {
  width: 44px;
  height: 6px;
  border-radius: 3px;
  margin-bottom: 8px;
}

.drawer-title {
  font-size: 28px;
  line-height: 38px;
  text-align: center;
  margin-bottom: 4px;
}

.theme-row {
  flex-direction: row;
  width: 100%;
}

.theme-item {
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 8px 0;
  border-radius: 10px;
  border: 2px solid transparent;
}

.theme-dot {
  width: 24px;
  height: 24px;
  border-radius: 12px;
}

.theme-name {
  font-size: 24px;
  margin-top: 2px;
  text-align: center;
  line-height: 34px;
}

.drawer-done {
  width: 100%;
  height: 46px;
  border-radius: 23px;
  font-size: 28px;
  margin-top: 8px;
  line-height: 46px;
}

/* ---- 方屏 / 圆屏：只放大字号与留白，不引入第五档字号 ---- */
@media screen and (shape: rect) {
  .page-body {
    padding: 40px 20px 16px 20px;
  }

  .row-label {
    font-size: 30px;
    line-height: 40px;
  }

  .group-title {
    font-size: 30px;
    line-height: 40px;
  }

  .info-value {
    font-size: 30px;
    line-height: 40px;
  }

  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
}

@media screen and (shape: circle) {
  .page-body {
    padding: 56px 40px 32px 40px;
  }

  .row-label {
    font-size: 30px;
    line-height: 40px;
  }

  .group-title {
    font-size: 30px;
    line-height: 40px;
  }

  .info-value {
    font-size: 30px;
    line-height: 40px;
  }

  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
}
</style>
