  }
  .toggle-btn {
    width: 56px;
    height: 44px;
    font-size: 26px;
    line-height: 44px;
  }
}

/* ===== 主题配色：底部抽屉弹 =====
   几何策略：面板用 left/bottom 贴底 + width: 100% 通栏 —— 不做任何居中计算，
   因此与屏幕宽高、屏型全部无关（192 胶囊 / 336 方屏表现一致）。
   定位属性已移至模板 inline style（手环 9 兼容性要求）。 */
.theme-drawer {
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 1200;
}
.theme-drawer-panel {
  border-radius: 20px 20px 0 0;
  padding: 10px 14px 18px 14px;
  flex-direction: column;
  align-items: center;
}
.drawer-handle {
  width: 44px;
