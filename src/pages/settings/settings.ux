<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="settings-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">设置</text>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openNicknameEdit">
        <text class="row-label" style="color: {{ theme.text }}">昵称</text>
        <div class="row-right">
          <text class="row-value" if="{{ nickname }}" style="color: {{ theme.accent }}">{{ nickname }}</text>
          <text class="row-hint" if="{{ !nickname }}" style="color: {{ theme.textMuted }}">点击设置</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.text }}">主题配色</text>
      <div class="theme-grid">
        <div for="{{ themes }}" class="theme-item {{ currentThemeKey === $item.key ? 'active' : '' }}" onclick="selectTheme($item.key)" style="border-color: {{ currentThemeKey === $item.key ? theme.accent : 'transparent' }}">
          <div class="theme-dot" style="background-color: {{ $item.accent }}"></div>
          <text class="theme-name" style="color: {{ currentThemeKey === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.name }}</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="group-title-row" onclick="toggleFontSize">
        <text class="group-title" style="color: {{ theme.text }}">字体大小</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">{{ displaySize }}px</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">{{ showFontSize ? 'v' : '›' }}</text>
        </div>
      </div>
      <div if="{{ showFontSize }}" class="font-size-body">
        <div class="scale-row">
          <input class="scale-btn" type="button" value="−" onclick="decreaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="scale-value" style="color: {{ theme.accent }}">{{ displaySize }}px</text>
          <input class="scale-btn" type="button" value="+" onclick="increaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
        <div class="preview-box" style="background-color: {{ theme.cardLight }}">
          <text class="preview-text" style="font-size: {{ displaySize }}px; color: {{ theme.text }}">数学 08:00</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="group-title-row" onclick="toggleDefaultHomepage">
        <text class="group-title" style="color: {{ theme.text }}">默认首页</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">{{ defaultHomepageLabel }}</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">{{ showDefaultHomepage ? 'v' : '›' }}</text>
        </div>
      </div>
      <div if="{{ showDefaultHomepage }}" class="default-homepage-body">
        <text class="section-label" style="color: {{ theme.textSecondary }}">目标页面</text>
        <div class="page-options">
          <div class="page-option {{ defaultTargetPage === 'index-full' ? 'active' : '' }}" onclick="selectTargetPage('index-full')" style="background-color: {{ defaultTargetPage === 'index-full' ? theme.accent : theme.cardLight }}">
            <text class="page-option-text" style="color: {{ defaultTargetPage === 'index-full' ? theme.bg : theme.text }}">标准页</text>
          </div>
          <div class="page-option {{ defaultTargetPage === 'week-view' ? 'active' : '' }}" onclick="selectTargetPage('week-view')" style="background-color: {{ defaultTargetPage === 'week-view' ? theme.accent : theme.cardLight }}">
            <text class="page-option-text" style="color: {{ defaultTargetPage === 'week-view' ? theme.bg : theme.text }}">总课表</text>
          </div>
        </div>
        <text class="section-label" style="color: {{ theme.textSecondary }}">跳转</text>
        <div class="page-options">
          <div class="page-option {{ defaultAutoSeconds === 0 ? 'active' : '' }}" onclick="selectAutoSeconds(0)" style="background-color: {{ defaultAutoSeconds === 0 ? theme.accent : theme.cardLight }}">
            <text class="page-option-text" style="color: {{ defaultAutoSeconds === 0 ? theme.bg : theme.text }}">0秒</text>
          </div>
          <div class="page-option {{ defaultAutoSeconds === 3 ? 'active' : '' }}" onclick="selectAutoSeconds(3)" style="background-color: {{ defaultAutoSeconds === 3 ? theme.accent : theme.cardLight }}">
            <text class="page-option-text" style="color: {{ defaultAutoSeconds === 3 ? theme.bg : theme.text }}">3秒</text>
          </div>
          <div class="page-option {{ defaultAutoSeconds === 5 ? 'active' : '' }}" onclick="selectAutoSeconds(5)" style="background-color: {{ defaultAutoSeconds === 5 ? theme.accent : theme.cardLight }}">
            <text class="page-option-text" style="color: {{ defaultAutoSeconds === 5 ? theme.bg : theme.text }}">5秒</text>
          </div>
          <div class="page-option {{ defaultAutoSeconds === -1 ? 'active' : '' }}" onclick="selectAutoSeconds(-1)" style="background-color: {{ defaultAutoSeconds === -1 ? theme.accent : theme.cardLight }}">
            <text class="page-option-text" style="color: {{ defaultAutoSeconds === -1 ? theme.bg : theme.text }}">不跳转</text>
          </div>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.text }}">课程表设置</text>
      <div class="row">
        <text class="row-label" style="color: {{ theme.text }}">隐藏周末</text>
        <input class="toggle-btn" type="button" value="{{ hideWeekend ? '开' : '关' }}" onclick="toggleHideWeekend" style="background-color: {{ hideWeekend ? theme.accent : theme.border }}; color: {{ hideWeekend ? theme.bg : theme.textSecondary }}" />
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openTemplatePicker">
        <text class="row-label" style="color: {{ theme.text }}">课表风格</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.accent }}">{{ currentTemplateName }}</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openHomepageSettings">
        <text class="row-label" style="color: {{ theme.text }}">首页设置</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">栏目时间</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openBackupRestore">
        <text class="row-label" style="color: {{ theme.text }}">数据备份</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">云端备份</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openTestArea">
        <text class="row-label" style="color: {{ theme.text }}">功能实验室</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">实验性功能</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openActivation">
        <text class="row-label" style="color: {{ theme.text }}">高级版</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">解锁</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openDonate">
        <text class="row-label" style="color: {{ theme.text }}">打赏支持</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">支持</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openResetData">
        <text class="row-label" style="color: {{ theme.deleteText }}">恢复默认</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">重置</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="save-area">
      <input class="save-btn" type="button" value="保存" onclick="saveSettings" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <text class="version-text" style="color: {{ theme.textMuted }}">v{{ versionText }}</text>
    <text class="welcome-link" onclick="goToWelcome" style="color: {{ theme.accent }}">欢迎页</text>

    <unlock-dialog id="unlockDialog"></unlock-dialog>

    <div class="overlay-bottom-sheet" if="{{ showPremiumDialog }}" onclick="dismissPremiumDialog">
      <div class="bottom-sheet" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <div class="sheet-handle" style="background-color: {{ theme.textMuted }}"></div>
        <text class="sheet-title" style="color: {{ theme.accent }}">解锁高级功能</text>
        <text class="sheet-desc" style="color: {{ theme.textSecondary }}">升级解锁多套主题</text>
        <div class="benefit-list">
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多课表管理</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
        </div>
        <input class="sheet-btn" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="sheet-cancel" type="button" value="暂不需要" onclick="dismissPremiumDialog"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const version = require("../../data/version.js")

const sizeLevels = [20, 28, 36, 48, 62, 76]

export default {
  private: {
    nickname: "",
    displaySize: 48,
    previewClassSize: 48,
    hideWeekend: true,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    currentThemeKey: "blue",
    themes: [],
    versionText: "",
    showPremiumDialog: false,
    showFontSize: false,
    showDefaultHomepage: false,
    defaultTargetPage: "index-full",
    defaultAutoSeconds: 3,
    defaultHomepageLabel: "标准页",
    currentTemplateName: "Minimal Char"
  },

  onInit() {
    var self = this
    this.themes = store.getAvailableThemes ? store.getAvailableThemes() : []

    store.getTheme(function(t, name) {
      self.theme = t
      self.currentThemeKey = name || "blue"
    })

    store.getBaseFontSize(function(size) {
      self.displaySize = size
    }, true)
    this.loadNickname()
    this.loadHideWeekend()
    this.loadDefaultHomepage()
    this.loadTemplateName()
    this.versionText = version.versionName
  },

  onShow() {
    this.loadNickname()
  },

  updatePreviews() {
    var r = this.displaySize / 48
    this.previewClassSize = Math.round(28 * r)
  },

  setSize(size) {
    this.displaySize = size
    store.setBaseFontSize(size)
  },

  set20() { this.setSize(20) },

  decreaseFont() {
    for (var i = sizeLevels.length - 1; i >= 0; i--) {
      if (sizeLevels[i] < this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  increaseFont() {
    for (var i = 0; i < sizeLevels.length; i++) {
      if (sizeLevels[i] > this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  toggleFontSize() {
    this.showFontSize = !this.showFontSize
  },

  selectTheme(themeKey) {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        self.applyTheme(themeKey)
      } else {
        self.showPremiumDialog = true
      }
    })
  },

  applyTheme(themeKey) {
    var self = this
    this.currentThemeKey = themeKey
    store.setTheme(themeKey, function() {
      store.getTheme(function(t) {
        self.theme = t
      })
    })
  },

  loadNickname() {
    var self = this
    store.getNickname(function(name) {
      self.nickname = name || ""
    })
  },

  loadHideWeekend() {
    var self = this
    store.getHideWeekend(function(hide) {
      self.hideWeekend = hide
    })
  },

  toggleHideWeekend() {
    this.hideWeekend = !this.hideWeekend
    store.setHideWeekend(this.hideWeekend)
  },

  toggleDefaultHomepage() {
    this.showDefaultHomepage = !this.showDefaultHomepage
  },

  selectTargetPage(page) {
    this.defaultTargetPage = page
    this.updateDefaultHomepageLabel()
    this.saveDefaultHomepage()
  },

  selectAutoSeconds(seconds) {
    this.defaultAutoSeconds = seconds
    this.updateDefaultHomepageLabel()
    this.saveDefaultHomepage()
  },

  loadDefaultHomepage() {
    var self = this
    store.getDefaultHomepage(function(settings) {
      self.defaultTargetPage = settings.targetPage || "index-full"
      self.defaultAutoSeconds = settings.autoSeconds
      if (self.defaultAutoSeconds === undefined) self.defaultAutoSeconds = 3
      self.updateDefaultHomepageLabel()
    })
  },

  updateDefaultHomepageLabel() {
    var pageName = this.defaultTargetPage === "week-view" ? "总课表" : "标准页"
    var autoLabel = ""
    if (this.defaultAutoSeconds === 0) {
      autoLabel = " 0s"
    } else if (this.defaultAutoSeconds === 3) {
      autoLabel = " 3s"
    } else if (this.defaultAutoSeconds === 5) {
      autoLabel = " 5s"
    } else {
      autoLabel = " 手动"
    }
    this.defaultHomepageLabel = pageName + autoLabel
  },

  saveDefaultHomepage() {
    store.setDefaultHomepage({
      targetPage: this.defaultTargetPage,
      autoSeconds: this.defaultAutoSeconds
    })
  },

  openNicknameEdit() {
    router.push({ uri: "/pages/nickname-edit" })
  },

  openTestArea() {
    router.push({ uri: "/pages/lab" })
  },

  openActivation() {
    router.push({ uri: "/pages/activation" })
  },

  openDonate() {
    router.push({ uri: "/pages/donate" })
  },

  goToPremium() {
    this.showPremiumDialog = false
    router.push({ uri: "/pages/activation" })
  },

  dismissPremiumDialog() {
    this.showPremiumDialog = false
  },

  stopBubble() {
  },

  openHomepageSettings() {
    router.push({ uri: "/pages/homepage-settings" })
  },

  openBackupRestore() {
    router.push({ uri: "/pages/backup-restore" })
  },

  openResetData() {
    router.push({ uri: "/pages/reset-data" })
  },

  loadTemplateName() {
    var self = this
    store.getWeekViewTemplate(function(id) {
      var names = {
        "minimal-char": "Minimal Char",
        "minimal-en": "Minimal EN",
        "standard-block": "Standard Block",
        "compact-grid": "Compact Grid",
        "color-pastel": "Color Pastel"
      }
      self.currentTemplateName = names[id] || "Minimal Char"
    })
  },

  openTemplatePicker() {
    router.push({ uri: "/pages/template-picker" })
  },

  goToWelcome() {
    router.push({ uri: "/pages/welcome" })
  },

  goBack() {
    router.back()
  },

  saveSettings() {
    var self = this
    store.setTheme(this.currentThemeKey, function() {
      store.setBaseFontSize(self.displaySize, function() {
        store.setHideWeekend(self.hideWeekend, function() {
          store.getTheme(function(t) {
            self.theme = t
          })
        })
      })
    })
  }
}
</script>

<style>
.settings-page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 44px 10px 12px 10px;
  position: relative;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 4px;
}

.back-btn {
  width: 64px;
  height: 38px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.header-title {
  font-size: 36px;
  font-weight: bold;
  margin-left: 12px;
}

.group {
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.group-title {
  font-size: 28px;
  font-weight: bold;
  opacity: 0.8;
}

.group-title-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.font-size-body {
  flex-direction: column;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}

.row-label {
  font-size: 32px;
  flex-shrink: 0;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 1;
  overflow: hidden;
}

.row-value {
  font-size: 28px;
  margin-right: 6px;
}

.row-hint {
  font-size: 28px;
  margin-right: 6px;
  max-lines: 1;
}

.arrow {
  font-size: 28px;
  flex-shrink: 0;
}

.divider {
  height: 1px;
  margin: 6px 0;
}

.theme-grid {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 14px;
}

.theme-item {
  flex-direction: column;
  align-items: center;
  width: 20%;
  padding: 12px 0;
  border-radius: 8px;
  border: 2px solid transparent;
}

.theme-dot {
  width: 26px;
  height: 26px;
  border-radius: 13px;
}

.theme-name {
  font-size: 28px;
  margin-top: 4px;
  text-align: center;
}

.scale-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.scale-btn {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
}

.scale-value {
  font-size: 28px;
  font-weight: bold;
  width: 72px;
  text-align: center;
}

.preview-box {
  border-radius: 8px;
  padding: 12px;
  align-items: center;
  justify-content: center;
}

.preview-text {
  font-weight: bold;
  text-align: center;
}

.toggle-btn {
  width: 60px;
  height: 36px;
  border-radius: 8px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
}

.save-area {
  margin-top: 22px;
  padding-bottom: 8px;
}

.save-btn {
  width: 100%;
  height: 48px;
  border-radius: 12px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
}

.version-text {
  font-size: 24px;
  text-align: center;
  padding-top: 14px;
  padding-bottom: 8px;
}

.welcome-link {
  font-size: 28px;
  text-align: center;
  padding-bottom: 20px;
}

.overlay-bottom-sheet {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  flex-direction: column;
  justify-content: flex-end;
}

.bottom-sheet {
  width: 100%;
  border-radius: 16px 16px 0 0;
  padding: 14px 20px 24px 20px;
  flex-direction: column;
  align-items: center;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  margin-bottom: 18px;
}

.sheet-title {
  font-size: 36px;
  font-weight: bold;
  margin-bottom: 10px;
  text-align: center;
}

.sheet-desc {
  font-size: 28px;
  text-align: center;
  margin-bottom: 20px;
  line-height: 36px;
}

.benefit-list {
  width: 100%;
  flex-direction: column;
  padding-left: 12px;
  margin-bottom: 26px;
}

.benefit-item {
  font-size: 32px;
  margin-bottom: 10px;
}

.sheet-btn {
  width: 100%;
  height: 42px;
  border-radius: 21px;
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 8px;
}

.sheet-cancel {
  width: 100%;
  height: 36px;
  border-radius: 18px;
  font-size: 28px;
}

.default-homepage-body {
  padding: 8px 0;
}

.section-label {
  font-size: 28px;
  margin: 12px 0 8px 0;
}

.page-options {
  flex-direction: row;
  flex-wrap: wrap;
}

.page-option {
  height: 38px;
  border-radius: 8px;
  padding: 0 14px;
  margin: 0 8px 8px 0;
  align-items: center;
  justify-content: center;
}

.page-option-text {
  font-size: 28px;
}

@media (shape: circle) {
  .settings-page {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    margin-bottom: 8px;
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 52px;
    height: 40px;
    font-size: 24px;
  }
  .header-title {
    font-size: 32px;
  }
  .row-label {
    font-size: 28px;
  }
  .row-hint {
    font-size: 24px;
  }
  .toggle-btn {
    width: 52px;
    height: 38px;
    font-size: 24px;
  }
  .save-btn {
    height: 42px;
    font-size: 24px;
  }
  .version-text {
    font-size: 20px;
  }
