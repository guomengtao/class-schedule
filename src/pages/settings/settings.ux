<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="settings-page" style="background-color: {{ theme.bg }}">
    <!-- 可滚动内容区：修复小屏下方行点不到的问题（档案 P0） -->
    <scroll class="settings-scroll" scroll-y="{{true}}">
    <!-- 内层承载页面 padding：让抽屉弹（绝对定位）能真正贴到屏幕底部与左右边缘 -->
    <div class="settings-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">设置</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row nickname-row" onclick="openNicknameEdit">
        <text class="row-label nickname-label" style="color: {{ theme.text }}">昵称</text>
        <div class="row-right nickname-value-wrap">
          <text class="row-value nickname-value" if="{{ nickname }}" style="color: {{ theme.accent }}">{{ nickname }}</text>
          <text class="row-hint" if="{{ !nickname }}" style="color: {{ theme.textMuted }}">点击设置</text>
          <text class="arrow nickname-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="group-title-row" onclick="toggleTheme">
        <text class="group-title" style="color: {{ theme.text }}">主题配色</text>
        <div class="row-right">
          <text class="arrow" style="color: {{ theme.textMuted }}">{{ showTheme ? 'v' : '›' }}</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="group-title-row" onclick="toggleFontSize">
        <text class="group-title" style="color: {{ theme.text }}">课程字号</text>
        <div class="row-right">
          <text class="size-indicator" style="color: {{ theme.textMuted }}">{{ displaySize }}px</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">{{ showFontSize ? 'v' : '›' }}</text>
        </div>
      </div>
      <div if="{{ showFontSize }}" class="font-size-body">
        <div class="scale-row">
          <input class="scale-btn" type="button" value="−" onclick="decreaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="scale-value" style="color: {{ theme.accent }}">{{ displaySize }}px</text>
          <input class="scale-btn" type="button" value="+" onclick="increaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
        <div class="preview-box" style="background-color: {{ theme.cardLight }}">
          <text class="preview-text" style="font-size: {{ previewDisplaySize }}px; color: {{ theme.text }}">数学 08:00</text>
        </div>
        <!-- 本项设计上只作用于首页课程卡片（其余页面用固定字号保证布局与触控达标），
             必须显式告知用户作用范围，否则会被理解为"设置没生效" -->
        <text class="scope-hint" style="color: {{ theme.textMuted }}">仅影响首页课程卡片，其他页面为固定字号</text>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="group-title-row" onclick="toggleSchedule">
        <text class="group-title" style="color: {{ theme.text }}">周课表</text>
        <div class="row-right">
          <text class="arrow" style="color: {{ theme.textMuted }}">{{ showSchedule ? 'v' : '›' }}</text>
        </div>
      </div>
      <div if="{{ showSchedule }}" style="flex-direction: column">
        <div class="row">
          <text class="row-label" style="color: {{ theme.text }}">隐藏周末</text>
          <div class="switch-track" style="background-color: {{ hideWeekend ? theme.accent : theme.border }}" onclick="toggleHideWeekend">
            <div class="switch-thumb" style="left: {{ hideWeekend ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openHomepageSettings">
        <text class="row-label" style="color: {{ theme.text }}">首页设置</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">栏目时间</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openFeedback">
        <text class="row-label" style="color: {{ theme.text }}">帮助与反馈</text>
      </div>
      <div class="row" onclick="openTools">
        <text class="row-label" style="color: {{ theme.text }}">工具</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">调试、二维码等</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openBackupRestore">
        <text class="row-label" style="color: {{ theme.text }}">数据备份</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">云端备份</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openActivation">
        <text class="row-label" style="color: {{ theme.text }}">高级版</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">解锁</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openDonate">
        <text class="row-label" style="color: {{ theme.text }}">打赏支持</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">支持</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openResetData">
        <text class="row-label" style="color: {{ theme.deleteText }}">恢复默认</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">重置</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <text class="version-text" style="color: {{ theme.textMuted }}">v{{ versionText }} · #{{ versionCode }}</text>
    <text class="welcome-link" onclick="goToWelcome" style="color: {{ theme.accent }}">欢迎页</text>
    <!-- 兜底退出：欢迎页之外唯一可见的显式出口。返回键在部分运行时会被吃掉/不生效时，
         这里保证从任何能走到设置的地方都能主动终止应用，不必一层层用返回键往回堆。 -->
    <input class="exit-app-btn" type="button"
           value="{{ exitConfirm ? '再点一次退出' : '退出应用' }}"
           onclick="handleExitApp"
           style="background-color: {{ theme.cardLight }}; color: {{ exitConfirm ? theme.deleteText : theme.textSecondary }}" />
    <text class="exit-app-hint" if="{{ exitConfirm }}" style="color: {{ theme.textMuted }}">3 秒内再点一次即退出</text>
    </div>
    </scroll>

    <unlock-dialog id="unlockDialog"></unlock-dialog>

    <div class="overlay-modal" if="{{ showPremiumDialog }}" onclick="dismissPremiumDialog">
      <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁高级版</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">多课表管理 · 云备份恢复 · 自定义主题，一次性解锁永久使用</text>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="取消" onclick="dismissPremiumDialog"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>

    <!-- 主题配色：底部抽屉弹。通栏 + 贴底（left/bottom 定位），不依赖居中计算，
         与屏幕宽高无关；面板自身 padding 提供内缩。 -->
    <div class="theme-drawer" if="{{ showTheme }}" onclick="closeThemeDrawer">
      <div class="theme-drawer-panel" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <div class="drawer-handle" style="background-color: {{ theme.border }}"></div>
        <text class="drawer-title" style="color: {{ theme.text }}">主题配色</text>
        <div class="theme-row">
          <div for="{{ themesRow1 }}" class="theme-item {{ currentThemeKey === $item.key ? 'active' : '' }}" onclick="selectTheme($item.key)" style="border-color: {{ currentThemeKey === $item.key ? theme.accent : 'transparent' }}">
            <div class="theme-dot" style="background-color: {{ $item.accent }}"></div>
            <text class="theme-name" style="color: {{ currentThemeKey === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.name }}</text>
          </div>
        </div>
        <div class="theme-row">
          <div for="{{ themesRow2 }}" class="theme-item {{ currentThemeKey === $item.key ? 'active' : '' }}" onclick="selectTheme($item.key)" style="border-color: {{ currentThemeKey === $item.key ? theme.accent : 'transparent' }}">
            <div class="theme-dot" style="background-color: {{ $item.accent }}"></div>
            <text class="theme-name" style="color: {{ currentThemeKey === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.name }}</text>
          </div>
        </div>
        <input class="drawer-done" type="button" value="完成" onclick="closeThemeDrawer"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const version = require("../../data/version.js")

const sizeLevels = [20, 28, 36, 48, 62, 76]

// 退出二次确认的复位定时器（模块级：goBack / onDestroy 都要能清掉，避免悬空回调改已销毁页面的状态）
var exitConfirmTimer = null

export default {
  private: {
    nickname: "",
    displaySize: 48,
    previewClassSize: 48,
    previewDisplaySize: 32,
    hideWeekend: true,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    currentThemeKey: "blue",
    iconTheme: "dark",
    themes: [],
    themesRow1: [],
    themesRow2: [],
    versionText: "",
    versionCode: 0,
    showPremiumDialog: false,
    showFontSize: false,
    showTheme: false,
    showSchedule: false,
    exitConfirm: false
  },

  onInit() {
    var self = this
    this.themes = store.getAvailableThemes ? store.getAvailableThemes() : []
    var mid = Math.ceil(this.themes.length / 2)
    this.themesRow1 = this.themes.slice(0, mid)
    this.themesRow2 = this.themes.slice(mid)

    store.getTheme(function(t, name) {
      self.theme = t
      self.currentThemeKey = name || "blue"
      self.updateIconSrc(name)
    })

    store.getBaseFontSize(function(size) {
      self.displaySize = size
      self.updatePreviews()
    }, true)
    this.loadNickname()
    this.loadHideWeekend()
    this.versionText = version.versionName
    this.versionCode = version.versionCode
  },

  onShow() {
    this.loadNickname()
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  updatePreviews() {
    // Use same formula as index.ux computeFontSizes to preview actual homepage size
    var norm = Math.round(this.displaySize * 32 / 48)
    if (norm < 20) norm = 20
    if (norm > 40) norm = 40
    norm = Math.round(norm / 4) * 4
    this.previewDisplaySize = Math.min(norm, 40)
    this.previewClassSize = this.previewDisplaySize
  },

  setSize(size) {
    this.displaySize = size
    store.setBaseFontSize(size)
    this.updatePreviews()
  },

  set20() { this.setSize(20) },

  decreaseFont() {
    for (var i = sizeLevels.length - 1; i >= 0; i--) {
      if (sizeLevels[i] < this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  increaseFont() {
    for (var i = 0; i < sizeLevels.length; i++) {
      if (sizeLevels[i] > this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  toggleFontSize() {
    this.showFontSize = !this.showFontSize
  },

  selectTheme(themeKey) {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      // 先收起抽屉：否则未解锁时弹窗会被压在抽屉面板下面
      self.showTheme = false
      if (unlocked) {
        self.applyTheme(themeKey)
      } else {
        self.showPremiumDialog = true
      }
    })
  },

  applyTheme(themeKey) {
    var self = this
    this.currentThemeKey = themeKey
    store.setTheme(themeKey, function() {
      store.getTheme(function(t, themeName) {
        self.theme = t
        self.updateIconSrc(themeName)
      })
    })
  },

  loadNickname() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: "chinese_input_nickname_result",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          var newName = data.trim()
          store.setNickname(newName, function() {
            self.nickname = newName
          })
          storage.delete({ key: "chinese_input_nickname_result", fail: function() {} })
          return
        }
        store.getNickname(function(name) {
          self.nickname = name || ""
        })
      },
      fail: function() {
        store.getNickname(function(name) {
          self.nickname = name || ""
        })
      }
    })
  },

  loadHideWeekend() {
    var self = this
    store.getHideWeekend(function(hide) {
      self.hideWeekend = hide
    })
  },

  toggleHideWeekend() {
    this.hideWeekend = !this.hideWeekend
    store.setHideWeekend(this.hideWeekend)
  },

  toggleTheme() {
    // 主题配色改为底部抽屉弹：点一次打开抽屉
    this.showTheme = true
  },

  closeThemeDrawer() {
    this.showTheme = false
  },

  toggleSchedule() {
    this.showSchedule = !this.showSchedule
  },

  openNicknameEdit() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "编辑昵称", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "输入昵称", success: function() {} })
    storage.set({ key: "chinese_input_value", value: this.nickname, success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "12", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "chinese_input_nickname_result", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  openFeedback() {
    router.push({ uri: "/pages/feedback" })
  },

  openTools() {
    router.push({ uri: "/pages/tools" })
  },

  openActivation() {
    router.push({ uri: "/pages/activation" })
  },

  openDonate() {
    router.push({ uri: "/pages/donate" })
  },

  goToPremium() {
    this.showPremiumDialog = false
    router.push({ uri: "/pages/activation" })
  },

  dismissPremiumDialog() {
    this.showPremiumDialog = false
  },

  stopBubble() {
  },

  openHomepageSettings() {
    router.push({ uri: "/pages/homepage-settings" })
  },

  openBackupRestore() {
    router.push({ uri: "/pages/backup-restore" })
  },

  openResetData() {
    router.push({ uri: "/pages/reset-data" })
  },

  goToWelcome() {
    router.push({ uri: "/pages/welcome" })
  },

  // 退出应用兜底入口：与欢迎页同一个 utils.exitApp()（进程级退出，和当前在哪页无关）。
  // 二次点击确认 + 3 秒自动复位：既防住滚动到底时的误触，又不给真正想退出的人设死门槛。
  handleExitApp() {
    var self = this
    if (!this.exitConfirm) {
      this.exitConfirm = true
      this.clearExitConfirmTimer()
      exitConfirmTimer = setTimeout(function() {
        exitConfirmTimer = null
        self.exitConfirm = false
      }, 3000)
      return
    }
    this.clearExitConfirmTimer()
    this.exitConfirm = false
    var utils = require("../../data/utils.js")
    var ok = utils.exitApp()
    if (!ok) {
      // 运行时不提供任何退出入口时明确告知，避免"点了没反应"
      var prompt = require("@system.prompt")
      prompt.showToast({ message: "请用系统手势退出应用" })
    }
  },

  clearExitConfirmTimer() {
    if (exitConfirmTimer) {
      clearTimeout(exitConfirmTimer)
      exitConfirmTimer = null
    }
  },

  goBack() {
    this.clearExitConfirmTimer()
    router.back()
  },

  onDestroy() {
    this.clearExitConfirmTimer()
  }
}
</script>

<style>
.settings-page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  
  position: relative;
}

/* 页面内容的内层容器：承载 padding，让绝对定位的抽屉弹能贴到屏幕四边 */
.settings-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

/* 可滚动内容区：header 固定在顶部，其余内容上下滚动 */
.settings-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  lines: 1;
  text-overflow: ellipsis;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.group {
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.group-title {
  font-size: 28px;
  font-weight: bold;
  opacity: 0.8;
  line-height: 38px;
}

.group-title-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.font-size-body {
  flex-direction: column;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}

.row-label {
  font-size: 30px;
  flex-shrink: 0;
  line-height: 40px;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 1;
  overflow: hidden;
}

.row-value {
  font-size: 28px;
  margin-right: 6px;
  line-height: 38px;
}

.row-hint {
  font-size: 28px;
  margin-right: 6px;
  max-lines: 1;
  line-height: 38px;
}

.size-indicator {
  font-size: 24px;
  margin-right: 6px;
  max-lines: 1;
  line-height: 32px;
  flex-shrink: 0;
}

.arrow {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.divider {
  height: 1px;
  margin: 6px 0;
}

.switch-track {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  flex-shrink: 0;
  position: relative;
}

.switch-thumb {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  position: absolute;
  top: 2px;
}

.theme-item {
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 12px 0;
  border-radius: 8px;
  border: 2px solid transparent;
}

.theme-dot {
  width: 26px;
  height: 26px;
  border-radius: 13px;
}

.theme-name {
  font-size: 28px;
  margin-top: 4px;
  text-align: center;
  line-height: 38px;
}

.scale-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.scale-btn {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
}

.scale-value {
  font-size: 28px;
  font-weight: bold;
  width: 72px;
  text-align: center;
  line-height: 38px;
}

.preview-box {
  border-radius: 8px;
  padding: 12px;
  align-items: center;
  justify-content: center;
}

.preview-text {
  font-weight: bold;
  text-align: center;
}

/* 作用范围说明：20px 为规范下限，行高取 1.2 倍 */
.scope-hint {
  font-size: 20px;
  line-height: 24px;
  text-align: center;
  margin-top: 8px;
}

.toggle-btn {
  width: 60px;
  height: 36px;
  border-radius: 8px;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 36px;
}

.version-text {
