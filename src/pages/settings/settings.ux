  }
  .drawer-done {
    height: 42px;
    font-size: 24px;
  }
}

/* ================================================================
   宽度断点：Watch 6 / 方屏（width >= 400px，内容区 ~400px）
   rect 屏上下空间充裕，padding 可大幅压缩。
   ================================================================ */
@media (width >= 400px) {
  .settings-body {
    padding: 6px 8px 6px 8px;
  }
  .back-header {
    margin-bottom: 6px;
  }
  .back-btn-wrapper {
    width: 50px;
