    font-size: 18px;
    line-height: 26px;
  }
}

/* ================================================================
   宽度断点：手环 10 / 胶囊屏大号（width >= 200px，内容区 ~180px）
   在 base 基础上「增量」：字号略大、抽屉/弹窗内缩适当放宽。
   ================================================================ */
@media (width >= 200px) {
  .theme-drawer-panel {
    padding: 8px 12px 16px 12px;
  }
  .drawer-title {
