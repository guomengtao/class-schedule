<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="settings-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">设置</text>
    </div>

    <div class="nickname-section" onclick="openNicknameEdit" style="background-color: {{ theme.card }}">
      <text class="nickname-label" style="color: {{ theme.text }}">昵称</text>
      <div class="nickname-value-row">
        <text class="nickname-value" if="{{ nickname }}" style="color: {{ theme.accent }}">{{ nickname }}</text>
        <text class="nickname-placeholder" if="{{ !nickname }}" style="color: {{ theme.textMuted }}">点击设置</text>
        <text class="nickname-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="theme-section" style="background-color: {{ theme.card }}">
      <text class="section-label" style="color: {{ theme.text }}">主题配色</text>
      <div class="theme-grid">
        <div for="{{ themes }}" class="theme-option {{ currentThemeKey === $item.key ? 'active' : '' }}" onclick="selectTheme($item.key)">
          <div class="theme-dot" style="background-color: {{ $item.accent }}; border-color: {{ $item.bg }}"></div>
          <text class="theme-name" style="color: {{ currentThemeKey === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.name }}</text>
        </div>
      </div>
    </div>

    <div class="scale-section" style="background-color: {{ theme.card }}">
      <text class="section-label" style="color: {{ theme.text }}">课程名称字体：{{ displaySize }}px</text>

      <div class="scale-control">
        <input class="scale-btn" type="button" value="−" onclick="decreaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        <text class="scale-value" style="color: {{ theme.accent }}">{{ displaySize }}px</text>
        <input class="scale-btn" type="button" value="+" onclick="increaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
      </div>

      <div class="quick-scales">
        <input class="quick-scale-btn {{ displaySize === 28 ? 'active' : '' }}" type="button" value="28px" onclick="set28" style="background-color: {{ displaySize === 28 ? theme.accent : theme.border }}; color: {{ displaySize === 28 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-scale-btn {{ displaySize === 36 ? 'active' : '' }}" type="button" value="36px" onclick="set36" style="background-color: {{ displaySize === 36 ? theme.accent : theme.border }}; color: {{ displaySize === 36 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-scale-btn {{ displaySize === 48 ? 'active' : '' }}" type="button" value="48px" onclick="set48" style="background-color: {{ displaySize === 48 ? theme.accent : theme.border }}; color: {{ displaySize === 48 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-scale-btn {{ displaySize === 62 ? 'active' : '' }}" type="button" value="62px" onclick="set62" style="background-color: {{ displaySize === 62 ? theme.accent : theme.border }}; color: {{ displaySize === 62 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-scale-btn {{ displaySize === 76 ? 'active' : '' }}" type="button" value="76px" onclick="set76" style="background-color: {{ displaySize === 76 ? theme.accent : theme.border }}; color: {{ displaySize === 76 ? theme.bg : theme.textSecondary }}" />
      </div>
    </div>

    <div class="preview-section" style="background-color: {{ theme.card }}">
      <text class="preview-label" style="color: {{ theme.textSecondary }}">文字预览（{{ previewClassSize }}px）</text>
      <text class="preview-card-name" style="font-size: {{ previewClassSize }}px; color: {{ theme.text }}">数学 08:00 - 08:45 301教室</text>
    </div>

    <div class="info-section" onclick="openHomepageSettings" style="background-color: {{ theme.card }}">
      <text class="info-label" style="color: {{ theme.text }}">首页设置</text>
      <div class="info-value-row">
        <text class="info-placeholder" style="color: {{ theme.textMuted }}">自定义首页内容与时间显示</text>
        <text class="info-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="remind-section" style="background-color: {{ theme.card }}">
      <text class="section-label" style="color: {{ theme.text }}">上课提醒</text>

      <div class="remind-row">
        <text class="remind-label" style="color: {{ theme.text }}">震动提醒</text>
        <input class="toggle-btn" type="button" value="{{ remindEnabled ? 'ON' : 'OFF' }}" onclick="toggleRemind" style="background-color: {{ remindEnabled ? theme.accent : theme.border }}; color: {{ remindEnabled ? theme.bg : theme.textSecondary }}" />
      </div>

      <div class="remind-row" if="{{ remindEnabled }}">
        <text class="remind-label" style="color: {{ theme.text }}">提前提醒 (分钟)</text>
        <div class="minute-selector">
          <input class="minute-btn" type="button" value="−" onclick="decreaseMinutes" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="minute-value" style="color: {{ theme.accent }}">{{ remindMinutes }}</text>
          <input class="minute-btn" type="button" value="+" onclick="increaseMinutes" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
      </div>

      <div class="vibration-style-section" if="{{ remindEnabled }}">
        <text class="section-label" style="color: {{ theme.text }}">震动样式</text>
        <div class="vibration-grid">
          <div for="{{ vibrationStyles }}" class="vibration-item {{ vibrationStyle === $item.key ? 'active' : '' }}" onclick="selectVibrationStyle($item.key)" style="background-color: {{ vibrationStyle === $item.key ? theme.cardLight : theme.border }}">
            <text class="vibration-label" style="color: {{ vibrationStyle === $item.key ? theme.accent : theme.text }}">{{ $item.label }}</text>
            <text class="vibration-desc" style="color: {{ vibrationStyle === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.desc }}</text>
            <text class="vibration-check" if="{{ vibrationStyle === $item.key }}" style="color: {{ theme.accent }}">✓</text>
          </div>
        </div>
        <text class="vibration-hint" style="color: {{ theme.textMuted }}">点击选项试听震动效果</text>
      </div>
    </div>

    <div class="save-section">
      <input class="save-settings-btn" type="button" value="保存设置" onclick="saveSettings" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="info-section" onclick="openBackupRestore" style="background-color: {{ theme.card }}">
      <text class="info-label" style="color: {{ theme.text }}">数据备份与恢复</text>
      <div class="info-value-row">
        <text class="info-placeholder" style="color: {{ theme.textMuted }}">备份课程数据，换设备一键恢复</text>
        <text class="info-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="info-section" onclick="openTestArea" style="background-color: {{ theme.card }}">
      <text class="info-label" style="color: {{ theme.text }}">功能实验室</text>
      <div class="info-value-row">
        <text class="info-placeholder" style="color: {{ theme.textMuted }}">实验性功能尝鲜</text>
        <text class="info-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="info-section" onclick="openActivation" style="background-color: {{ theme.card }}">
      <text class="info-label" style="color: {{ theme.text }}">高级版</text>
      <div class="info-value-row">
        <text class="info-placeholder" style="color: {{ theme.textMuted }}">爱发电购买兑换码激活</text>
        <text class="info-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <div class="reset-section" onclick="openResetData" style="background-color: {{ theme.card }}">
      <text class="reset-label" style="color: {{ theme.deleteText }}">恢复默认数据</text>
      <div class="reset-value-row">
        <text class="reset-desc" style="color: {{ theme.textMuted }}">重置所有课程为 Demo 数据</text>
        <text class="reset-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    <text class="version-text" style="color: {{ theme.textMuted }}">{{ versionText }}</text>

    <unlock-dialog id="unlockDialog"></unlock-dialog>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const version = require("../../data/version.js")

function safeVibrate(mode) {
  if (!vibrator) {
    console.warn("[SETTINGS] vibrator module is missing")
    return false
  }

  var vibrateMode = (mode === "long" || mode === 400) ? "long" : "short"

  try {
    vibrator.vibrate({
      mode: vibrateMode,
      success: function() {
        console.log("[SETTINGS] vibrate success, mode: " + vibrateMode)
      },
      fail: function(data, code) {
        console.warn("[SETTINGS] vibrate fail, code: " + code)
      }
    })
    return true
  } catch (e) {
    console.warn("[SETTINGS] vibrate exception: " + e)
    return false
  }
}

const sizeLevels = [28, 36, 48, 62, 76]

export default {
  private: {
    nickname: "",
    scale: 1.0,
    displaySize: 48,
    previewClassSize: 48,
    previewClassStyle: "",
    remindEnabled: true,
    remindMinutes: 5,
    vibrationStyle: "short",
    vibrationStyles: [],
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    currentThemeKey: "blue",
    themes: [],
    versionText: ""
  },

  onInit() {
    var self = this
    this.vibrationStyles = store.getVibrationStyles ? store.getVibrationStyles() : []
    this.themes = store.getAvailableThemes ? store.getAvailableThemes() : []

    store.getTheme(function(t, name) {
      self.theme = t
      self.currentThemeKey = name || "blue"
    })

    store.getFontScale(function(scale) {
      if (!scale || scale < 0.5) { scale = 1.0 }
      self.scale = scale
      self.displaySize = Math.round(48 * scale)
      self.updatePreviews()
    })
    this.loadRemindSettings()
    this.loadNickname()
    this.loadVibrationStyle()
    this.versionText = "v" + version.versionName
  },

  onShow() {
    this.loadNickname()
  },

  updatePreviews() {
    this.previewClassSize = Math.round(28 * this.scale)
    this.previewClassStyle = "font-size: " + this.previewClassSize + "px"
  },

  setSize(size) {
    this.displaySize = size
    this.scale = size / 48
    store.setFontScale(this.scale)
    this.updatePreviews()
  },

  set28() { this.setSize(28) },
  set36() { this.setSize(36) },
  set48() { this.setSize(48) },
  set62() { this.setSize(62) },
  set76() { this.setSize(76) },

  decreaseFont() {
    for (var i = sizeLevels.length - 1; i >= 0; i--) {
      if (sizeLevels[i] < this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  increaseFont() {
    for (var i = 0; i < sizeLevels.length; i++) {
      if (sizeLevels[i] > this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  selectTheme(themeKey) {
    var self = this

    if (store.isFreeTheme(themeKey)) {
      this.applyTheme(themeKey)
      return
    }

    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        self.applyTheme(themeKey)
      } else {
        self.$element('unlockDialog').show({})
      }
    })
  },

  applyTheme(themeKey) {
    var self = this
    this.currentThemeKey = themeKey
    store.setTheme(themeKey, function() {
      store.getTheme(function(t) {
        self.theme = t
      })
    })
  },

  loadRemindSettings() {
    var self = this
    store.getRemindSettings(function(settings) {
      if (settings) {
        self.remindEnabled = settings.enabled
        self.remindMinutes = settings.minutes
      }
    })
  },

  loadNickname() {
    var self = this
    store.getNickname(function(name) {
      self.nickname = name || ""
    })
  },

  openNicknameEdit() {
    router.push({ uri: "/pages/nickname-edit" })
  },

  openTestArea() {
    router.push({ uri: "/pages/test-area" })
  },

  openActivation() {
    router.push({ uri: "/pages/activation" })
  },

  toggleRemind() {
    this.remindEnabled = !this.remindEnabled
    this.saveRemindSettings()
  },

  increaseMinutes() {
    if (this.remindMinutes < 30) {
      this.remindMinutes++
      this.saveRemindSettings()
    }
  },

  decreaseMinutes() {
    if (this.remindMinutes > 0) {
      this.remindMinutes--
      this.saveRemindSettings()
    }
  },

  saveRemindSettings() {
    store.setRemindSettings({
      enabled: this.remindEnabled,
      minutes: this.remindMinutes
    })
  },

  loadVibrationStyle() {
    var self = this
    store.getVibrationStyle(function(style) {
      self.vibrationStyle = style || "short"
    })
  },

  selectVibrationStyle(style) {
    this.vibrationStyle = style
    this.previewVibration(style)
    store.setVibrationStyle(style)
  },

  previewVibration(style) {
    var pattern = null
    var styles = this.vibrationStyles
    for (var i = 0; i < styles.length; i++) {
      if (styles[i].key === style) {
        pattern = styles[i]
        break
      }
    }
    if (!pattern) {
      safeVibrate("short")
      return
    }

    vibrator.start({
      duration: pattern.duration,
      interval: pattern.interval,
      count: pattern.count,
      success: function() {},
      fail: function(data, code) {
        console.warn("[SETTINGS] vibrator.start fail, code=" + code + ", fallback to vibrate")
        var idx = 0
        function loop() {
          if (idx >= pattern.count) return
          var mode = pattern.duration > 300 ? "long" : "short"
          vibrator.vibrate({ mode: mode })
          idx++
          if (idx < pattern.count) {
            setTimeout(loop, pattern.interval + pattern.duration)
          }
        }
        loop()
      }
    })
  },

  saveSettings() {
    prompt.showToast({ message: "设置已保存" })
    router.back()
  },

  openHomepageSettings() {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        router.push({ uri: "/pages/homepage-settings" })
      } else {
        self.$element('unlockDialog').show({})
      }
    })
  },

  openBackupRestore() {
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (unlocked) {
        router.push({ uri: "/pages/backup-restore" })
      } else {
        self.$element('unlockDialog').show({})
      }
    })
  },

  openResetData() {
    router.push({ uri: "/pages/reset-data" })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
