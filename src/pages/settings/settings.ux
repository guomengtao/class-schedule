  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 38px;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.group {
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.group-title {
  font-size: 28px;
  font-weight: bold;
  opacity: 0.8;
  line-height: 38px;
}

.group-title-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.font-size-body {
  flex-direction: column;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}

/* ================================================================
   BASE 内额外：胶囊/手环9 基准（160px 内容区）
   昵称行窄屏用纵向布局，避免与右侧箭头挤压。
   ================================================================ */
.nickname-row {
  flex-direction: column;
  align-items: flex-start;
  padding: 14px 0;
}
.nickname-label {
  line-height: 36px;
