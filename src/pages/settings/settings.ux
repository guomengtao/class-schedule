  font-weight: bold;
  text-align: center;
}

.toggle-btn {
  width: 52px;
  height: 28px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: bold;
  text-align: center;
}

.save-area {
  margin-top: 10px;
  padding-bottom: 4px;
}

.save-btn {
  width: 100%;
  height: 42px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}

.version-text {
  font-size: 16px;
  text-align: center;
  padding-top: 6px;
  padding-bottom: 4px;
}

.welcome-link {
  font-size: 16px;
  text-align: center;
  padding-bottom: 12px;
}

.overlay-bottom-sheet {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  flex-direction: column;
  justify-content: flex-end;
}

.bottom-sheet {
  width: 100%;
  border-radius: 16px 16px 0 0;
  padding: 8px 16px 16px 16px;
  flex-direction: column;
  align-items: center;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  margin-bottom: 12px;
}

.sheet-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 6px;
  text-align: center;
}

.sheet-desc {
  font-size: 12px;
  text-align: center;
  margin-bottom: 14px;
  line-height: 18px;
}

.benefit-list {
  width: 100%;
  flex-direction: column;
  padding-left: 12px;
  margin-bottom: 18px;
}

.benefit-item {
  font-size: 13px;
  margin-bottom: 6px;
}

.sheet-btn {
  width: 100%;
  height: 34px;
  border-radius: 17px;
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 6px;
}

.sheet-cancel {
  width: 100%;
  height: 28px;
  border-radius: 14px;
  font-size: 12px;
}

.default-homepage-body {
  padding: 4px 0;
}

.section-label {
  font-size: 12px;
  margin: 6px 0 4px 0;
}

.page-options {
  flex-direction: row;
  flex-wrap: wrap;
}

.page-option {
  height: 30px;
  border-radius: 8px;
  padding: 0 10px;
  margin: 0 4px 4px 0;
  align-items: center;
  justify-content: center;
}

