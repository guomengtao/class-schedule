}
.drawer-title {
  font-size: 28px;
  line-height: 36px;
  text-align: center;
  margin-bottom: 6px;
}
.theme-row {
  flex-direction: row;
  width: 100%;
}
.drawer-done {
  width: 100%;
  height: 46px;
  border-radius: 23px;
  font-size: 26px;
  margin-top: 10px;
}
</style>