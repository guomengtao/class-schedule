}

.modal-btn-primary {
  width: 100%;
  height: 42px;
  border-radius: 21px;
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 8px;
  line-height: 42px;
}

.modal-btn-secondary {
  width: 100%;
  height: 36px;
  border-radius: 18px;
  font-size: 28px;
  line-height: 36px;
}
/* ================================================================
   圆形表盘（唯一保留的 shape 查询——圆方不同构，非宽度可替代）
   手环 9 不会命中此分支，天然安全。
   ================================================================ */
@media screen and (shape: circle) {
  .settings-body {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    margin-bottom: 8px;
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn-wrapper {
    width: 52px;
    height: 40px;
  }
  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
