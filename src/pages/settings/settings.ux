<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="settings-page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">设置</text>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openNicknameEdit">
        <text class="row-label" style="color: {{ theme.text }}">昵称</text>
        <div class="row-right">
          <text class="row-value" if="{{ nickname }}" style="color: {{ theme.accent }}">{{ nickname }}</text>
          <text class="row-hint" if="{{ !nickname }}" style="color: {{ theme.textMuted }}">点击设置</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.text }}">主题配色</text>
      <div class="theme-grid">
        <div for="{{ themes }}" class="theme-item {{ currentThemeKey === $item.key ? 'active' : '' }}" onclick="selectTheme($item.key)" style="border-color: {{ currentThemeKey === $item.key ? theme.accent : 'transparent' }}">
          <div class="theme-dot" style="background-color: {{ $item.accent }}"></div>
          <text class="theme-name" style="color: {{ currentThemeKey === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.name }}</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.text }}">字体大小</text>
      <div class="scale-row">
        <input class="scale-btn" type="button" value="−" onclick="decreaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        <text class="scale-value" style="color: {{ theme.accent }}">{{ displaySize }}px</text>
        <input class="scale-btn" type="button" value="+" onclick="increaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
      </div>
      <div class="quick-row">
        <input class="quick-btn {{ displaySize === 28 ? 'active' : '' }}" type="button" value="28" onclick="set28" style="background-color: {{ displaySize === 28 ? theme.accent : theme.border }}; color: {{ displaySize === 28 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-btn {{ displaySize === 36 ? 'active' : '' }}" type="button" value="36" onclick="set36" style="background-color: {{ displaySize === 36 ? theme.accent : theme.border }}; color: {{ displaySize === 36 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-btn {{ displaySize === 48 ? 'active' : '' }}" type="button" value="48" onclick="set48" style="background-color: {{ displaySize === 48 ? theme.accent : theme.border }}; color: {{ displaySize === 48 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-btn {{ displaySize === 62 ? 'active' : '' }}" type="button" value="62" onclick="set62" style="background-color: {{ displaySize === 62 ? theme.accent : theme.border }}; color: {{ displaySize === 62 ? theme.bg : theme.textSecondary }}" />
        <input class="quick-btn {{ displaySize === 76 ? 'active' : '' }}" type="button" value="76" onclick="set76" style="background-color: {{ displaySize === 76 ? theme.accent : theme.border }}; color: {{ displaySize === 76 ? theme.bg : theme.textSecondary }}" />
      </div>
      <div class="preview-box" style="background-color: {{ theme.cardLight }}">
        <text class="preview-text" style="font-size: {{ previewClassSize }}px; color: {{ theme.text }}">数学 08:00-08:45 301</text>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.text }}">上课提醒</text>
      <div class="row">
        <text class="row-label" style="color: {{ theme.text }}">震动提醒</text>
        <input class="toggle-btn" type="button" value="{{ remindEnabled ? 'ON' : 'OFF' }}" onclick="toggleRemind" style="background-color: {{ remindEnabled ? theme.accent : theme.border }}; color: {{ remindEnabled ? theme.bg : theme.textSecondary }}" />
      </div>
      <div class="row" if="{{ remindEnabled }}">
        <text class="row-label" style="color: {{ theme.text }}">提前提醒</text>
        <div class="minute-row">
          <input class="minute-btn" type="button" value="−" onclick="decreaseMinutes" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="minute-value" style="color: {{ theme.accent }}">{{ remindMinutes }} 分钟</text>
          <input class="minute-btn" type="button" value="+" onclick="increaseMinutes" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
      </div>
      <div if="{{ remindEnabled }}">
        <text class="group-title" style="color: {{ theme.text }}">震动样式</text>
        <div class="vibe-grid">
          <div for="{{ vibrationStyles }}" class="vibe-item {{ vibrationStyle === $item.key ? 'active' : '' }}" onclick="selectVibrationStyle($item.key)" style="background-color: {{ vibrationStyle === $item.key ? theme.cardLight : theme.border }}; border-color: {{ vibrationStyle === $item.key ? theme.accent : 'transparent' }}">
            <div class="vibe-top">
              <text class="vibe-label" style="color: {{ vibrationStyle === $item.key ? theme.accent : theme.text }}">{{ $item.label }}</text>
              <text class="vibe-check" if="{{ vibrationStyle === $item.key }}" style="color: {{ theme.accent }}">✓</text>
            </div>
            <text class="vibe-desc" style="color: {{ vibrationStyle === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.desc }}</text>
          </div>
        </div>
        <text class="vibe-hint" style="color: {{ theme.textMuted }}">点击试听震动效果</text>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <text class="group-title" style="color: {{ theme.text }}">课程表设置</text>
      <div class="row">
        <text class="row-label" style="color: {{ theme.text }}">隐藏周六日</text>
        <input class="toggle-btn" type="button" value="{{ hideWeekend ? '开' : '关' }}" onclick="toggleHideWeekend" style="background-color: {{ hideWeekend ? theme.accent : theme.border }}; color: {{ hideWeekend ? theme.bg : theme.textSecondary }}" />
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openHomepageSettings">
        <text class="row-label" style="color: {{ theme.text }}">首页设置</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">栏目与时间格式</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openBackupRestore">
        <text class="row-label" style="color: {{ theme.text }}">数据备份与恢复</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">备份与换设备恢复</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openTestArea">
        <text class="row-label" style="color: {{ theme.text }}">功能实验室</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">实验性功能</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="openActivation">
        <text class="row-label" style="color: {{ theme.text }}">高级版</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">解锁全部功能</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="group" style="background-color: {{ theme.card }}">
      <div class="row" onclick="openResetData">
        <text class="row-label" style="color: {{ theme.deleteText }}">恢复默认数据</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">重置为Demo课程</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="save-area">
      <input class="save-btn" type="button" value="保存设置" onclick="saveSettings" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <text class="version-text" style="color: {{ theme.textMuted }}">v{{ versionText }}</text>

    <unlock-dialog id="unlockDialog"></unlock-dialog>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const version = require("../../data/version.js")

function safeVibrate(mode) {
  if (!vibrator) {
    console.warn("[SETTINGS] vibrator module is missing")
    return false
  }
  var vibrateMode = (mode === "long" || mode === 400) ? "long" : "short"
  try {
    vibrator.vibrate({
      mode: vibrateMode,
      success: function() {},
      fail: function(data, code) {
        console.warn("[SETTINGS] vibrate fail, code: " + code)
      }
    })
    return true
  } catch (e) {
    console.warn("[SETTINGS] vibrate exception: " + e)
    return false
  }
}

const sizeLevels = [28, 36, 48, 62, 76]

export default {
  private: {
    nickname: "",
    scale: 1.0,
    displaySize: 48,
    previewClassSize: 48,
    remindEnabled: true,
    remindMinutes: 5,
    vibrationStyle: "short",
    vibrationStyles: [],
    hideWeekend: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '🔵',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    currentThemeKey: "blue",
    themes: [],
    versionText: ""
  },

  onInit() {
    var self = this
    this.vibrationStyles = store.getVibrationStyles ? store.getVibrationStyles() : []
    this.themes = store.getAvailableThemes ? store.getAvailableThemes() : []

    store.getTheme(function(t, name) {
      self.theme = t
      self.currentThemeKey = name || "blue"
    })

    store.getFontScale(function(scale) {
      if (!scale || scale < 0.5) { scale = 1.0 }
      self.scale = scale
      self.displaySize = Math.round(48 * scale)
      self.updatePreviews()
    })
    this.loadRemindSettings()
    this.loadNickname()
    this.loadVibrationStyle()
    this.loadHideWeekend()
    this.versionText = version.versionName
  },

  onShow() {
    this.loadNickname()
  },

  updatePreviews() {
    this.previewClassSize = Math.round(28 * this.scale)
  },

  setSize(size) {
    this.displaySize = size
    this.scale = size / 48
    store.setFontScale(this.scale)
    this.updatePreviews()
  },

  set28() { this.setSize(28) },
  set36() { this.setSize(36) },
  set48() { this.setSize(48) },
  set62() { this.setSize(62) },
  set76() { this.setSize(76) },

  decreaseFont() {
    for (var i = sizeLevels.length - 1; i >= 0; i--) {
      if (sizeLevels[i] < this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  increaseFont() {
    for (var i = 0; i < sizeLevels.length; i++) {
      if (sizeLevels[i] > this.displaySize) {
        this.setSize(sizeLevels[i])
        return
      }
    }
  },

  selectTheme(themeKey) {
    this.applyTheme(themeKey)
  },

  applyTheme(themeKey) {
    var self = this
    this.currentThemeKey = themeKey
    store.setTheme(themeKey, function() {
      store.getTheme(function(t) {
        self.theme = t
      })
    })
  },

  loadRemindSettings() {
    var self = this
    store.getRemindSettings(function(settings) {
      if (settings) {
        self.remindEnabled = settings.enabled
        self.remindMinutes = settings.minutes
      }
    })
  },

  loadNickname() {
    var self = this
    store.getNickname(function(name) {
      self.nickname = name || ""
    })
  },

  loadHideWeekend() {
    var self = this
    store.getHideWeekend(function(hide) {
      self.hideWeekend = hide
    })
  },

  toggleHideWeekend() {
    this.hideWeekend = !this.hideWeekend
    store.setHideWeekend(this.hideWeekend)
  },

  openNicknameEdit() {
    router.push({ uri: "/pages/nickname-edit" })
  },

  openTestArea() {
    router.push({ uri: "/pages/test-area" })
  },

  openActivation() {
    router.push({ uri: "/pages/activation" })
  },

  toggleRemind() {
    this.remindEnabled = !this.remindEnabled
    this.saveRemindSettings()
  },

  increaseMinutes() {
    if (this.remindMinutes < 30) {
      this.remindMinutes++
      this.saveRemindSettings()
    }
  },

  decreaseMinutes() {
    if (this.remindMinutes > 0) {
      this.remindMinutes--
      this.saveRemindSettings()
    }
  },

  saveRemindSettings() {
    store.setRemindSettings({
      enabled: this.remindEnabled,
      minutes: this.remindMinutes
    })
  },

  loadVibrationStyle() {
    var self = this
    store.getVibrationStyle(function(style) {
      self.vibrationStyle = style || "short"
    })
  },

  selectVibrationStyle(style) {
    this.vibrationStyle = style
    this.previewVibration(style)
    store.setVibrationStyle(style)
  },

  previewVibration(style) {
    var pattern = null
    var styles = this.vibrationStyles
    for (var i = 0; i < styles.length; i++) {
      if (styles[i].key === style) {
        pattern = styles[i]
        break
      }
    }
    if (!pattern) {
      safeVibrate("short")
      return
    }
    vibrator.start({
      duration: pattern.duration,
      interval: pattern.interval,
      count: pattern.count,
      success: function() {},
      fail: function(data, code) {
        console.warn("[SETTINGS] vibrator.start fail, code=" + code + ", fallback to vibrate")
        var idx = 0
        function loop() {
          if (idx >= pattern.count) return
          var mode = pattern.duration > 300 ? "long" : "short"
          vibrator.vibrate({ mode: mode })
          idx++
          if (idx < pattern.count) {
            setTimeout(loop, pattern.interval + pattern.duration)
          }
        }
        loop()
      }
    })
  },

  saveSettings() {
    prompt.showToast({ message: "设置已保存" })
    router.back()
  },

  openHomepageSettings() {
    router.push({ uri: "/pages/homepage-settings" })
  },

  openBackupRestore() {
    router.push({ uri: "/pages/backup-restore" })
  },

  openResetData() {
    router.push({ uri: "/pages/reset-data" })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.settings-page {
  flex-direction: column;
  padding: 24px 8px 8px 8px;
  min-height: 100%;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
  padding: 0 4px;
}

.back-btn {
  width: 64px;
  height: 32px;
  border-radius: 8px;
  font-size: 13px;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  margin-left: 8px;
}

.group {
  flex-direction: column;
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 6px;
}

.group-title {
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 8px;
  opacity: 0.8;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
}

.row-label {
  font-size: 14px;
  flex-shrink: 0;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 1;
  overflow: hidden;
}

.row-value {
  font-size: 13px;
  margin-right: 4px;
}

.row-hint {
  font-size: 12px;
  margin-right: 4px;
  max-lines: 1;
}

.arrow {
  font-size: 18px;
  flex-shrink: 0;
}

.divider {
  height: 1px;
  margin: 2px 0;
}

.theme-grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.theme-item {
  flex-direction: column;
  align-items: center;
  width: 20%;
  padding: 4px 0;
  border-radius: 8px;
  border: 2px solid transparent;
}

.theme-dot {
  width: 22px;
  height: 22px;
  border-radius: 11px;
}

.theme-name {
  font-size: 10px;
  margin-top: 2px;
  text-align: center;
}

.scale-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
}

.scale-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
}

.scale-value {
  font-size: 16px;
  font-weight: bold;
  width: 56px;
  text-align: center;
}

.quick-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 8px;
}

.quick-btn {
  width: 44px;
  height: 28px;
  border-radius: 6px;
  font-size: 11px;
  text-align: center;
  margin: 0 2px;
}

.quick-btn.active {
  font-weight: bold;
}

.preview-box {
  border-radius: 8px;
  padding: 8px;
  align-items: center;
  justify-content: center;
}

.preview-text {
  font-weight: bold;
  text-align: center;
}

.toggle-btn {
  width: 52px;
  height: 28px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: bold;
  text-align: center;
}

.minute-row {
  flex-direction: row;
  align-items: center;
}

.minute-btn {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}

.minute-value {
  font-size: 14px;
  font-weight: bold;
  min-width: 64px;
  text-align: center;
}

.vibe-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.vibe-item {
  flex-direction: column;
  width: 48%;
  padding: 8px;
  margin-bottom: 4px;
  border-radius: 8px;
  border: 2px solid transparent;
}

.vibe-top {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.vibe-label {
  font-size: 13px;
  font-weight: bold;
}

.vibe-check {
  font-size: 14px;
}

.vibe-desc {
  font-size: 11px;
  margin-top: 2px;
}

.vibe-hint {
  font-size: 11px;
  text-align: center;
  margin-top: 6px;
}

.save-area {
  margin-top: 10px;
  padding-bottom: 4px;
}

.save-btn {
  width: 100%;
  height: 42px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}

.version-text {
  font-size: 11px;
  text-align: center;
  padding-top: 6px;
  padding-bottom: 12px;
}

@media (shape: circle) {
  .settings-page {
    padding: 24px 24px 24px 24px;
  }
  .back-header {
    margin-bottom: 8px;
    padding: 0 12px;
    justify-content: center;
  }
  .back-btn {
    width: 52px;
    height: 28px;
    font-size: 12px;
  }
  .header-title {
    font-size: 16px;
  }
}
</style>