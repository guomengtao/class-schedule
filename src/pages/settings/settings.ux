    font-size: 16px;
  }
  .nickname-section {
    padding: 10px;
    margin-bottom: 6px;
  }
  .nickname-label {
    font-size: 14px;
  }
  .theme-section {
    padding: 10px;
    margin-bottom: 6px;
  }
  .section-label {
    font-size: 14px;
  }
  .theme-dot {
    width: 22px;
    height: 22px;
  }
  .theme-name {
    font-size: 9px;
  }
  .scale-section {
    padding: 10px;
    margin-bottom: 6px;
  }
  .scale-btn {
    width: 30px;
    height: 30px;
    font-size: 15px;
  }
  .scale-value {
    font-size: 14px;
  }
  .quick-scale-btn {
    width: 44px;
    height: 28px;
    font-size: 11px;
  }
  .preview-section {
    padding: 8px;
    margin-bottom: 6px;
  }
  .remind-section {
    padding: 10px;
    margin-bottom: 6px;
  }
  .remind-label {
