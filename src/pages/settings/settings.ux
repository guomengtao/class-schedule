  padding-bottom: 12px;
}

@media (shape: circle) {
  .settings-page {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    margin-bottom: 8px;
    padding: 0 20px;
    justify-content: center;
  }
  .back-btn {
    width: 56px;
    height: 32px;
    font-size: 13px;
  }
