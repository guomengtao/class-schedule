  border-radius: 8px;
  border-width: 1px;
  border-style: solid;
  font-size: 14px;
  padding: 0 8px;
  margin-right: 6px;
}

.custom-btn {
  width: 50px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
  flex-shrink: 0;
}

.qr-section {
  flex-direction: column;
  align-items: center;
  margin-bottom: 12px;
}

.qr-wrapper {
  padding: 14px;
  border-radius: 14px;
  align-items: center;
  justify-content: center;
}

.qr-hint {
  font-size: 14px;
  margin-top: 10px;
}

.result-section {
  flex-direction: column;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 12px;
}

.result-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 8px;
}

.result-text {
  font-size: 14px;
  line-height: 22px;
}

.preview-section {
