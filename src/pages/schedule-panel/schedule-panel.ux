<!-- UI/实现来源：早期沿用 open-vela-learning 官方 sample（home/index.ux），
     2026-10-17 UI 整理：原样式 padding 60px 80px 在 192 宽屏上左右各吃掉 80px，7 个栏目被压成
     一条窄柱；.link 的 margin-left:23px 又被后面的 margin:5px 0 简写覆盖（等于没缩进）；
     行高 40px 装 30px 字，行间距全靠全局 text 规则，视觉松散不成组。
     现改为对标 pages/tools/tools.ux 的标准样式：状态栏留白 + 返回钮/居中标题头部 + 单张卡片内
     7 行（行 + 箭头 ›），配色全部走 store.getTheme 的 theme 变量，深浅主题自动适配。
     逻辑与数据源未动：仍是 data.js 的 tabsData，route/goBack 行为不变。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="page-scroll" scroll-y="{{ true }}">
      <div class="page-body">
        <div class="back-header">
          <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
            <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
          </div>
          <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">更多首页</text>
        </div>

        <text class="panel-desc" style="color: {{ theme.textMuted }}">每个栏目都可当独立首页长期使用，默认首页不受影响。</text>

        <div class="section" style="background-color: {{ theme.card }}">
          <block for="{{ items }}">
            <div class="item-row" @click="route($item.path)">
              <text class="item-label" style="color: {{ theme.text }}">{{ $item.name }}</text>
              <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
            </div>
          </block>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
// 数据源沿用 data.js 的 tabsData（更多首页一章一组 7 个栏目）；此处只做「章节 → 平铺列表」的展平。
import { tabsData } from './data.js'

const store = require('../../data/store.js')

const flatItems = []
for (let i = 0; i < tabsData.length; i++) {
  const groups = tabsData[i].groupList || []
  for (let j = 0; j < groups.length; j++) {
    const cases = groups[j].caseList || []
    for (let k = 0; k < cases.length; k++) {
      flatItems.push({ name: cases[k].name, path: cases[k].path })
    }
  }
}

export default {
  private: {
    iconTheme: 'dark',
    items: flatItems,
    // 首帧默认深色（与 tools.ux 同款），onInit 里由 store.getTheme 覆盖为当前主题
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      text: '#ffffff',
      textMuted: '#555566',
      border: '#0f3460'
    }
  },

  onInit() {
    const self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  // 注入点3跳转：官方 route 原样保留（router.push uri）；带 fromPanel 标记，供目标页判定 root
  route(uri) {
    router.push({ uri: uri, params: { fromPanel: '1' } })
  },

  // 注入点3跳转-返回：本页由设置页 push 而来非根页，顶部返回按钮回上一页
  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.page-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-body {
  flex-direction: column;
  width: 100%;
  /* 44px 顶部留白避开状态栏，左右 12px 与兄弟面板页一致 */
  padding: 44px 12px 12px 12px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 36px; height: 36px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0;
}

.back-btn-icon {
  width: 24px; height: 24px;
}

/* 标题居中：192 宽屏减去返回钮后仅剩 ~120px，4 个汉字 28px 必然折行，
   故降到 26px 并去掉右侧等宽占位（占位 48px 会把标题压到 64px，直接两行）。 */
.header-title {
  flex: 1; font-size: 24px; font-weight: bold; text-align: center; line-height: 32px; lines: 1;
}

/* 目录页定位说明（「更多首页」改名配套）：18px/24px 行高、次要色。
   2026-10-21 按规则 §七 抬字号：14px 真实手环上不可读。抬到 18 后 156px 宽
   约 8 字一行，原文案要占 6 行（144px），把 7 个栏目整体压下去，故同步精简为 27 字 → 4 行。 */
.panel-desc {
  font-size: 18px;
  line-height: 26px;
  padding: 0 4px;
  margin-bottom: 12px;
}

/* 单张卡片承载 7 个栏目：整块成组，比原来一串散落的蓝色下划线链接干净 */
.section {
  width: 100%;
  flex-direction: column;
  border-radius: 14px;
  padding: 10px 14px;
}

.item-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  /* 6px 上下 + 38px 行高 = 50px/行 × 7 行 + 卡片内边距 + 头部 = 478px，稳稳落在一屏内 */
  padding: 6px 0;
}

.item-label {
  font-size: 28px;
  line-height: 38px;
}

.arrow {
  font-size: 28px;
  line-height: 38px;
  flex-shrink: 0;
}

@media (width >= 360) {
  .page-body { padding: 44px 16px 16px 16px; }
  .item-row { padding: 10px 0; }
  .item-label { font-size: 32px; line-height: 44px; }
  .arrow { font-size: 32px; line-height: 44px; }
}

@media (width >= 480) {
  .page-body { padding: 44px 40px 24px 40px; }
  .item-row { padding: 14px 0; }
  .section { border-radius: 18px; padding: 14px 20px; }
}
</style>
