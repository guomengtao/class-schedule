<!-- UI/实现来源：open-vela-learning/packages_apps/wearable/vela-sample/src/home/index.ux（ev-minimal 最小改动法 v3，2026-10-14；官方正统栏目目录页：分章→分组折叠→链接导航，原生 pill 适配。注入点仅数据源/文案） -->
<template>
  <div class="page home-page">
    <block for="{{tabs}}">
      <div class="chapter">
        <text class="h1">{{$item.name}}</text>
        <block for="{{$item.groupList}}">
          <div class="header" @click="toggleGroup($item.name)">
            <image class="arrow" src="/common/image/arrow-{{expandedGroups[$item.name] ? 1 : 0}}.png"></image>
            <text class="h2">{{$item.name}}</text>
          </div>
          <block if="{{expandedGroups[$item.name]}}">
            <text class="link" for="{{$item.caseList}}" @click="route($item.path)">{{$item.name}}</text>
          </block>
        </block>
      </div>
    </block>
  </div>
</template>

<script>
import router from '@system.router'
// 注入点1数据源：官方 tabsData（框架/组件/接口三章）→ 课程面板一章一组 7 个栏目。
// 官方字段 name/path 原样沿用（path=manifest 页 key，官方 route(uri) 零改动直通）；
// 结构由官方对象字典改为单章数组（官方 demo 三章并列，本工程一章即可，其余逐字保留）。
import { tabsData } from './data.js'

export default {
  private: {
    tabs: tabsData,
    expandedGroups: {}
  },

  // 官方 route 原样保留：官方 path 即页 key（官方 manifest 同款直通），
  // 我们的 data.js path 同样写 manifest 页 key（schedule-panel-xxx），无需注入跳转逻辑
  route(uri) {
    router.push({ uri })
  },

  toggleGroup(name) {
    this.expandedGroups[name] = !this.expandedGroups[name]
  }
}
</script>

<style>
@import './comm.css';

.home-page {
  align-items: flex-start;
  justify-content: flex-start;
  padding: 60px 80px;
}

.chapter {
  margin-bottom: 30px;
  flex-direction: column;
}

.h1 {
  font-weight: bold;
  font-size: 36px;
}

.h2 {
  margin-top: 15px;
  font-size: 30px;
}

.header {
  align-items: center;
  margin-top: 0;
  margin-bottom: 0;
}

.arrow {
  width: 20px;
  height: 20px;
  margin-top: 7px;
  margin-right: 3px;
}

/* ev-minimal 军规4例外：官方此处另有 text-overflow: ellipsis 一行，
   撞项目铁律（禁 ellipsis）故删除，其余逐行保留 */
.link {
  height: 40px;
  margin-left: 23px;
  font-size: 30px;
  margin: 5px 0;
}

text {
  font-size: 30px;
  margin: 5px 0;
}

@media (shape: pill-shaped) {
  .home-page {
    padding: 60px 10px;
  }

  .link {
    height: 70px;
    margin-left: 15px;
  }

  .h1 {
    font-size: 52px;
  }

  text {
    font-size: 48px;
  }

  .arrow {
    width: 30px;
    height: 36px;
  }
}
</style>
