<!-- 「更多首页」目录页：data.js 的 tabsData 展平成 8 个栏目入口。
     2026-10-17 首轮整理（原 padding 60 80 把 7 栏压成窄柱）。
     2026-10-25 按 ev-six 六位准则重排（evtask-D-evclass-sche-261025-5aqmfh），修三处实测违规：
     ① 标题原「更多首页」4 字 @28px 实宽 149px，头部可用宽只有 116px（192−8×2−30−30），
        必折行 → 文案删字改「栏目」2 字 = 75px，余 33px；
     ② 卡片左右 padding 14px + 页面 8px，条目名 4 字 @28 需 149px，容器仅 148px，贴边裁字
        → 页面 12px / 卡片 8px，容器回 152px（余 3px，手册 §4.1 认可的贴边配置）；
     ③ 行 padding 6px + 行高 38 = 50px/行，8 行 + 头部 + 留白 = 518px 超 490 屏，末项被切
        → 行 padding 3px（44px/行，恰好等于触控最小热区），整页 468px，一屏放下 8 项。
     可点性靠底色（红线 9）：整张卡是 card 二级底，行内不再叠符号；行内无箭头、无分隔符。
     逻辑与数据源未动：仍是 data.js 的 tabsData，route/goBack 行为不变。 -->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="page-scroll" scroll-y="{{ true }}">
      <div class="page-body">
        <!-- 头部固定 3 元素：返回键 30 + 居中标题（≤3 字）+ 等宽占位 30 -->
        <div class="header">
          <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
            <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
          </div>
          <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">栏目</text>
          <div class="header-placeholder"></div>
        </div>

        <!-- 单张卡承载 8 个栏目：整块成组，比一串散落的链接干净；行与行靠 44px 行距分层 -->
        <div class="section" style="background-color: {{ theme.card }}">
          <div class="item-row" for="{{ items }}" onclick="route($item.path)">
            <text class="item-label" style="color: {{ theme.text }}">{{ $item.name }}</text>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
// 数据源沿用 data.js 的 tabsData（更多首页一章一组 8 个栏目）；此处只做「章节 → 平铺列表」的展平。
import { tabsData } from './data.js'

const store = require('../../data/store.js')

const flatItems = []
for (let i = 0; i < tabsData.length; i++) {
  const groups = tabsData[i].groupList || []
  for (let j = 0; j < groups.length; j++) {
    const cases = groups[j].caseList || []
    for (let k = 0; k < cases.length; k++) {
      flatItems.push({ name: cases[k].name, path: cases[k].path })
    }
  }
}

export default {
  private: {
    iconTheme: 'dark',
    items: flatItems,
    // 首帧默认深色（与 tools.ux 同款），onInit 里由 store.getTheme 覆盖为当前主题
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      text: '#ffffff',
      textMuted: '#555566',
      border: '#0f3460'
    }
  },

  onInit() {
    const self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  // 注入点3跳转：官方 route 原样保留（router.push uri）；带 fromPanel 标记，供目标页判定 root
  route(uri) {
    router.push({ uri: uri, params: { fromPanel: '1' } })
  },

  // 注入点3跳转-返回：本页由设置页 push 而来非根页，顶部返回按钮回上一页
  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.page-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

/* 页面左右 12px（内容宽 168px），顶部 44px 避开状态栏。 */
.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 12px 12px 12px;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn-wrapper {
  width: 30px; height: 30px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0;
}

.back-btn-icon {
  width: 22px; height: 22px;
}

/* 标题可用宽 = 192 − 12×2 − 30 − 30 = 108px；2 字 @28 = 75px，余 33px。 */
.header-title {
  flex: 1; font-size: 28px; font-weight: bold; text-align: center; line-height: 36px; lines: 1;
}

.header-placeholder {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
}

/* 卡片左右 padding 8px（≤8 合规）：行内可用 152px，4 字 @28 = 149px，余 3px。 */
.section {
  width: 100%;
  flex-direction: column;
  border-radius: 14px;
  padding: 10px 8px;
}

/* 行高 38 + 上下 3px = 44px/行（触控最小热区）；8 行 352px，整页 468px，一屏不滚。 */
.item-row {
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 44px;
  padding: 3px 0;
}

.item-label {
  font-size: 28px;
  line-height: 38px;
}

@media (width >= 360) {
  .page-body { padding: 44px 16px 16px 16px; }
  .item-row { min-height: 52px; padding: 7px 0; }
  .item-label { font-size: 30px; line-height: 40px; }
}

@media (width >= 480) {
  .page-body { padding: 44px 40px 24px 40px; }
  .item-row { min-height: 60px; padding: 10px 0; }
  .section { border-radius: 18px; padding: 14px 12px; }
}
</style>
