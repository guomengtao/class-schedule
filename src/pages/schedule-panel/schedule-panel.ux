<!-- UI/实现来源：open-vela-learning/packages_apps/wearable/settings/src/pages/home/index.ux（ev-minimal 最小改动法，2026-10-14；注入点仅数据源/文案/跳转） -->
<template>
  <div class="w-full h-full bg-black">
    <list class="list">
      <list-item class="list-item justify-center" type="title">
        <image class="w-30 h-30 mr-10" src="/common/image/back.png" onclick="handleClick"></image>
        <text class="list-item-title">课程面板</text>
      </list-item>
      <list-item class="list-item justify-between pl-60" type="setting-item" for="{{list}}" onclick="routeDetail($item)">
        <div>
          <image class="subject-image mt-4" src="{{$item.iconSrc}}"></image>
          <text class="subject-name">{{ $item.name }}</text>
        </div>

        <image class="subject-image mr-60" src="/common/image/right.png"></image>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"

// 注入点①数据源：官方 settings 静态 list（15 项设置）→ 课程面板 7 个栏目入口。
// 图标资源原样拷贝自官方 settings/src/common/image/*.indexed_8.png（官方 demo 本身即一图多项复用）；
// page 字段为本工程栏目页路由名（官方 demo 无此字段，§11 例外：官方无课程面板业务）。
var ENTRIES = [
  { name: "当前进度", iconSrc: "/common/image/motion.indexed_8.png", page: "schedule-panel-progress" },
  { name: "剩余课程", iconSrc: "/common/image/battery.indexed_8.png", page: "schedule-panel-remaining" },
  { name: "科目色卡", iconSrc: "/common/image/display.indexed_8.png", page: "schedule-panel-subject-color" },
  { name: "倒计时", iconSrc: "/common/image/disturb.indexed_8.png", page: "schedule-panel-countdown" },
  { name: "智能切换", iconSrc: "/common/image/applayout.indexed_8.png", page: "schedule-panel-dual-mode" },
  { name: "多彩课表", iconSrc: "/common/image/sound.indexed_8.png", page: "schedule-panel-colorful" },
  { name: "简易课表", iconSrc: "/common/image/novice.indexed_8.png", page: "schedule-panel-simple" }
]

export default {
  // 页面级组件的数据模型，影响传入数据的覆盖机制：private内定义的属性不允许被覆盖
  private: {
    title: "课程面板",
    list: ENTRIES
  },

  // 注入点③跳转：官方 routeDetail（/pages/detail，本工程不存在）→ 按条目进对应栏目页
  routeDetail(item) {
    router.push({
      uri: "/pages/" + item.page
    })
  },
  // 注入点③跳转-返回：官方 handleClick 为 app.terminate()（官方 demo 是根页）；
  // 本页由设置页 push 而来非根页，返回应为 router.back()，官方 app 导入随之移除。
  handleClick() {
    router.back()
  }
}
</script>

<style>
@import "./index.less";
.list {
  width: 100%;
  height: 100%;
}
.title {
  color: #fff;
  font-size: 40px;
  margin-top: 42px;
}
.list-item-title{
  font-size: 36px;
  color:white;
}
.list-item {
  flex-direction: row;
  align-items: center;
  height: 88px;
}

.subject-image {
	width: 58px;
	height: 58px;
	margin-right: 30px;
}
.subject-name {
	font-size: 36px;
	font-weight: 400;
	color: #fff;
}
</style>

/* atomics below copied verbatim from official settings app.ux style block (ev-minimal rule 3: append-only) */
.pl-60 { padding-left: 60px; }
.mr-10 { margin-right: 10px; }
.mr-60 { margin-right: 60px; }
.mt-4 { margin-top: 4px; }
.bg-black { background-color: rgba(0, 0, 0, 1); }
.h-30 { height: 30px; }
.h-full { height: 100%; }
.w-30 { width: 30px; }
.w-full { width: 100%; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }

/* ev-minimal v2 rule 6: band-9 pill screen 194x368 narrowing (append-only; official class defs untouched; single-shape query, no comma).
   Official settings home has no pill branch. At 194px the official row (pl-60 + 58px icon + 36px name + 60px + 58px arrow) overflows.
   Narrowed per three-shape template baselines: row 88->72px, icon/arrow 58->30px, name 36->24px, pl-60->8px, mr-60->8px.
   Math: usable 194px - fixed 84px (8+30+8+8+30) = 110px name budget; 4 chars at 24px = 96px fits. */
@media screen and (shape: pill-shaped) {
  .list-item { height: 72px; }
  .list-item-title { font-size: 28px; }
  .subject-image { width: 30px; height: 30px; margin-right: 8px; }
  .subject-name { font-size: 24px; }
  .pl-60 { padding-left: 8px; }
  .mr-60 { margin-right: 8px; }
}
