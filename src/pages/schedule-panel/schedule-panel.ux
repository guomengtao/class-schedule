<!-- UI/实现来源：open-vela-learning/packages_apps/wearable/multi_screen_todolist/src/pages/task/index.ux（ev-minimal 最小改动法，2026-10-14；官方库最基础列表实现：div for 循环行 + text onclick。注入点仅数据源/文案/跳转） -->
<template>
  <div class="list" onswipe="touchMove">
    <text class="today-text" onclick="toPrev">{{showPrev ? '上一页' : '课程面板'}}</text>
    <div class="item-box">
      <div for="{{(index, task) in pageTasks}}" class="item-wrapper">
        <div class="content-common">
          <image src="./checkbox.png" class="image"></image>
          <text class="title-text" onclick="toDetail(task)">{{task.title}}</text>
        </div>
        <div class="date-text-box" onclick="toDetail(task)">
          <text class="date-text">{{task.dateString}}</text>
        </div>
      </div>
    </div>
    <text show="{{showNext}}" onclick="toNext" class="more-text">下一页</text>
  </div>
</template>

<script>
import router from "@system.router";

// 注入点1数据源：官方 tasks（5 条静态任务）→ 课程面板 7 个栏目入口。
// 官方字段 title/dateString 原样沿用（dateString 注入为栏目简短说明）；
// page 字段为本工程栏目页路由名（官方 demo 无此字段，§11 例外：官方无课程面板业务）。
// 官方分页逻辑（3 条/页）原样保留，未改。
var ENTRIES = [
  { title: "当前进度", dateString: "今日上课情况", page: "schedule-panel-progress" },
  { title: "剩余课程", dateString: "还没上的课", page: "schedule-panel-remaining" },
  { title: "科目色卡", dateString: "科目颜色一览", page: "schedule-panel-subject-color" },
  { title: "倒计时", dateString: "下课倒计时", page: "schedule-panel-countdown" },
  { title: "智能切换", dateString: "课表库自动切换", page: "schedule-panel-dual-mode" },
  { title: "多彩课表", dateString: "彩色周视图", page: "schedule-panel-colorful" },
  { title: "简易课表", dateString: "简洁周视图", page: "schedule-panel-simple" }
]

export default {
  // 页面级组件的数据模型，影响传入数据的覆盖机制：private内定义的属性不允许被覆盖
  private: {
    tasks: ENTRIES,
    pageTasks: [],
    showPrev: false,
    showNext: true,
    showMore: false,
    isShow: false,
    page: 0
  },

  onShow() {
    this.updatePageTask()
  },

  updatePageTask() {
    const start = this.page * 3
    const end = (this.page + 1) * 3
    this.pageTasks = this.tasks.slice(start, end)
    if (end >= this.tasks.length) this.showNext = false
  },

  toPrev() {
    if (this.page === 0) return
    this.page--
    if (this.page === 0) this.showPrev = false

    this.updatePageTask()
    if (this.page !== 5) this.showNext = true
  },

  toNext() {
    this.page++
    if (this.page > 0) this.showPrev = true
    if (this.page === 5) this.showNext = false
    this.updatePageTask()
  },
  // 注入点3跳转：官方 toDetail（/pages/detail，本工程不存在）→ 按条目进对应栏目页
  toDetail(task) {
    router.push({
      uri: "/pages/" + task.page
    });
  },
  // 注入点3跳转-返回：官方 touchMove 右滑为 app.terminate()（官方 demo 是根页）；
  // 本页由设置页 push 而来非根页，右滑返回应为 router.back()，官方 app 导入随之移除。
  touchMove: function (e) {
    if (e.direction == "right") {
      router.back();
    }
  },
};
</script>

<style>
@import "./radioLessThanHalf.css" screen and (aspect-ratio < 1/2);
@import "./radioMoreThanHalf.css" screen and (aspect-ratio > 1/2) and (aspect-ratio < 1/1);
@import "./radioMoreThanOne.css" screen and (aspect-ratio >= 1);

.list {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
}

.today-text {
  width: 100%;
  text-align: center;
  color: #ff6a24;
}

.complete-text {
  width: 100%;
  text-align: center;
  color: #6f6f6f;
}

/* ev-minimal 军规4例外：官方此处有 text-overflow: ellipsis 与 lines: 1 两行，
   撞项目铁律（禁 lines/ellipsis，详见项目字号规范）故删除，其余逐行保留 */
text {
  font-size: 30px;
  color: white;
}

.item-box {
  flex: 1;
  flex-direction: column;
}

.content-common {
  width: 100%;
  height: 50%;
  justify-content: flex-end;
  align-items: center;
}

.date-text-box {
  width: 100%;
  height: 50%;
  justify-content: flex-end;
  align-items: center;
}

.item-wrapper {
  width: 100%;
  height: 30%;
  justify-content: center;
  flex-direction: column;
}

.image {
  margin-right: 10px;
}

.content-wrapper {
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  border:1px solid pink;
}

.date-text {
  color: #6f6f6f;
}

.more-text {
  width: 100%;
  text-align: center;
  color: #ff6a24;
}

/* ev-minimal v2 军规6：手环9 胶囊屏 194x368（aspect-ratio≈0.53 走官方 radioMoreThanHalf 档），
   但该档 title-text/date-text 为 332px 固定宽，超 194px 屏宽。
   追加式收窄（单一 shape 无逗号，官方 class 定义未动）：
   算账 194px - image 60px - margin 30px = 104px 标题预算；4 字栏目名@24px=96px 达标；
   副文案无图标占位，164px 预算@24px 约 6 字达标。 */
@media screen and (shape: pill-shaped) {
  .title-text {
    width: 104px;
    margin-right: 0;
    font-size: 24px;
  }
  .date-text {
    width: 164px;
    margin-right: 0;
    font-size: 24px;
  }
}
</style>
