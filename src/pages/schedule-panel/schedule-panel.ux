<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">课程面板</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="row" onclick="goPage('schedule-panel-progress')">
        <text class="row-label" style="color: {{ theme.text }}">当前进度</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">进度条 · 倒计时</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="goPage('schedule-panel-remaining')">
        <text class="row-label" style="color: {{ theme.text }}">剩余课程</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">自动隐藏已过</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="goPage('schedule-panel-subject-color')">
        <text class="row-label" style="color: {{ theme.text }}">科目色卡</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">科目固定颜色</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="goPage('schedule-panel-countdown')">
        <text class="row-label" style="color: {{ theme.text }}">倒计时</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">大号倒计时</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="goPage('schedule-panel-dual-mode')">
        <text class="row-label" style="color: {{ theme.text }}">智能切换</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">上课课间自动切</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}; margin-top: 12px">
      <div class="row" onclick="goPage('schedule-panel-colorful')">
        <text class="row-label" style="color: {{ theme.text }}">多彩课表</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">多彩色 · 最新课程</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
      <div class="divider" style="background-color: {{ theme.border }}"></div>
      <div class="row" onclick="goPage('schedule-panel-simple')">
        <text class="row-label" style="color: {{ theme.text }}">简易课表</text>
        <div class="row-right">
          <text class="row-hint" style="color: {{ theme.textMuted }}">极简 · 核心课程</text>
          <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  goPage(name) {
    router.push({ uri: "/pages/" + name })
  },

  goBack() { router.back() }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; padding: 44px 12px 12px 12px }

.back-header { flex-direction: row; align-items: center; margin-bottom: 16px; padding: 0 4px }
.back-btn-wrapper { width: 48px; height: 40px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 24px; height: 24px }
.header-title { flex: 1; font-size: 28px; font-weight: bold; text-align: center; line-height: 38px }
.header-placeholder { width: 48px; height: 48px; flex-shrink: 0 }

.section { flex-direction: column; border-radius: 14px; overflow: hidden; margin: 0 4px }
.row { flex-direction: row; align-items: center; padding: 18px 16px }
.row-label { font-size: 24px; line-height: 32px; font-weight: bold; flex: 1 }
.row-right { flex-direction: row; align-items: center; flex-shrink: 0 }
.row-hint { font-size: 18px; line-height: 26px; margin-right: 6px }
.arrow { font-size: 24px; line-height: 32px }
.divider { height: 1px; margin: 0 16px }

@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px }
  .row { padding: 20px 18px }
  .row-label { font-size: 26px; line-height: 34px }
  .row-hint { font-size: 20px; line-height: 28px }
}
</style>