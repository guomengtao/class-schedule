<!-- UI/实现来源：open-vela-learning/packages_apps/wearable/vela-sample/src/home/index.ux（ev-minimal v3，2026-10-14）
     本轮改动（注入点：数据源/跳转/返回）：去掉官方分组折叠，caseList 直接平铺为链接列表；顶部加居中返回按钮。 -->
<template>
  <div class="page home-page">
    <div class="back-header" @click="goBack">
      <image class="back-icon" src="/common/image/back.png"></image>
      <text class="back-text">返回</text>
    </div>
    <block for="{{tabs}}">
      <div class="chapter">
        <text class="h1">{{$item.name}}</text>
        <block for="{{$item.groupList}}">
          <text class="link" for="{{$item.caseList}}" @click="route($item.path)">{{$item.name}}</text>
        </block>
      </div>
    </block>
  </div>
</template>

<script>
import router from '@system.router'
// 注入点1数据源：官方 tabsData（框架/组件/接口三章）→ 课程面板一章一组 7 个栏目。
// 官方字段 name/path 原样沿用；path 写全 /pages/ 前缀（官方 manifest 页 key 无 pages/ 前缀，
// 本项目 manifest 为 "pages/schedule-panel-xxx"，故跳转必须带前缀，否则链接点不开 —— 跳转属注入点）。
import { tabsData } from './data.js'

export default {
  private: {
    tabs: tabsData
  },

  // 注入点3跳转：官方 route 原样保留（router.push uri）
  route(uri) {
    router.push({ uri })
  },

  // 注入点3跳转-返回：本页由设置页 push 而来非根页，顶部返回按钮回上一页
  goBack() {
    router.back()
  }
}
</script>

<style>
@import './comm.css';

.home-page {
  align-items: flex-start;
  justify-content: flex-start;
  padding: 60px 80px;
}

.back-header {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-bottom: 20px;
}

.back-icon {
  width: 30px;
  height: 30px;
  margin-right: 6px;
}

.back-text {
  font-size: 30px;
}

.chapter {
  margin-bottom: 30px;
  flex-direction: column;
}

.h1 {
  font-weight: bold;
  font-size: 36px;
}

.h2 {
  margin-top: 15px;
  font-size: 30px;
}

/* ev-minimal 军规4例外：官方此处另有 text-overflow: ellipsis 一行，
   撞项目铁律（禁 ellipsis）故删除，其余逐行保留 */
.link {
  height: 40px;
  margin-left: 23px;
  font-size: 30px;
  margin: 5px 0;
}

text {
  font-size: 30px;
  margin: 5px 0;
}

@media (shape: pill-shaped) {
  .home-page {
    padding: 60px 10px;
  }

  .back-icon {
    width: 36px;
    height: 36px;
  }

  .link {
    height: 70px;
    margin-left: 15px;
  }

  .h1 {
    font-size: 52px;
  }

  text {
    font-size: 48px;
  }
}
</style>
