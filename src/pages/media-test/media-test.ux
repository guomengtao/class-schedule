<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">@media 语法测试</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="scroll-body" scroll-y="{{true}}">
      <div class="test-section">
        <text class="section-title" style="color: {{ theme.textSecondary }}">本页面在手环真机上运行。</text>
        <text class="section-title" style="color: {{ theme.textSecondary }}">绿色 = 媒体查询匹配生效 / 红色 = 未匹配</text>

        <!-- 测试 1: @media (shape: pill-shaped) -->
        <div class="test-group-1">
          <text class="test-label" style="color: {{ theme.text }}">1. @media (shape: pill-shaped)</text>
          <div class="test-box">
            <text class="test-text">Red=不匹配 | Green=匹配</text>
          </div>
        </div>

        <!-- 测试 2: @media screen and (shape: pill-shaped) 【关键】 -->
        <div class="test-group-2">
          <text class="test-label" style="color: {{ theme.text }}">2. @media screen and (shape: pill-shaped)</text>
          <div class="test-box">
            <text class="test-text">Red=不匹配 | Green=匹配</text>
          </div>
        </div>

        <!-- 测试 3: @media (shape: capsule) -->
        <div class="test-group-3">
          <text class="test-label" style="color: {{ theme.text }}">3. @media (shape: capsule)</text>
          <div class="test-box">
            <text class="test-text">Red=不匹配 | Green=匹配</text>
          </div>
        </div>

        <!-- 测试 4: @media screen and (shape: capsule) 【关键】 -->
        <div class="test-group-4">
          <text class="test-label" style="color: {{ theme.text }}">4. @media screen and (shape: capsule)</text>
          <div class="test-box">
            <text class="test-text">Red=不匹配 | Green=匹配</text>
          </div>
        </div>

        <!-- 测试 5: 无媒体查询（对照组，永远绿色） -->
        <div class="test-group-5">
          <text class="test-label" style="color: {{ theme.text }}">5. 对照组（无 @media，永远生效）</text>
          <div class="test-box">
            <text class="test-text">Red=不匹配 | Green=匹配</text>
          </div>
        </div>

        <!-- 测试 6: @media screen and (width >= 100px) -->
        <div class="test-group-6">
          <text class="test-label" style="color: {{ theme.text }}">6. @media screen and (width >= 100px)</text>
          <div class="test-box">
            <text class="test-text">Red=不匹配 | Green=匹配</text>
          </div>
        </div>

        <!-- 测试 7: @media (width >= 100px) -->
        <div class="test-group-7">
          <text class="test-label" style="color: {{ theme.text }}">7. @media (width >= 100px)</text>
          <div class="test-box">
            <text class="test-text">Red=不匹配 | Green=匹配</text>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      text: '#ffffff',
      textSecondary: '#888899',
      accent: '#7ec8e3'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  goBack() {
    router.back()
  }
}
</script>

