<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="page-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">日期选择器 Demo</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="notice-banner" style="background-color: {{ theme.cardLight }}; border-color: {{ theme.accent }}">
      <text class="notice-text" style="color: {{ theme.textSecondary }}">以下全部使用小米 Vela 官方 picker 组件（type="text" / type="time"），零自绘滚轮。</text>
    </div>

    <div class="section-title-block">
      <text class="section-title" style="color: {{ theme.accent }}">路径 A · 官方时间选择器</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">picker type="time" — 选时分，官方原生滚动</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="picker-row">
        <text class="picker-label" style="color: {{ theme.textSecondary }}">⏰ 当前时间：</text>
        <text class="picker-value" style="color: {{ theme.accent }}">{{ timeVal }}</text>
      </div>
      <picker class="time-picker" type="time" selected="{{ timeVal }}" onchange="onTimeChange">
      </picker>
    </div>

    <div class="section-title-block">
      <text class="section-title" style="color: {{ theme.accent }}">路径 B · 官方选择器级联（年月日）</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">picker type="text" — 三列逐列选年/月/日</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="picker-label" style="color: {{ theme.textSecondary }}">📅 年</text>
      <picker class="date-picker" type="text" range="{{ yearStrs }}" selected="{{ yIdx }}" onchange="onYearChange">
      </picker>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <text class="picker-label" style="color: {{ theme.textSecondary }}">📅 月</text>
      <picker class="date-picker" type="text" range="{{ monthStrs }}" selected="{{ mIdx }}" onchange="onMonthChange">
      </picker>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <text class="picker-label" style="color: {{ theme.textSecondary }}">📅 日</text>
      <picker class="date-picker" type="text" range="{{ dayStrs }}" selected="{{ dIdx }}" onchange="onDayChange">
      </picker>

      <div class="result-row">
        <text class="result-label" style="color: {{ theme.textSecondary }}">已选日期：</text>
        <text class="result-value" style="color: {{ theme.accent }}">{{ years[yIdx] }}-{{ monthStrs[mIdx] }}-{{ dayStrs[dIdx] }}</text>
      </div>
    </div>

    <div class="section-title-block">
      <text class="section-title" style="color: {{ theme.accent }}">路径 C · 组合结果</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">同时展示时分和年月日</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="combined-card" style="background-color: {{ theme.cardLight }}">
        <div class="combined-row">
          <text class="combined-label" style="color: {{ theme.textSecondary }}">时间</text>
          <text class="combined-val" style="color: {{ theme.text }}">{{ timeVal }}</text>
        </div>
        <div class="row-divider" style="background-color: {{ theme.border }}"></div>
        <div class="combined-row">
          <text class="combined-label" style="color: {{ theme.textSecondary }}">日期</text>
          <text class="combined-val" style="color: {{ theme.text }}">{{ years[yIdx] }}-{{ monthStrs[mIdx] }}-{{ dayStrs[dIdx] }}</text>
        </div>
        <div class="row-divider" style="background-color: {{ theme.border }}"></div>
        <div class="combined-row">
          <text class="combined-label" style="color: {{ theme.textSecondary }}">完整</text>
          <text class="combined-val" style="color: {{ theme.accent }}; font-weight: bold;">{{ years[yIdx] }}-{{ monthStrs[mIdx] }}-{{ dayStrs[dIdx] }} {{ timeVal }}</text>
        </div>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-subtitle" style="color: {{ theme.text }}">官方组件说明</text>
      <div class="info-list">
        <text class="info-item" style="color: {{ theme.textSecondary }}">• picker type="time"：官方原生时分滚动，selected 为 hh:mm 字符串</text>
        <text class="info-item" style="color: {{ theme.textSecondary }}">• picker type="text" + range：三列单列级联，range 为 Array&lt;string&gt;</text>
        <text class="info-item" style="color: {{ theme.textSecondary }}">• 事件：普通 picker change → { newValue, newSelected }；时间 picker → { hour, minute }</text>
        <text class="info-item" style="color: {{ theme.textSecondary }}">• 零自绘滚轮、零 scroll 实时逻辑、零模拟器</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    years: [],
    yearStrs: [],
    monthStrs: [],
    dayStrs: [],
    yIdx: 0,
    mIdx: 0,
    dIdx: 0,
    timeVal: "12:30"
  },

  onInit() {
    var self = this
    var now = new Date()
    var cy = now.getFullYear()
    var cm = now.getMonth() + 1
    var cd = now.getDate()

    var hrs = String(now.getHours()).padStart(2, "0")
    var mins = String(now.getMinutes()).padStart(2, "0")
    self.timeVal = hrs + ":" + mins

    var yArr = []
    var startY = 2020
    for (var i = startY; i <= cy + 5; i++) {
      yArr.push(i)
    }
    self.years = yArr
    self.yearStrs = yArr.map(function(v) { return String(v) })

    var yi = yArr.indexOf(cy)
    if (yi < 0) yi = yArr.length - 1
    self.yIdx = yi

    self.monthStrs = []
    for (var j = 1; j <= 12; j++) {
      self.monthStrs.push(String(j))
    }
    self.mIdx = cm - 1

    self.dayStrs = self.buildDayStrs(cy, cm)
    var di = cd - 1
    if (di < 0) di = 0
    if (di >= self.dayStrs.length) di = self.dayStrs.length - 1
    self.dIdx = di

    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  buildDayStrs: function(y, m) {
    var daysInMonth = 31
    if (m === 2) {
      var isLeap = (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0)
      daysInMonth = isLeap ? 29 : 28
    } else if (m === 4 || m === 6 || m === 9 || m === 11) {
      daysInMonth = 30
    }
    var arr = []
    for (var d = 1; d <= daysInMonth; d++) {
      arr.push(String(d))
    }
    return arr
  },

  onTimeChange: function(e) {
    this.timeVal = e.hour + ":" + e.minute
  },

  onYearChange: function(e) {
    this.yIdx = e.newSelected
    this.recalcDays()
  },

  onMonthChange: function(e) {
    this.mIdx = e.newSelected
    this.recalcDays()
  },

  onDayChange: function(e) {
    this.dIdx = e.newSelected
  },

  recalcDays: function() {
    var yv = this.years[this.yIdx]
    var mv = parseInt(this.monthStrs[this.mIdx], 10)
    this.dayStrs = this.buildDayStrs(yv, mv)
    if (this.dIdx >= this.dayStrs.length) {
      this.dIdx = this.dayStrs.length - 1
    }
  },

  goBack: function() {
    router.back()
  },

  onDestroy: function() {
    this.theme = null
  }
}
</script>

