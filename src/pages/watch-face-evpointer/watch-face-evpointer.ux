<template>
  <!--
    EV指针 · 仿古金属指针表盘（独立页面 watch-face-evpointer）
    —— 与并行会话的 watch-face-metal 完全隔离，各做各的，互不改对方文件。
    Vela 快应用 · 小米手环 9 标准版 · 跑道屏 192×490（弧形安全区 y<40 / y>450 只留底色）

    设计定位：仿中国古代青铜器 —— 青铜同心环表壳（铜锈绿）+ 雷纹式分钟轨表圈
              + 十二地支（子…亥）替代阿拉伯数字 + 铜色时/分针 + 赤铜秒针。
    已实现（第 2 步）：盘面视觉 + 刻度 + 地支 + 指针实时走时。
    待做（后续步）：四路隐形退出手势（长按中心 / 长按铭文 / 双击表冠 / 上滑）；本期退出＝单击盘面返回。
  -->
  <div class="page">
    <!-- 表壳：青铜同心环（外缘铜锈高光 → 中圈铜锈绿 → 内圈暗铜），造金属厚度 -->
    <div class="case-outer"></div>
    <div class="case-mid"></div>
    <div class="case-inner"></div>
    <div class="dial"></div>

    <!-- 盘面光影：上半受光 / 下半沉影 + 一处镜面高光（无渐变，靠半色调叠） -->
    <div class="dial-light"></div>
    <div class="dial-shade"></div>
    <div class="glare"></div>

    <!-- 雷纹式分钟轨：60 格（长刻度更粗，仿嵌槽雷纹） -->
    <div class="tick" for="{{ticks}}"
         style="left: {{$item.x}}px; top: {{$item.y}}px; width: {{$item.w}}px; height: {{$item.h}}px; transform: rotate({{$item.rot}}deg); background-color: {{$item.c}}"></div>

    <!-- 十二地支（子…亥）：暗影倒角层 + 亮铜层（先影后亮，造浮雕） -->
    <text class="gan-sh" for="{{ganShadows}}"
          style="left: {{$item.x}}px; top: {{$item.y}}px; color: {{$item.c}}">{{$item.t}}</text>
    <text class="gan" for="{{ganZhi}}"
          style="left: {{$item.x}}px; top: {{$item.y}}px; color: {{$item.c}}">{{$item.t}}</text>

    <!-- 12 点位内圈铭文 EV（青铜款识） -->
    <text class="brand">EV</text>

    <!-- 指针：铜时/分针 + 赤铜秒针 + 铜轴帽 -->
    <div class="hand-hour" style="transform: rotate({{hourDeg}}deg)"></div>
    <div class="hand-minute" style="transform: rotate({{minDeg}}deg)"></div>
    <div class="sec-hand" style="transform: rotate({{secDeg}}deg)">
      <div class="sec-tip"></div>
    </div>
    <div class="center-cap"></div>

    <!-- 隐形热区：覆盖中性盘区，单击返回上一页（后续步再扩多路手势） -->
    <div class="hit-face" onclick="onFaceTap"></div>
  </div>
</template>

<script>
import router from "@system.router"

const CX = 96          // 盘心 x（屏宽 192 正中）
const CY = 240         // 盘心 y（避上下弧形危险区）
const R_TICK = 70      // 分钟轨半径
const R_GAN = 54       // 地支半径
const TICK_MS = 100    // 扫秒刷新间隔（连续扫动感）

// 十二地支：子(12点) → 亥，顺时针每 30°
const GAN = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥']

/** 极坐标 → 元素左上角坐标（元素自身中心落在半径 R 上）。 */
function place(radius, deg, w, h) {
  const rad = deg * Math.PI / 180
  return {
    x: Math.round((CX + radius * Math.sin(rad) - w / 2) * 10) / 10,
    y: Math.round((CY - radius * Math.cos(rad) - h / 2) * 10) / 10
  }
}

export default {
  private: {
    hourDeg: 0,
    minDeg: 0,
    secDeg: 0,
    ticks: [],
    ganZhi: [],
    ganShadows: [],
    timer: null
  },

  onInit() {
    this.buildDial()
    this.tick()
  },

  onShow() { this.startTimer() },
  onHide() { this.stopTimer() },
  onDestroy() { this.stopTimer() },

  // ==================== 盘面静态构件（一次性算好坐标） ====================

  buildDial() {
    // 雷纹式分钟轨 60 格
    const ticks = []
    for (let i = 0; i < 60; i++) {
      const deg = i * 6
      const long = (i % 5 === 0)
      const w = long ? 2 : 1
      const h = long ? 8 : 4
      const p = place(R_TICK, deg, w, h)
      ticks.push({
        x: p.x, y: p.y, w: w, h: h, rot: deg,
        c: long ? '#a4904a' : '#5e5a35'
      })
    }
    this.ticks = ticks

    // 十二地支：亮铜层 + 暗影倒角层（偏移 +1,+1）
    const ganZhi = []
    const ganShadows = []
    for (let i = 0; i < 12; i++) {
      const deg = i * 30
      const rad = deg * Math.PI / 180
      const nx = CX + R_GAN * Math.sin(rad)
      const ny = CY - R_GAN * Math.cos(rad)
      const t = GAN[i]
      ganZhi.push({
        x: Math.round((nx - 9) * 10) / 10,
        y: Math.round((ny - 9) * 10) / 10,
        t: t,
        c: '#d9c67e'
      })
      ganShadows.push({
        x: Math.round((nx - 9 + 1) * 10) / 10,
        y: Math.round((ny - 9 + 1) * 10) / 10,
        t: t,
        c: '#6f5f2a'
      })
    }
    this.ganZhi = ganZhi
    this.ganShadows = ganShadows
  },

  // ==================== 走时 ====================

  startTimer() {
    this.stopTimer()
    const self = this
    this.timer = setInterval(function () { self.tick() }, TICK_MS)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tick() {
    const d = new Date()
    const h = d.getHours()
    const m = d.getMinutes()
    const s = d.getSeconds()
    const ms = d.getMilliseconds()
    // 时针随分钟连续推进（真机械表的时针是渐进的，不是整点跳）
    this.hourDeg = (h % 12) * 30 + m * 0.5
    this.minDeg = m * 6 + s * 0.1
    this.secDeg = (s + ms / 1000) * 6
  },

  // ==================== 退出：单击中性盘区返回 ====================

  onFaceTap() {
    router.back()
  }
}
</script>

<style>
  .page {
    flex: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #0d100a;
  }

  /* ── 表壳同心环：青铜（外缘铜锈高光边 → 中圈铜锈绿 → 内圈暗铜） ── */
  .case-outer {
    position: absolute;
    left: 4px;
    top: 148px;
    width: 184px;
    height: 184px;
    border-radius: 92px;
    background-color: #2b3226;
    border: 2px solid #6b7657;
  }

  .case-mid {
    position: absolute;
    left: 11px;
    top: 155px;
    width: 170px;
    height: 170px;
    border-radius: 85px;
    background-color: #39422f;
  }

  .case-inner {
    position: absolute;
    left: 15px;
    top: 159px;
    width: 162px;
    height: 162px;
    border-radius: 81px;
    background-color: #1e2418;
  }

  .dial {
    position: absolute;
    left: 18px;
    top: 162px;
    width: 156px;
    height: 156px;
    border-radius: 78px;
    background-color: #262d1e;
    border: 1px solid #4b573a;
  }

  /* ── 盘面光影（半色调叠立体，不用渐变） ── */
  .dial-light {
    position: absolute;
    left: 18px;
    top: 162px;
    width: 156px;
    height: 78px;
    border-radius: 78px 78px 0 0;
    background-color: #414d34;
    opacity: 0.55;
  }

  .dial-shade {
    position: absolute;
    left: 18px;
    top: 240px;
    width: 156px;
    height: 78px;
    border-radius: 0 0 78px 78px;
    background-color: #090b06;
    opacity: 0.50;
  }

  .glare {
    position: absolute;
    left: 34px;
    top: 178px;
    width: 58px;
    height: 26px;
    border-radius: 29px 22px 29px 22px;
    background-color: #e2e8ca;
    opacity: 0.09;
  }

  /* ── 雷纹式分钟轨 ── */
  .tick {
    position: absolute;
    border-radius: 1px;
  }

  /* ── 十二地支（立体倒角：暗影层 + 亮铜层） ── */
  .gan-sh,
  .gan {
    position: absolute;
    width: 18px;
    height: 18px;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    line-height: 18px;
  }

  /* ── 12 点位铭文 EV ── */
  .brand {
    position: absolute;
    left: 66px;
    top: 198px;
    width: 60px;
    height: 14px;
    font-size: 12px;
    letter-spacing: 3px;
    text-align: center;
    line-height: 14px;
    color: #c9b978;
  }

  /* ── 指针（transform-origin 50% 100%：绕元素底边中点＝盘心旋转） ── */
  .hand-hour {
    position: absolute;
    left: 92px;
    top: 196px;
    width: 8px;
    height: 44px;
    border-radius: 4px 4px 1px 1px;
    background-color: #c9a95e;
    border: 1px solid #7d6a34;
    transform-origin: 50% 100%;
  }

  .hand-minute {
    position: absolute;
    left: 93px;
    top: 180px;
    width: 6px;
    height: 60px;
    border-radius: 3px 3px 1px 1px;
    background-color: #d2b370;
    border: 1px solid #7d6a34;
    transform-origin: 50% 100%;
  }

  .sec-hand {
    position: absolute;
    left: 95px;
    top: 172px;
    width: 2px;
    height: 68px;
    background-color: #b8703c;
    transform-origin: 50% 100%;
  }

  .sec-tip {
    position: absolute;
    left: -1px;
    top: 0px;
    width: 4px;
    height: 12px;
    background-color: #8f4f2a;
    border-radius: 2px;
  }

  .center-cap {
    position: absolute;
    left: 91px;
    top: 235px;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #dcc57e;
    border: 1px solid #7d6a34;
  }

  /* ── 隐形热区（不画内容，单击返回） ── */
  .hit-face {
    position: absolute;
    left: 18px;
    top: 162px;
    width: 156px;
    height: 156px;
    background-color: transparent;
  }
</style>
