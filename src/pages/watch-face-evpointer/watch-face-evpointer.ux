    width: 168px;
    height: 168px;
    border-radius: 84px;
    background-color: #2a3720;
  }

  .dial-face {
    position: absolute;
    left: 18px;
    top: 18px;
    width: 148px;
    height: 148px;
    border-radius: 74px;
    background-color: #1b2416;
  }

  .tick {
    position: absolute;
    width: 2px;
    height: 10px;
    background-color: #c9a961;
  }

  .gan {
    position: absolute;
    width: 20px;
    height: 20px;
    font-size: 14px;
    text-align: center;
    color: #d8b45a;
  }

  .hub {
    position: absolute;
    left: 84px;
    top: 84px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: #d8b45a;
  }

  .ev {
    position: absolute;
    left: 62px;
    top: 96px;
    width: 60px;
    text-align: center;
    font-size: 10px;
    color: #8a7d54;
    letter-spacing: 2px;
  }

  /* ── 三针：顶部中点压在盘心，向下延伸（引擎轴=顶部中点）── */
  .hand {
    position: absolute;
  }

  .hour {
    left: 89.5px;
    top: 92px;
    width: 5px;
    height: 48px;
    background-color: #d8b45a;
  }

  .minute {
    left: 90px;
    top: 92px;
    width: 4px;
    height: 66px;
    background-color: #e8c877;
  }

  .second {
    left: 91px;
    top: 92px;
    width: 2px;
    height: 80px;
    background-color: #d9552f;
  }

  /* ── 60 档字面量旋转：rotate(180 + 6N)，180° 使其由「向下」转为「向上」── */
  .r0 { transform: rotate(180deg); }
  .r1 { transform: rotate(186deg); }
  .r2 { transform: rotate(192deg); }
  .r3 { transform: rotate(198deg); }
  .r4 { transform: rotate(204deg); }
  .r5 { transform: rotate(210deg); }
  .r6 { transform: rotate(216deg); }
  .r7 { transform: rotate(222deg); }
  .r8 { transform: rotate(228deg); }
  .r9 { transform: rotate(234deg); }
  .r10 { transform: rotate(240deg); }
  .r11 { transform: rotate(246deg); }
  .r12 { transform: rotate(252deg); }
  .r13 { transform: rotate(258deg); }
  .r14 { transform: rotate(264deg); }
  .r15 { transform: rotate(270deg); }
  .r16 { transform: rotate(276deg); }
  .r17 { transform: rotate(282deg); }
  .r18 { transform: rotate(288deg); }
  .r19 { transform: rotate(294deg); }
  .r20 { transform: rotate(300deg); }
  .r21 { transform: rotate(306deg); }
  .r22 { transform: rotate(312deg); }
  .r23 { transform: rotate(318deg); }
  .r24 { transform: rotate(324deg); }
  .r25 { transform: rotate(330deg); }
  .r26 { transform: rotate(336deg); }
  .r27 { transform: rotate(342deg); }
  .r28 { transform: rotate(348deg); }
  .r29 { transform: rotate(354deg); }
  .r30 { transform: rotate(360deg); }
  .r31 { transform: rotate(366deg); }
  .r32 { transform: rotate(372deg); }
  .r33 { transform: rotate(378deg); }
  .r34 { transform: rotate(384deg); }
  .r35 { transform: rotate(390deg); }
  .r36 { transform: rotate(396deg); }
  .r37 { transform: rotate(402deg); }
  .r38 { transform: rotate(408deg); }
  .r39 { transform: rotate(414deg); }
  .r40 { transform: rotate(420deg); }
  .r41 { transform: rotate(426deg); }
  .r42 { transform: rotate(432deg); }
  .r43 { transform: rotate(438deg); }
  .r44 { transform: rotate(444deg); }
  .r45 { transform: rotate(450deg); }
  .r46 { transform: rotate(456deg); }
  .r47 { transform: rotate(462deg); }
  .r48 { transform: rotate(468deg); }
  .r49 { transform: rotate(474deg); }
  .r50 { transform: rotate(480deg); }
  .r51 { transform: rotate(486deg); }
  .r52 { transform: rotate(492deg); }
  .r53 { transform: rotate(498deg); }
  .r54 { transform: rotate(504deg); }
  .r55 { transform: rotate(510deg); }
  .r56 { transform: rotate(516deg); }
  .r57 { transform: rotate(522deg); }
  .r58 { transform: rotate(528deg); }
  .r59 { transform: rotate(534deg); }

  /* ── 底部信息 ── */
  .date-line {
    position: absolute;
    left: 0;
    top: 360px;
    width: 192px;
    text-align: center;
    font-size: 24px;
    color: #b9a86f;
  }

  .time-line {
    position: absolute;
    left: 0;
    top: 386px;
    width: 192px;
    text-align: center;
    font-size: 34px;
    color: #f0e2b6;
  }

  .back {
    position: absolute;
    left: 0;
    top: 444px;
    width: 192px;
    text-align: center;
    font-size: 24px;
    color: #6f6650;
  }

  /* ════════════════════════════════════════════════════════════
     手环10Pro 336×480 宽屏档
     · 全部单类选择器 —— Vela 不支持后代选择器
       （给宽屏类加页面前缀的写法会退化成单类，样式套到所有屏上）
     · 绝不碰 `.page` —— 页面头部铁律：加 flex 对齐会与
       absolute 子元素共同触发黑屏
     ════════════════════════════════════════════════════════════ */
  .w-brand {
    top: 18px;
    width: 100%;
    font-size: 28px;
    letter-spacing: 6px;
  }

  .w-bsub {
    top: 46px;
    width: 100%;
    font-size: 24px;
    letter-spacing: 3px;
  }

  /* 盘体整体放大 1.5：32 个盘内节点零改动，
     圆心/半径/刻度角/针长比例天然全部正确。
     transform-origin 默认 0 0（左上）→ left/top 即视觉左上，不用算中心补偿。
     横向 184*1.5=276，(336-276)/2=30；盘心 = (30+138, 78+138) = (168,216)。 */
  .w-dial {
    left: 30px;
    top: 78px;
    transform: scale(1.5);
  }

  .w-date {
    top: 362px;
    width: 100%;
    font-size: 24px;
  }

  /* 时间 52px 而非 56：盘底 354 到屏底 480 只有 126px 要装三行
     （日期 ink 22 + 时间 ink 40 + 返回 ink 19 = 81），56px 会把
     「轻触返回」压到 07:04 的下沿上（实测两组 ink 相连成 67px 一段）。 */
  .w-time {
    top: 388px;
    width: 100%;
    font-size: 52px;
  }

  /* top 446 + 提亮：原 #6f6650 在 24px 上对比度不足，几乎看不见 */
  .w-back {
    top: 446px;
    width: 100%;
    font-size: 24px;
    color: #9a8f72;
  }
</style>
