<!--
  EV 指针表盘（仿古青铜）
  ─────────────────────────────────────────────────────────────
  设计：184px 青铜三层同心环表壳 + 十二地支刻度 + 三针 + 数字时间/日期。

  走针方案（2026-10-19 标定后定稿，绕开引擎三大坑）：
  ① 不用 `transform: rotate({{deg}}deg)` 数据绑定 —— Vela 会整页黑屏；
  ② 不用 @keyframes 动画承载「当前时刻」—— 实测动画合成不可靠：
     指针角度与盘面时间对不上、周期性整根消失、画面长时间冻结；
  ③ 引擎的旋转轴实测为【元素顶部中点】，`transform-origin` 不按 CSS 语义生效
     （4 色标定针实测：top 对齐盘心的元素，rotate(90) 得到向左的水平线）。
     故三针一律「顶部中点压在盘心 + 向下延伸」，rotate(180+θ) 即指向 θ（0=12点）。
  ④ 角度用 60 档字面量类 `.r0…​.r59`（字面量 transform 安全），
     时钟只改 class 名（不是 transform 值），引擎走普通样式重算。

  布局铁律：`.page` 只给 width/height:100% + flex 列，绝不加
  justify-content / align-items（加了会与 absolute 子元素共同触发黑屏）。
-->

<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd" onclick="onTap">

    <!-- 顶部品牌 -->
    <text class="brand">EV</text>
    <text class="brand-sub">指针表盘</text>

    <!-- 表盘 -->
    <div class="dial-wrap">
      <!-- 青铜表壳：三层同心色阶造厚度（不用渐变） -->
      <div class="ring-outer"></div>
      <div class="ring-mid"></div>
      <div class="dial-face"></div>

      <!-- 12 短刻度（静态 rotate，literal transform，安全） -->
      <div class="tick" style="left:91px;top:7px;transform:rotate(0deg)"></div>
      <div class="tick" style="left:131px;top:18px;transform:rotate(30deg)"></div>
      <div class="tick" style="left:160px;top:47px;transform:rotate(60deg)"></div>
      <div class="tick" style="left:171px;top:87px;transform:rotate(90deg)"></div>
      <div class="tick" style="left:160px;top:127px;transform:rotate(120deg)"></div>
      <div class="tick" style="left:131px;top:156px;transform:rotate(150deg)"></div>
      <div class="tick" style="left:91px;top:167px;transform:rotate(180deg)"></div>
      <div class="tick" style="left:51px;top:156px;transform:rotate(210deg)"></div>
      <div class="tick" style="left:22px;top:127px;transform:rotate(240deg)"></div>
      <div class="tick" style="left:11px;top:87px;transform:rotate(270deg)"></div>
      <div class="tick" style="left:22px;top:47px;transform:rotate(300deg)"></div>
      <div class="tick" style="left:51px;top:18px;transform:rotate(330deg)"></div>

      <!-- 十二地支（子位 12 点，顺时针每 30°） -->
      <text class="gan" style="left:82px;top:18px">子</text>
      <text class="gan" style="left:114px;top:27px">丑</text>
      <text class="gan" style="left:137px;top:50px">寅</text>
      <text class="gan" style="left:146px;top:82px">卯</text>
      <text class="gan" style="left:137px;top:114px">辰</text>
      <text class="gan" style="left:114px;top:137px">巳</text>
      <text class="gan" style="left:82px;top:146px">午</text>
      <text class="gan" style="left:50px;top:137px">未</text>
      <text class="gan" style="left:27px;top:114px">申</text>
      <text class="gan" style="left:18px;top:82px">酉</text>
      <text class="gan" style="left:27px;top:50px">戌</text>
      <text class="gan" style="left:50px;top:27px">亥</text>

      <!-- 三针：顶部中点压在盘心 (92,92)，向下延伸，rotate(180+θ) 指向 θ -->
      <div class="hand hour {{hourCls}}"></div>
      <div class="hand minute {{minuteCls}}"></div>
      <div class="hand second {{secondCls}}"></div>

      <!-- 盘心 + 铭文 -->
      <div class="hub"></div>
      <text class="ev">EV</text>
    </div>

    <!-- 底部：日期 / 数字时间 / 返回提示 -->
    <text class="date-line">{{dateText}}</text>
    <text class="time-line">{{timeText}}</text>
    <text class="back">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const FULL_DAY = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

function pad2(n) {
  return (n < 10 ? "0" : "") + n
}

// 角度 → 60 档类名（6° 一档）。引擎轴在顶部中点，故 .rN 内部为 rotate(180 + 6N)
function stepClass(deg) {
  let step = Math.round(deg / 6) % 60
  if (step < 0) step += 60
  return "r" + step
}

export default {
  data: {
    hourCls: "r0",
    minuteCls: "r0",
    secondCls: "r0",
    timeText: "--:--",
    dateText: "",
    touchStartY: 0,
    suppressTap: false,
    timer: null
  },

  onInit() {
    this.syncHands()
    this.tick()
  },

  onReady() {
    this.startTimer()
  },

  onShow() {
    this.syncHands()
    this.tick()
    this.startTimer()
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  /* ── 走针：当前时刻 → 三针角度 → 60 档 class ── */
  syncHands() {
    const now = new Date()
    const h = now.getHours() % 12
    const m = now.getMinutes()
    const s = now.getSeconds()

    this.hourCls = stepClass((h + m / 60 + s / 3600) * 30)
    this.minuteCls = stepClass((m + s / 60) * 6)
    this.secondCls = stepClass(s * 6)
  },

  startTimer() {
    this.stopTimer()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tick() {
    const now = new Date()
    this.timeText = pad2(now.getHours()) + ":" + pad2(now.getMinutes())
    this.dateText = pad2(now.getMonth() + 1) + "-" + pad2(now.getDate()) + " " + FULL_DAY[now.getDay()]
    this.syncHands()
  },

  /* ── 上下滑动切表盘（Vela 无 onswipe，靠 Y 位移手算；阈值 40px）──
     目录环：金属字针表(gold) ← 上滑 ｜ 下滑 → 仿古金属表盘(metal) */
  onTouchStart(e) {
    const t = (e && e.touches && e.touches[0]) || e || {}
    this.touchStartY = t.clientY || t.offsetY || t.pageY || 0
  },

  onTouchEnd(e) {
    const t = (e && e.touches && e.touches[0]) || (e && e.changedTouches && e.changedTouches[0]) || e || {}
    const endY = t.clientY || t.offsetY || t.pageY || 0
    const d = this.touchStartY ? (this.touchStartY - endY) : 0
    if (d >= 40) {
      this.suppressTap = true
      router.replace({ uri: "/pages/watch-face-gold" })
    } else if (d <= -40) {
      this.suppressTap = true
      router.replace({ uri: "/pages/watch-face-metal" })
    }
    this.touchStartY = 0
  },

  /* ── 退出：单击任意位置返回目录（系列统一）── */
  onTap() {
    if (this.suppressTap) return
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

