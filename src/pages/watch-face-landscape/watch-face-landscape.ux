<template>
  <div class="page" onclick="onTap">
    <text class="brand">EV</text>
    <text class="sub">大字表盘</text>

    <div class="row r1">
      <text class="dg">{{ h0 }}</text>
      <text class="dg">{{ h1 }}</text>
    </div>

    <div class="row r2">
      <text class="dg">{{ m0 }}</text>
      <text class="dg">{{ m1 }}</text>
    </div>

    <text class="date">{{ dateText }}</text>
    <text class="hint">轻触返回</text>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"
const FULL_DAY = ["日", "一", "二", "三", "四", "五", "六"]

function pad2(n) {
  return n < 10 ? ("0" + n) : ("" + n)
}

export default {
  data: {
    h0: "0", h1: "0", m0: "0", m1: "0",
    dateText: ""
  },

  onInit() {
    this.shown = ["", "", "", ""]
    this.tick()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* 先对齐整秒再起 interval，避免跳秒与长跑漂移 */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.alignTimer = setTimeout(function() {
      self.alignTimer = undefined
      self.tick()
      self.timer = setInterval(function() {
        self.tick()
      }, 1000)
    }, 1000 - (new Date().getTime() % 1000))
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
    if (this.alignTimer) {
      clearTimeout(this.alignTimer)
      this.alignTimer = undefined
    }
  },

  tick() {
    const n = new Date()
    const hh = pad2(n.getHours())
    const mm = pad2(n.getMinutes())
    const v = [hh[0], hh[1], mm[0], mm[1]]
    /* 脏检查：分钟没变时一位都不写 */
    for (let i = 0; i < 4; i++) {
      if (v[i] === this.shown[i]) continue
      this.shown[i] = v[i]
      this.setDigit(i, v[i])
    }
    const dt = pad2(n.getMonth() + 1) + "-" + pad2(n.getDate()) + " 周" + FULL_DAY[n.getDay()]
    if (dt !== this.dateText) this.dateText = dt
  },

  /* 显式分支：动态属性名不保证被 Vela 观测 */
  setDigit(i, c) {
    if (i === 0) this.h0 = c
    else if (i === 1) this.h1 = c
    else if (i === 2) this.m0 = c
    else this.m1 = c
  },

  onTap() {
    this.stop()
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
  }

  .brand {
    position: absolute;
    left: 0;
    top: 40px;
    width: 192px;
    text-align: center;
    font-size: 22px;
    letter-spacing: 3px;
    color: #d8dde8;
  }

  .sub {
    position: absolute;
    left: 0;
    top: 68px;
    width: 192px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 2px;
    color: #5a6274;
  }

  /* 两行超大字：每行 2 位 × 90 = 180，居中 */
  .row {
    position: absolute;
    left: 0;
    width: 192px;
    height: 150px;
    flex-direction: row;
    justify-content: center;
  }

  .r1 { top: 120px; }
  .r2 { top: 262px; }

  .dg {
    width: 90px;
    height: 150px;
    font-size: 150px;
    font-weight: bold;
    line-height: 150px;
    text-align: center;
    color: #e8e4da;
  }

  .date {
    position: absolute;
    left: 0;
    top: 424px;
    width: 192px;
    text-align: center;
    font-size: 14px;
    letter-spacing: 1px;
    color: #6f7688;
  }

  .hint {
    position: absolute;
    left: 0;
    top: 450px;
    width: 192px;
    text-align: center;
    font-size: 11px;
    color: #3f4655;
  }
</style>
