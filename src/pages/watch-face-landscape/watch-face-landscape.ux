<template>
  <!-- 横屏表盘 ①：整体右转 90°，时间一行显示、字号最大；无按钮（点击整屏返回）。
       · transform-origin 必须显式设中心(px)，否则快应用默认绕左上角转=黑。
       · 冒号做跳动。 -->
  <div class="page" onclick="onTap">
    <div class="rot">
      <div class="line">
        <text class="d">{{ hh }}</text>
        <text class="colon">:</text>
        <text class="d">{{ mm }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

const LIST_PAGE = "/pages/watch-face-list"

export default {
  data: {
    hh: "--",
    mm: "--"
  },

  onInit() {
    this.tick()
  },

  onReady() {
    this.refresh()
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.timer = setInterval(function() {
      self.tick()
    }, 1000)
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
  },

  tick() {
    const n = new Date()
    const h = this.pad(n.getHours())
    const m = this.pad(n.getMinutes())
    if (h !== this.hh) this.hh = h
    if (m !== this.mm) this.mm = m
  },

  pad(n) {
    return n < 10 ? "0" + n : "" + n
  },

  /* 无可见按钮：点击整屏返回 */
  onTap() {
    router.replace({ uri: LIST_PAGE })
  },

  goBack() {
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
  }

  /* 绝对定位铺满 + 内部居中 + 字面量旋转；origin 必须显式设为中心(px) */
  .rot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transform: rotate(90deg);
    transform-origin: 96px 245px;
  }

  .line {
    flex-direction: row;
    align-items: center;
  }

  /* 字号最大化（192×490 旋转后，受屏宽 192 限制，约 150px 已是上限附近） */
  .d {
    font-size: 150px;
    font-weight: bold;
    color: #e8e4da;
  }

  .colon {
    font-size: 150px;
    font-weight: bold;
    color: #e8e4da;
    margin: 0 6px;
    animation-name: kf-blink;
    animation-duration: 1s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes kf-blink {
    0%   { opacity: 1; }
    50%  { opacity: 0; }
    100% { opacity: 1; }
  }
</style>
