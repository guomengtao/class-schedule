<template>
  <div class="page" onclick="onTap">
    <!-- ===== 192×490（手环 9）：原绝对定位版，一个像素都不改 ===== -->
    <text if="{{ !wide }}" class="brand">EV</text>
    <text if="{{ !wide }}" class="sub">大字表盘</text>

    <div if="{{ !wide }}" class="row r1">
      <text class="dg">{{ h0 }}</text>
      <text class="dg">{{ h1 }}</text>
    </div>

    <div if="{{ !wide }}" class="row r2">
      <text class="dg">{{ m0 }}</text>
      <text class="dg">{{ m1 }}</text>
    </div>

    <text if="{{ !wide }}" class="date">{{ dateText }}</text>
    <text if="{{ !wide }}" class="hint">轻触返回</text>

    <!-- ===== 宽屏（10Pro 336×480 起）：4 位数字并成一行吃满宽度 + 整体垂直居中 =====
         192 屏两行数字受「屏高」限制（490 高只能放两行 150px），再放大就溢出；
         而 336 屏是「宽而矮」（480 高），继续两行 = 左右各留 72px 空白、纵向还挤。
         故宽屏把「时分」并成一行：4×81 + 12 间距 = 336 满宽，主数字 146px 不受高度限制。
         时与分之间只用 12px 空隙区分（ev-six 第 5 条：分隔靠排版，不靠符号）。 -->
    <div if="{{ wide }}" class="wrap">
      <text class="w-brand">EV</text>
      <text class="w-sub">大字表盘</text>
      <div class="w-row">
        <text class="w-dg">{{ h0 }}</text>
        <text class="w-dg">{{ h1 }}</text>
        <div class="w-gap"></div>
        <text class="w-dg">{{ m0 }}</text>
        <text class="w-dg">{{ m1 }}</text>
      </div>
      <text class="w-date">{{ dateText }}</text>
      <text class="w-hint">轻触返回</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"

const LIST_PAGE = "/pages/watch-face-list"
const FULL_DAY = ["日", "一", "二", "三", "四", "五", "六"]

function pad2(n) {
  return n < 10 ? ("0" + n) : ("" + n)
}

export default {
  data: {
    h0: "0", h1: "0", m0: "0", m1: "0",
    dateText: "",
    wide: false
  },

  onInit() {
    this.shown = ["", "", "", ""]
    this.fitScreen()
    this.tick()
  },

  /* 屏宽 ≥300 → 宽屏版式（10Pro 336 起）。读不到就按 192 基准渲染，绝不白屏。 */
  fitScreen() {
    const self = this
    device.getInfo({
      success: function(d) {
        if (d && d.screenWidth >= 300) self.wide = true
      },
      fail: function() {}
    })
  },

  onShow() {
    this.refresh()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  /* 先对齐整秒再起 interval，避免跳秒与长跑漂移 */
  refresh() {
    this.stop()
    this.tick()
    const self = this
    this.alignTimer = setTimeout(function() {
      self.alignTimer = undefined
      self.tick()
      self.timer = setInterval(function() {
        self.tick()
      }, 1000)
    }, 1000 - (new Date().getTime() % 1000))
  },

  stop() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = undefined
    }
    if (this.alignTimer) {
      clearTimeout(this.alignTimer)
      this.alignTimer = undefined
    }
  },

  tick() {
    const n = new Date()
    const hh = pad2(n.getHours())
    const mm = pad2(n.getMinutes())
    const v = [hh[0], hh[1], mm[0], mm[1]]
    /* 脏检查：分钟没变时一位都不写 */
    for (let i = 0; i < 4; i++) {
      if (v[i] === this.shown[i]) continue
      this.shown[i] = v[i]
      this.setDigit(i, v[i])
    }
    const dt = pad2(n.getMonth() + 1) + "-" + pad2(n.getDate()) + " 周" + FULL_DAY[n.getDay()]
    if (dt !== this.dateText) this.dateText = dt
  },

  /* 显式分支：动态属性名不保证被 Vela 观测 */
  setDigit(i, c) {
    if (i === 0) this.h0 = c
    else if (i === 1) this.h1 = c
    else if (i === 2) this.m0 = c
    else this.m1 = c
  },

  onTap() {
    this.stop()
    router.replace({ uri: LIST_PAGE })
  }
}
</script>

<style>
  .page {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
  }

  .brand {
    position: absolute;
    left: 0;
    top: 40px;
    width: 192px;
    text-align: center;
    font-size: 22px;
    letter-spacing: 3px;
    color: #d8dde8;
  }

  .sub {
    position: absolute;
    left: 0;
    top: 68px;
    width: 192px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 2px;
    color: #5a6274;
  }

  /* 两行超大字：每行 2 位 × 90 = 180，居中 */
  .row {
    position: absolute;
    left: 0;
    width: 192px;
    height: 150px;
    flex-direction: row;
    justify-content: center;
  }

  .r1 { top: 120px; }
  .r2 { top: 262px; }

  .dg {
    width: 90px;
    height: 150px;
    font-size: 150px;
    font-weight: bold;
    line-height: 150px;
    text-align: center;
    color: #e8e4da;
  }

  .date {
    position: absolute;
    left: 0;
    top: 424px;
    width: 192px;
    text-align: center;
    font-size: 14px;
    letter-spacing: 1px;
    color: #6f7688;
  }

  .hint {
    position: absolute;
    left: 0;
    top: 450px;
    width: 192px;
    text-align: center;
    font-size: 11px;
    color: #3f4655;
  }

  /* ===== 宽屏（10Pro 336×480 起）版式 =====
     ev-six 约束：可读文字只用 24/28/30/44 四档，24 为绝对下限。
     192 版里的 22/14/11px 在宽屏一律抬到 24 档（11px 在手环上≈显示器 3px 脚注，等于没有）。
     主数字 146px 属「表盘图形本体」，不套四档——套 44 档就不是表盘了。 */
  .wrap {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .w-brand {
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 6px;
    color: #d8dde8;
  }

  .w-sub {
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 2px;
    margin-top: 2px;
    color: #8a93a8;
  }

  .w-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 20px;
    margin-bottom: 14px;
  }

  /* 位宽不写死：数字字形宽度随字号变化，写死 81px 会让 146px 的「1」「0」溢到框外被裁。
     不设 width = 由字形撑开，行容器居中。
     字号 126 按**最坏字宽**反算（「8/0」宽约 0.6F）：4×0.6×126 + 14 = 316 ≤ 320 安全区，
     实测 148 时遇到宽字形会把两端数字裁掉，故不取更满的值。 */
  .w-dg {
    height: 168px;
    font-size: 126px;
    font-weight: bold;
    line-height: 168px;
    text-align: center;
    color: #e8e4da;
  }

  .w-gap {
    width: 14px;
    height: 168px;
  }

  .w-date {
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 1px;
    color: #8a93a8;
  }

  .w-hint {
    font-size: 24px;
    line-height: 32px;
    margin-top: 4px;
    color: #6f7688;
  }
</style>
