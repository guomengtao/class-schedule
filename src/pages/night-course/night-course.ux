<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- ev-six 规则①②③：公共头部骨架，返回 30 + 居中标题 28 + 等宽占位 30，
         不放其他按钮；颜色一律走 theme 变量，不在页面里硬编码 hex。 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">晚课</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="body-scroll" scroll-y="{{ true }}">
      <!-- 开关卡：一行 ≤6P，标题 28px、摘要 24px 分两行，不靠压字号塞进一行 -->
      <div class="card" style="background-color: {{ theme.card }}">
        <div class="switch-row" onclick="toggleEnabled">
          <text class="switch-title" style="color: {{ theme.text }}">启用晚课</text>
          <div class="switch-pill" style="background-color: {{ enabled ? theme.accent : theme.btnSecondary }}">
            <div class="switch-knob" style="left: {{ enabled ? 32 : 3 }}px"></div>
          </div>
        </div>
        <text class="card-sub" style="color: {{ theme.textSecondary }}">{{ summary }}</text>
      </div>

      <!-- 轮换周期：不设死 6 周，1..12 任意加减。cells 行数由 setCycle 自动跟随。 -->
      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">轮换周期</text>
        <div class="step-row">
          <div class="step-btn" style="background-color: {{ theme.btnSecondary }}" onclick="cycleMinus">
            <text class="step-btn-text" style="color: {{ theme.text }}">减</text>
          </div>
          <text class="step-value" style="color: {{ theme.accent }}">{{ cycle }} 周</text>
          <div class="step-btn" style="background-color: {{ theme.btnSecondary }}" onclick="cyclePlus">
            <text class="step-btn-text" style="color: {{ theme.text }}">加</text>
          </div>
        </div>
        <text class="step-hint" style="color: {{ theme.textMuted }}">{{ cycleHint }}</text>
      </div>

      <!-- 本周是第几周：写「本周一 = 第 N 周」锚点，之后按日期自动推进、按周期回卷。
           不是存一个静态数字，所以下周一自动变，导出到别的设备也对。 -->
      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">本周是第几周</text>
        <div class="step-row">
          <div class="step-btn" style="background-color: {{ theme.btnSecondary }}" onclick="weekMinus">
            <text class="step-btn-text" style="color: {{ theme.text }}">减</text>
          </div>
          <text class="step-value" style="color: {{ theme.accent }}">第 {{ curWeek }} 周</text>
          <div class="step-btn" style="background-color: {{ theme.btnSecondary }}" onclick="weekPlus">
            <text class="step-btn-text" style="color: {{ theme.text }}">加</text>
          </div>
        </div>
        <text class="step-hint" style="color: {{ theme.textSecondary }}">{{ weekHint }}</text>
        <text class="step-hint" style="color: {{ theme.textMuted }}">每周一自动推进 到末尾回到第 1 周</text>
      </div>

      <!-- 时段 / 周末显隐 -->
      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.text }}">上课时段</text>
        <picker class="time-picker" type="text" range="{{ timeOpts }}" selected="{{ timeIdx }}"
                onchange="onTimeChange" style="color: {{ theme.text }}; background-color: {{ theme.keyBg }}"></picker>
        <div class="weekend-row" onclick="toggleWeekend">
          <text class="weekend-text" style="color: {{ theme.textSecondary }}">周末</text>
          <text class="weekend-state" style="color: {{ showWeekend ? theme.accent : theme.textMuted }}">{{ showWeekend ? '显示' : '隐藏' }}</text>
        </div>
      </div>

      <!-- 长列表：每周一段，默认只铺周一到周五（与《晚课课表》照片一致）。
           可点性靠 cardLight 亮底表达，不再用箭头符号。 -->
      <div for="{{ rows }}" class="row-wrap">
        <text if="{{ $item.type === 'week' }}" class="week-title"
              style="color: {{ $item.isCurrent ? theme.accent : theme.textSecondary }}">{{ $item.label }}</text>
        <div if="{{ $item.type === 'cell' }}" class="cell" style="background-color: {{ theme.cardLight }}"
             onclick="editCell($item)">
          <text class="cell-day" style="color: {{ $item.isToday ? theme.accent : theme.textSecondary }}">{{ $item.dayLabel }}</text>
          <text class="cell-name" style="color: {{ $item.name ? theme.text : theme.textMuted }}">{{ $item.name ? $item.name : '未设置' }}</text>
        </div>
      </div>

      <text class="tips" style="color: {{ theme.textMuted }}">第 {{ sidLabel }} 套课表 每周一自动推进</text>
      <div class="bottom-gap"></div>
    </scroll>

    <!-- ev-six 第 13 条：禁用系统 toast 浮层（会压住内容），
         全部提示走这条固定 52px 的页内条，只换文案不换高度。 -->
    <div class="tip-bar" style="display: {{ tipVisible ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
      <text class="tip-msg" style="color: {{ theme.text }}">{{ tipText }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

var rotation = require("../../data/rotation")
var database = require("../../data/database")
var store = require("../../data/store.js")

var RESULT_KEY = "night_cell_result"
var PENDING_KEY = "night_cell_pending"
var SID_KEY = "night_course_sid"

function fallbackSid() {
  var idx = 0
  try {
    idx = database.getScheduleIndex()
  } catch (e) {
    idx = 0
  }
  return (idx == null || idx < 0) ? 0 : idx
}

function startPage(comp, idx) {
  if (idx == null || idx < 0) idx = 0
  comp.sid = idx
  comp.sidLabel = idx + 1
  rotation.prime(idx, function (tpl) {
    comp.tpl = tpl || rotation.normalize({ enabled: false })
    comp.refresh()
  })
}

var TIME_OPTS = [
  "16:30 - 17:20",
  "17:00 - 17:50",
  "17:10 - 18:00",
  "17:30 - 18:20",
  "18:00 - 18:50",
  "18:30 - 19:20",
  "19:00 - 19:50"
]

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    },
    enabled: false,
    cycle: 6,
    curWeek: 1,
    cycleHint: "",
    weekHint: "",
    timeOpts: TIME_OPTS,
    timeIdx: 2,
    summary: "未设置",
    rows: [],
    sid: 0,
    sidLabel: 1,
    showWeekend: false,
    tipVisible: false,
    tipText: "",
    busy: false
  },

  tpl: null,
  tipTimer: null,
  confirmTimer: null,
  pendingCycle: null,

  onInit() {
    var self = this
    store.getTheme(function (t, name) {
      self.theme = t
      self.iconTheme = (name && String(name).indexOf("light") >= 0) ? "light" : "dark"
    })
    // 从「课表管理」某套课表进来时指定套号。读完立刻删掉：
    // 旧实现留着全局单值，下次从别处进入会误用上次的 sid，
    // 用户以为在改 A 套，实际写进 B 套。
    storage.get({
      key: SID_KEY,
      success: function (v) {
        var idx = -1
        if (v != null && String(v).length > 0) idx = parseInt(v, 10)
        if (!(idx >= 0)) idx = fallbackSid()
        try { storage.delete({ key: SID_KEY, fail: function () {} }) } catch (e) {}
        startPage(self, idx)
      },
      fail: function () {
        startPage(self, fallbackSid())
      }
    })
  },

  onShow() {
    // 从中文输入页回来：先看 pending 标记，再用 undefined/null 判断「没有结果」。
    // 不能写 if (!val) return：用户清空输入确认回填空串，那是删掉这格晚课的合法操作。
    var self = this
    storage.get({
      key: PENDING_KEY,
      success: function (pos) {
        if (!pos) return
        storage.get({
          key: RESULT_KEY,
          success: function (val) {
            if (val === undefined || val === null) return
            var parts = String(pos).split("_")
            var w = parseInt(parts[0], 10) || 0
            var d = parseInt(parts[1], 10) || 0
            if (!self.tpl) self.tpl = rotation.normalize({})
            rotation.setCell(self.tpl, w, d, val)
            // 旧实现在 save 调用后立刻删结果键，写盘失败时输入结果已丢且无法重试。
            // 改成只在写盘成功的回调里清。
            rotation.save(self.sid, self.tpl, function (err) {
              if (err) {
                self.showTip("保存失败 请重试")
                return
              }
              try {
                storage.delete({ key: RESULT_KEY })
                storage.delete({ key: PENDING_KEY })
              } catch (e) {}
              self.refresh()
            })
          }
        })
      }
    })
  },

  onDestroy() {
    this.clearTipTimer()
    this.clearConfirmTimer()
  },

  goBack() {
    router.back()
  },

  showTip(msg) {
    var self = this
    this.tipText = msg
    this.tipVisible = true
    this.clearTipTimer()
    this.tipTimer = setTimeout(function () {
      self.tipVisible = false
    }, 2600)
  },

  clearTipTimer() {
    if (this.tipTimer) {
      clearTimeout(this.tipTimer)
      this.tipTimer = null
    }
  },

  clearConfirmTimer() {
    if (this.confirmTimer) {
      clearTimeout(this.confirmTimer)
      this.confirmTimer = null
    }
    this.pendingCycle = null
  },

  toggleEnabled() {
    if (!this.tpl || this.busy) return
    this.tpl.enabled = !this.tpl.enabled
    if (this.tpl.enabled && rotation.isEmpty(this.tpl)) {
      this.showTip("点下面任意一行填写晚课")
    }
    this.persist()
  },

  cycleMinus() {
    this.changeCycle(-1)
  },

  cyclePlus() {
    this.changeCycle(1)
  },

  /**
   * 加减周数。减周会裁掉末尾一周的格子，属于不可逆操作：
   * 末尾一周有内容时先拦一次，3 秒内再点同一次才执行（页内 tip 二次确认，
   * 不用系统弹窗，也不额外压字号）。
   */
  changeCycle(delta) {
    if (!this.tpl || this.busy) return
    var want = this.tpl.cycle + delta
    if (want < 1 || want > rotation.MAX_CYCLE) {
      this.showTip(want < 1 ? "最少 1 周" : "最多 " + rotation.MAX_CYCLE + " 周")
      return
    }
    if (delta < 0 && rotation.weekFilled(this.tpl, want) > 0) {
      if (this.pendingCycle !== want) {
        this.pendingCycle = want
        this.clearConfirmTimerHint()
        var self = this
        this.confirmTimer = setTimeout(function () {
          self.pendingCycle = null
          self.confirmTimer = null
        }, 3000)
        this.showTip("最后一周有课 再点一次减")
        return
      }
      this.clearConfirmTimer()
    } else {
      this.clearConfirmTimer()
    }
    rotation.setCycle(this.tpl, want)
    this.persist()
  },

  clearConfirmTimerHint() {
    if (this.confirmTimer) {
      clearTimeout(this.confirmTimer)
      this.confirmTimer = null
    }
  },

  /** 本周第几周：在 1..cycle 内循环，写入周一周次锚点 */
  weekMinus() {
    this.changeWeek(-1)
  },

  weekPlus() {
    this.changeWeek(1)
  },

  changeWeek(delta) {
    if (!this.tpl || this.busy) return
    var c = this.tpl.cycle
    var cur = rotation.currentWeek(this.tpl)
    var want = ((cur - 1 + delta) % c + c) % c + 1
    rotation.setCurrentWeek(this.tpl, want)
    this.persist()
  },

  onTimeChange(e) {
    if (!this.tpl || this.busy) return
    var i = e.newSelected
    if (i == null || i < 0 || i >= this.timeOpts.length) return
    this.timeIdx = i
    this.tpl.time = this.timeOpts[i]
    this.persist()
  },

  toggleWeekend() {
    this.showWeekend = !this.showWeekend
    this.refresh()
  },

  editCell(item) {
    if (!item || this.busy) return
    var self = this
    var w = item.w
    var d = item.d
    var name = rotation.cellOf(self.tpl, w, d)
    var title = "第 " + (w + 1) + " 周 " + rotation.DAY_SHORT[d]
    storage.set({ key: "chinese_input_title", value: title, success: function () {} })
    storage.set({ key: "chinese_input_placeholder", value: "输入课程名", success: function () {} })
    storage.set({ key: "chinese_input_value", value: name, success: function () {} })
    storage.set({ key: "chinese_input_maxlen", value: "8", success: function () {} })
    storage.set({ key: "chinese_input_return_key", value: RESULT_KEY, success: function () {} })
    storage.set({ key: PENDING_KEY, value: w + "_" + d, success: function () {} })
    router.push({ uri: "/pages/chinese-input" })
  },

  persist() {
    var self = this
    if (!self.tpl || self.busy) return
    self.busy = true
    rotation.save(self.sid, self.tpl, function (err) {
      self.busy = false
      if (err) {
        self.showTip("保存失败 请重试")
        return
      }
      self.refresh()
    })
  },

  refresh() {
    var tpl = this.tpl || rotation.normalize({})
    this.tpl = tpl
    this.enabled = !!tpl.enabled
    // 不用 rotation.summary()：它带装饰分隔符，违反 ev-six 禁用符号。
    this.summary = (tpl.enabled ? "已启用" : "未启用") + " 已填 " + rotation.filledCount(tpl) + " 格"

    var info = rotation.weekInfo(tpl)
    this.cycle = info.cycle
    this.curWeek = info.current
    this.cycleHint = info.cycle === 1
      ? "不轮换 可直接填进课程表"
      : "加几周多一套 减周删末尾"
    this.weekHint = info.anchored
      ? ("本周第 " + info.current + " 周 下周第 " + info.next + " 周")
      : "选一次本周周次 之后自动跟着走"

    var opts = TIME_OPTS.slice(0)
    var ti = opts.indexOf(tpl.time)
    if (ti < 0) {
      opts.unshift(tpl.time)
      ti = 0
    }
    this.timeOpts = opts
    this.timeIdx = ti

    // 用 rotation.listView() 作数据源（旧页面自己重拼 rows，与数据层口径分叉），
    // 再展平成单层数组，避开快应用嵌套 for 的 $item 歧义。
    var groups = rotation.listView(tpl)
    var days = this.showWeekend ? 7 : 5
    var rows = []
    for (var w = 0; w < groups.length; w++) {
      var g = groups[w]
      rows.push({
        type: "week",
        label: g.weekLabel + (g.isCurrent ? " 本周" : ""),
        isCurrent: g.isCurrent
      })
      for (var d = 0; d < days && d < g.items.length; d++) {
        var it = g.items[d]
        rows.push({
          type: "cell",
          w: g.week,
          d: it.day,
          dayLabel: it.dayLabel,
          name: it.name,
          isToday: it.isToday
        })
      }
    }
    this.rows = rows
  }
}
</script>

<style>
@import '../../common/header.css';

/* 基准 = 胶囊屏 192×490。字号只取 24 / 28 / 30 三档，24px 是绝对下限；
   @media 只负责在大屏放大，禁止靠压字号把内容塞进一屏。 */
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 0;
}

.body-scroll {
  flex: 1;
  flex-direction: column;
  padding: 0 12px;
}

.card {
  flex-direction: column;
  border-radius: 12px;
  padding: 8px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.switch-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.switch-title {
  font-size: 28px;
  line-height: 34px;
  lines: 1;
}

.switch-pill {
  width: 60px;
  height: 30px;
  border-radius: 15px;
  justify-content: center;
  flex-shrink: 0;
}

.switch-knob {
  position: absolute;
  top: 3px;
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: #ffffff;
}

.card-sub {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  margin-top: 4px;
}

.card-title {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  margin-bottom: 4px;
}

/* 步进器：中文「减 / 加」功能文字，不用 − + 装饰符号；
   可点性靠 btnSecondary 亮底，文字只三档字号。 */
.step-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.step-btn {
  width: 56px;
  height: 36px;
  border-radius: 8px;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-btn-text {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}

.step-value {
  flex: 1;
  font-size: 28px;
  line-height: 34px;
  lines: 1;
  text-align: center;
}

.step-hint {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  margin-top: 4px;
}

.time-picker {
  width: 100%;
  height: 36px;
  border-radius: 8px;
  font-size: 24px;
  text-align: center;
}

.weekend-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
}

.weekend-text,
.weekend-state {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}

.row-wrap {
  flex-direction: column;
}

.week-title {
  font-size: 28px;
  line-height: 34px;
  lines: 1;
  font-weight: bold;
  margin-top: 6px;
  margin-bottom: 4px;
}

.cell {
  height: 40px;
  margin-bottom: 4px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 8px;
  flex-direction: row;
  align-items: center;
}

.cell-day {
  width: 64px;
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  flex-shrink: 0;
}

.cell-name {
  flex: 1;
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}

.tips {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  margin-top: 8px;
}

.bottom-gap {
  height: 16px;
}

.tip-bar {
  height: 52px;
  flex-direction: row;
  align-items: center;
  padding: 0 12px;
  flex-shrink: 0;
}

.tip-msg {
  flex: 1;
  font-size: 24px;
  line-height: 30px;
  lines: 1;
}

/* 方屏 / 圆屏放大 */
@media (shape: rect) {
  .card { padding: 10px; margin-bottom: 10px; }
  .switch-title { font-size: 30px; line-height: 38px; }
  .step-value { font-size: 30px; line-height: 38px; }
  .week-title { font-size: 30px; line-height: 38px; }
  .step-btn { width: 64px; height: 42px; }
  .cell { height: 46px; }
  .cell-day { width: 76px; }
}

@media (shape: circle) {
  .body-scroll { padding: 0 16px; }
  .card { padding: 10px; }
  .switch-title { font-size: 30px; line-height: 38px; }
  .step-value { font-size: 30px; line-height: 38px; }
  .week-title { font-size: 30px; line-height: 38px; }
  .step-btn { width: 64px; height: 42px; }
  .cell { height: 46px; }
  .cell-day { width: 76px; }
}
</style>
