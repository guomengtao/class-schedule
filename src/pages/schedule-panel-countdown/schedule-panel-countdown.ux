<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <!-- 条件渲染一律 display 绑定（事故案例 11：多兄弟节点 if 会整页白屏） -->
      <div class="back-btn-wrapper" style="display: {{ isRoot ? 'none' : 'flex' }}; background-color: {{ theme.card }}" onclick="goBack">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">倒数</text>
      <div class="header-placeholder" style="display: {{ isRoot ? 'none' : 'flex' }}"></div>
    </div>

    <div class="loading-area" style="display: {{ isLoading ? 'flex' : 'none' }}">
      <text class="loading-text" style="color: {{ theme.textSecondary }}">加载中</text>
    </div>

    <div class="center-area" style="display: {{ isLoading ? 'none' : 'flex' }}">
      <text class="empty-text" style="display: {{ nextClass ? 'none' : 'flex' }}; color: {{ theme.textSecondary }}">{{ emptyMessage }}</text>

      <!-- A 课名 / B 大数字 + 单位 / C 语义行 / D 日期 / E 开始时刻 / F 地点 -->
      <div class="card" style="display: {{ nextClass ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
        <text class="c-name" style="color: {{ theme.text }}">{{ nameText }}</text>
        <div class="num-row">
          <text class="c-num" style="color: {{ theme.accent }}">{{ displayTime }}</text>
          <text class="c-unit" style="color: {{ theme.textSecondary }}">{{ unitText }}</text>
        </div>
        <text class="c-label" style="color: {{ theme.textSecondary }}">{{ countdownLabel }}</text>
        <text class="c-day" style="display: {{ dayPrefix ? 'flex' : 'none' }}; color: {{ theme.textSecondary }}">{{ dayPrefix }}</text>
        <text class="c-time" style="color: {{ theme.textSecondary }}">{{ startLabel }}</text>
        <text class="c-loc" style="display: {{ locText ? 'flex' : 'none' }}; color: {{ theme.textSecondary }}">{{ locText }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")
const utils = require("../../data/utils.js")
const builtinSchedule = require("../../data/schedule.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

// "08:00 - 09:35" 解析成 {startMin, endMin}；格式不合规返回 null（脏数据不参与计算）
function parseTimeRange(timeStr) {
  if (!timeStr) return null
  var parts = timeStr.split(" - ")
  if (parts.length !== 2) return null
  var s1 = parts[0].trim().split(":")
  var s2 = parts[1].trim().split(":")
  if (s1.length !== 2 || s2.length !== 2) return null
  var a = parseInt(s1[0]) * 60 + parseInt(s1[1])
  var b = parseInt(s2[0]) * 60 + parseInt(s2[1])
  if (isNaN(a) || isNaN(b) || b <= a) return null
  return { startMin: a, endMin: b }
}

// "08:00 - 09:35" 只取开始时刻，拼成 "08:00 起"（完整区间 13 字符 @24 约 160px，超卡片内宽 152px）
function startLabelOf(timeStr) {
  if (!timeStr) return ""
  var i = timeStr.indexOf(" - ")
  var s = (i < 0 ? timeStr : timeStr.substring(0, i)).trim()
  return s ? s + " 起" : ""
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    isLoading: true,
    nextClass: null,
    nameText: "",
    displayTime: "",
    unitText: "",
    countdownLabel: "",
    dayPrefix: "",
    startLabel: "",
    locText: "",
    emptyMessage: "",
    schedule: [],
    tickTimer: null,
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    // 独立首页 root 判定：由「更多首页」push 带 fromPanel='1'；无参数即冷启动为首页
    self.fromPanel = (self.fromPanel === '1') ? '1' : ''
    self.isRoot = self.fromPanel !== '1'
    // 首帧同步出内容：storage 回调慢/丢也不许停在「加载中」
    self.apply((builtinSchedule && builtinSchedule.schedule) ? builtinSchedule.schedule : [])
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
      self.loadData()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    // 回前台立即重算（后台期间可能已换课），再续排下一次整分
    if (!self.isLoading) self.tick()
  },

  onHide() {
    this.clearTickTimer()
  },

  /* 分钟级刷新：只挂一个对齐「下一个整分」的 setTimeout（方案 §0 禁秒级轮询） */
  scheduleNextMinute: function() {
    var self = this
    this.clearTickTimer()
    var now = new Date()
    var ms = 60000 - (now.getSeconds() * 1000)
    if (ms < 1000) ms = 1000
    this.tickTimer = setTimeout(function() { self.tick() }, ms)
  },

  clearTickTimer: function() {
    if (this.tickTimer) { clearTimeout(this.tickTimer); this.tickTimer = null }
  },

  apply: function(schedule) {
    this.schedule = schedule || []
    this.isLoading = false
    this.tick()
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.apply(schedule || [])
      })
    })
  },

  classesOf: function(dayName) {
    var schedule = this.schedule || []
    for (var i = 0; i < schedule.length; i++) {
      if (schedule[i].day === dayName) return schedule[i].classes || []
    }
    return []
  },

  tick: function() {
    try {
      this.compute()
    } catch (e) {
      // 计算异常不许把页面钉在旧状态：退回空态，用户至少看得懂
      this.nextClass = null
      this.emptyMessage = "数据异常"
      console.error("[countdown] compute failed: " + e)
    }
    this.scheduleNextMinute()
  },

  fill: function(cls, num, unit, label, day) {
    this.nextClass = cls
    this.nameText = cls.name || "未命名"
    this.displayTime = num
    this.unitText = unit
    this.countdownLabel = label
    this.dayPrefix = day || ""
    this.startLabel = startLabelOf(cls.time)
    this.locText = cls.location || ""
  },

  compute: function() {
    var self = this
    var now = new Date()
    var nowMin = now.getHours() * 60 + now.getMinutes()
    var todayIdx = now.getDay()
    var todayClasses = self.classesOf(DAY_NAMES[todayIdx])

    self.nextClass = null
    self.nameText = ""
    self.displayTime = ""
    self.unitText = ""
    self.countdownLabel = ""
    self.dayPrefix = ""
    self.startLabel = ""
    self.locText = ""

    // ① 上课中：大数字 = 距下课分钟
    for (var i = 0; i < todayClasses.length; i++) {
      var r = parseTimeRange(todayClasses[i].time)
      if (r && nowMin >= r.startMin && nowMin < r.endMin) {
        self.fill(todayClasses[i], String(r.endMin - nowMin), "分", "距下课")
        return
      }
    }

    // ② 今天下一节未开始：大数字 = 距上课分钟（≥100 压成 99+，避免 4 位数溢出）
    var best = null
    var bestStart = 0
    for (var j = 0; j < todayClasses.length; j++) {
      var rr = parseTimeRange(todayClasses[j].time)
      if (rr && rr.startMin > nowMin && (!best || rr.startMin < bestStart)) {
        best = todayClasses[j]
        bestStart = rr.startMin
      }
    }
    if (best) {
      var wait = bestStart - nowMin
      self.fill(best, wait > 99 ? "99+" : String(wait), "分", "距上课")
      return
    }

    // ③ 今天已结束：往后找最近有课的一天，改用小时级（跨周末也成立）
    for (var d = 1; d <= 7; d++) {
      var idx = (todayIdx + d) % 7
      var cs = self.classesOf(DAY_NAMES[idx])
      var first = null
      var firstStart = 0
      for (var k = 0; k < cs.length; k++) {
        var r3 = parseTimeRange(cs[k].time)
        if (r3 && (!first || r3.startMin < firstStart)) { first = cs[k]; firstStart = r3.startMin }
      }
      if (first) {
        var hrs = Math.floor((firstStart + d * 1440 - nowMin) / 60)
        self.fill(first, hrs > 99 ? "99+" : String(hrs), "小时", "距上课", d === 1 ? "明天" : DAY_NAMES[idx])
        return
      }
    }

    self.emptyMessage = "暂无课程"
  },

  goBack() {
    // 双模返回：被「更多首页」push（fromPanel）则回父页；作为 root 首页则回「更多首页」
    if (this.fromPanel === '1') {
      router.back()
    } else {
      // 面板被当独立首页（root）时无可退返回栈，直接回「更多首页」
      router.push({ uri: '/pages/schedule-panel' })
    }
  },

  onBackPress() {
    // 硬件返回键：push 态交还系统默认返回（回更多首页）；root 态退出（与默认首页 index 一致）
    if (this.fromPanel === '1') return false
    return utils.exitApp() === true
  },

  onDestroy() {
    this.clearTickTimer()
  }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100%; padding: 44px 12px 12px 12px }

.back-header { flex-direction: row; align-items: center; margin-bottom: 8px }
.back-btn-wrapper { width: 30px; height: 30px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 22px; height: 22px }
/* 标题可用宽 108 = 192 − 12×2 − 30 − 30；28px 只放得下 2 字（3 字 112px 会啃掉边） */
.header-title { flex: 1; font-size: 28px; font-weight: bold; text-align: center; line-height: 36px; lines: 1 }
.header-placeholder { width: 30px; height: 30px; flex-shrink: 0 }

.loading-area { align-items: center; padding: 30px 0 }
.loading-text { font-size: 24px; line-height: 34px }

.center-area { flex: 1; justify-content: center; align-items: center }
.empty-text { font-size: 24px; line-height: 34px; text-align: center; lines: 1 }

/* 卡片内宽 152 = 168 − 8×2；A 课名 / B 数字+单位 / C 语义行 / D 日期 / E 开始时刻 / F 地点 */
.card { flex-direction: column; align-items: center; width: 100%; padding: 12px 8px; border-radius: 12px }
/* 4 字 @28 = 149 ≤ 152（贴边），5 字任何字档都放不下，靠删字不靠省略号 */
.c-name { font-size: 28px; font-weight: bold; line-height: 34px; text-align: center; lines: 1 }
/* 数字与单位同一行：44 是四档上限，单位并排后「99+ 分」总宽约 100px，远窄于 152 */
.num-row { flex-direction: row; align-items: flex-end; justify-content: center }
.c-num { font-size: 44px; font-weight: bold; line-height: 52px; font-family: monospace }
.c-unit { font-size: 24px; line-height: 34px; margin-left: 4px }
.c-label { font-size: 24px; line-height: 34px; text-align: center; lines: 1 }
.c-day { font-size: 24px; line-height: 30px; text-align: center; lines: 1 }
.c-time { font-size: 24px; line-height: 34px; text-align: center; lines: 1 }
.c-loc { font-size: 24px; line-height: 30px; text-align: center; lines: 1 }

@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px }
  .c-name { font-size: 28px; line-height: 36px }
  .c-num { line-height: 56px }
}

@media (width >= 400px) {
  .page { padding: 12px 20px 16px 20px }
  .card { padding: 24px 16px }
  .c-name { font-size: 28px; line-height: 40px }
  .c-num { font-size: 44px; line-height: 60px }
  .c-unit { font-size: 28px; line-height: 40px }
  .c-label { font-size: 28px; line-height: 40px }
  .c-time { font-size: 28px; line-height: 38px }
}
</style>
