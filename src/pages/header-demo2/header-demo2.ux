<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  goBack() {
    router.back()
  }
}
</script>

