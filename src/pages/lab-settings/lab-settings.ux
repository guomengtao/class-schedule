    font-size: 24px;
  }
  .header-title {
    font-size: 36px;
    line-height: 48px;
  }
  .list-row {
    padding: 18px 16px;
    margin-bottom: 10px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 16px 16px 16px;
  }
  .back-btn {
    width: 50px;
    height: 40px;
    font-size: 24px;
  }
  .header-title {
