  font-size: 36px;
  font-weight: bold;
  margin-left: 12px;
  line-height: 44px;
}

.section-hint {
  font-size: 28px;
  margin-bottom: 12px;
  line-height: 38px;
}

.list-scroll {
  flex: 1;
  flex-direction: column;
  overflow: scroll;
}

.list-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 8px;
  min-height: 56px;
}

.row-name {
  font-size: 32px;
  flex-shrink: 0;
  max-lines: 1;
  line-height: 38px;
}

.row-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 1;
  overflow: hidden;
}

.row-desc {
  font-size: 28px;
  margin-right: 6px;
  max-lines: 1;
  line-height: 34px;
}

.row-arrow {
  font-size: 28px;
  flex-shrink: 0;
}

.version-text {
  font-size: 24px;
  text-align: center;
  padding-top: 12px;
  flex-shrink: 0;
  line-height: 34px;
}

