<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="<" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">实验室</text>
    </div>

    <text class="section-hint" style="color: {{ theme.textSecondary }}">实验性功能列表</text>

    <div class="list-scroll">
      <div class="list-row" for="(idx, item) in labItems" style="background-color: {{ theme.card }}" onclick="onOpenItem(idx)">
        <text class="row-name" style="color: {{ theme.text }}">{{ item.name }}</text>
        <div class="row-right">
          <text class="row-desc" style="color: {{ theme.textMuted }}">{{ item.desc }}</text>
          <text class="row-arrow" style="color: {{ theme.textMuted }}">></text>
        </div>
      </div>
    </div>

    <text class="version-text" style="color: {{ theme.textMuted }}">v{{ versionText }}</text>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    labItems: [
      { name: "胶囊屏隐藏测试", desc: "胶囊屏隐藏方法验证", uri: "/pages/capsule-hide-test" },
      { name: "Demo1: 遮罩弹窗", desc: "遮罩弹窗测试", uri: "/pages/bs-demo1" },
      { name: "Demo2: 点击穿透", desc: "事件穿透问题", uri: "/pages/bs-demo2" },
      { name: "Demo3: 循环弹窗", desc: "弹窗时序测试", uri: "/pages/bs-demo3" },
      { name: "Demo4: 定位对比", desc: "定位方式对比", uri: "/pages/bs-demo4" },
      { name: "Demo5: 事件测试", desc: "事件冒泡捕获", uri: "/pages/bs-demo5" },
      { name: "震动实验室", desc: "震动效果测试", uri: "/pages/vibration-lab" },
      { name: "二维码生成", desc: "二维码生成工具", uri: "/pages/qrcode-generator" }
    ],
    versionText: "",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    this.loadVersion()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  loadVersion() {
    try {
      var v = require("../../data/version.js")
      this.versionText = v.version || "1.0.0"
    } catch (e) {
      this.versionText = "1.0.0"
    }
  },

  onOpenItem(idx) {
    var item = this.labItems[idx]
    if (item && item.uri) {
      router.push({ uri: item.uri })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
