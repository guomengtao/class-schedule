  .page {
    padding: 120px 10px 120px 10px;
  }
  .back-header {
    margin-bottom: 14px;
  }
  .back-btn {
    width: 52px;
    height: 40px;
    border-radius: 20px;
    font-size: 20px;
  }
  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
  .section-hint {
    font-size: 24px;
    margin-bottom: 10px;
    line-height: 40pxpx;
  }
  .list-row {
    padding: 14px 12px;
    margin-bottom: 8px;
    min-height: 64px;
    border-radius: 10px;
  }
  .row-name {
    font-size: 28px;
    line-height: 42px;
    max-lines: 1;
  }
  .row-desc {
    font-size: 22px;
    line-height: 40pxpx;
    max-lines: 1;
    margin-right: 4px;
  }
  .row-arrow {
    font-size: 24px;
  }
  .version-text {
    font-size: 20px;
    padding-top: 10px;
