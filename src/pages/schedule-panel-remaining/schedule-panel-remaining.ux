<template>
  <div class="page" style="background-color: {{ theme.bg }}; padding: {{ sz.page }}">
    <div class="back-header" style="height: {{ sz.headerH }}">
      <div class="back-btn-wrapper" onclick="goBack"
           style="background-color: {{ theme.card }}; display: {{ isRoot ? 'none' : 'flex' }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.textSecondary }}; font-size: {{ sz.title }}; line-height: {{ sz.titleLh }}">剩余</text>
      <div class="header-placeholder" style="display: {{ isRoot ? 'none' : 'flex' }}"></div>
    </div>

    <!-- A 主信息：剩余节数（字号封顶 44，单位跟数字同排，省一行） -->
    <text class="big-count" style="color: {{ theme.accent }}; margin-top: {{ sz.bigMarginTop }}; font-size: {{ sz.bigFont }}; line-height: {{ sz.bigLh }}">{{ bigText }}</text>

    <!-- B 副信息：剩余总时长；空态时这里直接说结论，D 区不再重复 -->
    <text class="unit-line" style="color: {{ theme.textSecondary }}; margin-top: {{ sz.unitMarginTop }}; font-size: {{ sz.unitFont }}; line-height: {{ sz.unitLh }}">{{ unitText }}</text>

    <!-- D 列表：最多 4 行，行高由剩余高度预算算出（192 屏 44，宽屏 50+）。不写死容器高，行数少就自然收紧 -->
    <div class="list" style="margin-top: {{ sz.listMarginTop }}">
      <div for="{{ shownClasses }}" class="row" style="height: {{ sz.rowH }}">
        <text class="row-time" style="color: {{ theme.textSecondary }}; width: {{ sz.timeW }}; margin-right: {{ sz.timeMr }}; font-size: {{ sz.rowFont }}; line-height: {{ sz.rowLh }}">{{ $item.timeShort }}</text>
        <text class="row-name" style="color: {{ $item.isCurrent ? theme.accent : theme.text }}; font-size: {{ sz.rowFont }}; line-height: {{ sz.rowLh }}">{{ $item.name }}</text>
      </div>
    </div>

    <!-- E 溢出提示：只报条数，13 字长句在 168px 上必然折行 -->
    <text class="overflow-tip" style="color: {{ theme.textMuted }}; display: {{ hasOverflow ? 'flex' : 'none' }}; font-size: {{ sz.tipFont }}; line-height: {{ sz.tipLh }}">{{ overflowText }}</text>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const database = require("../../data/database.js")
const store = require("../../data/store.js")
const utils = require("../../data/utils.js")
const builtinSchedule = require("../../data/schedule.js")
const screenFit = require("../../data/screen-fit.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

// "08:00 - 09:35" 解析成 {startMin, endMin}；格式不合规返回 null（脏数据不参与统计）
function parseTimeRange(timeStr) {
  if (!timeStr) return null
  var parts = timeStr.split(" - ")
  if (parts.length !== 2) return null
  var s1 = parts[0].trim().split(":")
  var s2 = parts[1].trim().split(":")
  if (s1.length !== 2 || s2.length !== 2) return null
  var a = parseInt(s1[0]) * 60 + parseInt(s1[1])
  var b = parseInt(s2[0]) * 60 + parseInt(s2[1])
  if (isNaN(a) || isNaN(b) || b <= a) return null
  return { startMin: a, endMin: b }
}

// "08:00 - 09:35" 取开始时刻 "08:00"
function startLabel(timeStr) {
  if (!timeStr) return ""
  var i = timeStr.indexOf(" - ")
  return (i < 0 ? timeStr : timeStr.substring(0, i)).trim()
}

// P2：剩余时长舍入到 5 分钟（有剩余但不足 2.5 分时不许显示 0）
function round5(min) {
  if (min <= 0) return 0
  var r = Math.round(min / 5) * 5
  return r === 0 ? 5 : r
}

// 分钟数取成 "3 小时 15 分" / "45 分"。
// 24px 下最坏串「10 小时 55 分」= 165px ≤ 168px，所以这里不能再加「还剩」前缀（加 3 字就 216px）。
function durationText(min) {
  if (min <= 0) return "0 分"
  if (min < 60) return min + " 分"
  var h = Math.floor(min / 60)
  var m = min % 60
  return m === 0 ? (h + " 小时") : (h + " 小时 " + m + " 分")
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    isLoading: true,
    remainCount: 0,
    bigText: "0 节",        // A 区：剩余节数带单位
    unitText: "",           // B 区：剩余总时长，或空态结论
    emptyMessage: "今天没课",
    shownClasses: [],
    overflowCount: 0,
    hasOverflow: false,
    overflowText: "",
    schedule: [],
    tickTimer: null,
    // 尺寸令牌：默认 = 192×490 基准原值（手环 9 零改动）；
    // 宽屏（10 Pro 336 起）由 fitScreen() 按 k = screenWidth/192 覆盖
    sz: {
      page: "44px 12px 12px 12px",
      headerH: "40px",
      title: "28px", titleLh: "36px",
      bigMarginTop: "18px", bigFont: "44px", bigLh: "60px",
      unitMarginTop: "4px", unitFont: "24px", unitLh: "34px",
      listMarginTop: "16px",
      rowH: "44px", timeW: "62px", timeMr: "8px",
      rowFont: "24px", rowLh: "34px",
      tipFont: "24px", tipLh: "34px"
    },
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    // 独立首页 root 判定：由「更多首页」push 带 fromPanel='1'；无参数即冷启动为首页
    self.fromPanel = (self.fromPanel === '1') ? '1' : ''
    self.isRoot = self.fromPanel !== '1'
    self.fitScreen()
    // 首帧同步出内容：storage 回调慢/丢也不许停在「加载中」
    self.apply((builtinSchedule && builtinSchedule.schedule) ? builtinSchedule.schedule : [])
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
      self.loadData()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    // 回前台立即重算（后台期间可能已跨节），再续排下一次整分
    if (!self.isLoading) self.tick()
  },

  onHide() {
    this.clearTickTimer()
  },

  /* 分钟级刷新：只保留一个对齐「下一个整分」的 setTimeout。
     剩余节数/剩余时长都是分钟级事件，全页禁 setInterval（方案 §0）。 */
  scheduleNextMinute: function() {
    var self = this
    this.clearTickTimer()
    var now = new Date()
    var ms = 60000 - (now.getSeconds() * 1000)
    if (ms < 1000) ms = 1000
    this.tickTimer = setTimeout(function() { self.tick() }, ms)
  },

  clearTickTimer: function() {
    if (this.tickTimer) { clearTimeout(this.tickTimer); this.tickTimer = null }
  },

  apply: function(schedule) {
    this.schedule = schedule || []
    this.isLoading = false
    this.tick()
  },

  /* 屏宽比例适配（2026-10-25）：
     192×490（手环 9）是设计基准，sz 原样不动；只有 wide 屏（≥300，10 Pro 336 起）
     才按 k = screenWidth / 192 重算。竖向空间没跟着变宽（480/490 ≈ 0.98），
     所以字号用 min(k, kv×1.14) 压住，行高再由剩余高度预算反算 —— 宁可字小也不许溢出。
     读不到屏幕信息就继续用基准值，绝不白屏。 */
  fitScreen: function() {
    var self = this
    device.getInfo({
      success: function(d) {
        var s = screenFit.scaleFor(d.screenWidth, d.screenHeight)
        if (!s.wide) return
        self.applyWide(s, d.screenWidth, d.screenHeight)
      },
      fail: function() {}
    })
  },

  applyWide: function(s, w, h) {
    var self = this
    var px = screenFit.px
    var fx = Math.min(s.k, 1.3)            // 横向拉伸上限：时间列再宽就挤课名了
    var padTop = 44                        // 状态栏留白：系统级，不跟屏宽放大
    var padBottom = 12
    var sides = Math.round(12 * fx)        // 12 → 16
    var headerH = 48
    var bigFont = 56, bigLh = 70, bigMT = 14
    var unitFont = 30, unitLh = 40, unitMT = 4
    var listMT = 14
    var tipFont = 26, tipLh = 32
    var rowFont = 30, rowLh = 38
    var timeW = Math.round(62 * fx)        // 62 → 81
    // 行高吃剩下的高度：4 行硬上限（P1 规格），并夹在 44（触控下限）~64 之间
    var avail = h - padTop - padBottom
    var fixedH = headerH + bigMT + bigLh + unitMT + unitLh + listMT + tipLh
    var rowH = Math.floor((avail - fixedH) / 4)
    if (rowH > 64) rowH = 64
    if (rowH < 44) rowH = 44
    self.sz = {
      page: px(padTop) + " " + px(sides) + " " + px(padBottom) + " " + px(sides),
      headerH: px(headerH),
      title: px(28 * s.font), titleLh: px(36 * s.font),
      bigMarginTop: px(bigMT), bigFont: px(bigFont), bigLh: px(bigLh),
      unitMarginTop: px(unitMT), unitFont: px(unitFont), unitLh: px(unitLh),
      listMarginTop: px(listMT),
      rowH: px(rowH), timeW: px(timeW), timeMr: px(8),
      rowFont: px(rowFont), rowLh: px(rowLh),
      tipFont: px(tipFont), tipLh: px(tipLh)
    }
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.apply(schedule || [])
      })
    })
  },

  classesOf: function(dayName) {
    var schedule = this.schedule || []
    for (var i = 0; i < schedule.length; i++) {
      if (schedule[i].day === dayName) return schedule[i].classes || []
    }
    return []
  },

  tick: function() {
    try {
      this.compute()
    } catch (e) {
      // 算炸了也不许把页面钉在旧读数上
      this.remainCount = 0
      this.bigText = "0 节"
      this.unitText = "数据异常"
      this.shownClasses = []
      this.overflowCount = 0
      this.hasOverflow = false
      this.overflowText = ""
      console.error("[remaining] compute failed: " + e)
    }
    this.scheduleNextMinute()
  },

  compute: function() {
    var now = new Date()
    var nowMin = now.getHours() * 60 + now.getMinutes()
    var raw = this.classesOf(DAY_NAMES[now.getDay()])

    var items = []
    for (var i = 0; i < raw.length; i++) {
      var r = parseTimeRange(raw[i].time)
      if (!r) continue
      // 已结束（含正好下课）的不算剩余
      if (r.endMin <= nowMin) continue
      // 正在上的课只算「剩余段」，天然不吃课间/午休（不按末节减现在串算）
      var remainMin = r.endMin - (nowMin > r.startMin ? nowMin : r.startMin)
      if (remainMin <= 0) continue
      items.push({
        id: raw[i].id,
        name: raw[i].name,
        timeShort: startLabel(raw[i].time),
        startMin: r.startMin,
        endMin: r.endMin,
        remainMin: remainMin
      })
    }
    items.sort(function(a, b) { return a.startMin - b.startMin })

    var totalMin = 0
    for (var k = 0; k < items.length; k++) totalMin += items[k].remainMin

    // P1：D 区最多 4 行，超出进 E 区
    var shown = items.slice(0, 4)
    for (var m = 0; m < shown.length; m++) {
      shown[m].isCurrent = nowMin >= shown[m].startMin && nowMin < shown[m].endMin
    }

    this.remainCount = items.length
    this.bigText = items.length + " 节"
    this.overflowCount = items.length - shown.length
    this.hasOverflow = this.overflowCount > 0
    this.overflowText = "还有 " + this.overflowCount + " 节"
    this.shownClasses = shown

    if (items.length === 0) {
      // 空态不重复：B 区直接说结论，D 区不再摆一行字
      this.emptyMessage = raw.length === 0 ? "今天没课" : "今日已上完"
      this.unitText = this.emptyMessage
    } else {
      this.unitText = durationText(round5(totalMin))
    }
  },

  goBack: function() {
    // 双模返回：被「更多首页」push（fromPanel）则回父页；作为 root 首页则回「更多首页」
    if (this.fromPanel === '1') {
      router.back()
    } else {
      // 面板被当独立首页（root）时无可退返回栈，直接回「更多首页」
      router.push({ uri: '/pages/schedule-panel' })
    }
  },

  onBackPress: function() {
    // 硬件返回键：push 态交还系统默认返回；root 态退出（与 index 一致）
    if (this.fromPanel === '1') return false
    return utils.exitApp() === true
  },

  onDestroy: function() {
    this.clearTickTimer()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 12px 12px 12px;
}
.back-header {
  flex-direction: row;
  align-items: center;
  height: 40px;
  flex-shrink: 0;
}
.back-btn-wrapper {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.back-btn-icon {
  width: 22px;
  height: 22px;
}
.header-title {
  flex: 1;
  font-size: 28px;
  line-height: 36px;
  text-align: center;
  lines: 1;
}
.header-placeholder {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
}

/* A 剩余节数：44px 是四档上限，「5 节」= 22 + 7 + 58.5 ≈ 88px，居中 */
.big-count {
  margin-top: 18px;
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  text-align: center;
  lines: 1;
  flex-shrink: 0;
}

/* B 剩余总时长：最坏「10 小时 55 分」165px ≤ 168px，只许一行 */
.unit-line {
  margin-top: 4px;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
  flex-shrink: 0;
}

/* D 列表：4 行 × 44（44 也是触控最小热区）。容器不写死高度，行数少就自然收紧，
   否则 1 节课时列表底下会空出 132px，再把溢出提示顶到屏幕中间 */
.list {
  margin-top: 16px;
  flex-direction: column;
  flex-shrink: 0;
}
.row {
  height: 44px;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}
/* 时间列：「08:00」24px 实测 60px，给 62px 才不折行；再留 8px 与课名分开
   （不留就只有 2px 缝，实测截图里「16:40物理」糊成一片） */
.row-time {
  width: 62px;
  margin-right: 8px;
  font-size: 24px;
  line-height: 34px;
  flex-shrink: 0;
}
/* 课名剩 98px = 3 个 24px 汉字（96px，2 字科名余裕，3 字刚好贴边） */
.row-name {
  flex: 1;
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  lines: 1;
}

/* E 溢出提示：只报条数（「还有 3 节」= 122px），长句在 168px 上必折行 */
.overflow-tip {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  flex-shrink: 0;
}

/* 宽屏（10 Pro 336 起）不再写 @media 断点：
   尺寸由 fitScreen() 按 k = screenWidth/192 算好、行内 style 绑定，
   这里的数值只是 192 屏兜底（会被行内值覆盖）。 */
</style>
