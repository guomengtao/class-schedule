<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="page-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">剩余课程</text>
      <div class="header-placeholder"></div>
    </div>

    <div if="{{ isLoading }}" class="loading-area">
      <text class="loading-text" style="color: {{ theme.textMuted }}">加载中...</text>
    </div>

    <div if="{{ !isLoading && remainingClasses.length === 0 }}" class="empty-area">
      <text class="empty-icon">{{ allDone ? '🎉' : '📭' }}</text>
      <text class="empty-text" style="color: {{ theme.textSecondary }}">{{ emptyMessage }}</text>
    </div>

    <div for="{{ remainingClasses }}" class="course-row">
      <div class="course-left">
        <text class="course-index" style="color: {{ theme.textMuted }}">{{ $idx + 1 }}</text>
        <text class="course-name" style="color: {{ $idx === 0 ? theme.accent : theme.text }}">{{ $item.name }}</text>
      </div>
      <div class="course-right">
        <text class="course-time" style="color: {{ theme.textSecondary }}">{{ $item.time }}</text>
        <text class="course-location" if="{{ $item.location }}" style="color: {{ theme.textMuted }}">{{ $item.location }}</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

function parseEndMin(timeStr) {
  if (!timeStr) return -1
  var parts = timeStr.split(" - ")
  if (parts.length !== 2) return -1
  var s = parts[1].trim().split(":")
  if (s.length !== 2) return -1
  return parseInt(s[0]) * 60 + parseInt(s[1])
}

export default {
  private: {
    iconTheme: "dark",
    isLoading: true,
    remainingClasses: [],
    allDone: false,
    emptyMessage: "今天没有课",
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    self.loadData()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        var todayIndex = new Date().getDay()
        var todayName = DAY_NAMES[todayIndex]
        var todayDay = null
        for (var i = 0; i < schedule.length; i++) {
          if (schedule[i].day === todayName) { todayDay = schedule[i]; break }
        }
        var all = (todayDay && todayDay.classes) ? todayDay.classes.slice() : []
        var nowMin = new Date().getHours() * 60 + new Date().getMinutes()
        var remaining = []
        for (var j = 0; j < all.length; j++) {
          var endMin = parseEndMin(all[j].time)
          if (endMin < 0 || endMin > nowMin) {
            remaining.push(all[j])
          }
        }
        self.isLoading = false
        self.remainingClasses = remaining
        if (remaining.length === 0 && all.length > 0) {
          self.allDone = true
          self.emptyMessage = "今日课程已全部结束"
        } else if (remaining.length === 0) {
          self.emptyMessage = "今天没有课"
        }
      })
    })
  },

  goBack() { router.back() }
}
</script>

<style>
.page { flex-direction: column; width: 100%; height: 100% }
.page-scroll { flex: 1; width: 100%; flex-direction: column }
.page-body { flex-direction: column; width: 100%; padding: 44px 12px 12px 12px }

.back-header { flex-direction: row; align-items: center; margin-bottom: 16px; padding: 0 4px }
.back-btn-wrapper { width: 48px; height: 40px; border-radius: 8px; justify-content: center; align-items: center; flex-shrink: 0 }
.back-btn-icon { width: 24px; height: 24px }
.header-title { flex: 1; font-size: 28px; font-weight: bold; text-align: center; line-height: 38px }
.header-placeholder { width: 48px; height: 48px; flex-shrink: 0 }

.loading-area { align-items: center; padding: 30px 0 }
.loading-text { font-size: 22px; line-height: 30px }

.empty-area { flex-direction: column; align-items: center; padding: 40px 0 }
.empty-icon { font-size: 48px; margin-bottom: 12px }
.empty-text { font-size: 24px; line-height: 32px; text-align: center }

.course-row { flex-direction: column; padding: 16px 12px; border-bottom-width: 1px; border-bottom-color: rgba(128,128,128,0.12) }
.course-left { flex-direction: row; align-items: center; margin-bottom: 4px }
.course-index { font-size: 20px; line-height: 28px; width: 28px; flex-shrink: 0 }
.course-name { font-size: 26px; line-height: 34px; font-weight: bold }
.course-right { flex-direction: row; padding-left: 28px }
.course-time { font-size: 20px; line-height: 28px; margin-right: 16px }
.course-location { font-size: 18px; line-height: 26px }

@media (width >= 200px) {
  .page-body { padding: 44px 16px 14px 16px }
  .course-row { padding: 18px 14px }
  .course-name { font-size: 28px; line-height: 36px }
}
</style>