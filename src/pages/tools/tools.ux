<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="tools-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">工具</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 行标签一律 ≤4 字：页面 padding 12 + 卡片 padding 8 后可用 152px，
         实测 28px 汉字宽 ≈1.33×字号，4 字 = 149px 贴边、5 字 = 186px 必被裁掉最后一字。
         2026-10-23 修：「震动自定义」「二维码生成」「工作日信息」原来都是 5 字，真机截图里被裁成 4 字。
         同时按手册红线 6 去掉行尾 › 箭头（箭头不承载信息，还吃掉半个字宽），可点性靠卡片底色。 -->
    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row" onclick="openCountdownManage">
        <text class="item-label" style="color: {{ theme.text }}">倒数日</text>
      </div>
      <div class="item-row" onclick="openVibrationLab">
        <text class="item-label" style="color: {{ theme.text }}">震动调试</text>
      </div>
      <div class="item-row" onclick="openQRCodeGenerator">
        <text class="item-label" style="color: {{ theme.text }}">二维码</text>
      </div>
      <div class="item-row" onclick="openWorkdayInfo">
        <text class="item-label" style="color: {{ theme.text }}">工作日</text>
      </div>
      <div class="item-row" onclick="openStatistics">
        <text class="item-label" style="color: {{ theme.text }}">数据统计</text>
      </div>
      <div class="item-row" onclick="openDeviceInfo">
        <text class="item-label" style="color: {{ theme.text }}">设备信息</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  openDeviceInfo() {
    router.push({ uri: "/pages/device-info" })
  },

  openVibrationLab() {
    router.push({ uri: "/pages/vibration-lab" })
  },

  openCountdownManage() {
    router.push({ uri: "/pages/countdown-manage" })
  },

  openQRCodeGenerator() {
    router.push({ uri: "/pages/qrcode-generator" })
  },

  openStatistics() {
    router.push({ uri: "/pages/statistics" })
  },

  openWorkdayInfo() {
    router.push({ uri: "/pages/workday-info" })
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    this.theme = null
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.tools-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

/* 192px 宽 · 可用宽 = 192 − 12×2 = 168；卡片内 = 168 − 8×2 = 152px
 * 旧值 padding 44px 10px / 卡片 18px 14px → 卡片内只剩 144px，5 字标签必裁 */
.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 12px 12px 12px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn-wrapper {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 32px;
}

.header-placeholder {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
}

.section {
  width: 100%;
  flex-direction: column;
  border-radius: 14px;
  padding: 10px 8px;
  margin-bottom: 10px;
}

/* 行高 46px = 38(行高) + 4×2；行间靠 8px 纵向间距分隔，不用分隔线 */
.item-row {
  flex-direction: row;
  align-items: center;
  width: 100%;
  padding: 4px 0;
  min-height: 46px;
}

.item-label {
  font-size: 28px;
  line-height: 38px;
  flex-shrink: 0;
}

/* 方屏 / 圆屏：只放大留白与字号档位，不引入第五档字号 */
@media screen and (shape: rect) {
  .page-body {
    padding: 40px 20px 16px 20px;
  }

  .item-label {
    font-size: 30px;
    line-height: 40px;
  }
}

@media screen and (shape: circle) {
  .page-body {
    padding: 56px 40px 32px 40px;
  }

  .item-label {
    font-size: 30px;
    line-height: 40px;
  }
}
</style>
