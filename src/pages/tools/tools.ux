<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="tools-scroll" scroll-y="{{true}}">
    <div class="page-body">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">工具</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row" onclick="openWatchFace">
        <text class="item-label" style="color: {{ theme.text }}">表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openWatchFaceClass">
        <text class="item-label" style="color: {{ theme.text }}">课程表盘</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openCountdownManage">
        <text class="item-label" style="color: {{ theme.text }}">倒数日</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openVibrationLab">
        <text class="item-label" style="color: {{ theme.text }}">震动自定义</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openQRCodeGenerator">
        <text class="item-label" style="color: {{ theme.text }}">二维码生成</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openWorkdayInfo">
        <text class="item-label" style="color: {{ theme.text }}">工作日信息</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openStatistics">
        <text class="item-label" style="color: {{ theme.text }}">数据统计</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}"></div>
      <div class="item-row" onclick="openDeviceInfo">
        <text class="item-label" style="color: {{ theme.text }}">设备信息</text>
        <text class="arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
    </div>

    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  openDeviceInfo() {
    router.push({ uri: "/pages/device-info" })
  },

  openWatchFace() {
    router.push({ uri: "/pages/watch-face" })
  },

  openWatchFaceClass() {
    router.push({ uri: "/pages/watch-face-class" })
  },

  openVibrationLab() {
    router.push({ uri: "/pages/vibration-lab" })
  },

  openCountdownManage() {
    router.push({ uri: "/pages/countdown-manage" })
  },

  openQRCodeGenerator() {
    router.push({ uri: "/pages/qrcode-generator" })
  },

  openStatistics() {
    router.push({ uri: "/pages/statistics" })
  },

  openWorkdayInfo() {
    router.push({ uri: "/pages/workday-info" })
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    this.theme = null
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.tools-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-body {
  flex-direction: column;
  width: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  line-height: 38px;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.section {
  width: 100%;
  flex-direction: column;
  border-radius: 12px;
  padding: 18px 14px;
  margin-bottom: 14px;
}

.item-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}

.item-label {
  font-size: 28px;
  line-height: 38px;
}

.arrow {
  font-size: 28px;
  flex-shrink: 0;
  line-height: 38px;
}

.row-divider {
  height: 1px;
  margin: 6px 0;
}

@media (width >= 360) {
  .page-body { padding: 44px 20px 24px 20px; }
  .item-row { padding: 16px 0; }
}

@media (width >= 480) {
  .page-body { padding: 44px 48px 24px 48px; }
}
</style>