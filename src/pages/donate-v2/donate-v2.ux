<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">

    <div class="header">
      <text class="back-btn" onclick="goBack"
            style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">打赏支持</text>
      <div class="header-spacer"></div>
    </div>

    <div class="tab-bar">
      <div class="tab-item" onclick="switchTab(0)"
           style="background-color: {{ currentTab === 0 ? '#07C160' : theme.card }}">
        <text class="tab-text"
              style="color: {{ currentTab === 0 ? '#ffffff' : theme.textSecondary }}">微信</text>
      </div>
      <div class="tab-item" onclick="switchTab(1)"
           style="background-color: {{ currentTab === 1 ? '#1677FF' : theme.card }}">
        <text class="tab-text"
              style="color: {{ currentTab === 1 ? '#ffffff' : theme.textSecondary }}">支付宝</text>
      </div>
      <div class="tab-item" onclick="switchTab(2)"
           style="background-color: {{ currentTab === 2 ? '#FF6B35' : theme.card }}">
        <text class="tab-text"
              style="color: {{ currentTab === 2 ? '#ffffff' : theme.textSecondary }}">爱发电</text>
      </div>
    </div>

    <div class="content-area">
      <div class="qr-card" style="background-color: {{ theme.card }}">
        <div class="qr-wrapper">
          <qrcode value="{{ qrText }}"
                  style="width: {{ qrSize }}px; height: {{ qrSize }}px; color: #000000; background-color: #ffffff;"></qrcode>
        </div>
        <text class="scan-hint" style="color: {{ theme.textSecondary }}">请使用 {{ platformName }} 扫码</text>
      </div>
    </div>

    <div class="thanks-section">
      <text class="thanks-icon" style="color: {{ theme.accent }}">♥</text>
      <text class="thanks-text" style="color: {{ theme.textSecondary }}">感谢您的支持</text>
    </div>

  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const store = require("../../data/store.js")

var WECHAT_URL = "wxp://f2f0i7FYfQ5xBhxQtXDwsQpkyGZLB7UsjrRjsrXn02Qx8NQHjn8WlZEnozT2BURX_JRy"
var ALIPAY_URL = "https://qr.alipay.com/fkx11582syvbdeymczggr3c"
var AFDIAN_URL = "https://ifdian.net/a/peipeijin/plan"

var PLATFORMS = [
  { name: "微信",   color: "#07C160" },
  { name: "支付宝", color: "#1677FF" },
  { name: "爱发电", color: "#FF6B35" }
]

var QR_TEXTS = [WECHAT_URL, ALIPAY_URL, AFDIAN_URL]

export default {
  private: {
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#9a9ab0"
    },
    currentTab: 0,
    qrText: WECHAT_URL,
    qrSize: 144,
    platformName: "微信"
  },

  onInit() {
    var self = this
    store.getTheme(function (t) {
      self.theme = t
    })
    self.calcQrSize()
  },

  onShow() {
    var self = this
    store.getTheme(function (t) {
      self.theme = t
    })
  },

  calcQrSize() {
    var self = this
    device.getInfo({
      success: function (info) {
        var w = info.screenWidth || 192
        var size = Math.floor(w - 8 * 2 - 8 * 2 - 6 * 2 - 4)
        if (size > 200) size = 200
        if (size < 80) size = 80
        self.qrSize = size
      },
      fail: function () {
        self.qrSize = 144
      }
    })
  },

  switchTab(index) {
    this.currentTab = index
    this.qrText = QR_TEXTS[index]
    this.platformName = PLATFORMS[index].name
  },

  goBack() {
    router.back()
  }
}
</script>

