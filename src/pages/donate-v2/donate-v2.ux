<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">打赏支持</text>
      <text class="version-tag" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">V2</text>
    </div>

    <div class="tab-bar">
      <div class="tab-item {{ currentTab === 0 ? 'tab-active' : '' }}" onclick="switchTab(0)" style="background-color: {{ currentTab === 0 ? '#07C160' : theme.card }}">
        <text class="tab-text" style="color: {{ currentTab === 0 ? '#ffffff' : theme.textSecondary }}">微信</text>
      </div>
      <div class="tab-item {{ currentTab === 1 ? 'tab-active' : '' }}" onclick="switchTab(1)" style="background-color: {{ currentTab === 1 ? '#1677FF' : theme.card }}">
        <text class="tab-text" style="color: {{ currentTab === 1 ? '#ffffff' : theme.textSecondary }}">支付宝</text>
      </div>
      <div class="tab-item {{ currentTab === 2 ? 'tab-active' : '' }}" onclick="switchTab(2)" style="background-color: {{ currentTab === 2 ? '#FF6B35' : theme.card }}">
        <text class="tab-text" style="color: {{ currentTab === 2 ? '#ffffff' : theme.textSecondary }}">爱发电</text>
      </div>
    </div>

    <div class="content-area">
      <div class="qr-card" style="background-color: {{ theme.card }}">
        <div class="platform-header">
          <text class="platform-icon" style="color: {{ platformColor }}">{{ platformIcon }}</text>
          <text class="platform-name" style="color: {{ platformColor }}">{{ platformName }}</text>
        </div>

        <text class="platform-desc" style="color: {{ theme.textSecondary }}">{{ platformDesc }}</text>

        <div class="qr-wrapper">
          <qrcode value="{{ qrText }}" style="color: #000000; background-color: #ffffff; width: {{ qrSize }}px; height: {{ qrSize }}px;"></qrcode>
        </div>

        <text class="scan-hint" style="color: {{ theme.textMuted }}">请使用 {{ platformName }} 扫码</text>
      </div>
    </div>

    <div class="thanks-section">
      <text class="thanks-icon" style="color: {{ theme.accent }}">♥</text>
      <text class="thanks-text" style="color: {{ theme.textSecondary }}">感谢您的支持</text>
      <text class="thanks-sub" style="color: {{ theme.textMuted }}">每一份支持都是我前进的动力</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var WECHAT_URL = "wxp://f2f0i7FYfQ5xBhxQtXDwsQpkyGZLB7UsjrRjsrXn02Qx8NQHjn8WlZEnozT2BURX_JRy"
var ALIPAY_URL = "https://qr.alipay.com/fkx11582syvbdeymczggr3c"
var AFDIAN_URL = "https://ifdian.net/a/peipeijin/plan"

var PLATFORMS = [
  { name: "微信", desc: "微信扫一扫，向我付款", color: "#07C160", icon: "💬" },
  { name: "支付宝", desc: "支付宝扫一扫，向我转账", color: "#1677FF", icon: "🔵" },
  { name: "爱发电", desc: "浏览器扫码访问我的主页", color: "#FF6B35", icon: "⚡" }
]

var QR_TEXTS = [WECHAT_URL, ALIPAY_URL, AFDIAN_URL]

export default {
  private: {
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    },
    currentTab: 0,
    qrText: WECHAT_URL,
    qrSize: 150,
    platformName: "微信",
    platformDesc: "微信扫一扫，向我付款",
    platformColor: "#07C160",
    platformIcon: "💬"
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.setQrSize()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  setQrSize() {
    this.qrSize = 150
  },

  switchTab(index) {
    this.currentTab = index
    this.qrText = QR_TEXTS[index]
    this.platformName = PLATFORMS[index].name
    this.platformDesc = PLATFORMS[index].desc
    this.platformColor = PLATFORMS[index].color
    this.platformIcon = PLATFORMS[index].icon
  },

  goBack() {
    router.back()
  }
}
</script>

