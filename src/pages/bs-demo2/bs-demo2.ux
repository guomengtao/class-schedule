<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">Demo2: 无media适配</text>
    </div>

    <text class="info" style="color: {{ theme.accent }}">测试: 无 @media (shape:) 屏幕形状适配</text>
    <text class="desc" style="color: {{ theme.textSecondary }}">此页没有 shape:circle / capsule / rect 适配，布局全靠基础CSS</text>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.text }}">无 Media 适配</text>
      <text class="card-text" style="color: {{ theme.textSecondary }}">本页 style 中没有 @media (shape:) 声明</text>
      <text class="card-text" style="color: {{ theme.textMuted }}">在米环9/10胶囊屏上，如果没有 shape 适配，465条CSS声明可能全部无效</text>
    </div>

    <div class="content-card" style="background-color: {{ theme.card }}">
      <text class="card-title" style="color: {{ theme.text }}">底部对比标记</text>
      <text class="card-text" style="color: {{ theme.accent }}">能看到这行 → 无media适配页正常</text>
    </div>

    <div class="nav-bar" style="background-color: {{ theme.card }}">
      <input class="nav-btn" type="button" value="‹ 上一项" onclick="goPrev"
             style="background-color: {{ theme.border }}; color: {{ theme.textSecondary }}" />
      <text class="nav-page" style="color: {{ theme.textMuted }}">2 / 5</text>
      <input class="nav-btn" type="button" value="下一项 ›" onclick="goNext"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  goBack() {
    router.back()
  },

  goPrev() {
    router.push({ uri: "/pages/bs-demo1" })
  },

  goNext() {
    router.push({ uri: "/pages/bs-demo3" })
  }
}
</script>

