<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="&#9664; 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">今日课程</text>
    </div>

    <text class="subtitle" style="color: {{ theme.textSecondary }}">{{ currentDay }} · {{ classes.length }} 节课</text>

    <div if="{{ addedRandom }}" class="added-hint" style="background-color: {{ theme.cardLight }}">
      <text class="added-hint-text" style="color: {{ theme.accent }}">已自动添加 2 个随机课程</text>
    </div>

    <scroll class="class-list" scroll-y="{{true}}">
      <div for="{{ classes }}" class="class-item" style="background-color: {{ theme.card }}">
        <div class="accent" style="background-color: {{ theme.accent }}"></div>
        <div class="class-info">
          <text class="class-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="class-time" style="color: {{ theme.textSecondary }}">{{ $item.time }}</text>
        </div>
        <text class="class-location" if="{{ $item.location }}" style="color: {{ theme.accent }}">{{ $item.location }}</text>
      </div>

      <div if="{{ classes.length === 0 && !loading }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">加载中...</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")

var dayNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

var randomCourses = [
  { name: "高等数学", time: "08:00 - 09:30", teacher: "张老师", location: "教学楼A101" },
  { name: "大学英语", time: "10:00 - 11:30", teacher: "李老师", location: "教学楼B202" },
  { name: "计算机科学", time: "14:00 - 15:30", teacher: "王老师", location: "实验楼C301" },
  { name: "线性代数", time: "16:00 - 17:30", teacher: "赵老师", location: "教学楼A203" },
  { name: "物理实验", time: "09:00 - 10:30", teacher: "陈老师", location: "物理楼101" },
  { name: "马克思主义原理", time: "13:00 - 14:30", teacher: "刘老师", location: "教学楼D104" },
  { name: "体育课", time: "15:00 - 16:30", teacher: "周老师", location: "操场" },
  { name: "程序设计", time: "08:30 - 10:00", teacher: "吴老师", location: "机房401" }
]

function getRealTodayIndex() {
  return new Date().getDay()
}

function shuffle(arr) {
  var result = arr.slice()
  for (var i = result.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1))
    var tmp = result[i]
    result[i] = result[j]
    result[j] = tmp
  }
  return result
}

export default {
  private: {
    currentDay: "",
    classes: [],
    addedRandom: false,
    loading: true,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    }
  },

  onInit() {
    var self = this
    var todayIdx = getRealTodayIndex()
    self.currentDay = dayNames[todayIdx]

    store.getTheme(function(t) {
      self.theme = t
    })

    database.init(function() {
      database.getAllCourses(function(schedule) {
        console.log("[today-demo] schedule loaded, " + schedule.length + " days")
        self.checkAndLoad(schedule, todayIdx)
      })
    })
  },

  checkAndLoad(schedule, todayIdx) {
    var self = this
    var todayName = dayNames[todayIdx]
    var dayData = null

    for (var i = 0; i < schedule.length; i++) {
      if (schedule[i].day === todayName) {
        dayData = schedule[i]
        break
      }
    }

    var rawClasses = dayData ? dayData.classes : []
    console.log("[today-demo] " + todayName + " has " + rawClasses.length + " classes")

    if (rawClasses.length === 0) {
      console.log("[today-demo] no classes for today, adding 2 random courses")
      self.addRandomCourses(todayName, 2, function() {
        self.reloadClasses()
      })
    } else {
      self.displayClasses(rawClasses)
    }
  },

  addRandomCourses(day, count, callback) {
    var self = this
    var shuffled = shuffle(randomCourses)
    var picked = []
    for (var i = 0; i < count && i < shuffled.length; i++) {
      picked.push(shuffled[i])
    }

    var added = 0
    function addNext() {
      if (added >= picked.length) {
        console.log("[today-demo] added " + added + " random courses")
        self.addedRandom = true
        callback()
        return
      }
      var c = picked[added]
      var course = {
        id: "random_" + Date.now() + "_" + added,
        day: day,
        name: c.name,
        time: c.time,
        teacher: c.teacher,
        location: c.location,
        notes: ""
      }
      database.insertCourse(course, function(err) {
        if (err) {
          console.log("[today-demo] insertCourse failed: " + JSON.stringify(err))
        }
        added++
        addNext()
      })
    }
    addNext()
  },

  reloadClasses() {
    var self = this
    database.getAllCourses(function(schedule) {
      var todayIdx = getRealTodayIndex()
      var todayName = dayNames[todayIdx]
      var dayData = null
      for (var i = 0; i < schedule.length; i++) {
        if (schedule[i].day === todayName) {
          dayData = schedule[i]
          break
        }
      }
      var rawClasses = dayData ? dayData.classes : []
      self.displayClasses(rawClasses)
    })
  },

  displayClasses(rawClasses) {
    var classes = []
    for (var j = 0; j < rawClasses.length; j++) {
      var src = rawClasses[j]
      classes.push({
        id: src.id,
        name: src.name,
        time: src.time,
        location: src.location || ""
      })
    }
    classes.sort(function(a, b) {
      var ta = a.time ? a.time.split(" - ")[0] : "00:00"
      var tb = b.time ? b.time.split(" - ")[0] : "00:00"
      var taParts = ta.split(":")
      var tbParts = tb.split(":")
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    this.classes = classes
    this.loading = false
    console.log("[today-demo] displayed " + classes.length + " classes")
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.subtitle {
  font-size: 13px;
  text-align: center;
  margin-bottom: 8px;
}

.added-hint {
  flex-direction: row;
  justify-content: center;
  border-radius: 8px;
  padding: 6px 12px;
  margin-bottom: 8px;
}

.added-hint-text {
  font-size: 13px;
}

.class-list {
  flex: 1;
  flex-direction: column;
  overflow: auto;
}

.class-item {
  flex-direction: row;
  align-items: center;
  border-radius: 8px;
  padding: 0 0 0 0;
  margin-bottom: 6px;
  overflow: hidden;
  position: relative;
}

.accent {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 4px;
}

.class-info {
  flex-direction: column;
  flex: 1;
  padding: 10px 14px;
}

.class-name {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 2px;
}

.class-time {
  font-size: 14px;
}

.class-location {
  font-size: 14px;
  padding-right: 14px;
  flex-shrink: 0;
}

.empty-card {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.empty-text {
  font-size: 20px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
}
</style>