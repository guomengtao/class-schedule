<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="&#9664; 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">今日课程</text>
    </div>

    <div class="premium-overlay" style="background-color: {{ theme.accent }}">
      <text class="premium-overlay-text" style="color: {{ theme.bg }}">⭐ 高级版功能 · 升级解锁更多</text>
      <text class="premium-overlay-link" onclick="goToPremium" style="color: {{ theme.bg }}">查看详情 →</text>
    </div>

    <div class="quick-buttons">
      <input class="quick-btn" type="button" value="化学" onclick="addQuickCourse('化学')" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="quick-btn" type="button" value="品德" onclick="addQuickCourse('品德')" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
    </div>

    <text class="subtitle" style="color: {{ theme.textSecondary }}">{{ currentDay }} · {{ classes.length }} 节课</text>

    <div class="schedule-info" style="background-color: {{ theme.cardLight }}">
      <text class="schedule-info-text" style="color: {{ theme.accent }}">当前课程表: {{ currentScheduleName }}</text>
    </div>

    <scroll class="class-list" scroll-y="{{true}}">
      <div for="{{ classes }}" class="class-item" style="background-color: {{ theme.card }}">
        <div class="accent" style="background-color: {{ theme.accent }}"></div>
        <div class="class-info">
          <text class="class-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="class-time" style="color: {{ theme.textSecondary }}">{{ $item.time }}</text>
        </div>
        <text class="class-location" if="{{ $item.location }}" style="color: {{ theme.accent }}">{{ $item.location }}</text>
      </div>

      <div if="{{ loading }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">加载中...</text>
      </div>

      <div if="{{ classes.length === 0 && !loading }}" class="empty-card">
        <text class="empty-text" style="color: {{ theme.textMuted }}">今日暂无课程</text>
        <text class="empty-hint" style="color: {{ theme.textSecondary }}">使用上方快速添加或前往课程管理添加课程</text>
      </div>
    </scroll>

    <div class="footer-actions">
      <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}; font-size: 13px;">📌 钉首页</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const database = require("../../data/database.js")
var pinHelper = require("../../data/pin-helper.js")

var dayNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]

function getRealTodayIndex() {
  return new Date().getDay()
}

export default {
  private: {
    currentDay: "",
    classes: [],
    currentScheduleName: "",
    loading: true,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    }
  },

  onInit() {
    var self = this
    var todayIdx = getRealTodayIndex()
    self.currentDay = dayNames[todayIdx]

    store.getTheme(function(t) {
      self.theme = t
    })

    store.getCurrentScheduleIndex(function(idx) {
      store.getScheduleNames(function(names) {
        if (names && idx < names.length) {
          self.currentScheduleName = names[idx]
        } else {
          self.currentScheduleName = "课程表" + (idx + 1)
        }
        console.log("[today-demo] active schedule: " + self.currentScheduleName + " (index=" + idx + ")")
      })
    })

    database.init(function() {
      database.getAllCourses(function(schedule) {
        console.log("[today-demo] schedule loaded, " + schedule.length + " days")
        var todayName = dayNames[todayIdx]
        var dayData = null
        for (var i = 0; i < schedule.length; i++) {
          if (schedule[i].day === todayName) {
            dayData = schedule[i]
            break
          }
        }
        var rawClasses = dayData ? dayData.classes : []
        console.log("[today-demo] " + todayName + " has " + rawClasses.length + " classes")
        self.displayClasses(rawClasses)
      })
    })
  },

  displayClasses(rawClasses) {
    var classes = []
    for (var j = 0; j < rawClasses.length; j++) {
      var src = rawClasses[j]
      classes.push({
        id: src.id,
        name: src.name,
        time: src.time,
        location: src.location || ""
      })
    }
    classes.sort(function(a, b) {
      var ta = a.time ? a.time.split(" - ")[0] : "00:00"
      var tb = b.time ? b.time.split(" - ")[0] : "00:00"
      var taParts = ta.split(":")
      var tbParts = tb.split(":")
      return (parseInt(taParts[0]) * 60 + parseInt(taParts[1])) - (parseInt(tbParts[0]) * 60 + parseInt(tbParts[1]))
    })
    this.classes = classes
    this.loading = false
    console.log("[today-demo] displayed " + classes.length + " classes")
  },

  goBack() {
    router.back()
  },

  goToPremium() {
    router.push({ uri: "/pages/premium-test" })
  },

  pinToHome() {
    pinHelper.pinPage("今日课程", "/pages/today-demo")
  },

  addQuickCourse(courseName) {
    var self = this
    var todayIdx = getRealTodayIndex()
    var todayName = dayNames[todayIdx]
    var course = {
      id: "quick_" + Date.now(),
      day: todayName,
      name: courseName,
      time: "08:00 - 09:30",
      teacher: "",
      location: "",
      notes: ""
    }
    database.insertCourse(course, function(err) {
      if (err) {
        console.log("[today-demo] addQuickCourse failed: " + JSON.stringify(err))
      }
      console.log("[today-demo] added " + courseName + " to " + todayName)
      database.getAllCourses(function(schedule) {
        var todayName2 = dayNames[getRealTodayIndex()]
        var dayData = null
        for (var i = 0; i < schedule.length; i++) {
          if (schedule[i].day === todayName2) {
            dayData = schedule[i]
            break
          }
        }
        var rawClasses = dayData ? dayData.classes : []
        self.displayClasses(rawClasses)
      })
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 8px 8px 8px;
  min-height: 100%;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}

.premium-overlay {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 10px;
  padding: 10px 14px;
  margin-bottom: 10px;
  opacity: 0.85;
}

.premium-overlay-text {
  font-size: 14px;
  font-weight: bold;
}

.premium-overlay-link {
  font-size: 13px;
  text-decoration: underline;
}

.subtitle {
  font-size: 13px;
  text-align: center;
  margin-bottom: 8px;
}

.schedule-info {
  flex-direction: row;
  justify-content: center;
  border-radius: 8px;
  padding: 6px 12px;
  margin-bottom: 8px;
}

.schedule-info-text {
  font-size: 13px;
}

.quick-buttons {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 8px;
}

.quick-btn {
  width: 80px;
  height: 36px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  margin: 0 6px;
}

.class-list {
  flex: 1;
  flex-direction: column;
  overflow: auto;
}

.class-item {
  flex-direction: row;
  align-items: center;
  border-radius: 8px;
  padding: 0 0 0 0;
  margin-bottom: 6px;
  overflow: hidden;
  position: relative;
}

.accent {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 4px;
}

.class-info {
  flex-direction: column;
  flex: 1;
  padding: 10px 14px;
}

.class-name {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 2px;
}

.class-time {
  font-size: 14px;
}

.class-location {
  font-size: 14px;
  padding-right: 14px;
  flex-shrink: 0;
}

.empty-card {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.empty-text {
  font-size: 20px;
}

.empty-hint {
  font-size: 13px;
  margin-top: 8px;
}

.footer-actions {
  flex-direction: row;
  justify-content: center;
  padding: 12px 0 4px 0;
}

.pin-link {
  font-size: 13px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: capsule) {
  .page {
    padding: 44px 8px 12px 8px;
  }
}

@media (shape: rect) {
  .page {
    padding: 44px 6px 6px 6px;
  }
}
</style>