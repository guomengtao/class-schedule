<template>
  <div class="hub-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="&#9664;" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">Demo功能列表</text>
    </div>
    <text class="subtitle" style="color: {{ theme.textMuted }}">选择一种列表风格查看</text>
    <scroll class="grid-scroll" scroll-y="{{true}}">
    <div class="grid">
      <div class="card" for="{{ pages }}" onclick="openPage($idx)" style="background-color: {{ theme.card }}">
        <div class="badge" style="background-color: {{ accents[$idx] }}">
          <text class="badge-text">{{ $idx + 1 }}</text>
        </div>
        <text class="card-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <text class="card-desc" style="color: {{ theme.textMuted }}">{{ $item.desc }}</text>
      </div>
    </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var routes = [
  "demo-animal", "demo-phone", "demo-car", "demo-fruit",
  "demo-color", "demo-city", "demo-music", "demo-sport",
  "demo-book", "demo-movie", "demo-star", "demo-lang",
  "demo-furniture", "demo-reminder"
]

export default {
  private: {
    theme: {},
    pages: [
      { name: "动物", desc: "左侧蓝边 + 圆角" },
      { name: "手机", desc: "胶囊边框 + 居中" },
      { name: "汽车", desc: "粗左竖条 + 淡色底" },
      { name: "水果", desc: "交替行色 + 绿白条纹" },
      { name: "颜色", desc: "底部下划线 + 无圆角" },
      { name: "城市", desc: "虚线边框 + 紫色" },
      { name: "乐器", desc: "不对称裁角 + 橙底" },
      { name: "运动", desc: "上下双边框 + 居中" },
      { name: "书籍", desc: "双线左框 + 古典" },
      { name: "电影", desc: "对角裁切 + 粉色" },
      { name: "星座", desc: "药丸圆角 + 交替行" },
      { name: "语言", desc: "暗色终端 + 绿色高亮" },
      { name: "家具", desc: "极简细边框 + 无色调" },
      { name: "提醒Demo", desc: "5种时间设置方式" }
    ],
    accents: [
      "#7ec8e3", "#e74c3c", "#3498db", "#2ecc71", "#f39c12",
      "#9b59b6", "#e67e22", "#1abc9c", "#34495e", "#e91e63",
      "#ff9800", "#00bcd4", "#795548", "#e91e63"
    ]
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  openPage: function(idx) {
    router.push({
      uri: "pages/" + routes[idx],
      params: {}
    })
  },

  goBack: function() {
    router.back()
  }
}
</script>

<style>
.hub-page {
  flex-direction: column;
  padding: 16px;
  height: 100%;
}
.header {
  flex-direction: row;
  align-items: center;
  padding: 12px 4px;
  margin-bottom: 4px;
}
.back-btn {
  width: 56px;
  height: 44px;
  border-radius: 10px;
  font-size: 18px;
  text-align: center;
}
.title {
  font-size: 28px;
  font-weight: bold;
  margin-left: 10px;
  flex: 1;
}
.subtitle {
  font-size: 16px;
  padding: 0 4px 12px;
  margin-bottom: 4px;
}
.grid-scroll {
  flex: 1;
  flex-direction: column;
}
.grid {
  flex-direction: column;
}
.card {
  flex-direction: row;
  align-items: center;
  border-radius: 14px;
  padding: 20px 16px;
  margin-bottom: 10px;
}
.badge {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.badge-text {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}
.card-name {
  font-size: 24px;
  font-weight: bold;
  margin-left: 14px;
  width: 80px;
}
.card-desc {
  font-size: 16px;
  flex: 1;
}
</style>