<template>
  <div class="page" style="background-color: {{ theme.bg }}">

    <!-- ============ 管理模式：短语管理（点按展开式） ============ -->
    <block if="{{ manageMode }}">
      <div class="back-header">
        <div class="back-btn-wrapper" onclick="toggleManage" style="background-color: {{ theme.card }}">
          <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        </div>
        <text class="header-title" style="color: {{ theme.text }}">短语管理</text>
        <div class="header-placeholder"></div>
      </div>

      <scroll class="list-area">
        <div class="manage-list" style="background-color: {{ theme.card }}">
          <div class="phrase-item" for="{{ phrases }}" style="border-bottom-color: {{ theme.border }}">
            <!-- 默认态：整行就是一个短语按钮，热区足够大 -->
            <div class="phrase-row-full" onclick="tapPhraseRow($idx)"
                 style="background-color: {{ expandedIdx === $idx ? theme.accentBg : 'transparent' }}; border-color: {{ expandedIdx === $idx ? theme.accent : 'transparent' }}">
              <text class="phrase-item-text" lines="1" text-overflow="ellipsis"
                    style="color: {{ expandedIdx === $idx ? theme.accent : theme.text }}">{{ $item }}</text>
            </div>
            <!-- 展开态：编辑 / 删除，等宽热区 -->
            <div class="phrase-ops" if="{{ expandedIdx === $idx }}">
              <div class="phrase-op-btn" onclick="phraseEdit($idx)" style="background-color: {{ theme.cardLight }}">
                <text class="phrase-op-text" style="color: {{ theme.text }}">编辑</text>
              </div>
              <div class="phrase-op-btn" onclick="phraseDelete($idx)" style="background-color: {{ theme.deleteBg }}">
                <text class="phrase-op-text" style="color: {{ theme.deleteText }}">删除</text>
              </div>
            </div>
          </div>
        </div>
        <text class="manage-hint" style="color: {{ theme.textMuted }}">点短语展开操作 · 长按消息置顶</text>
      </scroll>

      <div class="add-btn" onclick="phraseAdd" style="background-color: {{ theme.accent }}">
        <text class="add-btn-text" style="color: {{ theme.bg }}">＋ 新增短语</text>
      </div>
    </block>

    <!-- ============ 对话模式：气泡流 + 回复条 ============ -->
    <block if="{{ !manageMode }}">
      <div class="back-header">
        <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
          <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        </div>
        <text class="header-title" style="color: {{ theme.text }}">留言板</text>
        <div class="manage-entry" onclick="toggleManage" style="background-color: {{ theme.card }}">
          <text class="manage-entry-text" style="color: {{ theme.accent }}">管理</text>
        </div>
      </div>

      <scroll class="list-area">
        <!-- 手机消息：白气泡靠左 -->
        <div class="chat-area" if="{{ messages.length > 0 }}">
          <block for="{{ messages }}">
            <!-- 对方正在输入：虚线预显示气泡（未发送也能看到） -->
            <div class="bubble-row left" if="{{ peerTypingActive && $item.isLastPhone }}">
              <text class="typing-tag" style="color: {{ theme.accent }}">对方正在输入</text>
              <div class="bubble phone-bubble draft-bubble" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
                <text class="bubble-text" style="color: {{ theme.textMuted }}">{{ peerTyping }}</text>
              </div>
            </div>
            <div class="bubble-row {{ $item.from === 'watch' ? 'right' : 'left' }}">
              <text class="bubble-time" style="color: {{ theme.textMuted }}">{{ $item.timeStr }}</text>
              <div class="bubble {{ $item.from === 'watch' ? 'me-bubble' : 'phone-bubble' }}"
                   style="background-color: {{ $item.from === 'watch' ? theme.accentBg : theme.card }}">
                <text class="bubble-text" style="color: {{ $item.read ? ($item.from === 'watch' ? theme.text : theme.textMuted) : theme.text }}">{{ $item.text }}</text>
              </div>
            </div>
          </block>
        </div>

        <div class="empty-state" if="{{ messages.length === 0 && !peerTypingActive }}">
          <text class="empty-text" style="color: {{ theme.textMuted }}">暂无留言</text>
          <text class="empty-hint" style="color: {{ theme.textMuted }}">手机端发送的留言会显示在这里</text>
        </div>
      </scroll>

      <div class="meta-row" if="{{ messages.length > 0 }}">
        <text class="meta-text" style="color: {{ theme.textMuted }}">共 {{ messages.length }} 条 · 未读 {{ unread }}</text>
        <div class="clear-btn" onclick="clearAll" style="background-color: {{ theme.deleteBg }}">
          <text class="clear-btn-text" style="color: {{ theme.deleteText }}">清空</text>
        </div>
      </div>

      <div class="reply-bar" style="background-color: {{ theme.card }}">
        <text class="phone-status" onclick="statusTap" style="color: {{ phoneStatusColor }}">{{ phoneStatus }}</text>
        <div class="phrase-row" style="background-color: {{ theme.cardLight }}">
          <text class="phrase-arrow" style="color: {{ theme.textMuted }}">‹</text>
          <swiper class="phrase-swiper" index="{{ phraseIdx }}" loop="false" onchange="onPhraseSwipe">
            <div class="phrase-slide" for="{{ phrases }}" onclick="sendCurrent">
              <text class="phrase-text" style="color: {{ theme.accent }}">{{ $item }}</text>
            </div>
          </swiper>
          <text class="phrase-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
        <div class="write-btn" onclick="writeReply" style="background-color: {{ theme.accent }}">
          <text class="write-text" style="color: {{ theme.bg }}">自己写…</text>
        </div>
      </div>
    </block>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
var store = require("../../data/store.js")
var msgStore = require("../../data/message-store.js")
var chatBridge = require("../../data/chat-bridge.js")
var replyPhrases = require("../../data/reply-phrases.js")

/** 自己写回复时，中文输入页把结果写进这个 key（返回本页时读走） */
var DRAFT_KEY = "ev_reply_draft"
/** 「等待输入页返回」标记：onShow 靠它区分「首次进入」与「从输入页回来」 */
var AWAITING_KEY = "ev_reply_awaiting"
/** 短语管理的 storage key（存用户自定义短语数组 JSON） */
var PHRASES_KEY = "ev_reply_phrases_custom"
/** 短语编辑态：编辑/新增走中文输入页时用的草稿与标记 key */
var PHRASE_EDIT_KEY = "ev_phrase_edit_draft"
var PHRASE_EDIT_AWAITING = "ev_phrase_edit_awaiting"
/** 短语编辑上下文：-1 = 新增，>=0 = 编辑第 idx 条 */
var PHRASE_EDIT_IDX = "ev_phrase_edit_idx"

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      accentBg: "#12414f",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080"
    },
    messages: [],
    unread: 0,
    phrases: [],
    phraseIdx: 0,
    phoneStatus: "手机状态未知",
    phoneStatusColor: "#888899",
    // P3 输入态：手机正在输入时显示草稿
    peerTyping: "",
    peerTypingActive: false,
    typingTimer: null,
    // v3 短语管理
    manageMode: false,
    expandedIdx: -1
  },

  onInit() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadPhrases()
    self.loadMessages()
    self.refreshPhoneStatus()
  },

  onShow() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadPhrases()
    self.loadMessages()
    self.refreshPhoneStatus()
    // P3：开始轮询「手机是否正在输入」（app.ux 收到 typing 后写 globalThis.__evPeerTyping）
    self.startTypingPoll()
    // 从输入页返回：先看是不是短语编辑回来，再看是不是回复草稿回来
    self.checkPhraseEdit()
    self.checkPendingReply()
  },

  onHide() {
    this.stopTypingPoll()
  },

  onDestroy() {
    this.stopTypingPoll()
  },

  /**
   * P3 输入态轮询：手机端的 typing 是瞬时状态，且 app.ux 与页面 JS 是不同模块副本，
   * globalThis 是唯一跨副本通道 —— 页面按 1s 轮询全局状态并渲染。
   */
  startTypingPoll() {
    var self = this
    this.stopTypingPoll()
    this.typingTimer = setInterval(function () { self.pollPeerTyping() }, 5000)
    self.pollPeerTyping()
  },

  stopTypingPoll() {
    if (this.typingTimer) {
      clearInterval(this.typingTimer)
      this.typingTimer = null
    }
    this.peerTypingActive = false
    this.peerTyping = ""
  },

  pollPeerTyping() {
    var d = null
    try { d = globalThis.__evPeerTyping || null } catch (e) { d = null }
    if (!d) {
      this.peerTypingActive = false
      return
    }
    var now = Date.now()
    var ts = Number(d.ts || 0)
    // stop 态 / 超过 5s 无新包 / 非法 → 不显示（防「卡住一直显示正在输入」）
    if (d.state === "stop" || (ts > 0 && now - ts > 5000)) {
      this.peerTypingActive = false
      return
    }
    var txt = String(d.text || "")
    this.peerTyping = txt.length > 0 ? txt : "正在输入…"
    this.peerTypingActive = true
  },

  updateIconSrc: function (themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadMessages() {
    var self = this
    msgStore.getInbox(function (list) {
      var phoneIds = []
      for (var i = 0; i < list.length; i++) {
        list[i].timeStr = msgStore.formatTime(list[i].ts)
        if (list[i].read === undefined) {
          list[i].read = false
        }
        // 收集「来自手机」的留言 id，供已读回执上报（P2）
        if (list[i].from === "phone" && list[i].id) {
          phoneIds.push(list[i].id)
        }
      }
      list.reverse()
      // 标记「最后一条手机消息」：草稿预显示气泡插在它下面，视觉上才是「正在回这条」
      var lastPhoneIdx = -1
      for (var j = 0; j < list.length; j++) {
        list[j].isLastPhone = false
        if (list[j].from === "phone") { lastPhoneIdx = j }
      }
      if (lastPhoneIdx >= 0 && list[lastPhoneIdx]) {
        list[lastPhoneIdx].isLastPhone = true
      }
      self.messages = list
      self.unread = msgStore.unreadCount(list)
      self.reportRead(phoneIds)
    })
  },

  /**
   * 已读回执（P2）：把「本页刚渲染的、来自手机的留言」id 上报给手机端。
   *
   * 纪律（方案的验收核心）：**只有真正进到本页并渲染后才上报**。
   *   手环没开机 / 没进页面时绝不上报 → 手机端就只能停在「已送达」，这才是真实状态，
   *   绝不允许手机端自己推断「已读」。
   * 幂等：可重复上报，手机端只做「未读 → 已读」单向升级。
   * 上报上限 30 条，避免报文过大。
   */
  reportRead(ids) {
    if (!ids || !ids.length) {
      return
    }
    var slice = ids.length > 30 ? ids.slice(ids.length - 30) : ids
    try {
      chatBridge.sendRead(slice)
    } catch (e) {}
  },

  clearAll() {
    var self = this
    msgStore.clearAll(function () {
      self.loadMessages()
    })
  },

  // ======================= 短语管理（v3） =======================

  /**
   * 加载短语：storage 里的自定义表 merge 默认表。
   * mergePhrases 纯函数有单测覆盖，页面只负责读写 storage。
   */
  loadPhrases() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: PHRASES_KEY,
      success: function (v) {
        self.phrases = replyPhrases.mergePhrases(replyPhrases.parsePhrases(v))
        if (self.phraseIdx >= self.phrases.length) { self.phraseIdx = 0 }
      },
      fail: function () {
        self.phrases = replyPhrases.getPhrases()
      }
    })
  },

  /** 自定义表落盘（只存用户自己的短语，默认表由 merge 兜底） */
  persistPhrases(customList) {
    var storage = require("@system.storage")
    storage.set({
      key: PHRASES_KEY,
      value: replyPhrases.stringifyPhrases(customList),
      fail: function () {}
    })
  },

  toggleManage() {
    this.manageMode = !this.manageMode
    this.expandedIdx = -1
  },

  /** 点按展开式：点行展开操作，同时只展开一行；再点收起 */
  tapPhraseRow(idx) {
    this.expandedIdx = (this.expandedIdx === idx) ? -1 : idx
  },

  /** 编辑：带原值进中文输入页，回来在 checkPhraseEdit 里落盘 */
  phraseEdit(idx) {
    var cur = this.phrases[idx] || ""
    this.setSeq([
      ["chinese_input_title", "编辑短语"],
      ["chinese_input_placeholder", "输入短语"],
      ["chinese_input_value", cur],
      ["chinese_input_maxlen", String(replyPhrases.PHRASE_MAX_LEN)],
      ["chinese_input_return_key", PHRASE_EDIT_KEY],
      [PHRASE_EDIT_KEY, ""],
      [PHRASE_EDIT_AWAITING, "1"],
      [PHRASE_EDIT_IDX, String(idx)]
    ], function () {
      router.push({ uri: "/pages/chinese-input" })
    })
  },

  /** 新增：空值进中文输入页 */
  phraseAdd() {
    if (this.phrases.length >= replyPhrases.PHRASE_MAX_COUNT) {
      prompt.showToast({ message: "最多 " + replyPhrases.PHRASE_MAX_COUNT + " 条" })
      return
    }
    this.setSeq([
      ["chinese_input_title", "新增短语"],
      ["chinese_input_placeholder", "输入短语"],
      ["chinese_input_value", ""],
      ["chinese_input_maxlen", String(replyPhrases.PHRASE_MAX_LEN)],
      ["chinese_input_return_key", PHRASE_EDIT_KEY],
      [PHRASE_EDIT_KEY, ""],
      [PHRASE_EDIT_AWAITING, "1"],
      [PHRASE_EDIT_IDX, "-1"]
    ], function () {
      router.push({ uri: "/pages/chinese-input" })
    })
  },

  /**
   * 删除：以「当前展示表」去掉该条后整体固化为自定义表。
   * 展示表 = 自定义 ∪ 默认，固化后 merge 结果不变；默认短语删掉后也不会被 merge 补回。
   */
  phraseDelete(idx) {
    var table = []
    for (var j = 0; j < this.phrases.length; j++) {
      if (j !== idx) { table.push(this.phrases[j]) }
    }
    this.persistPhrases(table)
    this.loadPhrases()
    this.expandedIdx = -1
  },

  /**
   * 从「短语编辑」输入页返回：读草稿与目标 idx 落盘。
   * 与回复草稿（checkPendingReply）互不干扰，靠各自的 awaiting key 区分。
   */
  checkPhraseEdit() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: PHRASE_EDIT_AWAITING,
      success: function (v) {
        if (String(v === undefined || v === null ? "" : v) !== "1") { return }
        storage.set({ key: PHRASE_EDIT_AWAITING, value: "", fail: function () {} })
        storage.get({
          key: PHRASE_EDIT_IDX,
          success: function (iv) {
            var idx = parseInt(String(iv === undefined || iv === null ? "-1" : iv), 10)
            if (isNaN(idx)) { idx = -1 }
            storage.get({
              key: PHRASE_EDIT_KEY,
              success: function (draft) {
                storage.set({ key: PHRASE_EDIT_KEY, value: "", fail: function () {} })
                var p = replyPhrases.normalizePhrase(draft)
                if (!p) { return }
                // 以「当前展示表」为基础改写后整体固化为自定义表：
                // 展示表 = 自定义 ∪ 默认，固化后 merge 结果不变，行为可预期
                var table = self.phrases.slice(0)
                if (idx >= 0 && idx < table.length) {
                  table[idx] = p
                } else {
                  table.unshift(p)
                }
                self.persistPhrases(table)
                self.loadPhrases()
              },
              fail: function () {}
            })
          },
          fail: function () {}
        })
      },
      fail: function () {}
    })
  },

  // ======================= 回复 =======================

  /** 横滑选择：swiper 的 onchange 带回当前页索引 */
  onPhraseSwipe(e) {
    if (e && typeof e.index === "number") {
      this.phraseIdx = e.index
    }
  },

  /** 点按当前短语：直接发回手机 */
  sendCurrent() {
    var p = this.phrases[this.phraseIdx]
    this.sendPhrase(p)
  },

  /** 点快捷短语：直接发回手机（保留方法名：单测依赖） */
  sendPhrase(phrase) {
    this.doSend(phrase)
  },

  /**
   * 把一条回复发回手机。
   * 走 chatBridge.send（interconnect 点对点，手机端 MessageActivity 按 id 去重后入库并提醒）。
   * 手机收到后会回 rx_ack 应用层回执（app.ux 记「手机最后在线时间」），
   * 所以发送成功 1.5 秒后刷新一次手机在线状态。
   */
  doSend(text) {
    var self = this
    var t = replyPhrases.buildReply(text)
    if (!t) {
      prompt.showToast({ message: "没有可回复的内容" })
      return
    }
    var ok = chatBridge.send(t)
    if (!ok) {
      this.refreshPhoneStatus()
      prompt.showToast({ message: "设备未连接，先在手机端打开 EV 同步" })
      return
    }
    this.appendLocal(t)
    prompt.showToast({ message: "已回复：" + t })
    // 等手机端 rx_ack 回来（通常 1 秒内）再刷新状态
    if (typeof setTimeout === "function") {
      setTimeout(function () { self.refreshPhoneStatus() }, 1500)
    }
  },

  // ======================= 手机在线状态 =======================

  /**
   * 读全局「手机最后在线时间」（app.ux 收到 rx_ack 时写 globalThis）。
   * globalThis 是 app.ux 与页面 JS 之间唯一可靠的跨模块通道
   * （aiot 多入口打包会把共享模块打成多份副本，全局对象不受影响）。
   */
  refreshPhoneStatus() {
    var ts = 0
    try {
      ts = Number(globalThis.__evSyncPhoneSeenTs || 0)
    } catch (e) { ts = 0 }
    if (!ts) {
      this.phoneStatus = "手机未连接"
      this.phoneStatusColor = "#888899"
      return
    }
    var d = Date.now() - ts
    if (d < 60000) {
      this.phoneStatus = "手机在线 · 刚刚确认"
      this.phoneStatusColor = "#8fd6a0"
    } else if (d < 3600000) {
      this.phoneStatus = "手机在线 · " + Math.floor(d / 60000) + "分钟前"
      this.phoneStatusColor = "#8fd6a0"
    } else {
      var t = new Date(ts)
      var hh = ("0" + t.getHours()).slice(-2)
      var mm = ("0" + t.getMinutes()).slice(-2)
      this.phoneStatus = "手机在线 · " + hh + ":" + mm
      this.phoneStatusColor = "#8fd6a0"
    }
  },

  /** 点状态文字手动刷新 */
  statusTap() {
    this.refreshPhoneStatus()
  },

  /** 发出的回复也在本页留一条（标 from=watch），便于回看自己回过什么 */
  appendLocal(text) {
    var self = this
    var storage = require("@system.storage")
    // ⚠️ key 不存在时 storage.get 走 fail —— fail 里必须同样落盘，
    //    否则「第一次回复」永远不生成收件箱，用户看不到自己发过什么。
    function write(oldVal) {
      var list = []
      try { list = JSON.parse(oldVal || "[]") } catch (e) { list = [] }
      list.push({
        id: String(Date.now()) + "-r" + Math.random().toString(36).slice(2, 6),
        from: "watch",
        text: text,
        ts: Date.now(),
        read: true
      })
      if (list.length > 50) { list = list.slice(list.length - 50) }
      storage.set({
        key: "ev_chat_inbox",
        value: JSON.stringify(list),
        success: function () { self.loadMessages() },
        fail: function () {}
      })
    }
    storage.get({
      key: "ev_chat_inbox",
      success: function (val) { write(val) },
      fail: function () { write(null) }
    })
  },

  /** 「自己写…」：配置好中文输入页的参数后跳过去，回来时在 onShow 里取草稿 */
  writeReply() {
    this.setSeq([
      ["chinese_input_title", "回复留言"],
      ["chinese_input_placeholder", "输入回复内容"],
      ["chinese_input_value", ""],
      ["chinese_input_maxlen", "20"],
      ["chinese_input_return_key", DRAFT_KEY],
      [DRAFT_KEY, ""],
      [AWAITING_KEY, "1"]
    ], function () {
      router.push({ uri: "/pages/chinese-input" })
    })
  },

  /**
   * 检查是否有「自己写」的草稿待发。
   * onShow 在首次进入时也会触发，所以必须先看标记，避免把上一次的旧草稿重复发出去。
   */
  checkPendingReply() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: AWAITING_KEY,
      success: function (v) {
        if (String(v === undefined || v === null ? "" : v) !== "1") {
          return
        }
        storage.set({ key: AWAITING_KEY, value: "", fail: function () {} })
        storage.get({
          key: DRAFT_KEY,
          success: function (draft) {
            storage.set({ key: DRAFT_KEY, value: "", fail: function () {} })
            var t = replyPhrases.buildReply(draft)
            if (t) {
              self.doSend(t)
            }
          },
          fail: function () {}
        })
      },
      fail: function () {}
    })
  },

  /**
   * 串行写 storage。
   * 快应用的 storage.set 是异步的（带 success/fail 回调），并发调用时完成顺序无法保证 ——
   * 「自己写」要写 7 个 key，若并发写就可能出现输入页读到旧标题/旧结果的竞态。
   */
  setSeq(items, done) {
    var storage = require("@system.storage")
    var i = 0
    function next() {
      if (i >= items.length) {
        if (typeof done === "function") { done() }
        return
      }
      var pair = items[i]
      i++
      storage.set({ key: pair[0], value: pair[1], success: next, fail: next })
    }
    next()
  },

  goBack() {
    router.back()
  }
}
</script>

