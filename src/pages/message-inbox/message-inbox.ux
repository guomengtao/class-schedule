<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">留言板</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 消息区：可滚动查看全部留言 -->
    <scroll class="list-area">
      <div class="section" style="background-color: {{ theme.card }}" if="{{ messages.length > 0 }}">
        <div class="item-row" for="{{ messages }}" onclick="toggleRead($item.id)">
          <div class="msg-line">
            <div class="unread-dot" style="background-color: {{ $item.read ? 'transparent' : theme.accent }}"></div>
            <text class="msg-from" if="{{ $item.from === 'watch' }}" style="color: {{ theme.accent }}">我：</text>
            <text class="msg-text" style="color: {{ $item.read ? theme.textMuted : theme.text }}">{{ $item.text }}</text>
          </div>
          <text class="msg-time" style="color: {{ theme.textMuted }}">{{ $item.timeStr }}</text>
        </div>
      </div>

      <div class="empty-state" if="{{ messages.length === 0 }}">
        <text class="empty-icon">📭</text>
        <text class="empty-text" style="color: {{ theme.textMuted }}">暂无留言</text>
        <text class="empty-hint" style="color: {{ theme.textMuted }}">手机端发送的留言会显示在这里</text>
      </div>
    </scroll>

    <!-- 统计行 -->
    <div class="meta-row" if="{{ messages.length > 0 }}">
      <text class="meta-text" style="color: {{ theme.textMuted }}">共 {{ messages.length }} 条 · 未读 {{ unread }}</text>
      <div class="clear-btn" onclick="clearAll" style="background-color: {{ theme.deleteBg }}">
        <text class="clear-btn-text" style="color: {{ theme.deleteText }}">清空</text>
      </div>
    </div>

    <!-- 回复区：手机在线状态 + 快捷短语（横滑选择，点按发送）+ 自己写 -->
    <div class="reply-bar" style="background-color: {{ theme.card }}">
      <text class="phone-status" onclick="statusTap" style="color: {{ phoneStatusColor }}">{{ phoneStatus }}</text>
      <div class="phrase-row" style="background-color: {{ theme.cardLight }}">
        <text class="phrase-arrow" style="color: {{ theme.textMuted }}">‹</text>
        <swiper class="phrase-swiper" index="{{ phraseIdx }}" loop="false" onchange="onPhraseSwipe">
          <div class="phrase-slide" for="{{ phrases }}" onclick="sendCurrent">
            <text class="phrase-text" style="color: {{ theme.accent }}">{{ $item }}</text>
          </div>
        </swiper>
        <text class="phrase-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>
      <div class="write-btn" onclick="writeReply" style="background-color: {{ theme.accent }}">
        <text class="write-text" style="color: {{ theme.bg }}">自己写…</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
var store = require("../../data/store.js")
var msgStore = require("../../data/message-store.js")
var chatBridge = require("../../data/chat-bridge.js")
var replyPhrases = require("../../data/reply-phrases.js")

/** 自己写回复时，中文输入页把结果写进这个 key（返回本页时读走） */
var DRAFT_KEY = "ev_reply_draft"
/** 「等待输入页返回」标记：onShow 靠它区分「首次进入」与「从输入页回来」 */
var AWAITING_KEY = "ev_reply_awaiting"

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080"
    },
    messages: [],
    unread: 0,
    phrases: [],
    phraseIdx: 0,
    phoneStatus: "手机状态未知",
    phoneStatusColor: "#888899"
  },

  onInit() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    // 短语表来自数据模块（有单测覆盖），页面只负责渲染与发送
    self.phrases = replyPhrases.getPhrases()
    self.loadMessages()
    self.refreshPhoneStatus()
  },

  onShow() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadMessages()
    self.refreshPhoneStatus()
    // 从「自己写」输入页返回时，把草稿发出去
    self.checkPendingReply()
  },

  updateIconSrc: function (themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadMessages() {
    var self = this
    msgStore.getInbox(function (list) {
      for (var i = 0; i < list.length; i++) {
        list[i].timeStr = msgStore.formatTime(list[i].ts)
        if (list[i].read === undefined) {
          list[i].read = false
        }
      }
      list.reverse()
      self.messages = list
      self.unread = msgStore.unreadCount(list)
    })
  },

  toggleRead(id) {
    var self = this
    msgStore.toggleRead(id, function () {
      self.loadMessages()
    })
  },

  clearAll() {
    var self = this
    msgStore.clearAll(function () {
      self.loadMessages()
    })
  },

  // ======================= 回复 =======================

  /** 横滑选择：swiper 的 onchange 带回当前页索引 */
  onPhraseSwipe(e) {
    if (e && typeof e.index === "number") {
      this.phraseIdx = e.index
    }
  },

  /** 点按当前短语：直接发回手机 */
  sendCurrent() {
    var p = this.phrases[this.phraseIdx]
    this.sendPhrase(p)
  },

  /** 点快捷短语：直接发回手机（保留方法名：单测依赖） */
  sendPhrase(phrase) {
    this.doSend(phrase)
  },

  /**
   * 把一条回复发回手机。
   * 走 chatBridge.send（interconnect 点对点，手机端 MessageActivity 按 id 去重后入库并提醒）。
   * 手机收到后会回 rx_ack 应用层回执（app.ux 记「手机最后在线时间」），
   * 所以发送成功 1.5 秒后刷新一次手机在线状态。
   */
  doSend(text) {
    var self = this
    var t = replyPhrases.buildReply(text)
    if (!t) {
      prompt.showToast({ message: "没有可回复的内容" })
      return
    }
    var ok = chatBridge.send(t)
    if (!ok) {
      this.refreshPhoneStatus()
      prompt.showToast({ message: "设备未连接，先在手机端打开 EV 同步" })
      return
    }
    this.appendLocal(t)
    prompt.showToast({ message: "已回复：" + t })
    // 等手机端 rx_ack 回来（通常 1 秒内）再刷新状态
    if (typeof setTimeout === "function") {
      setTimeout(function () { self.refreshPhoneStatus() }, 1500)
    }
  },

  // ======================= 手机在线状态 =======================

  /**
   * 读全局「手机最后在线时间」（app.ux 收到 rx_ack 时写 globalThis）。
   * globalThis 是 app.ux 与页面 JS 之间唯一可靠的跨模块通道
   * （aiot 多入口打包会把共享模块打成多份副本，全局对象不受影响）。
   */
  refreshPhoneStatus() {
    var ts = 0
    try {
      ts = Number(globalThis.__evSyncPhoneSeenTs || 0)
    } catch (e) { ts = 0 }
    if (!ts) {
      this.phoneStatus = "手机未连接"
      this.phoneStatusColor = "#888899"
      return
    }
    var d = Date.now() - ts
    if (d < 60000) {
      this.phoneStatus = "手机在线 · 刚刚确认"
      this.phoneStatusColor = "#8fd6a0"
    } else if (d < 3600000) {
      this.phoneStatus = "手机在线 · " + Math.floor(d / 60000) + "分钟前"
      this.phoneStatusColor = "#8fd6a0"
    } else {
      var t = new Date(ts)
      var hh = ("0" + t.getHours()).slice(-2)
      var mm = ("0" + t.getMinutes()).slice(-2)
      this.phoneStatus = "手机在线 · " + hh + ":" + mm
      this.phoneStatusColor = "#8fd6a0"
    }
  },

  /** 点状态文字手动刷新 */
  statusTap() {
    this.refreshPhoneStatus()
  },

  /** 发出的回复也在本页留一条（标 from=watch），便于回看自己回过什么 */
  appendLocal(text) {
    var self = this
    var storage = require("@system.storage")
    // ⚠️ key 不存在时 storage.get 走 fail —— fail 里必须同样落盘，
    //    否则「第一次回复」永远不生成收件箱，用户看不到自己发过什么。
    function write(oldVal) {
      var list = []
      try { list = JSON.parse(oldVal || "[]") } catch (e) { list = [] }
      list.push({
        id: String(Date.now()) + "-r" + Math.random().toString(36).slice(2, 6),
        from: "watch",
        text: text,
        ts: Date.now(),
        read: true
      })
      if (list.length > 50) { list = list.slice(list.length - 50) }
      storage.set({
        key: "ev_chat_inbox",
        value: JSON.stringify(list),
        success: function () { self.loadMessages() },
        fail: function () {}
      })
    }
    storage.get({
      key: "ev_chat_inbox",
      success: function (val) { write(val) },
      fail: function () { write(null) }
    })
  },

  /** 「自己写…」：配置好中文输入页的参数后跳过去，回来时在 onShow 里取草稿 */
  writeReply() {
    this.setSeq([
      ["chinese_input_title", "回复留言"],
      ["chinese_input_placeholder", "输入回复内容"],
      ["chinese_input_value", ""],
      ["chinese_input_maxlen", "20"],
      ["chinese_input_return_key", DRAFT_KEY],
      [DRAFT_KEY, ""],
      [AWAITING_KEY, "1"]
    ], function () {
      router.push({ uri: "/pages/chinese-input" })
    })
  },

  /**
   * 检查是否有「自己写」的草稿待发。
   * onShow 在首次进入时也会触发，所以必须先看标记，避免把上一次的旧草稿重复发出去。
   */
  checkPendingReply() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: AWAITING_KEY,
      success: function (v) {
        if (String(v === undefined || v === null ? "" : v) !== "1") {
          return
        }
        storage.set({ key: AWAITING_KEY, value: "", fail: function () {} })
        storage.get({
          key: DRAFT_KEY,
          success: function (draft) {
            storage.set({ key: DRAFT_KEY, value: "", fail: function () {} })
            var t = replyPhrases.buildReply(draft)
            if (t) {
              self.doSend(t)
            }
          },
          fail: function () {}
        })
      },
      fail: function () {}
    })
  },

  /**
   * 串行写 storage。
   * 快应用的 storage.set 是异步的（带 success/fail 回调），并发调用时完成顺序无法保证 ——
   * 「自己写」要写 7 个 key，若并发写就可能出现输入页读到旧标题/旧结果的竞态。
   */
  setSeq(items, done) {
    var storage = require("@system.storage")
    var i = 0
    function next() {
      if (i >= items.length) {
        if (typeof done === "function") { done() }
        return
      }
      var pair = items[i]
      i++
      storage.set({ key: pair[0], value: pair[1], success: next, fail: next })
    }
    next()
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 42px;
  lines: 1;
  text-overflow: ellipsis;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.list-area {
  flex: 1;
  flex-direction: column;
}

.section {
  flex-direction: column;
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 10px;
}

/* 行高加大：胶囊屏小字易挤，正文 1.6 倍行距 */
.item-row {
  flex-direction: column;
  padding: 18px 0;
  border-bottom-width: 1px;
  border-bottom-color: #0f3460;
}

.msg-line {
  flex-direction: row;
  align-items: flex-start;
}

.unread-dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 10px;
  margin-top: 20px;
  flex-shrink: 0;
}

.msg-from {
  font-size: 28px;
  line-height: 50px;
  margin-right: 4px;
  flex-shrink: 0;
}

.msg-text {
  font-size: 32px;
  line-height: 50px;
  flex: 1;
}

.msg-time {
  font-size: 24px;
  line-height: 34px;
  margin-top: 6px;
  padding-left: 20px;
}

.empty-state {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 56px;
  padding-bottom: 40px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 32px;
  line-height: 48px;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 24px;
  line-height: 38px;
  text-align: center;
}

.meta-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 6px 4px;
}

.meta-text {
  font-size: 24px;
  line-height: 34px;
}

.clear-btn {
  padding: 6px 18px;
  border-radius: 8px;
}

.clear-btn-text {
  font-size: 26px;
  line-height: 36px;
}

.reply-bar {
  flex-direction: column;
  border-radius: 12px;
  padding: 12px 12px 14px 12px;
  margin-top: 4px;
}

.phone-status {
  font-size: 22px;
  line-height: 32px;
  margin-bottom: 10px;
}

/* 横滑短语：一行，左右滑切换，点按发送 */
.phrase-row {
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
  height: 72px;
}

.phrase-arrow {
  font-size: 36px;
  width: 34px;
  text-align: center;
  flex-shrink: 0;
}

.phrase-swiper {
  flex: 1;
  height: 72px;
}

.phrase-slide {
  width: 100%;
  height: 72px;
  justify-content: center;
  align-items: center;
}

.phrase-text {
  font-size: 30px;
  line-height: 44px;
  lines: 1;
  text-overflow: ellipsis;
}

.write-btn {
  height: 60px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
}

.write-text {
  font-size: 28px;
  line-height: 40px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    margin-bottom: 8px;
    padding: 0 4px;
    justify-content: center;
  }
  .back-btn-wrapper {
    width: 52px;
    height: 40px;
  }
  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
  .msg-text {
    font-size: 28px;
    line-height: 44px;
  }
  .msg-from {
    line-height: 44px;
  }
  .phrase-row {
    height: 66px;
  }
  .phrase-swiper,
  .phrase-slide {
    height: 66px;
  }
  .phrase-text,
  .write-text {
    font-size: 26px;
    line-height: 38px;
  }
}

@media (shape: pill-shaped) {
  .page {
    padding: 30px 16px 30px 16px;
  }
  .back-header {
    padding: 0 4px;
  }
  .back-btn-wrapper {
    width: 36px;
    height: 36px;
  }
  .header-placeholder {
    width: 34px;
  }
  .header-title {
    font-size: 20px;
    line-height: 28px;
  }
  .section {
    padding: 10px 10px;
  }
  .item-row {
    padding: 16px 0;
  }
  .msg-text {
    font-size: 32px;
    line-height: 48px;
    lines: 2;
    text-overflow: ellipsis;
  }
  .msg-from {
    font-size: 28px;
    line-height: 48px;
  }
  .msg-time {
    font-size: 22px;
    line-height: 32px;
  }
  .meta-text {
    font-size: 22px;
    line-height: 30px;
  }
  .clear-btn-text {
    font-size: 26px;
    line-height: 36px;
  }
  .phone-status {
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 8px;
  }
  .phrase-row {
    height: 64px;
  }
  .phrase-swiper,
  .phrase-slide {
    height: 64px;
  }
  .phrase-text {
    font-size: 28px;
    line-height: 42px;
  }
  .write-text {
    font-size: 26px;
    line-height: 38px;
  }
  .write-btn {
    height: 56px;
    margin-top: 8px;
  }
}
</style>
