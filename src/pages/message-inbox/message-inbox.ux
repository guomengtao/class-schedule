<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">留言板</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}" if="{{ messages.length > 0 }}">
      <div class="item-row" for="{{ messages }}" onclick="toggleRead($item.id)">
        <div class="msg-left">
          <div class="unread-dot" style="background-color: {{ $item.read ? 'transparent' : theme.accent }}"></div>
          <text class="msg-text" style="color: {{ $item.read ? theme.textMuted : theme.text }}">{{ $item.text }}</text>
        </div>
        <div class="msg-right">
          <text class="msg-time" style="color: {{ theme.textMuted }}">{{ $item.timeStr }}</text>
        </div>
      </div>
    </div>

    <div class="empty-state" if="{{ messages.length === 0 }}">
      <text class="empty-icon">📭</text>
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无留言</text>
      <text class="empty-hint" style="color: {{ theme.textMuted }}">手机端发送的留言会显示在这里</text>
    </div>

    <div class="action-row" if="{{ messages.length > 0 }}">
      <text class="action-text" style="color: {{ theme.textMuted }}">共 {{ messages.length }} 条，{{ unread }} 条未读</text>
      <div class="clear-btn" onclick="clearAll" style="background-color: {{ theme.deleteBg }}">
        <text class="clear-btn-text" style="color: {{ theme.deleteText }}">清空</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var store = require("../../data/store.js")
var msgStore = require("../../data/message-store.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a",
      deleteBg: "#2a1a3e",
      deleteText: "#e08080"
    },
    messages: [],
    unread: 0
  },

  onInit() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadMessages()
  },

  onShow() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadMessages()
  },

  updateIconSrc: function (themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadMessages() {
    var self = this
    msgStore.getInbox(function (list) {
      for (var i = 0; i < list.length; i++) {
        list[i].timeStr = msgStore.formatTime(list[i].ts)
        if (list[i].read === undefined) {
          list[i].read = false
        }
      }
      list.reverse()
      self.messages = list
      self.unread = msgStore.unreadCount(list)
    })
  },

  toggleRead(id) {
    var self = this
    msgStore.toggleRead(id, function () {
      self.loadMessages()
    })
  },

  clearAll() {
    var self = this
    msgStore.clearAll(function () {
      self.loadMessages()
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 10px 12px 10px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  lines: 1;
  text-overflow: ellipsis;
}

.header-placeholder {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.section {
  flex-direction: column;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 14px;
  flex: 1;
}

.item-row {
  flex-direction: column;
  padding: 14px 0;
  border-bottom-width: 1px;
  border-bottom-color: #0f3460;
}

.msg-left {
  flex-direction: row;
  align-items: center;
}

.unread-dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 10px;
  flex-shrink: 0;
}

.msg-text {
  font-size: 32px;
  line-height: 44px;
  flex: 1;
}

.msg-right {
  margin-top: 6px;
  padding-left: 20px;
}

.msg-time {
  font-size: 24px;
  line-height: 32px;
}

.empty-state {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 32px;
  line-height: 44px;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
}

.action-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 4px;
}

.action-text {
  font-size: 24px;
  line-height: 34px;
}

.clear-btn {
  padding: 8px 20px;
  border-radius: 8px;
}

.clear-btn-text {
  font-size: 28px;
  line-height: 38px;
}

@media screen and (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  .back-header {
    margin-bottom: 8px;
    padding: 0 4px;
    justify-content: center;
  }
  .back-btn-wrapper {
    width: 52px;
    height: 40px;
  }
  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
  .msg-text {
    font-size: 28px;
    line-height: 38px;
  }
}

@media screen and (shape: pill-shaped) {
  .page {
    padding: 30px 16px 30px 16px;
  }
  .back-header {
    padding: 0 4px;
  }
  .back-btn-wrapper {
    width: 36px;
    height: 36px;
  }
  .header-placeholder {
    width: 34px;
  }
  .header-title {
    font-size: 20px;
    line-height: 28px;
  }
  .section {
    padding: 12px 10px;
  }
  .item-row {
    padding: 14px 0;
  }
  .msg-text {
    font-size: 32px;
    line-height: 44px;
    lines: 2;
    text-overflow: ellipsis;
  }
  .msg-time {
    font-size: 22px;
    line-height: 30px;
  }
  .action-text {
    font-size: 22px;
    line-height: 30px;
  }
  .clear-btn-text {
    font-size: 26px;
    line-height: 36px;
  }
  .empty-icon {
    font-size: 40px;
  }
  .empty-text {
    font-size: 28px;
    line-height: 38px;
  }
  .empty-hint {
    font-size: 22px;
    line-height: 30px;
  }
}
</style>