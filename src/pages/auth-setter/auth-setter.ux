<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">授权数据设置</text>
    </div>

    <div class="scroll-area">
      <text class="section-desc" style="color: {{ theme.textSecondary }}">直接修改 @system.storage 中的 auth_data 和 premium_unlocked。</text>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.accent }}">当前状态</text>
        <text class="status-text" style="color: {{ theme.text }}">状态: {{ currentStatus }}</text>
        <text class="status-text" style="color: {{ theme.textSecondary }}">isActivated: {{ currentAuth.isActivated }}</text>
        <text class="status-text" style="color: {{ theme.textSecondary }}">isPermanent: {{ currentAuth.isPermanent }}</text>
        <text class="status-text" style="color: {{ theme.textSecondary }}">expireAt: {{ expireDisplay }}</text>
        <text class="status-text" style="color: {{ theme.textSecondary }}">deviceId: {{ currentAuth.deviceId || 'none' }}</text>
        <text class="status-text" style="color: {{ theme.textSecondary }}">history: {{ historyCount }} entries</text>
      </div>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.accent }}">快速设置</text>
        <text class="card-hint" style="color: {{ theme.textMuted }}">点击按钮直接修改授权数据</text>

        <input class="action-btn" type="button" value="标准版 (无授权)" onclick="setStandard"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
        <input class="action-btn" type="button" value="永久激活版" onclick="setPermanent"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="action-btn" type="button" value="1个月高级版" onclick="setMonths(1)"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="action-btn" type="button" value="3个月高级版" onclick="setMonths(3)"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="action-btn" type="button" value="6个月高级版" onclick="setMonths(6)"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="action-btn" type="button" value="12个月高级版" onclick="setMonths(12)"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="action-btn" type="button" value="30天高级版" onclick="setDays(30)"
               style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
        <input class="action-btn" type="button" value="已过期 (3天前)" onclick="setExpired"
               style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}" />
        <input class="action-btn" type="button" value="试用期 (未激活)" onclick="setTrial"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.accent }}">清除记录</text>
        <text class="card-hint" style="color: {{ theme.textMuted }}">软删除激活记录（不影响授权状态）</text>

        <input class="action-btn small" type="button" value="清除已用激活码" onclick="clearUsedCodes"
               style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}" />
        <input class="action-btn small" type="button" value="清除已用兑换码" onclick="clearUsedRedeem"
               style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}" />
        <input class="action-btn small" type="button" value="清除万能码记录" onclick="clearMasterUsage"
               style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}" />
        <input class="action-btn small" type="button" value="清除全部授权" onclick="clearAll"
               style="background-color: {{ theme.deleteText }}; color: {{ theme.bg }}" />
      </div>

      <div class="card" style="background-color: {{ theme.card }}">
        <text class="card-title" style="color: {{ theme.accent }}">JSON 导入</text>
        <text class="card-hint" style="color: {{ theme.textMuted }}">粘贴由 scripts/set-auth.js 生成的 JSON，点击应用</text>
        <textarea class="json-input" style="background-color: {{ theme.bg }}; color: {{ theme.text }}; border-color: {{ theme.border }}"
                  placeholder='{"keys":{"auth_data":"...","premium_unlocked":"true"}}'
                  onchange="onJsonChange"></textarea>
        <input class="action-btn" type="button" value="应用 JSON" onclick="applyJson"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <text class="json-result" if="{{ jsonResult }}" style="color: {{ jsonResultColor }}">{{ jsonResult }}</text>
      </div>

      <div class="footer-space"></div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import storage from "@system.storage"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")

var AUTH_KEY = "auth_data"
var PREMIUM_KEY = "premium_unlocked"
var USED_CODES_KEY = "used_codes"
var USED_REDEEM_KEY = "used_redeem"
var MASTER_USAGE_KEY = "master_usage"

function now() {
  return Date.now()
}

function daysToMs(days) {
  return days * 24 * 60 * 60 * 1000
}

function formatDate(ts) {
  if (!ts) return "none"
  var d = new Date(ts)
  var y = d.getFullYear()
  var m = String(d.getMonth() + 1)
  if (m.length < 2) m = "0" + m
  var day = String(d.getDate())
  if (day.length < 2) day = "0" + day
  return y + "-" + m + "-" + day
}

function addHistoryEntry(data, type, duration, codeType, status, activationCode) {
  if (!data.history) data.history = []
  data.history.unshift({
    id: String(now()),
    timestamp: now(),
    date: formatDate(now()),
    type: type,
    duration: duration,
    codeType: codeType,
    status: status,
    activationCode: activationCode || "",
    redeemCode: ""
  })
  if (data.history.length > 50) {
    data.history = data.history.slice(0, 50)
  }
}

export default {
  private: {
    theme: {},
    currentStatus: "loading...",
    currentAuth: {},
    expireDisplay: "loading...",
    historyCount: 0,
    jsonInput: "",
    jsonResult: "",
    jsonResultColor: "#7ec8e3"
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.refresh()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.refresh()
  },

  refresh() {
    var self = this
    authStore.getFullStatus(function(status) {
      self.currentStatus = status.text
      self.currentAuth = {
        isActivated: status.isActivated,
        isPermanent: status.isPermanent
      }
      self.expireDisplay = status.expireAt ? formatDate(status.expireAt) : "none"
    })

    authStore.getAuthData(function(data) {
      if (data) {
        self.currentAuth = data
        self.historyCount = data.history ? data.history.length : 0
        self.expireDisplay = data.expireAt ? formatDate(data.expireAt) : (data.isPermanent ? "permanent" : "none")
        if (data.isPermanent) {
          self.currentStatus = "高级版 永久有效"
        } else if (data.isActivated && data.expireAt) {
          var remaining = Math.ceil((data.expireAt - now()) / daysToMs(1))
          if (remaining <= 0) {
            self.currentStatus = "高级版 已过期"
          } else {
            self.currentStatus = "高级版 剩余 " + remaining + " 天"
          }
        } else {
          self.currentStatus = "标准版"
        }
      }
    })
  },

  saveAuth(data, premiumValue, callback) {
    storage.set({
      key: AUTH_KEY,
      value: JSON.stringify(data),
      success: function() {
        if (premiumValue !== undefined) {
          storage.set({
            key: PREMIUM_KEY,
            value: premiumValue,
            success: function() { if (callback) callback() },
            fail: function() { if (callback) callback() }
          })
        } else {
          if (callback) callback()
        }
      },
      fail: function() {
        prompt.showToast({ message: "save failed" })
        if (callback) callback()
      }
    })
  },

  setStandard() {
    var self = this
    authStore.getAuthData(function(oldData) {
      var data = {
        installTime: oldData ? oldData.installTime : now(),
        isActivated: false,
        isPermanent: false,
        expireAt: null,
        activatedAt: null,
        lastRemindDate: "",
        remindEnabled: true,
        trialDays: 7,
        productId: oldData ? oldData.productId : "0001",
        deviceId: oldData ? oldData.deviceId : "",
        history: oldData ? oldData.history : []
      }
      addHistoryEntry(data, "set", "standard", "manual", "success", "MANUAL-STANDARD")
      self.saveAuth(data, "false", function() {
        prompt.showToast({ message: "已设为标准版" })
        self.refresh()
      })
    })
  },

  setPermanent() {
    var self = this
    authStore.getAuthData(function(oldData) {
      var data = {
        installTime: oldData ? oldData.installTime : now(),
        isActivated: true,
        isPermanent: true,
        expireAt: null,
        activatedAt: now(),
        lastRemindDate: "",
        remindEnabled: true,
        trialDays: 7,
        productId: oldData ? oldData.productId : "0001",
        deviceId: oldData ? oldData.deviceId : "",
        history: oldData ? oldData.history : []
      }
      addHistoryEntry(data, "set", "permanent", "permanent", "success", "MANUAL-PERMANENT")
      self.saveAuth(data, "true", function() {
        prompt.showToast({ message: "已设为永久激活" })
        self.refresh()
      })
    })
  },

  setMonths(months) {
    var self = this
    var days = months * 30
    authStore.getAuthData(function(oldData) {
      var data = {
        installTime: oldData ? oldData.installTime : now(),
        isActivated: true,
        isPermanent: false,
        expireAt: now() + daysToMs(days),
        activatedAt: now(),
        lastRemindDate: "",
        remindEnabled: true,
        trialDays: 7,
        productId: oldData ? oldData.productId : "0001",
        deviceId: oldData ? oldData.deviceId : "",
        history: oldData ? oldData.history : []
      }
      addHistoryEntry(data, "set", months + "months", "standard", "success", "MANUAL-" + months + "MONTHS")
      self.saveAuth(data, "true", function() {
        prompt.showToast({ message: "已设为" + months + "个月高级版" })
        self.refresh()
      })
    })
  },

  setDays(days) {
    var self = this
    authStore.getAuthData(function(oldData) {
      var data = {
        installTime: oldData ? oldData.installTime : now(),
        isActivated: true,
        isPermanent: false,
        expireAt: now() + daysToMs(days),
        activatedAt: now(),
        lastRemindDate: "",
        remindEnabled: true,
        trialDays: 7,
        productId: oldData ? oldData.productId : "0001",
        deviceId: oldData ? oldData.deviceId : "",
        history: oldData ? oldData.history : []
      }
      addHistoryEntry(data, "set", days + "d", "standard", "success", "MANUAL-" + days + "DAYS")
      self.saveAuth(data, "true", function() {
        prompt.showToast({ message: "已设为" + days + "天高级版" })
        self.refresh()
      })
    })
  },

  setExpired() {
    var self = this
    authStore.getAuthData(function(oldData) {
      var data = {
        installTime: oldData ? oldData.installTime : now() - daysToMs(60),
        isActivated: true,
        isPermanent: false,
        expireAt: now() - daysToMs(3),
        activatedAt: now() - daysToMs(33),
        lastRemindDate: "",
        remindEnabled: true,
        trialDays: 7,
        productId: oldData ? oldData.productId : "0001",
        deviceId: oldData ? oldData.deviceId : "",
        history: oldData ? oldData.history : []
      }
      addHistoryEntry(data, "set", "expired", "standard", "success", "MANUAL-EXPIRED")
      self.saveAuth(data, "false", function() {
        prompt.showToast({ message: "已设为已过期" })
        self.refresh()
      })
    })
  },

  setTrial() {
    var self = this
    authStore.getAuthData(function(oldData) {
      var data = {
        installTime: now(),
        isActivated: false,
        isPermanent: false,
        expireAt: null,
        activatedAt: null,
        lastRemindDate: "",
        remindEnabled: true,
        trialDays: 7,
        productId: oldData ? oldData.productId : "0001",
        deviceId: oldData ? oldData.deviceId : "",
        history: oldData ? oldData.history : []
      }
      addHistoryEntry(data, "set", "trial", "trial", "success", "MANUAL-TRIAL")
      self.saveAuth(data, "false", function() {
        prompt.showToast({ message: "已重置为试用期" })
        self.refresh()
      })
    })
  },

  clearUsedCodes() {
    storage.set({
      key: USED_CODES_KEY,
      value: "[]",
      success: function() {
        prompt.showToast({ message: "已清除已用激活码" })
      }
    })
  },

  clearUsedRedeem() {
    storage.set({
      key: USED_REDEEM_KEY,
      value: "[]",
      success: function() {
        prompt.showToast({ message: "已清除已用兑换码" })
      }
    })
  },

  clearMasterUsage() {
    storage.set({
      key: MASTER_USAGE_KEY,
      value: "[]",
      success: function() {
        prompt.showToast({ message: "已清除万能码记录" })
      }
    })
  },

  clearAll() {
    var self = this
    storage.delete({
      key: AUTH_KEY,
      success: function() {
        storage.delete({
          key: PREMIUM_KEY,
          success: function() {
            prompt.showToast({ message: "已清除全部授权" })
            self.refresh()
          },
          fail: function() {
            prompt.showToast({ message: "已清除全部授权" })
            self.refresh()
          }
        })
      },
      fail: function() {
        prompt.showToast({ message: "清除失败" })
      }
    })
  },

  onJsonChange(e) {
    this.jsonInput = e.value || e.text || ""
  },

  applyJson() {
    var self = this
    if (!self.jsonInput || self.jsonInput.trim() === "") {
      self.jsonResult = "please paste JSON first"
      self.jsonResultColor = "#e08080"
      return
    }

    var parsed
    try {
      parsed = JSON.parse(self.jsonInput)
    } catch (e) {
      self.jsonResult = "invalid JSON: " + e.message
      self.jsonResultColor = "#e08080"
      return
    }

    if (!parsed.keys || typeof parsed.keys !== "object") {
      self.jsonResult = "missing 'keys' object in JSON"
      self.jsonResultColor = "#e08080"
      return
    }

    var keys = parsed.keys
    var keyList = Object.keys(keys)
    var total = keyList.length
    var done = 0
    var errors = []

    function applyNext() {
      if (done >= total) {
        if (errors.length > 0) {
          self.jsonResult = "applied " + (total - errors.length) + "/" + total + " keys. errors: " + errors.join(", ")
          self.jsonResultColor = "#d4a017"
        } else {
          self.jsonResult = "applied " + total + " keys successfully"
          self.jsonResultColor = "#7ec8a0"
        }
        self.refresh()
        return
      }

      var key = keyList[done]
      var value = keys[key]
      done++

      storage.set({
        key: key,
        value: value,
        success: function() {
          applyNext()
        },
        fail: function() {
          errors.push(key)
          applyNext()
        }
      })
    }

    applyNext()
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
}

.header {
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
}

.back-btn {
  width: 64px;
  height: 30px;
  font-size: 12px;
  border-radius: 8px;
  margin-right: 10px;
}

.title {
  font-size: 16px;
  font-weight: bold;
}

.scroll-area {
  flex: 1;
  flex-direction: column;
  padding: 0 10px;
  overflow: scroll;
}

.section-desc {
  font-size: 11px;
  margin-bottom: 8px;
  padding: 0 4px;
}

.card {
  flex-direction: column;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 10px;
}

.card-title {
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 6px;
}

.card-hint {
  font-size: 10px;
  margin-bottom: 8px;
}

.status-text {
  font-size: 12px;
  margin-bottom: 2px;
}

.action-btn {
  width: 100%;
  height: 34px;
  font-size: 13px;
  border-radius: 8px;
  margin-bottom: 6px;
}

.action-btn.small {
  height: 30px;
  font-size: 12px;
}

.json-input {
  width: 100%;
  height: 80px;
  font-size: 10px;
  border-radius: 6px;
  border-width: 1px;
  padding: 6px;
  margin-bottom: 6px;
}

.json-result {
  font-size: 11px;
  margin-top: 4px;
}

.footer-space {
  height: 20px;
}
</style>