<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">倒数日</text>
    </div>

    <div class="toolbar" if="{{ countdownList.length > 0 }}">
      <text class="toolbar-count" style="color: {{ theme.textSecondary }}">{{ countdownList.length }}个倒数日</text>
      <text class="toolbar-sort" onclick="toggleSort" style="color: {{ theme.accent }}">
        {{ sortRecent ? '最近' : '名称' }}
      </text>
      <input class="toolbar-clear" type="button" value="{{ clearAllConfirm ? '确认' : '清空' }}" onclick="clearAll"
             style="background-color: {{ clearAllConfirm ? theme.deleteText : theme.deleteBg }}; color: {{ clearAllConfirm ? theme.text : theme.deleteText }}" />
    </div>

    <scroll class="list-scroll" scroll-y="{{true}}">
      <div for="{{ (idx, item) in countdownList }}" class="cd-item">
        <div class="cd-group-divider" if="{{ item.showDivider }}">
          <div class="cd-group-line"></div>
          <text class="cd-group-label" style="color: {{ theme.textMuted }}">已结束</text>
        </div>
        <!-- 卡片只承载「读」：标题 / 天数 / 进度 / 日期。
             开关、编辑、删除全部收进点击后弹出的详情层 ——
             它们常驻时每张卡要多占 68px（40 操作排 + 28 开关行），
             一屏从 3 条掉到 2 条，且每个卡片都是「一坨按钮」，读起来很吵。 -->
        <div class="countdown-row" style="background-color: {{ theme.card }}; opacity: {{ item.enabled ? 1 : 0.45 }}; {{ item.cardBorder }}"
             onclick="openDetail(idx)">
          <div class="cd-head">
            <text class="cd-title" style="color: {{ theme.text }}">{{ item.title }}</text>
          </div>
          <div class="cd-summary">
            <text if="{{ item.status === 'today' }}" class="cd-today-badge">今天</text>
            <text class="cd-days" style="color: {{ item.daysColor }}">{{ item.daysText }}</text>
            <text class="cd-more" style="color: {{ theme.textMuted }}">›</text>
          </div>
          <div class="cd-bar">
            <div class="cd-bar-track" style="background-color: {{ theme.borderLight }}">
              <div class="cd-bar-fill" style="width: {{ item.fillPx }}px; {{ item.barBg }}"></div>
            </div>
          </div>
          <div class="cd-meta">
            <text class="cd-date" style="color: {{ theme.textSecondary }}">{{ item.dateDisplay }}</text>
            <text if="{{ !item.enabled }}" class="cd-off-tag" style="color: {{ theme.textMuted }}">已关闭</text>
          </div>
        </div>
      </div>
      <text if="{{ countdownList.length === 0 }}" class="empty-text" style="color: {{ theme.textMuted }}">暂无倒数日</text>
      <div class="add-row-btn" onclick="startAdd" style="background-color: {{ theme.accent }}">
        <text class="btn-label" style="color: {{ theme.bg }}">+ 添加倒数日</text>
      </div>
    </scroll>

    <div if="{{ detailVisible }}" class="detail-mask" onclick="closeDetail">
      <div class="detail-panel" style="background-color: {{ theme.card }}" onclick="detailStop($event)">
        <div class="detail-arc-wrap">
          <progress class="detail-arc" type="arc" percent="{{ detailItem.arcPercent }}"
                    color="{{ detailItem.arcColor }}" backgroundcolor="{{ theme.borderLight }}" stroke-width="12" />
          <div class="detail-arc-center">
            <text class="detail-arc-num" style="color: {{ detailItem.daysColor }}">{{ detailItem.daysText }}</text>
          </div>
        </div>
        <text class="detail-title" style="color: {{ theme.text }}">{{ detailItem.title }}</text>
        <text class="detail-date" style="color: {{ theme.textSecondary }}">{{ detailItem.dateDisplay }}</text>
        <div class="detail-actions">
          <div class="action-btn detail-edit" onclick="editFromDetail"
               style="background-color: {{ theme.accent }}">
            <text class="btn-label" style="color: {{ theme.bg }}">编辑</text>
          </div>
          <div class="action-btn detail-del" onclick="deleteFromDetail"
               style="background-color: {{ detailDeleteConfirm ? theme.deleteText : theme.deleteBg }}">
            <text class="btn-label" style="color: {{ detailDeleteConfirm ? theme.text : theme.deleteText }}">{{ detailDeleteConfirm ? '确认' : '删除' }}</text>
          </div>
        </div>
        <div class="detail-actions detail-switch-row">
          <text class="detail-switch-label" style="color: {{ theme.textSecondary }}">首页显示</text>
          <div class="switch-btn detail-switch" onclick="toggleFromDetail"
               style="background-color: {{ detailItem.enabled ? theme.accent : theme.btnSecondary }}">
            <text class="switch-label" style="color: {{ detailItem.enabled ? theme.bg : theme.btnSecondaryText }}">{{ detailItem.enabled ? 'ON' : 'OFF' }}</text>
          </div>
        </div>
        <div class="detail-actions">
          <div class="action-btn detail-close" onclick="closeDetail" style="background-color: {{ theme.btnSecondary }}">
            <text class="btn-label" style="color: {{ theme.btnSecondaryText }}">关闭</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const countdown = require("../../data/countdown.js")

var NAME_RETURN_KEY = "countdown_name_result"
var DATE_RETURN_KEY = "countdown_date_result"

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    },
    countdownList: [],
    sortRecent: true,
    clearAllConfirm: false,
    deleteConfirmIndex: -1,
    deleteTimer: null,
    clearTimer: null,
    isCapsule: false,
    flowMode: "idle",
    flowStep: "idle",
    editIdx: -1,
    pendingTitle: "",
    pendingDate: "",
    detailVisible: false,
    detailIdx: -1,
    detailItem: null,
    detailDeleteConfirm: false,
    detailTimer: null
  },

  onInit() {
    var self = this
    this.loadList()
    try {
      var device = require("@system.device")
      device.getInfo({
        success: function(data) {
          var shape = data.screenShape || ""
          if (shape === "capsule" || shape === "pill-shaped") self.isCapsule = true
        },
        fail: function() {}
      })
    } catch (e) {}
  },

  onShow() {
    var self = this
    // 旧三段式接力的残留消费（flowStep 恒为 idle，实际不生效），保留仅为兼容历史跳转
    this.drainName()
    this.drainDate()
    // 2026-10-21：从 countdown-edit 表单页返回后必须重读数据，否则新增/编辑不可见
    this.loadList()
  },

  drainName: function() {
    var self = this
    storage.get({
      key: NAME_RETURN_KEY,
      success: function(data) {
        if (self.flowStep === "await_name" && data !== undefined && data !== null && data !== "") {
          storage.delete({ key: NAME_RETURN_KEY, fail: function() {} })
          self.pendingTitle = String(data).trim()
          self.flowStep = "await_date"
          self.openDatePage()
        } else {
          if (self.flowStep === "await_name") self.flowStep = "idle"
        }
      },
      fail: function() {
        if (self.flowStep === "await_name") self.flowStep = "idle"
      }
    })
  },

  drainDate: function() {
    var self = this
    storage.get({
      key: DATE_RETURN_KEY,
      success: function(data) {
        if (self.flowStep === "await_date" && data && /^\d{4}-\d{2}-\d{2}$/.test(String(data))) {
          storage.delete({ key: DATE_RETURN_KEY, fail: function() {} })
          self.pendingDate = String(data)
          self.finalizeFlow()
        } else {
          if (self.flowStep === "await_date") self.flowStep = "idle"
        }
      },
      fail: function() {
        if (self.flowStep === "await_date") self.flowStep = "idle"
      }
    })
  },

  // 2026-10-21 改版：添加/编辑统一进 countdown-edit 表单页（进入即表单，0 跳转）。
  // 旧的「chinese-input → countdown-date」三段式接力（flowStep 状态机 + 5 个 storage 键）
  // 已停用：任一步返回都会丢数据，且用户感知为「点了没反应」。
  openForm(id) {
    var uri = "/pages/countdown-edit"
    var go = function() { router.push({ uri: uri }) }
    storage.set({
      key: "cd_edit_id",
      value: id ? String(id) : "",
      success: go,
      fail: go
    })
  },

  startAdd() {
    this.openForm("")
  },

  startEdit(idx) {
    var item = this.countdownList[idx]
    if (!item) return
    this.openForm(item.id)
  },

  openDatePage() {
    var self = this
    var preset = ""
    if (this.flowMode === "edit" && this.editIdx >= 0 && this.countdownList[this.editIdx]) {
      preset = this.countdownList[this.editIdx].date || ""
    }
    storage.set({ key: "cd_date_preset", value: preset, success: function() {} })
    storage.set({ key: "cd_date_return_key", value: DATE_RETURN_KEY, success: function() {
      router.push({ uri: "/pages/countdown-date" })
    }})
  },

  finalizeFlow() {
    var self = this
    var list = this.countdownList.slice()
    if (this.flowMode === "add") {
      list.push({ id: countdown.newId(), title: this.pendingTitle, date: this.pendingDate, enabled: true, createdAt: Date.now() })
    } else if (this.flowMode === "edit") {
      var it = list[this.editIdx]
      if (it) {
        it.title = this.pendingTitle
        if (this.pendingDate) it.date = this.pendingDate
      }
    }
    this.flowMode = "idle"
    this.flowStep = "idle"
    this.persistList(list)
  },

  // cb 可选：详情层的开关改完要在列表重排后再按下标定位，需要拿到新列表
  loadList(cb) {
    var self = this
    countdown.load(function(res) {
      var items = res.items
      countdown.recompute(items)
      countdown.sortForDisplay(items, self.sortRecent ? "recent" : "name")
      self.decorate(items)
      self.countdownList = items
      if (cb) cb(items)
    })
  },

  // 为排序后的列表逐条附展示字段：状态/文字/颜色/进度条填充/分组分隔/渐变/高亮
  decorate(items) {
    var prevGroup = -1
    for (var i = 0; i < items.length; i++) {
      var it = items[i]
      it.status = countdown.statusOf(it)
      var d = it.daysLeft
      if (it.status === "done") {
        it.daysText = "已过 " + (-d) + " 天"
        it.daysColor = this.theme.deleteText
        it.barBg = "background-color: " + this.theme.textMuted
        it.barColor = this.theme.textMuted
      } else if (it.status === "today") {
        it.daysText = "剩 0 天"
        it.daysColor = "#ff7a45"
        it.barBg = "background-image: linear-gradient(90deg, #ff7a45, #ffc199)"
        it.barColor = "#ff7a45"
      } else {
        it.daysText = "剩 " + d + " 天"
        it.daysColor = it.daysLeft >= 100 ? this.theme.textSecondary : this.theme.accent
        it.barBg = "background-image: linear-gradient(90deg, " + this.theme.accent + ", #c2e8f5)"
        it.barColor = this.theme.accent
      }
      var p = countdown.progressOf(it)
      it.fillPx = Math.max(6, Math.round(112 * p))
      it.cardBorder = it.status === "today" ? "border: 1px solid rgba(255,122,69,0.55)" : "border: 1px solid transparent"
      var g = it.status === "done" ? 1 : 0
      it.showDivider = (i > 0 && g !== prevGroup)
      prevGroup = g
    }
  },

  persistList(list) {
    var self = this
    countdown.save(list, function() {
      self.loadList()
    })
  },

  toggleItem(idx) {
    var list = this.countdownList.slice()
    if (list[idx]) list[idx].enabled = !list[idx].enabled
    this.persistList(list)
  },

  deleteItem(idx) {
    var self = this
    if (this.deleteConfirmIndex === idx) {
      var list = this.countdownList.slice()
      list.splice(idx, 1)
      this.persistList(list)
      clearTimeout(this.deleteTimer)
      this.deleteConfirmIndex = -1
      return
    }
    this.deleteConfirmIndex = idx
    clearTimeout(this.deleteTimer)
    this.deleteTimer = setTimeout(function() {
      self.deleteConfirmIndex = -1
    }, 3000)
  },

  toggleSort() {
    this.sortRecent = !this.sortRecent
    var list = this.countdownList.slice()
    countdown.sortForDisplay(list, this.sortRecent ? "recent" : "name")
    this.decorate(list)
    this.countdownList = list
  },

  clearAll() {
    var self = this
    if (this.clearAllConfirm) {
      this.persistList([])
      clearTimeout(this.clearTimer)
      this.clearAllConfirm = false
      return
    }
    this.clearAllConfirm = true
    clearTimeout(this.clearTimer)
    this.clearTimer = setTimeout(function() {
      self.clearAllConfirm = false
    }, 3000)
  },

  // ---- 详情态：卡片上所有写操作的唯一入口 ----
  // 弧环的两个派生字段只在弹层用，故不放进 decorate（列表页不渲染弧环）
  withArc(it) {
    it.arcPercent = it.daysLeft < 0 ? 0 : Math.max(0, Math.min(100, Math.round(100 * (countdown.progressOf(it) || 0))))
    it.arcColor = it.daysLeft < 0 ? this.theme.textMuted : (it.daysLeft === 0 ? "#ff7a45" : this.theme.accent)
    return it
  },

  openDetail(idx) {
    var it = this.countdownList[idx]
    if (!it) return
    this.withArc(it)
    this.detailIdx = idx
    this.detailItem = it
    this.detailDeleteConfirm = false
    this.detailVisible = true
  },

  closeDetail() {
    if (this.detailVisible) {
      this.detailVisible = false
      this.detailIdx = -1
      this.detailItem = null
      this.detailDeleteConfirm = false
    }
  },

  detailStop(e) {
    if (e && e.stopPropagation) e.stopPropagation()
  },

  // 详情的三个动作一律按 id 定位：列表按剩余天数重排，弹层开着这几秒里
  // 下标随时可能指向别人（同一个坑在 3 秒删除窗口踩过，见 countdown.js findIndexById 注释）
  editFromDetail() {
    var it = this.detailItem
    if (!it) return
    var id = it.id
    this.closeDetail()
    this.openForm(id)
  },

  // 开关原地生效、不关弹层：用户关掉它之后往往还想顺手编辑或删除
  toggleFromDetail() {
    var self = this
    var it = this.countdownList[this.detailIdx]
    if (!it) return
    var id = it.id
    it.enabled = !it.enabled
    countdown.save(this.countdownList, function() {
      self.loadList(function(items) {
        var ni = countdown.findIndexById(items, id)
        if (ni < 0) {
          self.closeDetail()
          return
        }
        self.detailIdx = ni
        self.detailItem = self.withArc(items[ni])
      })
    })
  },

  deleteFromDetail() {
    var self = this
    if (!this.detailItem) return
    if (this.detailDeleteConfirm) {
      var id = this.detailItem.id
      clearTimeout(this.detailTimer)
      this.detailDeleteConfirm = false
      countdown.load(function(res) {
        var items = res.items || []
        var idx = countdown.findIndexById(items, id)
        if (idx >= 0) items.splice(idx, 1)
        countdown.save(items, function() {
          self.closeDetail()
          self.loadList()
        })
      })
      return
    }
    this.detailDeleteConfirm = true
    clearTimeout(this.detailTimer)
    this.detailTimer = setTimeout(function() {
      self.detailDeleteConfirm = false
    }, 3000)
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    if (this.detailTimer) {
      clearTimeout(this.detailTimer)
      this.detailTimer = null
    }
    this.countdownList = null
    this.theme = null
  }
}
</script>

<style>
@import '../../common/header.css';

/* ================================================================
   BASE CSS = 手环 9 基准（192 屏 / 内容区 168px）
   手环 9 默认命中，不依赖任何 media query。
   依据 add-course.ux 铁律：独立 @media (shape: pill-shaped) 大块命中即崩，
   故 base 以 9 为基准、彻底移除 pill-shaped 分支；大屏只在 rect 断点做增量。
   所有文案按「不被截断」定量：标题整行独占、天数独立一行、日期与开关同行。
   ================================================================ */

/* 头部：胶囊屏只有一行、横向极窄（192 − 24 留白 = 168）。
   铁律：头部只放「返回 + 标题」，任何操作按钮一律不准进头部（见
   docs/胶囊屏UI规范与模拟器快速迭代-20261018.md）。新增入口下沉到列表底部整行按钮。 */
.header {
  height: 34px;
  margin-bottom: 8px;
}

.back-btn-wrapper {
  width: 32px;
  height: 32px;
  border-radius: 8px;
}

.back-btn-icon {
  width: 18px;
  height: 18px;
}

.header-title {
  font-size: 20px;
  line-height: 26px;
}

.page {
  flex: 1;
  flex-direction: column;
  padding: 24px 12px 20px 12px;
}

/* 新增入口：列表底部整行按钮（头部禁放按钮后的唯一入口），热区 168×44 */
.add-row-btn {
  width: 168px;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin: 12px 0 16px 0;
  flex-shrink: 0;
}

.toolbar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 30px;
  padding: 0 2px;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.toolbar-count {
  font-size: 16px;
  line-height: 22px;
  flex-shrink: 0;
}

.toolbar-sort {
  font-size: 16px;
  line-height: 22px;
  flex-shrink: 0;
  margin-left: 6px;
}

.toolbar-clear {
  width: 44px;
  height: 26px;
  border-radius: 13px;
  font-size: 16px;
  text-align: center;
  line-height: 26px;
  flex-shrink: 0;
}

.list-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
}

/* 列表项必须显式撑满：Vela 里 div 宽度默认随内容收缩，
   否则短标题卡片（如「运动会」）会被压窄，天数与日期随之换行/截断 */
.cd-item {
  width: 100%;
  flex-direction: column;
}

.countdown-row {
  flex-direction: column;
  width: 100%;
  flex-shrink: 0;
  border-radius: 12px;
  padding: 8px 8px;
  margin-bottom: 6px;
}

.cd-head {
  flex-direction: column;
  width: 100%;
  flex-shrink: 0;
}

/* 标题独占整行，且不设 lines —— 长标题自然换行，绝不出现省略号或被裁切 */
.cd-title {
  font-size: 22px;
  line-height: 28px;
  width: 100%;
}

.cd-summary {
  flex-direction: row;
  align-items: center;
  width: 100%;
  flex-shrink: 0;
  margin-top: 2px;
}

.cd-today-badge {
  font-size: 16px;
  line-height: 20px;
  color: #ffffff;
  background-color: #ff7a45;
  border-radius: 6px;
  padding: 0 6px;
  margin-right: 6px;
  flex-shrink: 0;
}

.cd-days {
  font-size: 24px;
  line-height: 30px;
  font-weight: bold;
  flex: 1;          /* 把 › 推到行尾；长天数文案自己收缩，不与箭头抢空间 */
  min-width: 0;
}

/* 「可点开」的唯一视觉暗示。不做整卡箭头图标：192 屏上加图标会挤掉天数 */
.cd-more {
  font-size: 22px;
  line-height: 30px;
  flex-shrink: 0;
  margin-left: 4px;
}

.cd-bar {
  margin-top: 4px;
  height: 10px;
  justify-content: center;
  width: 100%;
}

.cd-bar-track {
  width: 100%;
  height: 6px;
  border-radius: 3px;
}

.cd-bar-fill {
  height: 6px;
  border-radius: 3px;
}

.cd-meta {
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-top: 4px;
}

.cd-date {
  font-size: 16px;
  line-height: 22px;
  flex: 1;
  min-width: 0;
}

/* 已关闭的卡片只留一行弱提示，替代原来常驻的 ON/OFF 开关 ——
   开关搬到弹层后卡片少了 28px（开关行）+ 40px（操作排），一屏多看一条 */
.cd-off-tag {
  font-size: 15px;
  line-height: 22px;
  flex-shrink: 0;
  margin-left: 6px;
}

/* ⚠️ 必须用单类选择器：Vela 编译会静默丢弃 `.父 .子` 后代选择器，
   写了不生效也不报错 —— 之前 width 从 68 改到 72 毫无反应就是这个原因。
   卡片内可用宽度 = 168 − padding 8×2 = 152 → 72 + 8 + 72 */
.del-btn {
  margin-left: 8px;
}

.cd-group-divider {
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin: 2px 2px 6px 2px;
}

.cd-group-line {
  flex: 1;
  height: 2px;
  background-color: rgba(136, 136, 153, 0.25);
}

.cd-group-label {
  font-size: 16px;
  line-height: 22px;
  margin-left: 6px;
  flex-shrink: 0;
}

.switch-btn {
  width: 52px;
  height: 28px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.switch-label {
  font-size: 15px;
  line-height: 20px;
  text-align: center;
}

/* 按钮一律 div + text：Vela 里 input[type=button] 的 width 不生效（宽度只跟文案走），
   热区调不动。div 宽高完全可控，onclick 一样能点。 */
.action-btn {
  width: 72px;
  height: 40px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  margin-bottom: 0;
}

.btn-label {
  font-size: 20px;
  line-height: 24px;
  text-align: center;
}

.empty-text {
  font-size: 20px;
  line-height: 28px;
  text-align: center;
  width: 100%;
  margin-top: 40px;
}

.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 192×490 上面板高约 280：靠 flex 居中会整体下沉把操作排推出屏幕，
     故改为顶部对齐 + 固定上留白，保证「编辑/删除/开关」始终可见 */
  justify-content: flex-start;
  align-items: center;
  padding-top: 34px;
  background-color: rgba(0, 0, 0, 0.6);
}

/* 184 = 屏宽 192 − 左右各 4；内容区 168，正好容下 72 + 8 + 72 的操作排 */
.detail-panel {
  flex-direction: column;
  align-items: center;
  width: 184px;
  border-radius: 14px;
  padding: 18px 8px 14px 8px;
}

.detail-arc-wrap {
  width: 120px;
  height: 120px;
  justify-content: center;
  align-items: center;
  position: relative;
}

.detail-arc {
  width: 120px;
  height: 120px;
}

.detail-arc-center {
  position: absolute;
  top: 0;
  left: 0;
  width: 120px;
  height: 120px;
  justify-content: center;
  align-items: center;
}

/* 弧环内径约 96px：「已过 999 天」这类最长文案也要放得下，故 22px */
.detail-arc-num {
  font-size: 22px;
  line-height: 28px;
  font-weight: bold;
}

/* 详情标题同样不设 lines：完整换行显示 */
.detail-title {
  font-size: 22px;
  line-height: 28px;
  margin-top: 10px;
  width: 100%;
  text-align: center;
}

.detail-date {
  font-size: 16px;
  line-height: 22px;
  margin-top: 2px;
}

.detail-actions {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-top: 8px;
}

.detail-del {
  margin-left: 8px;
}

/* 同样必须单类选择器（后代选择器会被丢弃） */
.detail-switch {
  width: 80px;
  height: 32px;
}

/* 开关行：左标签 + 右开关。原版把 ON/OFF 单独居中，看不出这开关是管什么的 */
/* 竖排：横排时开关固定 80px 后标签只剩约 45px，「首页显示」必然折行 */
.detail-switch-row {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 6px;
}

.detail-switch-label {
  font-size: 15px;
  line-height: 20px;
  text-align: center;
  width: 100%;
}

/* 关闭按钮占满行宽：弹层是模态的，必须给一个明确出口。
   只靠「点空白处」——192 屏上弹层几乎铺满，空白处只剩边距那几像素 */
.detail-close {
  width: 152px;
  height: 36px;
  border-radius: 18px;
  margin-top: 2px;
}

/* 大屏（9 Pro / 10 Pro 336×480 等 rect 屏）只做增量：留白与按钮放大，
   不覆盖 base 的字号体系，保证同一套文案在两种屏上都不被截断 */
@media (shape: rect) {
  .page {
    padding: 24px 20px 20px 20px;
  }

  .add-row-btn {
    width: 296px;
    height: 48px;
    border-radius: 24px;
  }
}
