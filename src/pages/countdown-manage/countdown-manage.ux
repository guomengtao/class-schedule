<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <!-- 标题同样可点返回：手环屏小，返回热区越大越好，
           且用户直觉就是「点标题回上级」（2026-10-21 全站规则） -->
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">倒数日</text>
    </div>

    <div class="toolbar" if="{{ countdownList.length > 0 }}">
      <text class="toolbar-count" style="color: {{ theme.textSecondary }}">共{{ countdownList.length }}条</text>
      <text class="toolbar-sort" onclick="toggleSort" style="color: {{ theme.accent }}">
        {{ sortRecent ? '最近' : '名称' }}
      </text>
      <input class="toolbar-clear" type="button" value="{{ clearAllConfirm ? '确认' : '清空' }}" onclick="clearAll"
             style="background-color: {{ clearAllConfirm ? theme.deleteText : theme.deleteBg }}; color: {{ clearAllConfirm ? theme.text : theme.deleteText }}" />
    </div>

    <scroll class="list-scroll" scroll-y="{{true}}">
      <div for="{{ (idx, item) in countdownList }}" class="cd-item">
        <div class="cd-group-divider" if="{{ item.showDivider }}">
          <div class="cd-group-line"></div>
          <text class="cd-group-label" style="color: {{ theme.textMuted }}">已结束</text>
        </div>
        <!-- 卡片只承载「读」：标题 / 天数 / 进度 / 日期。
             开关、编辑、删除一律不进列表卡：它们常驻时每张卡要多占 68px
             （40 操作排 + 28 开关行），一屏从 3 条掉到 2 条，
             且每个卡片都是「一坨按钮」，读起来很吵。
             2026-10-21 二审：原来的「点卡片弹详情层再点编辑」已删 ——
             一次点击进不了的层级就是多余层级，卡片点击直接进编辑页，
             删除与「首页显示」开关都在编辑页里，弹层的存在只为多一层。
             底色/描边/天数/进度条全部取用户选的颜色（item 级），
             让「生日」「考试」「出行」在列表里一眼分得开。 -->
        <div class="countdown-row" style="{{ item.cardBg }}; opacity: {{ item.enabled ? 1 : 0.5 }}; {{ item.cardBorder }}"
             onclick="openForm(item.id)">
          <div class="cd-head">
            <text class="cd-title" style="color: {{ theme.text }}">{{ item.title }}</text>
            <text if="{{ !item.enabled }}" class="cd-off-tag" style="color: {{ theme.textMuted }}">已关闭</text>
          </div>
          <div class="cd-summary">
            <text if="{{ item.status === 'today' }}" class="cd-today-badge">今天</text>
            <text class="cd-days" style="color: {{ item.daysColor }}">{{ item.daysText }}</text>
            <text class="cd-more" style="color: {{ theme.textMuted }}">›</text>
          </div>
          <div class="cd-bar">
            <div class="cd-bar-track" style="background-color: {{ theme.borderLight }}">
              <div class="cd-bar-fill" style="width: {{ item.fillPx }}px; {{ item.barBg }}"></div>
            </div>
          </div>
          <text class="cd-date" style="color: {{ theme.textSecondary }}">{{ item.dateDisplay }}</text>
          <!-- 当年用农历录入的条目，多给一行农历：生日/中秋这类日期
               用户脑子里存的是「八月十五」，不是 2026-09-25 -->
          <text if="{{ item.lunarLine }}" class="cd-lunar" style="color: {{ item.lunarColor }}">{{ item.lunarLine }}</text>
        </div>
      </div>
      <text if="{{ countdownList.length === 0 }}" class="empty-text" style="color: {{ theme.textMuted }}">暂无倒数日</text>
      <div class="add-row-btn" onclick="startAdd" style="background-color: {{ theme.accent }}">
        <text class="btn-label" style="color: {{ theme.bg }}">+ 添加倒数日</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const countdown = require("../../data/countdown.js")
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    isLight: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    },
    countdownList: [],
    sortRecent: true,
    clearAllConfirm: false,
    clearTimer: null
  },

  onInit() {
    var self = this
    // 主题必须先读：色块的淡底与文字提亮/压暗都按深浅主题算
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.isLight = (themeName === 'light' || themeName === 'warm')
      self.iconTheme = self.isLight ? 'light' : 'dark'
      self.loadList()
    })
  },

  onShow() {
    // 2026-10-21：从 countdown-edit 表单页返回后必须重读数据，否则新增/编辑不可见。
    // 原来的 drainName/drainDate（旧三段式接力的返回键消费）已删：
    // flowStep 恒为 idle，它们只是每次进页白跑两次 storage.get。
    this.loadList()
  },

  // 2026-10-21 改版：添加/编辑统一进 countdown-edit 表单页（进入即表单，0 跳转）。
  // 列表卡片的点击直接走这里（不再经过详情弹层）。
  // 旧的「chinese-input → countdown-date」三段式接力（flowStep 状态机 + 5 个 storage 键）
  // 已整体删除：任一步返回都会丢数据，且用户感知为「点了没反应」。
  openForm(id) {
    var uri = "/pages/countdown-edit"
    var go = function() { router.push({ uri: uri }) }
    storage.set({
      key: "cd_edit_id",
      value: id ? String(id) : "",
      success: go,
      fail: go
    })
  },

  startAdd() {
    this.openForm("")
  },

  // 列表只读，重排/重算后不再需要回调定位 —— 弹层的「原地保持下标」随着
  // 弹层一起删了（曾用 cb 把重排后的新下标回填给 detailIdx）
  loadList() {
    var self = this
    countdown.load(function(res) {
      var items = res.items
      countdown.recompute(items)
      countdown.sortForDisplay(items, self.sortRecent ? "recent" : "name")
      self.decorate(items)
      self.countdownList = items
    })
  },

  // 为排序后的列表逐条附展示字段：状态/文字/颜色/进度条填充/分组分隔/高亮
  decorate(items) {
    var prevGroup = -1
    var light = this.isLight
    for (var i = 0; i < items.length; i++) {
      var it = items[i]
      it.status = countdown.statusOf(it)
      var d = it.daysLeft
      // 色块三件套：底（低透明淡色）+ 描边 + 文字，全部由 item 颜色派生。
      // 不直接拿 hex 当文字色：中间调在深色主题上发灰、在浅色主题上发白，
      // adaptColor 按主题提亮/压暗 32%，两种主题都能当天数色用（2026-10-21）
      var hex = countdown.colorOf(it)
      var textColor = countdown.adaptColor(hex, light)
      it.cardBg = "background-color: " + countdown.tintColor(hex, light ? 0.13 : 0.18)
      it.cardBorder = "border: 1px solid " + countdown.tintColor(hex, light ? 0.5 : 0.62)
      if (it.status === "done") {
        it.daysText = "已过 " + (-d) + " 天"
        it.daysColor = this.theme.textMuted
        it.barBg = "background-color: " + this.theme.textMuted
      } else {
        it.daysText = it.status === "today" ? "剩 0 天" : "剩 " + d + " 天"
        it.daysColor = textColor
        it.barBg = "background-color: " + textColor
      }
      // 农历行：只有当初用农历录入的条目才有；已结束的条目跟着天数一起褪色
      it.lunarLine = (it.cal === "lunar" && it.lunarText) ? ("农历" + it.lunarText) : ""
      it.lunarColor = it.status === "done" ? this.theme.textMuted : textColor
      var p = countdown.progressOf(it)
      it.fillPx = Math.max(6, Math.round(146 * p))
      var g = it.status === "done" ? 1 : 0
      it.showDivider = (i > 0 && g !== prevGroup)
      prevGroup = g
    }
  },

  persistList(list) {
    var self = this
    countdown.save(list, function() {
      self.loadList()
    })
  },

  toggleSort() {
    this.sortRecent = !this.sortRecent
    var list = this.countdownList.slice()
    countdown.sortForDisplay(list, this.sortRecent ? "recent" : "name")
    this.decorate(list)
    this.countdownList = list
  },

  clearAll() {
    var self = this
    if (this.clearAllConfirm) {
      this.persistList([])
      clearTimeout(this.clearTimer)
      this.clearAllConfirm = false
      return
    }
    this.clearAllConfirm = true
    clearTimeout(this.clearTimer)
    this.clearTimer = setTimeout(function() {
      self.clearAllConfirm = false
    }, 3000)
  },

  goBack() {
    router.back()
  },

  onDestroy() {
    if (this.clearTimer) {
      clearTimeout(this.clearTimer)
      this.clearTimer = null
    }
    this.countdownList = null
    this.theme = null
  }
}
</script>

<style>
@import '../../common/header.css';

/* ================================================================
   BASE CSS = 手环 9 基准（192 屏 / 内容区 168px）
   手环 9 默认命中，不依赖任何 media query。
   依据 add-course.ux 铁律：独立 @media (shape: pill-shaped) 大块命中即崩，
   故 base 以 9 为基准、彻底移除 pill-shaped 分支；大屏只在 rect 断点做增量。
   所有文案按「不被截断」定量：标题整行独占、天数独立一行、日期与开关同行。
   ================================================================ */

/* 头部：胶囊屏只有一行、横向极窄（192 − 24 留白 = 168）。
   铁律：头部只放「返回 + 标题」，任何操作按钮一律不准进头部（见
   docs/胶囊屏UI规范与模拟器快速迭代-20261018.md）。新增入口下沉到列表底部整行按钮。 */
.header {
  height: 34px;
  margin-bottom: 8px;
}

.back-btn-wrapper {
  width: 44px;
  height: 44px;
  border-radius: 8px;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  font-size: 20px;
  line-height: 26px;
}

.page {
  flex: 1;
  flex-direction: column;
  padding: 24px 12px 20px 12px;
}

/* 新增入口：列表底部整行按钮（头部禁放按钮后的唯一入口），热区 168×44 */
.add-row-btn {
  width: 168px;
  height: 44px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin: 12px 0 16px 0;
  flex-shrink: 0;
}

.toolbar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 32px;
  padding: 0 2px;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.toolbar-count {
  font-size: 20px;
  line-height: 26px;
  flex-shrink: 0;
}

.toolbar-sort {
  font-size: 20px;
  line-height: 26px;
  flex-shrink: 0;
  margin-left: 6px;
}

.toolbar-clear {
  width: 48px;
  height: 30px;
  border-radius: 15px;
  font-size: 20px;
  text-align: center;
  line-height: 30px;
  flex-shrink: 0;
}

.list-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
}

/* 列表项必须显式撑满：Vela 里 div 宽度默认随内容收缩，
   否则短标题卡片（如「运动会」）会被压窄，天数与日期随之换行/截断 */
.cd-item {
  width: 100%;
  flex-direction: column;
}

.countdown-row {
  flex-direction: column;
  width: 100%;
  flex-shrink: 0;
  border-radius: 12px;
  padding: 8px 8px;
  margin-bottom: 6px;
}

.cd-head {
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
  flex-shrink: 0;
}

/* 标题独占整行，且不设 lines —— 长标题自然换行，绝不出现省略号或被裁切 */
.cd-title {
  font-size: 24px;
  line-height: 30px;
  flex: 1;
  min-width: 0;
}

.cd-summary {
  flex-direction: row;
  align-items: center;
  width: 100%;
  flex-shrink: 0;
  margin-top: 2px;
}

.cd-today-badge {
  font-size: 18px;
  line-height: 22px;
  color: #ffffff;
  background-color: #ff7a45;
  border-radius: 6px;
  padding: 0 6px;
  margin-right: 6px;
  flex-shrink: 0;
}

.cd-days {
  font-size: 26px;
  line-height: 32px;
  font-weight: bold;
  flex: 1;          /* 把 › 推到行尾；长天数文案自己收缩，不与箭头抢空间 */
  min-width: 0;
}

/* 「可点开」的唯一视觉暗示。不做整卡箭头图标：192 屏上加图标会挤掉天数 */
.cd-more {
  font-size: 24px;
  line-height: 32px;
  flex-shrink: 0;
  margin-left: 4px;
}

.cd-bar {
  margin-top: 4px;
  height: 10px;
  justify-content: center;
  width: 100%;
}

.cd-bar-track {
  width: 100%;
  height: 6px;
  border-radius: 3px;
}

.cd-bar-fill {
  height: 6px;
  border-radius: 3px;
}

.cd-date {
  font-size: 20px;
  line-height: 26px;
  width: 100%;
  margin-top: 4px;
}

/* 农历行：与公历日期同号同位置，只靠颜色区分主次。
   20px 下「农历八月十五」= 120px，内容区 152px，放得下不换行 */
.cd-lunar {
  font-size: 20px;
  line-height: 26px;
  width: 100%;
  margin-top: 1px;
}

/* 已关闭的卡片只留一行弱提示（整卡同时降到 0.5 透明度）——
   ON/OFF 开关本身在编辑页，列表页不承载任何写操作 */
.cd-off-tag {
  font-size: 18px;
  line-height: 30px;
  flex-shrink: 0;
  margin-left: 6px;
}

.cd-group-divider {
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin: 2px 2px 6px 2px;
}

.cd-group-line {
  flex: 1;
  height: 2px;
  background-color: rgba(136, 136, 153, 0.25);
}

.cd-group-label {
  font-size: 20px;
  line-height: 26px;
  margin-left: 6px;
  flex-shrink: 0;
}

.btn-label {
  font-size: 20px;
  line-height: 24px;
  text-align: center;
}

.empty-text {
  font-size: 20px;
  line-height: 28px;
  text-align: center;
  width: 100%;
  margin-top: 40px;
}

/* 大屏（9 Pro / 10 Pro 336×480 等 rect 屏）只做增量：留白与按钮放大，
   不覆盖 base 的字号体系，保证同一套文案在两种屏上都不被截断 */
@media (shape: rect) {
  .page {
    padding: 24px 20px 20px 20px;
  }

  .add-row-btn {
    width: 296px;
    height: 48px;
    border-radius: 24px;
  }
}
</style>