<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 标题 4 字 @30px 承担「安卓」这一路径信息，正文因此不必再写「安卓」 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">安卓</text>
    </div>

    <text class="progress" style="color: {{ theme.accent }}">第1步 共2步</text>

    <text class="lead" style="color: {{ theme.textSecondary }}">扫码安装同步器</text>

    <div class="qr-box" style="background-color: {{ theme.card }}">
      <div class="qr-wrap" if="{{ qrUrl }}">
        <qrcode class="qr-code" value="{{ qrUrl }}" style="color: #000000; background-color: #ffffff;"></qrcode>
      </div>
      <text class="qr-loading" if="{{ !qrUrl }}" style="color: {{ theme.textMuted }}">正在生成</text>
    </div>

    <!-- 终态提示，不是「下一步」：A 到此结束，避免把用户误导入 B。
         卡片左右 padding 8 会吃掉 16px → 内容宽只剩 152px，故标题 4 字、副标 6 字 -->
    <div class="done-box" style="background-color: {{ theme.card }}">
      <text class="done-title" style="color: {{ theme.accent }}">自动激活</text>
      <text class="done-sub" style="color: {{ theme.textSecondary }}">无需输兑换码</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const ctx = require("../shared/activation-context.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    qrUrl: ''
  },

  onInit() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    ctx.getIdentity(function(deviceId, infoParams) {
      self.qrUrl = ctx.apkUrl(deviceId, infoParams)
    })
  },

  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
/* ev-six：字号只用 30/28/24；横向 padding 页面 10、卡片 8。
   高度预算：header 46 + 进度 38 + 说明 40 + 二维码 198 + 终态卡 93 = 415 / 434 */
.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 40px;
  margin-bottom: 6px;
}

.back-btn-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 20px;
  height: 20px;
}

/* 4 字 @30 = 120px，header 可用 132px */
.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
}

.progress {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 4px;
}

/* 7 字 @24 = 168px 满行 */
.lead {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 6px;
}

/* 152 + 白边 16 = 168px；容器禁压缩，否则码体被挤扁扫不出 */
.qr-box {
  width: 100%;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 10px 0;
  border-radius: 12px;
  margin-bottom: 10px;
}

.qr-wrap {
  align-items: center;
  justify-content: center;
  padding: 8px;
  background-color: #ffffff;
  border-radius: 6px;
}

.qr-code {
  width: 152px;
  height: 152px;
  flex-shrink: 0;
}

.qr-loading {
  font-size: 24px;
  line-height: 34px;
  height: 168px;
  text-align: center;
}

/* 终态卡推到底：内容少时让空白自然落在中间，不硬填 */
.done-box {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 10px 8px 12px 8px;
  border-radius: 12px;
  margin-top: auto;
}

.done-title {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  margin-bottom: 2px;
}

.done-sub {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
}

@media (shape: pill-shaped) {
  .page {
    padding: 24px 12px 20px 12px;
  }

  .header {
    height: 38px;
  }

  .back-btn-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 18px;
    height: 18px;
  }

  .header-title {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
