<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 标题 3 字 @30px：原「获取激活码」5 字只能压到 24px，比说明行（28px）还小，层级倒挂 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">激活码</text>
    </div>

    <!-- 「第1步 共3步」：本路径用户手里已有 4 位兑换码，第一步是拿到设备ID，不是扫码 -->
    <text class="progress" style="color: {{ theme.textSecondary }}">第1步 共3步</text>

    <!-- 扫码是唯一主路径（2026-11-04 用户裁定）：去掉「或」字——这里不是可选项，
         就是扫；二维码按屏宽吃满，小屏扫得动优先于任何文案。
         扫码会自动带上 deviceId 与全部参数，用户不需要抄任何东西。 -->
    <div class="qr-box" style="background-color: {{ theme.card }}">
      <text class="qr-hint" style="color: {{ theme.textSecondary }}">扫码打开</text>
      <div class="qr-wrap" if="{{ qrUrl }}">
        <qrcode class="qr-code" value="{{ qrUrl }}" style="width: {{ qrSize }}px; height: {{ qrSize }}px; color: #000000; background-color: #ffffff;"></qrcode>
      </div>
      <text class="qr-loading" if="{{ !qrUrl }}" style="color: {{ theme.textMuted }}">正在生成</text>
    </div>

    <!-- 设备ID 降为页脚参考行：只是「有这个」兜底/排障，不占视觉预算。
         点击仍可复制完整 ID（手输路径已退为备用/测试通道） -->
    <div class="dev-row" onclick="onDevTap">
      <text class="dev-value" style="color: {{ theme.textMuted }}">设备ID {{ deviceIdText }}</text>
    </div>

    <div class="btn" onclick="goInput" style="background-color: {{ theme.accent }}">
      <text class="btn-text" style="color: {{ theme.bg }}">去输入激活码</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import clipboard from "@system.clipboard"
import prompt from "@system.prompt"
import device from "@system.device"
const ctx = require("../shared/activation-context.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    deviceIdText: 'ID 获取中',
    idColor: '#888899',
    qrUrl: '',
    deviceId: '',
    qrSize: 156
  },

  onInit() {
    var self = this
    self.calcQrSize()
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    ctx.getIdentity(function(deviceId, infoParams) {
      self.deviceId = deviceId || ''
      self.deviceIdText = self.formatId(deviceId)
      self.idColor = deviceId ? self.theme.text : self.theme.accent
      self.qrUrl = ctx.redeemUrl(deviceId, infoParams)
    })
  },

  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  // 二维码边长按屏宽/屏高同时封顶：小屏扫得动是第一诉求。
  // 宽度侧：页面左右 padding 20 + 白框 12 + 呼吸 12 = 44
  // 高度侧：固定占位约 302（header/progress/hint/ID 行/按钮/各间距）
  calcQrSize() {
    var self = this
    if (!device || typeof device.getInfo !== 'function') return
    device.getInfo({
      success: function(d) {
        var w = (d && d.screenWidth) ? d.screenWidth : 192
        var h = (d && d.screenHeight) ? d.screenHeight : 480
        var byW = w - 44
        var byH = h - 302
        var s = Math.min(byW, byH, 240)
        if (s < 96) s = 96
        self.qrSize = Math.floor(s)
      },
      fail: function() {}
    })
  },

  // 展示末 4 位明码：备用/排障时网页端要手输这 4 位
  // 取不到时显式提示，且提示本身是可点击的重试入口
  formatId(id) {
    if (!id) return '点此重试获取ID'
    return String(id).substring(String(id).length - 4)
  },

  // 点击：有 ID 复制（主路径是手抄/复制到网页），没 ID 重试
  onDevTap() {
    if (!this.deviceId) {
      this.retryId()
      return
    }
    try {
      clipboard.set({ text: this.deviceId })
      prompt.showToast({ message: '已复制完整设备ID' })
    } catch (e) {
      prompt.showToast({ message: '复制失败，请手抄屏幕上的 4 位' })
    }
  },

  retryId() {
    router.replace({ uri: 'pages/activation/path-b-redeem' })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goInput() {
    router.push({ uri: 'pages/activation/activation-code' })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
/* ev-six：字号只用 30/28/24，横向 padding 页面 10、卡片 8，留白从行高与纵向 padding 买。
   高度预算：header 44 + 进度 36 + 说明 42 + ID 58 + 二维码 154 + 按钮 58 ≈ 392 / 434
   （2026-11-04：二维码 152→120 并加一行小字说明，净省 30px，给手输主路径留裕量） */
.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 40px;
  margin-bottom: 4px;
}

.back-btn-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 20px;
  height: 20px;
}

/* 3 字 @30 = 90px，header 可用 132px，宽裕 */
.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
}

.progress {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 2px;
}

/* 设备ID 页脚参考行：无卡片底、24px muted，点一下可复制完整 ID */
.dev-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 32px;
  padding: 0 4px;
  margin-top: 4px;
  margin-bottom: 6px;
}

.dev-value {
  font-size: 24px;
  line-height: 32px;
  text-align: center;
  flex-shrink: 0;
}

/* 二维码容器绝不参与压缩：152 + 白边 16 = 168px，等于内容宽。
   flex-direction: column 是必须的 —— 缺了它，说明行与二维码会被横向并排，
   文字被压到左边剩半句、二维码跑到右侧、白框错位（2026-11-04 实测 bug） */
.qr-box {
  width: 100%;
  flex-direction: column;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 6px 0;
  border-radius: 12px;
  margin-bottom: 6px;
}

.qr-wrap {
  flex-direction: row;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 6px;
  background-color: #ffffff;
  border-radius: 6px;
}

/* 4 字 @24 = 96px，任何屏宽都单行放得下（去掉了原来的「或」） */
.qr-hint {
  font-size: 24px;
  line-height: 32px;
  margin-bottom: 4px;
}

/* 兜底尺寸；真实边长由脚本按 screenWidth/Height 动态写入 inline style */
.qr-code {
  width: 156px;
  height: 156px;
  flex-shrink: 0;
}

.qr-loading {
  font-size: 24px;
  line-height: 34px;
  height: 168px;
  text-align: center;
}

/* 主操作：28px 字，58px 高 */
.btn {
  width: 100%;
  min-height: 58px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-top: auto;
}

.btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
}

@media (shape: pill-shaped) {
  .page {
    padding: 24px 12px 20px 12px;
  }

  .header {
    height: 38px;
    margin-bottom: 2px;
  }

  .back-btn-wrapper {
    width: 30px;
    height: 30px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 18px;
    height: 18px;
  }

  .header-title {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
