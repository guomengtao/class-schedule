<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 标题 3 字 @30px：原「获取激活码」5 字只能压到 24px，比说明行（28px）还小，层级倒挂 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">激活码</text>
    </div>

    <!-- 「第2步 共3步」= 5.4P @24px = 130px，无分隔符无箭头 -->
    <text class="progress" style="color: {{ theme.textSecondary }}">第2步 共3步</text>

    <text class="lead" style="color: {{ theme.text }}">扫码取激活码</text>

    <!-- ID 并入一行：ID + 后 4 位 = 4.6P @24px；点击整行重试 -->
    <div class="dev-row" onclick="retryId" style="background-color: {{ theme.card }}">
      <text class="dev-value" style="color: {{ idColor }}">{{ deviceIdText }}</text>
    </div>

    <div class="qr-box" style="background-color: {{ theme.card }}">
      <div class="qr-wrap" if="{{ qrUrl }}">
        <qrcode class="qr-code" value="{{ qrUrl }}" style="color: #000000; background-color: #ffffff;"></qrcode>
      </div>
      <text class="qr-loading" if="{{ !qrUrl }}" style="color: {{ theme.textMuted }}">正在生成</text>
    </div>

    <div class="btn" onclick="goInput" style="background-color: {{ theme.accent }}">
      <text class="btn-text" style="color: {{ theme.bg }}">去输入激活码</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const ctx = require("../shared/activation-context.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    deviceIdText: 'ID 获取中',
    idColor: '#888899',
    qrUrl: ''
  },

  onInit() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    ctx.getIdentity(function(deviceId, infoParams) {
      self.deviceIdText = self.formatId(deviceId)
      self.idColor = deviceId ? self.theme.text : self.theme.accent
      self.qrUrl = ctx.redeemUrl(deviceId, infoParams)
    })
  },

  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  // 只展示末 4 位：用户不直接使用完整 ID，只需确认「取到了」
  // 取不到时必须显式提示，隐藏就等于让用户看不到问题；提示本身是可点击的重试入口
  formatId(id) {
    if (!id) return '重试获取ID'
    var s = String(id)
    if (s.length <= 4) return 'ID ••' + s
    return 'ID ••' + s.substring(s.length - 4)
  },

  retryId() {
    router.replace({ uri: 'pages/activation/path-b-redeem' })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goInput() {
    router.push({ uri: 'pages/activation/activation-code' })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
/* ev-six：字号只用 30/28/24，横向 padding 页面 10、卡片 8，留白从行高与纵向 padding 买。
   高度预算：header 44 + 进度 36 + 说明 42 + ID 58 + 二维码 186 + 按钮 58 = 424 / 434 */
.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 40px;
  margin-bottom: 4px;
}

.back-btn-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 20px;
  height: 20px;
}

/* 3 字 @30 = 90px，header 可用 132px，宽裕 */
.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
}

.progress {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 2px;
}

/* 6 字 @28 = 168px，正好满行 */
.lead {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 4px;
}

/* ID 单行居中，无 label、无分隔符 */
.dev-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  padding: 8px;
  border-radius: 10px;
  margin-bottom: 8px;
}

.dev-value {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  flex-shrink: 0;
}

/* 二维码容器绝不参与压缩：152 + 白边 16 = 168px，等于内容宽 */
.qr-box {
  width: 100%;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 5px 0;
  border-radius: 12px;
  margin-bottom: 8px;
}

.qr-wrap {
  align-items: center;
  justify-content: center;
  padding: 8px;
  background-color: #ffffff;
  border-radius: 6px;
}

.qr-code {
  width: 152px;
  height: 152px;
  flex-shrink: 0;
}

.qr-loading {
  font-size: 24px;
  line-height: 34px;
  height: 168px;
  text-align: center;
}

/* 主操作：28px 字，58px 高 */
.btn {
  width: 100%;
  min-height: 58px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-top: auto;
}

.btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
}

@media (shape: pill-shaped) {
  .page {
    padding: 24px 12px 20px 12px;
  }

  .header {
    height: 38px;
    margin-bottom: 2px;
  }

  .back-btn-wrapper {
    width: 30px;
    height: 30px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 18px;
    height: 18px;
  }

  .header-title {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
