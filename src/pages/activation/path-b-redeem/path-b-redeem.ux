<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 标题 3 字 @30px：原「获取激活码」5 字只能压到 24px，比说明行（28px）还小，层级倒挂 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">激活码</text>
    </div>

    <!-- 「第1步 共3步」：本路径用户手里已有 4 位兑换码，第一步是拿到设备ID，不是扫码 -->
    <text class="progress" style="color: {{ theme.textSecondary }}">第1步 共3步</text>

    <text class="lead" style="color: {{ theme.text }}">记下设备ID</text>

    <!-- 设备ID 明码大字（P1 手输网页的前提，掩码等于让用户没法抄）。
         点击：取到 ID 时复制，取不到时重试 -->
    <div class="dev-row" onclick="onDevTap" style="background-color: {{ theme.card }}">
      <text class="dev-value" style="color: {{ idColor }}">{{ deviceIdText }}</text>
    </div>

    <!-- 二维码降为次要通道（120px）：主路径是手抄 4 位去网页输入 -->
    <div class="qr-box" style="background-color: {{ theme.card }}">
      <text class="qr-hint" style="color: {{ theme.textMuted }}">也可以扫码打开激活页</text>
      <div class="qr-wrap" if="{{ qrUrl }}">
        <qrcode class="qr-code" value="{{ qrUrl }}" style="color: #000000; background-color: #ffffff;"></qrcode>
      </div>
      <text class="qr-loading" if="{{ !qrUrl }}" style="color: {{ theme.textMuted }}">正在生成</text>
    </div>

    <div class="btn" onclick="goInput" style="background-color: {{ theme.accent }}">
      <text class="btn-text" style="color: {{ theme.bg }}">去输入激活码</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import clipboard from "@system.clipboard"
import prompt from "@system.prompt"
const ctx = require("../shared/activation-context.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    deviceIdText: 'ID 获取中',
    idColor: '#888899',
    qrUrl: '',
    deviceId: ''
  },

  onInit() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    ctx.getIdentity(function(deviceId, infoParams) {
      self.deviceId = deviceId || ''
      self.deviceIdText = self.formatId(deviceId)
      self.idColor = deviceId ? self.theme.text : self.theme.accent
      self.qrUrl = ctx.redeemUrl(deviceId, infoParams)
    })
  },

  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  // 展示末 4 位明码：网页端要手输这 4 位（掩码会让用户没法抄）。
  // 取不到时显式提示，且提示本身是可点击的重试入口
  formatId(id) {
    if (!id) return '点此重试获取ID'
    return String(id).substring(String(id).length - 4)
  },

  // 点击：有 ID 复制（主路径是手抄/复制到网页），没 ID 重试
  onDevTap() {
    if (!this.deviceId) {
      this.retryId()
      return
    }
    try {
      clipboard.set({ text: this.deviceId })
      prompt.showToast({ message: '已复制完整设备ID' })
    } catch (e) {
      prompt.showToast({ message: '复制失败，请手抄屏幕上的 4 位' })
    }
  },

  retryId() {
    router.replace({ uri: 'pages/activation/path-b-redeem' })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goInput() {
    router.push({ uri: 'pages/activation/activation-code' })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
/* ev-six：字号只用 30/28/24，横向 padding 页面 10、卡片 8，留白从行高与纵向 padding 买。
   高度预算：header 44 + 进度 36 + 说明 42 + ID 58 + 二维码 154 + 按钮 58 ≈ 392 / 434
   （2026-11-04：二维码 152→120 并加一行小字说明，净省 30px，给手输主路径留裕量） */
.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 40px;
  margin-bottom: 4px;
}

.back-btn-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 20px;
  height: 20px;
}

/* 3 字 @30 = 90px，header 可用 132px，宽裕 */
.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
}

.progress {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 2px;
}

/* 6 字 @28 = 168px，正好满行 */
.lead {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 4px;
}

/* ID 单行居中，无 label、无分隔符 */
.dev-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  padding: 8px;
  border-radius: 10px;
  margin-bottom: 8px;
}

.dev-value {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  flex-shrink: 0;
}

/* 二维码容器绝不参与压缩：152 + 白边 16 = 168px，等于内容宽 */
.qr-box {
  width: 100%;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 5px 0;
  border-radius: 12px;
  margin-bottom: 8px;
}

.qr-wrap {
  align-items: center;
  justify-content: center;
  padding: 8px;
  background-color: #ffffff;
  border-radius: 6px;
}

/* 二维码降为次要通道：120 + 白边 16 = 136px，上方留一行小字说明 */
.qr-hint {
  font-size: 24px;
  line-height: 34px;
  margin-bottom: 4px;
}

.qr-code {
  width: 120px;
  height: 120px;
  flex-shrink: 0;
}

.qr-loading {
  font-size: 24px;
  line-height: 34px;
  height: 136px;
  text-align: center;
}

/* 主操作：28px 字，58px 高 */
.btn {
  width: 100%;
  min-height: 58px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-top: auto;
}

.btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
}

@media (shape: pill-shaped) {
  .page {
    padding: 24px 12px 20px 12px;
  }

  .header {
    height: 38px;
    margin-bottom: 2px;
  }

  .back-btn-wrapper {
    width: 30px;
    height: 30px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 18px;
    height: 18px;
  }

  .header-title {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
