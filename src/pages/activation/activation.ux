<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- header: 不放 header-placeholder（它是标题被挤成「高...」的元凶），标题 flex:1 不设 lines 限制 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">高级版</text>
    </div>

    <div class="status-card" style="background-color: {{ theme.card }}">
      <text class="status-main" style="color: {{ statusColor }}">{{ statusText }}</text>
      <text class="status-sub" style="color: {{ theme.textSecondary }}">{{ statusSub }}</text>
    </div>

    <!-- 未激活：唯一序号「购买」+ A/B 二选一。已激活整体收起，不留置灰入口 -->
    <block if="{{ !isActivated }}">
      <div class="buy-row" onclick="openPurchase" style="background-color: {{ theme.card }}">
        <div class="buy-badge" style="background-color: {{ theme.accent }}">
          <text class="buy-badge-num" style="color: {{ theme.bg }}">1</text>
        </div>
        <text class="buy-text" style="color: {{ theme.text }}">购买兑换码</text>
        <text class="row-arrow" style="color: {{ theme.textSecondary }}">›</text>
      </div>

      <text class="section-label" style="color: {{ theme.textMuted }}">激活方式 · 二选一</text>

      <div class="path-card" onclick="openPathA" style="background-color: {{ theme.card }}">
        <div class="path-head">
          <div class="path-badge" style="background-color: {{ theme.accent }}">
            <text class="path-badge-text" style="color: {{ theme.bg }}">A</text>
          </div>
          <text class="path-title" style="color: {{ theme.text }}">扫码激活</text>
          <text class="row-arrow" style="color: {{ theme.textSecondary }}">›</text>
        </div>
        <text class="path-sub" style="color: {{ theme.accent }}">安卓 · 2 步 · 推荐</text>
      </div>

      <div class="path-card" onclick="openPathB" style="background-color: {{ theme.card }}">
        <div class="path-head">
          <div class="path-badge" style="background-color: {{ theme.cardLight }}">
            <text class="path-badge-text" style="color: {{ theme.text }}">B</text>
          </div>
          <text class="path-title" style="color: {{ theme.text }}">手工激活</text>
          <text class="row-arrow" style="color: {{ theme.textSecondary }}">›</text>
        </div>
        <text class="path-sub" style="color: {{ theme.textSecondary }}">全平台 · 3 步</text>
      </div>
    </block>

    <div class="info-row" onclick="openInfoPage">
      <text class="info-text" style="color: {{ theme.textSecondary }}">历史 · 设备信息</text>
      <text class="row-arrow" style="color: {{ theme.textMuted }}">›</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")
const ctx = require("./shared/activation-context.js")

function formatDate(ts) {
  if (!ts) return ''
  var d = new Date(ts)
  var y = d.getFullYear()
  var m = String(d.getMonth() + 1)
  if (m.length < 2) m = '0' + m
  var day = String(d.getDate())
  if (day.length < 2) day = '0' + day
  return y + '-' + m + '-' + day
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    isActivated: false,
    statusText: '高级版',
    statusSub: '未激活 · 待解锁',
    statusColor: '#888899'
  },

  onInit() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadStatus()
  },

  // 从子页返回时必须重读，保证激活完成后状态即时切换
  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadStatus()
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadStatus() {
    var self = this
    try {
      authStore.getFullStatus(function(status) {
        var activated = !!status.isActivated
        self.isActivated = activated

        if (status.isPermanent) {
          self.statusText = '高级版'
          self.statusSub = '已激活 · 永久有效'
          self.statusColor = 'green'
        } else if (activated && status.isExpired) {
          self.statusText = '高级版'
          self.statusSub = '已过期 · 可重新激活'
          self.statusColor = 'red'
        } else if (activated && status.isExpiring) {
          self.statusText = '高级版'
          self.statusSub = '已激活 · 即将到期'
          self.statusColor = '#e67e22'
        } else if (activated) {
          self.statusText = '高级版'
          self.statusSub = '已激活 · ' + (formatDate(status.expireAt) || '有效期未知') + ' 到期'
          self.statusColor = 'green'
        } else {
          self.statusText = '标准版'
          self.statusSub = '未激活 · 待解锁'
          self.statusColor = 'gray'
        }
      })
    } catch (e) {
      self.statusText = '标准版'
      self.statusSub = '未激活 · 待解锁'
    }
  },

  goBack() {
    router.back()
  },

  openPurchase() {
    router.push({ uri: 'pages/activation/step-purchase' })
  },

  // A 路径：只有一页，页尾是终态提示，不设「下一步」
  openPathA() {
    router.push({ uri: 'pages/activation/path-a-sync' })
  },

  // B 路径：取码 → 输码
  openPathB() {
    router.push({ uri: 'pages/activation/path-b-redeem' })
  },

  openInfoPage() {
    router.push({ uri: 'pages/activation/activation-info' })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 40px;
  margin-bottom: 8px;
}

.back-btn-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 20px;
  height: 20px;
}

/* 关键：不设 lines / text-overflow，标题靠 flex 吃满剩余宽度 */
.header-title {
  flex: 1;
  font-size: 26px;
  font-weight: bold;
  text-align: center;
  line-height: 34px;
}

.status-card {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 10px 8px 12px 8px;
  border-radius: 12px;
  margin-bottom: 16px;
}

.status-main {
  font-size: 26px;
  font-weight: bold;
  line-height: 32px;
}

.status-sub {
  font-size: 16px;
  line-height: 20px;
}

/* 唯一全局序号：购买 */
.buy-row {
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 42px;
  padding: 0 10px;
  border-radius: 12px;
  margin-bottom: 8px;
}

.buy-badge {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 7px;
}

.buy-badge-num {
  font-size: 13px;
  font-weight: bold;
  line-height: 16px;
}

.buy-text {
  flex: 1;
  font-size: 20px;
  line-height: 24px;
}

.row-arrow {
  font-size: 22px;
  line-height: 24px;
  flex-shrink: 0;
  margin-left: 2px;
}

.section-label {
  font-size: 16px;
  line-height: 20px;
  padding-left: 2px;
  margin-bottom: 6px;
}

/* 路径卡：整卡可点，两行（标题行 + 属性行） */
.path-card {
  width: 100%;
  flex-direction: column;
  padding: 7px 10px 8px 10px;
  border-radius: 12px;
  margin-bottom: 7px;
}

.path-head {
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.path-badge {
  width: 18px;
  height: 18px;
  border-radius: 9px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 5px;
}

.path-badge-text {
  font-size: 12px;
  font-weight: bold;
  line-height: 15px;
}

.path-title {
  flex: 1;
  font-size: 20px;
  font-weight: bold;
  line-height: 22px;
}

.path-tag {
  font-size: 12px;
  line-height: 16px;
  flex-shrink: 0;
  margin-right: 2px;
}

.path-sub {
  font-size: 16px;
  line-height: 19px;
  margin-top: 2px;
}

.info-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 38px;
  margin-top: auto;
}

.info-text {
  font-size: 16px;
  line-height: 22px;
}

@media (shape: pill-shaped) {
  .page {
    padding: 26px 16px 22px 16px;
  }

  .header {
    height: 36px;
    margin-bottom: 6px;
  }

  .back-btn-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 18px;
    height: 18px;
  }

  .header-title {
    font-size: 26px;
    line-height: 30px;
  }

  .status-main {
    font-size: 26px;
    line-height: 30px;
  }

  .status-sub {
    font-size: 16px;
    line-height: 19px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
