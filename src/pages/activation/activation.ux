}































.bottom-spacer {
  height: 30px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: pill-shaped) {
  .page {
    padding: 30px 16px 30px 16px;
  }

  .header-title {
    font-size: 28px;
    line-height: 36px;
  }

  .back-btn-wrapper {
    width: 44px;
    height: 44px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 24px;
    height: 24px;
  }

  .header-placeholder {
    width: 36px;
  }


}

