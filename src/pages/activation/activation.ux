<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- header: 不放 header-placeholder（它是标题被挤成「高...」的元凶），标题 flex:1 不设 lines 限制 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">高级版</text>
    </div>

    <!-- 状态：3 个位置 @44px，卡内近乎占满。副标不带分隔符（原「未激活 · 待解锁」= 7.1 位置） -->
    <div class="status-card" style="background-color: {{ theme.card }}">
      <text class="status-main" style="color: {{ statusColor }}">{{ statusText }}</text>
      <text class="status-sub" style="color: {{ theme.textSecondary }}">{{ statusSub }}</text>
    </div>

    <!-- 未激活：购买入口（无序号徽标 —— 「1」是四步错觉的残留）+ A/B 二选一。已激活整体收起 -->
    <block if="{{ !isActivated }}">
      <div class="buy-row" onclick="openPurchase" style="background-color: {{ theme.card }}">
        <text class="buy-text" style="color: {{ theme.text }}">购买兑换码</text>
        <text class="row-arrow" style="color: {{ theme.textSecondary }}">›</text>
      </div>

      <!-- 7 个位置 @24px = 168px，正好铺满。原「激活方式 · 二选一」= 8.1 位置 -->
      <text class="section-label" style="color: {{ theme.textMuted }}">激活方式二选一</text>

      <!-- A 路：「A 扫码激活」= 0.55+0.3+4 = 4.85 位置 @28px ≈ 150px，加箭头正好占满 -->
      <div class="path-card" onclick="openPathA" style="background-color: {{ theme.card }}">
        <div class="path-head">
          <text class="path-key" style="color: {{ theme.accent }}">A</text>
          <text class="path-title" style="color: {{ theme.text }}">扫码激活</text>
          <text class="row-arrow" style="color: {{ theme.textSecondary }}">›</text>
        </div>
        <text class="path-sub" style="color: {{ theme.accent }}">安卓 2 步</text>
      </div>

      <div class="path-card" onclick="openPathB" style="background-color: {{ theme.card }}">
        <div class="path-head">
          <text class="path-key" style="color: {{ theme.textSecondary }}">B</text>
          <text class="path-title" style="color: {{ theme.text }}">手工激活</text>
          <text class="row-arrow" style="color: {{ theme.textSecondary }}">›</text>
        </div>
        <text class="path-sub" style="color: {{ theme.textSecondary }}">全平台 3 步</text>
      </div>
    </block>

    <!-- 7 个位置 @24px 铺满，无箭头（箭头会顶到 8 位置） -->
    <div class="info-row" onclick="openInfoPage">
      <text class="info-text" style="color: {{ theme.textSecondary }}">历史与设备信息</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")
const ctx = require("./shared/activation-context.js")

// 只保留「M月D日到期」：完整日期 "2026-11-01 到期" = 12.3 位置，超一倍
function formatExpireShort(ts) {
  if (!ts) return '有效期未知'
  var d = new Date(ts)
  return (d.getMonth() + 1) + '月' + d.getDate() + '日到期'
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    isActivated: false,
    statusText: '高级版',
    statusSub: '未激活',
    statusColor: '#888899'
  },

  onInit() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadStatus()
  },

  // 从子页返回时必须重读，保证激活完成后状态即时切换
  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadStatus()
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadStatus() {
    var self = this
    try {
      authStore.getFullStatus(function(status) {
        var activated = !!status.isActivated
        self.isActivated = activated

        if (status.isPermanent) {
          self.statusText = '高级版'
          self.statusSub = '永久有效'
          self.statusColor = 'green'
        } else if (activated && status.isExpired) {
          self.statusText = '高级版'
          self.statusSub = '已过期'
          self.statusColor = 'red'
        } else if (activated && status.isExpiring) {
          self.statusText = '高级版'
          self.statusSub = '即将到期'
          self.statusColor = '#e67e22'
        } else if (activated) {
          self.statusText = '高级版'
          self.statusSub = formatExpireShort(status.expireAt)
          self.statusColor = 'green'
        } else {
          self.statusText = '标准版'
          self.statusSub = '未激活'
          self.statusColor = 'gray'
        }
      })
    } catch (e) {
      self.statusText = '标准版'
      self.statusSub = '未激活'
    }
  },

  goBack() {
    router.back()
  },

  openPurchase() {
    router.push({ uri: 'pages/activation/step-purchase' })
  },

  // A 路径：只有一页，页尾是终态提示，不设「下一步」
  openPathA() {
    router.push({ uri: 'pages/activation/path-a-sync' })
  },

  // B 路径：取码 → 输码
  openPathB() {
    router.push({ uri: 'pages/activation/path-b-redeem' })
  },

  openInfoPage() {
    router.push({ uri: 'pages/activation/activation-info' })
  }
}
</script>

<style>
/* 六字真言：内容宽 192-24 = 168px。6 位置 @28px = 168px；7 位置 @24px = 168px */
.page {
  flex-direction: column;
  padding: 44px 12px 12px 12px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 40px;
  margin-bottom: 6px;
}

.back-btn-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 20px;
  height: 20px;
}

/* 关键：不设 lines / text-overflow，标题靠 flex 吃满剩余宽度 */
.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 36px;
}

.status-card {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 8px 8px 10px 8px;
  border-radius: 12px;
  margin-bottom: 12px;
}

/* 44px × 3 字 = 132px，卡内 152px，余 20px —— 全页最大字号，状态是第一焦点 */
.status-main {
  font-size: 44px;
  font-weight: bold;
  line-height: 52px;
}

.status-sub {
  font-size: 24px;
  line-height: 28px;
}

/* 原「1 购买兑换码」：删掉序号徽标，5 字 @28px + 箭头 = 占满 156px */
.buy-row {
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 44px;
  padding: 0 6px;
  border-radius: 12px;
  margin-bottom: 8px;
}

.buy-text {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
}

.row-arrow {
  font-size: 24px;
  line-height: 28px;
  flex-shrink: 0;
}

.section-label {
  font-size: 24px;
  line-height: 28px;
  margin-bottom: 4px;
}

/* 路径卡：删掉 A/B 圆形徽标，改为行首半角字母（0.55 位置），省下 30px 全给标题 */
.path-card {
  width: 100%;
  flex-direction: column;
  padding: 6px 8px 7px 8px;
  border-radius: 12px;
  margin-bottom: 8px;
}

.path-head {
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.path-key {
  font-size: 28px;
  font-weight: bold;
  line-height: 32px;
  flex-shrink: 0;
  margin-right: 8px;
}

.path-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  line-height: 32px;
}

.path-sub {
  font-size: 24px;
  line-height: 28px;
  margin-top: 2px;
}

.info-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 34px;
  margin-top: auto;
}

.info-text {
  font-size: 24px;
  line-height: 28px;
}

@media (shape: pill-shaped) {
  .page {
    padding: 26px 12px 20px 12px;
  }

  .header {
    height: 36px;
    margin-bottom: 6px;
  }

  .back-btn-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 18px;
    height: 18px;
  }

  .status-main {
    line-height: 50px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
