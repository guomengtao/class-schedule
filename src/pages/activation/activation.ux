<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="page-scroll" scroll-y="{{true}}">
      <div class="header">
        <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
        <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">高级版</text>
      <div class="header-placeholder"></div>
      </div>
      <!-- 状态卡只留 2 行：状态 + 有效期。版本号移到 info 页，去掉重复的到期文案 -->
      <div class="status-card">
        <text class="status-main" style="color: {{ statusColor }}">{{ statusText }}</text>
        <text class="status-expiry" show="{{ expireTimeText }}" style="color: {{ theme.textSecondary }}">有效期 {{ expireTimeText }}</text>
      </div>
      <!-- 购买卡：老版「激活软件·步骤1」原样上浮主页首屏。购买是第一优先级，不下单激活无从谈起 -->
      <div class="purchase-card" style="background-color: {{ theme.card }}">
        <text class="purchase-title" style="color: {{ theme.text }}">购买兑换码</text>
        <text class="purchase-desc" style="color: {{ theme.textSecondary }}">爱发电购买</text>
        <div class="purchase-qr" if="{{ afdianUrl }}">
          <qrcode class="qr-code" value="{{ afdianUrl }}" style="color: #000000; background-color: #ffffff;"></qrcode>
        </div>
        <text class="qr-loading" if="{{ !afdianUrl }}" style="color: {{ theme.textMuted }}">正在生成二维码...</text>
      </div>

      <div class="entry-primary" onclick="openCodePage" style="background-color: {{ theme.accent }}">
        <text class="entry-primary-text" style="color: {{ theme.bg }}">输入激活码</text>
        <text class="entry-primary-arrow" style="color: {{ theme.bg }}">›</text>
      </div>

      <div class="entry-secondary" onclick="openGuidePage" style="background-color: {{ theme.card }}">
        <text class="entry-secondary-text" style="color: {{ theme.text }}">激活步骤指南</text>
        <text class="entry-secondary-arrow" style="color: {{ theme.textSecondary }}">›</text>
      </div>

      <div class="entry-footer" onclick="openInfoPage">
        <text class="entry-footer-text" style="color: {{ theme.textSecondary }}">激活历史 · 设备信息</text>
        <text class="entry-footer-arrow" style="color: {{ theme.textMuted }}">›</text>
      </div>

      <div class="bottom-spacer"></div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")
const version = require("../../data/version.js")

var AFDIAN_REDIRECT_URL = "https://app-auth.gudq.com/go/ev-timetable?deviceId="

function formatDate(ts) {
  if (!ts) return ''
  var d = new Date(ts)
  var y = d.getFullYear()
  var m = String(d.getMonth() + 1)
  if (m.length < 2) m = '0' + m
  var day = String(d.getDate())
  if (day.length < 2) day = '0' + day
  return y + '-' + m + '-' + day
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    statusText: '加载中...',
    statusColor: '#888899',
    expireTimeText: '',
    afdianUrl: '',
    deviceId: '',
    deviceInfoParams: '',
    channelParam: version.channel || ''
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadStatus()
    self.fetchDeviceId()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadStatus() {
    var self = this
    try {
      authStore.getFullStatus(function(status) {
        self.statusText = status.displayStatus || status.text
        self.statusColor = status.color

        if (status.isPermanent) {
          self.statusText = '高级版'
          self.statusColor = 'green'
        } else if (status.isActivated && status.isExpired) {
          self.statusText = '高级版'
          self.statusColor = 'red'
        } else if (status.isActivated && status.isExpiring) {
          self.statusText = '高级版'
          self.statusColor = '#e67e22'
        } else if (status.isActivated) {
          self.statusText = '高级版'
          self.statusColor = 'green'
        } else {
          self.statusText = '标准版'
          self.statusColor = 'gray'
        }

        if (status.isPermanent) {
          self.expireTimeText = '永久有效'
        } else if (status.expireAt) {
          self.expireTimeText = formatDate(status.expireAt)
        } else {
          self.expireTimeText = ''
        }
      })
    } catch (e) {
      dlog('[ACTIVATION] loadStatus error: ' + e)
    }
  },

  // 设备ID与购买二维码（afdianUrl 拼接逻辑与老版单页一致：deviceId + 设备信息参数 + 版本 + 渠道）
  fetchDeviceId() {
    var self = this
    try {
      var device = require("@system.device")
      device.getDeviceId({
        success: function(data) {
          var raw = data.deviceId || ''
          if (!raw || raw === 'NA' || raw === 'unknown' || raw === 'null') {
            self._fallbackToLocalUUID()
          } else {
            self.deviceId = raw
            self.updateAfdianUrl()
            self.fetchDeviceInfo()
          }
        },
        fail: function() {
          self._fallbackToLocalUUID()
        }
      })
    } catch (e) {
      self._fallbackToLocalUUID()
    }
  },

  _fallbackToLocalUUID() {
    var self = this
    var deviceUuid = require("../../utils/device-uuid.js")
    deviceUuid.getLocalDeviceId(function(id) {
      self.deviceId = id
      self.updateAfdianUrl()
      self.fetchDeviceInfo()
    })
  },

  fetchDeviceInfo() {
    var self = this
    try {
      var device = require("@system.device")
      device.getInfo({
        success: function(ret) {
          var params = []
          if (ret.model) params.push('m=' + encodeURIComponent(ret.model))
          if (ret.product) params.push('p=' + encodeURIComponent(ret.product))
          if (ret.osVersionCode != null) params.push('o=' + ret.osVersionCode)
          if (ret.platformVersionCode != null) params.push('v=' + ret.platformVersionCode)
          if (ret.deviceType) params.push('t=' + encodeURIComponent(ret.deviceType))
          if (ret.screenShape) params.push('s=' + encodeURIComponent(ret.screenShape))
          if (ret.screenWidth != null) params.push('w=' + ret.screenWidth)
          if (ret.screenHeight != null) params.push('h=' + ret.screenHeight)
          if (ret.APILevel != null) params.push('a=' + ret.APILevel)
          if (ret.language) params.push('l=' + encodeURIComponent(ret.language))
          self.deviceInfoParams = params.join('&')
          self.updateAfdianUrl()
        },
        fail: function() {
          self.deviceInfoParams = ''
          self.updateAfdianUrl()
        }
      })
    } catch (e) {
      self.deviceInfoParams = ''
      self.updateAfdianUrl()
    }
  },

  updateAfdianUrl() {
    var self = this
    if (!self.deviceId || self.deviceId === '获取中...') {
      return
    }
    var afd = AFDIAN_REDIRECT_URL + encodeURIComponent(self.deviceId)
    if (self.deviceInfoParams) {
      afd = afd + '&' + self.deviceInfoParams
    }
    if (self.channelParam) {
      afd = afd + '&c=' + encodeURIComponent(self.channelParam)
    }
    self.afdianUrl = afd
  },

  openCodePage() {
    router.push({ uri: 'pages/activation/activation-code' });
  },
  goBack() {
    router.back()
  },

  openGuidePage() {
    router.push({ uri: 'pages/activation/activation-guide' })
  },

  openInfoPage() {
    router.push({ uri: 'pages/activation/activation-info' })
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
  
}

.header-title {
  font-size: 32px;
  font-weight: bold;
}

.page-scroll {
  flex: 1;
  flex-direction: column;
}

.status-card {
  width: 100%;
  flex-direction: column;
  padding: 4px 0 2px 0;
  margin-bottom: 10px;
  align-items: center;
}

.status-main {
  font-size: 32px;
  font-weight: bold;
  margin-bottom: 2px;
}

.status-expiry {
  font-size: 22px;
  line-height: 28px;
}

.bottom-spacer {
  height: 12px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: pill-shaped) {
  .page {
    padding: 30px 16px 30px 16px;
  }

  .header-title {
    font-size: 28px;
    line-height: 36px;
  }

  .back-btn-wrapper {
    width: 44px;
    height: 44px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 24px;
    height: 24px;
  }

  .header-placeholder {
    width: 36px;
  }

}

@media (shape: rect) {
  .page {
    padding: 6px 8px 8px 8px;
  }
}

/* 购买卡：老版「激活软件·步骤1」原样上浮，首屏第一优先级 */
.purchase-card {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 8px 10px 8px 10px;
  margin-bottom: 6px;
  border-radius: 12px;
}

.purchase-title {
  font-size: 22px;
  font-weight: bold;
  line-height: 28px;
  margin-bottom: 2px;
}

.purchase-desc {
  font-size: 20px;
  line-height: 26px;
  margin-bottom: 6px;
}

.purchase-qr {
  align-items: center;
  justify-content: center;
}

.qr-code {
  width: 80px;
  height: 80px;
}

.qr-loading {
  font-size: 20px;
  line-height: 26px;
  height: 80px;
  text-align: center;
}

.entry-primary {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 168px;
  min-height: 52px;
  padding: 0 16px;
  border-radius: 26px;
  margin-bottom: 8px;
}

.entry-primary-text {
  font-size: 24px;
  font-weight: bold;
  line-height: 34px;
}

.entry-primary-arrow {
  font-size: 28px;
  line-height: 34px;
}

.entry-secondary {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 168px;
  min-height: 52px;
  padding: 0 16px;
  border-radius: 26px;
  margin-bottom: 8px;
}

.entry-secondary-text {
  font-size: 22px;
  line-height: 30px;
}

.entry-secondary-arrow {
  font-size: 26px;
  line-height: 30px;
}

/* 次级下拉入口：历史与设备信息（指向 info 页），热区 44 高 */
.entry-footer {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 44px;
  margin-bottom: 4px;
}

.entry-footer-text {
  font-size: 22px;
  line-height: 28px;
}

.entry-footer-arrow {
  font-size: 24px;
  line-height: 28px;
  margin-left: 4px;
}
</style>