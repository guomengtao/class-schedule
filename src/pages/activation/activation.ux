<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- header: 不放 header-placeholder（它是标题被挤成「高...」的元凶），标题 flex:1 不设 lines 限制 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">高级版</text>
        <div class="header-placeholder"></div>
    </div>

    <!-- 状态区：去掉卡片底色，裸大字 + 宽行高。与下方卡片形成「裸文 vs 卡片」层级，不花一个位置 -->
    <div class="status">
      <text class="status-main" style="color: {{ statusColor }}">{{ statusText }}</text>
      <text class="status-sub" style="color: {{ theme.textSecondary }}">{{ statusSub }}</text>
    </div>

    <!-- 未激活：购买入口 + A/B 二选一（无序号徽标、无分隔符、无分组标签） -->
    <block if="{{ !isActivated }}">
      <div class="buy-row" onclick="openPurchase" style="background-color: {{ theme.cardLight }}">
        <text class="buy-text" style="color: {{ theme.text }}">购买兑换码</text>
      </div>

      <!-- A/B 紧贴（间距 10）与其他组间距（14/12）形成节奏，「二选一」由布局表达，不用文字占位置 -->
      <div class="path-card" onclick="openPathA" style="background-color: {{ theme.card }}">
        <div class="path-head">
          <text class="path-key" style="color: {{ theme.accent }}">A</text>
          <text class="path-title" style="color: {{ theme.text }}">扫码激活</text>
        </div>
        <text class="path-sub" style="color: {{ theme.accent }}">安卓 2 步</text>
      </div>

      <div class="path-card" onclick="openPathB" style="background-color: {{ theme.card }}">
        <div class="path-head">
          <text class="path-key" style="color: {{ theme.textSecondary }}">B</text>
          <text class="path-title" style="color: {{ theme.text }}">手工激活</text>
        </div>
        <text class="path-sub" style="color: {{ theme.textSecondary }}">全平台 3 步</text>
      </div>
    </block>

    <!-- 已激活：仅剩一个低频入口，用 margin-top:auto 推到底，中间留白自然分布 -->
    <block if="{{ isActivated }}">
      <div class="info-row" onclick="openInfoPage">
        <text class="info-text" style="color: {{ theme.textSecondary }}">历史与设备信息</text>
      </div>
    </block>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")
const ctx = require("./shared/activation-context.js")

// 只保留「M月D日到期」：完整日期 "2026-11-01 到期" = 12.3 位置，超一倍
function formatExpireShort(ts) {
  if (!ts) return '有效期未知'
  var d = new Date(ts)
  return (d.getMonth() + 1) + '月' + d.getDate() + '日到期'
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    isActivated: false,
    statusText: '高级版',
    statusSub: '未激活',
    statusColor: '#888899'
  },

  onInit() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadStatus()
  },

  // 从子页返回时必须重读，保证激活完成后状态即时切换
  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadStatus()
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadStatus() {
    var self = this
    try {
      authStore.getFullStatus(function(status) {
        var activated = !!status.isActivated
        self.isActivated = activated

        if (status.isPermanent) {
          self.statusText = '高级版'
          self.statusSub = '永久有效'
          self.statusColor = 'green'
        } else if (activated && status.isExpired) {
          self.statusText = '高级版'
          self.statusSub = '已过期'
          self.statusColor = 'red'
        } else if (activated && status.isExpiring) {
          self.statusText = '高级版'
          self.statusSub = '即将到期'
          self.statusColor = '#e67e22'
        } else if (activated) {
          self.statusText = '高级版'
          self.statusSub = formatExpireShort(status.expireAt)
          self.statusColor = 'green'
        } else {
          self.statusText = '标准版'
          self.statusSub = '未激活'
          self.statusColor = 'gray'
        }
      })
    } catch (e) {
      self.statusText = '标准版'
      self.statusSub = '未激活'
    }
  },

  goBack() {
    router.back()
  },

  openPurchase() {
    router.push({ uri: 'pages/activation/step-purchase' })
  },

  // A 路径：只有一页，页尾是终态提示，不设「下一步」
  openPathA() {
    router.push({ uri: 'pages/activation/path-a-sync' })
  },

  // B 路径：取码 → 输码
  openPathB() {
    router.push({ uri: 'pages/activation/path-b-redeem' })
  },

  openInfoPage() {
    router.push({ uri: 'pages/activation/activation-info' })
  }
}
</script>

<style>
/* 位置是硬约束（宽度），行高是弹性约束（高度）。
   行高一路上调到 1.36~1.42 换呼吸感；字号一档没降。
   内容宽 168px = 6 位置 @28px = 7 位置 @24px。 */
.page {
  flex-direction: column;
  padding: 32px 12px 16px 12px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 36px;
  margin-bottom: 12px;
}

.back-btn-wrapper {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

/* 不设 lines / text-overflow，标题靠 flex 吃满剩余宽度 */
.header-title {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 32px;
}

.header-placeholder {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
}


/* 状态区：无卡片底色，靠留白和层级区分，不与下方卡片抢视觉重量 */
.status {
  flex-direction: column;
  width: 100%;
  margin-bottom: 14px;
}

/* 44px × 3 字 = 132/168px。行高 60 = 1.36 倍，字不再贴顶贴底 */
.status-main {
  font-size: 44px;
  font-weight: bold;
  line-height: 60px;
}

.status-sub {
  font-size: 24px;
  line-height: 34px;
  margin-top: 4px;
}

/* 主操作：亮一档底色（cardLight），与 A/B 卡（card）拉开层级，不加边框不加图标 */
.buy-row {
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 58px;
  padding: 0 6px;
  border-radius: 14px;
  margin-bottom: 12px;
}

.buy-text {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
}

/* 全页无导航箭头：官方链接本身就是「点击即进」，加 › 只是装饰又白占 0.5 位置 */

/* 路径卡：上下 11px 内边距 + 38px 标题行 + 34px 副标行 = 100px，卡内不挤 */
.path-card {
  width: 100%;
  flex-direction: column;
  padding: 11px 8px;
  border-radius: 14px;
  margin-bottom: 10px;
}

.path-head {
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.path-key {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  flex-shrink: 0;
  margin-right: 8px;
}

.path-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
}

.path-sub {
  font-size: 24px;
  line-height: 34px;
  margin-top: 6px;
}

/* 已激活态：单入口推到底，空白自然落在中间，不硬填 */
.info-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 40px;
  margin-top: auto;
}

.info-text {
  font-size: 24px;
  line-height: 34px;
}

@media (shape: pill-shaped) {
  .page {
    padding: 26px 12px 18px 12px;
  }

  .header-title {
    font-size: 24px;
    line-height: 32px;
  }

  .status-main {
    line-height: 58px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
