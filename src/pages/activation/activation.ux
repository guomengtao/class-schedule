<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <input class="back-btn" type="button" value="◀ 返回" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="header-title" style="color: {{ theme.text }}">软件授权</text>
    </div>

    <scroll class="page-scroll" scroll-y="{{true}}">
      <div class="status-card" style="background-color: {{ theme.card }}">
        <div class="status-row">
          <text class="status-icon" style="color: {{ statusColor }}">[</text>
          <text class="status-text" style="color: {{ statusColor }}">{{ statusText }}</text>
          <text class="status-icon" style="color: {{ statusColor }}">]</text>
        </div>
        <div class="status-details" if="{{ statusDetail }}">
          <text class="status-detail-line" style="color: {{ theme.textSecondary }}">{{ statusDetail }}</text>
        </div>
        <div class="status-actions" if="{{ showRenewButton }}">
          <input class="renew-btn" type="button" value="去续费" onclick="goToRenew" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        </div>
      </div>

      <text class="section-title" style="color: {{ theme.text }}">激活历史</text>
      <div class="history-list" style="background-color: {{ theme.card }}">
        <div for="{{ historyList }}" class="history-item">
          <div class="history-left">
            <text class="history-date" style="color: {{ theme.textSecondary }}">{{ $item.date }}</text>
            <text class="history-type" style="color: {{ theme.text }}">{{ $item.type }}</text>
          </div>
          <div class="history-right">
            <text class="history-duration" style="color: {{ theme.accent }}">{{ $item.duration }}</text>
            <text class="history-status" style="color: {{ $item.status === '成功' ? '#27ae60' : '#e74c3c' }}">{{ $item.status }}</text>
          </div>
        </div>
        <div class="history-empty" if="{{ historyList.length === 0 }}">
          <text class="history-empty-text" style="color: {{ theme.textMuted }}">暂无激活记录</text>
        </div>
      </div>

      <text class="section-title" style="color: {{ theme.text }}">设备信息</text>
      <div class="device-card" style="background-color: {{ theme.card }}">
        <div class="device-info-row">
          <text class="device-info-label" style="color: {{ theme.textSecondary }}">设备ID</text>
          <text class="device-info-value" style="color: {{ theme.accent }}">{{ deviceId || '获取中...' }}</text>
        </div>
        <div class="device-info-row">
          <text class="device-info-label" style="color: {{ theme.textSecondary }}">首次安装</text>
          <text class="device-info-value" style="color: {{ theme.text }}">{{ installTimeText }}</text>
        </div>
        <div class="device-info-row" if="{{ expireTimeText }}">
          <text class="device-info-label" style="color: {{ theme.textSecondary }}">到期时间</text>
          <text class="device-info-value" style="color: {{ theme.text }}">{{ expireTimeText }}</text>
        </div>
      </div>

      <text class="section-title" style="color: {{ theme.text }}">激活软件</text>

      <div class="step-card" style="background-color: {{ theme.card }}">
        <div class="step-header">
          <div class="step-badge" style="background-color: {{ theme.accent }}">
            <text class="step-badge-text" style="color: {{ theme.bg }}">1</text>
          </div>
          <text class="step-title" style="color: {{ theme.text }}">爱发电购买兑换码</text>
        </div>
        <text class="step-desc" style="color: {{ theme.textSecondary }}">使用手机扫描下方二维码，或在浏览器中访问爱发电网址，购买软件授权兑换码</text>
        <div class="qr-section">
          <div class="qr-wrapper" style="background-color: #ffffff">
            <qrcode value="{{ afdianUrl }}" style="color: #000000; background-color: #ffffff; width: 140px; height: 140px;"></qrcode>
          </div>
          <text class="qr-label" style="color: {{ theme.textSecondary }}">扫码打开爱发电</text>
        </div>
        <div class="url-box" style="background-color: {{ theme.bg }}">
          <text class="url-text" style="color: {{ theme.accent }}">{{ afdianUrl }}</text>
        </div>
      </div>

      <div class="step-arrow" style="color: {{ theme.textMuted }}">▼</div>

      <div class="step-card" style="background-color: {{ theme.card }}">
        <div class="step-header">
          <div class="step-badge" style="background-color: {{ theme.accent }}">
            <text class="step-badge-text" style="color: {{ theme.bg }}">2</text>
          </div>
          <text class="step-title" style="color: {{ theme.text }}">兑换激活码</text>
        </div>
        <text class="step-desc" style="color: {{ theme.textSecondary }}">购买后，扫描下方二维码打开激活页面，输入兑换码获取12位激活码</text>
        <div class="device-row">
          <text class="device-label" style="color: {{ theme.textSecondary }}">本机设备ID</text>
          <text class="device-value" style="color: {{ theme.accent }}">{{ deviceId || '获取中...' }}</text>
        </div>
        <div class="qr-section" if="{{ qrText }}">
          <div class="qr-wrapper" style="background-color: #ffffff">
            <qrcode value="{{ qrText }}" style="color: #000000; background-color: #ffffff; width: 140px; height: 140px;"></qrcode>
          </div>
          <text class="qr-label" style="color: {{ theme.textSecondary }}">扫码兑换激活码</text>
        </div>
        <div class="qr-section" if="{{ !qrText }}">
          <text class="qr-loading" style="color: {{ theme.textMuted }}">正在生成二维码...</text>
        </div>
        <div class="url-box" if="{{ qrText }}" style="background-color: {{ theme.bg }}">
          <text class="url-text" style="color: {{ theme.textMuted }}">{{ qrText }}</text>
        </div>
      </div>

      <div class="step-arrow" style="color: {{ theme.textMuted }}">▼</div>

      <div class="step-card" style="background-color: {{ theme.card }}">
        <div class="step-header">
          <div class="step-badge" style="background-color: {{ theme.accent }}">
            <text class="step-badge-text" style="color: {{ theme.bg }}">3</text>
          </div>
          <text class="step-title" style="color: {{ theme.text }}">输入激活码</text>
        </div>
        <text class="step-desc" style="color: {{ theme.textSecondary }}">将从网页获取的12位激活码输入下方，前4位+后4位含字母，中间4位纯数字</text>

        <div class="stepper-panel" style="background-color: {{ theme.bg }}">
          <div class="stepper-row">
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(0)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d0 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(0)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(1)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d1 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(1)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(2)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d2 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(2)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(3)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d3 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(3)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(4)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d4 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(4)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(5)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d5 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(5)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(6)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d6 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(6)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(7)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d7 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(7)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
          <div class="stepper-row">
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(8)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d8 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(8)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(9)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d9 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(9)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(10)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d10 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(10)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-gap"></text>
            <input class="stepper-btn" type="button" value="-" onclick="decreaseDigit(11)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
            <text class="stepper-val" style="color: {{ theme.text }}">{{ d11 }}</text>
            <input class="stepper-btn" type="button" value="+" onclick="increaseDigit(11)" style="background-color: {{ theme.cardLight }}; color: {{ theme.accent }}" />
          </div>
        </div>

        <input class="verify-btn" type="button" value="验证激活码" onclick="doVerify" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />

        <div class="result-box" show="{{ verifyResult }}" style="background-color: {{ theme.bg }}; border-color: {{ verifySuccess ? theme.accent : '#e74c3c' }}">
          <text class="result-label" style="color: {{ theme.textSecondary }}">验证结果</text>
          <text class="result-code" style="color: {{ verifySuccess ? theme.accent : '#e74c3c' }}">{{ verifyResult }}</text>
          <text class="result-detail" show="{{ verifyDetail }}" style="color: {{ theme.textSecondary }}">{{ verifyDetail }}</text>
        </div>
      </div>

      <div class="bottom-spacer"></div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")

var CHARSET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
var DIGITS = "0123456789"
var BASE = 62

var ACTIVATION_URL = "https://activate.example.com/activate?device="
var AFDIAN_URL = "https://afdian.com/a/your-creator"

function encode4(n) {
  var result = ''
  var v = n
  for (var i = 0; i < 4; i++) {
    result = CHARSET[v % BASE] + result
    v = Math.floor(v / BASE)
  }
  return result
}

function deviceIdToHash(id) {
  var hash = 0
  for (var i = 0; i < id.length; i++) {
    hash = ((hash << 5) - hash) + id.charCodeAt(i)
    hash = hash & hash
  }
  return encode4(Math.abs(hash) % 10000)
}

function checksum(str) {
  var hash = 0
  for (var i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i)
    hash = hash & hash
  }
  return encode4(Math.abs(hash) % 10000)
}

function decrypt(encrypted) {
  if (encrypted.length !== 12) return null
  var idPart = encrypted.substring(0, 4)
  var daysPart = encrypted.substring(4, 8)
  var code = encrypted.substring(8, 12)
  if (!/^\d{4}$/.test(daysPart)) return null
  var plain = idPart + daysPart
  if (checksum(plain) !== code) return null
  var days = parseInt(daysPart, 10)
  return {
    idHash: idPart,
    days: days === 9999 ? -1 : days,
    isPermanent: days === 9999
  }
}

function verifyActivation(encrypted, myDeviceId) {
  var result = decrypt(encrypted)
  if (!result) return { success: false, reason: '激活码无效' }
  var myHash = deviceIdToHash(myDeviceId)
  if (result.idHash !== myHash) {
    return { success: false, reason: '设备ID不匹配' }
  }
  return {
    success: true,
    days: result.days,
    isPermanent: result.isPermanent
  }
}

function formatDate(ts) {
  if (!ts) return ''
  var d = new Date(ts)
  var y = d.getFullYear()
  var m = String(d.getMonth() + 1)
  if (m.length < 2) m = '0' + m
  var day = String(d.getDate())
  if (day.length < 2) day = '0' + day
  return y + '-' + m + '-' + day
}

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    statusText: '加载中...',
    statusColor: '#888899',
    statusDetail: '',
    showRenewButton: false,
    historyList: [],
    installTimeText: '',
    expireTimeText: '',
    afdianUrl: AFDIAN_URL,
    deviceId: '',
    qrText: '',
    d0: '0', d1: '0', d2: '0', d3: '0',
    d4: '0', d5: '0', d6: '0', d7: '0',
    d8: '0', d9: '0', d10: '0', d11: '0',
    verifyResult: '',
    verifyDetail: '',
    verifySuccess: false
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.fetchDeviceId()
    self.loadStatus()
    self.loadHistory()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.loadStatus()
    self.loadHistory()
  },

  loadStatus() {
    var self = this
    try {
      authStore.getFullStatus(function(status) {
        self.statusText = status.displayStatus || status.text
        self.statusColor = status.color

        if (status.isPermanent) {
          self.statusText = '已永久激活 ' + (status.displayStatus || '')
          self.showRenewButton = false
        } else if (status.isExpired) {
          self.statusText = '已过期 ' + (status.displayStatus || '')
          self.showRenewButton = true
        } else if (status.isExpiring) {
          self.statusText = '即将到期 ' + (status.displayStatus || '')
          self.showRenewButton = true
        } else if (status.isActivated) {
          self.statusText = '已激活 ' + (status.displayStatus || '')
          self.showRenewButton = false
        } else if (status.isTrial) {
          self.statusText = '免费试用中 ' + (status.displayStatus || '')
          self.showRenewButton = false
        }

        self.statusDetail = status.expireText || ''

        if (status.installTime) {
          self.installTimeText = formatDate(status.installTime)
        }
        if (status.expireAt) {
          self.expireTimeText = formatDate(status.expireAt)
        } else if (status.isPermanent) {
          self.expireTimeText = '永久有效'
        } else {
          self.expireTimeText = ''
        }
      })
    } catch (e) {
      console.warn('[ACTIVATION] loadStatus error: ' + e)
    }
  },

  loadHistory() {
    var self = this
    try {
      authStore.getHistory(function(history) {
        self.historyList = history || []
      })
    } catch (e) {
      console.warn('[ACTIVATION] loadHistory error: ' + e)
    }
  },

  fetchDeviceId() {
    var self = this
    try {
      var device = require("@system.device")
      device.getDeviceId({
        success: function(data) {
          self.deviceId = data.deviceId || '未知'
          self.qrText = ACTIVATION_URL + self.deviceId
        },
        fail: function(data, code) {
          self.deviceId = '获取失败(' + code + ')'
          self.qrText = ACTIVATION_URL + 'unknown'
        }
      })
    } catch (e) {
      self.deviceId = '不可用'
      self.qrText = ACTIVATION_URL + 'demo'
    }
  },

  goBack() {
    router.back()
  },

  goToRenew() {
    router.push({ uri: "/pages/activation" })
  },

  increaseDigit(index) {
    var charset = (index >= 4 && index <= 7) ? DIGITS : CHARSET
    var current = this['d' + index]
    var pos = charset.indexOf(current)
    if (pos < 0) pos = 0
    if (pos < charset.length - 1) {
      pos++
    } else {
      pos = 0
    }
    this['d' + index] = charset[pos]
  },

  decreaseDigit(index) {
    var charset = (index >= 4 && index <= 7) ? DIGITS : CHARSET
    var current = this['d' + index]
    var pos = charset.indexOf(current)
    if (pos < 0) pos = 0
    if (pos > 0) {
      pos--
    } else {
      pos = charset.length - 1
    }
    this['d' + index] = charset[pos]
  },

  doVerify() {
    var code = ''
    for (var i = 0; i < 12; i++) {
      code += this['d' + i] || '0'
    }

    var deviceId = this.deviceId

    if (!deviceId || deviceId.indexOf('获取失败') >= 0 || deviceId.indexOf('未知') >= 0 || deviceId.indexOf('不可用') >= 0) {
      this.verifySuccess = false
      this.verifyResult = '无法获取设备ID'
      this.verifyDetail = ''
      return
    }

    var self = this

    authStore.verifyMasterCode(code, deviceId, function(masterResult) {
      if (masterResult.success) {
        self.verifySuccess = true
        self.verifyResult = '万能码验证通过 - ' + masterResult.duration + ' 天'
        self.verifyDetail = '剩余可用次数: ' + masterResult.remainingUses

        authStore.markActivated(masterResult.duration, function(success) {
          if (success) {
            prompt.showToast({ message: masterResult.message || '激活成功' })
            self.loadStatus()
            self.loadHistory()
          }
        })
        return
      }

      if (masterResult.blockReason === 'not_expired') {
        self.verifySuccess = false
        self.verifyResult = masterResult.reason
        self.verifyDetail = '您的授权仍在有效期内，无需使用万能码'
        return
      }

      if (masterResult.blockReason === 'limit_reached') {
        self.verifySuccess = false
        self.verifyResult = masterResult.reason
        self.verifyDetail = ''
        return
      }

      var codeChecksum = code.substring(8, 12)
      var result = verifyActivation(code, deviceId)
      if (result.success) {
        self.verifySuccess = true
        var myHash = deviceIdToHash(deviceId)
        self.verifyDetail = '设备ID哈希: ' + myHash + ' | 天数: ' + (result.isPermanent ? '永久' : result.days + '天') + ' | 校验码: ' + codeChecksum
        if (result.isPermanent) {
          self.verifyResult = '验证通过 - 永久激活'
        } else {
          self.verifyResult = '验证通过 - ' + result.days + ' 天'
        }

        authStore.markActivated(result.isPermanent ? -1 : result.days, function(success) {
          if (success) {
            prompt.showToast({ message: '激活成功' })
            self.loadStatus()
            self.loadHistory()
          }
        })
      } else {
        self.verifySuccess = false
        self.verifyResult = result.reason || '验证失败'
        self.verifyDetail = ''
      }
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  height: 100%;
}

.page-scroll {
  flex: 1;
  flex-direction: column;
  padding: 0 8px 0 8px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  padding: 44px 8px 4px 8px;
}

.back-btn {
  width: 70px;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  margin-left: 8px;
}

.status-card {
  flex-direction: column;
  border-radius: 12px;
  padding: 14px 12px;
  margin-bottom: 8px;
}

.status-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.status-icon {
  font-size: 22px;
  margin-right: 8px;
}

.status-text {
  font-size: 18px;
  font-weight: bold;
}

.status-details {
  flex-direction: column;
  padding-left: 30px;
  margin-bottom: 6px;
}

.status-detail-line {
  font-size: 13px;
  margin-bottom: 2px;
}

.status-actions {
  flex-direction: row;
  padding-left: 30px;
}

.renew-btn {
  width: 80px;
  height: 32px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
}

.section-title {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 6px;
  padding-left: 4px;
}

.history-list {
  flex-direction: column;
  border-radius: 12px;
  padding: 8px 12px;
  margin-bottom: 8px;
}

.history-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
