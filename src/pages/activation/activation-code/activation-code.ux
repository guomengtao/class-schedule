<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="page-scroll" scroll-y="{{true}}">
      <div class="header">
        <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
          <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        </div>
        <!-- 标题 3 字 @28px：公共 header.css 的 18px 低于 ev-six 24px 下限，本页覆盖 -->
        <text class="header-title" onclick="goBack" style="font-size: {{ verifySuccess ? '24px' : '28px' }}; color: {{ verifySuccess ? theme.accent : theme.text }}">{{ verifySuccess ? '激活成功' : '激活码' }}</text>
        <div class="header-placeholder"></div>
      </div>

      <!-- 5 字上限：ev-six 规定 @24px 单行最多 5 个全角字（5×24×1.33≈160px / 容器 172px）。
           原「18位 · 从网页获取，不是4位兑换码」18 字必须压到 5 字，防误输靠下方 3×6 共 18 格
           与状态条「共需18位」双保险，不靠这行长文案。
           已激活后这行改为状态回显（否则激活成功的人还被教「去网页换 18 位」）。
           成功态整行退场，把版面让给 done-box。 -->
      <text class="source-hint" style="display: {{ verifySuccess ? 'none' : 'block' }}; color: {{ sourceHintColor }}">{{ sourceHint }}</text>

      <!-- 18 位码：3 行 × 6 位，正好一行 6 个位置（ev-six） -->
      <div class="cells-grid" style="display: {{ verifySuccess ? 'none' : 'flex' }}">
        <div class="cells-row">
          <div class="cell {{ cursor === 0 ? 'cell-active' : '' }}" onclick="onCellClick(0)" style="background-color: {{ cursor === 0 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 0 ? theme.bg : theme.text }}">{{ cell0 !== null ? cell0 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 1 ? 'cell-active' : '' }}" onclick="onCellClick(1)" style="background-color: {{ cursor === 1 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 1 ? theme.bg : theme.text }}">{{ cell1 !== null ? cell1 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 2 ? 'cell-active' : '' }}" onclick="onCellClick(2)" style="background-color: {{ cursor === 2 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 2 ? theme.bg : theme.text }}">{{ cell2 !== null ? cell2 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 3 ? 'cell-active' : '' }}" onclick="onCellClick(3)" style="background-color: {{ cursor === 3 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 3 ? theme.bg : theme.text }}">{{ cell3 !== null ? cell3 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 4 ? 'cell-active' : '' }}" onclick="onCellClick(4)" style="background-color: {{ cursor === 4 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 4 ? theme.bg : theme.text }}">{{ cell4 !== null ? cell4 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 5 ? 'cell-active' : '' }}" onclick="onCellClick(5)" style="background-color: {{ cursor === 5 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 5 ? theme.bg : theme.text }}">{{ cell5 !== null ? cell5 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 6 ? 'cell-active' : '' }}" onclick="onCellClick(6)" style="background-color: {{ cursor === 6 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 6 ? theme.bg : theme.text }}">{{ cell6 !== null ? cell6 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 7 ? 'cell-active' : '' }}" onclick="onCellClick(7)" style="background-color: {{ cursor === 7 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 7 ? theme.bg : theme.text }}">{{ cell7 !== null ? cell7 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 8 ? 'cell-active' : '' }}" onclick="onCellClick(8)" style="background-color: {{ cursor === 8 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 8 ? theme.bg : theme.text }}">{{ cell8 !== null ? cell8 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 9 ? 'cell-active' : '' }}" onclick="onCellClick(9)" style="background-color: {{ cursor === 9 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 9 ? theme.bg : theme.text }}">{{ cell9 !== null ? cell9 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 10 ? 'cell-active' : '' }}" onclick="onCellClick(10)" style="background-color: {{ cursor === 10 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 10 ? theme.bg : theme.text }}">{{ cell10 !== null ? cell10 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 11 ? 'cell-active' : '' }}" onclick="onCellClick(11)" style="background-color: {{ cursor === 11 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 11 ? theme.bg : theme.text }}">{{ cell11 !== null ? cell11 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 12 ? 'cell-active' : '' }}" onclick="onCellClick(12)" style="background-color: {{ cursor === 12 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 12 ? theme.bg : theme.text }}">{{ cell12 !== null ? cell12 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 13 ? 'cell-active' : '' }}" onclick="onCellClick(13)" style="background-color: {{ cursor === 13 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 13 ? theme.bg : theme.text }}">{{ cell13 !== null ? cell13 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 14 ? 'cell-active' : '' }}" onclick="onCellClick(14)" style="background-color: {{ cursor === 14 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 14 ? theme.bg : theme.text }}">{{ cell14 !== null ? cell14 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 15 ? 'cell-active' : '' }}" onclick="onCellClick(15)" style="background-color: {{ cursor === 15 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 15 ? theme.bg : theme.text }}">{{ cell15 !== null ? cell15 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 16 ? 'cell-active' : '' }}" onclick="onCellClick(16)" style="background-color: {{ cursor === 16 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 16 ? theme.bg : theme.text }}">{{ cell16 !== null ? cell16 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 17 ? 'cell-active' : '' }}" onclick="onCellClick(17)" style="background-color: {{ cursor === 17 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 17 ? theme.bg : theme.text }}">{{ cell17 !== null ? cell17 : '-' }}</text>
          </div>
        </div>
      </div>

      <!-- 内联状态条：唯一的提示通道，固定高度，永不覆盖输入 -->
      <div class="status-strip" style="background-color: {{ theme.card }}; display: {{ verifySuccess ? 'none' : 'flex' }}">
        <text class="status-text" style="color: {{ hintColor }}">{{ hintText }}</text>
      </div>

      <div class="keypad" style="display: {{ verifySuccess ? 'none' : 'flex' }}">
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(1)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">1</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(2)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">2</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(3)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">3</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(4)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">4</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(5)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">5</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(6)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">6</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(7)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">7</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(8)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">8</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(9)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">9</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onClear" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: #e74c3c">C</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(0)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">0</text>
          </div>
          <div class="keypad-btn" onclick="onDelete" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: #e74c3c">←</text>
          </div>
        </div>
      </div>

      <div class="verify-btn" onclick="doVerify" style="background-color: {{ theme.accent }}; display: {{ verifySuccess ? 'none' : 'flex' }}">
        <text class="verify-btn-text" style="color: {{ theme.bg }}">验证</text>
      </div>

      <!-- 成功态：一屏讲完「结果 → 得到了什么 → 下一步」。
           ev-six 字数已逐行核（168px 页面级 / 152px 卡片内）：
             恭喜 2字@44=117px、高级版已开通 5字@24=160px、
             权益每行 4字@24=128px（卡片内）、开始体验 4字@28=149px、上课不迟到 5字@24=160px。
           全部单行不折、无分隔符、无箭头、无徽标；可点性靠底色表达。 -->
      <div class="done-box" style="display: {{ verifySuccess ? 'flex' : 'none' }}">
        <text class="done-title" style="color: {{ theme.accent }}">恭喜</text>
        <text class="done-sub" style="color: {{ theme.text }}">高级版到手</text>

        <div class="perk-card" style="background-color: {{ theme.card }}">
          <text class="perk-row" style="color: {{ theme.text }}">数据备份</text>
          <text class="perk-row" style="color: {{ theme.text }}">10套主题</text>
          <text class="perk-row" style="color: {{ theme.text }}">多套课表</text>
        </div>

        <div class="done-btn" onclick="startExperience" style="background-color: {{ theme.accent }}">
          <text class="done-btn-text" style="color: {{ theme.bg }}">开始体验</text>
        </div>
        <text class="done-tip" style="color: {{ theme.textSecondary }}">上课不迟到</text>
      </div>

      <div class="bottom-spacer"></div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
import vibrator from "@system.vibrator"
const store = require("../../../data/store.js")
const authStore = require("../../../data/auth-store.js")
const version = require("../../../data/version.js")
const crypto = require("../../../lib/crypto.js")

var ACTIVATION_URL = "https://app-auth.gudq.com/activate.html?deviceId="
var AFDIAN_REDIRECT_URL = "https://app-auth.gudq.com/go/ev-timetable?deviceId="

function doVibrate() {
  try {
    vibrator.vibrate({ mode: "short" })
  } catch (e) {}
}

function formatDate(ts) {
  if (!ts) return ''
  var d = new Date(ts)
  var y = d.getFullYear()
  var m = String(d.getMonth() + 1)
  if (m.length < 2) m = '0' + m
  var day = String(d.getDate())
  if (day.length < 2) day = '0' + day
  return y + '-' + m + '-' + day
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    statusText: '加载中...',
    statusColor: '#888899',
    statusDetail: '',
    historyList: [],
    installTimeText: '',
    expireTimeText: '',
    afdianUrl: '',
    apkQrText: '',
    deviceId: '',
    deviceIdDisplay: '获取中...',
    qrText: '',
    cell0: null, cell1: null, cell2: null, cell3: null,
    cell4: null, cell5: null, cell6: null, cell7: null,
    cell8: null, cell9: null, cell10: null, cell11: null,
    cell12: null, cell13: null, cell14: null, cell15: null,
    cell16: null, cell17: null,
    cursor: 0,
    // 顶部来源提示：未激活=防误输引导，已激活=当前状态回显（激活成功的人不该再被教怎么输码）
    sourceHint: '18位激活码',
    sourceHintColor: '#555566',
    isActivatedNow: false,
    // 内联状态条：唯一的提示通道（原 prompt.showToast 会浮在输入格之上）
    hintText: '共需18位',
    hintColor: '#888899',
    verifySuccess: false,
    doneSub: '',
    versionText: '',
    deviceInfoParams: '',
    channelParam: version.channel || ''
  },

  onInit() {
    var self = this

    // 「直达成功屏」调试通道（不是隐藏入口，是显式参数）：
    //   router.push({ uri: 'pages/activation/activation-code', params: { mock: 'success' } })
    //   router.push({ uri: 'pages/activation/activation-code', params: { mock: 'success', sub: '剩余30天' } })
    // 命中后不取设备号、不读本地激活态、不轮询，直接把成功态铺上去——只为验收 UI。
    // 正常用户路径永远不带 mock 参数，走下面的真实逻辑。
    var params = {}
    try { params = router.getParams() || {} } catch (e) { params = {} }
    if (params && params.mock === 'success') {
      this._mockShot = true
      this.verifySuccess = true
      this.doneSub = params.sub || '永久有效'
      this.sourceHint = '已激活'
      this.sourceHintColor = '#7ec8e3'
      this.statusText = '高级版'
      this.statusColor = 'green'
      this.statusDetail = params.sub || '永久有效'
      this.hintText = '已激活'
      this.isActivatedNow = true
      this._actSeen = true
      this.versionText = version.versionName
      store.getTheme(function(t, themeName) {
        self.theme = t
        self.sourceHintColor = t.accent
        self.updateIconSrc(themeName)
      })
      return
    }

    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.versionText = version.versionName
    self.fetchDeviceId()
    self.loadStatus()
    self.loadHistory()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
      // 激活状态可能在别的入口被改掉（APK 一键激活 / 手环别处激活），回来必须重算一次，
      // 否则激活成功的人看到的还是「18位 · 从网页获取」这套输入引导。
      self.loadStatus()
    })
    self.startActivationWatch()
  },

  onHide() {
    this.stopActivationWatch()
  },

  onDestroy() {
    this.stopActivationWatch()
  },

  // 一键激活是「手机操作、手环生效」，手环这边页面不会收到任何通知。
  // 本页只要还开着，就轮询本地激活状态：一旦从「未激活」跳到「已激活」，
  // 立刻切成功态并震动——用户抬头看手环就能看到结果，而不是继续对着输入引导发呆。
  startActivationWatch() {
    var self = this
    this.stopActivationWatch()
    // mock 直达态不轮询：没有真实激活过程，轮询只会白耗电
    if (this._mockShot) return
    this._actTimer = setInterval(function () {
      if (self.verifySuccess) {
        self.stopActivationWatch()
        return
      }
      authStore.getFullStatus(function (st) {
        if (!st || !st.isActivated) return
        // 进页面时就已经是激活状态 → 不动，保留「输新码续期」的入口
        if (self._actSeen === true) return
        self._actSeen = true
        self.stopActivationWatch()
        var sub = st.isPermanent
          ? '永久有效'
          : (st.expireAt ? ('有效期至 ' + formatDate(st.expireAt)) : '')
        self.succeed(sub)
        doVibrate()
        self.loadStatus()
      })
    }, 1500)
  },

  stopActivationWatch() {
    if (this._actTimer) {
      clearInterval(this._actTimer)
      this._actTimer = null
    }
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  loadStatus() {
    var self = this
    try {
      authStore.getFullStatus(function(status) {
        self.statusText = status.displayStatus || status.text
        self.statusColor = status.color

        if (status.isPermanent) {
          self.statusText = '高级版'
          self.statusColor = 'green'
        } else if (status.isActivated && status.isExpired) {
          self.statusText = '高级版'
          self.statusColor = 'red'
        } else if (status.isActivated && status.isExpiring) {
          self.statusText = '高级版'
          self.statusColor = '#e67e22'
        } else if (status.isActivated) {
          self.statusText = '高级版'
          self.statusColor = 'green'
        } else {
          self.statusText = '标准版'
          self.statusColor = 'gray'
        }

        self.statusDetail = status.expireText || ''

        // 顶部提示随激活状态切换：已激活回显状态，不再教用户「去网页换 18 位」。
        // 这条曾经是实机反馈的缺陷——APK 一键激活成功后回到本页，看到的仍是输入引导。
        var activated = !!status.isActivated
        self.isActivatedNow = activated
        // 首次读到的状态就是「基线」：进来已激活的人不会被轮询强行切进成功态
        if (self._actSeen === undefined) self._actSeen = activated
        var muted = (self.theme && self.theme.textMuted) || '#555566'
        var accent = (self.theme && self.theme.accent) || '#7ec8e3'
        if (activated) {
          // 顶部只留 3 字主状态（@24px 合规），期限交给下方状态条。
          // 原来的「已激活 · 有效期至 2026-12-05」@24px 需 440px，会折成 3 行。
          self.sourceHint = '已激活'
          self.sourceHintColor = accent
          // status.expireText 是「剩余 30 天 / 永久有效 / 已过期 7 天」这类短语，
          // 本身就是 ev-six 合规长度（≤5 字档），信息不丢且不折行。
          var statusHint = status.expireText || '已激活'
          // 只在「空闲态」改写状态条：用户已经输了几位时（hintText 变成「已输 N 位」）
          // 或可验证时都不要覆盖，否则会打断输入反馈。
          if (!self.verifySuccess && (self.hintText === '共需18位' || self.hintText === self._expireHint)) {
            self.hintText = statusHint
            self.hintColor = (self.theme && self.theme.textSecondary) || '#888899'
            self._expireHint = statusHint
          }
        } else {
          self.sourceHint = '18位激活码'
          self.sourceHintColor = muted
          if (!self.verifySuccess && self.hintText === self._expireHint) {
            self.hintText = '共需18位'
            self.hintColor = (self.theme && self.theme.textSecondary) || '#888899'
            self._expireHint = ''
          }
        }

        if (status.installTime) {
          self.installTimeText = formatDate(status.installTime)
        }
        if (status.isPermanent) {
          self.expireTimeText = '永久有效'
        } else if (status.expireAt) {
          self.expireTimeText = formatDate(status.expireAt)
        } else {
          self.expireTimeText = ''
        }
      })
    } catch (e) {
      dlog('[ACTIVATION] loadStatus error: ' + e)
    }
  },

  loadHistory() {
    var self = this
    try {
      authStore.getHistory(function(history) {
        self.historyList = history || []
      })
    } catch (e) {
      dlog('[ACTIVATION] loadHistory error: ' + e)
    }
  },

  fetchDeviceId() {
    var self = this
    try {
      var device = require("@system.device")
      device.getDeviceId({
        success: function(data) {
          var raw = data.deviceId || ''
          if (!raw || raw === 'NA' || raw === 'unknown' || raw === 'null') {
            self._fallbackToLocalUUID()
          } else {
            self.deviceId = raw
            self.deviceIdDisplay = raw.slice(-6)
            self.updateQrText()
            self.fetchDeviceInfo()
          }
        },
        fail: function() {
          self._fallbackToLocalUUID()
        }
      })
    } catch (e) {
      self._fallbackToLocalUUID()
    }
  },

  _fallbackToLocalUUID() {
    var self = this
    var deviceUuid = require("../../../utils/device-uuid.js")
    deviceUuid.getLocalDeviceId(function(id) {
      self.deviceId = id
      self.deviceIdDisplay = id.slice(-6)
      self.updateQrText()
      self.fetchDeviceInfo()
    })
  },

  fetchDeviceInfo() {
    var self = this
    try {
      var device = require("@system.device")
      device.getInfo({
        success: function(ret) {
          var params = []
          if (ret.model) params.push('m=' + encodeURIComponent(ret.model))
          if (ret.product) params.push('p=' + encodeURIComponent(ret.product))
          if (ret.osVersionCode != null) params.push('o=' + ret.osVersionCode)
          if (ret.platformVersionCode != null) params.push('v=' + ret.platformVersionCode)
          if (ret.deviceType) params.push('t=' + encodeURIComponent(ret.deviceType))
          if (ret.screenShape) params.push('s=' + encodeURIComponent(ret.screenShape))
          if (ret.screenWidth != null) params.push('w=' + ret.screenWidth)
          if (ret.screenHeight != null) params.push('h=' + ret.screenHeight)
          if (ret.APILevel != null) params.push('a=' + ret.APILevel)
          if (ret.language) params.push('l=' + encodeURIComponent(ret.language))
          self.deviceInfoParams = params.join('&')
          self.updateQrText()
        },
        fail: function() {
          self.deviceInfoParams = ''
          self.updateQrText()
        }
      })
    } catch (e) {
      self.deviceInfoParams = ''
      self.updateQrText()
    }
  },

  updateQrText() {
    var self = this
    if (self.deviceId && self.deviceId !== '获取中...') {
      var qr = ACTIVATION_URL + encodeURIComponent(self.deviceId)
      if (self.deviceInfoParams) {
        qr = qr + '&' + self.deviceInfoParams
      }
      if (self.versionText) {
        qr = qr + '&r=' + encodeURIComponent(self.versionText)
      }
      if (self.channelParam) {
        qr = qr + '&c=' + encodeURIComponent(self.channelParam)
      }
      if (qr.length > 200 && self.channelParam) {
        qr = ACTIVATION_URL + encodeURIComponent(self.deviceId) + '&c=' + encodeURIComponent(self.channelParam)
        if (self.versionText) {
          var tmp = qr + '&r=' + encodeURIComponent(self.versionText)
          if (tmp.length <= 200) qr = tmp
        }
      }
      self.qrText = qr

      var afd = AFDIAN_REDIRECT_URL + encodeURIComponent(self.deviceId)
      if (self.deviceInfoParams) {
        afd = afd + '&' + self.deviceInfoParams
      }
      if (self.versionText) {
        afd = afd + '&r=' + encodeURIComponent(self.versionText)
      }
      if (self.channelParam) {
        afd = afd + '&c=' + encodeURIComponent(self.channelParam)
      }
      self.afdianUrl = afd

      // 步骤2「快速激活」：安卓同步器下载页（带 deviceId/版本/渠道追踪，服务端漏斗可见）
      var APK_DL_URL = 'https://app-auth.gudq.com/apk-download.html?deviceId='
      var apk = APK_DL_URL + encodeURIComponent(self.deviceId)
      if (self.versionText) {
        apk = apk + '&r=' + encodeURIComponent(self.versionText)
      }
      if (self.channelParam) {
        apk = apk + '&c=' + encodeURIComponent(self.channelParam)
      } else {
        apk = apk + '&c=band-premium'
      }
      self.apkQrText = apk
    }
  },

  goBack() {
    router.back()
  },

  // ---------- 提示：只有一条通道，就是输入格下方的内联状态条 ----------
  filledCount() {
    var n = 0
    for (var i = 0; i < 18; i++) {
      var v = this['cell' + i]
      if (v !== null && v !== undefined) n++
    }
    return n
  },

  // 正常态提示：告诉用户还差多少、什么时候可以验证
  refreshHint() {
    var n = this.filledCount()
    if (n >= 18) {
      this.hintText = '可以验证了'
      this.hintColor = this.theme.accent
    } else if (n === 0) {
      this.hintText = '共需18位'
      this.hintColor = this.theme.textSecondary
    } else {
      this.hintText = '已输' + n + '位'
      this.hintColor = this.theme.textSecondary
    }
  },

  // 失败态：文字换成红色短句 + 长震动。不弹 toast，不隐藏键盘，不打断输入
  showError(text) {
    this.hintText = text
    this.hintColor = '#e74c3c'
    try {
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {}
  },

  succeed(sub) {
    this.verifySuccess = true
    this.doneSub = sub || ''
  },

  // 成功态「开始体验」：直接回课程表首页。
  // 不用 goBack——上一页是兑换/购买路径，用户激活完没必要再看到。
  startExperience() {
    this.stopActivationWatch()
    try {
      router.replace({ uri: 'pages/index' })
    } catch (e) {
      router.push({ uri: 'pages/index' })
    }
  },

  onCellClick(index) {
    doVibrate()
    this.cursor = index
  },

  onKeyPress(digit) {
    doVibrate()
    var idx = this.cursor
    this['cell' + idx] = digit
    if (this.cursor < 17) {
      this.cursor = this.cursor + 1
    }
    this.refreshHint()
  },

  // 删除键：一次只删一位。
  // 光标指向空格时，先左移一格找到「最后一位有效输入」，删掉后光标**停在被删的那一格**。
  // 旧实现删完又退一格，相当于一次跨两格，实机手感就是「按一下删两位」。
  onDelete() {
    doVibrate()
    var idx = this.cursor
    if (this['cell' + idx] === null || this['cell' + idx] === undefined) {
      if (idx === 0) {
        this.refreshHint()
        return
      }
      idx = idx - 1
    }
    this['cell' + idx] = null
    this.cursor = idx
    this.refreshHint()
  },

  onClear() {
    doVibrate()
    for (var i = 0; i < 18; i++) {
      this['cell' + i] = null
    }
    this.cursor = 0
    this.refreshHint()
  },

  doVerify() {
    var code = ''
    for (var i = 0; i < 18; i++) {
      var val = this['cell' + i]
      if (val === null || val === undefined) {
        // 不再报「请输入完整的18位激活码」（11 字，两行且浮层遮挡），只报还差几位
        this.showError('还差' + (18 - this.filledCount()) + '位')
        return
      }
      code += val
    }

    var deviceId = this.deviceId

    if (!deviceId || deviceId.indexOf('获取失败') >= 0 || deviceId.indexOf('未知') >= 0 || deviceId.indexOf('不可用') >= 0) {
      this.showError('未取到设备号')
      return
    }

    var self = this

    authStore.verifyMasterCode(code, deviceId, function(masterResult) {
      if (masterResult.success) {
        authStore.markActivated(masterResult.duration, code, '', function(success) {
          if (success) {
            var d = masterResult.duration
            self.succeed(d > 0 ? ('有效期' + d + '天') : '永久有效')
            self.loadStatus()
            self.loadHistory()
          } else {
            self.showError('保存失败')
          }
        })
        return
      }

      if (masterResult.blockReason === 'not_expired') {
        self.showError('有效期未过')
        return
      }

      if (masterResult.blockReason === 'limit_reached') {
        self.showError('次数已用完')
        return
      }

      var decrypted = crypto.decryptActivationCode(code)
      if (!decrypted || !decrypted.valid) {
        self.showError('激活码无效')
        return
      }

      var deviceIdLast4 = deviceId.substring(deviceId.length - 4)
      // 大小写不敏感比较：DEVICE_CHARSET 把 A-Z 与 a-z 当作两组不同字符，
      // 而设备端 UUID 只生成小写（utils/device-uuid.js: chars='0123456789abcdef'），
      // 生成端若做过大写归一，同一台设备就会被判成他人设备。与 app.ux:521 口径对齐。
      if (String(decrypted.deviceId).toUpperCase() !== String(deviceIdLast4).toUpperCase()) {
        dlog('[ACTIVATION] device mismatch: code=' + decrypted.deviceId + ' local=' + deviceIdLast4)
        self.showError('设备不匹配')
        return
      }

      authStore.loadUsedRedeemCodes(function(usedRedeemList) {
        if (usedRedeemList.indexOf(decrypted.redeemCode) !== -1) {
          self.showError('兑换码已用')
          return
        }

        var months = parseInt(decrypted.months, 10)

        var isPermanent = months === 99
        var days = isPermanent ? -1 : months * 30

        authStore.markActivated(days, code, decrypted.redeemCode, function(success) {
          if (success) {
            authStore.saveUsedCode(code)
            authStore.saveUsedRedeemCode(decrypted.redeemCode)
            self.succeed(isPermanent ? '永久有效' : ('有效期' + months + '个月'))
            self.loadStatus()
            self.loadHistory()
          } else {
            self.showError('保存失败')
          }
        })
      })
    })
  }
}
</script>

<style>
@import '../../../common/header.css';

.page {
  flex-direction: column;
  padding: 38px 10px 8px 10px;
  width: 100%;
  height: 100%;
}

/* 滚动容器：与 activation 页同款定义（抽取时漏掉会导致正文不渲染） */
.page-scroll {
  flex: 1;
  flex-direction: column;
}

/* 标题 24px：与公共 header.css 手环档一致（ev-six 下限档，4 字 @24 = 96px） */
.header-title {
  font-size: 28px;
  line-height: 36px;
}

/* 18 位提示：内容宽 172px，13 字须 ≤13px/字 → 18px 一行放不下（13×18=234），
   实测用 2 行布局：字号 20px、允许换行，高度预算 +56px 仍 <490 */
/* 24px：ev-six 手环档下限，5 字 @24 = 162.8px / 容器 172px 单行不折 */
.source-hint {
  font-size: 24px;
  line-height: 34px;
  margin: 2px 0 4px 0;
  width: 100%;
  text-align: center;
}

/* 输入格：每行 6 个（与 ev-six 六位置对齐），高 32 保持竖向呼吸 */
.cells-grid {
  width: 100%;
  flex-direction: column;
  margin-bottom: 8px;
}

.cells-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 4px;
}

.cell {
  flex: 1;
  height: 32px;
  border-radius: 6px;
  border-width: 1px;
  border-style: solid;
  margin: 0 2px;
  justify-content: center;
  align-items: center;
}

.cell-active {
  border-width: 2px;
}

.cell-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 30px;
}

/* 状态条：占位固定 28px，报错只换颜色不换高度，因此永不挤压、永不遮挡 */
.status-strip {
  width: 100%;
  height: 28px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
}

.status-text {
  font-size: 24px;
  line-height: 28px;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

/* 键盘：flex:1 三等分，与上方 6 格同宽，不再靠 12px 外边距挤成一小团 */
.keypad {
  width: 100%;
  flex-direction: column;
  margin-bottom: 8px;
}

.keypad-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 3px;
}

.keypad-btn {
  flex: 1;
  height: 40px;
  border-radius: 8px;
  border-width: 1px;
  border-style: solid;
  margin: 0 2px;
  justify-content: center;
  align-items: center;
}

.keypad-text {
  font-size: 28px;
  font-weight: bold;
}

.verify-btn {
  width: 100%;
  height: 44px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  align-self: center;
}

.verify-btn-text {
  font-size: 30px;
  font-weight: bold;
  text-align: center;
}

/* 成功态 */
.done-box {
  width: 100%;
  flex-direction: column;
  align-items: center;
  margin-top: 4px;
}

/* 状态大字：ev-six 44px / 行高 60（不是 56） */
.done-title {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  text-align: center;
}

.done-sub {
  font-size: 24px;
  line-height: 34px;
  margin-top: 6px;
  text-align: center;
}

/* 权益卡：上下 11px 内边距是免费的，左右 8px 会占位置（ev-six §3.1） */
.perk-card {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 11px 8px;
  border-radius: 14px;
  margin-top: 8px;
}

.perk-row {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
}

.done-btn {
  width: 100%;
  height: 52px;
  border-radius: 14px;
  margin-top: 8px;
  justify-content: center;
  align-items: center;
}

.done-btn-text {
  font-size: 28px;
  font-weight: bold;
}

.done-tip {
  font-size: 24px;
  line-height: 34px;
  margin-top: 2px;
  text-align: center;
}

.bottom-spacer {
  height: 0;
}
</style>
