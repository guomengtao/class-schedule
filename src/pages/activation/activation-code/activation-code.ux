  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

/* 键盘：flex:1 三等分，与上方 6 格同宽，不再靠 12px 外边距挤成一小团 */
.keypad {
  width: 100%;
  flex-direction: column;
  margin-bottom: 8px;
}

.keypad-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 3px;
}

.keypad-btn {
  flex: 1;
  height: 40px;
  border-radius: 8px;
  border-width: 1px;
  border-style: solid;
  margin: 0 2px;
  justify-content: center;
  align-items: center;
}

.keypad-text {
  font-size: 28px;
  font-weight: bold;
}

.verify-btn {
  width: 100%;
  height: 44px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  align-self: center;
}

.verify-btn-text {
  font-size: 30px;
  font-weight: bold;
  text-align: center;
}

/* 成功态 */
.done-box {
  width: 100%;
  flex-direction: column;
  align-items: center;
  margin-top: 100px;
}

.done-title {
  font-size: 44px;
  line-height: 56px;
  font-weight: bold;
  text-align: center;
}

.done-sub {
  font-size: 24px;
  line-height: 34px;
  margin-top: 6px;
  text-align: center;
}

.done-btn {
  width: 100%;
  height: 46px;
  border-radius: 12px;
  margin-top: 20px;
  justify-content: center;
  align-items: center;
}

.done-btn-text {
  font-size: 28px;
