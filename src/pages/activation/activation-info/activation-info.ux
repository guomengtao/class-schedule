<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 返回键固定：放 scroll 外，长历史滚动时不被带走 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" onclick="goBack" style="color: {{ theme.text }}">信息</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="page-scroll" scroll-y="{{true}}">
      <div class="info-list">
        <div class="info-row">
          <text class="info-label" style="color: {{ theme.textSecondary }}">设备</text>
          <text class="info-value" style="color: {{ theme.accent }}">{{ deviceIdDisplay }}</text>
        </div>
        <div class="info-row">
          <text class="info-label" style="color: {{ theme.textSecondary }}">安装</text>
          <text class="info-value" style="color: {{ theme.text }}">{{ installText }}</text>
        </div>
        <div class="info-row" if="{{ expireText }}">
          <text class="info-label" style="color: {{ theme.textSecondary }}">到期</text>
          <text class="info-value" style="color: {{ theme.text }}">{{ expireText }}</text>
        </div>
      </div>

      <text class="section-title" style="color: {{ theme.text }}">激活历史</text>

      <div class="history-list">
        <div for="{{ historyList }}" class="history-item">
          <text class="history-date" style="color: {{ theme.textSecondary }}">{{ $item.dateShort }}</text>
          <text class="history-meta" style="color: {{ theme.text }}">{{ $item.metaLine }}</text>
        </div>
        <div class="history-empty" if="{{ historyList.length === 0 }}">
          <text class="history-empty-text" style="color: {{ theme.textSecondary }}">还没有记录</text>
        </div>
      </div>

      <text class="version-text" style="color: {{ theme.textSecondary }}">v{{ versionText }}</text>
      <div class="bottom-spacer"></div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../../data/store.js")
const authStore = require("../../../data/auth-store.js")
const version = require("../../../data/version.js")

var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}

var DAY_MS = 86400000

/* 安装日期：年内 M月D日；跨年 YY年M月（省掉日，否则 24px 下超 7 位置） */
function formatInstall(ts) {
  if (!ts) return ''
  var d = new Date(ts)
  var y = d.getFullYear()
  var m = d.getMonth() + 1
  var day = d.getDate()
  if (y === new Date().getFullYear()) return m + '月' + day + '日'
  return (y % 100) + '年' + m + '月'
}

/* 到期：用相对天数，绝对日期在 24px 下放不下（26年12月1日 = 6.75 位置 + 标签 2 位置） */
function formatExpire(ts, isPermanent) {
  if (isPermanent) return '永久有效'
  if (!ts) return '未激活'
  var days = Math.ceil((ts - Date.now()) / DAY_MS)
  if (days < 0) return '已过期' + (-days) + '天'
  if (days === 0) return '今天到期'
  return '还有' + days + '天'
}

/* 历史日期：优先 timestamp；老数据只有 date 字符串 "2026-10-23 14:32" */
function formatHistoryDate(item) {
  if (item && item.timestamp) {
    var d = new Date(item.timestamp)
    return (d.getMonth() + 1) + '月' + d.getDate() + '日'
  }
  var s = item && item.date ? item.date : ''
  if (s.length >= 10) {
    return parseInt(s.slice(5, 7), 10) + '月' + parseInt(s.slice(8, 10), 10) + '日'
  }
  return ''
}

/* 历史副行：激活 30天 —— 码一律不上正文（18 位远超 7 位置） */
function buildMetaLine(item) {
  var type = (item && item.type) ? item.type : '激活'
  var dur = (item && item.duration) ? item.duration : ''
  if (!dur) return type
  return type + ' ' + dur
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    versionText: '',
    historyList: [],
    installText: '',
    expireText: '',
    deviceId: '',
    deviceIdDisplay: '获取中'
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.versionText = version.versionName
    self.fetchDeviceId()
    self.loadStatus()
    self.loadHistory()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    // 从子页返回时历史可能已新增，重读一次
    self.loadStatus()
    self.loadHistory()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goBack() {
    router.back()
  },

  loadStatus() {
    var self = this
    try {
      authStore.getFullStatus(function(status) {
        if (status.installTime) {
          self.installText = formatInstall(status.installTime)
        }
        if (status.isPermanent) {
          self.expireText = '永久有效'
        } else if (status.expireAt) {
          self.expireText = formatExpire(status.expireAt, false)
        } else {
          self.expireText = '未激活'
        }
      })
    } catch (e) {
      dlog('[ACTIVATION-INFO] loadStatus error: ' + e)
    }
  },

  loadHistory() {
    var self = this
    try {
      authStore.getHistory(function(history) {
        var raw = history || []
        var out = []
        for (var i = 0; i < raw.length; i++) {
          out.push({
            dateShort: formatHistoryDate(raw[i]),
            metaLine: buildMetaLine(raw[i])
          })
        }
        self.historyList = out
      })
    } catch (e) {
      dlog('[ACTIVATION-INFO] loadHistory error: ' + e)
    }
  },

  fetchDeviceId() {
    var self = this
    try {
      var device = require("@system.device")
      device.getDeviceId({
        success: function(data) {
          var raw = data.deviceId || ''
          if (!raw || raw === 'NA' || raw === 'unknown' || raw === 'null') {
            self._fallbackToLocalUUID()
          } else {
            self.deviceId = raw
            self.deviceIdDisplay = raw.slice(-6)
          }
        },
        fail: function() {
          self._fallbackToLocalUUID()
        }
      })
    } catch (e) {
      self._fallbackToLocalUUID()
    }
  },

  _fallbackToLocalUUID() {
    var self = this
    var deviceUuid = require("../../../utils/device-uuid.js")
    deviceUuid.getLocalDeviceId(function(id) {
      self.deviceId = id || ''
      self.deviceIdDisplay = id ? id.slice(-6) : '未取到'
    })
  }
}
</script>

<style>
@import '../../../common/header.css';

/* 192px 宽 · 可用宽 = 192 − 12×2 = 168px = 7 位置（1 位置 = 24px）
 * 本页所有行都按 7 位置核算过，不留横向余量之外的 padding */
.page {
  flex-direction: column;
  padding: 44px 12px 12px 12px;
  width: 100%;
  height: 100%;
}

/* 公共 header.css 的 pill 档已是 24px，这里只钉住 base 档不回落 */
.header-title {
  font-size: 28px;
  font-weight: bold;
}

/* 本页滚动容器：缺此定义会导致 scroll 无高度约束、正文整体不渲染 */
.page-scroll {
  flex: 1;
  flex-direction: column;
}

/* ---- 设备段：标签在上 / 值在下 ----
 * 横排不可行：实测汉字渲染宽 ≈ 1.33 × font-size，24px 下「设备」两字就吃 64px，
 * 剩 104px 放不下「10月23日」(≈117px) / 「••44c78」(≈90px 临界)。
 * 竖排后值可独占 168px 全宽，所有字段都不折行、不压缩。 */
.info-list {
  flex-direction: column;
  padding: 2px 0 0 0;
  margin-bottom: 14px;
}

.info-row {
  flex-direction: column;
  align-items: flex-start;
  padding: 4px 0;
}

.info-label {
  font-size: 24px;
  line-height: 30px;
  flex-shrink: 0;
}

.info-value {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
  flex-shrink: 0;
}

/* ---- 历史段 ---- */
.section-title {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  padding-left: 2px;
  margin-bottom: 6px;
}

.history-list {
  width: 100%;
  flex-direction: column;
}

/* 不用 border-bottom：quickapp 里单独写 border-bottom 会被渲染成四边都有框，
 * 观感像给每条记录套了个卡片。分隔靠 8px 纵向间距。 */
.history-item {
  flex-direction: column;
  padding: 6px 0;
}

.history-date {
  font-size: 24px;
  line-height: 34px;
}

.history-meta {
  font-size: 24px;
  line-height: 34px;
  font-weight: bold;
}

.history-empty {
  padding: 10px 0 0 2px;
  align-items: flex-start;
}

.history-empty-text {
  font-size: 24px;
  line-height: 34px;
}

.version-text {
  font-size: 24px;
  line-height: 34px;
  padding: 12px 0 0 2px;
}

.bottom-spacer {
  height: 12px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: pill-shaped) {
  .page {
    padding: 30px 12px 22px 12px;
  }

  .header-title {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: rect) {
  .page {
    padding: 6px 8px 8px 8px;
  }
}
</style>
