<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 标题 2 字 @30：原「购买兑换码」5 字 @24 在 header 132px 里只能压字号 -->
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">购买</text>
    </div>

    <text class="lead" style="color: {{ theme.textSecondary }}">扫码买兑换码</text>

    <div class="qr-box" style="background-color: {{ theme.card }}">
      <div class="qr-wrap" if="{{ qrUrl }}">
        <qrcode class="qr-code" value="{{ qrUrl }}" style="color: #000000; background-color: #ffffff;"></qrcode>
      </div>
      <text class="qr-loading" if="{{ !qrUrl }}" style="color: {{ theme.textMuted }}">正在生成</text>
    </div>

    <text class="hint" style="color: {{ theme.textSecondary }}">付款后回到此页</text>

    <div class="btn" onclick="goBack" style="background-color: {{ theme.accent }}">
      <text class="btn-text" style="color: {{ theme.bg }}">已购买去激活</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const ctx = require("../shared/activation-context.js")

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    qrUrl: ''
  },

  onInit() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    ctx.getIdentity(function(deviceId, infoParams) {
      self.qrUrl = ctx.afdianUrl(deviceId, infoParams)
    })
  },

  onShow() {
    var self = this
    ctx.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
/* ev-six：字号只用 30/28/24；横向 padding 页面 10、卡片 8。
   高度预算：header 48 + 说明 42 + 二维码 196 + 提示 44 + 按钮 58 = 388 / 434 */
.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
}

.header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 40px;
  margin-bottom: 8px;
}

.back-btn-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 20px;
  height: 20px;
}

.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
}

/* 7 字 @24 = 168px，正好满行 */
.lead {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 8px;
}

/* 152 + 白边 16 = 168px；容器禁压缩，否则码体被挤扁扫不出 */
.qr-box {
  width: 100%;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 10px 0;
  border-radius: 12px;
  margin-bottom: 8px;
}

.qr-wrap {
  align-items: center;
  justify-content: center;
  padding: 8px;
  background-color: #ffffff;
  border-radius: 6px;
}

.qr-code {
  width: 152px;
  height: 152px;
  flex-shrink: 0;
}

.qr-loading {
  font-size: 24px;
  line-height: 34px;
  height: 168px;
  text-align: center;
}

.hint {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 10px;
}

.btn {
  width: 100%;
  min-height: 58px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-top: auto;
}

.btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
}

@media (shape: pill-shaped) {
  .page {
    padding: 24px 12px 20px 12px;
  }

  .header {
    height: 38px;
    margin-bottom: 6px;
  }

  .back-btn-wrapper {
    width: 30px;
    height: 30px;
    border-radius: 18px;
  }

  .back-btn-icon {
    width: 18px;
    height: 18px;
  }

  .header-title {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 8px 8px 10px 8px;
  }
}
</style>
