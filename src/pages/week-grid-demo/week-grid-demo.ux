<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <input class="back-btn" type="button" value="back" onclick="goBack"
             style="background-color: {{ theme.card }}; color: {{ theme.accent }}" />
      <text class="title" style="color: {{ theme.text }}">Weekly Schedule</text>
    </div>

    <scroll class="scroll-wrap">
      <div class="grid-wrap">
        <!-- header row: day labels -->
        <div class="grid-row">
          <text class="cell cell-time cell-header" style="color: {{ theme.textMuted }}"></text>
          <text class="cell cell-day cell-header" for="day in days" style="color: {{ theme.accent }}; font-weight: bold;">{{day}}</text>
        </div>

        <!-- schedule rows -->
        <div class="grid-row" for="(rowIdx, row) in schedule">
          <text class="cell cell-time" style="color: {{ theme.textMuted }}">{{ rowIdx + 1 }}</text>
          <div class="cell cell-slot" for="(colIdx, cls) in row" style="padding: 2px;">
            <div if="{{cls.name}}" class="class-block" style="background-color: {{ cls.color }};">
              <text class="class-name">{{ cls.name }}</text>
              <text class="class-room" show="{{cls.room}}">{{ cls.room }}</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>

    <div class="legend-bar" style="background-color: {{ theme.card }};">
      <div class="legend-item" for="item in subjects">
        <div class="legend-dot" style="background-color: {{ item.color }};"></div>
        <text class="legend-label" style="color: {{ theme.textSecondary }}">{{ item.name }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var COLORS = {
  math: "#4A90D9",
  eng: "#50B86C",
  chn: "#9B59B6",
  phy: "#E67E22",
  pe: "#E74C3C",
  chem: "#1ABC9C",
  bio: "#F39C12",
  history: "#3498DB"
}

var SUBJECTS = [
  { name: "Math", key: "math", color: COLORS.math },
  { name: "Eng", key: "eng", color: COLORS.eng },
  { name: "Chn", key: "chn", color: COLORS.chn },
  { name: "Phy", key: "phy", color: COLORS.phy },
  { name: "PE", key: "pe", color: COLORS.pe },
  { name: "Chem", key: "chem", color: COLORS.chem }
]

export default {
  private: {
    theme: {},
    days: ["Mon", "Tue", "Wed", "Thu", "Fri"],
    subjects: SUBJECTS,
    schedule: [
      [
        { name: "Math", room: "A101", color: COLORS.math },
        { name: "Eng", room: "B203", color: COLORS.eng },
        {},
        { name: "Chn", room: "C305", color: COLORS.chn },
        { name: "Phy", room: "A201", color: COLORS.phy }
      ],
      [
        { name: "Eng", room: "B203", color: COLORS.eng },
        { name: "Math", room: "A101", color: COLORS.math },
        { name: "Phy", room: "A201", color: COLORS.phy },
        {},
        { name: "Math", room: "A101", color: COLORS.math }
      ],
      [
        {},
        { name: "Chn", room: "C305", color: COLORS.chn },
        { name: "Math", room: "A101", color: COLORS.math },
        { name: "Eng", room: "B203", color: COLORS.eng },
        {}
      ],
      [
        { name: "PE", room: "Gym", color: COLORS.pe },
        {},
        { name: "Eng", room: "B203", color: COLORS.eng },
        { name: "Math", room: "A101", color: COLORS.math },
        { name: "Chn", room: "C305", color: COLORS.chn }
      ],
      [
        { name: "Chem", room: "Lab", color: COLORS.chem },
        { name: "Phy", room: "A201", color: COLORS.phy },
        { name: "Chn", room: "C305", color: COLORS.chn },
        {},
        { name: "PE", room: "Gym", color: COLORS.pe }
      ]
    ]
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  goBack() {
    router.back()
  }
}
</script>

