<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="../../common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">测试区</text>
      <div class="header-placeholder"></div>
      <div class="spacer"></div>
    </div>

    <div class="card" for="{{ items }}" onclick="openPage($item.uri)" style="background-color: {{ theme.card }}">
      <text class="card-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
      <text class="card-arrow" style="color: {{ theme.textMuted }}">›</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var ITEMS = [
  { name: "倒数日", uri: "/pages/countdown-manage" },
  { name: "二维码生成", uri: "/pages/qrcode-generator" },
  { name: "已钉页面", uri: "/pages/pinned-pages" },
  { name: "打赏支持", uri: "/pages/donate" },
  { name: "设备信息", uri: "/pages/device-info" },
  { name: "数据统计", uri: "/pages/statistics" },
  { name: "激活管理", uri: "/pages/activation" }
]

export default {
  private: {
    items: ITEMS,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  openPage(uri) {
    if (uri) {
      router.push({ uri: uri })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

