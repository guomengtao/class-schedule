<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">测试区</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 官方 list / list-item 原生组件平铺列表：左文字 + 右箭头 + 细分隔线 -->
    <list class="list">
      <list-item type="testItem" class="list-item" for="{{ items }}" onclick="openPage($item.uri)"
                 style="border-bottom-color: {{ theme.border }}">
        <text class="item-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        <image class="item-arrow-img" src="/common/icons/{{ iconTheme }}/icon_chevron_right.png"></image>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var ITEMS = [
  { name: "添加课程 V2", uri: "/pages/add-course-v2" },
  { name: "倒数日", uri: "/pages/countdown-manage" },
  { name: "二维码生成", uri: "/pages/qrcode-generator" },
  { name: "已钉页面", uri: "/pages/pinned-pages" },
  { name: "打赏支持", uri: "/pages/donate" },
  { name: "设备信息", uri: "/pages/device-info" },
  { name: "数据统计", uri: "/pages/statistics" },
  { name: "激活管理", uri: "/pages/activation" }
]

export default {
  private: {
    iconTheme: "dark",
    items: ITEMS,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textMuted: "#555566",
      border: "#0f3460"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  openPage(uri) {
    if (uri) {
      router.push({ uri: uri })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';

.page-root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 8px;
}

.back-btn-text {
  font-size: 28px;
  line-height: 36px;
  text-align: center;
}

/* 官方列表：整列表占满剩余高度，条目平铺、底部分隔线 */
.list {
  flex: 1;
  width: 100%;
}

.list-item {
  height: 56px;
  padding: 0 16px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom-width: 1px;
}

.item-name {
  flex: 1;
  font-size: 24px;
  line-height: 32px;
  lines: 1;
  text-overflow: ellipsis;
}

.item-arrow-img {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  margin-left: 6px;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page-root {
    padding: 8px;
  }
  .list-item {
    height: 56px;
    padding: 0 12px;
  }
  .item-name {
    font-size: 24px;
    line-height: 32px;
  }
  .item-arrow {
    font-size: 24px;
    line-height: 32px;
  }
}

@media (shape: rect) {
  .page-root {
    padding: 12px;
  }
  .list-item {
    height: 64px;
    padding: 0 20px;
  }
  .item-name {
    font-size: 28px;
    line-height: 40px;
  }
  .item-arrow {
    font-size: 28px;
    line-height: 40px;
  }
}

@media (shape: circle) {
  .page-root {
    padding: 8px;
  }
  .list-item {
    height: 56px;
    padding: 0 16px;
  }
  .item-name {
    font-size: 24px;
    line-height: 32px;
  }
  .item-arrow {
    font-size: 24px;
    line-height: 32px;
  }
}
</style>