<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}">◀</text>
      <text class="title" style="color: {{ theme.text }}">测试区</text>
      <text class="version-tag" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}">V2</text>
    </div>

    <scroll class="scroll-area">
      <div class="section" for="{{ sections }}">
        <text class="section-title" style="color: {{ theme.accent }}">{{ $item.label }}</text>

        <div class="card" for="{{ $item.items }}" onclick="openPage($item.uri)" style="background-color: {{ theme.card }}">
          <text class="card-icon">{{ $item.icon }}</text>
          <div class="card-body">
            <text class="card-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
            <text class="card-desc" style="color: {{ theme.textMuted }}">{{ $item.desc }}</text>
          </div>
          <text class="card-arrow" style="color: {{ theme.textMuted }}">›</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var SECTIONS = [
  {
    label: "常用工具",
    items: [
      { name: "倒数日", desc: "事件倒计时管理，记录重要日期", icon: "📅", uri: "/pages/countdown-manage" },
      { name: "二维码生成", desc: "文字/链接转为二维码图片", icon: "📱", uri: "/pages/qrcode-generator" },
      { name: "已钉页面", desc: "首页快捷入口管理", icon: "📌", uri: "/pages/pinned-pages" }
    ]
  },
  {
    label: "系统诊断",
    items: [
      { name: "设备信息", desc: "查看设备型号、存储、平台版本", icon: "📊", uri: "/pages/device-info" },
      { name: "数据统计", desc: "课程数据统计与排名", icon: "📈", uri: "/pages/statistics" }
    ]
  },
  {
    label: "高级功能",
    items: [
      { name: "激活管理", desc: "设备激活与授权管理", icon: "🔑", uri: "/pages/activation" }
    ]
  }
]

export default {
  private: {
    sections: SECTIONS,
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  openPage(uri) {
    if (uri) {
      router.push({ uri: uri })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

