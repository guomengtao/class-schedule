<template>
  <div class="page-root" style="background-color: #1a1a2e">
    <div class="header">
      <div class="back-btn" onclick="goBack" style="background-color: #16213e">
        <image class="back-icon" src="/common/icons/dark/icon_back.png"></image>
      </div>
      <text class="title" style="color: #ffffff">布局诊断</text>
