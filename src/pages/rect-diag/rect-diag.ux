  width: 48px;
  height: 48px;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  flex: 1;
}

.header-placeholder {
  width: 48px;
}

.env-card {
  width: 100%;
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 6px;
  flex-direction: column;
}

.env-line {
  font-size: 20px;
  line-height: 28px;
}

.guide {
  width: 100%;
  font-size: 18px;
  line-height: 26px;
  margin-bottom: 8px;
}

.case {
  width: 100%;
  border-radius: 10px;
  padding: 6px 10px 10px 10px;
  margin-bottom: 8px;
  flex-direction: column;
}

.case-title {
  width: 100%;
  font-size: 20px;
  line-height: 30px;
  margin-bottom: 4px;
}

.stage {
  width: 100%;
  border-radius: 6px;
  padding: 6px;
  flex-direction: column;
}

.stage-tall {
  height: 120px;
}

.probe-text {
  width: 100%;
  font-size: 22px;
  line-height: 44px;
  text-align: center;
  border-radius: 6px;
}

.probe-key {
  width: 60px;
  height: 60px;
  border-radius: 30px;
  background-color: #d9a441;
  color: #1a1a2e;
  font-size: 26px;
  font-weight: bold;
  text-align: center;
  line-height: 60px;
  margin-right: 4px;
}

.probe-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 52px;
}

.probe-label {
  font-size: 24px;
  line-height: 34px;
}

.probe-switch {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  flex-shrink: 0;
}

.probe-grid {
  width: 100%;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 4px;
}

.probe-cell {
  width: 48%;
  height: 48px;
  border-radius: 6px;
  margin-bottom: 4px;
  justify-content: center;
  align-items: center;
}

.probe-celltext {
  font-size: 20px;
}

.probe-minh {
  width: 60%;
  min-height: 100%;
  justify-content: center;
  align-items: center;
}

.tail {
  width: 100%;
  font-size: 18px;
  line-height: 26px;
  margin-top: 4px;
  margin-bottom: 10px;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page-body {
    padding: 40px 8px 10px 8px;
  }
}
</style>
