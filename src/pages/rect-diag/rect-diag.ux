</template>

<script>
import router from "@system.router"
import device from "@system.device"

export default {
  private: {
    env: "读取中..."
  },

  onInit() {
    var self = this
    device.getInfo({
      success: function(d) {
        self.env = (d.screenShape || "?") + " " + (d.screenWidth || "?") + "x" + (d.screenHeight || "?")
      }
    })
  },

  open(id) {
    router.push({ uri: "/pages/" + id })
  },

  goBack() {
    router.back()
  }
}
</script>

