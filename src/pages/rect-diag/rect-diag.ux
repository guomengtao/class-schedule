    <div class="row" onclick="open('rect-c1')" style="background-color: #16213e">
      <text class="row-text" style="color: #ffffff">1 基准 width:100%</text>
      <text class="row-hint" style="color: #555566">›</text>
    </div>
    <div class="row" onclick="open('rect-c2')" style="background-color: #16213e">
      <text class="row-text" style="color: #ffffff">2 无width中间层x2</text>
