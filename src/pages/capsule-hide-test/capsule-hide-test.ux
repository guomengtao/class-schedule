<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <text class="big-a capsule-hide" style="color: {{ theme.accent }}">A</text>
  </div>
</template>

<script>
const store = require("../../data/store.js")
import router from "@system.router"

export default {
  private: {
    theme: {
      bg: "#1a1a2e",
      accent: "#7ec8e3"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.big-a {
  font-size: 200px;
  font-weight: bold;
  line-height: 220px;
}

@media (shape: capsule) {
  .capsule-hide {
    display: none;
  }
}
</style>
