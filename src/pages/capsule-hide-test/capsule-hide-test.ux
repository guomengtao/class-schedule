<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <text class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; color: {{ theme.accent }}"><</text>
    </div>

    <div class="info-bar" style="background-color: {{ theme.card }}">
      <text class="info-label" style="color: {{ theme.textMuted }}">设备:</text>
      <text class="info-value" style="color: {{ theme.accent }}">{{ screenTypeLabel }}</text>
    </div>

    <div class="list-scroll">
      <div class="list-row" for="item in mainItems" style="background-color: {{ theme.card }}">
        <text class="row-name" style="color: {{ theme.text }}">{{ item.en }}</text>
        <text class="row-cn capsule-hide" style="color: {{ theme.textMuted }}">{{ item.cn }}</text>
      </div>

      <div class="list-row" for="item in extraItems" style="background-color: {{ theme.card }}">
        <text class="row-name" style="color: {{ theme.text }}">{{ item.en }}</text>
        <text class="row-cn capsule-hide" style="color: {{ theme.textMuted }}">{{ item.cn }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
const store = require("../../data/store.js")

export default {
  private: {
    mainItems: [
      { en: "dog", cn: "狗" },
      { en: "cat", cn: "猫" }
    ],
    extraItems: [
      { en: "fox", cn: "狐狸" }
    ],
    screenType: "unknown",
    screenTypeLabel: "检测中...",
    theme: { bg: "#1a1a2e", card: "#16213e", accent: "#7ec8e3", text: "#ffffff", textMuted: "#555566" }
  },

  onInit() {
    var self = this
    dlog("[DEBUG] ========== capsule-hide-test onInit START ==========")
    store.getTheme(function(t) { self.theme = t })

    device.getInfo({
      success: function(data) {
        dlog("[DEBUG] device.getInfo SUCCESS, raw data:", JSON.stringify(data))
        self.screenType = data.screenShape || "unknown"
        self.screenTypeLabel = self.translateShape(self.screenType)
        dlog("[DEBUG] screenShape =", data.screenShape)
        dlog("[DEBUG] translateShape result =", self.screenTypeLabel)
        dlog("[DEBUG] screenWidth =", data.screenWidth, "screenHeight =", data.screenHeight)
        dlog("[DEBUG] isRound =", data.isRound, "shape =", data.shape)
        dlog("[DEBUG] @media condition: (shape: capsule) OR (shape: pill-shaped)")
        var matchShape = (self.screenType === "capsule" || self.screenType === "pill-shaped")
        dlog("[DEBUG] shape:", self.screenType, "-> match =", matchShape)
        dlog("[DEBUG] FINAL: .capsule-hide should hide =", matchShape)
        dlog("[DEBUG] ========== capsule-hide-test onInit END ==========")
      },
      fail: function(err) {
        dlog("[DEBUG] device.getInfo FAIL, err:", JSON.stringify(err))
        self.screenTypeLabel = "获取失败"
      }
    })
  },

  onShow() {
    var self = this
    dlog("[DEBUG] onShow triggered, current screenType =", self.screenType)
    store.getTheme(function(t) { self.theme = t })
  },

  translateShape(shape) {
    if (shape === "capsule" || shape === "pill-shaped") return "胶囊屏"
    if (shape === "rect") return "方形屏"
    if (shape === "circle") return "圆形屏"
    return shape
  },

  goBack() { router.back() }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 8px 16px 16px 16px;
}
.back-header { flex-direction: row; align-items: center; margin-bottom: 12px; }
.back-btn { width: 48px; height: 36px; border-radius: 8px; font-size: 20px; text-align: center; flex-shrink: 0; }

.info-bar {
  flex-direction: row; align-items: center;
  border-radius: 10px; padding: 10px 14px; margin-bottom: 12px;
}
.info-label { font-size: 26px; }
.info-value { font-size: 28px; font-weight: bold; }

.list-scroll { flex: 1; flex-direction: column; }
.list-row {
  flex-direction: row; align-items: center; justify-content: space-between;
  border-radius: 12px; padding: 16px; margin-bottom: 8px;
}
.row-name { font-size: 32px; }
.row-cn { font-size: 28px; }

@media (shape: capsule), (shape: pill-shaped) {
  .capsule-hide {
    display: none;
  }
  .header {
    height: 48px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
  }
  .back-btn {
    width: 48px;
    height: 40px;
    border-radius: 20px;
    font-size: 24px;
    text-align: center;
    line-height: 40px;
    flex-shrink: 0;
  }
  .title {
    font-size: 28px;
    line-height: 44px;
    text-align: center;
    flex: 1;
    lines: 1;
    margin: 0 4px;
  }

}
</style>