  flex-direction: row;
  align-items: center;
}

.counter-btn {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  font-size: 24px;
  text-align: center;
  margin: 0 8px;
}

.reset-btn {
  font-size: 14px;
  width: 64px;
}

.list-section {
  flex-direction: column;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 8px;
  flex: 1;
}

.list-header {
  flex-direction: row;
  justify-content: space-between;
