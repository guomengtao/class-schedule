  align-items: center;
  padding: 20px;
}

.list-empty-text {
  font-size: 14px;
}

.info-section {
  flex-direction: column;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 8px;
}

.info-title {
  font-size: 14px;
