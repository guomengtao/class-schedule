<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">简易课表</text>
      <div class="header-placeholder"></div>
    </div>
    <div if="{{ isLoading }}" class="loading-area">
      <text class="loading-text" style="color: {{ theme.textMuted }}">加载中...</text>
    </div>
    <div if="{{ !isLoading && daySections.length === 0 }}" class="empty-area">
      <text class="empty-text" style="color: {{ theme.textMuted }}">暂无课程数据</text>
    </div>
    <scroll if="{{ !isLoading && daySections.length > 0 }}" class="scroll-body" scroll-y="true">
      <div for="{{ daySections }}" class="day-section">
        <div class="day-header">
          <text class="day-name" style="color: {{ $item.isToday ? theme.accent : theme.text }}">{{ $item.dayName }}</text>
          <text class="day-count" style="color: {{ $item.isToday ? theme.accent : theme.textMuted }}">{{ $item.classes.length }} 门课</text>
        </div>
        <div class="day-divider" style="background-color: {{ $item.isToday ? theme.accent : theme.border }}"></div>
        <div for="{{ $item.classes }}" class="course-row" onclick="goToDetail($item, $item.dayName)">
          <div class="course-accent" style="background-color: {{ theme.accent }}"></div>
          <div class="course-body">
            <div class="course-name-row">
              <text class="course-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
              <text class="course-time" style="color: {{ theme.accent }}">{{ $item.time }}</text>
            </div>
            <text class="course-location" if="{{ $item.location }}" style="color: {{ theme.textMuted }}">{{ $item.location }}</text>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")

var DAY_ORDER = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]

function getTodayName() {
  return DAY_ORDER[new Date().getDay() === 0 ? 6 : new Date().getDay() - 1]
}

function parseMinutes(t) {
  if (!t) return 0
  var i = t.indexOf(" - ")
  if (i < 0) return 0
  var sp = t.substring(0, i).trim().split(":")
  if (sp.length !== 2) return 0
  return parseInt(sp[0]) * 60 + parseInt(sp[1])
}

export default {
  private: {
    iconTheme: "dark",
    isLoading: true,
    daySections: [],
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark' })
    this.loadData()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark' })
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        var today = getTodayName()
        var out = []
        if (schedule) {
          for (var di = 0; di < DAY_ORDER.length; di++) {
            var dn = DAY_ORDER[di]
            var dd = null
            for (var s = 0; s < schedule.length; s++) {
              if (schedule[s].day === dn) { dd = schedule[s]; break }
            }
            if (!dd || !dd.classes || !dd.classes.length) continue
            var cls = dd.classes.slice()
            cls.sort(function(a, b) { return parseMinutes(a.time) - parseMinutes(b.time) })
            out.push({ dayName: dn, isToday: dn === today, classes: cls })
          }
        }
        self.daySections = out
        self.isLoading = false
      })
    })
  },

  goToDetail: function(course, dayName) {
    var storage = require("@system.storage")
    storage.set({ key: "detail_classId", value: String(course.id) })
    storage.set({ key: "detail_day", value: dayName, success: function() { router.push({ uri: "/pages/detail" }) } })
  },

  goBack: function() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 6px 6px 6px;
}
.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 0 2px;
  flex-shrink: 0;
}
.back-btn-wrapper {
  width: 40px;
  height: 36px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.back-btn-icon {
  width: 20px;
  height: 20px;
}
.header-title {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 32px;
}
.header-placeholder {
  width: 40px;
  height: 36px;
  flex-shrink: 0;
}
.loading-area {
  align-items: center;
  padding: 30px 0;
}
.loading-text {
  font-size: 20px;
  line-height: 28px;
}
.empty-area {
  flex: 1;
  justify-content: center;
  align-items: center;
}
.empty-text {
  font-size: 22px;
  line-height: 30px;
}
.scroll-body {
  flex: 1;
  flex-direction: column;
}
.day-section {
  flex-direction: column;
  margin-bottom: 10px;
}
.day-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding: 4px 4px 2px 4px;
}
.day-name {
  font-size: 22px;
  font-weight: bold;
  line-height: 30px;
}
.day-count {
  font-size: 18px;
  line-height: 26px;
}
.day-divider {
  height: 2px;
  margin: 2px 0 6px 0;
  border-radius: 1px;
}
.course-row {
  flex-direction: row;
  align-items: stretch;
  border-radius: 8px;
  margin-bottom: 4px;
  overflow: hidden;
}
.course-accent {
  width: 4px;
  flex-shrink: 0;
  border-radius: 2px;
  margin: 6px 0;
}
.course-body {
  flex: 1;
  flex-direction: column;
  padding: 8px;
}
.course-name-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
}
.course-name {
  font-size: 22px;
  font-weight: bold;
  line-height: 30px;
}
.course-time {
  font-size: 18px;
  line-height: 26px;
  flex-shrink: 0;
  margin-left: 6px;
}
.course-location {
  font-size: 17px;
  line-height: 24px;
  margin-top: 2px;
}

@media (width >= 200px) {
  .page { padding: 44px 10px 8px 10px; }
  .back-header { margin-bottom: 16px; padding: 0 4px; }
  .back-btn-wrapper { width: 48px; height: 40px; }
  .back-btn-icon { width: 24px; height: 24px; }
  .header-title { font-size: 28px; line-height: 38px; }
  .header-placeholder { width: 48px; height: 40px; }
  .day-name { font-size: 24px; line-height: 32px; }
  .day-count { font-size: 20px; line-height: 28px; }
  .course-body { padding: 10px 12px; }
  .course-name { font-size: 24px; line-height: 32px; }
  .course-time { font-size: 20px; line-height: 28px; }
  .course-location { font-size: 18px; line-height: 26px; }
  .day-section { margin-bottom: 14px; }
}

@media (width >= 400px) {
  .page { padding: 12px 16px; }
  .back-header { margin-bottom: 20px; }
  .header-title { font-size: 32px; line-height: 42px; }
  .day-name { font-size: 28px; line-height: 36px; }
  .day-count { font-size: 22px; line-height: 30px; }
  .course-body { padding: 12px 16px; }
  .course-name { font-size: 28px; line-height: 36px; }
  .course-time { font-size: 22px; line-height: 30px; }
  .course-location { font-size: 20px; line-height: 28px; }
  .day-section { margin-bottom: 18px; }
}

@media (shape: circle) {
  .page { padding: 30px 20px 20px 20px; }
  .course-row { border-radius: 12px; }
}
</style>