<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div if="{{ !isRoot }}" class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.textSecondary }}">简易课表</text>
      <div if="{{ !isRoot }}" class="header-placeholder"></div>
    </div>

    <text class="today-title" style="color: {{ theme.accent }}">{{ todayTitle }}</text>

    <div if="{{ isLoading }}" class="empty-box">
      <text class="empty-text" style="color: {{ theme.textMuted }}">加载中...</text>
    </div>

    <div if="{{ !isLoading && todayClasses.length === 0 }}" class="empty-box">
      <text class="empty-text" style="color: {{ theme.textSecondary }}">今天没课</text>
    </div>

    <div if="{{ !isLoading && todayClasses.length > 0 }}" class="list">
      <div for="{{ todayClasses }}" class="row" onclick="goToDetail($item)">
        <div class="dot" style="background-color: {{ $item.dotColor }}"></div>
        <div class="row-body">
          <text class="row-name" style="color: {{ $item.isCurrent ? theme.accent : theme.text }}">{{ $item.name }}</text>
          <text class="row-time" style="color: {{ theme.textSecondary }}">{{ $item.timeShort }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const database = require("../../data/database.js")
const store = require("../../data/store.js")
const utils = require("../../data/utils.js")
const builtinSchedule = require("../../data/schedule.js")

var DAY_NAMES = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
var DAY_SHORT = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]

// "08:00 - 09:35" → {startMin, endMin}；格式不合规返回 null（脏数据不参与计算）
function parseTimeRange(timeStr) {
  if (!timeStr) return null
  var parts = timeStr.split(" - ")
  if (parts.length !== 2) return null
  var s1 = parts[0].trim().split(":")
  var s2 = parts[1].trim().split(":")
  if (s1.length !== 2 || s2.length !== 2) return null
  return { startMin: parseInt(s1[0]) * 60 + parseInt(s1[1]), endMin: parseInt(s2[0]) * 60 + parseInt(s2[1]) }
}

// "08:00 - 09:35" → "08:00"（简易页只保留开始时间，行宽有限）
function startLabel(timeStr) {
  if (!timeStr) return ""
  var i = timeStr.indexOf(" - ")
  return (i < 0 ? timeStr : timeStr.substring(0, i)).trim()
}

export default {
  private: {
    iconTheme: "dark",
    fromPanel: "",
    isRoot: false,
    // isLoading 只保留给极短窗口：onInit 同步算出结果后立刻为 false
    isLoading: true,
    todayTitle: "",
    todayClasses: [],
    schedule: [],
    tickTimer: null,
    theme: {
      bg: '#1a1a2e', card: '#16213e', cardLight: '#0f3460',
      accent: '#7ec8e3', text: '#ffffff', textSecondary: '#888899',
      textMuted: '#555566', border: '#0f3460'
    }
  },

  onInit() {
    var self = this
    // 独立首页 root 判定：被「更多首页」push 带 fromPanel='1'；作为 root 冷启动则无此参
    self.fromPanel = (self.fromPanel === '1') ? '1' : ''
    self.isRoot = self.fromPanel !== '1'
    // 首帧同步出内容：先用内置课表算一遍，storage 慢/丢回调都不会停在「加载中」
    self.apply((builtinSchedule && builtinSchedule.schedule) ? builtinSchedule.schedule : [])
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
      self.loadData()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
    // 回前台立即重算一次（后台期间可能跨节），再按分钟对齐续排
    if (!self.isLoading) self.tick()
  },

  onHide() {
    this.clearTickTimer()
  },

  /* 分钟级刷新：对齐「下一个整分」只挂一个 setTimeout。
     课程表是分钟级事件，全页禁用 setInterval（方案 §0）。 */
  scheduleNextMinute: function() {
    var self = this
    this.clearTickTimer()
    var now = new Date()
    var ms = 60000 - (now.getSeconds() * 1000)
    if (ms < 1000) ms = 1000
    this.tickTimer = setTimeout(function() { self.tick() }, ms)
  },

  clearTickTimer: function() {
    if (this.tickTimer) { clearTimeout(this.tickTimer); this.tickTimer = null }
  },

  apply: function(schedule) {
    this.schedule = schedule || []
    this.isLoading = false
    this.tick()
  },

  loadData: function() {
    var self = this
    database.init(function() {
      database.getAllCourses(function(schedule) {
        self.apply(schedule || [])
      })
    })
  },

  classesOf: function(dayName) {
    var schedule = this.schedule || []
    for (var i = 0; i < schedule.length; i++) {
      if (schedule[i].day === dayName) return schedule[i].classes || []
    }
    return []
  },

  tick: function() {
    try {
      this.compute()
    } catch (e) {
      // 计算异常不许把页面钉在旧状态：退回空态，用户至少看得懂
      this.todayClasses = []
      this.todayTitle = this.titleOf(new Date())
      console.error("[simple] compute failed: " + e)
    }
    this.scheduleNextMinute()
  },

  titleOf: function(now) {
    return "今天 · " + DAY_SHORT[now.getDay()]
  },

  compute: function() {
    var now = new Date()
    var nowMin = now.getHours() * 60 + now.getMinutes()
    this.todayTitle = this.titleOf(now)

    var raw = this.classesOf(DAY_NAMES[now.getDay()])
    var items = []
    for (var i = 0; i < raw.length; i++) {
      var r = parseTimeRange(raw[i].time)
      if (!r) continue
      items.push({
        id: raw[i].id,
        name: raw[i].name,
        time: raw[i].time,
        timeShort: startLabel(raw[i].time),
        dayName: DAY_NAMES[now.getDay()],
        startMin: r.startMin,
        endMin: r.endMin
      })
    }
    items.sort(function(a, b) { return a.startMin - b.startMin })

    // 最多 5 行（B 区 5×52）
    var top = items.slice(0, 5)
    for (var k = 0; k < top.length; k++) {
      var it = top[k]
      var isPast = nowMin >= it.endMin
      var isNow = nowMin >= it.startMin && nowMin < it.endMin
      it.isCurrent = isNow
      // 三色状态点：已过灰 / 当前主色 / 未到白（用 theme.text 保证浅色主题也可见）
      it.dotColor = isPast ? this.theme.textMuted : (isNow ? this.theme.accent : this.theme.text)
    }
    this.todayClasses = top
  },

  goToDetail: function(course) {
    if (!course) return
    var storage = require("@system.storage")
    storage.set({ key: "detail_classId", value: String(course.id) })
    storage.set({
      key: "detail_day",
      value: course.dayName,
      success: function() { router.push({ uri: "/pages/detail" }) }
    })
  },

  goBack: function() {
    // 被「更多首页」push（fromPanel）→ 回目录；作为 root 首页冷启动 → 退出应用（与 index 一致）
    if (this.fromPanel === '1') {
      router.back()
    } else {
      utils.exitApp()
    }
  },

  onBackPress: function() {
    if (this.fromPanel === '1') return false
    return utils.exitApp() === true
  },

  onDestroy: function() {
    this.clearTickTimer()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 12px 12px 12px;
}
.back-header {
  flex-direction: row;
  align-items: center;
  height: 40px;
  flex-shrink: 0;
  padding: 0 4px;
}
.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.back-btn-icon {
  width: 24px;
  height: 24px;
}
.header-title {
  flex: 1;
  font-size: 18px;
  text-align: center;
  line-height: 26px;
}
.header-placeholder {
  width: 48px;
  height: 40px;
  flex-shrink: 0;
}

/* A 今日标题：130–156（header 84 + margin-top 46） */
.today-title {
  margin-top: 46px;
  height: 26px;
  font-size: 22px;
  font-weight: bold;
  line-height: 26px;
  text-align: center;
  flex-shrink: 0;
}

/* B 课程行：5 × 52 = 260，168–428 */
.list {
  flex-direction: column;
  margin-top: 12px;
}
.row {
  height: 52px;
  flex-direction: row;
  align-items: center;
  padding: 0 4px;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  margin-right: 10px;
  flex-shrink: 0;
}
.row-body {
  flex: 1;
  flex-direction: column;
  justify-content: center;
}
.row-name {
  font-size: 20px;
  font-weight: bold;
  line-height: 26px;
  lines: 1;
  text-overflow: ellipsis;
}
.row-time {
  font-size: 15px;
  line-height: 19px;
}

/* C 空态：占据 B 区，垂直居中 */
.empty-box {
  height: 260px;
  justify-content: center;
  align-items: center;
}
.empty-text {
  font-size: 24px;
  line-height: 32px;
  text-align: center;
}

@media (width >= 200px) {
  .page { padding: 44px 16px 14px 16px; }
  .header-title { font-size: 20px; line-height: 28px; }
  .today-title { margin-top: 44px; height: 30px; font-size: 24px; line-height: 30px; }
  .row { height: 56px; }
  .row-name { font-size: 22px; line-height: 28px; }
  .row-time { font-size: 16px; line-height: 20px; }
  .empty-box { height: 280px; }
}

@media (width >= 400px) {
  .page { padding: 12px 20px 16px 20px; }
  .header-title { font-size: 24px; line-height: 32px; }
  .today-title { margin-top: 20px; height: 38px; font-size: 30px; line-height: 38px; }
  .row { height: 64px; }
  .row-name { font-size: 28px; line-height: 36px; }
  .row-time { font-size: 20px; line-height: 26px; }
  .empty-box { height: 320px; }
  .empty-text { font-size: 28px; line-height: 36px; }
}
</style>
