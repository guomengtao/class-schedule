<!-- UI/实现来源：open-vela-learning/packages_apps/wearable/settings/src/pages/home/index.ux（ev-minimal 最小改动法，2026-10-14；注入点仅数据源/文案/跳转） -->
<template>
  <div class="w-full h-full bg-black">
    <list class="list">
      <list-item class="list-item justify-center" type="title">
        <image class="w-30 h-30 mr-10" src="/common/image/back.png" onclick="handleClick"></image>
        <text class="list-item-title">简易课表</text>
      </list-item>
      <list-item class="list-item justify-between pl-60" type="setting-item" for="{{list}}" onclick="routeDetail($item)">
        <div>
          <image class="subject-image mt-4" src="{{$item.iconSrc}}"></image>
          <text class="subject-name">{{ $item.name }}</text>
        </div>

        <image class="subject-image mr-60" src="/common/image/right.png"></image>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import app from "@system.app"
const database = require("../../data/database.js")

// 注入点①数据源-图标：官方 settings 静态 iconSrc → 科目图标。
// 图标资源原样拷贝自官方 settings/src/common/image/*.indexed_8.png（官方 demo 本身即一图多项复用，见官方 index.ux 列表）；
// 未命中科目回落官方 motion 图标。
var SUBJECT_ICONS = {
  "语文": "/common/image/novice.indexed_8.png",
  "数学": "/common/image/display.indexed_8.png",
  "英语": "/common/image/wlan.indexed_8.png",
  "物理": "/common/image/motion.indexed_8.png",
  "化学": "/common/image/battery.indexed_8.png",
  "生物": "/common/image/disturb.indexed_8.png",
  "历史": "/common/image/downkey.indexed_8.png",
  "地理": "/common/image/guesture.indexed_8.png",
  "政治": "/common/image/wrist.indexed_8.png",
  "体育": "/common/image/sound.indexed_8.png",
  "音乐": "/common/image/system.indexed_8.png",
  "美术": "/common/image/applayout.indexed_8.png",
  "信息": "/common/image/notify.indexed_8.png"
}
var DEFAULT_ICON = "/common/image/motion.indexed_8.png"

function pickIcon(name) {
  if (!name) return DEFAULT_ICON
  if (SUBJECT_ICONS[name]) return SUBJECT_ICONS[name]
  for (var key in SUBJECT_ICONS) {
    if (name.indexOf(key) >= 0) return SUBJECT_ICONS[key]
  }
  return DEFAULT_ICON
}

export default {
  // 页面级组件的数据模型，影响传入数据的覆盖机制：private内定义的属性不允许被覆盖
  private: {
    title: "简易课表",
    list: []
  },

  onInit() {
    // 注入点①数据源：官方 settings 静态 list → 项目课程列表（database.getAllCoursesWithIndex，§11 例外：官方无课程业务）
    // 行文案精简为"周X 课程名"：官方 36px 字号 + 58px 图标槽下，方形屏可用文本宽约 200px，
    // "星期一 数学 · 08:00" 约 13 字必溢出，故去掉时间（时间以课程管理页为准）。
    var self = this
    database.getAllCoursesWithIndex(0, function(schedule) {
      var list = []
      if (schedule) {
        for (var d = 0; d < schedule.length; d++) {
          var dayData = schedule[d]
          if (!dayData || !dayData.classes) continue
          var classes = dayData.classes
          for (var i = 0; i < classes.length; i++) {
            var c = classes[i]
            if (!c || !c.name) continue
            var dayShort = (dayData.day || "").replace("星期", "周")
            list.push({ name: dayShort + " " + c.name, iconSrc: pickIcon(c.name) })
          }
        }
      }
      self.list = list
    })
  },

  // 注入点③跳转：官方 routeDetail（/pages/detail，本工程不存在）→ 项目课程管理页
  routeDetail(item) {
    router.push({
      uri: "/pages/schedule-manager"
    })
  },
  handleClick() {
    app.terminate()
  }
}
</script>

<style>
@import "./index.less";
.list {
  width: 100%;
  height: 100%;
}
.title {
  color: #fff;
  font-size: 40px;
  margin-top: 42px;
}
.list-item-title{
  font-size: 36px;
  color:white;
}
.list-item {
  flex-direction: row;
  align-items: center;
  height: 88px;
}

.subject-image {
	width: 58px;
	height: 58px;
	margin-right: 30px;
}
.subject-name {
	font-size: 36px;
	font-weight: 400;
	color: #fff;
}
</style>

/* atomics below copied verbatim from official settings app.ux style block (ev-minimal rule 3: append-only) */
.pl-60 { padding-left: 60px; }
.mr-10 { margin-right: 10px; }
.mr-60 { margin-right: 60px; }
.mt-4 { margin-top: 4px; }
.bg-black { background-color: rgba(0, 0, 0, 1); }
.h-30 { height: 30px; }
.h-full { height: 100%; }
.w-30 { width: 30px; }
.w-full { width: 100%; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
